const COMMAND_JOURNAL_PRIMARY_STEPS: PackedStringArray = [
	"journal_seed", "journal_enqueue", "journal_flush_replay", "journal_verify", "journal_close",
]


func apply_command_journal_seed_live(province_id: int = 1, seed: int = 1936) -> Dictionary:
	if typeof(SessionPlayers) == TYPE_NIL:
		return {"ok": false, "error": "no_SessionPlayers", "live": false}
	## Reset N2 fingerprint pair — verify must capture pre at enqueue and applied at flush.
	peace_state["command_journal_seed"] = seed
	peace_state["command_journal_fingerprint_pre"] = ""
	peace_state["command_journal_fingerprint_applied"] = ""
	peace_state["command_journal_verify_ok"] = false
	if SessionPlayers.has_method("seed_command_journal"):
		var res: Dictionary = SessionPlayers.seed_command_journal(seed)
		res["live"] = true
		res["live_api"] = "apply_command_journal_seed_live"
		res["province_id"] = province_id
		return res
	SessionPlayers.setup_default_hotseat()
	SessionPlayers.mark_lobby_all_ready()
	if SessionPlayers.has_method("clear_command_journal"):
		SessionPlayers.clear_command_journal()
	return {"ok": true, "live": true, "seed": seed, "province_id": province_id, "live_api": "apply_command_journal_seed_live"}


func apply_command_journal_enqueue_live(province_id: int = 1) -> Dictionary:
	if typeof(SessionPlayers) == TYPE_NIL:
		return {"ok": false, "error": "no_SessionPlayers", "live": false}
	# Honest batch — never apply_focus
	var actions: Array = ["apply_production", "apply_station", "apply_production"]
	var res: Dictionary = {}
	if SessionPlayers.has_method("enqueue_journal_batch"):
		res = SessionPlayers.enqueue_journal_batch(actions, province_id)
	else:
		var n := 0
		for a in actions:
			if "apply_focus" in str(a):
				continue
			SessionPlayers.enqueue_command(str(a), province_id)
			n += 1
		res = {"ok": n > 0, "enqueued_n": n}
	## Capture pre-flush fingerprint from live SessionPlayers journal (not hardcoded list).
	var seed := int(peace_state.get("command_journal_seed", 1936))
	var journal: Array = []
	if SessionPlayers.has_method("get_command_journal"):
		journal = SessionPlayers.get_command_journal()
	var fp_pre := ""
	if SessionPlayers.has_method("fingerprint_command_journal"):
		fp_pre = str(SessionPlayers.fingerprint_command_journal(seed))
	elif SessionPlayers.has_method("fingerprint_commands"):
		fp_pre = str(SessionPlayers.fingerprint_commands(journal, seed))
	peace_state["command_journal_fingerprint_pre"] = fp_pre
	var has_focus := false
	if SessionPlayers.has_method("journal_has_apply_focus"):
		has_focus = bool(SessionPlayers.journal_has_apply_focus(journal))
	else:
		for cmd in journal:
			if cmd is Dictionary and "apply_focus" in str((cmd as Dictionary).get("action", "")):
				has_focus = true
				break
	res["live"] = true
	res["live_api"] = "apply_command_journal_enqueue_live"
	res["no_focus_batch"] = not has_focus
	res["fingerprint_pre"] = fp_pre
	res["journal_n"] = journal.size()
	res["province_id"] = province_id
	res["ok"] = bool(res.get("ok", false)) and not fp_pre.is_empty() and not has_focus and journal.size() > 0
	return res


func apply_command_journal_flush_live(province_id: int = 1) -> Dictionary:
	if typeof(SessionPlayers) == TYPE_NIL:
		return {"ok": false, "error": "no_SessionPlayers", "live": false}
	var seed := int(peace_state.get("command_journal_seed", 1936))
	## Prefer pre already captured at enqueue; if missing, snapshot queue before flush.
	var fp_pre := str(peace_state.get("command_journal_fingerprint_pre", ""))
	if fp_pre.is_empty() and SessionPlayers.has_method("fingerprint_command_journal"):
		fp_pre = str(SessionPlayers.fingerprint_command_journal(seed))
		peace_state["command_journal_fingerprint_pre"] = fp_pre
	var res: Dictionary = SessionPlayers.flush_command_queue()
	var applied: Array = (res.get("applied", []) as Array) if res.get("applied") is Array else []
	## Rebuild trail with same keys as journal fingerprint (action|pid|tag|turn).
	var trail: Array = []
	for row in applied:
		if row is Dictionary:
			var d: Dictionary = row
			trail.append({
				"action": str(d.get("action", "")),
				"province_id": int(d.get("province_id", province_id)),
				"tag": str(d.get("tag", "")),
				"turn": int(d.get("turn", 0)),
			})
	var fp_applied := ""
	if SessionPlayers.has_method("fingerprint_commands"):
		fp_applied = str(SessionPlayers.fingerprint_commands(trail, seed))
	else:
		var parts: PackedStringArray = ["s%d" % seed]
		for d in trail:
			parts.append("%s|%d|%s|%d" % [
				str((d as Dictionary).get("action", "")),
				int((d as Dictionary).get("province_id", 1)),
				str((d as Dictionary).get("tag", "")),
				int((d as Dictionary).get("turn", 0)),
			])
		fp_applied = str("|".join(parts).hash())
	peace_state["command_journal_fingerprint_applied"] = fp_applied
	peace_state["command_journal_last_flush"] = res.duplicate(true)
	var has_focus := false
	for d in trail:
		if "apply_focus" in str((d as Dictionary).get("action", "")):
			has_focus = true
			break
	res["live"] = true
	res["live_api"] = "apply_command_journal_flush_live"
	res["province_id"] = province_id
	res["fingerprint_pre"] = fp_pre
	res["fingerprint_applied"] = fp_applied
	res["no_focus_batch"] = not has_focus
	res["applied_n"] = trail.size()
	return res


func apply_command_journal_verify_live(province_id: int = 1) -> Dictionary:
	## Honest verify: compare pre-flush SessionPlayers journal fingerprint to post-flush applied trail.
	## Never invent success from a hardcoded action list.
	var seed := int(peace_state.get("command_journal_seed", 1936))
	var fp_pre := str(peace_state.get("command_journal_fingerprint_pre", ""))
	var fp_applied := str(peace_state.get("command_journal_fingerprint_applied", ""))
	## Optional live re-check of residual queue (should be empty after flush).
	var journal_n := 0
	if typeof(SessionPlayers) != TYPE_NIL and SessionPlayers.has_method("get_command_journal"):
		journal_n = SessionPlayers.get_command_journal().size()
	var has_focus := false
	if peace_state.has("command_journal_last_flush") and peace_state["command_journal_last_flush"] is Dictionary:
		var flush_d: Dictionary = peace_state["command_journal_last_flush"] as Dictionary
		var applied_v: Variant = flush_d.get("applied", [])
		if applied_v is Array:
			for row in applied_v:
				if row is Dictionary and "apply_focus" in str((row as Dictionary).get("action", "")):
					has_focus = true
					break
	var match_ok := (not fp_pre.is_empty()) and (not fp_applied.is_empty()) and fp_pre == fp_applied
	var ok := match_ok and not has_focus
	peace_state["command_journal_verify_ok"] = ok
	peace_state["command_journal_fingerprint"] = fp_applied if ok else fp_pre
	return {
		"ok": ok,
		"live": true,
		"fingerprint": fp_applied,
		"fingerprint_pre": fp_pre,
		"fingerprint_applied": fp_applied,
		"fingerprint_match": match_ok,
		"seed": seed,
		"no_focus_batch": not has_focus,
		"journal_n_after_flush": journal_n,
		"live_api": "apply_command_journal_verify_live",
		"province_id": province_id,
		"manager": "GameData.command_journal_verify",
	}


func apply_command_journal_close_live(province_id: int = 1) -> Dictionary:
	var verify: Dictionary = apply_command_journal_verify_live(province_id)
	var rotated := {}
	if typeof(SessionPlayers) != TYPE_NIL and SessionPlayers.has_method("rotate_active_player"):
		rotated = SessionPlayers.rotate_active_player()
	var ok := bool(verify.get("ok", false))
	return {
		"ok": ok, "live": true, "verify": verify, "rotated": rotated,
		"live_api": "apply_command_journal_close_live", "province_id": province_id,
	}


