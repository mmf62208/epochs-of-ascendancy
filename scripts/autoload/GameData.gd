	var day: Dictionary = {}
	if MapManager.has_method("fleet_multi_theater_day_for_tag"):
		day = MapManager.fleet_multi_theater_day_for_tag(tag, fuel_level, max_applies)
	else:
		day = MapPolishFormatters.fleet_multi_theater_day([], fuel_level, tag, max_applies)
	if bool(day.get("empty", false)):
		return {"ok": false, "reason": "empty multi-theater plan", "day": day}
	var applied: Array = []
	var ok_n := 0
	for item in day.get("apply_queue", []):
		if not (item is Dictionary):
			continue
		var pid := int(item.get("province_id", 1))
		var res: Dictionary = apply_fleet_autonomy_tick(pid, fuel_level)
