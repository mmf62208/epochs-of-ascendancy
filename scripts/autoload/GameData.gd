## CP5 combat munitions consume + reliability + troop XP.
const COMBAT_CONSUME_PRIMARY_STEPS: PackedStringArray = [
	"cc_catalog", "cc_consume", "cc_reliability", "cc_xp", "cc_close",
]


func apply_combat_consume_catalog_live(province_id: int = 1) -> Dictionary:
	# Instance methods are not always visible via load().has_method on class scripts — source + PM hooks.
	var src := ""
	if FileAccess.file_exists("res://scripts/combat/CombatResolver.gd"):
		src = FileAccess.get_file_as_string("res://scripts/combat/CombatResolver.gd")
	var ok: bool = ("func apply_combat_munitions_consume" in src) \
		and ("func apply_formation_combat_experience_gain" in src) \
		and ("func get_formation_reliability_snapshot" in src) \
		and ("reliability_combat_mult" in src) \
		and typeof(ProductionManager) != TYPE_NIL \
		and ProductionManager.has_method("consume_munitions_from_stockpile")
	return {"ok": ok, "live": true, "province_id": province_id, "live_api": "apply_combat_consume_catalog_live", "model": "equipment_flow_compact_ledger"}


func apply_combat_consume_munitions_live(province_id: int = 1) -> Dictionary:
	var cr_script = load("res://scripts/combat/CombatResolver.gd")
	if cr_script == null:
		return {"ok": false, "live": true, "error": "no_cr", "live_api": "apply_combat_consume_munitions_live"}
	# Instantiate RefCounted/Node class for method calls
	var cr = cr_script.new() if cr_script.can_instantiate() else null
	if cr == null and typeof(CombatResolver) != TYPE_NIL:
		cr = CombatResolver
	if cr == null:
		# Fall back to ProductionManager consume only for dual honesty
		if typeof(ProductionManager) == TYPE_NIL:
			return {"ok": false, "live": true, "error": "no_pm", "live_api": "apply_combat_consume_munitions_live"}
		ProductionManager.add_to_country_equipment_stockpile("USA", "tactical_missile_demo", 8)
		var before := ProductionManager.get_country_equipment_amount("USA", "tactical_missile_demo")
		var hit: Dictionary = ProductionManager.consume_munitions_from_stockpile("USA", "tactical_missile_demo", 2, 1.2, {"design_class": "missile"})
		var after := ProductionManager.get_country_equipment_amount("USA", "tactical_missile_demo")
		var ok_fb: bool = bool(hit.get("ok", false)) and after < before and int(hit.get("consumed", 0)) >= 1
		return {"ok": ok_fb, "live": true, "combat_consume_ok": ok_fb, "mode": "pm_fallback", "hit": hit, "province_id": province_id, "live_api": "apply_combat_consume_munitions_live", "model": "equipment_flow_compact_ledger"}
	# Seed stock and use first formation if any
	ProductionManager.add_to_country_equipment_stockpile("USA", "tactical_missile_demo", 10)
	var fid := ""
	if typeof(LeaderManager) != TYPE_NIL and "formations" in LeaderManager:
		for k in LeaderManager.formations.keys():
			var ff = LeaderManager.formations[k]
			if ff != null:
				if "country_tag" in ff:
					ff.country_tag = "USA"
				fid = str(k)
				break
	var before2 := ProductionManager.get_country_equipment_amount("USA", "tactical_missile_demo")
	var res: Dictionary = {}
	if cr.has_method("apply_combat_munitions_consume") and not fid.is_empty():
		res = cr.apply_combat_munitions_consume(fid, 1.5, {"role": "attacker"})
	else:
		res = ProductionManager.consume_munitions_from_stockpile("USA", "tactical_missile_demo", 2, 1.5, {"design_class": "missile"})
	var after2 := ProductionManager.get_country_equipment_amount("USA", "tactical_missile_demo")
	var consume_ok: bool = after2 < before2 or int(res.get("consumed", 0)) >= 1 or bool(res.get("ok", false))
	# Prefer actual stock drain
	if after2 >= before2 and int(res.get("consumed", 0)) < 1:
		# force consume path
		var forced: Dictionary = ProductionManager.consume_munitions_from_stockpile("USA", "tactical_missile_demo", 2, 1.0, {"design_class": "missile"})
		consume_ok = bool(forced.get("ok", false)) and int(forced.get("consumed", 0)) >= 1
		res = forced
	return {"ok": consume_ok, "live": true, "combat_consume_ok": consume_ok, "res": res, "before": before2, "after": after2, "formation_id": fid, "province_id": province_id, "live_api": "apply_combat_consume_munitions_live", "model": "equipment_flow_compact_ledger"}


func apply_combat_consume_reliability_live(province_id: int = 1) -> Dictionary:
	var cr_script = load("res://scripts/combat/CombatResolver.gd")
	var ok := false
	var snap: Dictionary = {}
	if cr_script != null and cr_script.can_instantiate():
		var cr = cr_script.new()
		if typeof(LeaderManager) != TYPE_NIL and "formations" in LeaderManager:
			for k in LeaderManager.formations.keys():
				if LeaderManager.formations[k] != null:
					if cr.has_method("get_formation_reliability_snapshot"):
						snap = cr.get_formation_reliability_snapshot(str(k))
					break
		if cr.has_method("free"):
			cr.free()
	# Also verify reliability mult exists in combat power path via source + production stamp
	if typeof(ProductionManager) != TYPE_NIL:
		ProductionManager.equipment_production_reliability["demo_unreliable_tank"] = {"reliability": 0.75, "samples": 3}
		var rel := ProductionManager.get_equipment_production_reliability("demo_unreliable_tank")
		ok = rel < 0.9 and rel > 0.5
	var src := FileAccess.get_file_as_string("res://scripts/combat/CombatResolver.gd") if FileAccess.file_exists("res://scripts/combat/CombatResolver.gd") else ""
	ok = ok and ("reliability_combat_mult" in src)
	if bool(snap.get("ok", false)):
		ok = ok and float(snap.get("breakdown_risk", 0)) >= 0.0
	return {"ok": ok, "live": true, "reliability_ok": ok, "snap": snap, "province_id": province_id, "live_api": "apply_combat_consume_reliability_live", "model": "equipment_flow_compact_ledger"}


func apply_combat_consume_xp_live(province_id: int = 1) -> Dictionary:
	var cr_script = load("res://scripts/combat/CombatResolver.gd")
	var xp_ok := false
	var gain: Dictionary = {}
	if cr_script != null and cr_script.can_instantiate() and typeof(LeaderManager) != TYPE_NIL and "formations" in LeaderManager:
		var cr = cr_script.new()
		var fid := ""
		for k in LeaderManager.formations.keys():
			if LeaderManager.formations[k] != null:
				fid = str(k)
				break
		if not fid.is_empty() and cr.has_method("apply_formation_combat_experience_gain"):
			if typeof(ProductionManager) != TYPE_NIL and ProductionManager.has_method("set_formation_combat_experience"):
				ProductionManager.set_formation_combat_experience(fid, 50.0)
			gain = cr.apply_formation_combat_experience_gain(fid, 1.5, {"outcome": "victory"})
			xp_ok = bool(gain.get("ok", false)) and float(gain.get("xp_after", 0)) > float(gain.get("xp_before", 0))
		if cr.has_method("free"):
			cr.free()
	# Aftermath wiring present
	var src := FileAccess.get_file_as_string("res://scripts/combat/CombatResolver.gd") if FileAccess.file_exists("res://scripts/combat/CombatResolver.gd") else ""
	xp_ok = xp_ok and ("apply_formation_combat_experience_gain" in src) and ("attacker_troop_xp" in src)
	return {"ok": xp_ok, "live": true, "xp_ok": xp_ok, "gain": gain, "province_id": province_id, "live_api": "apply_combat_consume_xp_live", "model": "equipment_flow_compact_ledger"}


