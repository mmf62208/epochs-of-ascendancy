]


func _space_layer_calc():
	return load("res://scripts/space/SpaceLayerCalculator.gd")


func apply_space_layer_catalog_live(province_id: int = 1) -> Dictionary:
	var calc = _space_layer_calc()
	if calc == null:
		return {"ok": false, "live": true, "error": "no_calc", "live_api": "apply_space_layer_catalog_live"}
	var rules: Dictionary = calc.get_rules() as Dictionary
	var model_ok: bool = str(rules.get("model", "")) == "orbital_compact_ledger"
	var layers_n: int = (rules.get("layers", []) as Array).size() if rules.get("layers") is Array else 0
	var bodies_n: int = (rules.get("bodies", []) as Array).size() if rules.get("bodies") is Array else 0
	var design_doc: bool = FileAccess.file_exists("res://docs/SPACE_STRATEGIC_LAYER_DESIGN.md")
	var ok: bool = model_ok and layers_n >= 5 and bodies_n >= 5 and design_doc
	return {
		"ok": ok, "live": true, "model": "orbital_compact_ledger",
		"layers_n": layers_n, "bodies_n": bodies_n, "design_doc": design_doc,
		"province_id": province_id, "live_api": "apply_space_layer_catalog_live",
	}


func apply_space_layer_gates_live(province_id: int = 1) -> Dictionary:
	var calc = _space_layer_calc()
	if calc == null:
		return {"ok": false, "live": true, "error": "no_calc", "live_api": "apply_space_layer_gates_live"}
	var early: Array = calc.visible_layers([], [])
	var early_ids: Array = []
	for L in early:
		if L is Dictionary and bool((L as Dictionary).get("unlocked", false)):
			early_ids.append(str((L as Dictionary).get("id", "")))
	var mid: Array = calc.visible_layers(["allow_satellites"], ["first_satellite"])
	var mid_near := false
	for L in mid:
		if L is Dictionary and str((L as Dictionary).get("id", "")) == "near_earth" and bool((L as Dictionary).get("unlocked", false)):
			mid_near = true
	var lunar: Array = calc.visible_layers(["allow_lunar_operations"], ["moon_landing"])
	var lunar_ok := false
	for L in lunar:
		if L is Dictionary and str((L as Dictionary).get("id", "")) == "cis_lunar" and bool((L as Dictionary).get("unlocked", false)):
			lunar_ok = true
	# Optional live tech flags if TechnologyManager available (player-ish USA)
	var live_flags: Array = []
	if typeof(TechnologyManager) != TYPE_NIL and TechnologyManager.has_method("has_rule_flag"):
		for f in ["allow_satellites", "allow_manned_space", "allow_lunar_operations"]:
			if TechnologyManager.has_rule_flag("USA", f):
				live_flags.append(f)
	var gates_ok: bool = early_ids == ["earth_surface"] and mid_near and lunar_ok
	return {
		"ok": gates_ok, "live": true, "gates_ok": gates_ok,
		"early_ids": early_ids, "mid_near": mid_near, "lunar_ok": lunar_ok,
		"live_flags": live_flags,
		"province_id": province_id, "live_api": "apply_space_layer_gates_live",
		"scenario": "progressive_layer_gates",
	}


func apply_space_layer_graph_live(province_id: int = 1) -> Dictionary:
	var calc = _space_layer_calc()
	if calc == null:
		return {"ok": false, "live": true, "error": "no_calc", "live_api": "apply_space_layer_graph_live"}
	var bodies: Array = calc.bodies_for_flags(["allow_satellites"], ["first_satellite"])
	var has_leo := false
	var has_mars := false
	for b in bodies:
		if not (b is Dictionary):
			continue
		var bid := str((b as Dictionary).get("id", ""))
		if bid == "leo_band":
			has_leo = true
		if bid == "mars":
			has_mars = true
	var bodies_lunar: Array = calc.bodies_for_flags(["allow_satellites", "allow_lunar_operations"], ["moon_landing"])
	var has_luna := false
	for b in bodies_lunar:
		if b is Dictionary and str((b as Dictionary).get("id", "")) == "luna":
			has_luna = true
	var graph_ok: bool = has_leo and not has_mars and has_luna and bodies.size() >= 2
	return {
		"ok": graph_ok, "live": true, "graph_ok": graph_ok,
		"bodies_mid_n": bodies.size(), "has_leo": has_leo, "has_mars_early": has_mars, "has_luna": has_luna,
		"province_id": province_id, "live_api": "apply_space_layer_graph_live",
		"scenario": "gated_body_graph",
	}


func apply_space_layer_routes_live(province_id: int = 1) -> Dictionary:
	var calc = _space_layer_calc()
	if calc == null:
		return {"ok": false, "live": true, "error": "no_calc", "live_api": "apply_space_layer_routes_live"}
	var cors: Array = calc.open_corridors(["allow_satellites", "allow_lunar_operations"], ["moon_landing"])
	var plain: String = str(calc.interdict_attribution_plain("asat", "leo_band", "earth", "luna"))
	var hit: float = float(calc.spaceflow_hit_chance(0.25))
	var loss: float = float(calc.spaceflow_loss_fraction(0.4, 0.6))
	var strain: Dictionary = calc.colony_strain(9.0, 5.0, 1.0, 2.0) as Dictionary
	var routes_ok: bool = (
		cors.size() >= 2
		and plain.contains("ASAT")
		and hit >= 0.02 and hit <= 0.5
		and loss >= 0.08 and loss <= 0.7
		and bool(strain.get("starvation_risk", false))
		and bool(strain.get("mc_over", false))
	)
	return {
		"ok": routes_ok, "live": true, "routes_ok": routes_ok,
		"corridors_n": cors.size(), "plain": plain, "hit_chance": hit, "loss": loss,
		"colony_strain": strain,
		"province_id": province_id, "live_api": "apply_space_layer_routes_live",
		"scenario": "spaceflow_interdict_and_strain",
	}


