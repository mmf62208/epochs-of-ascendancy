		major = "rsp_primary_close"
		live_api = "apply_resource_production_close_live"
		live_result = apply_resource_production_close_live(province_id)
	var step_ok := bool(live_result.get("ok", false))
	var major_credit := major if step_ok else ""
	var domain_script = load("res://scripts/core/ResourceProductionDomain.gd")
	var domain_res: Dictionary = {}
	var live_api_final: String = str(live_api)
	if domain_script != null and domain_script.has_method("apply_primary_step"):
		peace_state["resource_production_primary"] = st.duplicate(true)
		domain_res = domain_script.apply_primary_step(peace_state, s, live_api_final, major_credit, live_result)
	else:
		var applied_fb: Array = (st.get("applied", []) as Array).duplicate() if st.get("applied") is Array else []
		if not applied_fb.has(s):
			applied_fb.append(s)
		st["applied"] = applied_fb
		st["tick"] = int(st.get("tick", 0)) + 1
		var md_fb: Dictionary = (st.get("majors_done", {}) as Dictionary).duplicate(true)
		if not str(major_credit).is_empty():
			md_fb[major_credit] = int(md_fb.get(major_credit, 0)) + 1
		st["majors_done"] = md_fb
		peace_state["resource_production_primary"] = st.duplicate(true)
