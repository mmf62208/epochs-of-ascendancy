	st["open_n"] = open_n
	st["packages"] = packages
	st["tick_count"] = int(st.get("tick_count", 0)) + 1
	peace_state["gs_cycle"] = st.duplicate(true)
	var tcount := int(peace_state.get("gs_cycle_tick_count", 0)) + 1
	peace_state["gs_cycle_tick_count"] = tcount
	return {
