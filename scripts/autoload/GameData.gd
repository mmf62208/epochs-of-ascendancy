func apply_designer_campaign_live(step: String = "catalog_all", province_id: int = 1) -> Dictionary:
	var st: Dictionary = get_designer_campaign_state()
	var s := step.strip_edges().to_lower().replace("designer_", "")
	var open_n := int(st.get("open_n", 0))
	var seeded_n := int(st.get("seeded_n", 0))
	var equip_n := int(st.get("equip_n", 0))
	if s.begins_with("catalog") or s.begins_with("all"):
		open_n = 4
		if has_method("apply_order_panel_action"):
			apply_order_panel_action("apply_focus", province_id)
	elif s.begins_with("seed") or s.begins_with("multi"):
		# Seed each domain once for campaign depth.
		for dom in ["land", "naval", "air", "space"]:
			if has_method("apply_designer_field_live"):
				apply_designer_field_live("field", province_id, dom)
		seeded_n = 4
	elif s.begins_with("equip") or s.begins_with("close"):
		equip_n = mini(seeded_n if seeded_n > 0 else 4, open_n if open_n > 0 else 4)
		st["complete"] = equip_n >= 3
		if has_method("apply_order_panel_action"):
			apply_order_panel_action("apply_production", province_id)
	st["open_n"] = open_n
	st["seeded_n"] = seeded_n
	st["equip_n"] = equip_n
	st["tick_count"] = int(st.get("tick_count", 0)) + 1
	peace_state["designer_campaign"] = st.duplicate(true)
	var ticks := int(peace_state.get("designer_campaign_tick_count", 0)) + 1
	peace_state["designer_campaign_tick_count"] = ticks
	return {
		"ok": true, "live": true, "step": s, "province_id": province_id,
		"open_n": open_n, "seeded_n": seeded_n, "equip_n": equip_n,
		"complete": bool(st.get("complete", false)), "designer_campaign_tick_count": ticks,
		"manager": "GameData.designer_campaign",
	}


