func get_occupation_revolt_state(province_id: int = 1) -> Dictionary:
	var key := str(province_id)
	if not peace_state.has("occupation_revolt") or not (peace_state["occupation_revolt"] is Dictionary):
		peace_state["occupation_revolt"] = {}
	var store: Dictionary = peace_state["occupation_revolt"]
	if not store.has(key):
		store[key] = {
			"flashpoint": 0.48, "garrison_mode": "standard", "garrison_strength": 0.45,
			"suppress_power": 0.5, "resolved": false, "tick_count": 0,
		}
		peace_state["occupation_revolt"] = store
	return (store[key] as Dictionary).duplicate(true)

func apply_occupation_revolt_live(province_id: int = 1, step: String = "board", mode: String = "standard") -> Dictionary:
	var st: Dictionary = get_occupation_revolt_state(province_id)
	var s := step.strip_edges().to_lower().replace("occupation_revolt_", "")
	var m := mode.strip_edges().to_lower()
	if m not in ["light", "standard", "heavy"]:
		m = str(st.get("garrison_mode", "standard"))
	var flash := float(st.get("flashpoint", 0.48))
	var garr := float(st.get("garrison_strength", 0.45))
	if s.begins_with("garrison"):
		var mult := 1.0
		match m:
			"light": mult = 0.7
			"heavy": mult = 1.35
		garr = clampf(garr + 0.12 * mult, 0.0, 1.0)
		flash = clampf(flash - 0.06 * mult, 0.0, 1.0)
		st["garrison_mode"] = m
	elif s.begins_with("suppress") or s.begins_with("resolve"):
		flash = clampf(flash - 0.14, 0.0, 1.0)
		garr = clampf(garr + 0.04, 0.0, 1.0)
	else:
		# board: re-evaluate from occupation state if available
		if has_method("get_occupation_province_state"):
			var occ: Dictionary = get_occupation_province_state(province_id)
			flash = clampf(0.55 * float(occ.get("resistance_level", 0.55)) + 0.25 * (1.0 - float(occ.get("compliance_level", 0.4))) - 0.2 * garr + 0.1, 0.0, 1.0)
	var suppress := clampf(0.4 * garr + 0.35 * (1.0 - flash) + 0.15, 0.0, 1.0)
	st["flashpoint"] = flash
	st["garrison_strength"] = garr
	st["suppress_power"] = suppress
	st["resolved"] = flash < 0.45 and suppress >= 0.5
	st["tick_count"] = int(st.get("tick_count", 0)) + 1
	if not peace_state.has("occupation_revolt") or not (peace_state["occupation_revolt"] is Dictionary):
		peace_state["occupation_revolt"] = {}
	(peace_state["occupation_revolt"] as Dictionary)[str(province_id)] = st.duplicate(true)
	var ticks := int(peace_state.get("occupation_revolt_tick_count", 0)) + 1
	peace_state["occupation_revolt_tick_count"] = ticks
	return {
		"ok": true, "live": true, "step": s, "province_id": province_id,
		"flashpoint": flash, "garrison_mode": str(st.get("garrison_mode", m)), "garrison_strength": garr,
		"suppress_power": suppress, "resolved": bool(st.get("resolved", false)),
		"occupation_revolt_tick_count": ticks, "manager": "GameData.occupation_revolt",
	}

