func apply_resource_production_primary_live(province_id: int = 1) -> Dictionary:
	var results: Array = []
	for step in RESOURCE_PRODUCTION_PRIMARY_STEPS:
		results.append(apply_resource_production_primary_step_live(step, province_id))
	var majors_ok := 0
	var domain_script2 = load("res://scripts/core/ResourceProductionDomain.gd")
	if domain_script2 != null and domain_script2.has_method("majors_ok_count"):
		majors_ok = int(domain_script2.majors_ok_count(peace_state))
	var dead_n := 0
	var failed_n := 0
	var shortage_speed := 1.0
	var full_speed := 0.0
	for r in results:
		var api := str((r as Dictionary).get("live_api", ""))
		if api.is_empty() or api == "apply_focus":
			dead_n += 1
		if not bool((r as Dictionary).get("step_ok", (r as Dictionary).get("ok", false))):
			failed_n += 1
		var lr: Dictionary = (r as Dictionary).get("live_result", {}) if (r as Dictionary).get("live_result") is Dictionary else {}
		if str((r as Dictionary).get("step", "")) == "rsp_full":
			full_speed = float(lr.get("output_multiplier", 0.0))
		if str((r as Dictionary).get("step", "")) == "rsp_shortage":
			shortage_speed = float(lr.get("output_multiplier", 1.0))
	var shortage_matters := shortage_speed < full_speed - 0.01 or (full_speed >= 0.99 and shortage_speed < 0.99)
	var ok := majors_ok >= 5 and dead_n == 0 and failed_n == 0 and shortage_matters
	return {
		"ok": ok, "live": true, "majors_ok": majors_ok, "dead_n": dead_n, "failed_n": failed_n,
		"complete": ok, "shortage_matters": shortage_matters,
		"full_speed": full_speed, "shortage_speed": shortage_speed,
		"model": "strategic_stockpile_soft_shortage",
		"resource_production_primary_ticks": int(peace_state.get("resource_production_primary_ticks", 0)),
		"g0_domain": "ResourceProductionDomain",
		"province_id": province_id, "closed": RESOURCE_PRODUCTION_PRIMARY_STEPS,
	}


