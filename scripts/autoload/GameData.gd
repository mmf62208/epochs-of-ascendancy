func apply_space_rival_survey_seed_live(province_id: int = 1) -> Dictionary:
	if typeof(SpaceLayerManager) == TYPE_NIL:
		return {"ok": false, "live": true, "error": "no_slm", "live_api": "apply_space_rival_survey_seed_live"}
	SpaceLayerManager.reset_for_new_scenario()
	# USA already has a discovery on mars → contested race target
	var s: Dictionary = SpaceLayerManager.start_survey("USA", "mars", {"months": 1, "force_success": true})
