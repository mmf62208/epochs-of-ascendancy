	var ok := majors_ok >= 5 and dead_n == 0 and failed_n == 0 and lift_ok and flow_ok and board_ok
	return {"ok": ok, "live": true, "majors_ok": majors_ok, "dead_n": dead_n, "failed_n": failed_n, "lift_ok": lift_ok, "flow_ok": flow_ok, "board_ok": board_ok, "model": "orbital_compact_ledger", "province_id": province_id, "closed": SPACE_SUPPLY_PRIMARY_STEPS}


