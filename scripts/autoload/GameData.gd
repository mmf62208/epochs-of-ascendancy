	if aid.begins_with("save_slot:"):
		var slot := aid.substr("save_slot:".length()).strip_edges()
		if slot.is_empty():
			slot = "quicksave"
		if typeof(SaveLoadManager) != TYPE_NIL and SaveLoadManager.has_method("save_game_detailed"):
			var sr: Dictionary = SaveLoadManager.save_game_detailed(slot)
			return {"ok": bool(sr.get("ok", sr.get("success", false))), "slot": slot, "save": sr}
		return {"ok": false, "reason": "no save"}
	if aid.begins_with("load_slot:"):
		var lslot := aid.substr("load_slot:".length()).strip_edges()
		if lslot.is_empty():
			return {"ok": false, "reason": "empty slot"}
		if typeof(SaveLoadManager) != TYPE_NIL and SaveLoadManager.has_method("load_game_detailed"):
			var lr: Dictionary = SaveLoadManager.load_game_detailed(lslot)
			return {"ok": bool(lr.get("ok", lr.get("success", false))), "slot": lslot, "load": lr}
		return {"ok": false, "reason": "no load"}
	if aid == "refresh_queue" or aid == "refresh":
		if MapManager.has_method("order_queue_for_province"):
			var q: Dictionary = MapManager.order_queue_for_province(province_id)
			return {"ok": true, "queue": q, "refreshed": true}
		return {"ok": false, "reason": "no queue"}
	return {"ok": false, "reason": "unknown action %s" % action_id}



func apply_air_forecast_day(province_id: int = 1) -> Dictionary:
	var tag := "GER"
	if typeof(LeaderManager) != TYPE_NIL and LeaderManager.has_method("get_player_country_tag"):
		tag = str(LeaderManager.get_player_country_tag()).to_upper()
	var day: Dictionary = {}
	if MapManager.has_method("air_forecast_assault_day_for_tag"):
		day = MapManager.air_forecast_assault_day_for_tag(tag, province_id)
	if bool(day.get("empty", false)):
		return {"ok": false, "reason": "empty air forecast day", "day": day}
	var applied: Array = []
	var ok_n := 0
	for item in day.get("apply_queue", []):
		if not (item is Dictionary):
			continue
		var aid := str(item.get("action_id", ""))
		var pid := int(item.get("province_id", province_id))
		if pid < 0:
			pid = province_id
		var res: Dictionary = {}
		if aid == "apply_focus":
			res = apply_focus_order_mutation(str(item.get("focus_id", "industrial_effort")), "HOLD")
		else:
			res = apply_order_panel_action(aid, pid)
		if bool(res.get("ok", res.get("success", false))):
			ok_n += 1
		applied.append({"action_id": aid, "result": res})
	return {"ok": ok_n > 0, "ok_count": ok_n, "applied": applied, "day": day, "empty": applied.is_empty()}


func apply_reinforced_assault_day(max_targets: int = 3) -> Dictionary:
	var tag := "GER"
	if typeof(LeaderManager) != TYPE_NIL and LeaderManager.has_method("get_player_country_tag"):
		tag = str(LeaderManager.get_player_country_tag()).to_upper()
	var day: Dictionary = {}
	if MapManager.has_method("reinforced_assault_day_for_tag"):
		day = MapManager.reinforced_assault_day_for_tag(tag, max_targets)
	if bool(day.get("empty", false)):
		return {"ok": false, "reason": "empty reinforced assault day", "day": day}
	var applied: Array = []
	var ok_n := 0
	for item in day.get("apply_queue", []):
		if not (item is Dictionary) or not bool(item.get("enabled", true)):
			continue
		var pid := int(item.get("province_id", 1))
		var res: Dictionary = apply_order_panel_action("apply_assault", pid)
		if bool(res.get("ok", res.get("success", false))):
			ok_n += 1
		applied.append({"province_id": pid, "result": res})
	return {"ok": ok_n > 0, "ok_count": ok_n, "applied": applied, "day": day, "empty": applied.is_empty()}


