## E1 war economy primary command — board/convert_to_war/convert_to_civ/stockpile/close (5 steps).
## Live APIs match pure product LIVE_API_BY_STEP; never route via apply_focus.
const WAR_ECONOMY_PRIMARY_STEPS: PackedStringArray = [
	"board", "convert_to_war", "convert_to_civ", "stockpile_check", "close",
]


func _ensure_war_economy_primary_state() -> Dictionary:
	if not peace_state.has("war_economy_primary") or not (peace_state["war_economy_primary"] is Dictionary):
		peace_state["war_economy_primary"] = {
			"applied": [],
			"complete": false,
			"tick": 0,
			"board": {"history": []},
			"convert_to_war": {"history": []},
			"convert_to_civ": {"history": []},
			"stockpile": {"history": []},
			"close": {"history": []},
			"conversion_history": [],
			"majors_done": {},
			"last_live_api": "",
			"converted_lines": 0,
			"reconverted_lines": 0,
			"stockpile_checked": false,
		}
	return (peace_state["war_economy_primary"] as Dictionary).duplicate(true)


func apply_war_economy_primary_command_step_live(step: String = "board", province_id: int = 1) -> Dictionary:
	var st: Dictionary = _ensure_war_economy_primary_state()
	var s := step.strip_edges().to_lower()
	# normalize aliases from pure product
	var aliases := {
		"civ_board": "board",
		"economy_civ_board": "board",
		"open_board": "board",
		"industry_board": "board",
		"war_economy_board": "board",
		"war": "convert_to_war",
		"convert": "convert_to_war",
		"convert_war": "convert_to_war",
		"to_war": "convert_to_war",
		"economy_war_convert": "convert_to_war",
		"war_convert": "convert_to_war",
		"civ": "convert_to_civ",
		"to_civ": "convert_to_civ",
		"convert_civ": "convert_to_civ",
		"demobilize": "convert_to_civ",
		"reconversion": "convert_to_civ",
		"economy_conversion_live": "convert_to_civ",
		"stockpile": "stockpile_check",
		"stockpile_sustain": "stockpile_check",
		"sustain": "stockpile_check",
		"economy_stockpile_sustain": "stockpile_check",
		"stock": "stockpile_check",
		"war_economy_close": "close",
		"conversion_close": "close",
		"package_close": "close",
		"war_economy_conversion_close_day": "close",
		"war_economy_primary_close": "close",
	}
	if aliases.has(s):
		s = str(aliases[s])
	if not WAR_ECONOMY_PRIMARY_STEPS.has(s):
		for cand in WAR_ECONOMY_PRIMARY_STEPS:
			if s in cand or cand in s:
				s = cand
				break
		if not WAR_ECONOMY_PRIMARY_STEPS.has(s):
			s = WAR_ECONOMY_PRIMARY_STEPS[0]
	var leaf := ""
	var major_key := ""
	var live_api := ""
	var live_result: Dictionary = {}

	if s == "board":
		major_key = "war_economy_primary_board"
		leaf = "apply_economy_civ_board"
		live_api = "apply_economy_civ_board"
		var bd: Dictionary = (st.get("board", {}) as Dictionary).duplicate(true)
		var hist_b: Array = (bd.get("history", []) as Array).duplicate() if bd.get("history") is Array else []
		hist_b.append("board")
		bd["history"] = hist_b
		st["board"] = bd
		if has_method("apply_economy_civ_board"):
			live_result = apply_economy_civ_board(province_id)

	elif s == "convert_to_war":
		major_key = "war_economy_primary_convert_to_war"
		leaf = "apply_economy_war_convert"
		live_api = "apply_economy_war_convert"
		var cw: Dictionary = (st.get("convert_to_war", {}) as Dictionary).duplicate(true)
		var hist_w: Array = (cw.get("history", []) as Array).duplicate() if cw.get("history") is Array else []
		hist_w.append("convert_to_war")
		cw["history"] = hist_w
		st["convert_to_war"] = cw
		st["converted_lines"] = int(st.get("converted_lines", 0)) + 1
		if has_method("apply_economy_war_convert"):
			live_result = apply_economy_war_convert(province_id)

	elif s == "convert_to_civ":
		major_key = "war_economy_primary_convert_to_civ"
		leaf = "apply_economy_conversion_live"
		live_api = "apply_economy_conversion_live"
		var cc: Dictionary = (st.get("convert_to_civ", {}) as Dictionary).duplicate(true)
		var hist_c: Array = (cc.get("history", []) as Array).duplicate() if cc.get("history") is Array else []
		hist_c.append("convert_to_civ")
		cc["history"] = hist_c
		st["convert_to_civ"] = cc
		st["reconverted_lines"] = int(st.get("reconverted_lines", 0)) + 1
		if has_method("apply_economy_conversion_live"):
			# reconversion path — live API is apply_economy_conversion_live (not apply_focus)
			live_result = apply_economy_conversion_live("reconversion", province_id)

	elif s == "stockpile_check":
		major_key = "war_economy_primary_stockpile_check"
		leaf = "apply_economy_stockpile_sustain"
		live_api = "apply_economy_stockpile_sustain"
		var sp: Dictionary = (st.get("stockpile", {}) as Dictionary).duplicate(true)
		var hist_s: Array = (sp.get("history", []) as Array).duplicate() if sp.get("history") is Array else []
		hist_s.append("stockpile_check")
		sp["history"] = hist_s
		st["stockpile"] = sp
		st["stockpile_checked"] = true
		if has_method("apply_economy_stockpile_sustain"):
			live_result = apply_economy_stockpile_sustain(province_id)

	elif s == "close":
		major_key = "war_economy_primary_close"
		leaf = "apply_war_economy_conversion_close_day"
		live_api = "apply_war_economy_conversion_close_day"
		var clo: Dictionary = (st.get("close", {}) as Dictionary).duplicate(true)
		var hist_x: Array = (clo.get("history", []) as Array).duplicate() if clo.get("history") is Array else []
		hist_x.append("close")
		clo["history"] = hist_x
		st["close"] = clo
		if has_method("apply_war_economy_conversion_close_day"):
			live_result = apply_war_economy_conversion_close_day(province_id)

	# Honesty: never fall through to apply_focus for war economy primary steps.
	## G0 — WarEconomyDomain owns package state
	var domain_script = load("res://scripts/core/WarEconomyDomain.gd")
	var domain_res: Dictionary = {}
	var live_api_final: String = live_api if not live_api.is_empty() else leaf
	if domain_script != null and domain_script.has_method("apply_primary_step"):
		# preserve any extra history keys already on st
		peace_state["war_economy_primary"] = st.duplicate(true)
		domain_res = domain_script.apply_primary_step(peace_state, s, live_api_final, major_key)
	else:
		st["last_live_api"] = live_api_final
		var applied: Array = (st.get("applied", []) as Array).duplicate() if st.get("applied") is Array else []
		if not applied.has(s):
			applied.append(s)
		st["applied"] = applied
		st["tick"] = int(st.get("tick", 0)) + 1
		var majors_done: Dictionary = (st.get("majors_done", {}) as Dictionary).duplicate(true)
		if not major_key.is_empty():
			majors_done[major_key] = int(majors_done.get(major_key, 0)) + 1
		st["majors_done"] = majors_done
		var complete_fb := applied.size() >= WAR_ECONOMY_PRIMARY_STEPS.size()
		st["complete"] = complete_fb
		peace_state["war_economy_primary"] = st.duplicate(true)
		var we_ticks_fb := int(peace_state.get("war_economy_primary_ticks", 0)) + 1
		peace_state["war_economy_primary_ticks"] = we_ticks_fb
		domain_res = {"applied_n": applied.size(), "complete": complete_fb, "war_economy_primary_ticks": we_ticks_fb, "manager": "GameData.fallback"}
	return {
		"ok": true,
		"live": true,
		"step": s,
		"major": major_key,
		"leaf": leaf,
		"live_api": live_api_final,
		"live_result": live_result,
		"applied_n": int(domain_res.get("applied_n", 0)),
		"complete": bool(domain_res.get("complete", false)),
		"war_economy_primary_ticks": int(domain_res.get("war_economy_primary_ticks", peace_state.get("war_economy_primary_ticks", 0))),
		"province_id": province_id,
		"domain": str(domain_res.get("manager", "WarEconomyDomain")),
		"manager": "GameData.war_economy_primary",
	}


