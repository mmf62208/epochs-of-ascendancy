func apply_trade_relations_primary_step_live(step: String = "trl_catalog", province_id: int = 1) -> Dictionary:
	if not peace_state.has("trade_relations_primary") or not (peace_state["trade_relations_primary"] is Dictionary):
		peace_state["trade_relations_primary"] = {"applied": [], "majors_done": {}, "tick": 0}
	var st: Dictionary = (peace_state["trade_relations_primary"] as Dictionary).duplicate(true)
	var s := step.strip_edges().to_lower()
	var aliases := {
		"catalog": "trl_catalog", "value": "trl_value", "relations": "trl_relations",
		"flags": "trl_flags", "close": "trl_close",
	}
	if aliases.has(s):
		s = str(aliases[s])
	if not TRADE_RELATIONS_PRIMARY_STEPS.has(s):
		s = TRADE_RELATIONS_PRIMARY_STEPS[0]
	var live_api := ""
	var live_result: Dictionary = {}
	var major := ""
	if s == "trl_catalog":
		major = "trl_primary_catalog"
		live_api = "apply_trade_relations_catalog_live"
		live_result = apply_trade_relations_catalog_live(province_id)
	elif s == "trl_value":
		major = "trl_primary_value"
		live_api = "apply_trade_relations_value_live"
		live_result = apply_trade_relations_value_live(province_id)
	elif s == "trl_relations":
		major = "trl_primary_relations"
		live_api = "apply_trade_relations_relations_live"
		live_result = apply_trade_relations_relations_live(province_id)
	elif s == "trl_flags":
		major = "trl_primary_flags"
		live_api = "apply_trade_relations_flags_live"
		live_result = apply_trade_relations_flags_live(province_id)
	elif s == "trl_close":
		major = "trl_primary_close"
		live_api = "apply_trade_relations_close_live"
		live_result = apply_trade_relations_close_live(province_id)
	var step_ok := bool(live_result.get("ok", false))
	var major_credit := major if step_ok else ""
	var domain_script = load("res://scripts/core/TradeRelationsDomain.gd")
	var domain_res: Dictionary = {}
	var live_api_final: String = str(live_api)
	if domain_script != null and domain_script.has_method("apply_primary_step"):
		peace_state["trade_relations_primary"] = st.duplicate(true)
		domain_res = domain_script.apply_primary_step(peace_state, s, live_api_final, major_credit, live_result)
	else:
		var applied_fb: Array = (st.get("applied", []) as Array).duplicate() if st.get("applied") is Array else []
		if not applied_fb.has(s):
			applied_fb.append(s)
		st["applied"] = applied_fb
		st["tick"] = int(st.get("tick", 0)) + 1
		var md_fb: Dictionary = (st.get("majors_done", {}) as Dictionary).duplicate(true)
		if not str(major_credit).is_empty():
			md_fb[major_credit] = int(md_fb.get(major_credit, 0)) + 1
		st["majors_done"] = md_fb
		peace_state["trade_relations_primary"] = st.duplicate(true)
		var ticks_fb := int(peace_state.get("trade_relations_primary_ticks", 0)) + 1
		peace_state["trade_relations_primary_ticks"] = ticks_fb
		domain_res = {"applied_n": applied_fb.size(), "trade_relations_primary_ticks": ticks_fb}
	return {
		"ok": step_ok, "live": true, "step": s, "major": major_credit, "live_api": live_api_final, "leaf": live_api_final,
		"live_result": live_result, "step_ok": step_ok,
		"trade_relations_primary_ticks": int(domain_res.get("trade_relations_primary_ticks", peace_state.get("trade_relations_primary_ticks", 0))),
		"province_id": province_id, "domain": "TradeRelationsDomain",
		"manager": "GameData.trade_relations_primary",
	}


func apply_trade_relations_primary_live(province_id: int = 1) -> Dictionary:
	var results: Array = []
	for step in TRADE_RELATIONS_PRIMARY_STEPS:
		results.append(apply_trade_relations_primary_step_live(step, province_id))
	var majors_ok := 0
	var domain_script2 = load("res://scripts/core/TradeRelationsDomain.gd")
	if domain_script2 != null and domain_script2.has_method("majors_ok_count"):
		majors_ok = int(domain_script2.majors_ok_count(peace_state))
	var dead_n := 0
	var failed_n := 0
	var value_ok := false
	var relations_ok := false
	var flags_ok := false
	for r in results:
		var api := str((r as Dictionary).get("live_api", ""))
		if api.is_empty() or api == "apply_focus":
			dead_n += 1
		if not bool((r as Dictionary).get("step_ok", (r as Dictionary).get("ok", false))):
			failed_n += 1
		var lr: Dictionary = (r as Dictionary).get("live_result", {}) if (r as Dictionary).get("live_result") is Dictionary else {}
		if str((r as Dictionary).get("step", "")) == "trl_value":
			value_ok = bool(lr.get("value_ok", false))
		if str((r as Dictionary).get("step", "")) == "trl_relations":
			relations_ok = bool(lr.get("relations_ok", false))
		if str((r as Dictionary).get("step", "")) == "trl_flags":
			flags_ok = bool(lr.get("flags_ok", false))
	var ok := majors_ok >= 5 and dead_n == 0 and failed_n == 0 and value_ok and relations_ok and flags_ok
	return {
		"ok": ok, "live": true, "majors_ok": majors_ok, "dead_n": dead_n, "failed_n": failed_n,
		"complete": ok, "value_ok": value_ok, "relations_ok": relations_ok, "flags_ok": flags_ok,
		"model": "strategic_compact_ledger",
		"trade_relations_primary_ticks": int(peace_state.get("trade_relations_primary_ticks", 0)),
		"g0_domain": "TradeRelationsDomain",
		"province_id": province_id, "closed": TRADE_RELATIONS_PRIMARY_STEPS,
	}


