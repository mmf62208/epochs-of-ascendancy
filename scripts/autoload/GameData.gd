func _bfs_find_owner_province(tag: String, prefer_port: bool = true) -> int:
	if typeof(MapManager) == TYPE_NIL:
		return -1
	var t := tag.strip_edges().to_upper()
	if not MapManager.has_method("get_provinces_by_owner"):
		return -1
	var ids: Array = MapManager.get_provinces_by_owner(t)
	var fallback := -1
	var n := 0
	for pidv in ids:
		n += 1
		if n > 400:
			break
		var pid := int(pidv)
		var basing: Dictionary = MapManager.get_naval_basing(pid) if MapManager.has_method("get_naval_basing") else {}
		var lv := str(basing.get("level", "none"))
		if lv == "none":
			continue
		if fallback < 0:
			fallback = pid
		if prefer_port and (lv == "port" or lv == "major_base"):
			return pid
		if not prefer_port and lv == "anchorage":
			return pid
	return fallback


