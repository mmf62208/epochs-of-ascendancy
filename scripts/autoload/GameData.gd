func apply_space_depth_sites_live(province_id: int = 1) -> Dictionary:
	var calc = _space_layer_calc()
	if calc == null:
		return {"ok": false, "live": true, "error": "no_calc", "live_api": "apply_space_depth_sites_live"}
	var rep: Dictionary = calc.multi_site_sol_report() as Dictionary
	var tiny: Dictionary = calc.asteroid_caps("tiny") as Dictionary
	var dwarf: Dictionary = calc.asteroid_caps("dwarf") as Dictionary
	var aster_ok: bool = int(dwarf.get("max_pop", 0)) > int(tiny.get("max_pop", 0))
	var hab_mars: Dictionary = calc.habitability_band_for_body("mars") as Dictionary
	var hab_luna: Dictionary = calc.habitability_band_for_body("luna") as Dictionary
	var hab_ok: bool = str(hab_mars.get("band", "")) == "harsh" and str(hab_luna.get("band", "")) == "hostile"
	var sites_ok: bool = bool(rep.get("ok", false)) and aster_ok and hab_ok
	return {
		"ok": sites_ok, "live": true, "sites_ok": sites_ok,
		"sol": rep, "tiny": tiny, "dwarf": dwarf, "hab_mars": hab_mars, "hab_luna": hab_luna,
		"province_id": province_id, "live_api": "apply_space_depth_sites_live",
		"scenario": "multi_site_sol_habitability",
	}


func apply_space_depth_capacity_live(province_id: int = 1) -> Dictionary:
	var calc = _space_layer_calc()
	if calc == null:
		return {"ok": false, "live": true, "error": "no_calc", "live_api": "apply_space_depth_capacity_live"}
	var direct: float = float(calc.loft_cost_mult(false, false, false))
	var via_luna: float = float(calc.loft_cost_mult(true, false, false))
	var via_stack: float = float(calc.loft_cost_mult(false, false, true))
	var loft_ok: bool = via_luna < direct and via_stack <= via_luna
	var strain: Dictionary = calc.colony_strain(10.0, 4.0, 1.0, 2.5) as Dictionary
	var strain_ok: bool = bool(strain.get("command_over", strain.get("mc_over", false))) and bool(strain.get("starvation_risk", false))
	var indep: Dictionary = calc.independence_projection(30.0, false) as Dictionary
	var indep_mit: Dictionary = calc.independence_projection(30.0, true) as Dictionary
	var indep_ok: bool = float(indep.get("generation_years", 0)) >= 20.0 \
		and float(indep_mit.get("autonomy_after_neglect", 99)) < float(indep.get("autonomy_after_neglect", 0))
	var capacity_ok: bool = loft_ok and strain_ok and indep_ok
	return {
		"ok": capacity_ok, "live": true, "capacity_ok": capacity_ok,
		"loft_direct": direct, "loft_via_luna": via_luna, "loft_stack": via_stack,
		"strain": strain, "independence": indep, "independence_mitigated": indep_mit,
		"province_id": province_id, "live_api": "apply_space_depth_capacity_live",
		"scenario": "staging_orbital_command_independence",
	}


func apply_space_depth_power_live(province_id: int = 1) -> Dictionary:
	var calc = _space_layer_calc()
	if calc == null:
		return {"ok": false, "live": true, "error": "no_calc", "live_api": "apply_space_depth_power_live"}
	var weak: Dictionary = calc.compute_space_power_index({
		"fleet_strength": 3.0, "orbital_defenses": 2.0,
	}) as Dictionary
	var strong: Dictionary = calc.compute_space_power_index({
		"fleet_strength": 45.0,
		"orbital_weapons": 3.0,
		"bombardment_capable_ships": 5.0,
		"orbital_defenses": 0.0,
		"stations": 2.0,
		"isr_coverage": 2.0,
		"lift_capacity": 12.0,
	}) as Dictionary
	var sp_ok: bool = bool(strong.get("bombardment_threat", false)) \
		and bool(strong.get("undefended_surface_penalty", false)) \
		and float(strong.get("effective_space_threat", 0.0)) > float(weak.get("space_power_index", 0.0))
	# National power integration: space bombardment raises effective_threat
	var npc = load("res://scripts/national/NationalPowerCalculator.gd")
	var threat_ok := false
	var p_space: Dictionary = {}
	var p_plain: Dictionary = {}
	if npc != null and npc.has_method("compute_power_index"):
		p_plain = npc.compute_power_index({
			"factories": 20, "steel": 500.0, "fuel": 200.0, "tech_flags": [],
		}) as Dictionary
		p_space = npc.compute_power_index({
			"factories": 20, "steel": 500.0, "fuel": 200.0, "tech_flags": [],
			"space_power_index": float(strong.get("space_power_index", 0.0)),
			"bombardment_ships": 5.0,
			"orbital_defenses": 0.0,
		}) as Dictionary
		threat_ok = float(p_space.get("effective_threat", 0.0)) > float(p_plain.get("effective_threat", 0.0)) \
			and bool(p_space.get("space_bombardment_asymmetry", false))
	var spot_near: float = float(calc.spotting_detect_chance(0.3, true, true, false))
	var spot_far: float = float(calc.spotting_detect_chance(3.5, true, false, true))
	var spot_ok: bool = spot_near > spot_far
	var power_ok: bool = sp_ok and threat_ok and spot_ok
	return {
		"ok": power_ok, "live": true, "power_ok": power_ok,
		"space_weak": weak, "space_strong": strong,
		"national_plain": p_plain, "national_space": p_space,
		"spot_near": spot_near, "spot_far": spot_far,
		"province_id": province_id, "live_api": "apply_space_depth_power_live",
		"scenario": "space_power_diplomacy_threat",
	}


