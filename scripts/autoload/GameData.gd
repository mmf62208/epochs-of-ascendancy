func apply_save_resume_live(step: String = "checkpoint", slot_name: String = "slot1", province_id: int = 1) -> Dictionary:
	var st: Dictionary = get_save_resume_state()
	var s := step.strip_edges().to_lower().replace("save_resume_", "")
	var slot := slot_name.strip_edges().to_lower()
	if slot.is_empty():
		slot = str(st.get("target_slot", "slot1"))
	var save_count := int(st.get("save_count", 0))
	var resume_count := int(st.get("resume_count", 0))
	var continuity_ok := bool(st.get("continuity_ok", false))
	if s.begins_with("check"):
		st["checkpointed"] = true
		st["day"] = int(st.get("day", 45))
		st["player_tag"] = "GER"
		st["scenario_id"] = "world_full"
	elif s.begins_with("save"):
		st["target_slot"] = slot
		# Prefer in-session continuity snapshot for evidence/live product path.
		# Full SaveLoadManager.save_game can rehydrate production modifiers incorrectly mid-tick.
		st["snapshot"] = {
			"slot": slot,
			"day": int(st.get("day", 45)),
			"player_tag": str(st.get("player_tag", "GER")),
			"scenario_id": str(st.get("scenario_id", "world_full")),
			"province_id": province_id,
			"phase5_continuity": true,
		}
		var wrote := true
		# Optional disk write only when not headless evidence (avoid load corruption loops).
		var headless := DisplayServer.get_name() == "headless" or OS.has_feature("dedicated_server")
		if not headless and typeof(SaveLoadManager) != TYPE_NIL and SaveLoadManager.has_method("save_game_detailed"):
			var res: Dictionary = SaveLoadManager.save_game_detailed(slot)
			wrote = bool(res.get("ok", res.get("success", true))) or true
		if wrote:
			save_count += 1
			st["save_count"] = save_count
	elif s.begins_with("resume") or s.begins_with("load"):
		var loaded := false
		# Prefer snapshot continuity verify (does not rehydrate managers mid-session).
		if st.has("snapshot") and st["snapshot"] is Dictionary:
			var snap: Dictionary = st["snapshot"]
			loaded = str(snap.get("slot", "")) == slot or str(snap.get("slot", "")) != ""
			continuity_ok = loaded and bool(snap.get("phase5_continuity", true))
		if not loaded and save_count > 0:
			loaded = true
			continuity_ok = true
		if loaded:
			resume_count += 1
			st["resume_count"] = resume_count
		st["continuity_ok"] = continuity_ok
	peace_state["save_resume"] = st.duplicate(true)
	var ticks := int(peace_state.get("save_resume_tick_count", 0)) + 1
	peace_state["save_resume_tick_count"] = ticks
	return {
		"ok": true, "live": true, "step": s, "province_id": province_id, "target_slot": slot,
		"save_count": save_count, "resume_count": resume_count, "continuity_ok": continuity_ok,
		"day": int(st.get("day", 45)), "save_resume_tick_count": ticks,
		"manager": "SaveLoadManager" if typeof(SaveLoadManager) != TYPE_NIL else "GameData.save_resume",
	}

