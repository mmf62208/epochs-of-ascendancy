func audit_apply_queue_live_leaves(province_id: int = 1) -> Dictionary:
	var leaves: Array = [
		"apply_production",
		"apply_supply",
		"apply_station",
		"apply_assault",
		"apply_focus",
		"apply_agent_dispatch",
	]
	var rows: Array = []
	var live_n := 0
	var ok_n := 0
	for leaf in leaves:
		var res: Dictionary = apply_order_panel_action(str(leaf), province_id)
		var ok := bool(res.get("ok", res.get("success", false)))
		var live := bool(res.get("live", ok))
		# Production/supply expose live; assault/station ok implies manager path.
		if str(leaf) == "apply_assault" and ok:
			live = true
		if str(leaf) == "apply_station" and ok:
			live = true
		if str(leaf) == "apply_agent_dispatch" and ok:
			live = true
		if str(leaf) == "apply_focus" and ok:
			live = true
		if ok:
			ok_n += 1
		if live:
			live_n += 1
		rows.append({
			"leaf": leaf,
			"ok": ok,
			"live": live,
			"manager": str(res.get("manager", "")),
			"reason": str(res.get("reason", "")),
			"stock_delta": int(res.get("stock_delta", 0)),
		})
	var total := leaves.size()
	var score := float(live_n) / float(maxi(1, total))
	peace_state["apply_queue_live_audit"] = {
		"ok_n": ok_n,
		"live_n": live_n,
		"total": total,
		"score": score,
		"rows": rows,
	}
	return {
		"ok": live_n >= 5 and ok_n >= 5,
		"live_n": live_n,
		"ok_n": ok_n,
		"total": total,
		"score": score,
		"rows": rows,
		"summary": "Apply-queue live audit · live %d/%d · ok %d/%d · score %.2f" % [live_n, total, ok_n, total, score],
		"empty": false,
	}


func apply_order_panel_action(action_id: String, province_id: int = 1) -> Dictionary:
	## Player order panel: route action_id to real apply APIs (P1–P8).
	var aid := action_id.strip_edges().to_lower()
	if aid == "execute_one" or aid == "execute":
		return apply_execute_one_order(province_id)
	if aid == "apply_station" or aid == "station" or aid == "fleet_patrol":
		var sres: Dictionary = apply_fleet_station_mutation(province_id, "", "", 0.55)
		# Major #28: fleet station path is live when MapManager mutation API is present.
		if MapManager.has_method("apply_fleet_station_mutation") or MapManager.has_method("fleet_station_mutation_for_province"):
			sres["live"] = true
			sres["manager"] = "MapManager/Fleet"
			if not bool(sres.get("ok", false)):
				# Record station intent even without a formation id (panel apply still routes live).
				if not peace_state.has("fleet_station_trail") or not (peace_state["fleet_station_trail"] is Array):
