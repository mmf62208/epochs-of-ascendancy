func apply_space_colony_primary_step_live(step: String = "sco_catalog", province_id: int = 1) -> Dictionary:
	if not peace_state.has("space_colony_primary") or not (peace_state["space_colony_primary"] is Dictionary):
		peace_state["space_colony_primary"] = {"applied": [], "majors_done": {}, "tick": 0}
	var st: Dictionary = (peace_state["space_colony_primary"] as Dictionary).duplicate(true)
	var s := step.strip_edges().to_lower()
	var aliases := {
		"catalog": "sco_catalog", "relations": "sco_relations", "independence": "sco_independence",
		"combat": "sco_combat", "close": "sco_close",
	}
	if aliases.has(s):
		s = str(aliases[s])
	if not SPACE_COLONY_PRIMARY_STEPS.has(s):
		s = SPACE_COLONY_PRIMARY_STEPS[0]
	var live_api := ""
	var live_result: Dictionary = {}
	var major := ""
	if s == "sco_catalog":
		major = "sco_primary_catalog"
		live_api = "apply_space_colony_catalog_live"
		live_result = apply_space_colony_catalog_live(province_id)
	elif s == "sco_relations":
		major = "sco_primary_relations"
		live_api = "apply_space_colony_relations_live"
		live_result = apply_space_colony_relations_live(province_id)
	elif s == "sco_independence":
		major = "sco_primary_independence"
		live_api = "apply_space_colony_independence_live"
		live_result = apply_space_colony_independence_live(province_id)
	elif s == "sco_combat":
		major = "sco_primary_combat"
		live_api = "apply_space_colony_combat_live"
		live_result = apply_space_colony_combat_live(province_id)
	elif s == "sco_close":
		major = "sco_primary_close"
		live_api = "apply_space_colony_close_live"
		live_result = apply_space_colony_close_live(province_id)
	var step_ok := bool(live_result.get("ok", false))
	var major_credit := major if step_ok else ""
	var domain_script = load("res://scripts/core/SpaceColonyDomain.gd")
	var domain_res: Dictionary = {}
	var live_api_final: String = str(live_api)
	if domain_script != null and domain_script.has_method("apply_primary_step"):
		peace_state["space_colony_primary"] = st.duplicate(true)
		domain_res = domain_script.apply_primary_step(peace_state, s, live_api_final, major_credit, live_result)
	else:
		var applied_fb: Array = (st.get("applied", []) as Array).duplicate() if st.get("applied") is Array else []
		if not applied_fb.has(s):
			applied_fb.append(s)
		st["applied"] = applied_fb
		st["tick"] = int(st.get("tick", 0)) + 1
		var md_fb: Dictionary = (st.get("majors_done", {}) as Dictionary).duplicate(true)
		if not str(major_credit).is_empty():
			md_fb[major_credit] = int(md_fb.get(major_credit, 0)) + 1
		st["majors_done"] = md_fb
		peace_state["space_colony_primary"] = st.duplicate(true)
		var ticks_fb := int(peace_state.get("space_colony_primary_ticks", 0)) + 1
		peace_state["space_colony_primary_ticks"] = ticks_fb
		domain_res = {"applied_n": applied_fb.size(), "space_colony_primary_ticks": ticks_fb}
	return {
		"ok": step_ok, "live": true, "step": s, "major": major_credit, "live_api": live_api_final, "leaf": live_api_final,
		"live_result": live_result, "step_ok": step_ok,
		"space_colony_primary_ticks": int(domain_res.get("space_colony_primary_ticks", peace_state.get("space_colony_primary_ticks", 0))),
		"province_id": province_id, "domain": "SpaceColonyDomain",
		"manager": "GameData.space_colony_primary",
	}


func apply_space_colony_primary_live(province_id: int = 1) -> Dictionary:
	var results: Array = []
	for step in SPACE_COLONY_PRIMARY_STEPS:
		results.append(apply_space_colony_primary_step_live(step, province_id))
	var majors_ok := 0
	var domain_script2 = load("res://scripts/core/SpaceColonyDomain.gd")
