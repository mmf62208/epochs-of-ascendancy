	if tag.is_empty():
		tag = "GER"
	var st: Dictionary = get_manpower_cohort_state(tag)
	var s := step.strip_edges().to_lower().replace("manpower_cohort_", "")
	var pop := float(st.get("population_pool", 100000.0))
	var eligible := float(st.get("eligible", pop * 0.72))
	var active := float(st.get("active", 8000.0))
	var ready := float(st.get("ready", 20000.0))
	var strategic := float(st.get("strategic", 44000.0))
	var mobilized := float(st.get("mobilized", 0.0))
	if s.begins_with("cohort"):
		eligible = pop * 0.75
		st["youth"] = pop * 0.22
		st["prime"] = pop * 0.38
		st["veteran"] = pop * 0.28
		st["elder"] = pop * 0.12
	elif s.begins_with("reserve"):
		active = minf(eligible * 0.25, maxf(active, 5000.0) + 1500.0)
		ready = minf(eligible * 0.35, maxf(ready, 10000.0) + 2000.0)
		strategic = maxf(0.0, eligible - active - ready)
	elif s.begins_with("mobil"):
		var draft := minf(active * 0.85, active)
		mobilized += draft
		active = maxf(0.0, active - draft * 0.4)
		ready = maxf(0.0, ready - draft * 0.2)
	var readiness := clampf((active + ready * 0.7 + strategic * 0.35) / maxf(1.0, eligible), 0.0, 1.0)
	st["eligible"] = eligible
	st["active"] = active
	st["ready"] = ready
	st["strategic"] = strategic
	st["mobilized"] = mobilized
	st["readiness"] = readiness
	st["tick_count"] = int(st.get("tick_count", 0)) + 1
	if not peace_state.has("manpower_cohort") or not (peace_state["manpower_cohort"] is Dictionary):
		peace_state["manpower_cohort"] = {}
	(peace_state["manpower_cohort"] as Dictionary)[tag] = st.duplicate(true)
	var ticks := int(peace_state.get("manpower_cohort_tick_count", 0)) + 1
	peace_state["manpower_cohort_tick_count"] = ticks
	return {
		"ok": true, "live": true, "step": s, "country_tag": tag,
		"eligible": eligible, "active": active, "ready": ready, "strategic": strategic,
		"mobilized": mobilized, "readiness": readiness, "manpower_cohort_tick_count": ticks,
		"manager": "GameData.manpower_cohort",
	}

