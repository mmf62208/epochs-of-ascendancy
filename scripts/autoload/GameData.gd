func format_day_package_apply_audit_plain() -> String:
	## Non-mutating skim: panel section action_ids + core mutations are assumed live-routed.
	## Structural dead-button proof is pure `day_package_apply_audit` on shipped GD sources (CI).
	var ids: Array = []
	var plan: Dictionary = MapPolishFormatters.order_panel_section_plan(true, 2)
	for sec in plan.get("sections", []):
		if not (sec is Dictionary):
			continue
		for a in sec.get("actions", []):
			if a is Dictionary:
				var aid := str(a.get("action_id", ""))
				if not aid.is_empty() and aid not in ids:
					ids.append(aid)
	for extra in ["apply_supply", "apply_station", "apply_production", "apply_hh_commit", "apply_focus"]:
		if extra not in ids:
			ids.append(extra)
	var d: Dictionary = MapPolishFormatters.day_package_apply_audit(ids, "apply_order_panel_action live")
	return str(d.get("plain", d.get("summary", "")))


