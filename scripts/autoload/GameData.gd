func apply_equipment_flow_catalog_live(province_id: int = 1) -> Dictionary:
	var ok: bool = typeof(ProductionManager) != TYPE_NIL \
		and ProductionManager.has_method("create_equipment_flow") \
		and ProductionManager.has_method("interdict_equipment_flow") \
		and ProductionManager.has_method("advance_equipment_flows") \
		and ProductionManager.has_method("ship_and_reinforce_unit")
	var calc = load("res://scripts/production/EquipmentFlowCalculator.gd")
	ok = ok and calc != null
	return {"ok": ok, "live": true, "province_id": province_id, "live_api": "apply_equipment_flow_catalog_live", "model": "equipment_flow_compact_ledger"}


func apply_equipment_flow_create_live(province_id: int = 1) -> Dictionary:
	if typeof(ProductionManager) == TYPE_NIL:
		return {"ok": false, "live": true, "error": "no_pm", "live_api": "apply_equipment_flow_create_live"}
	if ProductionManager.has_method("reset_equipment_flows"):
		ProductionManager.reset_equipment_flows()
	ProductionManager.add_to_country_equipment_stockpile("USA", "medium_tank_mk4", 12)
	var before := ProductionManager.get_country_equipment_amount("USA", "medium_tank_mk4")
	var res: Dictionary = ProductionManager.create_equipment_flow(
		"USA", "medium_tank_mk4", 5, province_id, province_id + 1, "usa_3rd_army", "rail",
		{"hops": 2, "corridor_risk": 0.08},
	)
	var after := ProductionManager.get_country_equipment_amount("USA", "medium_tank_mk4")
	var flow: Dictionary = res.get("flow", {}) if res.get("flow") is Dictionary else {}
	var ok: bool = bool(res.get("ok", false)) and after == before - 5 \
		and str(flow.get("symbol", "")) == "train" and str(flow.get("mode", "")) == "rail"
	return {
		"ok": ok, "live": true, "create_ok": ok, "before": before, "after": after,
		"flow": flow, "province_id": province_id, "live_api": "apply_equipment_flow_create_live",
		"model": "equipment_flow_compact_ledger",
	}


func apply_equipment_flow_interdict_live(province_id: int = 1) -> Dictionary:
	if typeof(ProductionManager) == TYPE_NIL:
		return {"ok": false, "live": true, "error": "no_pm", "live_api": "apply_equipment_flow_interdict_live"}
	var flows: Array = ProductionManager.get_active_equipment_flows("USA")
	var fid := ""
	if flows.size() > 0 and flows[0] is Dictionary:
		fid = str((flows[0] as Dictionary).get("flow_id", ""))
	if fid.is_empty():
		ProductionManager.add_to_country_equipment_stockpile("USA", "fighter_p40", 8)
		var c: Dictionary = ProductionManager.create_equipment_flow(
			"USA", "fighter_p40", 4, 1, 2, "usa_air_wing_1", "airlift", {"corridor_risk": 0.15},
		)
		fid = str(c.get("flow_id", ""))
	var before_f: Dictionary = ProductionManager.get_equipment_flow(fid)
	var rem0 := int(before_f.get("amount_remaining", 0))
	var hit: Dictionary = ProductionManager.interdict_equipment_flow(fid, "partisan", 0.45)
	var rem1 := int(hit.get("remaining", rem0))
	var ok: bool = bool(hit.get("ok", false)) and int(hit.get("lost", 0)) > 0 and rem1 < rem0 \
		and not str(hit.get("plain", "")).is_empty()
	return {
		"ok": ok, "live": true, "interdict_ok": ok, "hit": hit, "rem0": rem0, "rem1": rem1,
		"province_id": province_id, "live_api": "apply_equipment_flow_interdict_live",
		"model": "equipment_flow_compact_ledger",
	}


func apply_equipment_flow_deliver_live(province_id: int = 1) -> Dictionary:
	if typeof(ProductionManager) == TYPE_NIL:
		return {"ok": false, "live": true, "error": "no_pm", "live_api": "apply_equipment_flow_deliver_live"}
	ProductionManager.add_to_country_equipment_stockpile("USA", "light_tank_m3", 10)
	ProductionManager.clear_unit_equipment_stock("usa_armor_demo")
	var ship: Dictionary = ProductionManager.ship_and_reinforce_unit(
