		if str((r as Dictionary).get("step", "")) == "tpi_spy":
			spy_ok = bool(lr.get("spy_ok", false))
	var ok := majors_ok >= 5 and dead_n == 0 and failed_n == 0 and power_ok and transit_ok and spy_ok
