	)
	var received := int(ship.get("received", 0))
	var board: Dictionary = ProductionManager.get_equipment_flow_board("USA")
	# After force deliver, active may be 0; board still ok
	var ok: bool = bool(ship.get("ok", false)) and received >= 1 and bool(board.get("ok", false))
	return {
