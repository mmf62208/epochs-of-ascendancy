func apply_strategic_ai_daily_apply(province_id: int = 1) -> Dictionary:
	if MapManager.has_method("apply_strategic_ai_daily_step_for_province"):
		var res: Dictionary = MapManager.apply_strategic_ai_daily_step_for_province(province_id, "apply_ai")
		# Ensure logistics doctrine is always present on apply leaf
		if not bool(res.get("logistics_ok", false)) and MapManager.has_method("apply_ai_logistics_doctrine_day"):
			var prod: Dictionary = res.get("product", {}) if res.get("product") is Dictionary else {}
			var logistics: Dictionary = MapManager.apply_ai_logistics_doctrine_day(
				str(prod.get("player_tag", "GER")), prod, province_id,
			)
			res["logistics"] = logistics
			res["logistics_ok"] = bool(logistics.get("logistics_ok", false))
			res["ok"] = bool(res.get("ok", false)) or bool(res.get("logistics_ok", false))
		return res
	var plan: Dictionary = MapPolishFormatters.execute_strategic_ai_daily_step("apply_ai", province_id)
	var out: Dictionary = _apply_day_queue(plan, province_id)
	if MapManager.has_method("apply_ai_logistics_doctrine_day"):
		var logistics2: Dictionary = MapManager.apply_ai_logistics_doctrine_day("GER", {}, province_id)
		out["logistics"] = logistics2
		out["logistics_ok"] = bool(logistics2.get("logistics_ok", false))
	return out


