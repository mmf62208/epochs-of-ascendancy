		if ents is Array:
			entry_n = (ents as Array).size()
	return {
		"ok": complete and entry_n >= 1, "live": true, "majors_ok": majors_ok, "dead_n": dead_n,
		"complete": complete, "entry_n": entry_n, "applied_n": results.size(),
		"battle_aar_primary_ticks": int(peace_state.get("battle_aar_primary_ticks", 0)),
		"g0_domain": "BattleAarDomain",
