func apply_combat_depth_primary_step_live(step: String = "cd_catalog", province_id: int = 1) -> Dictionary:
	if not peace_state.has("combat_depth_primary") or not (peace_state["combat_depth_primary"] is Dictionary):
		peace_state["combat_depth_primary"] = {"applied": [], "majors_done": {}, "tick": 0}
	var st: Dictionary = (peace_state["combat_depth_primary"] as Dictionary).duplicate(true)
	var s := step.strip_edges().to_lower()
	if not COMBAT_DEPTH_PRIMARY_STEPS.has(s):
		s = COMBAT_DEPTH_PRIMARY_STEPS[0]
	var live_api := ""
	var live_result: Dictionary = {}
	var major := ""
	if s == "cd_catalog":
		major = "cd_primary_catalog"; live_api = "apply_combat_depth_catalog_live"; live_result = apply_combat_depth_catalog_live(province_id)
	elif s == "cd_deep":
		major = "cd_primary_deep"; live_api = "apply_combat_depth_deep_live"; live_result = apply_combat_depth_deep_live(province_id)
	elif s == "cd_logistics":
		major = "cd_primary_logistics"; live_api = "apply_combat_depth_logistics_live"; live_result = apply_combat_depth_logistics_live(province_id)
	elif s == "cd_joint":
		major = "cd_primary_joint"; live_api = "apply_combat_depth_joint_live"; live_result = apply_combat_depth_joint_live(province_id)
	elif s == "cd_close":
		major = "cd_primary_close"; live_api = "apply_combat_depth_close_live"; live_result = apply_combat_depth_close_live(province_id)
	var step_ok := bool(live_result.get("ok", false))
	var major_credit := major if step_ok else ""
	var domain_script = load("res://scripts/core/CombatDepthDomain.gd")
	if domain_script != null and domain_script.has_method("apply_primary_step"):
		peace_state["combat_depth_primary"] = st.duplicate(true)
		domain_script.apply_primary_step(peace_state, s, live_api, major_credit, live_result)
	else:
		var applied_fb: Array = (st.get("applied", []) as Array).duplicate() if st.get("applied") is Array else []
		if not applied_fb.has(s):
			applied_fb.append(s)
		st["applied"] = applied_fb
		var md_fb: Dictionary = (st.get("majors_done", {}) as Dictionary).duplicate(true)
		if not major_credit.is_empty():
			md_fb[major_credit] = int(md_fb.get(major_credit, 0)) + 1
		st["majors_done"] = md_fb
		peace_state["combat_depth_primary"] = st.duplicate(true)
	return {"ok": step_ok, "live": true, "step": s, "major": major_credit, "live_api": live_api, "live_result": live_result, "step_ok": step_ok, "province_id": province_id}


func apply_combat_depth_primary_live(province_id: int = 1) -> Dictionary:
	var results: Array = []
	for step in COMBAT_DEPTH_PRIMARY_STEPS:
		results.append(apply_combat_depth_primary_step_live(step, province_id))
	var majors_ok := 0
