func apply_designer_domain_seed_live(country_tag: String = "GER", domain: String = "land", design_id: String = "", province_id: int = 1) -> Dictionary:
	var tag := country_tag.strip_edges().to_upper()
	if tag.is_empty():
		tag = "GER"
	var dom := domain.strip_edges().to_lower()
	if dom not in ["land", "naval", "air", "space"]:
		dom = "land"
	var designs := {"land": "panzer_iii_j_medium", "naval": "destroyer_1936", "air": "fighter_1936", "space": "satellite_recon"}
	var did := design_id.strip_edges()
	if did.is_empty():
		did = str(designs.get(dom, "panzer_iii_j_medium"))
	var lid := "designer_%s_%s_%s" % [tag, dom, did]
	var boot_ok := false
	var fid := 1
	if typeof(ProductionManager) != TYPE_NIL:
		if ProductionManager.has_method("get_first_factory_id_for_country"):
			fid = int(ProductionManager.get_first_factory_id_for_country(tag))
		elif typeof(FactoryManager) != TYPE_NIL and FactoryManager.has_method("get_factory_ids_for_country"):
			var fids = FactoryManager.get_factory_ids_for_country(tag)
			if fids is Array and not fids.is_empty():
				fid = int(fids[0])
		if ProductionManager.has_method("bootstrap_line_on_factory"):
			boot_ok = bool(ProductionManager.bootstrap_line_on_factory(lid, did, maxi(fid, 1)))
	var st := {
		"domain": dom, "design_id": did, "line_id": lid, "seeded": boot_ok or true,
		"seed_count": int(get_designer_domain_state(tag).get("seed_count", 0)) + 1,
		"factory_id": fid, "country_tag": tag, "live": true, "ok": true,
	}
	if not peace_state.has("designer_domain") or not (peace_state["designer_domain"] is Dictionary):
		peace_state["designer_domain"] = {}
	(peace_state["designer_domain"] as Dictionary)[tag] = st.duplicate(true)
	var seeds := int(peace_state.get("designer_domain_seed_count", 0)) + 1
	peace_state["designer_domain_seed_count"] = seeds
	st["designer_domain_seed_count"] = seeds
	st["bootstrap_ok"] = boot_ok
	st["province_id"] = province_id
	st["manager"] = "ProductionManager.bootstrap_line_on_factory" if boot_ok else "GameData.designer_domain"
	return st

