func _apply_day_queue(day: Dictionary, province_id: int = 1) -> Dictionary:
	if bool(day.get("empty", false)):
		return {"ok": false, "reason": "empty day", "day": day}
	var applied: Array = []
	var ok_n := 0
	for item in day.get("apply_queue", []):
		if not (item is Dictionary) or not bool(item.get("enabled", true)):
			continue
		var aid := str(item.get("action_id", ""))
		if aid.is_empty():
			continue
		var pid := int(item.get("province_id", province_id))
		if pid < 0:
			pid = province_id
		# Avoid re-entering day packages; only leaf apply routes
		if aid.ends_with("_day") and aid != "refresh_queue":
			continue
		var res: Dictionary = apply_order_panel_action(aid, maxi(pid, 1))
		if bool(res.get("ok", res.get("success", false))):
			ok_n += 1
		applied.append({"action_id": aid, "result": res})
	return {
		"ok": ok_n > 0 or not applied.is_empty(),
		"ok_count": ok_n,
		"applied": applied,
		"day": day,
		"queue_size": applied.size(),
		"empty": false,
	}


