func apply_hotseat_session_lock_audit_live(province_id: int = 1) -> Dictionary:
	if typeof(SessionPlayers) == TYPE_NIL:
		return {"ok": false, "error": "no_SessionPlayers", "live": false, "empty": true}
	if SessionPlayers.slots.is_empty() and SessionPlayers.has_method("setup_default_hotseat"):
		SessionPlayers.setup_default_hotseat()
	var active := str(SessionPlayers.get_active_tag()) if SessionPlayers.has_method("get_active_tag") else ""
	var allow_self := false
	var deny_other := true
	var other_tag := ""
	if SessionPlayers.has_method("is_command_allowed_for_tag"):
		allow_self = bool(SessionPlayers.is_command_allowed_for_tag(active)) if not active.is_empty() else false
		for s in SessionPlayers.slots:
			if s is Dictionary:
				var t := str((s as Dictionary).get("tag", "")).to_upper()
				if not t.is_empty() and t != active.to_upper():
					other_tag = t
					break
		if not other_tag.is_empty():
			deny_other = not bool(SessionPlayers.is_command_allowed_for_tag(other_tag))
	else:
		allow_self = not active.is_empty()
	var lock_ok := allow_self and deny_other
	return {
		"ok": lock_ok, "live": true, "empty": false, "active_tag": active, "other_tag": other_tag,
		"allow_self": allow_self, "deny_other": deny_other, "lock_ok": lock_ok, "province_id": province_id,
		"manager": "SessionPlayers.lock_audit",
	}


