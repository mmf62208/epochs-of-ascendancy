func apply_reinforcement_depth_non_instant_live(province_id: int = 1) -> Dictionary:
	if typeof(ProductionManager) == TYPE_NIL or not ProductionManager.has_method("run_non_instant_reinforce_demo"):
		return {"ok": false, "live": true, "error": "no_pm", "live_api": "apply_reinforcement_depth_non_instant_live"}
	var demo: Dictionary = ProductionManager.run_non_instant_reinforce_demo(
		"USA", "medium_tank_mk4", 3,
		{
			"from_province": province_id, "to_province": province_id + 1,
			"year": 1916, "mode": "rail", "hops": 3, "distance_km": 1200.0,
			"depot_fill": 0.85, "reset": true,
		},
	)
	var non_instant_ok: bool = bool(demo.get("non_instant_ok", false)) and bool(demo.get("ok", false)) \
		and float(demo.get("days_total", 0)) >= 0.75 and bool(demo.get("still_active", false)) \
		and int(demo.get("unit_received", -1)) == 0
	# Contrast: force_deliver path receives immediately (proves we chose non-instant deliberately)
	ProductionManager.add_to_country_equipment_stockpile("USA", "light_tank_m3", 6)
	ProductionManager.clear_unit_equipment_stock("usa_instant_contrast")
	var instant: Dictionary = ProductionManager.ship_and_reinforce_unit(
		"USA", "usa_instant_contrast", "light_tank_m3", 2, "rail",
		{"force_deliver": true, "from_province": province_id, "to_province": province_id + 1, "hops": 1},
	)
	var contrast_ok: bool = bool(instant.get("ok", false)) and int(instant.get("received", 0)) >= 1
	var ok := non_instant_ok and contrast_ok
	return {
		"ok": ok, "live": true, "non_instant_ok": ok, "demo": demo, "instant": instant,
		"province_id": province_id, "live_api": "apply_reinforcement_depth_non_instant_live",
		"model": "reinforce_experience_logistics_ledger",
	}


func apply_reinforcement_depth_combat_xp_live(province_id: int = 1) -> Dictionary:
	if typeof(ProductionManager) == TYPE_NIL or not ProductionManager.has_method("evaluate_combat_experience_mult"):
		return {"ok": false, "live": true, "error": "no_pm", "live_api": "apply_reinforcement_depth_combat_xp_live"}
	var eval: Dictionary = ProductionManager.evaluate_combat_experience_mult("")
	var combat_xp_ok: bool = bool(eval.get("combat_xp_ok", false)) \
		and float(eval.get("green_mult", 1.0)) < 0.9 \
		and float(eval.get("vet_mult", 1.0)) > 1.1
	# Live CombatResolver path when available
	var resolver_ok := true
	var resolver = load("res://scripts/combat/CombatResolver.gd")
	if resolver != null:
		# Script class — check source hooks already dualled via evaluate; optional formation probe
		if typeof(LeaderManager) != TYPE_NIL and "formations" in LeaderManager:
			var fid := ""
			for k in LeaderManager.formations.keys():
				var ff = LeaderManager.formations[k]
				if ff != null:
					fid = str(k)
					break
			if not fid.is_empty():
				ProductionManager.set_formation_combat_experience(fid, 90.0)
				var ev2: Dictionary = ProductionManager.evaluate_combat_experience_mult(fid)
				resolver_ok = float(ev2.get("formation_mult", 1.0)) > 1.05
				ProductionManager.set_formation_combat_experience(fid, 15.0)
				var ev3: Dictionary = ProductionManager.evaluate_combat_experience_mult(fid)
				resolver_ok = resolver_ok and float(ev3.get("formation_mult", 1.0)) < 0.92
	var ok := combat_xp_ok and resolver_ok
	return {
		"ok": ok, "live": true, "combat_xp_ok": ok, "eval": eval,
		"province_id": province_id, "live_api": "apply_reinforcement_depth_combat_xp_live",
		"model": "reinforce_experience_logistics_ledger",
	}


func apply_reinforcement_depth_policy_live(province_id: int = 1) -> Dictionary:
	if typeof(ProductionManager) == TYPE_NIL or not ProductionManager.has_method("apply_training_policy_decision"):
		return {"ok": false, "live": true, "error": "no_pm", "live_api": "apply_reinforcement_depth_policy_live"}
	var policies: Array = ProductionManager.list_training_policies()
	var crash: Dictionary = ProductionManager.apply_training_policy_decision("USA", "wartime_crash")
	var vol: Dictionary = ProductionManager.apply_training_policy_decision("USA", "volunteer_cadre")
	var clone: Dictionary = ProductionManager.apply_training_policy_decision("USA", "clone_batch_fill")
	var crash_xp := float(crash.get("recruit_xp_after", 0))
	var vol_xp := float(vol.get("recruit_xp_after", 0))
	var clone_xp := float(clone.get("recruit_xp_after", 0))
	# Quantity vs quality: volunteer higher XP than crash; clone lowest XP highest qty intent
	var policy_ok: bool = policies.size() >= 8 \
		and bool(crash.get("ok", false)) and bool(vol.get("ok", false)) and bool(clone.get("ok", false)) \
		and vol_xp > crash_xp + 20.0 and crash_xp > clone_xp \
		and str(vol.get("policy_after", "")) == "volunteer_cadre"
	# Manpower reinforce respects policy recruit XP
	if typeof(LeaderManager) != TYPE_NIL and "formations" in LeaderManager:
		var fid := ""
		for k in LeaderManager.formations.keys():
			if LeaderManager.formations[k] != null:
				fid = str(k)
				break
		if not fid.is_empty():
			ProductionManager.set_country_training_policy("USA", "wartime_crash")
			ProductionManager.set_formation_combat_experience(fid, 80.0)
			var f0 = LeaderManager.get_formation(fid)
			if f0 != null and "strength" in f0:
				f0.strength = 0.5
			var man: Dictionary = ProductionManager.apply_manpower_reinforce_with_experience(
				fid, 0.15, {"policy_id": "wartime_crash", "force_full": true},
			)
			policy_ok = policy_ok and bool(man.get("ok", false)) \
				and float(man.get("recruit_xp", 99)) <= 15.0 \
				and float(man.get("combat_experience_after", 100)) < float(man.get("combat_experience_before", 0))
	return {
		"ok": policy_ok, "live": true, "policy_ok": policy_ok,
		"policies_n": policies.size(), "crash_xp": crash_xp, "vol_xp": vol_xp, "clone_xp": clone_xp,
		"province_id": province_id, "live_api": "apply_reinforcement_depth_policy_live",
		"model": "reinforce_experience_logistics_ledger",
	}


func apply_reinforcement_depth_era_live(province_id: int = 1) -> Dictionary:
