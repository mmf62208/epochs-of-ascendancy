const SPACE_OPS_PRIMARY_STEPS: PackedStringArray = [
	"spo_catalog", "spo_claim", "spo_habitat", "spo_flow", "spo_close",
]


func apply_space_ops_catalog_live(province_id: int = 1) -> Dictionary:
	var has_slm: bool = typeof(SpaceLayerManager) != TYPE_NIL
	var has_claim: bool = has_slm and SpaceLayerManager.has_method("claim_site")
	var has_hab: bool = has_slm and SpaceLayerManager.has_method("build_habitat")
	var has_flow: bool = has_slm and SpaceLayerManager.has_method("create_space_flow")
	var has_month: bool = has_slm and SpaceLayerManager.has_method("process_monthly_space")
	var ok: bool = has_claim and has_hab and has_flow and has_month
	return {
		"ok": ok, "live": true, "model": "orbital_compact_ledger",
		"claim_api": has_claim, "habitat_api": has_hab, "flow_api": has_flow, "monthly_api": has_month,
		"province_id": province_id, "live_api": "apply_space_ops_catalog_live",
	}


func apply_space_ops_claim_live(province_id: int = 1) -> Dictionary:
	if typeof(SpaceLayerManager) == TYPE_NIL:
		return {"ok": false, "live": true, "error": "no_slm", "live_api": "apply_space_ops_claim_live"}
	if SpaceLayerManager.has_method("reset_for_new_scenario"):
		SpaceLayerManager.reset_for_new_scenario()
	SpaceLayerManager.set_nation_capacity("USA", 12.0, 10.0)
	var res: Dictionary = SpaceLayerManager.claim_site("luna_south_pole", "USA", 1978, {
		"require_lift": true, "lift_cost": 1.0,
	})
	var claim_ok: bool = bool(res.get("ok", false))
	var site: Dictionary = res.get("site", {}) as Dictionary if res.get("site") is Dictionary else {}
	var owner_ok: bool = str(site.get("owner_tag", "")) == "USA"
	# Fail path: no lift
	SpaceLayerManager.set_nation_capacity("BEL", 0.0, 5.0)
	var fail: Dictionary = SpaceLayerManager.claim_site("luna_farside", "BEL", 1978, {"require_lift": true, "lift_cost": 1.0})
	var fail_ok: bool = not bool(fail.get("ok", true)) and str(fail.get("error", "")) == "insufficient_lift"
	var ok: bool = claim_ok and owner_ok and fail_ok
	return {
		"ok": ok, "live": true, "claim_ok": ok,
		"claim": res, "fail_lift": fail,
		"province_id": province_id, "live_api": "apply_space_ops_claim_live",
		"scenario": "claim_site_lift_gate",
	}


func apply_space_ops_habitat_live(province_id: int = 1) -> Dictionary:
	if typeof(SpaceLayerManager) == TYPE_NIL:
		return {"ok": false, "live": true, "error": "no_slm", "live_api": "apply_space_ops_habitat_live"}
	SpaceLayerManager.set_nation_capacity("USA", 12.0, 10.0)
	if not SpaceLayerManager.get_site("luna_south_pole").get("owner_tag", "") == "USA":
		SpaceLayerManager.claim_site("luna_south_pole", "USA", 1978, {"require_lift": false})
	var hab: Dictionary = SpaceLayerManager.build_habitat("luna_south_pole", "USA", "settlement")
	var hab_ok: bool = bool(hab.get("ok", false))
	var board: Dictionary = SpaceLayerManager.get_nation_space_board("USA")
	var cmd_used: float = float(board.get("command_used", 0.0))
	var cmd_ok: bool = cmd_used >= 2.9  # settlement costs 3
	var rp: float = float(SpaceLayerManager.total_station_research_bonus("USA"))
	# Build orbital station for RP bonus
	SpaceLayerManager.claim_site("leo_depot", "USA", 1975, {"require_lift": false})
	var st: Dictionary = SpaceLayerManager.build_habitat("leo_depot", "USA", "orbital")
	var rp2: float = float(SpaceLayerManager.total_station_research_bonus("USA"))
	var station_ok: bool = bool(st.get("ok", false)) and rp2 > rp
	var ok: bool = hab_ok and cmd_ok and station_ok
	return {
		"ok": ok, "live": true, "habitat_ok": ok,
		"habitat": hab, "board": board, "station": st, "space_rp_bonus": rp2,
		"province_id": province_id, "live_api": "apply_space_ops_habitat_live",
		"scenario": "build_habitat_command_and_station_rp",
	}


func apply_space_ops_flow_live(province_id: int = 1) -> Dictionary:
	if typeof(SpaceLayerManager) == TYPE_NIL:
		return {"ok": false, "live": true, "error": "no_slm", "live_api": "apply_space_ops_flow_live"}
	var fid: String = str(SpaceLayerManager.create_space_flow(
		"USA", "USA", "propellant", 20.0,
		["earth", "leo_band", "earth_luna_l1", "luna"],
		{"corridor_risk": 0.2, "demo": false},
	))
	var before: Dictionary = SpaceLayerManager.get_space_flow(fid)
	var before_q: float = float(before.get("quantity_per_turn", 0.0))
	var hit: bool = SpaceLayerManager.interdict_space_flow(fid, "asat", 0.4, {"node_id": "leo_band", "silent": true})
	var after: Dictionary = SpaceLayerManager.get_space_flow(fid)
	var after_q: float = float(after.get("quantity_per_turn", 0.0))
	var plain: String = ""
	var md: Dictionary = after.get("metadata", {}) as Dictionary if after.get("metadata") is Dictionary else {}
	plain = str(md.get("last_interdiction_plain", ""))
	var interdict_ok: bool = hit and after_q < before_q and plain.contains("ASAT")
	# Monthly path
	var monthly: Dictionary = SpaceLayerManager.process_monthly_space(1979, 3, {
		"force_hit": true, "force_loss": 0.3, "force_cause": "solar_storm",
	})
	var deliv: Dictionary = monthly.get("delivery", {}) as Dictionary if monthly.get("delivery") is Dictionary else {}
	var month_ok: bool = bool(monthly.get("ok", false))
	# Delivery credits stockpile
	var board: Dictionary = SpaceLayerManager.get_nation_space_board("USA")
	var stock: Dictionary = board.get("stockpile", {}) as Dictionary if board.get("stockpile") is Dictionary else {}
	var flow_ok: bool = interdict_ok and month_ok and fid != ""
	return {
		"ok": flow_ok, "live": true, "flow_ok": flow_ok,
		"flow_id": fid, "before_q": before_q, "after_q": after_q, "plain": plain,
		"monthly": monthly, "stockpile": stock,
		"province_id": province_id, "live_api": "apply_space_ops_flow_live",
		"scenario": "spaceflow_interdict_and_monthly",
	}


