func apply_reinforcement_logistics_primary_step_live(step: String = "rfl_catalog", province_id: int = 1) -> Dictionary:
	if not peace_state.has("reinforcement_logistics_primary") or not (peace_state["reinforcement_logistics_primary"] is Dictionary):
		peace_state["reinforcement_logistics_primary"] = {"applied": [], "majors_done": {}, "tick": 0}
	var st: Dictionary = (peace_state["reinforcement_logistics_primary"] as Dictionary).duplicate(true)
	var s := step.strip_edges().to_lower()
	if not REINFORCEMENT_LOGISTICS_PRIMARY_STEPS.has(s):
		s = REINFORCEMENT_LOGISTICS_PRIMARY_STEPS[0]
	var live_api := ""
	var live_result: Dictionary = {}
	var major := ""
	if s == "rfl_catalog":
		major = "rfl_primary_catalog"; live_api = "apply_reinforcement_logistics_catalog_live"; live_result = apply_reinforcement_logistics_catalog_live(province_id)
	elif s == "rfl_time":
		major = "rfl_primary_time"; live_api = "apply_reinforcement_logistics_time_live"; live_result = apply_reinforcement_logistics_time_live(province_id)
	elif s == "rfl_exp":
		major = "rfl_primary_exp"; live_api = "apply_reinforcement_logistics_exp_live"; live_result = apply_reinforcement_logistics_exp_live(province_id)
	elif s == "rfl_hub":
		major = "rfl_primary_hub"; live_api = "apply_reinforcement_logistics_hub_live"; live_result = apply_reinforcement_logistics_hub_live(province_id)
	elif s == "rfl_close":
		major = "rfl_primary_close"; live_api = "apply_reinforcement_logistics_close_live"; live_result = apply_reinforcement_logistics_close_live(province_id)
	var step_ok := bool(live_result.get("ok", false))
	var major_credit := major if step_ok else ""
	var domain_script = load("res://scripts/core/ReinforcementLogisticsDomain.gd")
	if domain_script != null and domain_script.has_method("apply_primary_step"):
		peace_state["reinforcement_logistics_primary"] = st.duplicate(true)
		domain_script.apply_primary_step(peace_state, s, live_api, major_credit, live_result)
	else:
		var applied_fb: Array = (st.get("applied", []) as Array).duplicate() if st.get("applied") is Array else []
		if not applied_fb.has(s):
			applied_fb.append(s)
		st["applied"] = applied_fb
		var md_fb: Dictionary = (st.get("majors_done", {}) as Dictionary).duplicate(true)
		if not major_credit.is_empty():
			md_fb[major_credit] = int(md_fb.get(major_credit, 0)) + 1
		st["majors_done"] = md_fb
		peace_state["reinforcement_logistics_primary"] = st.duplicate(true)
	return {
		"ok": step_ok, "live": true, "step": s, "major": major_credit, "live_api": live_api,
		"live_result": live_result, "step_ok": step_ok, "province_id": province_id,
	}


func apply_reinforcement_logistics_primary_live(province_id: int = 1) -> Dictionary:
	var results: Array = []
	for step in REINFORCEMENT_LOGISTICS_PRIMARY_STEPS:
		results.append(apply_reinforcement_logistics_primary_step_live(step, province_id))
	var majors_ok := 0
	var domain_script2 = load("res://scripts/core/ReinforcementLogisticsDomain.gd")
	if domain_script2 != null and domain_script2.has_method("majors_ok_count"):
		majors_ok = int(domain_script2.majors_ok_count(peace_state))
	var dead_n := 0
	var failed_n := 0
	var time_ok := false
	var exp_ok := false
	var hub_ok := false
	for r in results:
		if str((r as Dictionary).get("live_api", "")).is_empty():
			dead_n += 1
		if not bool((r as Dictionary).get("step_ok", false)):
			failed_n += 1
		var lr: Dictionary = (r as Dictionary).get("live_result", {}) if (r as Dictionary).get("live_result") is Dictionary else {}
		if str((r as Dictionary).get("step", "")) == "rfl_time":
			time_ok = bool(lr.get("time_ok", lr.get("ok", false)))
		if str((r as Dictionary).get("step", "")) == "rfl_exp":
			exp_ok = bool(lr.get("exp_ok", lr.get("ok", false)))
		if str((r as Dictionary).get("step", "")) == "rfl_hub":
			hub_ok = bool(lr.get("hub_ok", lr.get("ok", false)))
	var ok := majors_ok >= 5 and dead_n == 0 and failed_n == 0 and time_ok and exp_ok and hub_ok
	return {
		"ok": ok, "live": true, "majors_ok": majors_ok, "dead_n": dead_n, "failed_n": failed_n,
		"time_ok": time_ok, "exp_ok": exp_ok, "hub_ok": hub_ok,
		"model": "reinforce_experience_logistics_ledger",
		"province_id": province_id, "closed": REINFORCEMENT_LOGISTICS_PRIMARY_STEPS,
	}


## RF2–RF4 depth — non-instant path · combat XP mult · training policy · era modes.
