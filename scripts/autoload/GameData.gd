func get_campaign_effects_trail(max_lines: int = 8) -> Array:
	if not peace_state.has("campaign_effects") or not (peace_state["campaign_effects"] is Array):
		return []
	var trail: Array = (peace_state["campaign_effects"] as Array).duplicate(true)
	if trail.size() > max_lines:
		return trail.slice(trail.size() - max_lines, trail.size())
	return trail


func store_campaign_map_effect(effect: Dictionary) -> Dictionary:
	if effect.is_empty() or not bool(effect.get("active", true)):
		return {"ok": false, "reason": "empty effect"}
	var trail: Array = []
	if peace_state.has("campaign_effects") and peace_state["campaign_effects"] is Array:
		trail = (peace_state["campaign_effects"] as Array).duplicate()
	trail.append(effect.duplicate(true))
	while trail.size() > 12:
		trail.pop_front()
	peace_state["campaign_effects"] = trail
	return {"ok": true, "count": trail.size(), "effect": effect}


func apply_hh_order_commit_mutation(max_commits: int = 3) -> Dictionary:
	var trail: Array = get_hh_agenda_trail()
	if trail.is_empty():
		return {"ok": false, "reason": "empty trail", "order": ""}
	var mut: Dictionary = MapPolishFormatters.hh_commit_mutation(trail, max_commits)
	if bool(mut.get("empty", true)):
		return {"ok": false, "reason": "empty commit", "order": ""}
	# plan may be missing/non-dict — never call .get on a bool
	var plan_v: Variant = mut.get("plan", {})
	var plan: Dictionary = plan_v if typeof(plan_v) == TYPE_DICTIONARY else {}
	var order := str(plan.get("order", mut.get("order", "")))
	# Stamp commit onto peace_state for next-day surfaces
	peace_state["hh_last_commit"] = {
		"order": order,
		"score": float(plan.get("score", 0.5)),
		"trail_len": trail.size(),
	}
	return {"ok": true, "order": order, "mutation": mut}


func apply_supply_route_mutation(route_id: String = "main", priority: String = "SUSTAIN", province_id: int = -1) -> Dictionary:
	if not peace_state.has("supply_route_priorities") or not (peace_state["supply_route_priorities"] is Dictionary):
		peace_state["supply_route_priorities"] = {}
	var routes: Dictionary = peace_state["supply_route_priorities"]
	routes[route_id] = {
		"priority": priority,
		"province_id": province_id,
	}
	peace_state["supply_route_priorities"] = routes
	# Live SupplyManager path (major #28): advance one supply day + mark depot/routing when possible.
	var supply_live := false
	var supply_detail := ""
	if typeof(SupplyManager) != TYPE_NIL:
		if province_id > 0 and SupplyManager.has_method("set_selected_province"):
			SupplyManager.set_selected_province(province_id)
		if SupplyManager.has_method("set_routing_mode"):
			SupplyManager.set_routing_mode(str(priority).to_lower())
		if province_id > 0 and SupplyManager.has_method("set_player_depot"):
			SupplyManager.set_player_depot(province_id, true)
		if SupplyManager.has_method("advance_supply_day"):
			SupplyManager.advance_supply_day(1.0)
			supply_live = true
			supply_detail = "advance_supply_day"
	peace_state["supply_last_live_apply"] = {
		"route_id": route_id,
		"priority": priority,
		"province_id": province_id,
		"live": supply_live,
		"detail": supply_detail,
	}
	return {
		"ok": true,
		"route_id": route_id,
		"priority": priority,
		"live": supply_live,
		"manager": "SupplyManager" if supply_live else "peace_state",
	}


func apply_focus_order_mutation(focus_id: String = "industrial_effort", action: String = "HOLD") -> Dictionary:
	peace_state["focus_last_mutation"] = {
		"focus_id": focus_id,
		"action": action,
	}
	# Live national focus trail for major #28 audit (visible state, not day-stub only).
	if not peace_state.has("focus_order_trail") or not (peace_state["focus_order_trail"] is Array):
		peace_state["focus_order_trail"] = []
	var trail: Array = peace_state["focus_order_trail"]
	trail.append({"focus_id": focus_id, "action": action})
	if trail.size() > 24:
		trail = trail.slice(trail.size() - 24, trail.size())
	peace_state["focus_order_trail"] = trail
	var national_live := false
	if typeof(ProductionManager) != TYPE_NIL and ProductionManager.has_method("apply_focus"):
		national_live = bool(ProductionManager.apply_focus(focus_id))
	elif typeof(NationalModifierManager) != TYPE_NIL and NationalModifierManager.has_method("apply_focus"):
		NationalModifierManager.apply_focus(focus_id)
		national_live = true
	return {
		"ok": true,
		"focus_id": focus_id,
		"action": action,
		"live": true,
		"national_live": national_live,
		"trail_n": trail.size(),
		"manager": "ProductionManager" if national_live else "peace_state",
	}


