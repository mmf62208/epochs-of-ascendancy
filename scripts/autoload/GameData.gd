func run_daily_theater_auto_tick(province_id: int = 1, max_applies: int = 3) -> Dictionary:
	## Day-advance entry: budgeted execute-one applies + command result log.
	## Uses real apply_execute_one_order / domain applies. Empty queue → empty log append skip.
	var year := 1936
	var month := 1
	var day := 1
	if typeof(TimeManager) != TYPE_NIL:
		if "current_year" in TimeManager:
			year = int(TimeManager.current_year)
		if "current_month" in TimeManager:
			month = int(TimeManager.current_month)
		if "current_day" in TimeManager:
			day = int(TimeManager.current_day)
	var vis := 1.0
	var precip := 0.0
	if typeof(WeatherManager) != TYPE_NIL and WeatherManager.has_method("get_province_weather"):
		var w: Dictionary = WeatherManager.get_province_weather(province_id)
		if w is Dictionary:
			vis = float(w.get("visibility", 1.0))
			precip = float(w.get("precip_intensity", w.get("precip", 0.0)))
	# Estimate pending from order queue
	var pending := 0
	if MapManager.has_method("order_queue_for_province"):
		var q: Dictionary = MapManager.order_queue_for_province(province_id)
		pending = int(q.get("count", 0))
	var budget: Dictionary = MapPolishFormatters.day_apply_budget(pending, max_applies, precip, vis)
	var allowed := int(budget.get("allowed", 0))
	var results: Array = []
	var ok_count := 0
	for _i in range(allowed):
		var applied: Dictionary = apply_execute_one_order(province_id)
		var ok := bool(applied.get("ok", applied.get("success", false)))
		var domain := "ops"
		var order := ""
		var score := 0.5
		if applied.has("pick") and applied["pick"] is Dictionary:
			var pick: Dictionary = applied["pick"]
			domain = str(pick.get("domain", domain))
			order = str(pick.get("order", ""))
			score = float(pick.get("score", 0.5))
		elif applied.has("mutation") and applied["mutation"] is Dictionary:
			var mut: Dictionary = applied["mutation"]
			order = str((mut.get("plan", {}) as Dictionary).get("order", mut.get("summary", "")))
			score = float(mut.get("score", 0.5))
		if order.is_empty():
			order = str(applied.get("order", applied.get("reason", "")))
		# Domain from successful specialized applies
		if applied.has("unit_id"):
			domain = "production"
		if applied.has("route_id"):
			domain = "supply"
		if applied.has("moved"):
			domain = "fleet"
		if applied.has("result") and applied.get("prep_only", false):
			domain = "combat"
			ok = true  # prep is a valid day action
		var reason := str(applied.get("reason", ""))
		if ok:
			ok_count += 1
		var entry: Dictionary = MapPolishFormatters.command_log_entry(
			domain, order, ok, reason, province_id, score, year, month, day
		)
		append_command_result_log(entry)
		results.append(entry)
		# Stop early if queue empty
		if not ok and reason == "empty queue":
			break
	var log_plain := format_command_result_log_plain(6)
	var integrity: Dictionary = MapPolishFormatters.daily_apply_integrity_gate(1.1, 0.8, 0.2, 1.1)
	return {
		"ok": true,
		"allowed": allowed,
		"pending": pending,
		"applied_count": results.size(),
		"ok_count": ok_count,
		"results": results,
		"budget": budget,
		"integrity": integrity,
		"log_plain": log_plain,
		"year": year,
		"month": month,
		"day": day,
		"empty": results.is_empty(),
	}



## Agenda commitment digest (top trail commits; empty trail → "").
func run_daily_theater_auto_tick_multi(max_provinces: int = 3, max_applies: int = 3) -> Dictionary:
	## Multi-province day tick: collect live coastal/station ids, apply budget across top provinces.
	var tag := "GER"
	if typeof(LeaderManager) != TYPE_NIL and LeaderManager.has_method("get_player_country_tag"):
		tag = str(LeaderManager.get_player_country_tag()).to_upper()
	if tag.is_empty():
		tag = "GER"
	var ids: Array = []
	if MapManager.has_method("collect_live_theater_province_ids"):
		ids = MapManager.collect_live_theater_province_ids(tag, maxi(max_provinces * 2, 6))
	if ids.is_empty():
		return run_daily_theater_auto_tick(1, max_applies)
	var live: Dictionary = {}
	if MapManager.has_method("multi_province_live_plan_for_tag"):
		live = MapManager.multi_province_live_plan_for_tag(tag, max_provinces)
	var top: Array = live.get("top", []) if live is Dictionary else []
	if top.is_empty():
		for i in range(mini(ids.size(), max_provinces)):
			top.append({"province_id": int(ids[i])})
	var remaining := max_applies
	var province_results: Array = []
	var total_ok := 0
	for item in top:
		if remaining <= 0:
			break
		var pid := int(item.get("province_id", -1)) if item is Dictionary else int(item)
		if pid < 0:
			continue
		var slice_n := maxi(1, mini(remaining, 2))
		var res: Dictionary = run_daily_theater_auto_tick(pid, slice_n)
		province_results.append({"province_id": pid, "result": res})
		total_ok += int(res.get("ok_count", 0))
		remaining -= int(res.get("applied_count", slice_n))
	# Once per day: integrated fleet/agent/HH + theater day cabinet (supply/timeline)
	var day_ops: Dictionary = {}
	if has_method("apply_day_ops_integrated"):
		day_ops = apply_day_ops_integrated(2, 2, true)
	else:
		if has_method("apply_fleet_multi_theater_day"):
			day_ops["fleet"] = apply_fleet_multi_theater_day(2)
