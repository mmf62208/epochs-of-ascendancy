func apply_equipment_flow_primary_step_live(step: String = "efl_catalog", province_id: int = 1) -> Dictionary:
	if not peace_state.has("equipment_flow_primary") or not (peace_state["equipment_flow_primary"] is Dictionary):
		peace_state["equipment_flow_primary"] = {"applied": [], "majors_done": {}, "tick": 0}
	var st: Dictionary = (peace_state["equipment_flow_primary"] as Dictionary).duplicate(true)
	var s := step.strip_edges().to_lower()
	if not EQUIPMENT_FLOW_PRIMARY_STEPS.has(s):
		s = EQUIPMENT_FLOW_PRIMARY_STEPS[0]
	var live_api := ""
	var live_result: Dictionary = {}
	var major := ""
	if s == "efl_catalog":
		major = "efl_primary_catalog"; live_api = "apply_equipment_flow_catalog_live"; live_result = apply_equipment_flow_catalog_live(province_id)
	elif s == "efl_create":
		major = "efl_primary_create"; live_api = "apply_equipment_flow_create_live"; live_result = apply_equipment_flow_create_live(province_id)
	elif s == "efl_interdict":
		major = "efl_primary_interdict"; live_api = "apply_equipment_flow_interdict_live"; live_result = apply_equipment_flow_interdict_live(province_id)
	elif s == "efl_deliver":
		major = "efl_primary_deliver"; live_api = "apply_equipment_flow_deliver_live"; live_result = apply_equipment_flow_deliver_live(province_id)
	elif s == "efl_close":
		major = "efl_primary_close"; live_api = "apply_equipment_flow_close_live"; live_result = apply_equipment_flow_close_live(province_id)
	var step_ok := bool(live_result.get("ok", false))
	var major_credit := major if step_ok else ""
	var domain_script = load("res://scripts/core/EquipmentFlowDomain.gd")
	if domain_script != null and domain_script.has_method("apply_primary_step"):
		peace_state["equipment_flow_primary"] = st.duplicate(true)
		domain_script.apply_primary_step(peace_state, s, live_api, major_credit, live_result)
	else:
		var applied_fb: Array = (st.get("applied", []) as Array).duplicate() if st.get("applied") is Array else []
		if not applied_fb.has(s):
			applied_fb.append(s)
		st["applied"] = applied_fb
		var md_fb: Dictionary = (st.get("majors_done", {}) as Dictionary).duplicate(true)
		if not major_credit.is_empty():
			md_fb[major_credit] = int(md_fb.get(major_credit, 0)) + 1
		st["majors_done"] = md_fb
		peace_state["equipment_flow_primary"] = st.duplicate(true)
	return {"ok": step_ok, "live": true, "step": s, "major": major_credit, "live_api": live_api, "live_result": live_result, "step_ok": step_ok, "province_id": province_id}


func apply_equipment_flow_primary_live(province_id: int = 1) -> Dictionary:
	var results: Array = []
	for step in EQUIPMENT_FLOW_PRIMARY_STEPS:
		results.append(apply_equipment_flow_primary_step_live(step, province_id))
	var majors_ok := 0
	var domain_script2 = load("res://scripts/core/EquipmentFlowDomain.gd")
	if domain_script2 != null and domain_script2.has_method("majors_ok_count"):
		majors_ok = int(domain_script2.majors_ok_count(peace_state))
	var dead_n := 0
	var failed_n := 0
