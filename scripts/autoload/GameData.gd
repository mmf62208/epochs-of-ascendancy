			"joint": 0.6, "live_score": 0.58, "variance": 0.02, "within_band": true, "sample_n": 0, "tick_count": 0,
		}
	return (peace_state["balance_honesty"] as Dictionary).duplicate(true)

func apply_balance_live(step: String = "estimate", province_id: int = 1) -> Dictionary:
	var st: Dictionary = get_balance_state()
	var s := step.strip_edges().to_lower().replace("balance_", "")
	var joint := float(st.get("joint", 0.6))
	var live := float(st.get("live_score", 0.58))
	var sample_n := int(st.get("sample_n", 0))
	if s.begins_with("estimate"):
		# Soft estimate from product scores when managers present.
		joint = 0.60
		if typeof(MapManager) != TYPE_NIL:
			if MapManager.has_method("multi_phase_combat_product_live"):
				var c: Dictionary = MapManager.multi_phase_combat_product_live(province_id)
				joint = 0.55 * float(c.get("score", joint)) + 0.45 * joint
			if MapManager.has_method("logistics_supply_theater_product_live"):
				var sup: Dictionary = MapManager.logistics_supply_theater_product_live(province_id)
				joint = 0.55 * joint + 0.45 * float(sup.get("score", joint))
		st["joint"] = clampf(joint, 0.35, 1.0)
	elif s.begins_with("sample") or s.begins_with("live"):
		sample_n += 1
		live = clampf(float(st.get("joint", joint)) * 0.96, 0.35, 1.0)
		# Optional live leaves without re-seeding production templates.
		if has_method("apply_order_panel_action"):
			apply_order_panel_action("apply_supply", province_id)
		st["live_score"] = live
		st["sample_n"] = sample_n
	elif s.begins_with("close") or s.begins_with("var"):
		var variance := absf(float(st.get("live_score", live)) - float(st.get("joint", joint)))
		st["variance"] = variance
		st["within_band"] = variance <= 0.18
	st["tick_count"] = int(st.get("tick_count", 0)) + 1
	peace_state["balance_honesty"] = st.duplicate(true)
	var ticks := int(peace_state.get("balance_tick_count", 0)) + 1
	peace_state["balance_tick_count"] = ticks
	return {
		"ok": true, "live": true, "step": s, "province_id": province_id,
		"joint": float(st.get("joint", joint)), "live_score": float(st.get("live_score", live)),
		"variance": float(st.get("variance", 0.0)), "within_band": bool(st.get("within_band", true)),
		"sample_n": int(st.get("sample_n", sample_n)), "balance_tick_count": ticks,
		"manager": "GameData.balance_honesty",
	}


