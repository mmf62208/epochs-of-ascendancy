func apply_multi_party_peace_live(step: String = "board", province_id: int = 1) -> Dictionary:
	var st: Dictionary = get_multi_party_peace_state()
	var s := step.strip_edges().to_lower().replace("multi_party_peace_", "")
	var winners: Array = st.get("winners", ["GER", "ITA", "HUN"])
	if not (winners is Array) or winners.is_empty():
		winners = ["GER", "ITA", "HUN"]
	var loser := str(st.get("loser_tag", "FRA"))
	var packages := int(st.get("package_n", 0))
	var settlements := int(st.get("settlement_count", 0))
	if s.begins_with("board"):
		st["boarded"] = true
		st["winner_n"] = winners.size()
	elif s.begins_with("wargoal") or s.begins_with("goal"):
		st["goals_set"] = true
		packages = winners.size()
		st["package_n"] = packages
		st["ai_accept"] = clampf(0.4 + 0.1 * float(winners.size()), 0.0, 1.0)
	elif s.begins_with("settle"):
		settlements += 1
		st["settlement_count"] = settlements
		# Tie into existing bilateral settle for map ownership proof.
		if has_method("apply_peace_conference_settlement_live"):
			var pe: Dictionary = apply_peace_conference_settlement_live("GER", loser, province_id, true, false, 0.25, true)
			st["bilateral"] = pe
	peace_state["multi_party_peace"] = st.duplicate(true)
	var ticks := int(peace_state.get("multi_party_peace_tick_count", 0)) + 1
	peace_state["multi_party_peace_tick_count"] = ticks
	return {
		"ok": true, "live": true, "step": s, "province_id": province_id,
		"winners": winners, "loser_tag": loser, "winner_n": winners.size(), "package_n": int(st.get("package_n", packages)),
		"settlement_count": int(st.get("settlement_count", settlements)), "ai_accept": float(st.get("ai_accept", 0.55)),
		"multi_party_peace_tick_count": ticks, "manager": "GameData.multi_party_peace",
	}

