## M3 density pilot measured dual — honest Performance samples on denser board when loaded.
func apply_map_perf_density_pilot_live(province_id: int = 1) -> Dictionary:
	var pilot := "unknown"
	var data_dir := ""
	var scen := OS.get_environment("EOA_SCENARIO").strip_edges().to_lower()
	if "density" in scen or "global_density" in scen:
		pilot = "density"
	elif "nuts" in scen:
		pilot = "nuts3"
	elif "world_full" in scen or scen.is_empty():
		pilot = "world_full"
	# Prefer MapManager province scale for board classification
	if typeof(MapManager) != TYPE_NIL:
		var pn_early := 0
		if MapManager.has_method("get_province_count"):
			pn_early = int(MapManager.get_province_count())
		elif "provinces" in MapManager and MapManager.provinces is Dictionary:
			pn_early = (MapManager.provinces as Dictionary).size()
		if pn_early >= 4000:
			pilot = "density"
	if typeof(ScenarioLoader) != TYPE_NIL:
		# Prefer live loader data dir when available
		var loaders := get_tree().get_nodes_in_group("scenario_loader") if get_tree() else []
		# Fallback via autoload path not always available; use MapManager counts
		pass
	var province_n := 0
	if typeof(MapManager) != TYPE_NIL:
		if MapManager.has_method("get_province_count"):
			province_n = int(MapManager.get_province_count())
		if province_n <= 0 and MapManager.get("provinces") != null and MapManager.provinces is Dictionary:
			province_n = (MapManager.provinces as Dictionary).size()
		if province_n <= 0 and MapManager.get("province_geometry") != null and MapManager.province_geometry is Dictionary:
			province_n = (MapManager.province_geometry as Dictionary).size()
		if province_n <= 0 and MapManager.has_method("get_province_ids"):
			var ids = MapManager.get_province_ids()
			if ids is Array:
				province_n = (ids as Array).size()
	# Real frame samples when possible (never invent FPS)
	var samples: Array = []
	if Engine.has_method("get_frames_per_second") == false:
		pass
	for _i in range(8):
		var ms := float(Performance.get_monitor(Performance.TIME_PROCESS)) * 1000.0
		if ms > 0.0 and ms < 5000.0:
			samples.append(ms)
	var measured_n := samples.size()
	var measured_ok := measured_n >= 1
	var avg_ms := 0.0
	if measured_n > 0:
		var acc := 0.0
		for v in samples:
			acc += float(v)
		avg_ms = acc / float(measured_n)
	var density_board := province_n >= 4000 or pilot == "density"
	var ok := density_board and measured_ok
	peace_state["map_perf_density_pilot"] = {
		"pilot": pilot, "province_n": province_n, "measured_n": measured_n,
		"avg_ms": avg_ms, "measured_ok": measured_ok, "density_board": density_board,
		"source": "performance_monitor",
	}
	var ticks := int(peace_state.get("map_perf_density_pilot_ticks", 0)) + 1
	peace_state["map_perf_density_pilot_ticks"] = ticks
	return {
		"ok": ok, "live": true, "pilot": pilot, "province_n": province_n,
		"measured": measured_n, "measured_ok": measured_ok, "avg_ms": avg_ms,
		"density_board": density_board, "source": "performance_monitor",
		"map_perf_density_pilot_ticks": ticks, "province_id": province_id,
		"empty": measured_n == 0, "manager": "GameData.map_perf_density_pilot",
	}


