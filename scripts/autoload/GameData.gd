func apply_map_flow_lod_lod_live(province_id: int = 1) -> Dictionary:
	var MapZoomLODScript = load("res://scripts/map/MapZoomLOD.gd")
	if MapZoomLODScript == null or not MapZoomLODScript.has_method("equipment_flow_glyph_policy"):
		return {"ok": false, "live": true, "error": "no_lod", "live_api": "apply_map_flow_lod_lod_live"}
	var s: Dictionary = MapZoomLODScript.equipment_flow_glyph_policy(0) as Dictionary
	var o: Dictionary = MapZoomLODScript.equipment_flow_glyph_policy(1) as Dictionary
	var t: Dictionary = MapZoomLODScript.equipment_flow_glyph_policy(2) as Dictionary
	var ms := int(s.get("max_glyphs", 0))
	var mo := int(o.get("max_glyphs", 0))
	var mt := int(t.get("max_glyphs", 0))
	var lod_ok: bool = ms > 0 and mo > ms and mt > mo \
		and bool(s.get("aggregate", false)) and not bool(o.get("aggregate", true)) \
		and str(s.get("style", "")) == "corridor" and str(t.get("style", "")) == "discrete"
	# Board-scaled caps
	if MapZoomLODScript.has_method("max_equipment_flow_glyphs_for_board"):
		var cap_w := int(MapZoomLODScript.max_equipment_flow_glyphs_for_board(0, 2600))
		lod_ok = lod_ok and cap_w <= ms and cap_w >= 4
	# Preview density across tiers with seeded flows
	if typeof(ProductionManager) != TYPE_NIL:
		if ProductionManager.has_method("reset_equipment_flows"):
			ProductionManager.reset_equipment_flows()
		ProductionManager.add_to_country_equipment_stockpile("USA", "medium_tank_mk4", 20)
		for i in range(6):
			ProductionManager.create_equipment_flow(
				"USA", "medium_tank_mk4", 1, province_id, province_id + 1 + i, "usa_lod_%d" % i, "rail",
				{"hops": 1, "distance_km": 200.0 + i * 50.0, "year": 1939},
			)
	var layer_scr = load("res://scripts/map/StrategicFlowOverlayLayer.gd")
	var n_s := 0
	var n_t := 0
	if layer_scr != null and layer_scr.has_method("collect_equipment_paint_preview"):
		var ps: Dictionary = layer_scr.collect_equipment_paint_preview({}, {"zoom_tier": 0, "glyphs_enabled": true, "province_count": 100})
		var pt: Dictionary = layer_scr.collect_equipment_paint_preview({}, {"zoom_tier": 2, "glyphs_enabled": true, "province_count": 100})
		n_s = int(ps.get("glyph_n", 0))
		n_t = int(pt.get("glyph_n", 0))
		# Strategic aggregate ≤ tactical discrete count (with enough flows)
		lod_ok = lod_ok and n_s >= 1 and n_t >= n_s
	return {
		"ok": lod_ok, "live": true, "lod_ok": lod_ok,
		"strategic_max": ms, "operational_max": mo, "tactical_max": mt,
		"preview_strategic_n": n_s, "preview_tactical_n": n_t,
		"province_id": province_id, "live_api": "apply_map_flow_lod_lod_live",
		"model": "equipment_flow_compact_ledger",
	}


func apply_map_flow_lod_toggle_live(province_id: int = 1) -> Dictionary:
	var layer_scr = load("res://scripts/map/StrategicFlowOverlayLayer.gd")
	if layer_scr == null:
		return {"ok": false, "live": true, "error": "no_layer", "live_api": "apply_map_flow_lod_toggle_live"}
	# Ensure some flows
	if typeof(ProductionManager) != TYPE_NIL:
		var board: Dictionary = ProductionManager.get_equipment_flow_board("USA")
		if int(board.get("active_n", 0)) < 1:
			ProductionManager.add_to_country_equipment_stockpile("USA", "light_tank_m3", 4)
			ProductionManager.create_equipment_flow(
				"USA", "light_tank_m3", 2, province_id, province_id + 1, "usa_toggle_demo", "road",
				{"hops": 1, "distance_km": 150.0, "year": 1940},
			)
	var on_prev: Dictionary = {}
	var off_prev: Dictionary = {}
	if layer_scr.has_method("collect_equipment_paint_preview"):
		on_prev = layer_scr.collect_equipment_paint_preview({}, {"zoom_tier": 1, "glyphs_enabled": true})
		off_prev = layer_scr.collect_equipment_paint_preview({}, {"zoom_tier": 1, "glyphs_enabled": false})
	var toggle_ok: bool = bool(on_prev.get("paint_ok", false)) and bool(on_prev.get("visible", false)) \
		and not bool(off_prev.get("visible", true)) and int(off_prev.get("glyph_n", 1)) == 0
	# Instance toggle API
	var inst_ok := false
	if layer_scr.can_instantiate():
		var layer = layer_scr.new()
		if layer != null:
			if layer.has_method("set_equipment_flow_glyphs_enabled"):
				layer.set_equipment_flow_glyphs_enabled(true)
				var q1: Dictionary = layer.get_equipment_flow_glyph_query() if layer.has_method("get_equipment_flow_glyph_query") else {}
				layer.set_equipment_flow_glyphs_enabled(false)
				var q2: Dictionary = layer.get_equipment_flow_glyph_query() if layer.has_method("get_equipment_flow_glyph_query") else {}
				inst_ok = bool(q1.get("equipment_flow_glyphs_enabled", false)) and not bool(q2.get("equipment_flow_glyphs_enabled", true))
			if layer is Node:
				layer.free()
	toggle_ok = toggle_ok and inst_ok
	return {
		"ok": toggle_ok, "live": true, "toggle_ok": toggle_ok,
		"on_prev": on_prev, "off_prev": off_prev,
		"province_id": province_id, "live_api": "apply_map_flow_lod_toggle_live",
		"model": "equipment_flow_compact_ledger",
	}


