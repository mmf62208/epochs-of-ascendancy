func apply_execute_one_order(province_id: int = 1) -> Dictionary:
	## Apply top theater queue item via real manager APIs when apply_ready.
	if not MapManager.has_method("execute_one_order_for_province"):
		return {"ok": false, "reason": "no execute_one_order_for_province"}
	var one: Dictionary = MapManager.execute_one_order_for_province(province_id)
	if bool(one.get("empty", true)):
		return {"ok": false, "reason": "empty queue", "pick": one}
	var domain := str(one.get("domain", ""))
	var plan: Dictionary = one.get("plan", {})
	if domain == "fleet" or domain == "naval":
		return apply_fleet_station_mutation(
			int(plan.get("province_id", province_id)),
			str(plan.get("formation_id", "")),
			str(plan.get("country_tag", "")),
			0.55,
		)
	if domain == "production":
		return apply_production_priority_mutation(
			str(plan.get("unit_id", "primary")),
			str(plan.get("line_id", "primary")),
		)
	if domain == "supply":
		return apply_supply_route_mutation(
			str(plan.get("route_id", "main")),
			str(plan.get("priority", "SUSTAIN")),
			int(plan.get("province_id", province_id)),
		)
	if domain == "hh":
		return apply_hh_order_commit_mutation(3)
	if domain == "combat":
		if MapManager.has_method("apply_assault_stage_mutation"):
			return MapManager.apply_assault_stage_mutation(
				int(plan.get("from_province_id", -1)),
				int(plan.get("target_province_id", -1)),
				str(plan.get("formation_id", "")),
				str(plan.get("attacker_tag", "GER")),
			)
	return {"ok": false, "reason": "unsupported domain %s" % domain, "pick": one}



