func apply_day_ops_integrated(
	max_fleet: int = 2,
	max_agent: int = 2,
	include_hh_commit: bool = true,
) -> Dictionary:
	## Run fleet multi-theater + agent auto-dispatch (+ optional HH commit) once.
	var plan: Dictionary = {}
	if MapManager.has_method("day_ops_integrated_for_tag"):
		var tag := "ENG"
		if typeof(LeaderManager) != TYPE_NIL and LeaderManager.has_method("get_player_country_tag"):
			tag = str(LeaderManager.get_player_country_tag()).to_upper()
		if tag.is_empty():
			tag = "ENG"
		plan = MapManager.day_ops_integrated_for_tag(tag, max_fleet, max_agent)
	if bool(plan.get("empty", true)):
		# Still try fleet/agent applies even if HH trail empty
		var fleet_r: Dictionary = apply_fleet_multi_theater_day(max_fleet) if has_method("apply_fleet_multi_theater_day") else {"ok": false}
		var agent_r: Dictionary = apply_agent_auto_dispatch_day(max_agent) if has_method("apply_agent_auto_dispatch_day") else {"ok": false}
		var hh_r: Dictionary = {}
		if include_hh_commit and has_method("apply_hh_order_commit_mutation"):
			hh_r = apply_hh_order_commit_mutation(2)
		var any_ok := bool(fleet_r.get("ok", false)) or bool(agent_r.get("ok", false)) or bool(hh_r.get("ok", false))
		return {
			"ok": any_ok,
			"plan": plan,
			"fleet": fleet_r,
			"agent": agent_r,
			"hh": hh_r,
			"empty": not any_ok,
		}
	var applied: Array = []
	var ok_n := 0
	for item in plan.get("apply_queue", []):
		if not (item is Dictionary):
			continue
		var aid := str(item.get("action_id", ""))
		var pid := int(item.get("province_id", 1))
		if aid == "apply_hh_commit" and not include_hh_commit:
			continue
		var res: Dictionary = {}
		if aid == "fleet_autonomy" or aid == "apply_station":
			res = apply_fleet_autonomy_tick(maxi(pid, 1), 0.7)
		elif aid == "apply_agent_dispatch" or aid == "apply_counterplay" or aid == "apply_hh_commit":
			res = apply_order_panel_action(aid, maxi(pid, 1))
		else:
			res = apply_order_panel_action(aid, maxi(pid, 1))
		if bool(res.get("ok", res.get("success", false))):
			ok_n += 1
		applied.append({"action_id": aid, "result": res})
	return {
		"ok": ok_n > 0,
		"ok_count": ok_n,
		"applied": applied,
		"plan": plan,
		"empty": applied.is_empty(),
	}


