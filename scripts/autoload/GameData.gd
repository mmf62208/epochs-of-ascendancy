func apply_resource_harvest_auto_live(province_id: int = 1) -> Dictionary:
	## Bare deposit harvest yields energy/steel without plants.
	var rhc = _resource_harvest_calculator()
	if rhc == null:
		return {"ok": false, "live": true, "error": "no_calculator", "live_api": "apply_resource_harvest_auto_live"}
	var resources := {"coal": 200.0, "iron": 100.0, "oil": 150.0, "rubber": 80.0}
	var bare: Dictionary = rhc.compute_province_daily_income(resources, [], {}) as Dictionary
	var energy := float(bare.get("energy", 0.0))
	var steel := float(bare.get("steel", 0.0))
	var fuel := float(bare.get("fuel", 0.0))
	var ok := energy > 0.0 and steel > 0.0 and fuel > 0.0
	# Also tick real ProductionManager path when available (no map required for synthetic income).
	var pm_ok := true
	if typeof(ProductionManager) != TYPE_NIL and ProductionManager.has_method("add_stockpile"):
		var prev: Dictionary = ProductionManager.national_stockpile.duplicate(true) if ProductionManager.national_stockpile is Dictionary else {}
		ProductionManager.add_stockpile(bare)
		for k in bare:
			var after := float(ProductionManager.national_stockpile.get(k, 0.0))
			var before := float(prev.get(k, 0.0))
			if after + 0.001 < before + float(bare[k]):
				pm_ok = false
		ProductionManager.set_stockpile(prev)
	ok = ok and pm_ok
	return {
		"ok": ok, "live": true, "bare_income": bare, "energy": energy, "steel": steel, "fuel": fuel,
		"pm_applied": pm_ok, "province_id": province_id, "live_api": "apply_resource_harvest_auto_live",
		"scenario": "bare_harvest",
	}


func apply_resource_harvest_plants_live(province_id: int = 1) -> Dictionary:
	var rhc = _resource_harvest_calculator()
	if rhc == null:
		return {"ok": false, "live": true, "error": "no_calculator", "live_api": "apply_resource_harvest_plants_live"}
	var resources := {"coal": 200.0, "iron": 100.0, "oil": 150.0}
	var bare: Dictionary = rhc.compute_province_daily_income(resources, [], {}) as Dictionary
	var plants: Array = [
		{"factory_type": "coal_plant", "size_tier": 3},
		{"factory_type": "steel_mill", "size_tier": 2},
		{"factory_type": "refinery", "size_tier": 2},
	]
	var boosted: Dictionary = rhc.compute_province_daily_income(resources, plants, {}) as Dictionary
	var plants_matter := float(boosted.get("energy", 0.0)) > float(bare.get("energy", 0.0)) + 0.01
	plants_matter = plants_matter and float(boosted.get("steel", 0.0)) > float(bare.get("steel", 0.0)) + 0.01
	# Prove factory plant registration when FactoryManager available
	var plant_created := false
	if typeof(FactoryManager) != TYPE_NIL and FactoryManager.has_method("create_resource_plant_for_province"):
		var f: Factory = FactoryManager.create_resource_plant_for_province(province_id, "TEST", "coal_plant", 2)
		plant_created = f != null and f.factory_type == "coal_plant"
		if f != null and FactoryManager.has_method("is_resource_plant"):
			plant_created = plant_created and FactoryManager.is_resource_plant(f)
	var ok := plants_matter
	return {
		"ok": ok, "live": true, "plants_matter": plants_matter, "bare": bare, "boosted": boosted,
		"plant_created": plant_created, "province_id": province_id,
		"live_api": "apply_resource_harvest_plants_live", "scenario": "plant_boost",
	}


func apply_resource_harvest_tech_live(province_id: int = 1) -> Dictionary:
	var rhc = _resource_harvest_calculator()
	if rhc == null:
		return {"ok": false, "live": true, "error": "no_calculator", "live_api": "apply_resource_harvest_tech_live"}
	var resources := {"rubber": 100.0, "semiconductors": 50.0, "uranium": 40.0, "coal": 200.0}
	var plants: Array = [{"factory_type": "coal_plant", "size_tier": 2}]
	var no_tech: Dictionary = rhc.compute_province_daily_income(resources, plants, {}) as Dictionary
	var unlocks := {
		"rule_flags": ["plastics_industry", "synthetic_fuel", "nuclear_fuel"],
		"unlocked_resources": ["fissiles", "uranium"],
		"permanent_modifiers": {"power_plant_output": 0.1},
	}
	var plants_tech: Array = plants + [{"factory_type": "enrichment_plant", "size_tier": 2}]
	var with_tech: Dictionary = rhc.compute_province_daily_income(resources, plants_tech, unlocks) as Dictionary
	var tech_matters := float(with_tech.get("rubber", 0.0)) > float(no_tech.get("rubber", 0.0)) + 0.01
	var fissiles_gated := not no_tech.has("fissiles") and with_tech.has("fissiles")
	var synth_fuel := float(with_tech.get("fuel", 0.0)) > float(no_tech.get("fuel", 0.0)) + 0.01
	var fiss_vis_locked: bool = not bool(rhc.is_major_visible("fissiles", {}))
	var fiss_vis_open: bool = bool(rhc.is_major_visible("fissiles", unlocks))
	var ok: bool = tech_matters and fissiles_gated and synth_fuel and fiss_vis_locked and fiss_vis_open
	return {
		"ok": ok, "live": true, "tech_matters": tech_matters, "fissiles_gated": fissiles_gated,
		"synthetic_fuel": synth_fuel, "no_tech": no_tech, "with_tech": with_tech,
		"fissiles_hidden_until_unlock": fiss_vis_locked and fiss_vis_open,
		"province_id": province_id, "live_api": "apply_resource_harvest_tech_live", "scenario": "tech_modifiers",
	}


