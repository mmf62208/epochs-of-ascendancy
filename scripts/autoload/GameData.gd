		if s == "save_browser_list":
			hist_s.append("list")
			leaf = "save_browser_campaign_product_live"
			live_api = "save_browser_campaign_product_live"
			if has_method("save_browser_campaign_product_live"):
				live_result = save_browser_campaign_product_live()
			elif has_method("apply_save_browser_campaign_product"):
				live_result = apply_save_browser_campaign_product(province_id)
			var slots_live: Array = []
			if live_result is Dictionary:
				var rows_v: Variant = live_result.get("rows", live_result.get("slots", []))
				if rows_v is Array:
					for row in rows_v:
						if row is Dictionary:
							slots_live.append(str((row as Dictionary).get("slot", "")))
						else:
							slots_live.append(str(row))
			if slots_live.is_empty():
				slots_live = ["quicksave", "autosave", "slot1", "slot2"]
			sv["slots"] = slots_live
		elif s == "save_browser_resume":
			hist_s.append("resume")
			leaf = "apply_save_browser_resume"
			live_api = "apply_save_browser_resume"
			if has_method("apply_save_browser_resume"):
				live_result = apply_save_browser_resume(province_id)
			var resume_slot := "quicksave"
			if live_result is Dictionary:
				var res_d: Dictionary = live_result.get("resume", {}) as Dictionary if live_result.get("resume") is Dictionary else {}
				if not str(res_d.get("slot", "")).is_empty():
					resume_slot = str(res_d.get("slot"))
			sv["resume_slot"] = resume_slot
		elif s == "save_checkpoint":
			hist_s.append("checkpoint")
			leaf = "apply_save_browser_checkpoint"
			live_api = "apply_save_browser_checkpoint"
			if has_method("apply_save_browser_checkpoint"):
				live_result = apply_save_browser_checkpoint(province_id)
			sv["checkpoint"] = true
		else:
			leaf = "save_browser_campaign_product_live"
			live_api = "save_browser_campaign_product_live"
			if has_method("save_browser_campaign_product_live"):
				live_result = save_browser_campaign_product_live()
		sv["history"] = hist_s
		sv["live_result"] = live_result
		st["save"] = sv

	elif s.begins_with("hh"):
		major_key = "hh_primary_agenda"
		leaf = "apply_hh_agenda_close_live"
		live_api = "apply_hh_agenda_close_live"
		var hh: Dictionary = (st.get("hh", {}) as Dictionary).duplicate(true)
		var hist_h: Array = (hh.get("history", []) as Array).duplicate() if hh.get("history") is Array else []
		var trail: Array = (hh.get("trail", []) as Array).duplicate() if hh.get("trail") is Array else []
		if s == "hh_trail_faction_filter":
			hh["faction"] = "axis"
			trail.append({"step": "filter", "faction": "axis"})
			hist_h.append("filter")
		elif s == "hh_monthly_commit":
			hh["months"] = int(hh.get("months", 0)) + 1
			trail.append({"step": "monthly", "month": hh["months"]})
			hist_h.append("monthly")
		elif s == "hh_quarterly_counter":
			trail.append({"step": "quarterly"})
			hist_h.append("quarterly")
		hh["trail"] = trail
		hh["history"] = hist_h
		st["hh"] = hh
		if has_method("apply_hh_agenda_close_live"):
			live_result = apply_hh_agenda_close_live(province_id)
		elif has_method("apply_hh_multi_month_agenda_product"):
			live_result = apply_hh_multi_month_agenda_product(province_id)

	# Honesty: never fall through to apply_focus for medium/save (or any major).
	## G0 — StreamAlphaDomain owns package state
	var domain_script = load("res://scripts/core/StreamAlphaDomain.gd")
	var domain_res: Dictionary = {}
	var live_api_final: String = live_api if not live_api.is_empty() else leaf
	if domain_script != null and domain_script.has_method("apply_primary_step"):
		peace_state["stream_alpha_primary"] = st.duplicate(true)
		domain_res = domain_script.apply_primary_step(peace_state, s, live_api_final, major_key)
	else:
		st["last_live_api"] = live_api_final
		var applied_fb: Array = (st.get("applied", []) as Array).duplicate() if st.get("applied") is Array else []
		if not applied_fb.has(s):
			applied_fb.append(s)
		st["applied"] = applied_fb
		st["tick"] = int(st.get("tick", 0)) + 1
		var majors_done_fb: Dictionary = (st.get("majors_done", {}) as Dictionary).duplicate(true)
		if not str(major_key).is_empty():
			majors_done_fb[major_key] = int(majors_done_fb.get(major_key, 0)) + 1
		st["majors_done"] = majors_done_fb
		var complete_fb := applied_fb.size() >= STREAM_ALPHA_STEPS.size()
		if complete_fb:
			for req in STREAM_ALPHA_STEPS:
				if not applied_fb.has(req):
					complete_fb = false
					break
		st["complete"] = complete_fb
		peace_state["stream_alpha_primary"] = st.duplicate(true)
		var ticks_fb := int(peace_state.get("stream_alpha_primary_ticks", 0)) + 1
		peace_state["stream_alpha_primary_ticks"] = ticks_fb
		domain_res = {"applied_n": applied_fb.size(), "complete": complete_fb, "stream_alpha_primary_ticks": ticks_fb, "manager": "GameData.fallback"}
	return {
		"ok": true,
		"live": true,
		"step": s,
		"major": major_key,
		"leaf": leaf,
		"live_api": live_api_final,
		"live_result": live_result,
		"applied_n": int(domain_res.get("applied_n", 0)),
		"complete": bool(domain_res.get("complete", false)),
		"stream_alpha_primary_ticks": int(domain_res.get("stream_alpha_primary_ticks", peace_state.get("stream_alpha_primary_ticks", 0))),
		"province_id": province_id,
		"domain": str(domain_res.get("manager", "StreamAlphaDomain")),
		"manager": "GameData.stream_alpha_primary",
	}


func apply_stream_alpha_primary_command_live(province_id: int = 1) -> Dictionary:
	"""Apply all Stream α primary-command steps (C1/P1/S1/L1). ok when majors_ok>=4 and dead_n==0."""
	var results: Array = []
	for step in STREAM_ALPHA_STEPS:
		results.append(apply_stream_alpha_primary_command_step_live(step, province_id))
	var last: Dictionary = results[results.size() - 1] if results.size() > 0 else {}
	var applied_n := int(last.get("applied_n", 0))
	var complete := bool(last.get("complete", false)) and applied_n >= STREAM_ALPHA_STEPS.size()
	var majors_ok := 0
	var majors_map := {}
	var domain_script2 = load("res://scripts/core/StreamAlphaDomain.gd")
	if domain_script2 != null and domain_script2.has_method("majors_ok_count"):
		majors_ok = int(domain_script2.majors_ok_count(peace_state))
		if peace_state.has("stream_alpha_primary") and peace_state["stream_alpha_primary"] is Dictionary:
			var md_d: Dictionary = (peace_state["stream_alpha_primary"] as Dictionary).get("majors_done", {}) as Dictionary
			for k in ["combat_primary_ribbon", "oob_primary_honesty", "save_primary_browser", "hh_primary_agenda"]:
				majors_map[k] = int(md_d.get(k, 0)) > 0
	elif peace_state.has("stream_alpha_primary") and peace_state["stream_alpha_primary"] is Dictionary:
		var st2: Dictionary = peace_state["stream_alpha_primary"] as Dictionary
		var md: Dictionary = st2.get("majors_done", {}) as Dictionary
		for k in ["combat_primary_ribbon", "oob_primary_honesty", "save_primary_browser", "hh_primary_agenda"]:
			var n := int(md.get(k, 0))
			majors_map[k] = n > 0
			if n > 0:
				majors_ok += 1
	# dead_n: structural — 0 when all steps routed to real live_api names (no empty).
	var dead_n := 0
	for r in results:
		var api := str((r as Dictionary).get("live_api", ""))
		if api.is_empty() or "apply_focus" in api:
			dead_n += 1
	var ok := complete and majors_ok >= 4 and dead_n == 0
	var score := 0.72 if ok else 0.4
	var label := "Stream α primary command close %s · steps %d/%d · majors %d/4 · dead %d · score %.2f" % [
		"PASS" if ok else "FAIL",
		applied_n,
		STREAM_ALPHA_STEPS.size(),
		majors_ok,
		dead_n,
		score,
	]
	return {
		"ok": ok,
		"live": true,
		"applied_n": applied_n,
		"majors_ok": majors_ok,
		"majors_ok_map": majors_map,
		"dead_n": dead_n,
		"complete": complete,
		"steps_n": results.size(),
		"stream_alpha_primary_ticks": int(peace_state.get("stream_alpha_primary_ticks", 0)),
		"g0_domain": "StreamAlphaDomain",
		"province_id": province_id,
		"closed": STREAM_ALPHA_STEPS,
		"score": score,
		"summary": label,
		"plain": label,
		"empty": false,
	}


## N1 dual — hotseat turn banner + non-active lock audit (SessionPlayers live state).
func apply_hotseat_turn_banner_live(province_id: int = 1) -> Dictionary:
	if typeof(SessionPlayers) == TYPE_NIL:
		return {"ok": false, "error": "no_SessionPlayers", "live": false, "empty": true}
	if SessionPlayers.slots.is_empty():
		SessionPlayers.setup_default_hotseat()
	if SessionPlayers.has_method("mark_lobby_all_ready"):
		SessionPlayers.mark_lobby_all_ready()
	var banner: Dictionary = {}
	if SessionPlayers.has_method("get_turn_banner_state"):
		banner = SessionPlayers.get_turn_banner_state()
	else:
		var tag0 := str(SessionPlayers.get_active_tag()) if SessionPlayers.has_method("get_active_tag") else ""
		var human0 := bool(SessionPlayers.is_active_human()) if SessionPlayers.has_method("is_active_human") else false
		var role0 := "HUMAN" if human0 else "AI (input locked)"
		var turn0 := int(SessionPlayers.turn)
		banner = {
			"slots": SessionPlayers.slots.duplicate(true),
			"active_tag": tag0,
			"turn_index": turn0,
			"banner_text": "Hotseat · Turn %d · Active %s · %s" % [turn0, tag0 if not tag0.is_empty() else "—", role0],
			"non_active_locked": true,
			"can_end_turn": bool(SessionPlayers.lobby_ready) and not SessionPlayers.slots.is_empty() and not tag0.is_empty(),
			"command_journal_len": int(SessionPlayers.command_queue.size()),
		}
	var active := str(banner.get("active_tag", ""))
	var banner_text := str(banner.get("banner_text", ""))
	var non_active_locked := bool(banner.get("non_active_locked", true))
	# Lock audit: active allowed; a different seat tag denied.
	var allow_self := false
	var deny_other := true
	var other_tag := ""
	if SessionPlayers.has_method("is_command_allowed_for_tag"):
		allow_self = bool(SessionPlayers.is_command_allowed_for_tag(active)) if not active.is_empty() else false
		for s in SessionPlayers.slots:
			if s is Dictionary:
				var t := str((s as Dictionary).get("tag", "")).to_upper()
				if not t.is_empty() and t != active.to_upper():
					other_tag = t
					break
		if not other_tag.is_empty():
			deny_other = not bool(SessionPlayers.is_command_allowed_for_tag(other_tag))
		else:
			deny_other = true
	else:
		allow_self = not active.is_empty()
		deny_other = true
	var lock_ok := allow_self and deny_other and non_active_locked
	var banner_ok := not banner_text.strip_edges().is_empty() and not active.is_empty()
	var ok := lock_ok and banner_ok and bool(banner.get("can_end_turn", false))
	var res := {
		"ok": ok,
		"live": true,
		"empty": false,
		"active_tag": active,
		"turn_index": int(banner.get("turn_index", 0)),
		"banner_text": banner_text,
		"non_active_locked": non_active_locked,
		"can_end_turn": bool(banner.get("can_end_turn", false)),
		"command_journal_len": int(banner.get("command_journal_len", 0)),
		"locked": non_active_locked,
		"allow_self": allow_self,
		"deny_other": deny_other,
		"other_tag": other_tag,
		"lock_ok": lock_ok,
		"banner_ok": banner_ok,
		"slot_n": SessionPlayers.slots.size(),
		"province_id": province_id,
		"manager": "SessionPlayers.turn_banner",
	}
	peace_state["hotseat_turn_banner"] = {
		"active_tag": active,
		"turn_index": int(banner.get("turn_index", 0)),
		"banner_text": banner_text,
		"non_active_locked": non_active_locked,
		"lock_ok": lock_ok,
		"ok": ok,
	}
	var ticks := int(peace_state.get("hotseat_turn_banner_ticks", 0)) + 1
	peace_state["hotseat_turn_banner_ticks"] = ticks
	res["hotseat_turn_banner_ticks"] = ticks
	return res


## M3 dual — map FPS harness crumb (honest empty when no MapRenderer samples).
func apply_map_perf_fps_harness_live(province_id: int = 1) -> Dictionary:
	var province_count := 0
	var land_n := 0
	if typeof(MapManager) != TYPE_NIL:
		if MapManager.has_method("get_province_count"):
			province_count = int(MapManager.get_province_count())
		elif MapManager.has_method("get_all_provinces"):
			province_count = int(MapManager.get_all_provinces().size())
		land_n = province_count
	# Pilot tag (matches pure resolve_pilot_tag spirit; nearest known pilot / EOA_SCENARIO).
	var pilot_tag := "custom"
	var scen := OS.get_environment("EOA_SCENARIO").strip_edges().to_lower()
	if scen.contains("density"):
		pilot_tag = "density"
	elif scen.contains("nuts"):
		pilot_tag = "nuts3"
	elif scen.contains("world") or scen == "full":
		pilot_tag = "world_full"
	if province_count > 0 and pilot_tag == "custom":
		var dens := absi(province_count - 4650)
		var nuts := absi(province_count - 1514)
		var world := absi(province_count - 2665)
		var best := mini(dens, mini(nuts, world))
		var threshold := maxi(80, int(0.15 * float(province_count)))
		if best <= threshold:
			if best == dens:
				pilot_tag = "density"
			elif best == nuts:
				pilot_tag = "nuts3"
			else:
				pilot_tag = "world_full"
	# Soft land_n from pilot plan when map count not yet available.
	if land_n <= 0:
		if pilot_tag == "density":
			land_n = 4650
		elif pilot_tag == "nuts3":
			land_n = 1514
		elif pilot_tag == "world_full":
			land_n = 2325
			if province_count <= 0:
				province_count = 2665
	# Prefer real MapRenderer frame samples when present; never invent FPS.
	var frame_times: Array = []
	var measured := 0
	var synthetic := false
	var mean_ms := 0.0
	var p95_ms := 0.0
	var estimated_fps := 0.0
	var tree := Engine.get_main_loop() as SceneTree
	if tree != null and tree.root != null:
		var mr: Node = tree.root.find_child("MapRenderer", true, false)
		if mr == null and tree.has_method("get_first_node_in_group"):
			mr = tree.get_first_node_in_group("map_renderer")
		if mr != null:
			var rep: Dictionary = {}
			if mr.has_method("get_perf_last_report"):
				rep = mr.call("get_perf_last_report") as Dictionary
			elif mr.has_method("dump_perf_profile"):
				# dump forces a report window; still honest (may be empty samples).
				rep = mr.call("dump_perf_profile") as Dictionary
			var frames_n := int(rep.get("frames", 0))
			var avg := float(rep.get("frame_avg_ms", 0.0))
			var mx := float(rep.get("frame_max_ms", 0.0))
			if frames_n > 0 and avg > 0.0:
				measured = frames_n
				mean_ms = avg
				p95_ms = mx if mx > 0.0 else avg
				estimated_fps = (1000.0 / avg) if avg > 0.001 else 0.0
				# Expand to short sample list for product shape (labeled from live report, not synthetic).
				frame_times = [avg]
				if mx > 0.0 and not is_equal_approx(mx, avg):
					frame_times.append(mx)
	var empty := measured <= 0 or frame_times.is_empty()
	var budget_ms_30 := 1000.0 / 30.0
	var budget_ms_60 := 1000.0 / 60.0
	var budget_ok_30 := (not empty) and mean_ms > 0.0 and mean_ms <= budget_ms_30 + 0.0001
	var budget_ok_60 := (not empty) and mean_ms > 0.0 and mean_ms <= budget_ms_60 + 0.0001
	var status := "EMPTY" if empty else ("PASS_60" if budget_ok_60 else ("PASS_30" if budget_ok_30 else "FAIL"))
	# Dual ok = harness ready (honest empty is PASS for dual crumb; measured path also ok).
	var ok := true
	var label := (
		"Map FPS harness live · pilot=%s · land=%d · measured=%d · empty=%s · status=%s"
		% [pilot_tag, land_n, measured, str(empty).to_lower(), status]
	)
	var res := {
		"ok": ok,
		"live": true,
		"empty": empty,
		"measured": measured,
		"sample_n": measured,
		"pilot_tag": pilot_tag,
		"pilot_name": pilot_tag,
		"province_count": province_count,
		"land_n": land_n,
		"mean_ms": mean_ms,
		"p95_ms": p95_ms,
		"estimated_fps": estimated_fps,
		"budget_ok_30": budget_ok_30,
		"budget_ok_60": budget_ok_60,
		"budget_ms_30": budget_ms_30,
		"budget_ms_60": budget_ms_60,
		"status": status,
		"synthetic": synthetic,
		"frame_times_ms": frame_times,
		"harness_ready": true,
		"province_id": province_id,
		"summary": label,
		"plain": label,
		"manager": "GameData.map_perf_fps_harness",
	}
	peace_state["map_perf_fps_harness"] = {
		"pilot_tag": pilot_tag,
		"measured": measured,
		"empty": empty,
		"status": status,
		"ok": ok,
	}
	var ticks := int(peace_state.get("map_perf_fps_harness_ticks", 0)) + 1
	peace_state["map_perf_fps_harness_ticks"] = ticks
	res["map_perf_fps_harness_ticks"] = ticks
	return res


## Fleet multi-day autonomy primary command — C2/A2 F0–F3 (4 steps).
## Live APIs match pure product LIVE_API_BY_STEP; never route via apply_focus.
const FLEET_AUTONOMY_PRIMARY_STEPS: PackedStringArray = [
	"fleet_posture_day", "fleet_station_escort", "fleet_follow_through", "fleet_autonomy_close",
]


func _ensure_fleet_autonomy_primary_state() -> Dictionary:
	if not peace_state.has("fleet_autonomy_primary") or not (peace_state["fleet_autonomy_primary"] is Dictionary):
		peace_state["fleet_autonomy_primary"] = {
			"applied": [],
			"complete": false,
			"tick": 0,
			"posture": {"day": 0, "history": []},
			"station_escort": {"day": 1, "history": []},
			"follow_through": {"day": 2, "history": []},
			"close": {"history": []},
			"fleet_history": [],
			"majors_done": {},
			"last_live_api": "",
		}
	return (peace_state["fleet_autonomy_primary"] as Dictionary).duplicate(true)


func apply_fleet_autonomy_primary_command_step_live(step: String = "fleet_posture_day", province_id: int = 1) -> Dictionary:
	var st: Dictionary = _ensure_fleet_autonomy_primary_state()
	var s := step.strip_edges().to_lower()
	# normalize aliases from pure product
	var aliases := {
		"posture": "fleet_posture_day",
		"fleet_posture": "fleet_posture_day",
		"fleet_day_posture": "fleet_posture_day",
		"station_escort": "fleet_station_escort",
		"fleet_day_station_escort": "fleet_station_escort",
		"follow_through": "fleet_follow_through",
		"fleet_day_follow_through": "fleet_follow_through",
		"close": "fleet_autonomy_close",
		"autonomy_close": "fleet_autonomy_close",
	}
	if aliases.has(s):
		s = str(aliases[s])
	if not FLEET_AUTONOMY_PRIMARY_STEPS.has(s):
		for cand in FLEET_AUTONOMY_PRIMARY_STEPS:
			if s in cand or cand in s:
				s = cand
				break
		if not FLEET_AUTONOMY_PRIMARY_STEPS.has(s):
			s = FLEET_AUTONOMY_PRIMARY_STEPS[0]
	var leaf := ""
	var major_key := ""
	var live_api := ""
	var live_result: Dictionary = {}

	if s == "fleet_posture_day":
		major_key = "fleet_primary_posture"
		leaf = "apply_fleet_day_posture"
		live_api = "apply_fleet_day_posture"
		var po: Dictionary = (st.get("posture", {}) as Dictionary).duplicate(true)
		var hist_p: Array = (po.get("history", []) as Array).duplicate() if po.get("history") is Array else []
		po["day"] = 0
		hist_p.append("posture")
		po["history"] = hist_p
		st["posture"] = po
		if has_method("apply_fleet_day_posture"):
			live_result = apply_fleet_day_posture(province_id)

	elif s == "fleet_station_escort":
		major_key = "fleet_primary_station_escort"
		leaf = "apply_fleet_day_station_escort"
		live_api = "apply_fleet_day_station_escort"
		var se: Dictionary = (st.get("station_escort", {}) as Dictionary).duplicate(true)
		var hist_s: Array = (se.get("history", []) as Array).duplicate() if se.get("history") is Array else []
		se["day"] = 1
		hist_s.append("station_escort")
		se["history"] = hist_s
		st["station_escort"] = se
		if has_method("apply_fleet_day_station_escort"):
			live_result = apply_fleet_day_station_escort(province_id)

	elif s == "fleet_follow_through":
		major_key = "fleet_primary_follow_through"
		leaf = "apply_fleet_day_follow_through"
		live_api = "apply_fleet_day_follow_through"
		var ft: Dictionary = (st.get("follow_through", {}) as Dictionary).duplicate(true)
		var hist_f: Array = (ft.get("history", []) as Array).duplicate() if ft.get("history") is Array else []
		ft["day"] = 2
		hist_f.append("follow_through")
		ft["history"] = hist_f
		st["follow_through"] = ft
		if has_method("apply_fleet_day_follow_through"):
			live_result = apply_fleet_day_follow_through(province_id)

	elif s == "fleet_autonomy_close":
		major_key = "fleet_primary_autonomy_close"
		leaf = "apply_naval_ops_close_live"
		live_api = "apply_naval_ops_close_live"
		var cl: Dictionary = (st.get("close", {}) as Dictionary).duplicate(true)
		var hist_c: Array = (cl.get("history", []) as Array).duplicate() if cl.get("history") is Array else []
		hist_c.append("close")
		cl["history"] = hist_c
		st["close"] = cl
		if has_method("apply_naval_ops_close_live"):
			live_result = apply_naval_ops_close_live(province_id)

	# Honesty: never fall through to apply_focus for fleet day / naval close.
	## G0 — FleetAutonomyDomain owns package state
