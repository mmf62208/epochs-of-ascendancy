func apply_space_supply_primary_step_live(step: String = "ssp_catalog", province_id: int = 1) -> Dictionary:
	if not peace_state.has("space_supply_primary") or not (peace_state["space_supply_primary"] is Dictionary):
		peace_state["space_supply_primary"] = {"applied": [], "majors_done": {}, "tick": 0}
	var st: Dictionary = (peace_state["space_supply_primary"] as Dictionary).duplicate(true)
	var s := step.strip_edges().to_lower()
	var aliases := {"catalog": "ssp_catalog", "lift": "ssp_lift", "flow": "ssp_flow", "board": "ssp_board", "close": "ssp_close"}
	if aliases.has(s):
		s = str(aliases[s])
	if not SPACE_SUPPLY_PRIMARY_STEPS.has(s):
		s = SPACE_SUPPLY_PRIMARY_STEPS[0]
	var live_api := ""
	var live_result: Dictionary = {}
	var major := ""
	if s == "ssp_catalog":
		major = "ssp_primary_catalog"; live_api = "apply_space_supply_catalog_live"; live_result = apply_space_supply_catalog_live(province_id)
	elif s == "ssp_lift":
		major = "ssp_primary_lift"; live_api = "apply_space_supply_lift_live"; live_result = apply_space_supply_lift_live(province_id)
	elif s == "ssp_flow":
		major = "ssp_primary_flow"; live_api = "apply_space_supply_flow_live"; live_result = apply_space_supply_flow_live(province_id)
	elif s == "ssp_board":
		major = "ssp_primary_board"; live_api = "apply_space_supply_board_live"; live_result = apply_space_supply_board_live(province_id)
	elif s == "ssp_close":
		major = "ssp_primary_close"; live_api = "apply_space_supply_close_live"; live_result = apply_space_supply_close_live(province_id)
	var step_ok := bool(live_result.get("ok", false))
	var major_credit := major if step_ok else ""
	var domain_script = load("res://scripts/core/SpaceSupplyDomain.gd")
	var domain_res: Dictionary = {}
	if domain_script != null and domain_script.has_method("apply_primary_step"):
		peace_state["space_supply_primary"] = st.duplicate(true)
		domain_res = domain_script.apply_primary_step(peace_state, s, live_api, major_credit, live_result)
	else:
		var applied_fb: Array = (st.get("applied", []) as Array).duplicate() if st.get("applied") is Array else []
		if not applied_fb.has(s):
			applied_fb.append(s)
		st["applied"] = applied_fb
		var md_fb: Dictionary = (st.get("majors_done", {}) as Dictionary).duplicate(true)
		if not major_credit.is_empty():
			md_fb[major_credit] = int(md_fb.get(major_credit, 0)) + 1
		st["majors_done"] = md_fb
		peace_state["space_supply_primary"] = st.duplicate(true)
		var ticks_fb := int(peace_state.get("space_supply_primary_ticks", 0)) + 1
		peace_state["space_supply_primary_ticks"] = ticks_fb
		domain_res = {"space_supply_primary_ticks": ticks_fb}
	return {"ok": step_ok, "live": true, "step": s, "major": major_credit, "live_api": live_api, "live_result": live_result, "step_ok": step_ok, "province_id": province_id}


func apply_space_supply_primary_live(province_id: int = 1) -> Dictionary:
	var results: Array = []
	for step in SPACE_SUPPLY_PRIMARY_STEPS:
		results.append(apply_space_supply_primary_step_live(step, province_id))
	var majors_ok := 0
	var domain_script2 = load("res://scripts/core/SpaceSupplyDomain.gd")
	if domain_script2 != null and domain_script2.has_method("majors_ok_count"):
		majors_ok = int(domain_script2.majors_ok_count(peace_state))
	var dead_n := 0
	var failed_n := 0
	var lift_ok := false
	var flow_ok := false
	var board_ok := false
	for r in results:
		if str((r as Dictionary).get("live_api", "")).is_empty():
			dead_n += 1
		if not bool((r as Dictionary).get("step_ok", false)):
			failed_n += 1
		var lr: Dictionary = (r as Dictionary).get("live_result", {}) if (r as Dictionary).get("live_result") is Dictionary else {}
