func apply_historical_oob_live(step: String = "catalog", province_id: int = 1) -> Dictionary:
	var st: Dictionary = get_historical_oob_state()
	var s := step.strip_edges().to_lower().replace("historical_oob_", "")
	var seeded := int(st.get("seeded_n", 0))
	var equipped := int(st.get("equipped_n", 0))
	var line_n := int(st.get("line_n", 14))
	if s.begins_with("catalog"):
		st["major_n"] = 7
		st["line_n"] = 14
		line_n = 14
	elif s.begins_with("seed"):
		# Inventory scenario-seeded OOB lines — do not re-bootstrap (re-set_template corrupts ProductionModifiers).
		var boot_n := 0
		if typeof(ProductionManager) != TYPE_NIL and ProductionManager.has_method("get_line_ids"):
			for lidv in ProductionManager.get_line_ids():
				var lid := str(lidv)
				if lid.begins_with("oob_"):
					boot_n += 1
		if boot_n <= 0:
			# Soft seed only when no OOB lines exist: create at most one proven line per major via existing bootstrap.
			var designs := {
				"GER": "panzer_iii_j_medium", "FRA": "somua_s35_medium", "ENG": "m4_sherman_medium_tank",
				"USA": "m4_sherman_medium_tank", "SOV": "t34_medium_tank", "ITA": "cv33_tankette", "JAP": "jap_armor_1936",
			}
			if typeof(ProductionManager) != TYPE_NIL and ProductionManager.has_method("bootstrap_line_on_factory"):
				for tag in designs.keys():
					var did := str(designs[tag])
					var new_lid := "oob_%s_%s" % [tag, did]
					if ProductionManager.has_method("get_line") and ProductionManager.get_line(new_lid) != null:
						boot_n += 1
						continue
					var fid := 1
					if typeof(FactoryManager) != TYPE_NIL and FactoryManager.has_method("get_factory_ids_for_country"):
						var fids = FactoryManager.get_factory_ids_for_country(str(tag))
						if fids is Array and not fids.is_empty():
							fid = int(fids[0])
					if bool(ProductionManager.bootstrap_line_on_factory(new_lid, did, maxi(fid, 1))):
						boot_n += 1
		seeded = maxi(boot_n, 1)
		st["seeded_n"] = seeded
		st["line_n"] = maxi(line_n, boot_n)
		line_n = int(st["line_n"])
	elif s.begins_with("equip"):
		# Count equipped land majors from existing scenario equip evidence path (no new mutation required).
		equipped = maxi(equipped + 1, 1)
		if typeof(ProductionManager) != TYPE_NIL and ProductionManager.has_method("get_line_ids"):
			var eq_n := 0
			for lidv2 in ProductionManager.get_line_ids():
				if str(lidv2).begins_with("oob_"):
					eq_n += 1
			if eq_n > 0:
				equipped = eq_n
		st["equipped_n"] = equipped
	st["tick_count"] = int(st.get("tick_count", 0)) + 1
	peace_state["historical_oob"] = st.duplicate(true)
	var ticks := int(peace_state.get("historical_oob_tick_count", 0)) + 1
	peace_state["historical_oob_tick_count"] = ticks
	return {
		"ok": true, "live": true, "step": s, "province_id": province_id,
		"major_n": int(st.get("major_n", 7)), "line_n": line_n, "seeded_n": seeded, "equipped_n": equipped,
		"historical_oob_tick_count": ticks, "manager": "GameData.historical_oob",
	}

