func apply_fleet_autonomy_tick(province_id: int = 1, fuel_level: float = 0.7) -> Dictionary:
	## Autonomous fleet tick: plan then apply station or supply via real mutations.
	var tag := "ENG"
	if typeof(LeaderManager) != TYPE_NIL and LeaderManager.has_method("get_player_country_tag"):
		tag = str(LeaderManager.get_player_country_tag()).to_upper()
	if tag.is_empty():
		tag = "ENG"
	var plan: Dictionary = {}
	if MapManager.has_method("fleet_autonomy_tick_for_tag"):
		plan = MapManager.fleet_autonomy_tick_for_tag(tag, fuel_level)
	elif MapPolishFormatters:
		plan = MapPolishFormatters.fleet_autonomy_plan(3, fuel_level, "port", "contested", 100.0, tag)
	if bool(plan.get("empty", false)):
		return {"ok": false, "reason": "empty fleet plan", "plan": plan}
	if not bool(plan.get("apply_ready", false)):
		return {
			"ok": false,
			"reason": str(plan.get("reason", "not apply_ready")),
			"plan": plan,
			"chosen_order": str(plan.get("chosen_order", "")),
		}
	var chosen := str(plan.get("chosen_order", "SEARCH_PATROL"))
	var action_hint := "apply_station"
	var acts: Array = plan.get("actions", [])
	if acts.size() > 0 and acts[0] is Dictionary:
		action_hint = str(acts[0].get("action_id", action_hint))
	var applied: Dictionary = {}
	if chosen == "ESCORT" or action_hint == "apply_supply":
		applied = apply_supply_route_mutation("main", "SUSTAIN", province_id)
	else:
		applied = apply_fleet_station_mutation(province_id, "", tag, fuel_level)
	return {
		"ok": bool(applied.get("ok", applied.get("success", true))),
		"chosen_order": chosen,
		"plan": plan,
		"applied": applied,
		"reason": str(plan.get("reason", "")),
	}


