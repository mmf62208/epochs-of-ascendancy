	for r in results:
		if str((r as Dictionary).get("live_api", "")).is_empty():
			dead_n += 1
		if not bool((r as Dictionary).get("step_ok", false)):
			failed_n += 1
		var lr: Dictionary = (r as Dictionary).get("live_result", {}) if (r as Dictionary).get("live_result") is Dictionary else {}
		if str((r as Dictionary).get("step", "")) == "efl_create":
			create_ok = bool(lr.get("create_ok", lr.get("ok", false)))
		if str((r as Dictionary).get("step", "")) == "efl_interdict":
			interdict_ok = bool(lr.get("interdict_ok", lr.get("ok", false)))
		if str((r as Dictionary).get("step", "")) == "efl_deliver":
			deliver_ok = bool(lr.get("deliver_ok", lr.get("ok", false)))
	var ok := majors_ok >= 5 and dead_n == 0 and failed_n == 0 and create_ok and interdict_ok and deliver_ok
	return {
		"ok": ok, "live": true, "majors_ok": majors_ok, "dead_n": dead_n, "failed_n": failed_n,
		"create_ok": create_ok, "interdict_ok": interdict_ok, "deliver_ok": deliver_ok,
		"model": "equipment_flow_compact_ledger",
		"province_id": province_id, "closed": EQUIPMENT_FLOW_PRIMARY_STEPS,
	}


