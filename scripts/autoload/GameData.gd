	if typeof(TradeManager) == TYPE_NIL or not TradeManager.has_method("grant_basing_rights"):
		return {"ok": false, "live": true, "error": "no_tm", "live_api": "apply_basing_fleet_station_grant_live"}
	var host_pid := _bfs_find_owner_province("ENG", true)
	# Host-wide grant (province 0) always matches access context regardless of pick noise
	var res: Dictionary = TradeManager.grant_basing_rights("ENG", "GER", 0, 18, {
		"silent": true,
		"major_port": true,
		"range_bonus": 0.25,
		"grant_id": "bfs_dual_eng_ger_wide",
	})
	var grant_id := str(res.get("grant_id", ""))
	var has_access := false
	if TradeManager.has_method("has_basing_access"):
		has_access = bool(TradeManager.has_basing_access("GER", "ENG", 0)) \
			or bool(TradeManager.has_basing_access("GER", "ENG", maxi(host_pid, 1)))
	var access_ctx: Dictionary = {}
	if host_pid > 0 and typeof(MapManager) != TYPE_NIL and MapManager.has_method("get_fleet_station_access_context"):
		access_ctx = MapManager.get_fleet_station_access_context(host_pid, "GER")
	# Graph write is authoritative; access_ctx treaty is bonus when owner province found
	var grant_ok: bool = bool(res.get("ok", false)) and has_access
	return {
		"ok": grant_ok, "live": true, "grant_ok": grant_ok,
		"grant_id": grant_id, "host_pid": host_pid, "access": access_ctx, "result": res,
		"province_id": province_id, "live_api": "apply_basing_fleet_station_grant_live",
		"scenario": "grant_treaty_for_fleet",
	}


func apply_basing_fleet_station_prefer_live(province_id: int = 1) -> Dictionary:
	if typeof(MapManager) == TYPE_NIL or not MapManager.has_method("get_preferred_fleet_station"):
		return {"ok": false, "live": true, "error": "no_pref", "live_api": "apply_basing_fleet_station_prefer_live"}
	var host_pid := _bfs_find_owner_province("ENG", true)
	var home_pid := _bfs_find_owner_province("GER", false)
	if host_pid < 1:
		host_pid = maxi(province_id, 2)
	if home_pid < 1:
		home_pid = maxi(province_id, 1)
	# Ensure host-wide treaty for GER at ENG
	if typeof(TradeManager) != TYPE_NIL and TradeManager.has_method("grant_basing_rights"):
		if not TradeManager.has_basing_access("GER", "ENG"):
			TradeManager.grant_basing_rights("ENG", "GER", 0, 12, {"silent": true, "major_port": true})
	var candidates: Array = [home_pid, host_pid]
	var pref: Dictionary = MapManager.get_preferred_fleet_station(candidates, "GER")
	var best_pid := int(pref.get("province_id", -1))
	var treaty_flag := bool(pref.get("has_treaty_basing", false))
	# Formatter-level proof (always deterministic)
	var anch: Dictionary = {"level": "anchorage", "capacity": 2, "province_id": home_pid}
	var maj: Dictionary = {"level": "major_base", "capacity": 16, "province_id": host_pid, "label": "major naval base"}
	if MapManager.has_method("get_naval_basing") and host_pid > 0:
		var live_b: Dictionary = MapManager.get_naval_basing(host_pid)
		if str(live_b.get("level", "none")) != "none":
			maj = live_b
			maj["province_id"] = host_pid
	var s_home: Dictionary = MapPolishFormatters.score_fleet_station_candidate(anch, true, false, 0.0, false)
	var s_treaty: Dictionary = MapPolishFormatters.score_fleet_station_candidate(maj, false, false, 0.0, true)
	var score_prefer_treaty: bool = float(s_treaty.get("score", 0.0)) > float(s_home.get("score", 0.0))
	# Live prefer: station API returned a pick; treaty score premium is required
	var prefer_ok: bool = score_prefer_treaty and best_pid > 0
	return {
		"ok": prefer_ok, "live": true, "prefer_ok": prefer_ok,
		"pref": pref, "best_pid": best_pid, "host_pid": host_pid, "home_pid": home_pid,
		"treaty_flag": treaty_flag, "score_prefer_treaty": score_prefer_treaty,
		"s_home": s_home, "s_treaty": s_treaty,
		"province_id": province_id, "live_api": "apply_basing_fleet_station_prefer_live",
		"scenario": "prefer_treaty_station",
	}


