func apply_campaign_alpha_apply_recommended(province_id: int = 1) -> Dictionary:
	## Apply the recommended-next leaf action (HH / theater / front / occupation).
	var product: Dictionary = {}
	if MapManager.has_method("campaign_alpha_primary_strip_product_live"):
		product = MapManager.campaign_alpha_primary_strip_product_live(province_id)
	else:
		product = MapPolishFormatters.campaign_alpha_primary_strip_product(province_id)
	apply_campaign_alpha_primary_strip_live("recommend", province_id)
	var rec: Dictionary = product.get("recommendation", {})
	var rec_id := str(rec.get("action_id", "apply_station")).strip_edges()
	if rec_id.is_empty():
		rec_id = "apply_station"
	var leaf: Dictionary = apply_order_panel_action(rec_id, province_id)
	return {
		"ok": bool(leaf.get("ok", true)), "live": true, "recommended": rec_id,
		"leaf_result": leaf, "product": product, "province_id": province_id,
		"summary": "Campaign Alpha apply recommended · %s" % rec_id, "empty": false,
	}

