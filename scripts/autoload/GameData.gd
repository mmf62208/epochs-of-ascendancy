func apply_air_theater_live(step: String = "recon", province_id: int = 1) -> Dictionary:
	var st: Dictionary = get_air_theater_state()
	var s := step.strip_edges().to_lower().replace("air_theater_", "").replace("air_", "")
	var packages := int(st.get("packages", 0))
	var strikes := int(st.get("strikes", 0))
	var fuel := float(st.get("fuel", 0.72))
	if s.begins_with("recon") or s.begins_with("sortie"):
		packages += 1
		fuel = clampf(fuel - 0.04, 0.2, 1.0)
	elif s.begins_with("cas") or s.begins_with("gate") or s.begins_with("weather"):
		st["gate_open"] = fuel >= 0.35
		if has_method("apply_order_panel_action"):
			apply_order_panel_action("apply_station", province_id)
	elif s.begins_with("inter") or s.begins_with("strike"):
