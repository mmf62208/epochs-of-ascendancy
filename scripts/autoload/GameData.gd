func get_occupation_province_state(province_id: int = 1) -> Dictionary:
	if not peace_state.has("occupation_province") or not (peace_state["occupation_province"] is Dictionary):
		peace_state["occupation_province"] = {}
	var store: Dictionary = peace_state["occupation_province"]
	var key := str(province_id)
	if not store.has(key):
		store[key] = {
			"resistance_level": 0.55,
			"compliance_level": 0.40,
			"policy": "moderate",
			"revolt_risk": 0.12,
			"factory_output_mult": 0.90,
			"manpower_drain": 0.05,
		}
		peace_state["occupation_province"] = store
	return (store[key] as Dictionary).duplicate(true)


func apply_occupation_policy_live(province_id: int = 1, policy: String = "moderate") -> Dictionary:
	var pol := policy.strip_edges().to_lower()
	if pol not in ["harsh", "moderate", "lenient"]:
		pol = "moderate"
	var st: Dictionary = get_occupation_province_state(province_id)
	var r := float(st.get("resistance_level", 0.55))
	var c := float(st.get("compliance_level", 0.40))
	var r_delta := -0.05
	var c_delta := 0.04
	var revolt := 0.07
	var fac := 0.90
	var drain := 0.05
	if pol == "harsh":
		r_delta = -0.08
		c_delta = -0.05
		revolt = 0.12
		fac = 0.85
		drain = 0.08
	elif pol == "lenient":
		r_delta = -0.03
		c_delta = 0.08
		revolt = 0.04
		fac = 0.95
		drain = 0.03
	r = clampf(r + r_delta, 0.0, 1.0)
	c = clampf(c + c_delta, 0.0, 1.0)
	var out := {
		"resistance_level": r,
		"compliance_level": c,
		"policy": pol,
		"revolt_risk": clampf(revolt + 0.4 * r - 0.25 * c, 0.0, 1.0),
		"factory_output_mult": fac,
		"manpower_drain": drain,
		"province_id": province_id,
		"live": true,
		"manager": "GameData.occupation_province",
		"ok": true,
	}
	if not peace_state.has("occupation_province") or not (peace_state["occupation_province"] is Dictionary):
		peace_state["occupation_province"] = {}
	(peace_state["occupation_province"] as Dictionary)[str(province_id)] = out.duplicate(true)
	peace_state["occupation_last_policy"] = out.duplicate(true)
	return out


func apply_occupation_daily_tick_live(province_id: int = 1) -> Dictionary:
	var st: Dictionary = get_occupation_province_state(province_id)
	var pol := str(st.get("policy", "moderate"))
	# Re-apply policy deltas as a daily tick.
	var res: Dictionary = apply_occupation_policy_live(province_id, pol)
	res["tick"] = true
	# Aggregate evidence counters
	var ticks := int(peace_state.get("occupation_tick_count", 0)) + 1
	peace_state["occupation_tick_count"] = ticks
	res["occupation_tick_count"] = ticks
	return res


