## CP6 optional deep combat + AI logistics doctrine.
const COMBAT_DEPTH_PRIMARY_STEPS: PackedStringArray = [
	"cd_catalog", "cd_deep", "cd_logistics", "cd_joint", "cd_close",
]


func apply_combat_depth_catalog_live(province_id: int = 1) -> Dictionary:
	var src := ""
	if FileAccess.file_exists("res://scripts/combat/CombatResolver.gd"):
		src = FileAccess.get_file_as_string("res://scripts/combat/CombatResolver.gd")
	var ok: bool = ("func resolve_deep_combat" in src) and ("func _deep_equipment_weight" in src) \
		and typeof(ProductionManager) != TYPE_NIL and ProductionManager.has_method("ai_select_logistics_doctrine")
	return {"ok": ok, "live": true, "province_id": province_id, "live_api": "apply_combat_depth_catalog_live", "model": "equipment_flow_compact_ledger"}


func apply_combat_depth_deep_live(province_id: int = 1) -> Dictionary:
	var cr_script = load("res://scripts/combat/CombatResolver.gd")
	var deep_ok := false
	var res: Dictionary = {}
	var att_id := ""
	var def_id := ""
	if typeof(LeaderManager) != TYPE_NIL and "formations" in LeaderManager:
		for k in LeaderManager.formations.keys():
			if LeaderManager.formations[k] == null:
				continue
			if att_id.is_empty():
				att_id = str(k)
			elif def_id.is_empty() and str(k) != att_id:
				def_id = str(k)
				break
		if def_id.is_empty():
			def_id = att_id
	if cr_script != null and cr_script.can_instantiate() and not att_id.is_empty():
		var cr = cr_script.new()
		# Seed unit equipment for deep weights
		if typeof(ProductionManager) != TYPE_NIL:
			ProductionManager.set_unit_equipment_stock(att_id, {"medium_tank_mk4": 4, "infantry_kit": 8})
			ProductionManager.set_unit_equipment_stock(def_id, {"infantry_kit": 10})
			ProductionManager.add_to_country_equipment_stockpile("USA", "tactical_missile_demo", 4)
		if cr.has_method("resolve_deep_combat"):
			res = cr.resolve_deep_combat(att_id, def_id, {"intensity": 1.2, "terrain": "plains"})
			deep_ok = bool(res.get("deep_ok", false)) and bool(res.get("ok", false)) and not str(res.get("outcome", "")).is_empty()
		if cr is Node:
			cr.free()
	# Source-level fallback if no formations
	if not deep_ok:
		var src := FileAccess.get_file_as_string("res://scripts/combat/CombatResolver.gd") if FileAccess.file_exists("res://scripts/combat/CombatResolver.gd") else ""
		deep_ok = "func resolve_deep_combat" in src and "deep_equipment_weighted" in src
		res = {"ok": deep_ok, "deep_ok": deep_ok, "outcome": "source_hooks", "mode": "deep_equipment_weighted"}
	return {"ok": deep_ok, "live": true, "deep_ok": deep_ok, "res": res, "province_id": province_id, "live_api": "apply_combat_depth_deep_live", "model": "equipment_flow_compact_ledger"}


func apply_combat_depth_logistics_live(province_id: int = 1) -> Dictionary:
	if typeof(ProductionManager) == TYPE_NIL or not ProductionManager.has_method("ai_select_logistics_doctrine"):
