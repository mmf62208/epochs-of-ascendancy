func apply_campaign_alpha_primary_strip_live(step: String = "board", province_id: int = 1) -> Dictionary:
	var product: Dictionary = {}
	if MapManager.has_method("campaign_alpha_primary_strip_product_live"):
		product = MapManager.campaign_alpha_primary_strip_product_live(province_id)
	else:
		product = MapPolishFormatters.campaign_alpha_primary_strip_product(province_id)
	## Pack B — domain helper owns state transition; GameData keeps public API name.
	## Preload avoids class_name parse-order issues on autoload reload.
	var domain_script = load("res://scripts/core/CampaignAlphaDomain.gd")
	if domain_script != null and domain_script.has_method("apply_step"):
		return domain_script.apply_step(peace_state, step, product, province_id)
	# Inline fallback if domain script missing
	var st: Dictionary = {}
	if peace_state.has("campaign_alpha") and peace_state["campaign_alpha"] is Dictionary:
		st = (peace_state["campaign_alpha"] as Dictionary).duplicate(true)
	else:
		st = {"max_expanded": 1, "max_actions": 8, "dead_n": 0, "last_recommended": "", "board_set": false, "recommend_set": false, "audit_set": false}
	var s := step.strip_edges().to_lower().replace("campaign_alpha_", "")
	if s.begins_with("rec"):
		st["recommend_set"] = true
		s = "recommend"
	elif s.begins_with("aud") or s.begins_with("dead"):
		st["audit_set"] = true
		s = "audit"
	else:
		st["board_set"] = true
		st["max_expanded"] = 1
		s = "board"
	st["dead_n"] = int(product.get("dead_n", 0))
	st["max_actions"] = int(product.get("max_actions", 8))
	var rec: Dictionary = product.get("recommendation", {})
	if rec is Dictionary:
		st["last_recommended"] = str(rec.get("action_id", ""))
	peace_state["campaign_alpha"] = st.duplicate(true)
	var ticks := int(peace_state.get("campaign_alpha_tick_count", 0)) + 1
	peace_state["campaign_alpha_tick_count"] = ticks
	return {
		"ok": bool(product.get("dead_ok", true)), "live": true, "step": s, "province_id": province_id,
		"dead_n": int(st.get("dead_n", 0)), "max_expanded": int(st.get("max_expanded", 1)),
		"last_recommended": str(st.get("last_recommended", "")), "campaign_alpha_tick_count": ticks,
		"manager": "GameData.campaign_alpha_fallback",
	}

