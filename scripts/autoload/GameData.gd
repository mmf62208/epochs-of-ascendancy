func apply_space_depth_primary_step_live(step: String = "spd_catalog", province_id: int = 1) -> Dictionary:
	if not peace_state.has("space_depth_primary") or not (peace_state["space_depth_primary"] is Dictionary):
		peace_state["space_depth_primary"] = {"applied": [], "majors_done": {}, "tick": 0}
	var st: Dictionary = (peace_state["space_depth_primary"] as Dictionary).duplicate(true)
	var s := step.strip_edges().to_lower()
	var aliases := {
		"catalog": "spd_catalog", "sites": "spd_sites", "capacity": "spd_capacity",
		"power": "spd_power", "close": "spd_close",
	}
	if aliases.has(s):
		s = str(aliases[s])
	if not SPACE_DEPTH_PRIMARY_STEPS.has(s):
		s = SPACE_DEPTH_PRIMARY_STEPS[0]
	var live_api := ""
	var live_result: Dictionary = {}
	var major := ""
	if s == "spd_catalog":
		major = "spd_primary_catalog"
		live_api = "apply_space_depth_catalog_live"
		live_result = apply_space_depth_catalog_live(province_id)
	elif s == "spd_sites":
		major = "spd_primary_sites"
		live_api = "apply_space_depth_sites_live"
		live_result = apply_space_depth_sites_live(province_id)
	elif s == "spd_capacity":
		major = "spd_primary_capacity"
		live_api = "apply_space_depth_capacity_live"
		live_result = apply_space_depth_capacity_live(province_id)
	elif s == "spd_power":
		major = "spd_primary_power"
		live_api = "apply_space_depth_power_live"
		live_result = apply_space_depth_power_live(province_id)
	elif s == "spd_close":
		major = "spd_primary_close"
		live_api = "apply_space_depth_close_live"
		live_result = apply_space_depth_close_live(province_id)
	var step_ok := bool(live_result.get("ok", false))
	var major_credit := major if step_ok else ""
	var domain_script = load("res://scripts/core/SpaceDepthDomain.gd")
	var domain_res: Dictionary = {}
	var live_api_final: String = str(live_api)
	if domain_script != null and domain_script.has_method("apply_primary_step"):
		peace_state["space_depth_primary"] = st.duplicate(true)
		domain_res = domain_script.apply_primary_step(peace_state, s, live_api_final, major_credit, live_result)
	else:
		var applied_fb: Array = (st.get("applied", []) as Array).duplicate() if st.get("applied") is Array else []
		if not applied_fb.has(s):
			applied_fb.append(s)
		st["applied"] = applied_fb
		st["tick"] = int(st.get("tick", 0)) + 1
		var md_fb: Dictionary = (st.get("majors_done", {}) as Dictionary).duplicate(true)
		if not str(major_credit).is_empty():
			md_fb[major_credit] = int(md_fb.get(major_credit, 0)) + 1
		st["majors_done"] = md_fb
		peace_state["space_depth_primary"] = st.duplicate(true)
		var ticks_fb := int(peace_state.get("space_depth_primary_ticks", 0)) + 1
		peace_state["space_depth_primary_ticks"] = ticks_fb
		domain_res = {"applied_n": applied_fb.size(), "space_depth_primary_ticks": ticks_fb}
	return {
		"ok": step_ok, "live": true, "step": s, "major": major_credit, "live_api": live_api_final, "leaf": live_api_final,
		"live_result": live_result, "step_ok": step_ok,
		"space_depth_primary_ticks": int(domain_res.get("space_depth_primary_ticks", peace_state.get("space_depth_primary_ticks", 0))),
		"province_id": province_id, "domain": "SpaceDepthDomain",
		"manager": "GameData.space_depth_primary",
	}


func apply_space_depth_primary_live(province_id: int = 1) -> Dictionary:
	var results: Array = []
	for step in SPACE_DEPTH_PRIMARY_STEPS:
		results.append(apply_space_depth_primary_step_live(step, province_id))
	var majors_ok := 0
	var domain_script2 = load("res://scripts/core/SpaceDepthDomain.gd")
	if domain_script2 != null and domain_script2.has_method("majors_ok_count"):
		majors_ok = int(domain_script2.majors_ok_count(peace_state))
	var dead_n := 0
	var failed_n := 0
	var sites_ok := false
	var capacity_ok := false
	var power_ok := false
	for r in results:
		var api := str((r as Dictionary).get("live_api", ""))
		if api.is_empty() or api == "apply_focus":
			dead_n += 1
		if not bool((r as Dictionary).get("step_ok", (r as Dictionary).get("ok", false))):
			failed_n += 1
		var lr: Dictionary = (r as Dictionary).get("live_result", {}) if (r as Dictionary).get("live_result") is Dictionary else {}
		if str((r as Dictionary).get("step", "")) == "spd_sites":
			sites_ok = bool(lr.get("sites_ok", lr.get("ok", false)))
		if str((r as Dictionary).get("step", "")) == "spd_capacity":
			capacity_ok = bool(lr.get("capacity_ok", lr.get("ok", false)))
		if str((r as Dictionary).get("step", "")) == "spd_power":
			power_ok = bool(lr.get("power_ok", lr.get("ok", false)))
	var ok := majors_ok >= 5 and dead_n == 0 and failed_n == 0 and sites_ok and capacity_ok and power_ok
	return {
		"ok": ok, "live": true, "majors_ok": majors_ok, "dead_n": dead_n, "failed_n": failed_n,
		"complete": ok, "sites_ok": sites_ok, "capacity_ok": capacity_ok, "power_ok": power_ok,
		"model": "orbital_compact_ledger",
		"space_depth_primary_ticks": int(peace_state.get("space_depth_primary_ticks", 0)),
		"g0_domain": "SpaceDepthDomain",
		"province_id": province_id, "closed": SPACE_DEPTH_PRIMARY_STEPS,
	}


