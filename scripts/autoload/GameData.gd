	var combat_ok := false
	for r in results:
		var api := str((r as Dictionary).get("live_api", ""))
		if api.is_empty() or api == "apply_focus":
			dead_n += 1
		if not bool((r as Dictionary).get("step_ok", (r as Dictionary).get("ok", false))):
			failed_n += 1
		var lr: Dictionary = (r as Dictionary).get("live_result", {}) if (r as Dictionary).get("live_result") is Dictionary else {}
		if str((r as Dictionary).get("step", "")) == "sco_relations":
			rel_ok = bool(lr.get("rel_ok", lr.get("ok", false)))
		if str((r as Dictionary).get("step", "")) == "sco_independence":
			indep_ok = bool(lr.get("indep_ok", false)) and bool(lr.get("save_ok", false))
		if str((r as Dictionary).get("step", "")) == "sco_combat":
			combat_ok = bool(lr.get("combat_ok", lr.get("ok", false)))
	var ok := majors_ok >= 5 and dead_n == 0 and failed_n == 0 and rel_ok and indep_ok and combat_ok
	return {
		"ok": ok, "live": true, "majors_ok": majors_ok, "dead_n": dead_n, "failed_n": failed_n,
		"complete": ok, "rel_ok": rel_ok, "indep_ok": indep_ok, "combat_ok": combat_ok,
		"model": "orbital_compact_ledger",
		"space_colony_primary_ticks": int(peace_state.get("space_colony_primary_ticks", 0)),
