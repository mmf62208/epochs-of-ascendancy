	if not TradeManager.has_basing_access("GER", "ENG", pid):
		TradeManager.grant_basing_rights("ENG", "GER", pid, 8, {"silent": true, "major_port": true})
	var has := bool(TradeManager.has_basing_access("GER", "ENG", pid))
