	return product

func apply_save_browser_campaign_product(province_id: int = 1) -> Dictionary:
	var product: Dictionary = save_browser_campaign_product_live()
	# Default product apply = checkpoint (safe session continuity)
	var cp: Dictionary = product.get("checkpoint", {})
	var aid := str(cp.get("action_id", "save_slot:autosave"))
	return apply_order_panel_action(aid, province_id)

func format_save_browser_campaign_product_plain(province_id: int = 1) -> String:
