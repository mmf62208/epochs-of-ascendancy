		"closed": true, "manager": "GameData.battle_aar_close",
	}


func apply_battle_aar_primary_command_step_live(step: String = "aar_open", province_id: int = 1) -> Dictionary:
	if not peace_state.has("battle_aar_primary") or not (peace_state["battle_aar_primary"] is Dictionary):
		peace_state["battle_aar_primary"] = {"applied": [], "majors_done": {}, "tick": 0, "last_live_api": ""}
	var st: Dictionary = (peace_state["battle_aar_primary"] as Dictionary).duplicate(true)
	var s := step.strip_edges().to_lower()
	var aliases := {
		"open": "aar_open", "record": "aar_record", "factors": "aar_factors",
		"persist": "aar_persist", "close": "aar_close",
	}
	if aliases.has(s):
		s = str(aliases[s])
	if not BATTLE_AAR_PRIMARY_STEPS.has(s):
		s = BATTLE_AAR_PRIMARY_STEPS[0]
	var live_api := ""
	var live_result: Dictionary = {}
	var major_key := ""
	if s == "aar_open":
		major_key = "aar_primary_open"
		live_api = "apply_multi_phase_combat_product"
		if has_method("apply_multi_phase_combat_product"):
			live_result = apply_multi_phase_combat_product(province_id)
	elif s == "aar_record":
		major_key = "aar_primary_record"
		live_api = "apply_combat_ops_close_live"
		if has_method("apply_combat_ops_close_live"):
			live_result = apply_combat_ops_close_live(province_id)
	elif s == "aar_factors":
		major_key = "aar_primary_factors"
		live_api = "apply_phase_engage"
		if has_method("apply_phase_engage"):
			live_result = apply_phase_engage(province_id)
	elif s == "aar_persist":
		major_key = "aar_primary_persist"
		live_api = "apply_battle_aar_persist_live"
		live_result = apply_battle_aar_persist_live(province_id)
	elif s == "aar_close":
		major_key = "aar_primary_close"
		live_api = "apply_battle_aar_close_live"
		live_result = apply_battle_aar_close_live(province_id)
	## G0 — BattleAarDomain owns package state
	var domain_script = load("res://scripts/core/BattleAarDomain.gd")
	var domain_res: Dictionary = {}
	if domain_script != null and domain_script.has_method("apply_primary_step"):
		domain_res = domain_script.apply_primary_step(peace_state, s, live_api, major_key)
	else:
		st["last_live_api"] = live_api
		var applied: Array = (st.get("applied", []) as Array).duplicate() if st.get("applied") is Array else []
		if not applied.has(s):
			applied.append(s)
		st["applied"] = applied
		st["tick"] = int(st.get("tick", 0)) + 1
		var md: Dictionary = (st.get("majors_done", {}) as Dictionary).duplicate(true)
		if not major_key.is_empty():
			md[major_key] = int(md.get(major_key, 0)) + 1
		st["majors_done"] = md
		var complete_fb := applied.size() >= BATTLE_AAR_PRIMARY_STEPS.size()
		st["complete"] = complete_fb
		peace_state["battle_aar_primary"] = st.duplicate(true)
		var ticks_fb := int(peace_state.get("battle_aar_primary_ticks", 0)) + 1
		peace_state["battle_aar_primary_ticks"] = ticks_fb
		domain_res = {"applied_n": applied.size(), "complete": complete_fb, "battle_aar_primary_ticks": ticks_fb, "manager": "GameData.fallback"}
	return {
		"ok": true, "live": true, "step": s, "major": major_key, "live_api": live_api, "leaf": live_api,
		"live_result": live_result, "applied_n": int(domain_res.get("applied_n", 0)),
		"complete": bool(domain_res.get("complete", false)),
		"battle_aar_primary_ticks": int(domain_res.get("battle_aar_primary_ticks", peace_state.get("battle_aar_primary_ticks", 0))),
		"province_id": province_id,
		"domain": str(domain_res.get("manager", "BattleAarDomain")),
		"manager": "GameData.battle_aar_primary",
	}


func apply_battle_aar_primary_command_live(province_id: int = 1) -> Dictionary:
	var results: Array = []
	for step in BATTLE_AAR_PRIMARY_STEPS:
		results.append(apply_battle_aar_primary_command_step_live(step, province_id))
	var majors_ok := 0
	var domain_script2 = load("res://scripts/core/BattleAarDomain.gd")
	if domain_script2 != null and domain_script2.has_method("majors_ok_count"):
		majors_ok = int(domain_script2.majors_ok_count(peace_state))
	elif peace_state.has("battle_aar_primary") and peace_state["battle_aar_primary"] is Dictionary:
		var md: Dictionary = (peace_state["battle_aar_primary"] as Dictionary).get("majors_done", {}) as Dictionary
		for k in ["aar_primary_open", "aar_primary_record", "aar_primary_factors", "aar_primary_persist", "aar_primary_close"]:
			if int(md.get(k, 0)) > 0:
				majors_ok += 1
	var dead_n := 0
	for r in results:
		var api := str((r as Dictionary).get("live_api", ""))
		if api.is_empty() or "apply_focus" in api:
