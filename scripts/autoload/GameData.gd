	var st: Dictionary = peace_state.get("equipment_flow_paint_primary", {}) if peace_state.get("equipment_flow_paint_primary") is Dictionary else {}
	var applied: Array = st.get("applied", []) if st.get("applied") is Array else []
	var md: Dictionary = st.get("majors_done", {}) if st.get("majors_done") is Dictionary else {}
	var majors_n := 0
