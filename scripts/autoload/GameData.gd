	var s := step.strip_edges().to_lower().replace("economy_", "").replace("war_economy_", "")
	var factories := int(st.get("factories", 14))
	var converted := int(st.get("converted", 0))
	var stock := int(st.get("stockpile_delta", 0))
	var frac := float(st.get("convert_frac", 0.28))
	if s.begins_with("civ") or s.begins_with("board"):
		factories = maxi(factories, 14)
		if has_method("apply_order_panel_action"):
			apply_order_panel_action("apply_production", province_id)
	elif s.begins_with("convert") or s.begins_with("war"):
