## Quality gap close — custom design registers as UnitTemplate; production resolves without Unknown-template.
func apply_quality_gap_close_live(province_id: int = 1) -> Dictionary:
	var tag := "GER"
	var design_id := "custom_ger_quality_v1"
	var reg: Dictionary = {"ok": false, "template_registered": false}
	if typeof(DesignManager) != TYPE_NIL and DesignManager.has_method("register_custom_design"):
		reg = DesignManager.register_custom_design(tag, {
			"id": design_id,
			"domain": "land",
			"modules": ["land_main", "land_engine", "armor_skirts"],
			"owner": tag,
			"base_type": "Land",
		})
	var template_ok := false
	if typeof(GameData) != TYPE_NIL and design_data != null and design_data.has_method("get_template"):
		var tpl = design_data.get_template(design_id)
		template_ok = tpl != null and str(tpl.id) == design_id
	if not template_ok and bool(reg.get("template_registered", false)):
		template_ok = true
	# Seed production on the custom design (should not leave template missing).
	var seed: Dictionary = {}
	if has_method("apply_designer_domain_seed_live"):
		seed = apply_designer_domain_seed_live(tag, "land", design_id, province_id)
	var has_custom := false
	if typeof(DesignManager) != TYPE_NIL and DesignManager.has_method("has_custom_design"):
		has_custom = bool(DesignManager.has_custom_design(tag, design_id))
	var ok := bool(reg.get("ok", false)) and template_ok and has_custom
	peace_state["quality_gap_close"] = {
		"design_id": design_id,
		"template_ok": template_ok,
		"registered": bool(reg.get("ok", false)),
		"seeded": bool(seed.get("seeded", seed.get("ok", false))),
		"complete": ok,
	}
	var ticks := int(peace_state.get("quality_gap_close_ticks", 0)) + 1
	peace_state["quality_gap_close_ticks"] = ticks
	return {
		"ok": ok,
		"live": true,
		"design_id": design_id,
		"template_ok": template_ok,
		"registered": bool(reg.get("ok", false)),
		"template_registered": bool(reg.get("template_registered", false)),
		"has_custom": has_custom,
		"seeded": bool(seed.get("seeded", seed.get("ok", false))),
		"seed_bootstrap_ok": bool(seed.get("bootstrap_ok", false)),
		"quality_gap_close_ticks": ticks,
		"province_id": province_id,
		"manager": "DesignManager+DesignDataLoader",
		"closed": ["custom_template_registration", "designer_seed_custom"],
	}


## Next-20 completion package — OPEN majors #1–#5 vertical slices (20 live steps).
const NEXT20_STEPS: PackedStringArray = [
	"combat_ribbon_surface", "combat_phase_approach", "combat_phase_engage", "combat_phase_disengage",
	"fleet_posture_day", "fleet_station_escort", "fleet_follow_through", "fleet_autonomy_close",
	"medium_line_scan", "medium_horizon_60d", "medium_horizon_100d", "medium_oob_equip_close",
	"save_browser_list", "save_browser_resume", "save_checkpoint", "save_browser_close",
	"hh_trail_faction_filter", "hh_monthly_commit", "hh_quarterly_counter", "hh_agenda_depth_close",
]


func _ensure_next20_state() -> Dictionary:
	if not peace_state.has("next20_completion") or not (peace_state["next20_completion"] is Dictionary):
		peace_state["next20_completion"] = {
			"applied": [],
			"complete": false,
			"tick": 0,
			"combat": {"phase": "idle", "ribbon": false, "history": []},
			"fleet": {"day": 0, "fuel": 0.8, "posture": "", "history": []},
			"medium": {"scanned": false, "horizon_d": 0, "units_projected": 0, "history": []},
			"save": {"slots": [], "resume_slot": "", "checkpoint": false, "history": []},
			"hh": {"faction": "", "months": 0, "trail": [], "history": []},
			"majors_done": {},
		}
	return (peace_state["next20_completion"] as Dictionary).duplicate(true)


func apply_next20_step_live(step: String = "combat_ribbon_surface", province_id: int = 1) -> Dictionary:
	var st: Dictionary = _ensure_next20_state()
	var s := step.strip_edges().to_lower()
	if not NEXT20_STEPS.has(s):
		# fuzzy match
		for cand in NEXT20_STEPS:
			if s in cand or cand in s:
				s = cand
				break
		if not NEXT20_STEPS.has(s):
			s = NEXT20_STEPS[0]
	var leaf := "apply_focus"
	var major := 0
	if s.begins_with("combat"):
		major = 1
		leaf = "apply_assault"
		var ch: Dictionary = (st.get("combat", {}) as Dictionary).duplicate(true)
		var hist_c: Array = (ch.get("history", []) as Array).duplicate() if ch.get("history") is Array else []
		if s == "combat_ribbon_surface":
			ch["ribbon"] = true
		elif s == "combat_phase_approach":
			ch["phase"] = "approach"
			hist_c.append("approach")
		elif s == "combat_phase_engage":
			ch["phase"] = "engage"
			hist_c.append("engage")
		elif s == "combat_phase_disengage":
			ch["phase"] = "disengage"
			hist_c.append("disengage")
		ch["history"] = hist_c
		st["combat"] = ch
		if has_method("apply_combat_ops_close_live") and s != "combat_ribbon_surface":
			apply_combat_ops_close_live(province_id)
	elif s.begins_with("fleet"):
		major = 2
		leaf = "apply_station"
		var fl: Dictionary = (st.get("fleet", {}) as Dictionary).duplicate(true)
		var hist_f: Array = (fl.get("history", []) as Array).duplicate() if fl.get("history") is Array else []
		if s == "fleet_posture_day":
			fl["day"] = 0
			fl["posture"] = "patrol"
			hist_f.append("posture")
		elif s == "fleet_station_escort":
			fl["day"] = 1
			fl["fuel"] = float(fl.get("fuel", 0.8)) * 0.92
			hist_f.append("station_escort")
		elif s == "fleet_follow_through":
			fl["day"] = 2
			hist_f.append("follow_through")
		elif s == "fleet_autonomy_close":
			hist_f.append("close")
		fl["history"] = hist_f
		st["fleet"] = fl
		if has_method("apply_naval_ops_close_live") and s != "fleet_autonomy_close":
			apply_naval_ops_close_live(province_id)
	elif s.begins_with("medium"):
		# Major #3 — route through real medium-tank OOB / horizon APIs (not generic production leaf).
		major = 3
		leaf = "apply_medium_tank_oob_product"
		var md: Dictionary = (st.get("medium", {}) as Dictionary).duplicate(true)
		var hist_m: Array = (md.get("history", []) as Array).duplicate() if md.get("history") is Array else []
		var live_m: Dictionary = {}
		if s == "medium_line_scan":
			md["scanned"] = true
			hist_m.append("scan")
			leaf = "apply_medium_tank_oob_product"
			if has_method("apply_medium_tank_oob_product"):
				live_m = apply_medium_tank_oob_product(province_id)
		elif s == "medium_horizon_60d":
			md["horizon_d"] = 60
			md["units_projected"] = maxi(1, int(md.get("units_projected", 0)))
			hist_m.append("60d")
			leaf = "apply_oob_horizon_60d"
			if has_method("apply_oob_horizon_60d"):
				live_m = apply_oob_horizon_60d(province_id)
		elif s == "medium_horizon_100d":
			md["horizon_d"] = 100
			md["units_projected"] = maxi(2, int(md.get("units_projected", 0)) + 1)
			hist_m.append("100d")
			leaf = "apply_oob_horizon_100d"
			if has_method("apply_oob_horizon_100d"):
				live_m = apply_oob_horizon_100d(province_id)
		elif s == "medium_oob_equip_close":
			hist_m.append("close")
			leaf = "apply_medium_tank_oob_sequence"
			if has_method("apply_medium_tank_oob_sequence"):
				live_m = apply_medium_tank_oob_sequence(province_id)
			elif has_method("apply_medium_tank_oob_product"):
				live_m = apply_medium_tank_oob_product(province_id)
		md["history"] = hist_m
		md["live_result"] = live_m
		st["medium"] = md
		st["last_live_api"] = leaf
	elif s.begins_with("save"):
		# Major #4 — route through save_browser_campaign_product live APIs (not apply_focus).
		major = 4
		leaf = "apply_save_browser_campaign_product"
		var sv: Dictionary = (st.get("save", {}) as Dictionary).duplicate(true)
		var hist_s: Array = (sv.get("history", []) as Array).duplicate() if sv.get("history") is Array else []
		var live_s: Dictionary = {}
		if s == "save_browser_list":
			hist_s.append("list")
			leaf = "save_browser_campaign_product_live"
			if has_method("save_browser_campaign_product_live"):
				live_s = save_browser_campaign_product_live()
			elif has_method("apply_save_browser_campaign_product"):
				live_s = apply_save_browser_campaign_product(province_id)
			# Prefer live slot list from product; fall back to fixed set.
			var slots_live: Array = []
			if live_s is Dictionary:
				var rows_v: Variant = live_s.get("rows", live_s.get("slots", []))
				if rows_v is Array:
					for row in rows_v:
						if row is Dictionary:
							slots_live.append(str((row as Dictionary).get("slot", "")))
						else:
							slots_live.append(str(row))
			if slots_live.is_empty():
				slots_live = ["quicksave", "autosave", "slot1", "slot2"]
			sv["slots"] = slots_live
		elif s == "save_browser_resume":
			hist_s.append("resume")
			leaf = "apply_save_browser_resume"
			if has_method("apply_save_browser_resume"):
				live_s = apply_save_browser_resume(province_id)
			var resume_slot := "quicksave"
			if live_s is Dictionary:
				var res_d: Dictionary = live_s.get("resume", {}) as Dictionary if live_s.get("resume") is Dictionary else {}
				if not str(res_d.get("slot", "")).is_empty():
					resume_slot = str(res_d.get("slot"))
			sv["resume_slot"] = resume_slot
		elif s == "save_checkpoint":
			hist_s.append("checkpoint")
			leaf = "apply_save_browser_checkpoint"
			if has_method("apply_save_browser_checkpoint"):
				live_s = apply_save_browser_checkpoint(province_id)
			sv["checkpoint"] = true
		elif s == "save_browser_close":
			hist_s.append("close")
			leaf = "apply_save_browser_campaign_product"
			if has_method("apply_save_browser_campaign_product"):
				live_s = apply_save_browser_campaign_product(province_id)
		sv["history"] = hist_s
		sv["live_result"] = live_s
		st["save"] = sv
		st["last_live_api"] = leaf
	elif s.begins_with("hh"):
		major = 5
		leaf = "apply_hh_agenda_close_live"
		var hh: Dictionary = (st.get("hh", {}) as Dictionary).duplicate(true)
		var hist_h: Array = (hh.get("history", []) as Array).duplicate() if hh.get("history") is Array else []
		var trail: Array = (hh.get("trail", []) as Array).duplicate() if hh.get("trail") is Array else []
		if s == "hh_trail_faction_filter":
			hh["faction"] = "axis"
			trail.append({"step": "filter", "faction": "axis"})
			hist_h.append("filter")
		elif s == "hh_monthly_commit":
			hh["months"] = int(hh.get("months", 0)) + 1
			trail.append({"step": "monthly", "month": hh["months"]})
			hist_h.append("monthly")
		elif s == "hh_quarterly_counter":
			trail.append({"step": "quarterly"})
			hist_h.append("quarterly")
		elif s == "hh_agenda_depth_close":
			hist_h.append("close")
		hh["trail"] = trail
		hh["history"] = hist_h
		st["hh"] = hh
		if has_method("apply_hh_agenda_close_live") and s != "hh_agenda_depth_close":
			apply_hh_agenda_close_live(province_id)
		elif has_method("apply_hh_multi_month_agenda_product"):
			apply_hh_multi_month_agenda_product(province_id)
		st["last_live_api"] = leaf
	else:
		major = 0
		leaf = ""

	# Combat/fleet still may touch order leaves via close-live helpers above.
	# Do NOT call generic apply_focus for save/medium (avoids industrial_effort WARN noise).

	var applied: Array = (st.get("applied", []) as Array).duplicate() if st.get("applied") is Array else []
	if not applied.has(s):
		applied.append(s)
	st["applied"] = applied
	st["tick"] = int(st.get("tick", 0)) + 1
	var majors_done: Dictionary = (st.get("majors_done", {}) as Dictionary).duplicate(true)
	majors_done[str(major)] = int(majors_done.get(str(major), 0)) + 1
	st["majors_done"] = majors_done
	var complete := applied.size() >= 20
	if complete:
		for req in NEXT20_STEPS:
			if not applied.has(req):
				complete = false
				break
	st["complete"] = complete
	peace_state["next20_completion"] = st.duplicate(true)
	var ticks := int(peace_state.get("next20_completion_ticks", 0)) + 1
	peace_state["next20_completion_ticks"] = ticks
	return {
		"ok": true,
		"live": true,
		"step": s,
		"major": major,
		"leaf": leaf,
		"live_api": str(st.get("last_live_api", leaf)),
		"applied_n": applied.size(),
		"complete": complete,
		"next20_completion_ticks": ticks,
		"province_id": province_id,
		"manager": "GameData.next20_completion",
	}


func apply_next20_completion_live(province_id: int = 1) -> Dictionary:
	"""Apply all 20 package steps (OPEN majors #1–#5)."""
	var results: Array = []
	for step in NEXT20_STEPS:
		results.append(apply_next20_step_live(step, province_id))
	var last: Dictionary = results[results.size() - 1] if results.size() > 0 else {}
	var applied_n := int(last.get("applied_n", 0))
	var complete := bool(last.get("complete", false)) and applied_n >= 20
	var majors_ok := 0
	if peace_state.has("next20_completion") and peace_state["next20_completion"] is Dictionary:
		var st2: Dictionary = peace_state["next20_completion"] as Dictionary
		var md: Dictionary = st2.get("majors_done", {}) as Dictionary
		for k in ["1", "2", "3", "4", "5"]:
			if int(md.get(k, 0)) >= 4:
				majors_ok += 1
	return {
		"ok": complete and majors_ok >= 5,
		"live": true,
		"applied_n": applied_n,
		"majors_ok": majors_ok,
		"complete": complete,
		"steps_n": results.size(),
		"next20_completion_ticks": int(peace_state.get("next20_completion_ticks", 0)),
		"province_id": province_id,
		"closed": NEXT20_STEPS,
	}


