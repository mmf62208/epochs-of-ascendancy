			var rep: Dictionary = {}
			if mr.has_method("get_perf_last_report"):
				rep = mr.call("get_perf_last_report") as Dictionary
			var frames_n := int(rep.get("frames", 0))
			var avg := float(rep.get("frame_avg_ms", 0.0))
			var mx := float(rep.get("frame_max_ms", 0.0))
			if frames_n > 0 and avg > 0.0:
				samples.append(avg)
				if mx > 0.0 and not is_equal_approx(mx, avg):
					samples.append(mx)
				# expand to at least 4 points from avg for product shape
				while samples.size() < 4:
					samples.append(avg)
				source = "map_renderer"
	# 2) Performance monitor process time (real engine metric; works headless)
	if samples.is_empty():
		for _i in range(8):
			var pt := float(Performance.get_monitor(Performance.TIME_PROCESS)) * 1000.0
			if pt <= 0.0:
				pt = float(Performance.get_monitor(Performance.TIME_FPS))
				if pt > 0.0:
					pt = 1000.0 / pt
			if pt > 0.0:
				samples.append(pt)
		if not samples.is_empty():
			source = "performance_monitor"
	var measured := samples.size()
	var mean := 0.0
	if measured > 0:
		for s in samples:
			mean += float(s)
		mean /= float(measured)
	var fps := (1000.0 / mean) if mean > 0.001 else 0.0
	var empty := measured <= 0
	peace_state["map_perf_measured_samples"] = samples.duplicate()
	peace_state["map_perf_measured_source"] = source
	peace_state["map_perf_measured_mean_ms"] = mean
	var ticks := int(peace_state.get("map_perf_sample_ticks", 0)) + 1
	peace_state["map_perf_sample_ticks"] = ticks
	return {
		"ok": not empty, "live": true, "sample_n": measured, "measured": measured, "empty": empty,
		"frame_times_ms": samples, "mean_ms": mean, "estimated_fps": fps, "source": source,
		"synthetic": false, "province_id": province_id, "live_api": "apply_map_perf_sample_frames_live",
		"map_perf_sample_ticks": ticks, "manager": "GameData.map_perf_sample",
	}


