func apply_production_priority_mutation(unit_id: String = "primary", line_id: String = "primary") -> Dictionary:
	if typeof(ProductionManager) == TYPE_NIL:
		return {"ok": false, "reason": "no ProductionManager"}
	var mut: Dictionary = MapPolishFormatters.production_priority_mutation(
		10.0, 0.0, "dry", 1.0, 0.2, 1.0, line_id, unit_id
	)
	var plan: Dictionary = mut.get("plan", {})
	var uid := str(plan.get("unit_id", unit_id))
	var enabled := bool(plan.get("enabled", true))
	var priority_ok := false
	if ProductionManager.has_method("set_unit_priority_reinforcement"):
		ProductionManager.set_unit_priority_reinforcement(uid, enabled)
		priority_ok = true
	# Live ProductionManager path (major #28): one real daily tick so stockpiles/lines move.
	var tick_ok := false
	var stock_before := 0
	var stock_after := 0
	var tag := "GER"
	if typeof(LeaderManager) != TYPE_NIL and LeaderManager.has_method("get_player_country_tag"):
		var t := str(LeaderManager.get_player_country_tag()).to_upper()
		if not t.is_empty():
			tag = t
	if ProductionManager.has_method("get_country_equipment_stockpile"):
		var b: Dictionary = ProductionManager.get_country_equipment_stockpile(tag)
		for k in b.keys():
			stock_before += int(b.get(k, 0))
	if ProductionManager.has_method("daily_production_tick"):
		ProductionManager.daily_production_tick()
		tick_ok = true
	if ProductionManager.has_method("get_country_equipment_stockpile"):
		var a: Dictionary = ProductionManager.get_country_equipment_stockpile(tag)
		for k in a.keys():
			stock_after += int(a.get(k, 0))
	peace_state["production_last_live_apply"] = {
		"unit_id": uid,
		"line_id": line_id,
		"priority_ok": priority_ok,
		"tick_ok": tick_ok,
		"stock_delta": stock_after - stock_before,
		"tag": tag,
	}
	var ok := priority_ok or tick_ok
	return {
		"ok": ok,
		"unit_id": uid,
		"enabled": enabled,
		"priority": str(plan.get("priority", "")),
		"live": tick_ok,
		"manager": "ProductionManager",
		"stock_delta": stock_after - stock_before,
		"reason": "" if ok else "no set_unit_priority_reinforcement and no daily_production_tick",
	}


## Tag-scoped production for interactive multi-AI (does NOT use player LeaderManager tag).
## Advances only that country's lines (or soft stock credit). Never calls global daily_production_tick.
func apply_production_for_tag(country_tag: String) -> Dictionary:
	var tag := country_tag.strip_edges().to_upper()
	if tag.is_empty():
		return {"ok": false, "reason": "empty_tag", "tag": tag}
	if typeof(ProductionManager) == TYPE_NIL:
		return {"ok": false, "reason": "no ProductionManager", "tag": tag}
	var stock_before := 0
	var stock_after := 0
	if ProductionManager.has_method("get_country_equipment_stockpile"):
		var b: Dictionary = ProductionManager.get_country_equipment_stockpile(tag)
		for k in b.keys():
			stock_before += int(b.get(k, 0))
	var adv: Dictionary = {}
	if ProductionManager.has_method("advance_days_for_country"):
		adv = ProductionManager.advance_days_for_country(tag, 1.0)
	else:
		return {"ok": false, "reason": "no advance_days_for_country", "tag": tag}
	if ProductionManager.has_method("get_country_equipment_stockpile"):
		var a: Dictionary = ProductionManager.get_country_equipment_stockpile(tag)
		for k in a.keys():
			stock_after += int(a.get(k, 0))
	var delta := stock_after - stock_before
	# Soft credit may land as units_completed 0 but stock +1
	var ok := bool(adv.get("ok", false)) or delta != 0 or int(adv.get("lines_touched", 0)) > 0
	peace_state["production_last_tag_apply"] = {
		"tag": tag,
		"stock_delta": delta,
		"lines_touched": int(adv.get("lines_touched", 0)),
		"soft_stock_credit": int(adv.get("soft_stock_credit", 0)),
	}
	return {
		"ok": ok,
		"tag": tag,
		"live": true,
		"stock_delta": delta,
		"lines_touched": int(adv.get("lines_touched", 0)),
		"soft_stock_credit": int(adv.get("soft_stock_credit", 0)),
		"manager": "ProductionManager.advance_days_for_country",
		"advance": adv,
	}



