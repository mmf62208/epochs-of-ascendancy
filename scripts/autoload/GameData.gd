	var has_month: bool = has_tm and TradeManager.has_method("process_monthly_basing_rights")
	var has_write: bool = has_tm  # _write used on accept; grant API is the public surface
	var ok: bool = has_grant and has_access and has_board and has_month
	return {
		"ok": ok, "live": true, "model": "strategic_compact_ledger",
		"grant_api": has_grant, "access_api": has_access, "board_api": has_board, "monthly_api": has_month,
