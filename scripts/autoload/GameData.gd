		{"hops": 2, "distance_km": 800.0, "year": 1916, "depot_fill": 0.85},
	)
	var flow: Dictionary = created.get("flow", {}) if created.get("flow") is Dictionary else {}
	var days_total := float(flow.get("days_total", 0))
	time_ok = time_ok and bool(created.get("ok", false)) and days_total >= 1.0
	return {
		"ok": time_ok, "live": true, "time_ok": time_ok,
		"d1916": a, "d2025": b, "d2080": c, "flow_days": days_total,
		"province_id": province_id, "live_api": "apply_reinforcement_logistics_time_live",
		"model": "reinforce_experience_logistics_ledger",
	}


func apply_reinforcement_logistics_exp_live(province_id: int = 1) -> Dictionary:
	if typeof(ProductionManager) == TYPE_NIL:
		return {"ok": false, "live": true, "error": "no_pm", "live_api": "apply_reinforcement_logistics_exp_live"}
	var calc = load("res://scripts/production/ReinforcementLogisticsCalculator.gd")
	if calc == null:
		return {"ok": false, "live": true, "error": "no_calc", "live_api": "apply_reinforcement_logistics_exp_live"}
	# Pure asymmetry check via calculator (always available)
	var after_greens := float(calc.blend_combat_experience_manpower(85.0, 12.0, 0.5))
	var after_rearm := float(calc.blend_combat_experience_rearm(85.0, 0.5, 0.35))
	var mult_g := float(calc.experience_combat_mult(15.0))
	var mult_v := float(calc.experience_combat_mult(90.0))
	var exp_ok: bool = after_greens < 65.0 and after_rearm > after_greens + 15.0 and mult_g < 0.9 and mult_v > 1.1
	# Live formation path when LeaderManager has a formation; else use pure ok as dual core
	var live_form_ok := true
	if typeof(LeaderManager) != TYPE_NIL and "formations" in LeaderManager:
		var fid := ""
		for k in LeaderManager.formations.keys():
			var ff = LeaderManager.formations[k]
			if ff == null:
				continue
			var ftype := str(ff.formation_type) if "formation_type" in ff else ""
			if ftype == "division":
				fid = str(k)
				break
			if fid.is_empty():
				fid = str(k)
		if not fid.is_empty():
			ProductionManager.set_formation_combat_experience(fid, 85.0)
			var f0 = LeaderManager.get_formation(fid)
			if f0 != null and "strength" in f0:
				f0.strength = 0.55
			var tag0 := "USA"
			if f0 != null and "country_tag" in f0:
				tag0 = str(f0.country_tag)
			ProductionManager.set_country_training_policy(tag0, "wartime_crash")
			var man: Dictionary = ProductionManager.apply_manpower_reinforce_with_experience(
				fid, 0.2, {"policy_id": "wartime_crash", "force_full": true, "recruit_xp": 12.0},
			)
			var rearm: Dictionary = ProductionManager.apply_equipment_rearm_experience(fid, 0.5, 0.35)
			live_form_ok = bool(man.get("ok", false)) \
				and float(man.get("combat_experience_after", 100)) < float(man.get("combat_experience_before", 0)) \
				and bool(rearm.get("ok", false))
	exp_ok = exp_ok and live_form_ok
	return {
		"ok": exp_ok, "live": true, "exp_ok": exp_ok,
		"after_greens": after_greens, "after_rearm": after_rearm,
		"mult_green": mult_g, "mult_vet": mult_v,
		"province_id": province_id, "live_api": "apply_reinforcement_logistics_exp_live",
		"model": "reinforce_experience_logistics_ledger",
	}


func apply_reinforcement_logistics_hub_live(province_id: int = 1) -> Dictionary:
	if typeof(ProductionManager) == TYPE_NIL or not ProductionManager.has_method("estimate_reinforce_transit_days"):
		return {"ok": false, "live": true, "error": "no_pm", "live_api": "apply_reinforcement_logistics_hub_live"}
	var near: Dictionary = ProductionManager.estimate_reinforce_transit_days(
		"rail", 1, 40.0, 1939, {"depot_fill": 1.0, "corridor_control": 1.0},
	)
	var far: Dictionary = ProductionManager.estimate_reinforce_transit_days(
		"rail", 1, 1600.0, 1939, {"depot_fill": 1.0, "corridor_control": 1.0},
	)
	var starved: Dictionary = ProductionManager.estimate_reinforce_transit_days(
		"airlift", 2, 800.0, 2020,
		{"depot_fill": 0.3, "corridor_control": 0.5, "fuel": 0.2, "supplies": 0.4},
	)
	var full: Dictionary = ProductionManager.estimate_reinforce_transit_days(
		"airlift", 2, 800.0, 2020,
		{"depot_fill": 1.0, "corridor_control": 1.0, "fuel": 1.0, "supplies": 1.0},
