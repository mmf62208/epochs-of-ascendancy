		return {"ok": false, "live": true, "error": "no_slm", "live_api": "apply_space_rival_survey_tick_live"}
	var tick: Dictionary = SpaceLayerManager.process_monthly_rival_surveys(1990, 3, {
		"rivals": ["SOV", "GER"], "targets": ["mars", "luna", "europa"], "max_new_per_month": 2, "months": 2,
	})
	var ok: bool = bool(tick.get("ok", false)) and int(tick.get("surveys_started", 0)) >= 1
	return {"ok": ok, "live": true, "tick_ok": ok, "tick": tick, "province_id": province_id, "live_api": "apply_space_rival_survey_tick_live"}


