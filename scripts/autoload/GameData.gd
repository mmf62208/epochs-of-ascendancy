func apply_trade_desk_interdict_live(province_id: int = 1) -> Dictionary:
	if typeof(TradeManager) == TYPE_NIL or not TradeManager.has_method("process_monthly_trade_risks"):
		return {"ok": false, "live": true, "error": "no_risks", "live_api": "apply_trade_desk_interdict_live"}
	var flow_id: String = ""
	if TradeManager.has_method("seed_demo_trade_flow"):
		flow_id = str(TradeManager.seed_demo_trade_flow("USA", "ENG", "steel", 24.0))
	var before_qty: float = 0.0
	if not flow_id.is_empty() and TradeManager.has_method("get_trade_flow"):
		var fl: TradeFlow = TradeManager.get_trade_flow(flow_id)
		if fl:
			before_qty = fl.quantity_per_turn
	var rep: Dictionary = TradeManager.process_monthly_trade_risks(1936, 6, {
		"force_hit": true,
		"include_demo": true,
		"force_loss": 0.4,
		"force_cause": "submarine",
		"force_province": maxi(province_id, 42),
		"attacker_tag": "GER",
		"silent": true,
	})
	var interdicted: int = int(rep.get("interdicted", 0))
	var after_qty: float = before_qty
	var auto_monthly: bool = false
	if not flow_id.is_empty() and TradeManager.has_method("get_trade_flow"):
		var fl2: TradeFlow = TradeManager.get_trade_flow(flow_id)
		if fl2:
			after_qty = fl2.quantity_per_turn
			var hist: Array = fl2.metadata.get("interdiction_history", []) as Array if fl2.metadata.get("interdiction_history") is Array else []
			if not hist.is_empty() and hist[hist.size() - 1] is Dictionary:
				var last: Dictionary = hist[hist.size() - 1] as Dictionary
				auto_monthly = bool(last.get("auto_monthly", false))
	var events: Array = rep.get("events", []) as Array if rep.get("events") is Array else []
	var has_event: bool = interdicted >= 1 and events.size() >= 1
	var rate_cut: bool = before_qty > 0.0 and after_qty < before_qty - 0.001
	var interdict_ok: bool = has_event and rate_cut
	return {
		"ok": interdict_ok, "live": true, "interdict_ok": interdict_ok,
		"report": rep, "flow_id": flow_id, "before_qty": before_qty, "after_qty": after_qty,
		"auto_monthly": auto_monthly, "interdicted": interdicted,
		"province_id": province_id, "live_api": "apply_trade_desk_interdict_live",
		"scenario": "auto_monthly_interdict",
	}


func apply_trade_desk_tariff_live(province_id: int = 1) -> Dictionary:
	if typeof(TradeManager) == TYPE_NIL:
		return {"ok": false, "live": true, "error": "no_tm", "live_api": "apply_trade_desk_tariff_live"}
	# Import tariff USA ← ENG steel
	if TradeManager.has_method("set_bilateral_trade_policy"):
		TradeManager.set_bilateral_trade_policy("ENG", "USA", {"import_tariff": 0.25})
	var pol: Dictionary = TradeManager.get_bilateral_trade_policy("ENG", "USA") if TradeManager.has_method("get_bilateral_trade_policy") else {}
	var treasury_before: float = float(TradeManager.get_tariff_treasury("USA")) if TradeManager.has_method("get_tariff_treasury") else 0.0
	var flow_id: String = ""
	if TradeManager.has_method("seed_demo_trade_flow"):
		flow_id = str(TradeManager.seed_demo_trade_flow("ENG", "USA", "steel", 100.0))
	# Force delivery tick
	if TradeManager.has_method("advance_trade_flows"):
		TradeManager.advance_trade_flows(1936)
	var treasury_after: float = float(TradeManager.get_tariff_treasury("USA")) if TradeManager.has_method("get_tariff_treasury") else 0.0
	var last_tariff: Dictionary = {}
	if not flow_id.is_empty() and TradeManager.has_method("get_trade_flow"):
		var fl: TradeFlow = TradeManager.get_trade_flow(flow_id)
		if fl and fl.metadata.get("last_tariff") is Dictionary:
			last_tariff = fl.metadata["last_tariff"] as Dictionary
	var rate_ok: bool = float(pol.get("import_tariff", 0.0)) >= 0.24
	var skim_ok: bool = float(last_tariff.get("skimmed", 0.0)) > 0.0 or (treasury_after > treasury_before + 0.01)
	var net_ok: bool = true
	if last_tariff.has("net_amount") and last_tariff.has("skimmed"):
		net_ok = float(last_tariff.get("net_amount", 0.0)) + float(last_tariff.get("skimmed", 0.0)) >= 99.0
	var tariff_ok: bool = rate_ok and skim_ok and net_ok
	return {
		"ok": tariff_ok, "live": true, "tariff_ok": tariff_ok,
		"policy": pol, "last_tariff": last_tariff,
		"treasury_before": treasury_before, "treasury_after": treasury_after,
		"flow_id": flow_id,
		"province_id": province_id, "live_api": "apply_trade_desk_tariff_live",
		"scenario": "import_tariff_skim",
	}


func apply_trade_desk_board_live(province_id: int = 1) -> Dictionary:
