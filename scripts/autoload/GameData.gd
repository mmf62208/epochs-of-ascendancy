func apply_reinforce_story_xp_live(province_id: int = 1) -> Dictionary:
	var calc = load("res://scripts/production/ReinforcementLogisticsCalculator.gd")
	if calc == null:
		return {"ok": false, "live": true, "error": "no_calc", "live_api": "apply_reinforce_story_xp_live"}
	var plain := str(calc.attribution_plain_xp_dilution(85.0, 48.0, "3rd Army"))
	var xp_ok: bool = "diluted" in plain.to_lower() or "green" in plain.to_lower() or "experience" in plain.to_lower()
	if typeof(ProductionManager) != TYPE_NIL and ProductionManager.has_method("apply_manpower_reinforce_with_experience") \
			and typeof(LeaderManager) != TYPE_NIL and "formations" in LeaderManager:
		var fid := ""
		for k in LeaderManager.formations.keys():
			if LeaderManager.formations[k] != null:
				fid = str(k)
				break
		if not fid.is_empty():
			ProductionManager.set_formation_combat_experience(fid, 85.0)
			var f0 = LeaderManager.get_formation(fid)
			if f0 != null and "strength" in f0:
				f0.strength = 0.5
			var man: Dictionary = ProductionManager.apply_manpower_reinforce_with_experience(
				fid, 0.15, {"policy_id": "wartime_crash", "force_full": true, "recruit_xp": 12.0},
			)
			var mp := str(man.get("plain", ""))
			xp_ok = xp_ok and bool(man.get("ok", false)) and not mp.is_empty()
	return {"ok": xp_ok, "live": true, "xp_plain_ok": xp_ok, "plain": plain, "province_id": province_id, "live_api": "apply_reinforce_story_xp_live", "model": "reinforce_experience_logistics_ledger"}


