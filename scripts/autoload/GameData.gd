func apply_trade_desk_primary_step_live(step: String = "tdk_catalog", province_id: int = 1) -> Dictionary:
	if not peace_state.has("trade_desk_primary") or not (peace_state["trade_desk_primary"] is Dictionary):
		peace_state["trade_desk_primary"] = {"applied": [], "majors_done": {}, "tick": 0}
	var st: Dictionary = (peace_state["trade_desk_primary"] as Dictionary).duplicate(true)
	var s := step.strip_edges().to_lower()
	var aliases := {
		"catalog": "tdk_catalog", "interdict": "tdk_interdict", "tariff": "tdk_tariff",
		"desk": "tdk_desk", "board": "tdk_desk", "close": "tdk_close",
	}
	if aliases.has(s):
		s = str(aliases[s])
	if not TRADE_DESK_PRIMARY_STEPS.has(s):
		s = TRADE_DESK_PRIMARY_STEPS[0]
	var live_api := ""
	var live_result: Dictionary = {}
	var major := ""
	if s == "tdk_catalog":
		major = "tdk_primary_catalog"
		live_api = "apply_trade_desk_catalog_live"
		live_result = apply_trade_desk_catalog_live(province_id)
	elif s == "tdk_interdict":
		major = "tdk_primary_interdict"
		live_api = "apply_trade_desk_interdict_live"
		live_result = apply_trade_desk_interdict_live(province_id)
	elif s == "tdk_tariff":
		major = "tdk_primary_tariff"
		live_api = "apply_trade_desk_tariff_live"
		live_result = apply_trade_desk_tariff_live(province_id)
	elif s == "tdk_desk":
		major = "tdk_primary_desk"
		live_api = "apply_trade_desk_board_live"
		live_result = apply_trade_desk_board_live(province_id)
	elif s == "tdk_close":
		major = "tdk_primary_close"
		live_api = "apply_trade_desk_close_live"
		live_result = apply_trade_desk_close_live(province_id)
	var step_ok := bool(live_result.get("ok", false))
	var major_credit := major if step_ok else ""
	var domain_script = load("res://scripts/core/TradeDeskDomain.gd")
	var domain_res: Dictionary = {}
	var live_api_final: String = str(live_api)
	if domain_script != null and domain_script.has_method("apply_primary_step"):
		peace_state["trade_desk_primary"] = st.duplicate(true)
		domain_res = domain_script.apply_primary_step(peace_state, s, live_api_final, major_credit, live_result)
	else:
		var applied_fb: Array = (st.get("applied", []) as Array).duplicate() if st.get("applied") is Array else []
		if not applied_fb.has(s):
			applied_fb.append(s)
		st["applied"] = applied_fb
		st["tick"] = int(st.get("tick", 0)) + 1
		var md_fb: Dictionary = (st.get("majors_done", {}) as Dictionary).duplicate(true)
		if not str(major_credit).is_empty():
			md_fb[major_credit] = int(md_fb.get(major_credit, 0)) + 1
		st["majors_done"] = md_fb
		peace_state["trade_desk_primary"] = st.duplicate(true)
		var ticks_fb := int(peace_state.get("trade_desk_primary_ticks", 0)) + 1
		peace_state["trade_desk_primary_ticks"] = ticks_fb
		domain_res = {"applied_n": applied_fb.size(), "trade_desk_primary_ticks": ticks_fb}
	return {
		"ok": step_ok, "live": true, "step": s, "major": major_credit, "live_api": live_api_final, "leaf": live_api_final,
		"live_result": live_result, "step_ok": step_ok,
		"trade_desk_primary_ticks": int(domain_res.get("trade_desk_primary_ticks", peace_state.get("trade_desk_primary_ticks", 0))),
		"province_id": province_id, "domain": "TradeDeskDomain",
		"manager": "GameData.trade_desk_primary",
	}


func apply_trade_desk_primary_live(province_id: int = 1) -> Dictionary:
	var results: Array = []
	for step in TRADE_DESK_PRIMARY_STEPS:
		results.append(apply_trade_desk_primary_step_live(step, province_id))
	var majors_ok := 0
	var domain_script2 = load("res://scripts/core/TradeDeskDomain.gd")
	if domain_script2 != null and domain_script2.has_method("majors_ok_count"):
		majors_ok = int(domain_script2.majors_ok_count(peace_state))
	var dead_n := 0
	var failed_n := 0
	var interdict_ok := false
	var tariff_ok := false
	var desk_ok := false
	for r in results:
		var api := str((r as Dictionary).get("live_api", ""))
		if api.is_empty() or api == "apply_focus":
			dead_n += 1
		if not bool((r as Dictionary).get("step_ok", (r as Dictionary).get("ok", false))):
			failed_n += 1
		var lr: Dictionary = (r as Dictionary).get("live_result", {}) if (r as Dictionary).get("live_result") is Dictionary else {}
		if str((r as Dictionary).get("step", "")) == "tdk_interdict":
			interdict_ok = bool(lr.get("interdict_ok", lr.get("ok", false)))
		if str((r as Dictionary).get("step", "")) == "tdk_tariff":
			tariff_ok = bool(lr.get("tariff_ok", lr.get("ok", false)))
		if str((r as Dictionary).get("step", "")) == "tdk_desk":
			desk_ok = bool(lr.get("desk_ok", lr.get("ok", false)))
	var ok := majors_ok >= 5 and dead_n == 0 and failed_n == 0 and interdict_ok and tariff_ok and desk_ok
	return {
		"ok": ok, "live": true, "majors_ok": majors_ok, "dead_n": dead_n, "failed_n": failed_n,
		"complete": ok, "interdict_ok": interdict_ok, "tariff_ok": tariff_ok, "desk_ok": desk_ok,
		"model": "strategic_compact_ledger",
		"trade_desk_primary_ticks": int(peace_state.get("trade_desk_primary_ticks", 0)),
		"g0_domain": "TradeDeskDomain",
		"province_id": province_id, "closed": TRADE_DESK_PRIMARY_STEPS,
	}


## Residual trade AI — monthly propose/accept · flags · nuclear placate (R6).
const TRADE_AI_PRIMARY_STEPS: PackedStringArray = [
	"tai_catalog", "tai_propose", "tai_accept", "tai_refuse", "tai_close",
]


func apply_trade_ai_catalog_live(province_id: int = 1) -> Dictionary:
	var has_tm: bool = typeof(TradeManager) != TYPE_NIL
	var has_decide: bool = has_tm and TradeManager.has_method("ai_decide_accept")
	var has_month: bool = has_tm and TradeManager.has_method("process_monthly_ai_trade")
	var has_core: bool = has_tm and TradeManager.has_method("ai_accept_decision_core")
	var has_propose: bool = has_tm and TradeManager.has_method("ai_propose_resource_swap")
	var ok: bool = has_decide and has_month and has_core and has_propose
	return {
		"ok": ok, "live": true, "model": "strategic_compact_ledger",
		"decide_api": has_decide, "monthly_api": has_month, "core_api": has_core, "propose_api": has_propose,
		"province_id": province_id, "live_api": "apply_trade_ai_catalog_live",
	}


func apply_trade_ai_propose_live(province_id: int = 1) -> Dictionary:
	if typeof(TradeManager) == TYPE_NIL or not TradeManager.has_method("ai_propose_resource_swap"):
		return {"ok": false, "live": true, "error": "no_propose", "live_api": "apply_trade_ai_propose_live"}
	var oid: String = str(TradeManager.ai_propose_resource_swap("GER", "FRA", "steel", 50.0, "fuel", 35.0))
	var offer: Dictionary = {}
	if not oid.is_empty() and TradeManager.has_method("get_offer"):
		var ov: Variant = TradeManager.get_offer(oid)
		if ov is Dictionary:
			offer = ov as Dictionary
	elif not oid.is_empty():
		# Fallback: fairness path proves offer exists
		var fair: Dictionary = TradeManager.evaluate_fairness(oid, "FRA") if TradeManager.has_method("evaluate_fairness") else {}
		offer = {"id": oid, "status": 0, "fairness_score": fair.get("score", 0.0)}
	var monthly: Dictionary = {}
	if TradeManager.has_method("process_monthly_ai_trade"):
		monthly = TradeManager.process_monthly_ai_trade(1936, 7, {
			"max_resolve": 0,
			"max_propose": 1,
			"pairs": [["ITA", "JAP"]],
			"force_propose_only": true,
			"offer_resource": "rubber",
			"request_resource": "steel",
			"offer_qty": 20.0,
			"request_qty": 25.0,
		})
	var propose_ok: bool = not oid.is_empty() and int(monthly.get("proposed", 0)) >= 1
	return {
		"ok": propose_ok, "live": true, "propose_ok": propose_ok,
		"offer_id": oid, "offer": offer, "monthly": monthly,
		"province_id": province_id, "live_api": "apply_trade_ai_propose_live",
		"scenario": "ai_monthly_propose",
	}


func apply_trade_ai_accept_live(province_id: int = 1) -> Dictionary:
	if typeof(TradeManager) == TYPE_NIL:
		return {"ok": false, "live": true, "error": "no_tm", "live_api": "apply_trade_ai_accept_live"}
	# Core placate math (hopeless + nuclear lowers floor under refuse_below)
	var core_placate: Dictionary = TradeManager.ai_accept_decision_core(0.80, 0.95, false, -0.30, 0.85)
	var placate_ok: bool = str(core_placate.get("decision", "")) == "accept" and float(core_placate.get("threshold", 1.0)) < 0.85
	# Live fair resource swap for AI recipient
	var oid: String = ""
	if TradeManager.has_method("ai_propose_resource_swap"):
		oid = str(TradeManager.ai_propose_resource_swap("GER", "ITA", "steel", 40.0, "steel", 40.0))
	var dec: Dictionary = {}
	if not oid.is_empty() and TradeManager.has_method("ai_decide_accept"):
		dec = TradeManager.ai_decide_accept(oid, "ITA")
	var fair_accept: bool = str(dec.get("decision", "")) == "accept"
	# Execute monthly resolve on this offer only path: force resolve with max_propose 0
	var monthly: Dictionary = {}
	if TradeManager.has_method("process_monthly_ai_trade"):
		monthly = TradeManager.process_monthly_ai_trade(1936, 8, {
			"max_resolve": 12,
			"max_propose": 0,
			"force_resolve_only": true,
			"include_player_as_target": false,
		})
	var accepted_n: int = int(monthly.get("accepted", 0))
	var accept_ok: bool = placate_ok and fair_accept and accepted_n >= 1
	return {
		"ok": accept_ok, "live": true, "accept_ok": accept_ok,
		"placate_ok": placate_ok, "fair_accept": fair_accept,
		"core_placate": core_placate, "decision": dec, "offer_id": oid,
		"monthly": monthly, "accepted_n": accepted_n,
		"province_id": province_id, "live_api": "apply_trade_ai_accept_live",
		"scenario": "ai_accept_and_placate",
	}


func apply_trade_ai_refuse_live(province_id: int = 1) -> Dictionary:
	if typeof(TradeManager) == TYPE_NIL:
		return {"ok": false, "live": true, "error": "no_tm", "live_api": "apply_trade_ai_refuse_live"}
	# Embargo hard-block
	if TradeManager.has_method("set_bilateral_trade_policy"):
		TradeManager.set_bilateral_trade_policy("SOV", "JAP", {"embargo": true, "import_tariff": 0.5})
	var oid: String = ""
	if TradeManager.has_method("ai_propose_resource_swap"):
		oid = str(TradeManager.ai_propose_resource_swap("SOV", "JAP", "steel", 30.0, "fuel", 20.0))
	var dec: Dictionary = {}
	if not oid.is_empty() and TradeManager.has_method("ai_decide_accept"):
		dec = TradeManager.ai_decide_accept(oid, "JAP")
	var hard: bool = bool(dec.get("hard_block", false)) or str(dec.get("reason", "")) == "hard_block"
	var refuse_decision: bool = str(dec.get("decision", "")) == "refuse"
	# Poor score without placate
	var core_poor: Dictionary = TradeManager.ai_accept_decision_core(0.70, 0.95, false, 0.0, 0.85)
	var poor_refuse: bool = str(core_poor.get("decision", "")) == "refuse"
	# Monthly should refuse the embargoed offer
	var monthly: Dictionary = {}
	if TradeManager.has_method("process_monthly_ai_trade"):
		monthly = TradeManager.process_monthly_ai_trade(1936, 9, {
			"max_resolve": 12,
			"max_propose": 0,
			"force_resolve_only": true,
		})
	var refused_n: int = int(monthly.get("refused", 0))
	var refuse_ok: bool = hard and refuse_decision and poor_refuse and refused_n >= 1
	return {
		"ok": refuse_ok, "live": true, "refuse_ok": refuse_ok,
		"hard_block": hard, "decision": dec, "core_poor": core_poor,
		"offer_id": oid, "monthly": monthly, "refused_n": refused_n,
		"province_id": province_id, "live_api": "apply_trade_ai_refuse_live",
		"scenario": "ai_refuse_hard_block",
	}


