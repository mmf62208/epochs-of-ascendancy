func apply_manpower_law_live(country_tag: String = "GER", law: String = "limited") -> Dictionary:
	var tag := country_tag.strip_edges().to_upper()
	if tag.is_empty():
		tag = "GER"
	var law_k := law.strip_edges().to_lower()
	var mult := 0.75
	match law_k:
		"volunteer":
			mult = 0.55
		"limited":
			mult = 0.75
		"extensive":
			mult = 0.95
		"service_by_requirement":
			mult = 1.15
		_:
			law_k = "limited"
			mult = 0.75
	var st: Dictionary = get_manpower_national_state(tag)
	var pop := float(st.get("population_pool", 100000.0))
	var eligible := pop * 0.12 * mult
	st["law"] = law_k
	st["law_mult"] = mult
	st["eligible"] = eligible
	if not peace_state.has("manpower_national") or not (peace_state["manpower_national"] is Dictionary):
		peace_state["manpower_national"] = {}
	(peace_state["manpower_national"] as Dictionary)[tag] = st
	# Mirror into demographic_policies if present
	if peace_state.has("demographic_policies") and peace_state["demographic_policies"] is Dictionary:
		var dp: Dictionary = peace_state["demographic_policies"]
		var entry: Dictionary = dp.get(tag, {}) if dp.has(tag) else {}
		if not (entry is Dictionary):
			entry = {}
		entry["conscription_level"] = 0 if law_k == "volunteer" else (1 if law_k == "limited" else 2)
		entry["manpower_law"] = law_k
		dp[tag] = entry
		peace_state["demographic_policies"] = dp
	st["ok"] = true
	st["live"] = true
	st["manager"] = "GameData.manpower_national"
	st["tag"] = tag
	return st


func apply_manpower_training_tick_live(country_tag: String = "GER") -> Dictionary:
	var tag := country_tag.strip_edges().to_upper()
	if tag.is_empty():
		tag = "GER"
	var st: Dictionary = get_manpower_national_state(tag)
	var eligible := float(st.get("eligible", 9000.0))
	var cap := float(st.get("training_capacity", 0.65))
	var train_out := eligible * 0.08 * cap
	var trained := float(st.get("trained_stock", 5000.0)) + train_out
	var fielded := trained * 0.15
	st["trained_stock"] = trained
	st["training_output"] = train_out
	st["fielded_total"] = float(st.get("fielded_total", 0.0)) + fielded
	st["last_fielded"] = fielded
	if not peace_state.has("manpower_national") or not (peace_state["manpower_national"] is Dictionary):
		peace_state["manpower_national"] = {}
	(peace_state["manpower_national"] as Dictionary)[tag] = st
	var ticks := int(peace_state.get("manpower_train_tick_count", 0)) + 1
	peace_state["manpower_train_tick_count"] = ticks
	return {
		"ok": true,
		"live": true,
		"manager": "GameData.manpower_national",
		"tag": tag,
		"trained_stock": trained,
		"training_output": train_out,
		"fielded": fielded,
		"manpower_train_tick_count": ticks,
	}


func apply_peace_conference_settlement_live(
	winner_tag: String = "GER",
	loser_tag: String = "FRA",
	province_id: int = 1,
	annex: bool = true,
	puppet: bool = false,
	reparations: float = 0.35,
	occupation_zone: bool = true,
) -> Dictionary:
	var w := winner_tag.strip_edges().to_upper()
	var l := loser_tag.strip_edges().to_upper()
	if w.is_empty():
		w = "GER"
	if l.is_empty():
		l = "FRA"
	var items: Array = []
	if annex:
		items.append({"type": "annex", "province_id": province_id})
		# Live owner flip when map province is available
		if typeof(MapManager) != TYPE_NIL and MapManager.has_method("get_province"):
			var prov = MapManager.get_province(province_id)
			if prov != null and "owner_tag" in prov:
				prov.owner_tag = w
				if "controller_tag" in prov:
					prov.controller_tag = w
	if puppet:
		items.append({"type": "puppet", "tag": l})
	if reparations > 0.05:
		items.append({"type": "reparations", "amount": clampf(reparations, 0.0, 1.0)})
	if occupation_zone:
		items.append({"type": "occupation_zone", "province_id": province_id})
		# Seed occupation state on the province for live conquest loop
		apply_occupation_policy_live(province_id, "moderate")
	# Hierarchy membership: annex creates/assigns a winner occupation state (dynamic borders).
	var membership_res: Dictionary = {}
	if annex and has_method("create_state_membership_live"):
		var h0: Dictionary = get_hierarchy_for_province_live(province_id) if has_method("get_hierarchy_for_province_live") else {}
		var state_label := "%s Occupied Zone" % w
		membership_res = create_state_membership_live(
			[province_id],
			state_label,
			int(h0.get("region_id", 0)),
			int(h0.get("super_region_id", 0)),
			w
		)
		items.append({
			"type": "membership_create_state",
			"province_id": province_id,
			"state_id": int(membership_res.get("state_id", 0)),
			"ok": bool(membership_res.get("ok", false)),
		})
	var settlement := {
		"winner_tag": w,
		"loser_tag": l,
		"province_id": province_id,
		"items": items,
		"applied": true,
		"live": true,
		"manager": "GameData.peace_settlement",
		"ok": true,
		"membership": membership_res,
		"membership_live": bool(membership_res.get("ok", false)),
	}
	if not peace_state.has("peace_settlements") or not (peace_state["peace_settlements"] is Array):
		peace_state["peace_settlements"] = []
	var trail: Array = peace_state["peace_settlements"]
	trail.append(settlement.duplicate(true))
	if trail.size() > 32:
		trail = trail.slice(trail.size() - 32, trail.size())
	peace_state["peace_settlements"] = trail
	peace_state["peace_last_settlement"] = settlement.duplicate(true)
	var n := int(peace_state.get("peace_settlement_count", 0)) + 1
	peace_state["peace_settlement_count"] = n
	settlement["peace_settlement_count"] = n
	# Prestige/mandate light touch via existing pillar API when present
	if has_method("apply_pillar_shift"):
		apply_pillar_shift(w, "ascendancy", 2, "peace_settlement")
		apply_pillar_shift(l, "mandate", -2, "peace_settlement")
	return settlement


