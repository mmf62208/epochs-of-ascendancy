	if npc == null:
		return {"ok": false, "live": true, "error": "no_npc", "live_api": "apply_trade_power_intel_power_live"}
	var small: Dictionary = npc.compute_power_index({
		"factories": 5, "steel": 100.0, "fuel": 40.0, "tech_flags": [],
	}) as Dictionary
	var nuke: Dictionary = npc.compute_power_index({
		"factories": 45, "steel": 2500.0, "fuel": 1800.0, "electronics": 400.0,
		"equipment_units": 600, "tech_flags": ["nuclear_fuel", "nuclear_warhead"],
		"fissiles_stock": 50.0,
	}) as Dictionary
	var mu: Dictionary = npc.matchup(small, nuke) as Dictionary
	var placate: float = float(npc.ai_placate_accept_floor_delta(mu))
	var disc: Dictionary = npc.relationship_discount_mults("ally_ready", true, 6.0) as Dictionary
	var disc_n: Dictionary = npc.relationship_discount_mults("neutral", false, 0.0) as Dictionary
	var power_ok: bool = bool(mu.get("hopeless", false)) and bool(mu.get("nuclear_asymmetry", false)) and placate < -0.1
	var disc_ok: bool = float(disc.get("trade_suu_mult", 1.0)) < float(disc_n.get("trade_suu_mult", 1.0))
	var cmp: Dictionary = {}
	if typeof(TradeManager) != TYPE_NIL and TradeManager.has_method("get_national_power_comparison"):
		if typeof(ProductionManager) != TYPE_NIL:
			ProductionManager.set_stockpile({"steel": 100.0, "fuel": 50.0, "fissiles": 0.0})
		cmp = TradeManager.get_national_power_comparison("BEL", "USA")
	var ok: bool = power_ok and disc_ok
	return {
		"ok": ok, "live": true, "power_ok": power_ok, "disc_ok": disc_ok,
		"small": small, "nuke": nuke, "matchup": mu, "placate_delta": placate,
		"discounts_ally": disc, "live_comparison": cmp,
		"province_id": province_id, "live_api": "apply_trade_power_intel_power_live",
		"scenario": "power_nuclear_placate",
	}


func apply_trade_power_intel_transit_live(province_id: int = 1) -> Dictionary:
	if typeof(TradeManager) == TYPE_NIL:
		return {"ok": false, "live": true, "error": "no_tm", "live_api": "apply_trade_power_intel_transit_live"}
	var plain: String = ""
	var health: Dictionary = {}
	var flow_id: String = ""
	# Seed a demo flow (no accept/map signal path) then interdict with province attribution
	if TradeManager.has_method("seed_demo_trade_flow"):
		flow_id = str(TradeManager.seed_demo_trade_flow("USA", "ENG", "steel", 20.0))
	if not flow_id.is_empty() and TradeManager.has_method("interdict_trade_flow"):
		TradeManager.interdict_trade_flow(flow_id, "submarine", 0.5, {
			"province_id": maxi(province_id, 42),
			"attacker_tag": "GER",
			"silent": true,
		})
	# Also demo air attack on a second flow
	var flow_id2: String = ""
	if TradeManager.has_method("seed_demo_trade_flow"):
		flow_id2 = str(TradeManager.seed_demo_trade_flow("USA", "ENG", "fuel", 12.0))
	if not flow_id2.is_empty():
		TradeManager.interdict_trade_flow(flow_id2, "air_attack", 0.3, {
			"province_id": maxi(province_id, 99),
			"attacker_tag": "GER",
			"silent": true,
		})
	health = TradeManager.get_bilateral_transit_health("USA", "ENG")
	plain = str(TradeManager.format_transit_issue_plain("USA", "ENG")) if TradeManager.has_method("format_transit_issue_plain") else ""
	var issues_n: int = int(health.get("issue_n", 0))
	var pct: int = int(health.get("overall_delivery_pct", 100))
	var ok: bool = issues_n >= 1 and pct < 100 and (
		plain.contains("Submarine") or plain.contains("submarine") or plain.contains("sank")
		or plain.contains("%") or plain.contains("through") or plain.contains("Aircraft")
	)
	return {
		"ok": ok, "live": true, "transit_ok": ok,
		"health": health, "plain": plain, "flow_id": flow_id, "flow_id2": flow_id2,
		"issues_n": issues_n, "overall_delivery_pct": pct,
		"province_id": province_id, "live_api": "apply_trade_power_intel_transit_live",
		"scenario": "transit_loss_attribution",
	}


