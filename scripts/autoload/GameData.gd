	if typeof(SpaceLayerManager) == TYPE_NIL:
		return {"ok": false, "live": true, "error": "no_slm", "live_api": "apply_space_rival_survey_compete_live"}
	var tags_with := 0
	for tag in ["USA", "SOV", "GER"]:
		if SpaceLayerManager.get_surveys_for_tag(tag).size() > 0 or SpaceLayerManager.get_discoveries_for_tag(tag).size() > 0:
			tags_with += 1
	## Light compete proof: second rival tick should not explode; avoid full monthly stack in dual chain.
	var tick2: Dictionary = SpaceLayerManager.process_monthly_rival_surveys(1990, 4, {
		"rivals": ["ENG", "JAP"], "targets": ["europa", "titan"], "max_new_per_month": 2, "months": 3,
	})
	var ok: bool = tags_with >= 2 and bool(tick2.get("ok", false))
	return {"ok": ok, "live": true, "compete_ok": ok, "tags_with_activity": tags_with, "tick2": tick2, "province_id": province_id, "live_api": "apply_space_rival_survey_compete_live"}


