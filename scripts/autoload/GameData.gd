	# Full strategic AI daily apply path must yield logistics for non-player tags
	var res: Dictionary = {}
	if has_method("apply_strategic_ai_daily_apply"):
		res = apply_strategic_ai_daily_apply(province_id)
	elif typeof(MapManager) != TYPE_NIL and MapManager.has_method("apply_strategic_ai_daily_campaign_product"):
		res = MapManager.apply_strategic_ai_daily_campaign_product(province_id)
	elif typeof(MapManager) != TYPE_NIL and MapManager.has_method("apply_strategic_ai_daily_step_for_province"):
		res = MapManager.apply_strategic_ai_daily_step_for_province(province_id, "apply_ai")
	var logistics: Dictionary = res.get("logistics", {}) if res.get("logistics") is Dictionary else {}
	if logistics.is_empty() and res.get("step_result") is Dictionary:
		logistics = (res["step_result"] as Dictionary).get("logistics", {}) if (res["step_result"] as Dictionary).get("logistics") is Dictionary else {}
	var apply_ok: bool = bool(res.get("logistics_ok", false)) or bool(logistics.get("logistics_ok", false))
	if not apply_ok and typeof(MapManager) != TYPE_NIL and MapManager.has_method("apply_ai_logistics_doctrine_day"):
		logistics = MapManager.apply_ai_logistics_doctrine_day("GER", {}, province_id)
		apply_ok = bool(logistics.get("logistics_ok", false))
	var outcomes: Array = logistics.get("outcomes", []) if logistics.get("outcomes") is Array else []
	# Non-player tags present
	var non_player := 0
	for o in outcomes:
		if o is Dictionary and str((o as Dictionary).get("tag", "")) != "GER":
			non_player += 1
	apply_ok = apply_ok and (non_player >= 1 or int(logistics.get("ok_n", 0)) >= 1)
	return {
		"ok": apply_ok, "live": true, "apply_ok": apply_ok, "logistics_ok": apply_ok,
		"logistics": logistics, "res_keys": res.keys(),
		"province_id": province_id, "live_api": "apply_ai_logistics_day_apply_live",
		"model": "reinforce_experience_logistics_ledger",
	}


func apply_ai_logistics_day_seed_live(province_id: int = 1) -> Dictionary:
	if typeof(MapManager) == TYPE_NIL or not MapManager.has_method("apply_ai_logistics_doctrine_day"):
		return {"ok": false, "live": true, "error": "no_mm", "live_api": "apply_ai_logistics_day_seed_live"}
	if typeof(ProductionManager) != TYPE_NIL and ProductionManager.has_method("reset_equipment_flows"):
		ProductionManager.reset_equipment_flows()
	var logistics: Dictionary = MapManager.apply_ai_logistics_doctrine_day(
		"GER", {"budget": {"selected": [{"tag": "USA", "urgency": 0.8}, {"tag": "SOV", "urgency": 0.6}]}},
		province_id, {"seed_flows": true, "year": 1942},
	)
	var seed_ok: bool = bool(logistics.get("logistics_ok", false)) and int(logistics.get("seeded_n", 0)) >= 1
	var board_n := 0
	if typeof(ProductionManager) != TYPE_NIL:
		board_n = int(ProductionManager.get_equipment_flow_board("").get("active_n", 0))
	seed_ok = seed_ok and board_n >= 1
	return {
		"ok": seed_ok, "live": true, "seed_ok": seed_ok, "logistics": logistics, "board_n": board_n,
		"province_id": province_id, "live_api": "apply_ai_logistics_day_seed_live",
		"model": "reinforce_experience_logistics_ledger",
	}


func apply_ai_logistics_day_close_live(province_id: int = 1) -> Dictionary:
	var st: Dictionary = peace_state.get("ai_logistics_day_primary", {}) if peace_state.get("ai_logistics_day_primary") is Dictionary else {}
	var applied: Array = st.get("applied", []) if st.get("applied") is Array else []
	var md: Dictionary = st.get("majors_done", {}) if st.get("majors_done") is Dictionary else {}
	var majors_n := 0
	for k in md.keys():
		if int(md[k]) > 0:
			majors_n += 1
	return {"ok": applied.size() >= 4 or majors_n >= 4, "live": true, "applied_n": applied.size(), "province_id": province_id, "live_api": "apply_ai_logistics_day_close_live"}


func apply_ai_logistics_day_primary_step_live(step: String = "ald_catalog", province_id: int = 1) -> Dictionary:
	if not peace_state.has("ai_logistics_day_primary") or not (peace_state["ai_logistics_day_primary"] is Dictionary):
		peace_state["ai_logistics_day_primary"] = {"applied": [], "majors_done": {}, "tick": 0}
	var st: Dictionary = (peace_state["ai_logistics_day_primary"] as Dictionary).duplicate(true)
	var s := step.strip_edges().to_lower()
	if not AI_LOGISTICS_DAY_PRIMARY_STEPS.has(s):
		s = AI_LOGISTICS_DAY_PRIMARY_STEPS[0]
	var live_api := ""
	var live_result: Dictionary = {}
	var major := ""
	if s == "ald_catalog":
		major = "ald_primary_catalog"; live_api = "apply_ai_logistics_day_catalog_live"; live_result = apply_ai_logistics_day_catalog_live(province_id)
	elif s == "ald_doctrine":
		major = "ald_primary_doctrine"; live_api = "apply_ai_logistics_day_doctrine_live"; live_result = apply_ai_logistics_day_doctrine_live(province_id)
	elif s == "ald_apply":
		major = "ald_primary_apply"; live_api = "apply_ai_logistics_day_apply_live"; live_result = apply_ai_logistics_day_apply_live(province_id)
	elif s == "ald_seed":
		major = "ald_primary_seed"; live_api = "apply_ai_logistics_day_seed_live"; live_result = apply_ai_logistics_day_seed_live(province_id)
	elif s == "ald_close":
		major = "ald_primary_close"; live_api = "apply_ai_logistics_day_close_live"; live_result = apply_ai_logistics_day_close_live(province_id)
	var step_ok := bool(live_result.get("ok", false))
	var major_credit := major if step_ok else ""
	var domain_script = load("res://scripts/core/AiLogisticsDayDomain.gd")
	if domain_script != null and domain_script.has_method("apply_primary_step"):
		peace_state["ai_logistics_day_primary"] = st.duplicate(true)
		domain_script.apply_primary_step(peace_state, s, live_api, major_credit, live_result)
	else:
		var applied_fb: Array = (st.get("applied", []) as Array).duplicate() if st.get("applied") is Array else []
		if not applied_fb.has(s):
			applied_fb.append(s)
		st["applied"] = applied_fb
		var md_fb: Dictionary = (st.get("majors_done", {}) as Dictionary).duplicate(true)
		if not major_credit.is_empty():
			md_fb[major_credit] = int(md_fb.get(major_credit, 0)) + 1
		st["majors_done"] = md_fb
		peace_state["ai_logistics_day_primary"] = st.duplicate(true)
	return {"ok": step_ok, "live": true, "step": s, "major": major_credit, "live_api": live_api, "live_result": live_result, "step_ok": step_ok, "province_id": province_id}


func apply_ai_logistics_day_primary_live(province_id: int = 1) -> Dictionary:
	var results: Array = []
	for step in AI_LOGISTICS_DAY_PRIMARY_STEPS:
		results.append(apply_ai_logistics_day_primary_step_live(step, province_id))
	var majors_ok := 0
	var domain_script2 = load("res://scripts/core/AiLogisticsDayDomain.gd")
	if domain_script2 != null and domain_script2.has_method("majors_ok_count"):
		majors_ok = int(domain_script2.majors_ok_count(peace_state))
	var dead_n := 0
	var failed_n := 0
	var doctrine_ok := false
	var apply_ok := false
	var seed_ok := false
	for r in results:
		if str((r as Dictionary).get("live_api", "")).is_empty():
			dead_n += 1
		if not bool((r as Dictionary).get("step_ok", false)):
			failed_n += 1
		var lr: Dictionary = (r as Dictionary).get("live_result", {}) if (r as Dictionary).get("live_result") is Dictionary else {}
		if str((r as Dictionary).get("step", "")) == "ald_doctrine":
			doctrine_ok = bool(lr.get("doctrine_ok", lr.get("ok", false)))
		if str((r as Dictionary).get("step", "")) == "ald_apply":
			apply_ok = bool(lr.get("apply_ok", lr.get("logistics_ok", lr.get("ok", false))))
		if str((r as Dictionary).get("step", "")) == "ald_seed":
			seed_ok = bool(lr.get("seed_ok", lr.get("ok", false)))
	var ok := majors_ok >= 5 and dead_n == 0 and failed_n == 0 and doctrine_ok and apply_ok and seed_ok
	return {
		"ok": ok, "live": true, "majors_ok": majors_ok, "dead_n": dead_n, "failed_n": failed_n,
		"doctrine_ok": doctrine_ok, "apply_ok": apply_ok, "seed_ok": seed_ok, "logistics_ok": apply_ok,
		"model": "reinforce_experience_logistics_ledger",
		"province_id": province_id, "closed": AI_LOGISTICS_DAY_PRIMARY_STEPS,
	}
