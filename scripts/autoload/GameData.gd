	"atp_catalog", "atp_peace", "atp_war", "atp_crisis", "atp_close",
]


func apply_ai_training_policy_catalog_live(province_id: int = 1) -> Dictionary:
	var ok: bool = typeof(ProductionManager) != TYPE_NIL and ProductionManager.has_method("ai_select_training_policy") \
		and ProductionManager.has_method("apply_training_policy_decision")
	return {"ok": ok, "live": true, "province_id": province_id, "live_api": "apply_ai_training_policy_catalog_live", "model": "reinforce_experience_logistics_ledger"}


func apply_ai_training_policy_peace_live(province_id: int = 1) -> Dictionary:
	if typeof(ProductionManager) == TYPE_NIL:
		return {"ok": false, "live": true, "error": "no_pm", "live_api": "apply_ai_training_policy_peace_live"}
	var elite: Dictionary = ProductionManager.ai_select_training_policy("USA", {"at_war": false, "manpower_strain": 0.1, "elite_focus": true, "year": 1936})
	var cold: Dictionary = ProductionManager.ai_select_training_policy("GER", {"at_war": false, "manpower_strain": 0.2, "elite_focus": false, "year": 1960})
	var peace_ok: bool = str(elite.get("ai_pick", "")) == "volunteer_cadre" and str(cold.get("ai_pick", "")) == "national_service"
	return {"ok": peace_ok, "live": true, "peace_ok": peace_ok, "elite": elite, "cold": cold, "province_id": province_id, "live_api": "apply_ai_training_policy_peace_live", "model": "reinforce_experience_logistics_ledger"}


func apply_ai_training_policy_war_live(province_id: int = 1) -> Dictionary:
	if typeof(ProductionManager) == TYPE_NIL:
		return {"ok": false, "live": true, "error": "no_pm", "live_api": "apply_ai_training_policy_war_live"}
	var crash: Dictionary = ProductionManager.ai_select_training_policy("SOV", {"at_war": true, "manpower_strain": 0.9, "year": 1942})
	var mid: Dictionary = ProductionManager.ai_select_training_policy("USA", {"at_war": true, "manpower_strain": 0.5, "year": 1943})
	var war_ok: bool = str(crash.get("ai_pick", "")) == "wartime_crash" \
		and str(mid.get("ai_pick", "")) in ["short_conscript", "selective_service"]
	return {"ok": war_ok, "live": true, "war_ok": war_ok, "crash": crash, "mid": mid, "province_id": province_id, "live_api": "apply_ai_training_policy_war_live", "model": "reinforce_experience_logistics_ledger"}


func apply_ai_training_policy_crisis_live(province_id: int = 1) -> Dictionary:
	if typeof(ProductionManager) == TYPE_NIL:
		return {"ok": false, "live": true, "error": "no_pm", "live_api": "apply_ai_training_policy_crisis_live"}
	var clone: Dictionary = ProductionManager.ai_select_training_policy("USA", {
		"at_war": true, "manpower_strain": 0.9, "industry_stress": 0.8, "year": 2050,
	})
	var avf: Dictionary = ProductionManager.ai_select_training_policy("USA", {
		"at_war": false, "manpower_strain": 0.1, "year": 2010,
	})
	var crisis_ok: bool = str(clone.get("ai_pick", "")) == "clone_batch_fill" \
		and str(avf.get("ai_pick", "")) == "all_volunteer_force"
	return {"ok": crisis_ok, "live": true, "ai_policy_ok": crisis_ok, "crisis_ok": crisis_ok, "clone": clone, "avf": avf, "province_id": province_id, "live_api": "apply_ai_training_policy_crisis_live", "model": "reinforce_experience_logistics_ledger"}


func apply_ai_training_policy_close_live(province_id: int = 1) -> Dictionary:
	var st: Dictionary = peace_state.get("ai_training_policy_primary", {}) if peace_state.get("ai_training_policy_primary") is Dictionary else {}
	var applied: Array = st.get("applied", []) if st.get("applied") is Array else []
	return {"ok": applied.size() >= 4, "live": true, "applied_n": applied.size(), "province_id": province_id, "live_api": "apply_ai_training_policy_close_live"}


func apply_ai_training_policy_primary_step_live(step: String = "atp_catalog", province_id: int = 1) -> Dictionary:
	if not peace_state.has("ai_training_policy_primary") or not (peace_state["ai_training_policy_primary"] is Dictionary):
		peace_state["ai_training_policy_primary"] = {"applied": [], "majors_done": {}, "tick": 0}
	var st: Dictionary = (peace_state["ai_training_policy_primary"] as Dictionary).duplicate(true)
	var s := step.strip_edges().to_lower()
	if not AI_TRAINING_POLICY_PRIMARY_STEPS.has(s):
		s = AI_TRAINING_POLICY_PRIMARY_STEPS[0]
	var live_api := ""
	var live_result: Dictionary = {}
	var major := ""
	if s == "atp_catalog":
		major = "atp_primary_catalog"; live_api = "apply_ai_training_policy_catalog_live"; live_result = apply_ai_training_policy_catalog_live(province_id)
	elif s == "atp_peace":
		major = "atp_primary_peace"; live_api = "apply_ai_training_policy_peace_live"; live_result = apply_ai_training_policy_peace_live(province_id)
	elif s == "atp_war":
		major = "atp_primary_war"; live_api = "apply_ai_training_policy_war_live"; live_result = apply_ai_training_policy_war_live(province_id)
	elif s == "atp_crisis":
		major = "atp_primary_crisis"; live_api = "apply_ai_training_policy_crisis_live"; live_result = apply_ai_training_policy_crisis_live(province_id)
	elif s == "atp_close":
		major = "atp_primary_close"; live_api = "apply_ai_training_policy_close_live"; live_result = apply_ai_training_policy_close_live(province_id)
	var step_ok := bool(live_result.get("ok", false))
	var major_credit := major if step_ok else ""
	var domain_script = load("res://scripts/core/AiTrainingPolicyDomain.gd")
	if domain_script != null and domain_script.has_method("apply_primary_step"):
		peace_state["ai_training_policy_primary"] = st.duplicate(true)
		domain_script.apply_primary_step(peace_state, s, live_api, major_credit, live_result)
	else:
		var applied_fb: Array = (st.get("applied", []) as Array).duplicate() if st.get("applied") is Array else []
		if not applied_fb.has(s):
			applied_fb.append(s)
		st["applied"] = applied_fb
		var md_fb: Dictionary = (st.get("majors_done", {}) as Dictionary).duplicate(true)
		if not major_credit.is_empty():
			md_fb[major_credit] = int(md_fb.get(major_credit, 0)) + 1
		st["majors_done"] = md_fb
		peace_state["ai_training_policy_primary"] = st.duplicate(true)
	return {"ok": step_ok, "live": true, "step": s, "major": major_credit, "live_api": live_api, "live_result": live_result, "step_ok": step_ok, "province_id": province_id}


func apply_ai_training_policy_primary_live(province_id: int = 1) -> Dictionary:
	var results: Array = []
	for step in AI_TRAINING_POLICY_PRIMARY_STEPS:
		results.append(apply_ai_training_policy_primary_step_live(step, province_id))
	var majors_ok := 0
	var domain_script2 = load("res://scripts/core/AiTrainingPolicyDomain.gd")
	if domain_script2 != null and domain_script2.has_method("majors_ok_count"):
		majors_ok = int(domain_script2.majors_ok_count(peace_state))
	var dead_n := 0
	var failed_n := 0
	var peace_ok := false
	var war_ok := false
	var ai_policy_ok := false
	for r in results:
		if str((r as Dictionary).get("live_api", "")).is_empty():
			dead_n += 1
		if not bool((r as Dictionary).get("step_ok", false)):
			failed_n += 1
		var lr: Dictionary = (r as Dictionary).get("live_result", {}) if (r as Dictionary).get("live_result") is Dictionary else {}
		if str((r as Dictionary).get("step", "")) == "atp_peace":
			peace_ok = bool(lr.get("peace_ok", lr.get("ok", false)))
		if str((r as Dictionary).get("step", "")) == "atp_war":
			war_ok = bool(lr.get("war_ok", lr.get("ok", false)))
		if str((r as Dictionary).get("step", "")) == "atp_crisis":
			ai_policy_ok = bool(lr.get("ai_policy_ok", lr.get("crisis_ok", lr.get("ok", false))))
	var ok := majors_ok >= 5 and dead_n == 0 and failed_n == 0 and peace_ok and war_ok and ai_policy_ok
	return {
		"ok": ok, "live": true, "majors_ok": majors_ok, "dead_n": dead_n, "failed_n": failed_n,
		"peace_ok": peace_ok, "war_ok": war_ok, "ai_policy_ok": ai_policy_ok,
		"model": "reinforce_experience_logistics_ledger",
		"province_id": province_id, "closed": AI_TRAINING_POLICY_PRIMARY_STEPS,
	}


## CP3 map paint — EquipmentFlow glyphs on StrategicFlowOverlayLayer.
const EQUIPMENT_FLOW_PAINT_PRIMARY_STEPS: PackedStringArray = [
	"efp_catalog", "efp_symbols", "efp_board", "efp_paint", "efp_close",
]


func apply_equipment_flow_paint_catalog_live(province_id: int = 1) -> Dictionary:
	var src := ""
	if FileAccess.file_exists("res://scripts/map/StrategicFlowOverlayLayer.gd"):
		src = FileAccess.get_file_as_string("res://scripts/map/StrategicFlowOverlayLayer.gd")
	var ok: bool = ("show_equipment_flows" in src) \
		and ("func _draw_equipment_flow_glyphs" in src) \
		and ("func _draw_equipment_symbol" in src) \
		and ("func collect_equipment_paint_preview" in src) \
		and typeof(ProductionManager) != TYPE_NIL \
		and ProductionManager.has_method("get_equipment_flow_board")
	return {"ok": ok, "live": true, "province_id": province_id, "live_api": "apply_equipment_flow_paint_catalog_live", "model": "equipment_flow_compact_ledger"}


func apply_equipment_flow_paint_symbols_live(province_id: int = 1) -> Dictionary:
	var calc = load("res://scripts/production/EquipmentFlowCalculator.gd")
	if calc == null:
		return {"ok": false, "live": true, "error": "no_calc", "live_api": "apply_equipment_flow_paint_symbols_live"}
	var expect := {
		"rail": "train", "road": "truck", "airlift": "transport_plane",
		"sealift": "merchant", "drone_logistics": "drone_convoy", "orbital": "orbital_loft",
	}
	var modes_ok := true
	var mapped: Dictionary = {}
	for mode in expect.keys():
		var sym := str(calc.symbol_for_mode(str(mode)))
		mapped[mode] = sym
		if sym != str(expect[mode]):
			modes_ok = false
	# Layer must draw those symbol keys
	var src := FileAccess.get_file_as_string("res://scripts/map/StrategicFlowOverlayLayer.gd") if FileAccess.file_exists("res://scripts/map/StrategicFlowOverlayLayer.gd") else ""
	modes_ok = modes_ok and ("\"train\"" in src or "train:" in src) and ("drone_convoy" in src) and ("orbital_loft" in src)
	return {"ok": modes_ok, "live": true, "symbols_ok": modes_ok, "mapped": mapped, "province_id": province_id, "live_api": "apply_equipment_flow_paint_symbols_live", "model": "equipment_flow_compact_ledger"}


func apply_equipment_flow_paint_board_live(province_id: int = 1) -> Dictionary:
	if typeof(ProductionManager) == TYPE_NIL:
		return {"ok": false, "live": true, "error": "no_pm", "live_api": "apply_equipment_flow_paint_board_live"}
	if ProductionManager.has_method("reset_equipment_flows"):
		ProductionManager.reset_equipment_flows()
	ProductionManager.add_to_country_equipment_stockpile("USA", "medium_tank_mk4", 6)
	ProductionManager.add_to_country_equipment_stockpile("USA", "fighter_p40", 4)
	var c1: Dictionary = ProductionManager.create_equipment_flow(
		"USA", "medium_tank_mk4", 2, province_id, province_id + 1, "usa_paint_army", "rail",
		{"hops": 2, "distance_km": 300.0, "year": 1939},
	)
	var c2: Dictionary = ProductionManager.create_equipment_flow(
		"USA", "fighter_p40", 2, province_id, province_id + 2, "usa_paint_wing", "airlift",
		{"hops": 1, "distance_km": 500.0, "year": 1944},
	)
	var board: Dictionary = ProductionManager.get_equipment_flow_board("USA")
	var glyphs: Array = board.get("glyphs", []) if board.get("glyphs") is Array else []
	var board_ok: bool = bool(c1.get("ok", false)) and bool(c2.get("ok", false)) \
		and int(board.get("active_n", 0)) >= 2 and glyphs.size() >= 2
	return {"ok": board_ok, "live": true, "board_ok": board_ok, "active_n": int(board.get("active_n", 0)), "glyphs_n": glyphs.size(), "province_id": province_id, "live_api": "apply_equipment_flow_paint_board_live", "model": "equipment_flow_compact_ledger"}


func apply_equipment_flow_paint_paint_live(province_id: int = 1) -> Dictionary:
	# Ensure flows exist for paint preview
	var board0: Dictionary = ProductionManager.get_equipment_flow_board("USA") if typeof(ProductionManager) != TYPE_NIL else {}
	if int(board0.get("active_n", 0)) < 1 and typeof(ProductionManager) != TYPE_NIL:
		ProductionManager.add_to_country_equipment_stockpile("USA", "light_tank_m3", 4)
		ProductionManager.create_equipment_flow(
			"USA", "light_tank_m3", 2, province_id, province_id + 1, "usa_paint_demo", "road",
			{"hops": 1, "distance_km": 200.0, "year": 1940},
		)
	var preview: Dictionary = {}
	var layer_scr = load("res://scripts/map/StrategicFlowOverlayLayer.gd")
	if layer_scr != null and layer_scr.has_method("collect_equipment_paint_preview"):
		preview = layer_scr.collect_equipment_paint_preview({})
	else:
		# Fallback: manual preview from board
		var board: Dictionary = ProductionManager.get_equipment_flow_board("USA") if typeof(ProductionManager) != TYPE_NIL else {}
		var glyphs: Array = board.get("glyphs", []) if board.get("glyphs") is Array else []
		preview = {
			"ok": true, "paint_ok": glyphs.size() > 0, "glyph_n": glyphs.size(),
			"symbols": board.get("symbols", {}), "glyphs": glyphs, "layer": "StrategicFlowOverlayLayer",
		}
	# Instantiate layer and call draw stats path without viewport if possible
	var layer_ok := false
	if layer_scr != null and layer_scr.can_instantiate():
		var layer = layer_scr.new()
		if layer != null:
			if "show_equipment_flows" in layer:
				layer.show_equipment_flows = true
			if layer.has_method("get_draw_stats"):
				var st: Dictionary = layer.get_draw_stats()
				layer_ok = bool(st.get("equipment_flows", false)) or ("equipment_glyph_n" in st)
			if layer is Node:
				layer.free()
	var paint_ok: bool = bool(preview.get("paint_ok", false)) and int(preview.get("glyph_n", 0)) >= 1
	# layer_ok is soft — headless may not draw; preview glyphs are the dual truth
	return {
		"ok": paint_ok, "live": true, "paint_ok": paint_ok, "preview": preview, "layer_ok": layer_ok,
		"province_id": province_id, "live_api": "apply_equipment_flow_paint_paint_live",
		"model": "equipment_flow_compact_ledger",
	}


