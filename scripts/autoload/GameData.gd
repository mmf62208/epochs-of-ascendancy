	## Save-friendly AAR trail in peace_state (C4).
	if not peace_state.has("battle_aar") or not (peace_state["battle_aar"] is Dictionary):
		peace_state["battle_aar"] = {"entries": [], "tick_count": 0}
	var st: Dictionary = (peace_state["battle_aar"] as Dictionary).duplicate(true)
	var entries: Array = (st.get("entries", []) as Array).duplicate() if st.get("entries") is Array else []
	var entry := {
		"province_id": province_id,
		"result": "recorded",
		"key_factors": ["multi_phase", "ops_close", "engage"],
		"date": "campaign",
	}
	# Prefer live multi-phase product for factor richness when available.
	if has_method("apply_multi_phase_combat_product"):
		var mp: Dictionary = apply_multi_phase_combat_product(province_id)
		entry["score"] = float(mp.get("score", 0.55))
		entry["summary"] = str(mp.get("summary", mp.get("plain", "AAR multi-phase")))
	entries.append(entry)
	if entries.size() > 32:
		entries = entries.slice(entries.size() - 32)
	st["entries"] = entries
	st["tick_count"] = int(st.get("tick_count", 0)) + 1
	peace_state["battle_aar"] = st.duplicate(true)
	var ticks := int(peace_state.get("battle_aar_ticks", 0)) + 1
	peace_state["battle_aar_ticks"] = ticks
	return {
		"ok": true, "live": true, "entry_n": entries.size(), "province_id": province_id,
		"battle_aar_ticks": ticks, "manager": "GameData.battle_aar",
	}


func apply_battle_aar_close_live(province_id: int = 1) -> Dictionary:
	var persist: Dictionary = apply_battle_aar_persist_live(province_id)
	if has_method("apply_combat_ops_close_live"):
		apply_combat_ops_close_live(province_id)
	var entry_n := int(persist.get("entry_n", 0))
	return {
