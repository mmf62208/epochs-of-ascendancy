	var rel_full := float(rhc.combat_reliability_from_production(1.0))
	var rel_short := float(rhc.combat_reliability_from_production(0.55))
	var combat_ok := rel_short < rel_full - 0.01 and rel_short + 0.001 >= 0.72
	# Stamp production reliability and prove combat stats path when PM available
	var pm_ok := true
	var jet_burn := float(rhc.fuel_ops_burn_rate("jet"))
	var truck_burn := float(rhc.fuel_ops_burn_rate("truck"))
	var rocket_burn := float(rhc.fuel_ops_burn_rate("rocket"))
	var fuel_ok := jet_burn > truck_burn + 0.1 and rocket_burn > jet_burn
	if typeof(ProductionManager) != TYPE_NIL:
		if ProductionManager.has_method("_record_equipment_production_reliability"):
			ProductionManager._record_equipment_production_reliability("depth_test_tank", 0.55, 2)
			var stamped := float(ProductionManager.get_equipment_production_reliability("depth_test_tank"))
			pm_ok = stamped < 0.999 and stamped + 0.001 >= 0.5
		if ProductionManager.has_method("burn_ops_fuel"):
			ProductionManager.set_stockpile({"fuel": 10.0})
			var burn: Dictionary = ProductionManager.burn_ops_fuel("jet", 2.0, 1.0)
			var jet_need := float(burn.get("needed", 0.0))
			var truck_need := float(rhc.compute_ops_fuel_cost("truck", 2.0, 1.0))
			fuel_ok = fuel_ok and jet_need > truck_need
			fuel_ok = fuel_ok and float(burn.get("mobility_multiplier", 1.0)) <= 1.001
	var ok := combat_ok and fuel_ok and pm_ok
	return {
		"ok": ok, "live": true, "combat_ok": combat_ok, "fuel_ok": fuel_ok, "pm_ok": pm_ok,
		"rel_full": rel_full, "rel_short": rel_short,
		"jet_burn": jet_burn, "truck_burn": truck_burn, "rocket_burn": rocket_burn,
		"province_id": province_id, "live_api": "apply_resource_economy_depth_combat_live",
		"scenario": "combat_reliability_fuel_ops",
	}


