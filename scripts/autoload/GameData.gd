	return "" if bool(d.get("empty", false)) else str(d.get("plain", d.get("summary", "")))

func apply_save_browser_resume(province_id: int = 1) -> Dictionary:
	var product: Dictionary = save_browser_campaign_product_live()
	var resume: Dictionary = product.get("resume", {})
	if bool(resume.get("empty", true)):
		return {"ok": false, "reason": "no occupied slot", "product": product}
	var aid := str(resume.get("action_id", ""))
	if aid.is_empty():
		return {"ok": false, "reason": "no resume action", "product": product}
	var result: Dictionary = apply_order_panel_action(aid, province_id)
	result["product"] = product
	result["resume"] = resume
	return result

func apply_save_browser_checkpoint(province_id: int = 1) -> Dictionary:
	var product: Dictionary = save_browser_campaign_product_live()
	var cp: Dictionary = product.get("checkpoint", {})
	var aid := str(cp.get("action_id", "save_slot:autosave"))
	var result: Dictionary = apply_order_panel_action(aid, province_id)
	result["product"] = product
	result["checkpoint"] = cp
	return result


func apply_stream_alpha_primary_packs_product(province_id: int = 1) -> Dictionary:
	## Pack C/E/F/G vertical close: combat phase + HH step + OOB 60d + save checkpoint (real APIs only).
	var combat: Dictionary = apply_combat_ops_close_live(province_id)
	var hh: Dictionary = apply_hh_agenda_close_live(province_id)
	var oob: Dictionary = {}
	if has_method("apply_oob_horizon_60d"):
		oob = apply_oob_horizon_60d(province_id)
	var save_cp: Dictionary = apply_save_browser_checkpoint(province_id)
	var product: Dictionary = MapPolishFormatters.stream_alpha_primary_packs_product(province_id)
	var dead_n := 0
	if not bool(combat.get("ok", false)):
		dead_n += 1
	if not bool(hh.get("ok", false)):
		dead_n += 1
	peace_state["stream_alpha_tick_count"] = int(peace_state.get("stream_alpha_tick_count", 0)) + 1
	return {
		"ok": dead_n == 0,
		"live": true,
		"dead_n": dead_n,
		"combat": combat,
		"hh": hh,
		"oob": oob,
		"save": save_cp,
		"product": product,
		"province_id": province_id,
		"summary": "Stream α packs apply · dead %d · combat %s · hh %s" % [
			dead_n, str(combat.get("applied_phase", "?")), str(hh.get("applied_step", hh.get("step", "?"))),
		],
		"empty": false,
	}


