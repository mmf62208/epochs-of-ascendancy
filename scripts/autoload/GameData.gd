		return {"ok": false, "live": true, "error": "no_pm", "live_api": "apply_reinforcement_logistics_time_live"}
	var d1916: Dictionary = ProductionManager.estimate_reinforce_transit_days(
		"rail", 3, 1200.0, 1916, {"depot_fill": 0.9, "corridor_control": 0.8, "fuel": 0.7, "supplies": 0.8},
	)
	var d2025: Dictionary = ProductionManager.estimate_reinforce_transit_days(
		"airlift", 2, 1200.0, 2025, {"depot_fill": 1.0, "corridor_control": 1.0, "fuel": 0.9, "supplies": 0.9},
	)
	var d2080: Dictionary = ProductionManager.estimate_reinforce_transit_days(
		"orbital", 1, 1200.0, 2080,
		{"depot_fill": 1.0, "corridor_control": 1.0, "fuel": 0.9, "supplies": 0.9, "electronics": 0.9},
	)
	var a := float(d1916.get("days", 0))
	var b := float(d2025.get("days", 0))
	var c := float(d2080.get("days", 0))
	var time_ok: bool = bool(d1916.get("ok", false)) and a > b and b > c and a >= 2.0
	# Non-instant default: create flow with distance must take > 0.5 day before deliver
	if ProductionManager.has_method("reset_equipment_flows"):
		ProductionManager.reset_equipment_flows()
	ProductionManager.add_to_country_equipment_stockpile("USA", "medium_tank_mk4", 4)
	var created: Dictionary = ProductionManager.create_equipment_flow(
