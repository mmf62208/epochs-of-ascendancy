		majors_ok = int(domain_script2.majors_ok_count(peace_state))
	var dead_n := 0
	var failed_n := 0
	var claim_ok := false
	var habitat_ok := false
	var flow_ok := false
	for r in results:
		var api := str((r as Dictionary).get("live_api", ""))
		if api.is_empty() or api == "apply_focus":
			dead_n += 1
		if not bool((r as Dictionary).get("step_ok", (r as Dictionary).get("ok", false))):
			failed_n += 1
		var lr: Dictionary = (r as Dictionary).get("live_result", {}) if (r as Dictionary).get("live_result") is Dictionary else {}
		if str((r as Dictionary).get("step", "")) == "spo_claim":
			claim_ok = bool(lr.get("claim_ok", lr.get("ok", false)))
		if str((r as Dictionary).get("step", "")) == "spo_habitat":
			habitat_ok = bool(lr.get("habitat_ok", lr.get("ok", false)))
		if str((r as Dictionary).get("step", "")) == "spo_flow":
			flow_ok = bool(lr.get("flow_ok", lr.get("ok", false)))
	var ok := majors_ok >= 5 and dead_n == 0 and failed_n == 0 and claim_ok and habitat_ok and flow_ok
	return {
		"ok": ok, "live": true, "majors_ok": majors_ok, "dead_n": dead_n, "failed_n": failed_n,
		"complete": ok, "claim_ok": claim_ok, "habitat_ok": habitat_ok, "flow_ok": flow_ok,
		"model": "orbital_compact_ledger",
		"space_ops_primary_ticks": int(peace_state.get("space_ops_primary_ticks", 0)),
		"g0_domain": "SpaceOpsDomain",
		"province_id": province_id, "closed": SPACE_OPS_PRIMARY_STEPS,
	}


## S3 space colony — parent CRS · range interact · independence · landing/bombard · save.
const SPACE_COLONY_PRIMARY_STEPS: PackedStringArray = [
	"sco_catalog", "sco_relations", "sco_independence", "sco_combat", "sco_close",
]


func apply_space_colony_catalog_live(province_id: int = 1) -> Dictionary:
	var has: bool = typeof(SpaceLayerManager) != TYPE_NIL
	var ok: bool = has \
		and SpaceLayerManager.has_method("build_colony_board") \
		and SpaceLayerManager.has_method("get_save_data") \
		and SpaceLayerManager.has_method("can_land_assault") \
		and SpaceLayerManager.has_method("can_bombard_body")
	return {
		"ok": ok, "live": true, "model": "orbital_compact_ledger",
		"province_id": province_id, "live_api": "apply_space_colony_catalog_live",
	}


func apply_space_colony_relations_live(province_id: int = 1) -> Dictionary:
	if typeof(SpaceLayerManager) == TYPE_NIL:
		return {"ok": false, "live": true, "error": "no_slm", "live_api": "apply_space_colony_relations_live"}
	SpaceLayerManager.reset_for_new_scenario()
	SpaceLayerManager.set_nation_capacity("USA", 20.0, 20.0)
	SpaceLayerManager.set_space_military("USA", {"max_reach_au": 2.0})
	SpaceLayerManager.set_space_military("GER", {"max_reach_au": 0.2})
	SpaceLayerManager.claim_site("luna_south_pole", "USA", 1980, {"require_lift": false})
	var hab: Dictionary = SpaceLayerManager.build_habitat("luna_south_pole", "USA", "settlement")
	var hid := str((hab.get("habitat", {}) as Dictionary).get("habitat_id", "")) if hab.get("habitat") is Dictionary else ""
	var board: Dictionary = SpaceLayerManager.build_colony_board(hid)
	var crs0: float = float(board.get("parent_crs", 0.0))
	var delta: Dictionary = SpaceLayerManager.apply_parent_vector_delta(hid, {"trust": 10.0, "public": 5.0})
	var crs1: float = float(delta.get("crs", 0.0))
	var crs_ok: bool = crs1 > crs0
	# Parent can always interact; GER with short reach cannot open third-party on Luna if distance > reach
	var parent_ix: Dictionary = SpaceLayerManager.can_interact_range("USA", hid)
	var ger_ix: Dictionary = SpaceLayerManager.can_interact_range("GER", hid)
	# Give GER deep reach to open relation
	SpaceLayerManager.set_space_military("SOV", {"max_reach_au": 5.0})
	var open: Dictionary = SpaceLayerManager.open_third_party_relation(hid, "SOV")
	var range_ok: bool = bool(parent_ix.get("can", false)) and bool(open.get("ok", false))
	# Out of range fail
	var fail: Dictionary = SpaceLayerManager.open_third_party_relation(hid, "GER")
	var fail_ok: bool = not bool(fail.get("ok", true))
	var rel_ok: bool = crs_ok and range_ok and fail_ok and bool(board.get("ok", false))
	return {
		"ok": rel_ok, "live": true, "rel_ok": rel_ok,
		"habitat_id": hid, "board": board, "crs0": crs0, "crs1": crs1,
		"parent_ix": parent_ix, "ger_ix": ger_ix, "open_sov": open, "fail_ger": fail,
		"province_id": province_id, "live_api": "apply_space_colony_relations_live",
		"scenario": "parent_crs_and_range",
	}


func apply_space_colony_independence_live(province_id: int = 1) -> Dictionary:
	if typeof(SpaceLayerManager) == TYPE_NIL:
		return {"ok": false, "live": true, "error": "no_slm", "live_api": "apply_space_colony_independence_live"}
	# Dedicated neglected habitat (do not rely on prior step supply)
	SpaceLayerManager.set_nation_capacity("USA", 40.0, 40.0)
	SpaceLayerManager.claim_site("mars_polar_n", "USA", 2040, {"require_lift": false, "force": true})
	var hb: Dictionary = SpaceLayerManager.build_habitat("mars_polar_n", "USA", "colony", {
		"supply_months": 1.0, "autonomy": 20.0, "allow_over_command": true,
	})
	var hid := str((hb.get("habitat", {}) as Dictionary).get("habitat_id", "")) if hb.get("habitat") is Dictionary else ""
	if hid.is_empty():
		# Fallback: reuse any USA habitat and starve via tick
		var habs: Array = SpaceLayerManager.get_habitats_for_tag("USA")
		if habs.size() > 0 and habs[0] is Dictionary:
			hid = str((habs[0] as Dictionary).get("habitat_id", ""))
	# Starved long tick → autonomy rise + years ≥ min breakaway
	var tick: Dictionary = SpaceLayerManager.force_independence_tick(hid, 300, {"mitigated": false})
	var ready: bool = bool(tick.get("breakaway_ready", false))
	# Mitigated colony should lag
	SpaceLayerManager.claim_site("mars_hellas", "USA", 2040, {"require_lift": false, "force": true})
	var hb2: Dictionary = SpaceLayerManager.build_habitat("mars_hellas", "USA", "colony", {
		"supply_months": 12.0, "autonomy": 20.0, "allow_over_command": true,
	})
	var hid2 := str((hb2.get("habitat", {}) as Dictionary).get("habitat_id", "")) if hb2.get("habitat") is Dictionary else ""
	var tick_m: Dictionary = SpaceLayerManager.force_independence_tick(hid2, 120, {"mitigated": true})
	var auto_m: float = float((tick_m.get("habitat", {}) as Dictionary).get("autonomy", 0.0)) if tick_m.get("habitat") is Dictionary else 0.0
	var auto_raw: float = float((tick.get("habitat", {}) as Dictionary).get("autonomy", 0.0)) if tick.get("habitat") is Dictionary else 0.0
	var indep_ok: bool = ready and auto_raw > auto_m
	# Save/load roundtrip
	var save_d: Dictionary = SpaceLayerManager.get_save_data()
	var hab_n0: int = int(save_d.get("habitats", {}).size()) if save_d.get("habitats") is Dictionary else 0
	SpaceLayerManager.reset_for_new_scenario()
	var empty_n: int = SpaceLayerManager.get_habitats_for_tag("USA").size()
	SpaceLayerManager.apply_save_data(save_d)
	var hab_n1: int = SpaceLayerManager.get_habitats_for_tag("USA").size()
	var save_ok: bool = hab_n0 > 0 and empty_n == 0 and hab_n1 == hab_n0
	var ok: bool = indep_ok and save_ok and not hid.is_empty()
	return {
		"ok": ok, "live": true, "indep_ok": indep_ok, "save_ok": save_ok,
		"tick": tick, "tick_mitigated": tick_m, "habitats_saved": hab_n0, "habitats_restored": hab_n1,
		"province_id": province_id, "live_api": "apply_space_colony_independence_live",
		"scenario": "independence_and_saveload",
	}


func apply_space_colony_combat_live(province_id: int = 1) -> Dictionary:
	if typeof(SpaceLayerManager) == TYPE_NIL:
		return {"ok": false, "live": true, "error": "no_slm", "live_api": "apply_space_colony_combat_live"}
	SpaceLayerManager.set_space_military("USA", {
		"landing_craft": 3,
		"bombardment_ships": 2,
		"orbital_weapons": 1,
		"orbital_defenses": 2,
		"fleet_strength": 40.0,
		"max_reach_au": 6.0,
	})
	SpaceLayerManager.set_space_military("BEL", {
		"landing_craft": 0,
		"bombardment_ships": 0,
		"orbital_defenses": 0,
		"max_reach_au": 0.2,
	})
	var land: Dictionary = SpaceLayerManager.can_land_assault("USA", "mars_polar_n")
	# Ensure site exists in catalog
	if land.get("error", "") == "unknown_site":
		# catalog sites always exist after _ensure
		land = SpaceLayerManager.can_land_assault("USA", "luna_south_pole")
	var land_fail: Dictionary = SpaceLayerManager.can_land_assault("BEL", "luna_south_pole")
	var bomb: Dictionary = SpaceLayerManager.can_bombard_body("USA", "mars", "BEL")
	var bomb_fail: Dictionary = SpaceLayerManager.can_bombard_body("BEL", "mars", "USA")
	var land_ok: bool = bool(land.get("can", false)) and not bool(land_fail.get("can", true))
	var bomb_ok: bool = bool(bomb.get("can", false)) and not bool(bomb_fail.get("can", true))
	var sp: Dictionary = SpaceLayerManager.compute_space_power_for_tag("USA")
	var power_ok: bool = float(sp.get("space_power_index", 0.0)) > 0.0 and bool(sp.get("bombardment_threat", false))
	var combat_ok: bool = land_ok and bomb_ok and power_ok
	return {
		"ok": combat_ok, "live": true, "combat_ok": combat_ok,
		"land": land, "land_fail": land_fail, "bomb": bomb, "bomb_fail": bomb_fail, "space_power": sp,
		"province_id": province_id, "live_api": "apply_space_colony_combat_live",
		"scenario": "landing_and_bombardment",
	}


