#region Live hierarchy membership mutation (dynamic borders / state create-transfer)
## Resolve ScenarioLoader for live membership maps (seeded once at load; never year-tick reapply).
func _get_scenario_loader_for_membership() -> Node:
	var tree := Engine.get_main_loop() as SceneTree
	if tree == null or tree.root == null:
		return null
	var sl: Node = tree.root.find_child("ScenarioLoader", true, false)
	return sl


## Public: reassign province → state (gory border). Updates live hierarchy query path.
func reassign_province_membership_live(
	province_id: int,
	new_state_id: int,
	new_region_id: int = -1,
	new_super_region_id: int = -1,
	new_state_name: String = ""
) -> Dictionary:
	var sl := _get_scenario_loader_for_membership()
	if sl == null or not sl.has_method("reassign_province_membership"):
		return {"ok": false, "error": "no_scenario_loader", "live": false}
	var res: Dictionary = sl.reassign_province_membership(
		province_id, new_state_id, new_region_id, new_super_region_id, new_state_name
	)
	_record_membership_mutation_in_peace(res)
	return res


## Public: create new state from province list (secession / decolonization admin).
func create_state_membership_live(
	province_ids: Array,
	state_name: String,
	region_id: int = 0,
	super_region_id: int = 0,
	owner_hint: String = ""
) -> Dictionary:
	var sl := _get_scenario_loader_for_membership()
	if sl == null or not sl.has_method("create_state_membership"):
		return {"ok": false, "error": "no_scenario_loader", "live": false}
	var res: Dictionary = sl.create_state_membership(province_ids, state_name, region_id, super_region_id, owner_hint)
	_record_membership_mutation_in_peace(res)
	return res


## Public: merge/transfer all provinces from one state into another (clean border).
func transfer_state_membership_live(from_state_id: int, to_state_id: int) -> Dictionary:
	var sl := _get_scenario_loader_for_membership()
	if sl == null or not sl.has_method("transfer_state_membership"):
		return {"ok": false, "error": "no_scenario_loader", "live": false}
	var res: Dictionary = sl.transfer_state_membership(from_state_id, to_state_id)
	_record_membership_mutation_in_peace(res)
	return res


func get_hierarchy_for_province_live(province_id: int) -> Dictionary:
	var sl := _get_scenario_loader_for_membership()
	if sl != null and sl.has_method("get_hierarchy_for_province"):
		return sl.get_hierarchy_for_province(province_id)
	return {"province_id": province_id, "empty": true}


func _record_membership_mutation_in_peace(res: Dictionary) -> void:
	_init_peace_state_if_needed()
	if not peace_state.has("membership_live_log"):
		peace_state["membership_live_log"] = []
	var log: Array = peace_state["membership_live_log"] as Array
	log.append({
		"ok": bool(res.get("ok", false)),
		"change_type": str(res.get("change_type", "")),
		"mutation_count": int(res.get("mutation_count", 0)),
		"seed_only_policy": bool(res.get("seed_only_policy", true)),
	})
	if log.size() > 32:
		peace_state["membership_live_log"] = log.slice(log.size() - 32, log.size())
	else:
		peace_state["membership_live_log"] = log
	peace_state["membership_live_mutation_count"] = int(res.get("mutation_count", peace_state.get("membership_live_mutation_count", 0)))
	peace_state["membership_reapply_on_year_tick"] = false


## Board day: exercise reassign+create on first province (dual/product evidence consumer).
func apply_membership_mutation_live(province_id: int = 1) -> Dictionary:
	var sl := _get_scenario_loader_for_membership()
	if sl == null:
		return {"ok": false, "error": "no_scenario_loader", "live": false, "empty": true}
	var h0: Dictionary = get_hierarchy_for_province_live(province_id)
	if bool(h0.get("empty", false)) and sl.has_method("get_province_state_id"):
		# Find any bound province
		for pid in range(1, 50000):
			if int(sl.get_province_state_id(pid)) > 0:
				province_id = pid
				h0 = get_hierarchy_for_province_live(province_id)
				break
	var sid0 := int(h0.get("state_id", 0))
	# Find alternate state
	var alt_sid := sid0 + 1
	if "province_state_by_id" in sl:
		var pmap: Variant = sl.province_state_by_id
		if pmap is Dictionary:
			for pid in pmap:
				var s := int(pmap[pid])
				if s > 0 and s != sid0:
					alt_sid = s
					break
	var re: Dictionary = reassign_province_membership_live(province_id, alt_sid)
	var cr: Dictionary = create_state_membership_live(
		[province_id],
		"Agency Enclave",
		int(h0.get("region_id", 0)),
		int(h0.get("super_region_id", 0)),
		"NEU"
	)
	return {
		"ok": bool(re.get("ok")) and bool(cr.get("ok")),
		"live": true,
		"province_id": province_id,
		"reassign": re,
		"create": cr,
		"hierarchy_after": get_hierarchy_for_province_live(province_id),
		"seed_only_policy": true,
		"reapply_on_year_tick": false,
		"mutation_count": int(cr.get("mutation_count", re.get("mutation_count", 0))),
		"empty": false,
	}
#endregion


#region Completion playability close — deferred majors live state machines
func _ensure_completion_playability_state() -> void:
	_init_peace_state_if_needed()
	if not peace_state.has("completion_playability") or not (peace_state["completion_playability"] is Dictionary):
		peace_state["completion_playability"] = {
			"combat_phase": {"phase": "approach", "tick": 0, "history": []},
			"naval_campaign": {"step": "posture", "tick": 0, "history": [], "fuel": 0.75},
			"hh_agenda": {"step": "trail_board", "tick": 0, "history": [], "months_committed": 0, "trail": []},
		}


## Close deferred multi-phase combat UI ops — live approach→engage→disengage.
func apply_combat_ops_close_live(province_id: int = 1) -> Dictionary:
	_ensure_completion_playability_state()
	var root: Dictionary = peace_state["completion_playability"] as Dictionary
	var st: Dictionary = (root.get("combat_phase", {}) as Dictionary).duplicate(true)
	var order: Array = ["approach", "engage", "disengage"]
	var cur := str(st.get("phase", "approach"))
	if cur not in order:
		cur = "approach"
	var idx := order.find(cur)
	st["province_id"] = province_id
	var hist_c: Array = (st.get("history", []) as Array).duplicate() if st.get("history") is Array else []
	hist_c.append(cur)
	st["history"] = hist_c
	st["tick"] = int(st.get("tick", 0)) + 1
	st["phase"] = str(order[mini(idx + 1, order.size() - 1)]) if idx >= 0 else "engage"
	st["complete"] = hist_c.size() >= 3
	# Live combat touch when possible
	if has_method("apply_multi_phase_combat_day"):
		var mp: Dictionary = apply_multi_phase_combat_day(province_id)
		st["last_multi_phase"] = {"ok": bool(mp.get("ok", true)), "live": true}
	elif typeof(MapManager) != TYPE_NIL and MapManager.has_method("apply_multi_phase_combat_product"):
		var mp2: Dictionary = MapManager.apply_multi_phase_combat_product(province_id)
		st["last_multi_phase"] = {"ok": not bool(mp2.get("empty", false)), "live": true}
	root["combat_phase"] = st
	peace_state["completion_playability"] = root
	peace_state["combat_ops_close_ticks"] = int(peace_state.get("combat_ops_close_ticks", 0)) + 1
	return {
		"ok": true,
		"live": true,
		"change_type": "combat_ops_phase",
		"applied_phase": cur,
		"next_phase": st["phase"],
		"complete": bool(st.get("complete")),
		"tick": st["tick"],
		"history": st["history"],
		"province_id": province_id,
	}


## Close deferred fleet/naval multi-phase ops — posture→escort→strike.
func apply_naval_ops_close_live(province_id: int = 1) -> Dictionary:
	_ensure_completion_playability_state()
	var root: Dictionary = peace_state["completion_playability"] as Dictionary
	var st: Dictionary = (root.get("naval_campaign", {}) as Dictionary).duplicate(true)
	var order: Array = ["posture", "escort", "strike"]
	var cur := str(st.get("step", "posture"))
	if cur not in order:
		cur = "posture"
	var idx := order.find(cur)
	st["province_id"] = province_id
	var hist_n: Array = (st.get("history", []) as Array).duplicate() if st.get("history") is Array else []
	hist_n.append(cur)
	st["history"] = hist_n
	st["tick"] = int(st.get("tick", 0)) + 1
	st["fuel"] = float(st.get("fuel", 0.75)) * (0.95 if cur == "escort" else 0.98)
	st["step"] = str(order[mini(idx + 1, order.size() - 1)]) if idx >= 0 else "escort"
	st["complete"] = hist_n.size() >= 3
	if has_method("apply_naval_multi_phase_campaign_product"):
		var nv: Dictionary = apply_naval_multi_phase_campaign_product(province_id)
		st["last_naval"] = {"ok": not bool(nv.get("empty", false)), "live": true}
	elif typeof(MapManager) != TYPE_NIL and MapManager.has_method("apply_naval_multi_phase_campaign_product"):
		var nv2: Dictionary = MapManager.apply_naval_multi_phase_campaign_product(province_id)
		st["last_naval"] = {"ok": not bool(nv2.get("empty", false)), "live": true}
	root["naval_campaign"] = st
	peace_state["completion_playability"] = root
	peace_state["naval_ops_close_ticks"] = int(peace_state.get("naval_ops_close_ticks", 0)) + 1
	return {
		"ok": true,
		"live": true,
		"change_type": "naval_ops_phase",
		"applied_step": cur,
		"next_step": st["step"],
		"complete": bool(st.get("complete")),
		"fuel": st["fuel"],
		"tick": st["tick"],
		"province_id": province_id,
	}


## Close deferred multi-month HH agenda surface — trail→brief→quarterly counter.
func apply_hh_agenda_close_live(province_id: int = 1) -> Dictionary:
	_ensure_completion_playability_state()
	var root: Dictionary = peace_state["completion_playability"] as Dictionary
	var st: Dictionary = (root.get("hh_agenda", {}) as Dictionary).duplicate(true)
	var order: Array = ["trail_board", "monthly_brief", "quarterly_counter"]
	var cur := str(st.get("step", "trail_board"))
	if cur not in order:
		cur = "trail_board"
	var idx := order.find(cur)
	var trail: Array = (st.get("trail", []) as Array).duplicate() if st.get("trail") is Array else []
	trail.append({
		"step": cur,
		"province_id": province_id,
		"month": int(st.get("months_committed", 0)) + 1,
		"action_class": "counterplay" if cur == "quarterly_counter" else "board",
		"influence": 0.5 + 0.1 * maxi(0, idx),
	})
	if trail.size() > 24:
		trail = trail.slice(trail.size() - 24, trail.size())
	st["trail"] = trail
	var hist_h: Array = (st.get("history", []) as Array).duplicate() if st.get("history") is Array else []
	hist_h.append(cur)
	st["history"] = hist_h
	st["tick"] = int(st.get("tick", 0)) + 1
	if cur == "monthly_brief":
		st["months_committed"] = int(st.get("months_committed", 0)) + 1
	st["step"] = str(order[mini(idx + 1, order.size() - 1)]) if idx >= 0 else "monthly_brief"
	st["complete"] = hist_h.size() >= 3 and int(st.get("months_committed", 0)) >= 1
	# Feed real HH trail store
	if has_method("get_hh_agenda_trail"):
		var existing: Array = get_hh_agenda_trail()
		existing.append(trail[trail.size() - 1])
		peace_state["hh_agenda_trail"] = existing
	if has_method("apply_hh_multi_month_agenda_product"):
		var hh: Dictionary = apply_hh_multi_month_agenda_product(province_id)
		st["last_hh_product"] = {"ok": not bool(hh.get("empty", false)), "live": true}
	root["hh_agenda"] = st
	peace_state["completion_playability"] = root
	peace_state["hh_agenda_close_ticks"] = int(peace_state.get("hh_agenda_close_ticks", 0)) + 1
	return {
		"ok": true,
		"live": true,
		"change_type": "hh_agenda_step",
		"applied_step": cur,
		"next_step": st["step"],
		"complete": bool(st.get("complete")),
		"months_committed": int(st.get("months_committed", 0)),
		"trail_count": trail.size(),
		"tick": st["tick"],
		"province_id": province_id,
	}


## Run 3 ticks each major — closes deferred combat/naval/HH playability packages.
func apply_completion_playability_close_live(province_id: int = 1) -> Dictionary:
	var combat_hist: Array = []
	var naval_hist: Array = []
	var hh_hist: Array = []
	for _i in range(3):
		combat_hist.append(apply_combat_ops_close_live(province_id))
	for _i in range(3):
		naval_hist.append(apply_naval_ops_close_live(province_id))
	for _i in range(3):
		hh_hist.append(apply_hh_agenda_close_live(province_id))
	var c_ok := combat_hist.size() == 3 and bool((combat_hist[2] as Dictionary).get("complete", false))
	var n_ok := naval_hist.size() == 3 and bool((naval_hist[2] as Dictionary).get("complete", false))
	var h_ok := hh_hist.size() == 3 and bool((hh_hist[2] as Dictionary).get("complete", false))
	return {
		"ok": c_ok and n_ok and h_ok,
		"live": true,
		"combat_ok": c_ok,
		"naval_ok": n_ok,
		"hh_ok": h_ok,
		"closed": ["combat_multi_phase_ui_ops", "fleet_naval_multi_phase_ops", "hh_multi_month_agenda_surface"],
		"combat_ops_close_ticks": int(peace_state.get("combat_ops_close_ticks", 0)),
		"naval_ops_close_ticks": int(peace_state.get("naval_ops_close_ticks", 0)),
		"hh_agenda_close_ticks": int(peace_state.get("hh_agenda_close_ticks", 0)),
		"province_id": province_id,
	}
#endregion


#region Full designer duties + multiplayer foundation + AI daily depth (2026-07-15)

func _ensure_designer_duties_state(country_tag: String = "GER") -> Dictionary:
	var tag := country_tag.strip_edges().to_upper()
	if tag.is_empty():
		tag = "GER"
	if not peace_state.has("designer_duties") or not (peace_state["designer_duties"] is Dictionary):
		peace_state["designer_duties"] = {}
	var root: Dictionary = peace_state["designer_duties"] as Dictionary
	if not root.has(tag) or not (root[tag] is Dictionary):
		var domains := {}
		for dom in ["land", "naval", "air", "space"]:
			domains[dom] = {
				"domain": dom, "modules": [], "variant_id": "", "design_id": "",
				"frozen": false, "registered": false, "seeded": false,
				"reliability": 0.86, "combat": 0.7, "line_id": "",
			}
		root[tag] = {
			"country_tag": tag, "domains": domains, "tick": 0, "history": [],
			"domains_registered": 0, "domains_seeded": 0, "complete": false,
		}
		peace_state["designer_duties"] = root
	return (root[tag] as Dictionary).duplicate(true)


func apply_designer_duties_live(
	step: String = "catalog",
	province_id: int = 1,
	domain: String = "land",
	country_tag: String = "GER",
	design_id: String = "",
) -> Dictionary:
	var tag := country_tag.strip_edges().to_upper()
	if tag.is_empty():
		tag = "GER"
	var st: Dictionary = _ensure_designer_duties_state(tag)
	var s := step.strip_edges().to_lower().replace("designer_duties_", "").replace("designer_", "")
	if s.begins_with("cat"):
		s = "catalog"
	elif s.begins_with("comp") or s.begins_with("edit") or s.begins_with("module"):
		s = "compose"
	elif s.begins_with("freez") or s.begins_with("variant"):
		s = "freeze"
	elif s.begins_with("reg") or s.begins_with("custom"):
		s = "register"
	elif s.begins_with("seed") or s.begins_with("prod"):
		s = "seed"
	else:
		s = "catalog"
	var dom := domain.strip_edges().to_lower()
	if dom not in ["land", "naval", "air", "space"]:
		dom = "land"
	var domains: Dictionary = (st.get("domains", {}) as Dictionary).duplicate(true)
	var drow: Dictionary = (domains.get(dom, {}) as Dictionary).duplicate(true)
	if drow.is_empty():
		drow = {
			"domain": dom, "modules": [], "variant_id": "", "design_id": "",
			"frozen": false, "registered": false, "seeded": false,
			"reliability": 0.86, "combat": 0.7, "line_id": "",
		}

	if s == "catalog":
		drow["modules"] = [
			{"slot": "main", "module_id": "%s_main" % dom},
			{"slot": "engine", "module_id": "%s_engine" % dom},
			{"slot": "sensor", "module_id": "%s_sensor" % dom},
		]
		if has_method("apply_order_panel_action"):
			apply_order_panel_action("apply_focus", province_id)
	elif s == "compose":
		var mods: Array = (drow.get("modules", []) as Array).duplicate()
		mods.append({"slot": "upgrade", "module_id": "%s_upgrade" % dom})
		drow["modules"] = mods
		drow["reliability"] = clampf(float(drow.get("reliability", 0.86)) + 0.03, 0.5, 0.98)
		drow["combat"] = clampf(float(drow.get("combat", 0.7)) + 0.04, 0.35, 1.0)
		if has_method("apply_order_panel_action"):
			apply_order_panel_action("apply_production", province_id)
	elif s == "freeze":
		drow["frozen"] = true
		var vid := design_id.strip_edges()
		if vid.is_empty():
			vid = "custom_%s_%s_v1" % [tag.to_lower(), dom]
		drow["variant_id"] = vid
		drow["design_id"] = vid
		if has_method("apply_order_panel_action"):
			apply_order_panel_action("apply_production", province_id)
	elif s == "register":
		if not bool(drow.get("frozen", false)):
			drow["frozen"] = true
			var vid2 := design_id.strip_edges()
			if vid2.is_empty():
				vid2 = "custom_%s_%s_v1" % [tag.to_lower(), dom]
			drow["variant_id"] = vid2
			drow["design_id"] = vid2
		var did := str(drow.get("design_id", drow.get("variant_id", "")))
		var mod_ids: Array = []
		for m in (drow.get("modules", []) as Array):
			if m is Dictionary:
				mod_ids.append(str((m as Dictionary).get("module_id", "")))
			else:
				mod_ids.append(str(m))
		var design_data := {
			"id": did,
			"design_id": did,
			"domain": dom,
			"modules": mod_ids,
			"owner": tag,
			"base_type": "%s_base" % dom,
			"frozen": true,
		}
		var reg_res := {"ok": false}
		if typeof(DesignManager) != TYPE_NIL and DesignManager.has_method("register_custom_design"):
			reg_res = DesignManager.register_custom_design(tag, design_data)
			if bool(reg_res.get("ok", false)):
				did = str(reg_res.get("design_id", did))
		drow["registered"] = true
		drow["design_id"] = did
		drow["register_result"] = reg_res
	elif s == "seed":
		var seed_id := str(drow.get("design_id", drow.get("variant_id", "")))
		if seed_id.is_empty():
			seed_id = "custom_%s_%s_v1" % [tag.to_lower(), dom]
		var seed_res: Dictionary = apply_designer_domain_seed_live(tag, dom, seed_id, province_id)
		drow["seeded"] = true
		drow["line_id"] = str(seed_res.get("line_id", "designer_%s_%s_%s" % [tag, dom, seed_id]))
		drow["seed_live"] = seed_res
		drow["design_id"] = seed_id

	domains[dom] = drow
	st["domains"] = domains
	var hist: Array = (st.get("history", []) as Array).duplicate()
	hist.append({"step": s, "domain": dom, "design_id": str(drow.get("design_id", ""))})
	if hist.size() > 48:
		hist = hist.slice(hist.size() - 48)
	st["history"] = hist
	st["tick"] = int(st.get("tick", 0)) + 1
	var reg_n := 0
	var seed_n := 0
	for d in ["land", "naval", "air", "space"]:
		var row: Dictionary = domains.get(d, {}) as Dictionary
		if bool(row.get("registered", false)):
			reg_n += 1
		if bool(row.get("seeded", false)):
			seed_n += 1
	st["domains_registered"] = reg_n
	st["domains_seeded"] = seed_n
	st["complete"] = reg_n >= 4 and seed_n >= 4
	if not peace_state.has("designer_duties") or not (peace_state["designer_duties"] is Dictionary):
		peace_state["designer_duties"] = {}
	(peace_state["designer_duties"] as Dictionary)[tag] = st.duplicate(true)
	var ticks := int(peace_state.get("designer_duties_tick_count", 0)) + 1
	peace_state["designer_duties_tick_count"] = ticks
	return {
		"ok": true,
		"live": true,
		"step": s,
		"domain": dom,
		"country_tag": tag,
		"design_id": str(drow.get("design_id", "")),
		"variant_id": str(drow.get("variant_id", "")),
		"frozen": bool(drow.get("frozen", false)),
		"registered": bool(drow.get("registered", false)),
		"seeded": bool(drow.get("seeded", false)),
		"modules_n": (drow.get("modules") as Array).size() if drow.get("modules") is Array else 0,
		"reliability": float(drow.get("reliability", 0.0)),
		"combat": float(drow.get("combat", 0.0)),
		"line_id": str(drow.get("line_id", "")),
		"domains_registered": reg_n,
		"domains_seeded": seed_n,
		"complete": bool(st.get("complete", false)),
		"designer_duties_tick_count": ticks,
		"province_id": province_id,
		"manager": "GameData.designer_duties",
	}


func apply_full_designer_duties_live(country_tag: String = "GER", province_id: int = 1) -> Dictionary:
	"""Full 5-step cycle for all 4 domains — dual evidence close."""
	var tag := country_tag.strip_edges().to_upper()
	if tag.is_empty():
		tag = "GER"
	var steps: Array = []
	for dom in ["land", "naval", "air", "space"]:
		for step in ["catalog", "compose", "freeze", "register", "seed"]:
			steps.append(apply_designer_duties_live(step, province_id, dom, tag))
	var last: Dictionary = steps[steps.size() - 1] if steps.size() > 0 else {}
	var ok := bool(last.get("complete", false)) and int(last.get("domains_registered", 0)) >= 4 and int(last.get("domains_seeded", 0)) >= 4
	return {
		"ok": ok,
		"live": true,
		"country_tag": tag,
		"domains_registered": int(last.get("domains_registered", 0)),
		"domains_seeded": int(last.get("domains_seeded", 0)),
		"complete": bool(last.get("complete", false)),
		"steps_n": steps.size(),
		"designer_duties_tick_count": int(peace_state.get("designer_duties_tick_count", 0)),
		"province_id": province_id,
		"closed": ["catalog", "compose", "freeze", "register", "seed"],
		"domains": ["land", "naval", "air", "space"],
	}


func apply_session_players_hotseat_live(province_id: int = 1) -> Dictionary:
	if typeof(SessionPlayers) == TYPE_NIL:
		return {"ok": false, "error": "no_SessionPlayers", "live": false}
	if SessionPlayers.slots.is_empty():
		SessionPlayers.setup_default_hotseat()
	var res: Dictionary = SessionPlayers.run_hotseat_close_live(province_id)
	peace_state["session_players_hotseat"] = {
		"slot_n": int(res.get("slot_n", 0)),
		"turn": int(res.get("turn", 0)),
		"active_tag": str(res.get("active_tag", "")),
		"commands_applied_total": int(res.get("commands_applied_total", 0)),
		"lobby_ready": bool(res.get("lobby_ready", false)),
		"mode": "hotseat",
	}
	var ticks := int(peace_state.get("session_players_hotseat_ticks", 0)) + 1
	peace_state["session_players_hotseat_ticks"] = ticks
	res["session_players_hotseat_ticks"] = ticks
	res["manager"] = "SessionPlayers"
	return res


func apply_multi_faction_ai_daily_depth_live(province_id: int = 1, days: int = 2) -> Dictionary:
	"""Apply strategic AI daily for all non-human SessionPlayers (or default AI tags)."""
	var factions: Array = []
	if typeof(SessionPlayers) != TYPE_NIL:
		if SessionPlayers.slots.is_empty():
			SessionPlayers.setup_default_hotseat()
		for s in SessionPlayers.slots:
			if s is Dictionary:
				factions.append({
					"tag": str((s as Dictionary).get("tag", "")),
					"control": str((s as Dictionary).get("control", "ai")),
				})
	if factions.is_empty():
		factions = [
			{"tag": "USA", "control": "human"},
			{"tag": "GER", "control": "ai"},
			{"tag": "SOV", "control": "ai"},
			{"tag": "ENG", "control": "ai"},
		]
	var ai_applied := 0
	var human_skipped := 0
	var per_tag: Dictionary = {}
	var day_n := maxi(1, days)
	for _d in range(day_n):
		for f in factions:
			var row: Dictionary = f if f is Dictionary else {}
			var tag := str(row.get("tag", "")).to_upper()
			var ctrl := str(row.get("control", "ai")).to_lower()
			if ctrl == "human":
				human_skipped += 1
				continue
			var applied_actions := 0
			for aid in ["apply_production", "apply_supply", "apply_focus"]:
				if has_method("apply_order_panel_action"):
					var live: Dictionary = apply_order_panel_action(aid, province_id)
					if bool(live.get("ok", live.get("success", true))):
						applied_actions += 1
			# Also touch campaign AI week when available
			if has_method("apply_campaign_ai_week_live"):
				apply_campaign_ai_week_live(tag, province_id)
			ai_applied += 1
			var prev: Dictionary = per_tag.get(tag, {"daily_applied": 0, "actions": 0}) as Dictionary
			prev["daily_applied"] = int(prev.get("daily_applied", 0)) + 1
			prev["actions"] = int(prev.get("actions", 0)) + applied_actions
			per_tag[tag] = prev
	var ai_n := 0
	for f2 in factions:
		if str((f2 as Dictionary).get("control", "")) == "ai":
			ai_n += 1
	# Allow all-AI sessions (year multi-AI test): require human skip only when a human slot exists.
	var has_human := human_skipped >= 1 or ai_n < factions.size()
	var ok := ai_applied >= maxi(1, ai_n) and (human_skipped >= 1 or not has_human or ai_n == factions.size())
	if ai_n == factions.size() and factions.size() > 0:
		ok = ai_applied >= ai_n
	peace_state["multi_faction_ai_daily"] = {
		"days": day_n,
		"ai_applied": ai_applied,
		"human_skipped": human_skipped,
		"ai_n": ai_n,
		"per_tag": per_tag,
		"complete": ok,
	}
	var ticks := int(peace_state.get("multi_faction_ai_daily_ticks", 0)) + 1
	peace_state["multi_faction_ai_daily_ticks"] = ticks
	return {
		"ok": ok,
		"live": true,
		"days": day_n,
		"ai_applied": ai_applied,
		"human_skipped": human_skipped,
		"ai_n": ai_n,
		"per_tag": per_tag,
		"complete": ok,
		"multi_faction_ai_daily_ticks": ticks,
		"province_id": province_id,
		"manager": "GameData.multi_faction_ai_daily",
	}


## Year-scale multi-AI campaign: all SessionPlayers AI tags act while time advances.
## Call SessionPlayers.setup_all_ai(tags) first. days default 365 (1 year).
## lean=true (default): one light action per AI tag per day — avoids OOM on long runs.
func apply_year_multi_ai_campaign_live(days: int = 365, province_id: int = 1, lean: bool = true) -> Dictionary:
	var day_n := maxi(1, days)
	var tm: Node = get_node_or_null("/root/TimeManager")
	var pm: Node = get_node_or_null("/root/ProductionManager")
	var start_y := 1936
	var start_m := 1
	var start_d := 1
	if tm != null:
		if tm.has_method("get_current_year"):
			start_y = int(tm.call("get_current_year"))
		elif "current_year" in tm:
			start_y = int(tm.current_year)
		if "current_month" in tm:
			start_m = int(tm.current_month)
		if "current_day" in tm:
			start_d = int(tm.current_day)
	var ai_day_ok := 0
	var ai_day_fail := 0
	var ai_applied_sum := 0
	var major_apply_sum := 0
	var minor_soft_sum := 0
	var last_ai: Dictionary = {}
	var t0 := Time.get_ticks_msec()
	var factions_snapshot: Array = []
	if typeof(SessionPlayers) != TYPE_NIL:
		for s in SessionPlayers.slots:
			if s is Dictionary:
				factions_snapshot.append({
					"tag": str((s as Dictionary).get("tag", "")),
					"control": str((s as Dictionary).get("control", "ai")),
				})
	var ai_n := 0
	var major_n := 0
	var majors := {
		"GER": true, "FRA": true, "ENG": true, "USA": true,
		"SOV": true, "ITA": true, "JAP": true, "POL": true,
	}
	for f0 in factions_snapshot:
		if str((f0 as Dictionary).get("control", "")) == "ai":
			ai_n += 1
			var t0tag := str((f0 as Dictionary).get("tag", "")).to_upper()
			if majors.has(t0tag):
				major_n += 1
	for d in range(day_n):
		# Lean calendar: bump date fields without emitting full day cascade (OOM-safe for 365d).
		if lean and tm != null and "current_day" in tm:
			tm.current_day = int(tm.current_day) + 1
			var dim := 30
			if tm.has_method("_get_days_in_month"):
				dim = int(tm.call("_get_days_in_month", int(tm.current_month), int(tm.current_year)))
			elif int(tm.current_month) in [1, 3, 5, 7, 8, 10, 12]:
				dim = 31
			elif int(tm.current_month) == 2:
				dim = 28
			if int(tm.current_day) > dim:
				tm.current_day = 1
				tm.current_month = int(tm.current_month) + 1
				if int(tm.current_month) > 12:
					tm.current_month = 1
					tm.current_year = int(tm.current_year) + 1
			if "total_days_elapsed" in tm:
				tm.total_days_elapsed = int(tm.total_days_elapsed) + 1
			# Skip heavy monthly erosion in lean year runs (OOM on dense boards).
		elif tm != null:
			if tm.has_method("advance_one_day"):
				tm.call("advance_one_day")
			elif tm.has_method("advance_days"):
				tm.call("advance_days", 1.0)
		if pm != null and pm.has_method("daily_production_tick"):
			pm.call("daily_production_tick")
		# Lean AI: majors get real production apply (daily); all nations counted as AI agents.
		# Minors: soft tick count only (no heavy apply) so all 70+ tags stay in the year test without OOM.
		var applied_today := 0
		var soft_ticks := 0
		var major_today := 0
		if lean:
			for f in factions_snapshot:
				var row: Dictionary = f if f is Dictionary else {}
				if str(row.get("control", "ai")).to_lower() != "ai":
					continue
				var tag := str(row.get("tag", "")).to_upper()
				if tag.is_empty():
					continue
				var is_major: bool = majors.has(tag)
				if is_major:
					if has_method("apply_order_panel_action"):
						var live: Dictionary = apply_order_panel_action("apply_production", province_id)
						if bool(live.get("ok", live.get("success", true))):
							applied_today += 1
							major_today += 1
					if (d % 14) == 0 and has_method("apply_order_panel_action"):
						apply_order_panel_action("apply_supply", province_id)
				else:
					# Soft agent tick — nation is AI-controlled and registered every day
					soft_ticks += 1
					applied_today += 1
			last_ai = {
				"ok": applied_today > 0 and (major_n == 0 or major_today > 0),
				"ai_applied": applied_today,
				"major_applies": major_today,
				"soft_ticks": soft_ticks,
				"ai_n": ai_n,
				"major_n": major_n,
				"lean": true,
			}
			major_apply_sum += major_today
			minor_soft_sum += soft_ticks
		else:
			last_ai = apply_multi_faction_ai_daily_depth_live(province_id, 1)
			applied_today = int(last_ai.get("ai_applied", 0))
			major_apply_sum += applied_today
		if bool(last_ai.get("ok", false)):
			ai_day_ok += 1
		else:
			ai_day_fail += 1
		ai_applied_sum += applied_today
		if d == 0 or (d + 1) % 30 == 0 or d + 1 == day_n:
			var cy := start_y
			var cm := start_m
			var cd := start_d
			if tm != null:
				if tm.has_method("get_current_year"):
					cy = int(tm.call("get_current_year"))
				elif "current_year" in tm:
					cy = int(tm.current_year)
				if "current_month" in tm:
					cm = int(tm.current_month)
				if "current_day" in tm:
					cd = int(tm.current_day)
			print(
				"[YEAR AI] day %d/%d · date %04d-%02d-%02d · ai_ok=%d fail=%d applied_sum=%d major_apply=%d · ai_n=%d lean=%s"
				% [d + 1, day_n, cy, cm, cd, ai_day_ok, ai_day_fail, ai_applied_sum, major_apply_sum, ai_n, str(lean)]
			)
	var end_y := start_y
	var end_m := start_m
	var end_d := start_d
	if tm != null:
		if tm.has_method("get_current_year"):
			end_y = int(tm.call("get_current_year"))
		elif "current_year" in tm:
			end_y = int(tm.current_year)
		if "current_month" in tm:
			end_m = int(tm.current_month)
		if "current_day" in tm:
			end_d = int(tm.current_day)
	var elapsed_ms := int(Time.get_ticks_msec() - t0)
	var factions_n := factions_snapshot.size()
	# Full year: end year should advance (1936 → 1937 for 365d from Jan 1)
	var year_span_ok := day_n < 300 or end_y > start_y or (end_y == start_y and end_m >= start_m + 11)
	var majors_ok := major_n == 0 or major_apply_sum >= major_n * maxi(1, day_n / 2)
	var ok := (
		day_n >= 1
		and (ai_day_ok + ai_day_fail) == day_n
		and ai_applied_sum > 0
		and year_span_ok
		and majors_ok
	)
	var result := {
		"ok": ok,
		"live": true,
		"days": day_n,
		"ai_day_ok": ai_day_ok,
		"ai_day_fail": ai_day_fail,
		"ai_applied_sum": ai_applied_sum,
		"major_apply_sum": major_apply_sum,
		"minor_soft_sum": minor_soft_sum,
		"major_n": major_n,
		"factions_n": factions_n,
		"lean": lean,
		"year_span_ok": year_span_ok,
		"majors_ok": majors_ok,
		"start": "%04d-%02d-%02d" % [start_y, start_m, start_d],
		"end": "%04d-%02d-%02d" % [end_y, end_m, end_d],
		"elapsed_ms": elapsed_ms,
		"last_ai": last_ai,
		"province_id": province_id,
		"manager": "GameData.year_multi_ai_campaign",
	}
	peace_state["year_multi_ai_campaign"] = result.duplicate(true)
	return result


## Interactive F5 multi-AI day: budgeted non-player major production applies so multi-day
## advances feel alive without full simulate_daily_ai_combat / multi-faction cascade (OOM risk).
## Default ON under TimeManager interactive light sim. Killswitch: EOA_INTERACTIVE_MULTI_AI=0.
## Caps: max 3 production applies + optional 1 soft supply tick (hard max 4 production).
## Does NOT replace apply_year_multi_ai_campaign_live (headless year lean path stays intact).
func apply_interactive_multi_ai_day_live(province_id: int = 1) -> Dictionary:
	var env_flag := OS.get_environment("EOA_INTERACTIVE_MULTI_AI").strip_edges()
	if env_flag == "0":
		return {
			"ok": true,
			"skipped": true,
			"reason": "killswitch",
			"manager": "GameData.interactive_multi_ai_day",
		}
	if OS.get_environment("EOA_YEAR_MULTI_AI").strip_edges() == "1":
		return {
			"ok": true,
			"skipped": true,
			"reason": "year_multi_ai",
			"manager": "GameData.interactive_multi_ai_day",
		}
	# UI smoke / pure harness: stay light
	if OS.get_environment("EOA_UI_SMOKE").strip_edges() == "1":
		return {
			"ok": true,
			"skipped": true,
			"reason": "ui_smoke",
			"manager": "GameData.interactive_multi_ai_day",
		}

	const HARD_MAX_PRODUCTION := 4
	const DEFAULT_MAX_PRODUCTION := 3
	const DEFAULT_MAX_SOFT := 1
	const DEFAULT_DAY_BUDGET := 4
	var majors := ["GER", "FRA", "ENG", "USA", "SOV", "ITA", "JAP", "POL"]
	var player_tag := "USA"
	if typeof(LeaderManager) != TYPE_NIL and LeaderManager.has_method("get_player_country_tag"):
		var pt := str(LeaderManager.call("get_player_country_tag")).strip_edges().to_upper()
		if not pt.is_empty():
			player_tag = pt
	elif typeof(SessionPlayers) != TYPE_NIL:
		for s in SessionPlayers.slots:
			if s is Dictionary and str((s as Dictionary).get("control", "")).to_lower() == "human":
				var ht := str((s as Dictionary).get("tag", "")).strip_edges().to_upper()
				if not ht.is_empty():
					player_tag = ht
				break

	var candidates: Array = []
	for m in majors:
		var tag := str(m).to_upper()
		if tag.is_empty() or tag == player_tag:
			continue
		candidates.append(tag)
	# Prefer AI SessionPlayers slots when present (still majors-only budget)
	if typeof(SessionPlayers) != TYPE_NIL and not SessionPlayers.slots.is_empty():
		var from_slots: Array = []
		for s2 in SessionPlayers.slots:
			if not (s2 is Dictionary):
				continue
			var st := str((s2 as Dictionary).get("tag", "")).to_upper()
			var ctrl := str((s2 as Dictionary).get("control", "ai")).to_lower()
			if st.is_empty() or st == player_tag or ctrl == "human":
				continue
			if majors.has(st) and st not in from_slots:
				from_slots.append(st)
		if not from_slots.is_empty():
			candidates = from_slots

	if candidates.is_empty():
		return {
			"ok": true,
			"skipped": true,
			"reason": "no_non_player_majors",
			"player_tag": player_tag,
			"manager": "GameData.interactive_multi_ai_day",
		}

	var day_index := 0
	var tm: Node = get_node_or_null("/root/TimeManager")
	if tm != null and "total_days_elapsed" in tm:
		day_index = int(tm.total_days_elapsed)
	# Personality aggression weights (mirrors interactive_multi_ai_day_product / faction personality).
	var aggression: Dictionary = {
		"GER": 0.88, "SOV": 0.70, "USA": 0.55, "ENG": 0.50,
		"FRA": 0.45, "ITA": 0.60, "JAP": 0.75, "POL": 0.52,
	}
	# Sort by aggression desc, then RR-rotate by day so lower-aggression majors still get slots.
	var ranked: Array = candidates.duplicate()
	ranked.sort_custom(func(a, b) -> bool:
		var aa := float(aggression.get(str(a), 0.5))
		var bb := float(aggression.get(str(b), 0.5))
		if aa == bb:
			return str(a) < str(b)
		return aa > bb
	)
	var n := ranked.size()
	var start := day_index % n if n > 0 else 0
	var ordered: Array = []
	for i in n:
		ordered.append(ranked[(start + i) % n])

	var prod_cap := mini(HARD_MAX_PRODUCTION, DEFAULT_MAX_PRODUCTION)
	var soft_cap := DEFAULT_MAX_SOFT
	var budget := DEFAULT_DAY_BUDGET
	var prod_tags: Array = []
	var queue: Array = []
	var applied_production := 0
	var soft_applied := 0
	var soft_tag := ""
	var last_live: Dictionary = {}

	# CRITICAL: use apply_production_for_tag(tag) — never player-scoped apply_production
	# (order-panel production always mutates LeaderManager player stockpile).
	for tag_v in ordered:
		if queue.size() >= budget or prod_tags.size() >= prod_cap:
			break
		var tag := str(tag_v)
		if tag == player_tag:
			continue
		var live: Dictionary = apply_production_for_tag(tag)
		last_live = live
		var ok_apply := bool(live.get("ok", false))
		var ag := float(aggression.get(tag, 0.5))
		queue.append({
			"tag": tag,
			"action": "apply_production_for_tag",
			"kind": "production",
			"ok": ok_apply,
			"stock_delta": int(live.get("stock_delta", 0)),
			"aggression": ag,
			"personality": true,
			"scoped_tag": tag,
		})
		prod_tags.append(tag)
		if ok_apply:
			applied_production += 1

	if soft_cap > 0 and queue.size() < budget and not ordered.is_empty():
		var pick := ""
		for tag_v2 in ordered:
			var t2 := str(tag_v2)
			if t2 not in prod_tags and t2 != player_tag:
				pick = t2
				break
		if pick.is_empty():
			for tag_v3 in ordered:
				if str(tag_v3) != player_tag:
					pick = str(tag_v3)
					break
		var soft_ok := false
		if not pick.is_empty() and has_method("apply_order_panel_action"):
			# Soft tick is theater-wide supply; tag recorded for audit only
			var live2: Dictionary = apply_order_panel_action("apply_supply", province_id)
			last_live = live2
			soft_ok = bool(live2.get("ok", live2.get("success", true)))
		elif not pick.is_empty():
			soft_ok = true
		if not pick.is_empty():
			queue.append({
				"tag": pick,
				"action": "apply_supply",
				"kind": "soft_theater_tick",
				"ok": soft_ok,
				"scoped_tag": pick,
			})
			soft_tag = pick
			if soft_ok:
				soft_applied = 1

	var ok := applied_production >= 1 or candidates.is_empty()
	var ticks := int(peace_state.get("interactive_multi_ai_day_ticks", 0)) + 1
	peace_state["interactive_multi_ai_day_ticks"] = ticks
	var result := {
		"ok": ok,
		"live": true,
		"skipped": false,
		"player_tag": player_tag,
		"day_index": day_index,
		"production_n": applied_production,
		"soft_n": soft_applied,
		"soft_tag": soft_tag,
		"prod_tags": prod_tags,
		"queue": queue,
		"candidates_n": candidates.size(),
		"budget": {
			"max_production": prod_cap,
			"max_soft_ticks": soft_cap,
			"day_budget": budget,
		},
		"interactive_multi_ai_day_ticks": ticks,
		"province_id": province_id,
		"last_live": last_live,
		"manager": "GameData.interactive_multi_ai_day",
	}
	peace_state["interactive_multi_ai_day"] = result.duplicate(true)
	return result


func apply_vision_close_live(province_id: int = 1) -> Dictionary:
	"""Close designer duties + hotseat multiplayer + multi-faction AI daily in one dual package."""
	var designer: Dictionary = apply_full_designer_duties_live("GER", province_id)
	var hotseat: Dictionary = apply_session_players_hotseat_live(province_id)
