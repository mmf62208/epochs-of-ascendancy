func apply_trade_basing_expire_live(province_id: int = 1) -> Dictionary:
	if typeof(TradeManager) == TYPE_NIL or not TradeManager.has_method("process_monthly_basing_rights"):
		return {"ok": false, "live": true, "error": "no_expire", "live_api": "apply_trade_basing_expire_live"}
	var pid := maxi(province_id, 77)
	var res: Dictionary = TradeManager.grant_basing_rights("FRA", "SOV", pid, 2, {
		"silent": true, "major_port": false, "grant_id": "basing_expire_test_%d" % pid,
	})
	var gid := str(res.get("grant_id", ""))
	var before := bool(TradeManager.has_basing_access("SOV", "FRA", pid))
	var tick1: Dictionary = TradeManager.process_monthly_basing_rights(1936, 3, {"force_months": 1})
	var mid := bool(TradeManager.has_basing_access("SOV", "FRA", pid))
	var tick2: Dictionary = TradeManager.process_monthly_basing_rights(1936, 4, {"force_months": 1})
	var after := bool(TradeManager.has_basing_access("SOV", "FRA", pid))
	var expired_n := int(tick1.get("expired", 0)) + int(tick2.get("expired", 0))
	var expire_ok: bool = before and mid and not after and expired_n >= 1
	# Also revoke path
	var revoke_ok := true
	if TradeManager.has_method("revoke_basing_rights") and not gid.is_empty():
		# already expired; grant fresh then revoke
		var r2: Dictionary = TradeManager.grant_basing_rights("ITA", "JAP", pid + 3, 12, {"silent": true})
		var g2 := str(r2.get("grant_id", ""))
		if not g2.is_empty():
			revoke_ok = TradeManager.revoke_basing_rights(g2, "dual_test") and not TradeManager.has_basing_access("JAP", "ITA", pid + 3)
	var ok: bool = expire_ok and revoke_ok
	return {
		"ok": ok, "live": true, "expire_ok": expire_ok, "revoke_ok": revoke_ok,
		"before": before, "mid": mid, "after": after, "expired_n": expired_n,
		"grant_id": gid, "tick1": tick1, "tick2": tick2,
		"province_id": province_id, "live_api": "apply_trade_basing_expire_live",
		"scenario": "basing_graph_expire",
	}


