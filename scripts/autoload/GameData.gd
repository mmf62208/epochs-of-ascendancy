func apply_trade_basing_grant_live(province_id: int = 1) -> Dictionary:
	if typeof(TradeManager) == TYPE_NIL or not TradeManager.has_method("grant_basing_rights"):
		return {"ok": false, "live": true, "error": "no_grant", "live_api": "apply_trade_basing_grant_live"}
	var pid := maxi(province_id, 42)
	var res: Dictionary = TradeManager.grant_basing_rights("ENG", "GER", pid, 12, {
		"major_port": true,
		"range_bonus": 0.2,
		"silent": true,
	})
	var grant_id := str(res.get("grant_id", ""))
	var ok_grant := bool(res.get("ok", false)) and not grant_id.is_empty()
	# Also exercise accept-path write via synthetic docking offer if create/accept available
	var accept_path_ok := false
	var offer_id := ""
	if TradeManager.has_method("create_offer"):
		var offered: Array = [{
			"type": TradeManager.TradeItemType.DOCKING_RIGHTS,
			"id": str(pid + 1),
			"quantity": 1.0,
			"metadata": {
				"duration_months": 6,
				"province_id": pid + 1,
				"major_port": true,
				"silent": true,
				"modifiers": {"supply_throughput": 0.15, "port_access": 1.0},
			},
		}]
		var requested: Array = [{
			"type": TradeManager.TradeItemType.RESOURCE,
			"id": "steel",
			"quantity": 1.0,
			"metadata": {"kind": "token"},
		}]
		offer_id = str(TradeManager.create_offer("USA", "ITA", offered, requested, TradeManager.TradeVisibility.PUBLIC, 2))
		if not offer_id.is_empty() and TradeManager.has_method("accept_offer"):
			# AI parties skip stockpile checks — accept should write basing graph
			if TradeManager.accept_offer(offer_id):
				accept_path_ok = TradeManager.has_basing_access("ITA", "USA", pid + 1) or TradeManager.has_basing_access("ITA", "USA")
	var grant_ok: bool = ok_grant and TradeManager.has_basing_access("GER", "ENG", pid)
	# accept_path optional honesty: if create/accept failed due to stockpile, still pass on direct grant
	var ok: bool = grant_ok
	return {
		"ok": ok, "live": true, "grant_ok": grant_ok,
		"grant_id": grant_id, "grant_result": res,
		"accept_path_ok": accept_path_ok, "offer_id": offer_id,
		"province_id": province_id, "live_api": "apply_trade_basing_grant_live",
		"scenario": "basing_graph_grant",
	}


func apply_trade_basing_query_live(province_id: int = 1) -> Dictionary:
	if typeof(TradeManager) == TYPE_NIL or not TradeManager.has_method("get_basing_graph_board"):
		return {"ok": false, "live": true, "error": "no_board", "live_api": "apply_trade_basing_query_live"}
