			"day": 1, "actions_done": 0, "progress": 0.0, "briefed": false, "guided": false, "checkpointed": false, "tick_count": 0,
		}
	return (peace_state["tutorial_session"] as Dictionary).duplicate(true)

func apply_tutorial_session_live(step: String = "brief", province_id: int = 1) -> Dictionary:
	var st: Dictionary = get_tutorial_session_state()
	var s := step.strip_edges().to_lower().replace("tutorial_session_", "").replace("tutorial_", "")
	var day := int(st.get("day", 1))
	var actions := int(st.get("actions_done", 0))
	if s.begins_with("brief"):
		st["briefed"] = true
		day = maxi(day, 1)
	elif s.begins_with("guide"):
		st["guided"] = true
		actions += 2
		day = mini(20, day + 2)
	elif s.begins_with("check"):
		st["checkpointed"] = true
		actions += 1
		# Soft continuity snapshot (no SaveLoadManager mid-tick).
		if has_method("apply_save_resume_live"):
			apply_save_resume_live("checkpoint", "slot1", province_id)
	var progress := clampf(float(actions) / 8.0 + float(day) / 20.0 * 0.4, 0.0, 1.0)
	st["day"] = day
	st["actions_done"] = actions
	st["progress"] = progress
	st["tick_count"] = int(st.get("tick_count", 0)) + 1
	peace_state["tutorial_session"] = st.duplicate(true)
	var ticks := int(peace_state.get("tutorial_session_tick_count", 0)) + 1
	peace_state["tutorial_session_tick_count"] = ticks
	return {
		"ok": true, "live": true, "step": s, "province_id": province_id,
		"day": day, "actions_done": actions, "progress": progress, "tutorial_session_tick_count": ticks,
		"manager": "GameData.tutorial_session",
	}

