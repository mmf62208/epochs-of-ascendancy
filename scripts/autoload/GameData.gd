## Residual resource production primary — strategic stockpile soft shortage slice.
const RESOURCE_PRODUCTION_PRIMARY_STEPS: PackedStringArray = [
	"rsp_catalog", "rsp_full", "rsp_shortage", "rsp_critical", "rsp_close",
]


func _resource_production_medium_tank_need() -> Dictionary:
	return ProductionCostCalculator.resolve_daily_resource_cost_from_dict({
		"category": "medium_tank",
		"production_complexity": 1.0,
	})


func apply_resource_production_catalog_live(province_id: int = 1) -> Dictionary:
	var majors: PackedStringArray = ProductionCostCalculator.get_major_resource_ids()
	var need: Dictionary = _resource_production_medium_tank_need()
	if need.is_empty():
		need = {"steel": 2.5, "aluminum": 0.8, "fuel": 0.4, "rubber": 0.2}
	var ok := majors.size() >= 8 and not need.is_empty()
	return {
		"ok": ok, "live": true, "major_n": majors.size(), "majors": majors,
		"daily_need": need, "model": "strategic_stockpile_soft_shortage",
		"province_id": province_id, "live_api": "apply_resource_production_catalog_live",
	}


func apply_resource_production_full_supply_live(province_id: int = 1) -> Dictionary:
	var need: Dictionary = _resource_production_medium_tank_need()
	if need.is_empty():
		need = {"steel": 2.5, "aluminum": 0.8, "fuel": 0.4, "rubber": 0.2}
	var have: Dictionary = {}
	for k in need:
		have[k] = float(need[k]) * 10.0
	var outcome: Dictionary = ProductionCostCalculator.compute_resource_outcome(need, have)
	var speed := float(outcome.get("output_multiplier", 0.0))
	var ok := bool(outcome.get("afforded", false)) and speed >= 0.999
	outcome["ok"] = ok
	outcome["live"] = true
	outcome["province_id"] = province_id
	outcome["live_api"] = "apply_resource_production_full_supply_live"
	outcome["scenario"] = "full_supply"
	return outcome


func apply_resource_production_shortage_live(province_id: int = 1) -> Dictionary:
	var need: Dictionary = _resource_production_medium_tank_need()
	if need.is_empty():
		need = {"steel": 2.5, "aluminum": 0.8, "fuel": 0.4, "rubber": 0.2}
	var have: Dictionary = {}
	for k in need:
		have[k] = 0.0
	var outcome: Dictionary = ProductionCostCalculator.compute_resource_outcome(need, have)
	var speed := float(outcome.get("output_multiplier", 1.0))
	var min_floor := 0.55
	var ok := speed < 0.999 and speed + 0.001 >= min_floor
	# Also prove ProductionManager applies the same path when available
	if typeof(ProductionManager) != TYPE_NIL:
		var prev: Dictionary = ProductionManager.national_stockpile.duplicate(true) if ProductionManager.national_stockpile is Dictionary else {}
		ProductionManager.set_stockpile(have)
		# Line-free: weighted fill via calculator already used by PM
		var fill_pm := ProductionCostCalculator.compute_weighted_fill_ratio(need, ProductionManager.national_stockpile)
		var mult_pm: Dictionary = ProductionCostCalculator.compute_shortage_multipliers(fill_pm)
		outcome["pm_fill_ratio"] = fill_pm
		outcome["pm_speed"] = float(mult_pm.get("speed", 1.0))
		ok = ok and float(mult_pm.get("speed", 1.0)) < 0.999
		ProductionManager.set_stockpile(prev)
	outcome["ok"] = ok
	outcome["live"] = true
	outcome["province_id"] = province_id
	outcome["live_api"] = "apply_resource_production_shortage_live"
	outcome["scenario"] = "empty_stockpile"
	return outcome


func apply_resource_production_critical_live(province_id: int = 1) -> Dictionary:
	## Critical electronics shortage should reduce speed more than equal steel shortage.
	var steel_fill := ProductionCostCalculator.compute_weighted_fill_ratio({"steel": 10.0}, {"steel": 5.0})
	var elec_fill := ProductionCostCalculator.compute_weighted_fill_ratio({"electronics": 10.0}, {"electronics": 5.0})
	var steel_m: Dictionary = ProductionCostCalculator.compute_shortage_multipliers(steel_fill)
	var elec_m: Dictionary = ProductionCostCalculator.compute_shortage_multipliers(elec_fill)
	var steel_speed := float(steel_m.get("speed", 1.0))
	var elec_speed := float(elec_m.get("speed", 1.0))
	var ok := elec_fill < steel_fill - 0.01 and elec_speed < steel_speed - 0.001
	return {
		"ok": ok, "live": true,
		"steel_fill": steel_fill, "electronics_fill": elec_fill,
		"steel_speed": steel_speed, "electronics_speed": elec_speed,
		"critical_hurts_more": ok,
		"province_id": province_id, "live_api": "apply_resource_production_critical_live",
	}


