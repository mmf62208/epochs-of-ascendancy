# scripts/core/SaveCoverageManifest.gd
## What round-trips in a v2 save, and what is rebuilt or out of sim.
## peace rows: every GameData.peace_state key touched in source, saved unless exempt.
class_name SaveCoverageManifest
extends RefCounted

## autoload name -> {saved_in} or {exempt, reason, rebuild}
const AUTOLOADS := {
	"GameData": {"saved_in": "game_data"},
	"FactoryManager": {"saved_in": "factories"},
	"ProductionManager": {"saved_in": "production"},
	"DesignManager": {"saved_in": "design_lifecycle"},
	"SessionPlayers": {"saved_in": "session_players"},
	"SupplyManager": {"saved_in": "supply"},
	"LeaderManager": {"saved_in": "leaders"},
	"TimeManager": {"saved_in": "time"},
	"WeatherManager": {"saved_in": "weather"},
	"AgentManager": {"saved_in": "agents"},
	"NationalModifierManager": {"saved_in": "national_modifiers"},
	"TradeManager": {"saved_in": "trade"},
	"RelationsManager": {"saved_in": "relations"},
	"SpaceLayerManager": {"saved_in": "space_layer"},
	"MapManager": {"saved_in": "map"},
	"InfrastructureDevelopmentManager": {"saved_in": "infrastructure_projects"},
	"TechnologyManager": {"saved_in": "technology"},
	"BattleManager": {"saved_in": "land_war"},
	"NationalSpiritManager": {"saved_in": "national_spirits"},
	"LeaderEventUI": {"exempt": "UI only", "reason": "toasts and news panels; no sim state"},
	"NetSessionManager": {"exempt": "net-only", "reason": "multiplayer session is out of scope; offline play has no sim peer state"},
	"SpecialSiteManager": {"exempt": "static data", "reason": "site definitions load from JSON; province sites ride in map.special_sites"},
	"SaveLoadManager": {"exempt": "bookkeeping", "reason": "slot index is derived from autosave file timestamps; not sim state"},
	"DialogueManager": {"exempt": "UI only", "reason": "conversation UI autoload; no daily sim state"},
}

const EXTRAS := {
	"FormationMovement": {"saved_in": "land_war.marches"},
	"CombatPresenceRegistry": {"exempt": "derived", "reason": "rebuilt when supply division_deployments apply", "rebuild": "SaveLoadManager._apply_supply_deployments_state"},
	"LandBattleAi": {"exempt": "static data", "reason": "personality tables are data files, not campaign memory"},
	"WarStateDomain": {"saved_in": "game_data.campaign_wars", "also": "WarStateDomain._override is a static test-rules override and is not saved"},
	"CapitulationDomain": {"saved_in": "game_data.campaign_capitulation"},
	"CampaignEndDomain": {"saved_in": "game_data.campaign_end"},
}

## Derived caches rebuilt after apply, not stored as their own section.
const REBUILDS := {
	"MapManager owner index": "MapManager.update_province_owner during _apply_map_state",
	"supply network regional bonuses": "SupplyManager._apply_regional_control_throughput_bonuses",
	"live fronts": "WarStateDomain.invalidate_fronts",
	"factory owner cache": "FactoryManager.reconcile_factory_owners_with_map",
	"production AI day cache": "ProductionManager.end_interactive_multi_ai_day_cache",
	"technology unlock index": "TechnologyManager._rebuild_unlock_indices",
}

