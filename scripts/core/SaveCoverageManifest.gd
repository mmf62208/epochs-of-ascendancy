static func autoload_row(name: String) -> Dictionary:
	if AUTOLOADS.has(name):
		return (AUTOLOADS[name] as Dictionary).duplicate(true)
	return {}


static func extra_row(name: String) -> Dictionary:
	if EXTRAS.has(name):
		return (EXTRAS[name] as Dictionary).duplicate(true)
	return {}


static func peace_exempt(key: String) -> bool:
	return PEACE_EXEMPT.has(key)


static func peace_row(key: String) -> Dictionary:
	if PEACE_EXEMPT.has(key):
		return {"exempt": str(PEACE_EXEMPT[key]), "key": key}
	for saved in PEACE_SAVED:
		if saved == key:
			return {"saved_in": "game_data.%s" % key, "key": key}
	return {}


static func saved_peace_keys() -> PackedStringArray:
	return PEACE_SAVED
