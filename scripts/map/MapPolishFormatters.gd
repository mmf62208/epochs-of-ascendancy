static func recommend_medium_honesty_step(complete_60: bool = false, complete_80: bool = false, complete_100: bool = false, progress: float = 0.15) -> Dictionary:
	var step := "prove_80d"
	var reason := "mid window — prove factory risk at 80d"
	if not complete_60 or progress < 0.35:
		step = "prove_60d"
		reason = "medium line early — prove 60d seed"
	elif not complete_80:
		step = "prove_80d"
		reason = "mid window — prove factory risk at 80d"
	elif not complete_100:
		step = "prove_100d"
		reason = "near complete — prove 100d equip"
	else:
		step = "prove_100d"
		reason = "honesty locked — reaffirm 100d complete"
	var action_id := "medium_honesty_prove_60d"
	var leaf := "apply_production"
	match step:
		"prove_80d":
			action_id = "medium_honesty_prove_80d"
			leaf = "apply_production"
		"prove_100d":
			action_id = "medium_honesty_prove_100d"
			leaf = "apply_supply"
	return {"step": step, "action_id": action_id, "leaf": leaf, "reason": reason, "empty": false, "summary": "Recommend %s · %s" % [step, reason]}

static func project_medium_unit_completion(horizon_days: int = 100, tank_line_progress: float = 0.15, factories: int = 14, days_per_unit: float = 62.0) -> Dictionary:
	var progress := clampf(tank_line_progress, 0.0, 1.0)
	var dpu := maxf(days_per_unit, 1.0)
	var rate := 1.0 + 0.012 * float(clampi(factories - 1, 0, 20))
	var remaining := dpu * (1.0 - progress)
	var effective_days := float(horizon_days) * rate
	var units := int(effective_days / maxf(remaining if remaining > 0.01 else dpu, 1.0))
	if remaining <= effective_days:
		units = maxi(units, 1)
	var complete: bool = units >= 1 and horizon_days >= 60
	var end_prog := clampf(progress + effective_days / dpu, 0.0, 1.5)
	var label := "Medium unit project · %dd · dpu %.0f · rate %.2f · units %d · complete %s · rel 70%% crew 5" % [horizon_days, dpu, rate, units, "yes" if complete else "no"]
	return {
		"design_id": "panzer_iii_j_medium", "name": "Panzer III Ausf. J (medium)",
		"crew_required": 5, "base_production_days": days_per_unit, "reliability": 0.70,
		"speed": 34.0, "armor": 42.0, "hardness": 0.76,
		"modules": ["medium_gun", "radio", "tracks", "engine"],
		"units_projected": units, "will_complete": complete, "end_progress": end_prog,
		"horizon_days": horizon_days, "days_per_unit": dpu, "factory_rate": rate,
		"summary": label, "plain": label, "empty": false,
	}

static func medium_tank_production_honesty_product(province_id: int = 1, tank_line_progress: float = 0.15, factories: int = 14) -> Dictionary:
	var oob: Dictionary = medium_tank_oob_product(province_id, tank_line_progress, 0.0, 5.0, factories)
	var ready: Dictionary = force_readiness_day(80.0, 0.85, 0.7, 0.3, "mud", 0.3, 6, 80.0, province_id)
	var p60: Dictionary = project_medium_unit_completion(60, tank_line_progress, factories, 62.0)
	var p80: Dictionary = project_medium_unit_completion(80, tank_line_progress, factories, 62.0)
	var p100: Dictionary = project_medium_unit_completion(100, tank_line_progress, factories, 62.0)
	var c60: bool = bool(p60.get("will_complete", false))
	var c80: bool = bool(p80.get("will_complete", false))
	var c100: bool = bool(p100.get("will_complete", false))
	var score_60 := 0.55 if c60 else clampf(0.35 + 0.2 * tank_line_progress, 0.0, 1.0)
	var score_80 := 0.55 if c80 else 0.45
	var score_100 := 0.65 if c100 else clampf(0.4 + 0.25 * float(oob.get("score", 0.5)), 0.0, 1.0)
	var score := clampf(0.3 * score_60 + 0.3 * score_80 + 0.4 * score_100, 0.0, 1.0)
	if score < 0.35: score = 0.35
	var rec: Dictionary = recommend_medium_honesty_step(c60, c80, c100, tank_line_progress)
	var steps: Array = [
		{"step": "prove_60d", "action_id": "medium_honesty_prove_60d", "leaf": "apply_production", "label": "Step 0 — prove 60d medium seed/priority", "score": score_60},
		{"step": "prove_80d", "action_id": "medium_honesty_prove_80d", "leaf": "apply_production", "label": "Step 1 — prove 80d factory risk window", "score": score_80},
		{"step": "prove_100d", "action_id": "medium_honesty_prove_100d", "leaf": "apply_supply", "label": "Step 2 — prove 100d complete unit equip", "score": score_100},
	]
	var day_rows: Array = []
	var apply_queue: Array = []
	for i in range(steps.size()):
		var st: Dictionary = steps[i]
		var step_name := str(st.get("step"))
		var recommended: bool = step_name == str(rec.get("step"))
		var sc := float(st.get("score", 0.5))
		var leaf := str(st.get("leaf"))
		var lab := str(st.get("label"))
		if recommended: lab = "★ " + lab
		lab = "%s · score %.2f" % [lab, sc]
		day_rows.append({"index": i, "step": step_name, "action_id": str(st.get("action_id")), "leaf_action": leaf, "label": lab, "score": sc, "enabled": true, "recommended": recommended, "province_id": province_id})
		apply_queue.append({"action_id": leaf, "province_id": province_id, "score": sc, "enabled": true, "label": lab, "step": step_name, "product_action": str(st.get("action_id"))})
	var medium_tank_complete := 1 if c100 and int(p100.get("units_projected", 0)) >= 1 else 0
	var actions: Array = [
		{"action_id": "medium_tank_production_honesty_product", "label": "Run medium-tank production honesty product", "enabled": true},
		{"action_id": str(rec.get("action_id", "medium_honesty_prove_60d")), "label": "Recommended: %s" % str(rec.get("step", "prove_60d")), "enabled": true},
	]
	for row2 in day_rows:
		actions.append({"action_id": str(row2.get("action_id")), "label": str(row2.get("label")), "enabled": true, "step": str(row2.get("step"))})
	var label := "Medium-tank production honesty · 60/80/100 · complete100 %s · units %d · medium_tank_complete=%d · score %.2f" % ["yes" if c100 else "no", int(p100.get("units_projected", 0)), medium_tank_complete, score]
	return {
		"oob": oob, "ready": ready, "p60": p60, "p80": p80, "p100": p100, "unit_sheet": p100,
		"complete_60": c60, "complete_80": c80, "complete_100": c100,
		"medium_tank_complete": medium_tank_complete,
		"recommendation": rec, "day_rows": day_rows, "apply_queue": apply_queue, "actions": actions,
		"score": score, "honesty_score": score, "province_id": province_id,
		"summary": label, "plain": label,
		"bbcode": "%s🛡 Medium honesty[/color] %s— %s[/color]" % [COLOR_HEADER, COLOR_MUTED, label],
		"empty": false,
		"integration": ["medium_tank_production_honesty_product", "medium_honesty_prove_60d", "medium_honesty_prove_80d", "medium_honesty_prove_100d", "major_27", "medium_tank", "production_honesty"],
	}

static func execute_medium_honesty_step(step: String = "prove_60d", province_id: int = 1) -> Dictionary:
	var s := step.strip_edges().to_lower()
	if s.begins_with("medium_honesty_"):
		s = s.replace("medium_honesty_", "")
	if s in ["60", "60d", "prove60", "prove_60"]: s = "prove_60d"
	elif s in ["80", "80d", "prove80", "prove_80"]: s = "prove_80d"
	elif s in ["100", "100d", "prove100", "prove_100"]: s = "prove_100d"
	if s not in ["prove_60d", "prove_80d", "prove_100d"]:
		s = "prove_60d"
	var product: Dictionary = medium_tank_production_honesty_product(province_id)
	var row: Dictionary = {}
	for r in product.get("day_rows", []):
		if r is Dictionary and str(r.get("step")) == s:
			row = r
			break
	var leaf := str(row.get("leaf_action", "apply_production"))
	var action_id := "medium_honesty_prove_60d"
	var hz := 60
	match s:
		"prove_80d":
			action_id = "medium_honesty_prove_80d"
			hz = 80
		"prove_100d":
			action_id = "medium_honesty_prove_100d"
			leaf = "apply_supply"
			hz = 100
	var sc := float(row.get("score", product.get("score", 0.5)))
	var label := "Execute medium honesty %s · leaf %s · score %.2f" % [s, leaf, sc]
	return {"step": s, "leaf_action": leaf, "action_id": action_id, "horizon_days": hz, "ok": true, "score": sc, "province_id": province_id,
		"apply_queue": [{"action_id": leaf, "province_id": province_id, "score": sc, "enabled": true, "label": label, "step": s, "product_action": action_id}],
		"summary": label, "plain": label, "bbcode": "%s🛡 Honesty %s[/color] %s— %s[/color]" % [COLOR_HEADER, s, COLOR_MUTED, label], "empty": false,
		"integration": ["execute_medium_honesty_step", s, leaf]}

