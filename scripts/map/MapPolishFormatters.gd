static func agent_auto_day(
	signals: Array = [],
	available_agents: int = 5,
	network_strength: float = 0.45,
	max_dispatches: int = 3,
	province_id: int = 1,
) -> Dictionary:
	var sigs: Array = signals.duplicate() if signals is Array else []
	if sigs.is_empty():
		sigs = [
			{"active": true, "action_class": "sabotage", "influence": 0.72, "province_id": province_id},
			{"active": true, "action_class": "intel", "influence": 0.58, "province_id": maxi(1, province_id + 1)},
			{"active": true, "action_class": "network", "influence": 0.5, "province_id": maxi(1, province_id + 2)},
		]
	var day: Dictionary = agent_auto_dispatch_day(sigs, available_agents, network_strength, max_dispatches)
	if bool(day.get("empty", false)):
		return {"empty": true, "plain": "", "bbcode": "", "summary": "", "score": 0.0, "apply_queue": [], "actions": []}
	var apply_queue: Array = []
	for q in day.get("dispatch_queue", []):
		if not (q is Dictionary):
			continue
		apply_queue.append({
			"action_id": str(q.get("action_id", "apply_agent_dispatch")),
			"province_id": int(q.get("province_id", province_id)),
			"score": float(q.get("score", 0.5)),
			"enabled": true,
			"label": str(q.get("best_mission", q.get("action_class", "dispatch"))),
		})
	var score := clampf(float(day.get("score", 0.5)), 0.0, 1.0)
	var affinity := float(day.get("affinity", 0.0))
	var q = day.get("quality", {})
	if affinity <= 0.0 and q is Dictionary:
		affinity = float(q.get("affinity", 0.0))
	var label := "Agent auto day · queue %d · score %.2f · affinity %.0f%%" % [
		apply_queue.size(), score, affinity * 100.0
	]
	return {
		"dispatch": day, "score": score, "apply_queue": apply_queue.slice(0, mini(apply_queue.size(), max_dispatches + 1)),
		"actions": [{"action_id": "agent_auto_day", "label": "Run agent auto day", "enabled": not apply_queue.is_empty()}],
		"summary": label, "plain": "%s\n%s" % [label, str(day.get("summary", ""))],
		"bbcode": "%s◈ Agent auto day[/color] %s— %s[/color]" % [COLOR_HEADER, COLOR_MUTED, label],
		"empty": false, "integration": ["agent", "dispatch", "counterplay"],
	}


