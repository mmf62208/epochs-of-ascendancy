static func map_effect_day(
	order: String = "apply_supply",
	province_id: int = 1,
	score: float = 0.65,
) -> Dictionary:
	var o := order.strip_edges()
	if o.is_empty():
		o = "apply_supply"
	var effect: Dictionary = map_effect_resolve(o, province_id, score)
	if bool(effect.get("empty", false)):
		return {"empty": true, "plain": "", "bbcode": "", "summary": "", "score": 0.0, "apply_queue": [], "actions": []}
	var sc := clampf(float(effect.get("score", score)), 0.0, 1.0)
	var aid := o
	var up := o.to_upper()
	if not aid.begins_with("apply_") and aid != "refresh_queue":
		if up.contains("SUPPLY") or up.contains("ROUTE"):
			aid = "apply_supply"
		elif up.contains("ASSAULT") or up.contains("COMBAT") or up.contains("PRESS"):
			aid = "apply_assault"
		elif up.contains("PROD"):
			aid = "apply_production"
		elif up.contains("AGENT") or up.contains("DISPATCH"):
			aid = "apply_agent_dispatch"
		elif up.contains("HH") or up.contains("COMMIT") or up.contains("AGENDA"):
			aid = "apply_hh_commit"
		else:
			aid = "refresh_queue"
	var apply_queue: Array = [
		{"action_id": aid, "province_id": province_id, "score": sc, "enabled": true, "label": "Apply map effect %s" % aid},
	]
	var cls := "ops"
	var eff = effect.get("effect", {})
	if eff is Dictionary:
		cls = str(eff.get("effect_class", "ops"))
	var label := "Map effect day · %s · score %.2f · #%d" % [cls, sc, province_id]
	return {
		"effect": effect, "score": sc, "apply_queue": apply_queue,
		"actions": [{"action_id": "map_effect_day", "label": "Run map effect day", "enabled": true}],
		"summary": label, "plain": "%s\n%s" % [label, str(effect.get("plain", effect.get("summary", "")))],
		"bbcode": "%s★ Map effect day[/color] %s— %s[/color]" % [COLOR_HEADER, COLOR_MUTED, label],
		"empty": false, "integration": ["map_effect", "order", "visual"],
	}


