	var hh: Dictionary = hh_order_commit(trail, 3)
	var tg: Dictionary = compose_fleet_task_group(100.0, "patrol", "contested", 0.0)
	var fb: Dictionary = next_day_mutation_feedback(0.5, 0.7, "command", "apply_supply")
	var ok := bool(gate.get("ok", false))
	var score := 0.35
