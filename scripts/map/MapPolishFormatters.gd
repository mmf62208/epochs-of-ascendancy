## Campaign Alpha primary strip — Phase 1 playability (Tier A)
static func campaign_alpha_primary_strip_product(province_id: int = 1, max_actions: int = 8, max_expanded: int = 1, front_pressure: float = 0.45, occupation_risk: float = 0.35, hh_urgency: float = 0.4, theater_score: float = 0.5, production_need: float = 0.42) -> Dictionary:
	var acts: Array = [
		{"action_id": "apply_station", "label": "Station forces", "key": "1", "domain": "force", "enabled": true},
		{"action_id": "apply_assault", "label": "Assault", "key": "2", "domain": "combat", "enabled": true},
		{"action_id": "apply_production", "label": "Production", "key": "3", "domain": "industry", "enabled": true},
		{"action_id": "day_ops_integrated", "label": "Integrated day ops", "key": "4", "domain": "ops", "enabled": true},
		{"action_id": "theater_command_execute", "label": "Theater execute", "key": "5", "domain": "theater", "enabled": true},
		{"action_id": "hh_month_brief", "label": "HH month brief", "key": "6", "domain": "hh", "enabled": true},
		{"action_id": "occupation_resistance_compliance_product", "label": "Occupation R/C", "key": "7", "domain": "occupation", "enabled": true},
		{"action_id": "save_resume_checkpoint", "label": "Checkpoint save", "key": "8", "domain": "save", "enabled": true},
	]
	var limit := mini(maxi(max_actions, 6), acts.size())
	var actions: Array = []
	for i in range(limit):
		var a: Dictionary = (acts[i] as Dictionary).duplicate(true)
		a["index"] = i
		a["priority"] = 163 - i
		actions.append(a)
	var candidates: Array = [
		{"action_id": "apply_assault", "score": clampf(front_pressure, 0.0, 1.0), "reason": "front pressure", "label": "Assault"},
		{"action_id": "occupation_resistance_compliance_product", "score": clampf(occupation_risk, 0.0, 1.0), "reason": "occupation risk", "label": "Occupation R/C"},
		{"action_id": "hh_month_brief", "score": clampf(hh_urgency, 0.0, 1.0), "reason": "HH agenda urgency", "label": "HH month brief"},
		{"action_id": "theater_command_execute", "score": clampf(theater_score, 0.0, 1.0), "reason": "theater command", "label": "Theater execute"},
		{"action_id": "apply_production", "score": clampf(production_need, 0.0, 1.0), "reason": "production need", "label": "Production"},
		{"action_id": "apply_station", "score": 0.35, "reason": "station forces", "label": "Station forces"},
		{"action_id": "day_ops_integrated", "score": 0.4, "reason": "integrated day ops", "label": "Integrated day ops"},
		{"action_id": "save_resume_checkpoint", "score": 0.28, "reason": "checkpoint habit", "label": "Checkpoint save"},
	]
	var rec: Dictionary = candidates[0]
	for c in candidates:
		if float(c.get("score", 0.0)) > float(rec.get("score", 0.0)):
			rec = c
	rec = {
		"action_id": str(rec.get("action_id")), "label": str(rec.get("label")), "reason": str(rec.get("reason")),
		"score": clampf(float(rec.get("score", 0.5)), 0.35, 1.0), "summary": "Recommend ★ %s · %s" % [str(rec.get("label")), str(rec.get("reason"))], "empty": false,
	}
	var live_ids := {}
	for a in actions:
		live_ids[str(a.get("action_id"))] = true
	var dead: Array = []
	for a in actions:
		var aid := str(a.get("action_id"))
		if not live_ids.has(aid):
			dead.append(aid)
	var audit := {
		"action_ids": live_ids.keys(), "dead": dead, "dead_n": dead.size(), "live_n": actions.size() - dead.size(),
		"ok": dead.is_empty() and actions.size() >= 6,
		"summary": "Primary strip audit · actions %d · dead %d · %s" % [actions.size(), dead.size(), "PASS" if dead.is_empty() else "FAIL"],
		"empty": false,
	}
	var max_exp := mini(maxi(max_expanded, 0), 2)
	var nsec := 24
	var collapsed := maxi(nsec - max_exp, 0)
	var load_sc := clampf(1.0 - 0.6 * (float(collapsed) / float(nsec)), 0.0, 1.0)
	var compact := {
		"max_expanded": max_exp, "section_count": nsec, "expanded_n": max_exp, "collapsed_n": collapsed,
		"cognitive_load": load_sc,
		"summary": "Alpha compact · expanded %d/%d · collapsed %d" % [max_exp, nsec, collapsed], "empty": false,
	}
	var board_score := clampf(0.4 + 0.06 * float(actions.size()), 0.35, 1.0)
	var rec_score := float(rec.get("score", 0.5))
	var audit_score := 1.0 if bool(audit.get("ok")) else 0.2
	var compact_score := clampf(1.0 - load_sc * 0.45, 0.35, 1.0)
	var score := clampf(0.3 * board_score + 0.3 * rec_score + 0.25 * audit_score + 0.15 * compact_score, 0.35, 1.0)
	var day_rows: Array = [
		{"step": "board", "action_id": "campaign_alpha_primary_board", "leaf_action": "apply_station", "label": "Step 0 — primary strip board", "score": board_score, "enabled": true},
		{"step": "recommend", "action_id": "campaign_alpha_recommend_next", "leaf_action": "apply_assault", "label": "★ Step 1 — recommended next", "score": rec_score, "enabled": true, "recommended": true},
		{"step": "audit", "action_id": "campaign_alpha_dead_audit", "leaf_action": "apply_production", "label": "Step 2 — dead-button audit", "score": audit_score, "enabled": true},
	]
	var apply_queue: Array = []
	for r in day_rows:
		apply_queue.append({"action_id": str(r.get("leaf_action")), "province_id": province_id, "score": float(r.get("score", 0.5)), "enabled": true, "label": str(r.get("label")), "step": str(r.get("step")), "product_action": str(r.get("action_id"))})
	var strip_lines: Array = []
	for a in actions:
		strip_lines.append("[%s] %s" % [str(a.get("key", "?")), str(a.get("label", a.get("action_id")))])
	var label := "Campaign Alpha primary · actions %d · dead %d · rec %s · expanded %d · score %.2f" % [actions.size(), int(audit.get("dead_n", 0)), str(rec.get("action_id")), max_exp, score]
	return {
		"actions": actions, "primary_actions": actions, "recommendation": rec, "audit": audit, "compact": compact,
		"day_rows": day_rows, "apply_queue": apply_queue, "strip_lines": strip_lines,
		"max_actions": actions.size(), "max_expanded": max_exp, "dead_n": int(audit.get("dead_n", 0)), "dead_ok": bool(audit.get("ok")),
		"score": score, "province_id": province_id, "summary": label, "plain": label,
		"bbcode": "[color=#7dcea0]★ Alpha strip[/color] [color=#8899aa]%s[/color]" % label,
		"empty": false,
		"integration": ["campaign_alpha_primary_strip_product", "campaign_alpha_primary_board", "campaign_alpha_recommend_next", "campaign_alpha_dead_audit", "campaign_alpha", "primary_strip", "playability", "phase1_alpha"],
		"panel_actions": [
			{"action_id": "campaign_alpha_primary_strip_product", "label": "Run Campaign Alpha primary strip", "enabled": true},
			{"action_id": "campaign_alpha_apply_recommended", "label": "Apply recommended next", "enabled": true},
			{"action_id": "campaign_alpha_primary_board", "label": "Primary strip board", "enabled": true},
			{"action_id": "campaign_alpha_recommend_next", "label": "Refresh recommended next", "enabled": true},
			{"action_id": "campaign_alpha_dead_audit", "label": "Run dead-button audit", "enabled": true},
		],
	}

static func execute_campaign_alpha_step(step: String = "board", province_id: int = 1) -> Dictionary:
	var s := step.strip_edges().to_lower().replace("campaign_alpha_", "")
	if s.begins_with("rec"): s = "recommend"
	elif s.begins_with("aud") or s.begins_with("dead"): s = "audit"
	elif s.begins_with("board") or s.begins_with("primary"): s = "board"
	else: s = "board"
	var leaf := "apply_station"
	var action_id := "campaign_alpha_primary_board"
	match s:
		"recommend":
			leaf = "apply_assault"; action_id = "campaign_alpha_recommend_next"
		"audit":
			leaf = "apply_production"; action_id = "campaign_alpha_dead_audit"
	var product: Dictionary = campaign_alpha_primary_strip_product(province_id)
	var score := float(product.get("score", 0.5))
	var label := "Execute campaign alpha %s · leaf %s · score %.2f" % [s, leaf, score]
	return {
		"step": s, "leaf_action": leaf, "action_id": action_id, "ok": true, "score": score, "province_id": province_id,
		"apply_queue": [{"action_id": leaf, "province_id": province_id, "score": score, "enabled": true, "label": label, "step": s}],
		"summary": label, "plain": label, "empty": false, "integration": ["execute_campaign_alpha_step", s, leaf],
	}

