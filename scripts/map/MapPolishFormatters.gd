	var variance := absf(live - joint)
	var within := variance <= 0.18
	var est_score := joint
	var sample_score := live
	var close_score := clampf(0.55 * sample_score + 0.45 * (1.0 if within else 0.4), 0.35, 1.0)
	var score := clampf(0.3 * est_score + 0.35 * sample_score + 0.35 * close_score, 0.35, 1.0)
