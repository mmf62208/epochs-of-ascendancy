## Air-land joint day package.
static func air_land_joint_day(
	visibility: float = 1.0,
	precip: float = 0.0,
	wind: float = 0.2,
	month: int = 6,
	attacker_power: float = 100.0,
	attacker_supply: float = 0.85,
	province_id: int = 1,
) -> Dictionary:
	var pkg: Dictionary = air_land_joint_package(visibility, precip, wind, month, attacker_power)
	var score := float(pkg.get("score", 0.5))
	if score > 2.0:
		score = clampf(score / 100.0, 0.0, 1.0)
	var air: Dictionary = air_ops_package(visibility, precip, wind, month)
	var grounded := bool(air.get("grounded", false))
	var apply_ready := (not grounded) and score >= 0.3
	var apply_queue: Array = []
	if apply_ready and score >= 0.4:
		apply_queue.append({"action_id": "apply_assault", "province_id": province_id, "score": score, "enabled": true})
	if grounded or visibility < 0.45:
		apply_queue.append({
			"action_id": "apply_focus",
			"province_id": province_id,
			"score": 0.4,
			"focus_id": "military_effort" if grounded else "industrial_effort",
			"enabled": true,
		})
	if attacker_supply < 0.7:
		apply_queue.append({"action_id": "apply_supply", "province_id": province_id, "score": maxf(0.35, 1.0 - attacker_supply), "enabled": true})
	if apply_queue.is_empty():
		apply_queue.append({"action_id": "apply_station", "province_id": province_id, "score": 0.4, "enabled": true})
	var label := "Air-land joint day · score %.2f · %s · supply %.0f%%" % [
		score, "GROUNDED" if grounded else "flyable", attacker_supply * 100.0
	]
	return {
		"package": pkg,
		"grounded": grounded,
		"score": score,
		"apply_ready": apply_ready,
		"apply_queue": apply_queue,
		"actions": [{"action_id": "air_land_joint_day", "label": "Run air-land joint day", "enabled": true}],
		"summary": label,
		"plain": label,
		"bbcode": "%s✈ Air-land joint day[/color] %s— %s[/color]" % [COLOR_HEADER, COLOR_MUTED, label],
		"empty": false,
	}


## Joint campaign day compose.
static func joint_campaign_day(
	visibility: float = 1.0,
	precip: float = 0.0,
	wind: float = 0.2,
	month: int = 6,
	fuel_level: float = 0.55,
	leader_skill: float = 0.65,
	attacker_power: float = 100.0,
	ground_state: String = "dry",
	province_id: int = 1,
) -> Dictionary:
	var naval: Dictionary = naval_campaign_day("port", fuel_level, 100.0, "contested", visibility, precip, province_id)
	var air_land: Dictionary = air_land_joint_day(visibility, precip, wind, month, attacker_power, 0.85, province_id)
	var leader: Dictionary = leader_campaign_assign(leader_skill, ground_state, visibility, false)
	var apply_queue: Array = []
	for block in [naval, air_land]:
		if not (block is Dictionary) or bool(block.get("empty", false)):
			continue
		for q in block.get("apply_queue", []):
			if q is Dictionary and bool(q.get("enabled", true)):
				apply_queue.append(q)
	var l_score := float(leader.get("score", 0.5))
	if l_score > 2.0:
		l_score = clampf(l_score / 100.0, 0.0, 1.0)
	if l_score >= 0.4:
		apply_queue.append({"action_id": "apply_station", "province_id": province_id, "score": minf(1.0, l_score), "enabled": true, "domain": "leader"})
	var seen: Dictionary = {}
	var deduped: Array = []
	for q in apply_queue:
		if not (q is Dictionary):
			continue
		var key := "%s:%d:%s" % [str(q.get("action_id", "")), int(q.get("province_id", -1)), str(q.get("domain", ""))]
		if seen.has(key):
			continue
		seen[key] = true
		deduped.append(q)
	if deduped.size() > 8:
		deduped = deduped.slice(0, 8)
	var s_naval := float(naval.get("score", 0.0))
	var s_air := float(air_land.get("score", 0.0))
	var score: float = (s_naval + s_air + l_score) / 3.0
	var label := "Joint campaign day · naval %.2f · air-land %.2f · leader %.2f · q %d" % [
		s_naval, s_air, l_score, deduped.size()
	]
	return {
		"naval": naval,
		"air_land": air_land,
		"leader": leader,
		"apply_queue": deduped,
		"score": score,
		"actions": [{"action_id": "joint_campaign_day", "label": "Run joint campaign day", "enabled": not deduped.is_empty()}],
		"summary": label,
		"plain": label,
		"bbcode": "%s🎖 Joint campaign day[/color] %s— %s[/color]" % [COLOR_HEADER, COLOR_MUTED, label],
		"empty": false,
	}


## Ground transition day package.
static func ground_transition_day(
	ground_state: String = "dry",
	temp: float = 10.0,
	precip: float = 0.0,
	province_id: int = 1,
) -> Dictionary:
	var ft: Dictionary = freeze_thaw_transition(ground_state, temp, precip)
	var wear: Dictionary = infra_weather_wear(ground_state, precip)
	var changed := bool(ft.get("changed", false))
	var wear_f := float(wear.get("wear_factor", 1.0))
	var crisis: float = (0.55 if changed else 0.15) + maxf(0.0, 1.0 - wear_f) * 0.7
	crisis = clampf(crisis, 0.05, 1.2)
	var apply_queue: Array = []
	if changed or wear_f < 0.92:
		apply_queue.append({"action_id": "apply_station", "province_id": province_id, "score": maxf(0.35, crisis), "enabled": true})
	if wear_f < 0.9 or precip > 0.45:
		apply_queue.append({"action_id": "apply_supply", "province_id": province_id, "score": maxf(0.35, 1.0 - wear_f + precip * 0.2), "enabled": true})
	var note := str(ft.get("note", ""))
	if changed and note in ["thaw", "freeze-in", "snowfall"]:
		apply_queue.append({"action_id": "apply_focus", "province_id": province_id, "score": 0.4, "focus_id": "industrial_effort", "enabled": true})
	if apply_queue.is_empty():
		apply_queue.append({"action_id": "apply_supply", "province_id": province_id, "score": 0.35, "enabled": true})
	var label := "Ground transition day · %s · wear×%.2f · crisis %.2f" % [str(ft.get("summary", "ground")), wear_f, crisis]
	return {
		"freeze_thaw": ft,
		"wear": wear,
		"changed": changed,
		"wear_factor": wear_f,
		"score": crisis,
		"apply_ready": true,
		"apply_queue": apply_queue,
		"actions": [{"action_id": "ground_transition_day", "label": "Run ground transition day", "enabled": true}],
		"summary": label,
		"plain": label,
		"bbcode": "%s❄ Ground transition day[/color] %s— %s[/color]" % [COLOR_HEADER, COLOR_MUTED, label],
		"empty": false,
	}


## Fog/air crisis day package.
static func fog_air_crisis_day(
	visibility: float = 1.0,
	precip: float = 0.0,
	wind: float = 0.2,
	province_id: int = 1,
) -> Dictionary:
	var fog: Dictionary = coastal_fog_naval_gate(visibility, precip)
	var air: Dictionary = air_grounding_alert(visibility, precip, wind)
	var fog_on := bool(fog.get("fog", false))
	var grounded := bool(air.get("grounded", false))
	var air_empty := bool(air.get("empty", true)) and not grounded
	var ops := float(fog.get("ops_mult", 1.0))
	var eff := float(air.get("effectiveness", 1.0))
	var crisis: float
	if not air_empty:
		crisis = (0.5 if fog_on else 0.15) + (0.45 if grounded else maxf(0.0, 0.5 - eff) * 0.5)
	else:
		crisis = 0.45 if fog_on else 0.1
	crisis = clampf(crisis, 0.05, 1.2)
	var apply_queue: Array = []
	if fog_on:
		apply_queue.append({"action_id": "fleet_autonomy", "province_id": province_id, "score": maxf(0.4, 1.0 - ops), "enabled": true, "order": "hold"})
		apply_queue.append({"action_id": "apply_supply", "province_id": province_id, "score": maxf(0.35, 1.0 - ops), "enabled": true})
	if grounded or (not air_empty and eff < 0.5):
		apply_queue.append({"action_id": "apply_focus", "province_id": province_id, "score": 0.45, "focus_id": "military_effort", "enabled": true})
	if apply_queue.is_empty():
		apply_queue.append({"action_id": "apply_station", "province_id": province_id, "score": 0.35, "enabled": true})
	var label := "Fog/air crisis day · fog=%s · grounded=%s · ops×%.2f · crisis %.2f" % [
		"yes" if fog_on else "no", "yes" if grounded else "no", ops, crisis
	]
	return {
		"fog": fog,
		"air": air,
		"fog_closed": fog_on,
		"grounded": grounded,
		"score": crisis,
		"apply_ready": true,
		"apply_queue": apply_queue,
		"actions": [{"action_id": "fog_air_crisis_day", "label": "Run fog/air crisis day", "enabled": true}],
		"summary": label,
		"plain": label,
		"bbcode": "%s🌫 Fog/air crisis day[/color] %s— %s[/color]" % [COLOR_WARN, COLOR_MUTED, label],
		"empty": false,
	}


## Weather crisis day compose.
static func weather_crisis_day(
	visibility: float = 1.0,
	precip: float = 0.0,
	temp: float = 10.0,
	ground_state: String = "dry",
	wind: float = 0.2,
	province_id: int = 1,
) -> Dictionary:
	var ground: Dictionary = ground_transition_day(ground_state, temp, precip, province_id)
	var fog_air: Dictionary = fog_air_crisis_day(visibility, precip, wind, province_id)
	var pressure: Dictionary = weather_pressure_index(visibility, precip, ground_state, wind)
	var p := float(pressure.get("pressure", 0.2))
	var apply_queue: Array = []
	for block in [ground, fog_air]:
		if not (block is Dictionary) or bool(block.get("empty", false)):
			continue
		for q in block.get("apply_queue", []):
			if q is Dictionary and bool(q.get("enabled", true)):
				apply_queue.append(q)
	if p >= 0.55:
		apply_queue.append({"action_id": "apply_supply", "province_id": province_id, "score": p, "enabled": true, "domain": "pressure"})
	var seen: Dictionary = {}
	var deduped: Array = []
	for q in apply_queue:
		if not (q is Dictionary):
			continue
		var key := "%s:%d:%s:%s" % [str(q.get("action_id", "")), int(q.get("province_id", -1)), str(q.get("domain", "")), str(q.get("focus_id", ""))]
		if seen.has(key):
			continue
		seen[key] = true
		deduped.append(q)
	if deduped.size() > 8:
		deduped = deduped.slice(0, 8)
	var s_g := float(ground.get("score", 0.0))
	var s_f := float(fog_air.get("score", 0.0))
	var score: float = (s_g + s_f + p) / 3.0
	var label := "Weather crisis day · ground %.2f · fog/air %.2f · pressure %.2f · q %d" % [
		s_g, s_f, p, deduped.size()
	]
	return {
		"ground": ground,
		"fog_air": fog_air,
		"pressure": pressure,
		"apply_queue": deduped,
		"score": score,
		"actions": [{"action_id": "weather_crisis_day", "label": "Run weather crisis day", "enabled": not deduped.is_empty()}],
		"summary": label,
		"plain": label,
		"bbcode": "%s⛈ Weather crisis day[/color] %s— %s[/color]" % [COLOR_WARN, COLOR_MUTED, label],
		"empty": false,
	}


