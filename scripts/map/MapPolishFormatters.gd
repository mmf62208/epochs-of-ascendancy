static func war_path_urgency(
	focus_id: String = "industrial_effort",
	focus_base: float = 50.0,
	trail: Array = [],
	visibility: float = 1.0,
	precip: float = 0.0,
) -> Dictionary:
	var focus: Dictionary = focus_weather_aware_score(focus_base, focus_id, visibility, precip)
	var pick := agenda_execute_pick_from_trail(trail, 3)
