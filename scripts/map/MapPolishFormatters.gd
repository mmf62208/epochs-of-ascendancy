static func force_supply_posture(force_strength: float = 50.0, supply_health: float = 1.0, visibility: float = 1.0, precip: float = 0.0, ground_state: String = "dry", wind: float = 0.2) -> Dictionary:
	var force := maxf(0.0, force_strength)
	var supply := clampf(supply_health, 0.15, 1.5)
	var pressure: Dictionary = weather_pressure_index(visibility, precip, ground_state, wind)
	var posture := clampf((force / 100.0) * supply * (1.0 - float(pressure.get("pressure", 0.0)) * 0.35), 0.05, 1.5)
	var label := "Force×supply · posture ×%.2f (force %.0f · supply ×%.2f)" % [posture, force, supply]
	return {
		"posture": posture,
		"summary": label,
		"bbcode": "%s🛡 Force×supply[/color] %s— %s[/color]" % [COLOR_TECH, COLOR_MUTED, label],
		"empty": false,
		"integration": ["force", "supply", "weather"],
	}


static func leader_weather_assign(leader_skill: float = 0.5, ground_state: String = "dry", visibility: float = 1.0, armored: bool = false) -> Dictionary:
	var skill := clampf(leader_skill, 0.1, 1.5)
	var move_m := weather_move_multiplier(ground_state, visibility, armored)
	var effective := clampf(move_m * (0.85 + 0.3 * skill), 0.15, 1.6)
	var label := "Leader×wx · move ×%.2f (skill %.2f · wx ×%.2f)" % [effective, skill, move_m]
	return {
		"effective_move": effective,
