static func map_effect_resolve(
	order: String = "",
	province_id: int = -1,
	score: float = 0.5,
) -> Dictionary:
	var o := order.strip_edges()
	if o.is_empty():
		return {"empty": true, "plain": "", "bbcode": "", "summary": "", "score": 0.0}
	var strength := clampf(score, 0.15, 1.0)
	var cls := "ops"
	var marker := "★"
	var up := o.to_upper()
	if up.contains("FLEET") or up.contains("DEPLOY"):
		cls = "naval"
		marker = "⚓"
	elif up.contains("COMBAT") or up.contains("PRESS") or up.contains("SOFTEN") or up.contains("HOLD"):
		cls = "combat"
		marker = "⚔"
	elif up.contains("DISPATCH") or up.contains("NETWORK"):
		cls = "intel"
		marker = "◈"
	elif up.contains("COMMIT") or up.contains("AGENDA"):
		cls = "agenda"
		marker = "📜"
	elif up.contains("PROD") or up.contains("LINE"):
		cls = "industry"
		marker = "🏭"
	elif up.contains("SUPPLY") or up.contains("ROUTE"):
		cls = "supply"
		marker = "📦"
	var label := "Map effect · %s %s ×%.0f%% @#%d" % [marker, cls, strength * 100.0, province_id]
	return {
		"effect": {
			"province_id": province_id,
			"effect_class": cls,
			"marker": marker,
			"strength": strength,
			"order": o,
			"active": true,
		},
		"score": strength,
		"summary": label,
		"plain": "%s\n%s" % [label, o],
		"bbcode": "%s%s Map effect[/color] %s— %s[/color]" % [COLOR_HEADER, marker, COLOR_MUTED, label],
		"empty": false,
		"integration": ["order", "map_effect"],
	}


static func next_day_feedback(
	before_score: float = 0.5,
	after_score: float = 0.55,
	order: String = "",
) -> Dictionary:
	var delta := after_score - before_score
	var trend := "improved" if delta > 0.02 else ("worsened" if delta < -0.02 else "steady")
	var label := "Next-day feedback · %s · Δ%+.2f (%.2f→%.2f)" % [trend, delta, before_score, after_score]
	var plain := label
	if not order.strip_edges().is_empty():
		plain = "%s\nafter: %s" % [label, order.split("\n")[0]]
	return {
		"before": before_score,
		"after": after_score,
		"delta": delta,
		"trend": trend,
		"order": order,
		"summary": label,
		"plain": plain,
		"bbcode": "%s↻ Next-day[/color] %s— %s[/color]" % [COLOR_HEADER, COLOR_MUTED, label],
		"empty": false,
		"integration": ["execute", "feedback"],
	}


static func production_order_resolve(
	temp: float = 10.0,
	precip: float = 0.0,
	ground_state: String = "dry",
	visibility: float = 1.0,
	wind: float = 0.2,
	base_output: float = 1.0,
	line_id: String = "primary",
) -> Dictionary:
	var risk_board: Dictionary = production_campaign_risk(temp, precip, ground_state, visibility, wind, base_output)
	var r := float(risk_board.get("risk", risk_board.get("score", 0.0)))
	var priority := "SURGE"
	if r >= 0.35:
		priority = "SHIELD"
	elif r >= 0.15:
		priority = "MONITOR"
	var order := "PROD LINE %s PRIORITY %s risk=%.0f%%" % [line_id, priority, r * 100.0]
	var label := "Production order · %s · risk %.2f" % [priority, r]
	return {
		"order": order,
		"priority": priority,
		"risk": r,
		"score": 1.0 - r,
		"summary": label,
		"plain": "%s\n%s" % [order, label],
		"bbcode": "%s🏭 Prod order[/color] %s— %s[/color]" % [COLOR_HEADER, COLOR_MUTED, order],
		"empty": false,
		"sole_mult": true,
		"integration": ["production_campaign", "order"],
	}


