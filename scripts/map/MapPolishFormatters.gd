static func occupation_control_product(province_id: int = 1) -> Dictionary:
	var theater: Dictionary = theater_command_product(province_id)
	var front: Dictionary = front_continuity_campaign_product(province_id)
	var agent: Dictionary = agent_campaign_product([], 5, 0.35, 0.5, province_id)
	var economy: Dictionary = war_economy_mobilization_product(province_id)
	var ready: Dictionary = force_readiness_day(80.0, 0.85, 0.7, 0.3, "mud", 0.3, 6, 80.0, province_id)
	var control_score := clampf(0.55 * float(theater.get("score", 0.5)) + 0.45 * float(agent.get("score", 0.5)), 0.0, 1.0)
	if control_score < 0.35: control_score = 0.35
	var garrison_score := clampf(0.5 * float(front.get("score", 0.5)) + 0.5 * float(ready.get("score", 0.5)), 0.0, 1.0)
	if garrison_score < 0.35: garrison_score = 0.35
	var integrate_score := clampf(0.5 * control_score + 0.5 * float(economy.get("score", 0.5)), 0.0, 1.0)
	if integrate_score < 0.35: integrate_score = 0.35
	var score := clampf(0.35 * control_score + 0.35 * garrison_score + 0.3 * integrate_score, 0.0, 1.0)
	if score < 0.35: score = 0.35
	var rec: Dictionary = recommend_occupation_step(control_score, garrison_score, control_score >= 0.45 and garrison_score >= 0.45)
	var steps: Array = [
		{"step": "control", "action_id": "occupation_control_board", "leaf": "apply_station", "label": "Step 0 — occupation control board", "score": control_score},
		{"step": "garrison", "action_id": "occupation_control_garrison", "leaf": "apply_assault", "label": "Step 1 — garrison/secure", "score": garrison_score},
		{"step": "integrate", "action_id": "occupation_control_integrate", "leaf": "apply_production", "label": "Step 2 — integrate economy/front", "score": integrate_score},
	]
	var day_rows: Array = []
	var apply_queue: Array = []
	for i in range(steps.size()):
		var st: Dictionary = steps[i]
		var step_name := str(st.get("step"))
		var recommended: bool = step_name == str(rec.get("step"))
		var sc := float(st.get("score", 0.5))
		var leaf := str(st.get("leaf"))
		var lab := str(st.get("label"))
		if recommended: lab = "★ " + lab
		lab = "%s · score %.2f" % [lab, sc]
		day_rows.append({"index": i, "step": step_name, "action_id": str(st.get("action_id")), "leaf_action": leaf, "label": lab, "score": sc, "enabled": true, "recommended": recommended, "province_id": province_id})
		apply_queue.append({"action_id": leaf, "province_id": province_id, "score": sc, "enabled": true, "label": lab, "step": step_name, "product_action": str(st.get("action_id"))})
	var actions: Array = [
		{"action_id": "occupation_control_product", "label": "Run occupation control product", "enabled": true},
		{"action_id": str(rec.get("action_id", "occupation_control_board")), "label": "Recommended: %s" % str(rec.get("step", "control")), "enabled": true},
	]
	for row2 in day_rows:
		actions.append({"action_id": str(row2.get("action_id")), "label": str(row2.get("label")), "enabled": true, "step": str(row2.get("step"))})
	var label := "Occupation control · control %.2f · garrison %.2f · integrate %.2f · score %.2f" % [control_score, garrison_score, integrate_score, score]
	return {
		"recommendation": rec, "day_rows": day_rows, "apply_queue": apply_queue, "actions": actions,
		"control_score": control_score, "garrison_score": garrison_score, "integrate_score": integrate_score,
		"score": score, "occupation_score": score, "province_id": province_id,
		"summary": label, "plain": label,
		"bbcode": "%s🏛 Occupation[/color] %s— %s[/color]" % [COLOR_HEADER, COLOR_MUTED, label],
		"empty": false,
		"integration": ["occupation_control_product", "occupation_control_board", "occupation_control_garrison", "occupation_control_integrate", "major_24", "occupation", "control"],
	}

static func execute_occupation_step(step: String = "control", province_id: int = 1) -> Dictionary:
	var s := step.strip_edges().to_lower()
	if s.begins_with("occupation_control_"):
		s = s.replace("occupation_control_", "")
	if s not in ["control", "garrison", "integrate"]:
		s = "control"
	var product: Dictionary = occupation_control_product(province_id)
	var row: Dictionary = {}
	for r in product.get("day_rows", []):
