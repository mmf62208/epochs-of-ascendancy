static func historical_oob_content_product(province_id: int = 1) -> Dictionary:
	var majors: Array = ["GER", "FRA", "ENG", "USA", "SOV", "ITA", "JAP"]
	var designs := {
		"GER": ["panzer_iii_j_medium", "infantry_k98_bolt_action"],
		"FRA": ["somua_s35_medium", "infantry_k98_bolt_action"],
		"ENG": ["m4_sherman_medium_tank", "infantry_m1_garand"],
		"USA": ["m4_sherman_medium_tank", "infantry_m1_garand"],
		"SOV": ["t34_medium_tank", "infantry_k98_bolt_action"],
		"ITA": ["cv33_tankette", "infantry_k98_bolt_action"],
		"JAP": ["jap_armor_1936", "infantry_k98_bolt_action"],
	}
	var line_n := 0
	for t in majors:
		line_n += (designs.get(t, []) as Array).size() if designs.has(t) else 1
	var coverage := clampf(float(majors.size()) / 7.0, 0.35, 1.0)
	var catalog_score := clampf(0.45 + 0.5 * coverage, 0.35, 1.0)
	var seed_score := clampf(0.45 + 0.04 * float(mini(line_n, 14)), 0.35, 1.0)
	var equip_score := clampf(0.5 * seed_score + 0.5 * catalog_score, 0.35, 1.0)
	var score := clampf(0.3 * catalog_score + 0.35 * seed_score + 0.35 * equip_score, 0.35, 1.0)
	var rec := {"step": "equip", "action_id": "historical_oob_equip", "leaf": "apply_station", "summary": "Recommend equip", "empty": false}
	var day_rows: Array = [
		{"step": "catalog", "action_id": "historical_oob_catalog", "leaf": "apply_focus", "label": "Step 0 — historical OOB catalog", "score": catalog_score},
		{"step": "seed", "action_id": "historical_oob_seed", "leaf": "apply_production", "label": "Step 1 — seed national production lines", "score": seed_score},
		{"step": "equip", "action_id": "historical_oob_equip", "leaf": "apply_station", "label": "Step 2 — equip land formations", "score": equip_score},
	]
	var apply_queue: Array = []
	for row in day_rows:
		apply_queue.append({"action_id": str(row.get("leaf")), "province_id": province_id, "score": float(row.get("score", 0.5)), "enabled": true, "label": str(row.get("label")), "step": str(row.get("step")), "product_action": str(row.get("action_id"))})
	var label := "Historical OOB content · majors %d · lines %d · score %.2f" % [majors.size(), line_n, score]
	return {
		"recommendation": rec, "day_rows": day_rows, "apply_queue": apply_queue,
		"actions": [{"action_id": "historical_oob_content_product", "label": "Run historical OOB content product", "enabled": true}, {"action_id": "historical_oob_equip", "label": "Recommended: equip", "enabled": true}],
		"major_n": majors.size(), "line_n": line_n, "coverage": coverage, "score": score, "oob_score": score, "province_id": province_id,
		"summary": label, "plain": label, "bbcode": "[color=#c8a060]📋 Historical OOB[/color] [color=#8899aa]%s[/color]" % label,
		"empty": false, "integration": ["historical_oob_content_product", "historical_oob_catalog", "historical_oob_seed", "historical_oob_equip", "major_38", "phase5_depth"],
	}

static func execute_historical_oob_step(step: String = "catalog", province_id: int = 1) -> Dictionary:
	var s := step.strip_edges().to_lower().replace("historical_oob_", "")
	if s.begins_with("catalog"): s = "catalog"
	elif s.begins_with("seed"): s = "seed"
	elif s.begins_with("equip"): s = "equip"
	else: s = "catalog"
	var product: Dictionary = historical_oob_content_product(province_id)
	var leaf := "apply_focus"
	var action_id := "historical_oob_catalog"
