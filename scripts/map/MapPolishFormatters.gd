## ---------------------------------------------------------------------------
## Multi-phase combat product surface (major #1) — interactive ribbon + per-phase apply
## Composes estimate_multi_phase_combat + multi_phase_combat_ui_product (not score stubs).
## ---------------------------------------------------------------------------

static func recommend_combat_phase_step(overall: float, engage_win: float = 0.5, approach_win: float = 0.5) -> Dictionary:
	var o := clampf(overall, 0.0, 1.0)
	var eng := clampf(engage_win, 0.0, 1.0)
	var app := clampf(approach_win, 0.0, 1.0)
	var step := "hold"
	var phase := "approach"
	var action_id := "phase_approach"
	var reason := "hold tempo — prep approach"
	if o >= 0.55 and eng >= 0.5:
		step = "press"
		phase = "engage"
		action_id = "phase_engage"
		reason = "overall favorable — press engage"
	elif o >= 0.4 and app < 0.45:
		step = "soften"
		phase = "approach"
		action_id = "phase_approach"
		reason = "marginal — approach/soften first"
	elif o < 0.35 or eng < 0.35:
		step = "disengage"
		phase = "disengage"
		action_id = "phase_disengage"
		reason = "unfavorable — disengage / hold"
	return {
		"step": step, "phase": phase, "action_id": action_id, "reason": reason,
		"overall": o, "engage_win": eng, "approach_win": app, "empty": false,
		"summary": "Recommend %s · %s · overall %.0f%%" % [step, phase, o * 100.0],
	}

static func multi_phase_combat_product(
	attacker_power: float = 100.0,
	defender_power: float = 80.0,
	attacker_supply: float = 0.85,
	weather_mult: float = 1.0,
	province_id: int = 1,
) -> Dictionary:
	var wmult := clampf(weather_mult, 0.2, 1.2)
	var ui: Dictionary = multi_phase_combat_ui_product(attacker_power, defender_power, attacker_supply, wmult, province_id)
	var est: Dictionary = estimate_multi_phase_combat(attacker_power, defender_power, attacker_supply, wmult)
	var overall := float(est.get("overall_attacker_win_chance", ui.get("overall", 0.0)))
	var engage_win := float(est.get("engage_win_chance", 0.5))
	var approach_win := float(est.get("approach_win_chance", 0.5))
	var rec: Dictionary = recommend_combat_phase_step(overall, engage_win, approach_win)
	var phase_actions: Array = []
	var apply_queue: Array = []
	var phases: Array = est.get("phases", [])
	var leaf_map := {
		"approach": {"action_id": "phase_approach", "leaf": "apply_supply", "label": "Approach — soften / supply prep"},
		"engage": {"action_id": "phase_engage", "leaf": "apply_assault", "label": "Engage — stage multi-phase assault"},
		"disengage": {"action_id": "phase_disengage", "leaf": "apply_station", "label": "Disengage — hold / extract"},
	}
	for i in range(phases.size()):
		var r: Dictionary = phases[i] if phases[i] is Dictionary else {}
		var phase := str(r.get("phase", "engage")).to_lower()
		var meta: Dictionary = leaf_map.get(phase, leaf_map["engage"])
		var win := float(r.get("attacker_win_chance", 0.0))
		var recommended := phase == str(rec.get("phase", ""))
		var label := str(meta.get("label", phase))
		if recommended:
			label = "★ " + label
		label = "%s · win %.0f%%" % [label, win * 100.0]
		var enabled := win >= 0.25 or phase == "disengage"
		var row := {
			"index": i, "phase": phase, "win_chance": win,
			"attacker_effective": float(r.get("attacker_effective", 0.0)),
			"defender_effective": float(r.get("defender_effective", 0.0)),
			"action_id": str(meta.get("action_id", "phase_engage")),
			"leaf_action": str(meta.get("leaf", "apply_assault")),
			"label": label, "enabled": enabled, "recommended": recommended,
			"province_id": province_id, "score": win,
		}
		phase_actions.append(row)
		apply_queue.append({
			"action_id": str(meta.get("leaf", "apply_assault")),
			"province_id": province_id, "score": win, "enabled": enabled,
			"label": label, "phase": phase, "product_action": str(meta.get("action_id", "")),
		})
	var apply_ready := overall >= 0.35 and attacker_power > 0.0
	var score := clampf(overall * (0.85 + 0.15 * wmult), 0.0, 1.0)
	var ribbon := str(ui.get("ribbon", format_combat_phase_ribbon_plain(attacker_power, defender_power, attacker_supply, wmult)))
	var label_out := "Multi-phase product · %d phases · overall %.0f%% · %s · wx×%.2f · #%d" % [
		phase_actions.size(), overall * 100.0, str(rec.get("step", "hold")), wmult, province_id
	]
	var plain_lines: PackedStringArray = [label_out, str(rec.get("summary", "")), ribbon]
	for row2 in phase_actions:
		plain_lines.append(str(row2.get("label", "")))
	var actions: Array = [
		{"action_id": "multi_phase_combat_product", "label": "Run multi-phase combat product", "enabled": true},
		{"action_id": str(rec.get("action_id", "phase_engage")), "label": "Recommended: %s" % str(rec.get("step", "hold")), "enabled": apply_ready or str(rec.get("step")) == "disengage"},
	]
	for row3 in phase_actions:
		actions.append({"action_id": str(row3.get("action_id", "")), "label": str(row3.get("label", "")), "enabled": bool(row3.get("enabled", true)), "phase": str(row3.get("phase", ""))})
	return {
		"ui": ui, "estimate": est, "ribbon": ribbon, "recommendation": rec,
		"phase_actions": phase_actions, "phase_rows": phase_actions, "phase_count": phase_actions.size(),
		"apply_queue": apply_queue, "overall": overall, "weather_mult": wmult,
		"attacker_power": attacker_power, "defender_power": defender_power, "attacker_supply": attacker_supply,
		"province_id": province_id, "score": score, "apply_ready": apply_ready,
		"follow_on": str(rec.get("step", "hold")), "actions": actions,
		"summary": label_out, "plain": "\n".join(plain_lines),
		"bbcode": "%s⚔ Multi-phase product[/color] %s— %s[/color]" % [COLOR_HEADER, COLOR_MUTED, label_out],
		"empty": phase_actions.is_empty(),
		"integration": ["multi_phase_combat_product", "phase_approach", "phase_engage", "phase_disengage", "major_1"],
	}

static func execute_combat_phase_plan(
	phase: String = "engage",
	province_id: int = 1,
	attacker_power: float = 100.0,
	defender_power: float = 80.0,
	attacker_supply: float = 0.85,
	weather_mult: float = 1.0,
) -> Dictionary:
	var p := phase.strip_edges().to_lower()
	if p not in ["approach", "engage", "disengage"]:
		p = "engage"
	var est: Dictionary = estimate_multi_phase_combat(attacker_power, defender_power, attacker_supply, weather_mult)
	var phases: Array = est.get("phases", [])
	var phase_est: Dictionary = {}
	for r in phases:
		if r is Dictionary and str(r.get("phase", "")).to_lower() == p:
			phase_est = r
			break
	if phase_est.is_empty() and not phases.is_empty() and phases[0] is Dictionary:
		phase_est = phases[0]
	var win := float(phase_est.get("attacker_win_chance", 0.5))
	var leaf := "apply_assault"
	var action_id := "phase_engage"
	var lab := "Engage — stage multi-phase assault"
	match p:
		"approach":
			leaf = "apply_supply"
			action_id = "phase_approach"
			lab = "Approach — soften / supply prep"
		"disengage":
			leaf = "apply_station"
			action_id = "phase_disengage"
			lab = "Disengage — hold / extract"
	var enabled := win >= 0.25 or p == "disengage"
	var apply_queue: Array = [{
		"action_id": leaf, "province_id": province_id, "score": win, "enabled": enabled,
		"label": lab, "phase": p, "product_action": action_id,
	}]
	var label := "Execute %s · win %.0f%% · leaf %s · #%d" % [p, win * 100.0, leaf, province_id]
	return {
		"phase": p, "estimate": phase_est, "leaf_action": leaf, "action_id": action_id,
		"apply_queue": apply_queue, "score": win, "enabled": enabled, "province_id": province_id,
		"summary": label, "plain": label,
		"bbcode": "%s⚔ Phase %s[/color] %s— %s[/color]" % [COLOR_HEADER, p, COLOR_MUTED, label],
		"empty": false, "ok": enabled,
		"integration": ["execute_combat_phase", p, leaf],
	}

## ---------------------------------------------------------------------------
## Fleet multi-day autonomy product (major #2) — posture → escort → follow-through
## Composes fleet_autonomy_plan + task/fuel/order/sealane helpers (not score stubs).
## ---------------------------------------------------------------------------

static func recommend_fleet_multi_day_step(fuel_level: float, autonomy_score: float, escort_need: float = 0.0, apply_ready: bool = true) -> Dictionary:
	var fuel := clampf(fuel_level, 0.0, 1.2)
	var score := clampf(autonomy_score, 0.0, 1.0)
	var step := "posture"
	var action_id := "fleet_day_posture"
	var leaf := "apply_station"
	var reason := "set posture/tasking first"
	if fuel < 0.35:
		step = "station_escort"
		action_id = "fleet_day_station_escort"
		leaf = "apply_supply"
		reason = "fuel low — station/refuel + escort sustain"
	elif escort_need >= 50.0 or (not apply_ready and fuel < 0.5):
		step = "station_escort"
		action_id = "fleet_day_station_escort"
		leaf = "apply_supply"
		reason = "escort pressure — convoy/screen day"
	elif score >= 0.55 and apply_ready:
		step = "follow_through"
		action_id = "fleet_day_follow_through"
		leaf = "apply_station"
		reason = "autonomy ready — multi-day follow-through"
	return {
		"step": step, "action_id": action_id, "leaf": leaf, "reason": reason,
		"fuel_level": fuel, "autonomy_score": score, "empty": false,
		"summary": "Recommend %s · %s" % [step, reason],
	}

static func fleet_multi_day_autonomy_product(
	fuel_level: float = 0.65,
	basing_level: String = "port",
	zone_relation: String = "contested",
	available_strength: float = 100.0,
	country_tag: String = "GER",
	province_id: int = 1,
	zone_count: int = 3,
) -> Dictionary:
	var fuel := clampf(fuel_level, 0.05, 1.2)
	var autonomy: Dictionary = fleet_autonomy_plan(zone_count, fuel, basing_level, zone_relation, available_strength, country_tag)
	var fuel_log: Dictionary = basing_fleet_fuel_logistics(basing_level, fuel, available_strength, zone_relation, "patrol", 0.7, 0.3)
	var task: Dictionary = compose_fleet_task_group(available_strength, "patrol", zone_relation, 0.35 if zone_relation != "friendly" else 0.1)
	var fleet_order: Dictionary = fleet_order_execute(basing_level, fuel, available_strength, zone_relation, 0.7, 0.3)
	var naval: Dictionary = naval_order_package(basing_level, fuel, available_strength, zone_relation, 0.7, 0.3)
	var fwx: Dictionary = fleet_weather_mission_package("patrol", available_strength, zone_relation, 0.3, 0.7, 0.3)
	var inputs: Array = []
	for i in range(maxi(1, zone_count)):
		inputs.append({"province_id": province_id + i, "fuel_level": fuel, "basing_level": basing_level})
	var posture: Dictionary = plan_fleet_theater_posture(inputs)
	var sealane: Dictionary = sealane_joint_health(1.0, 0.7, false, "mud", 0.3)
	var auto_score := float(autonomy.get("score", 0.55))
	if auto_score <= 0.0 and not bool(autonomy.get("empty", false)):
		auto_score = 0.55
	var logistics := float(fuel_log.get("logistics_score", 0.2))
	var order_score := float(fleet_order.get("score", naval.get("score", 0.5)))
	var sealane_score := float(sealane.get("score", 0.4))
	var score := clampf(0.35 * auto_score + 0.2 * order_score + 0.2 * maxf(0.35, logistics) + 0.15 * sealane_score + 0.1 * (0.6 if not bool(task.get("empty", false)) else 0.3), 0.0, 1.0)
	if score < 0.35:
		score = 0.35
	var escort_need := 70.0 if zone_relation != "friendly" else 20.0
	var rec: Dictionary = recommend_fleet_multi_day_step(fuel, auto_score, escort_need, bool(autonomy.get("apply_ready", true)))
	var day_rows: Array = []
	var apply_queue: Array = []
	var steps: Array = [
		{"step": "posture", "action_id": "fleet_day_posture", "leaf": "apply_station", "label": "Day 0 — set theater posture / tasking", "step_score": maxf(0.35, auto_score)},
		{"step": "station_escort", "action_id": "fleet_day_station_escort", "leaf": "apply_supply", "label": "Day 1 — station + escort sustain", "step_score": clampf(0.5 * maxf(0.35, logistics) + 0.5 * sealane_score, 0.35, 1.0)},
		{"step": "follow_through", "action_id": "fleet_day_follow_through", "leaf": "apply_station", "label": "Day 2 — multi-day follow-through", "step_score": clampf(0.5 * order_score + 0.5 * score, 0.35, 1.0)},
	]
	for i in range(steps.size()):
		var st: Dictionary = steps[i]
		var recommended := str(st.get("step")) == str(rec.get("step"))
		var lab := str(st.get("label"))
		if recommended:
			lab = "★ " + lab
		lab = "%s · score %.2f" % [lab, float(st.get("step_score", score))]
		var row := {
			"index": i, "day": i, "step": str(st.get("step")), "action_id": str(st.get("action_id")),
			"leaf_action": str(st.get("leaf")), "label": lab, "score": float(st.get("step_score", score)),
			"enabled": true, "recommended": recommended, "province_id": province_id,
		}
		day_rows.append(row)
		apply_queue.append({
			"action_id": str(st.get("leaf")), "province_id": province_id, "score": float(st.get("step_score", score)),
			"enabled": true, "label": lab, "step": str(st.get("step")), "product_action": str(st.get("action_id")),
		})
	var chosen := str(autonomy.get("chosen_order", "SEARCH_PATROL"))
	var posture_name := str(autonomy.get("chosen_posture", posture.get("dominant_posture", task.get("primary_role", "PATROL"))))
	var strip: Dictionary = execution_decision_strip([
		"fleet posture %s" % chosen, "escort sustain", "multi-day follow-through"
	])
	var actions: Array = [
		{"action_id": "fleet_multi_day_autonomy_product", "label": "Run fleet multi-day autonomy product", "enabled": true},
		{"action_id": str(rec.get("action_id", "fleet_day_posture")), "label": "Recommended: %s" % str(rec.get("step", "posture")), "enabled": true},
	]
	for row2 in day_rows:
		actions.append({"action_id": str(row2.get("action_id")), "label": str(row2.get("label")), "enabled": true, "step": str(row2.get("step"))})
	var label := "Fleet multi-day autonomy · %s · posture %s · fuel %.0f%% · score %.2f · %s" % [
		chosen, posture_name, fuel * 100.0, score, country_tag
	]
	var plain_lines: PackedStringArray = [label, str(rec.get("summary", "")), "order %s · primary %s" % [chosen, str(task.get("primary_role", "?"))]]
	for row3 in day_rows:
		plain_lines.append(str(row3.get("label", "")))
	return {
		"autonomy": autonomy, "fuel": fuel_log, "task_group": task, "fleet_order": fleet_order, "naval_order": naval,
		"weather_mission": fwx, "posture": posture, "sealane": sealane, "decision_strip": strip,
		"recommendation": rec, "day_rows": day_rows, "day_count": day_rows.size(), "apply_queue": apply_queue,
		"province_id": province_id, "fuel_level": fuel, "chosen_order": chosen, "chosen_posture": posture_name,
		"score": score, "fleet_score": score, "apply_ready": bool(autonomy.get("apply_ready", true)),
		"actions": actions, "summary": label, "plain": "\n".join(plain_lines),
		"bbcode": "%s🚢 Fleet multi-day autonomy[/color] %s— %s[/color]" % [COLOR_HEADER, COLOR_MUTED, label],
		"empty": bool(autonomy.get("empty", false)) and score <= 0.0,
		"integration": ["fleet_multi_day_autonomy_product", "fleet_day_posture", "fleet_day_station_escort", "fleet_day_follow_through", "major_2", "playability", "execution"],
	}

static func execute_fleet_day_step(
	step: String = "posture",
	province_id: int = 1,
	fuel_level: float = 0.65,
	basing_level: String = "port",
	zone_relation: String = "contested",
) -> Dictionary:
	var s := step.strip_edges().to_lower()
	if s.begins_with("fleet_day_"):
		s = s.replace("fleet_day_", "")
	if s not in ["posture", "station_escort", "follow_through"]:
		s = "posture"
	var product: Dictionary = fleet_multi_day_autonomy_product(fuel_level, basing_level, zone_relation, 100.0, "GER", province_id, 3)
	var row: Dictionary = {}
	for r in product.get("day_rows", []):
		if r is Dictionary and str(r.get("step")) == s:
			row = r
			break
	var leaf := "apply_station"
	var action_id := "fleet_day_posture"
	var lab := "Day 0 — set theater posture / tasking"
	match s:
		"station_escort":
			leaf = "apply_supply"
			action_id = "fleet_day_station_escort"
			lab = "Day 1 — station + escort sustain"
		"follow_through":
			leaf = "apply_station"
			action_id = "fleet_day_follow_through"
			lab = "Day 2 — multi-day follow-through"
	var score := float(row.get("score", product.get("score", 0.5)))
	var apply_queue: Array = [{
		"action_id": leaf, "province_id": province_id, "score": score, "enabled": true,
		"label": lab, "step": s, "product_action": action_id,
	}]
	var label := "Execute fleet day %s · leaf %s · score %.2f · #%d" % [s, leaf, score, province_id]
	return {
		"step": s, "leaf_action": leaf, "action_id": action_id, "apply_queue": apply_queue,
		"score": score, "province_id": province_id, "product_score": float(product.get("score", 0)),
		"chosen_order": str(product.get("chosen_order", "")),
		"summary": label, "plain": label,
		"bbcode": "%s🚢 Fleet day %s[/color] %s— %s[/color]" % [COLOR_HEADER, s, COLOR_MUTED, label],
		"empty": false, "ok": true,
		"integration": ["execute_fleet_day_step", s, leaf],
	}

