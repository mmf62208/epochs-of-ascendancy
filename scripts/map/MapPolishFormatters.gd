	}


static func format_command_log_surface(trail: Array = [], max_lines: int = 6) -> Dictionary:
	if trail.is_empty():
		return {"empty": true, "plain": "", "bbcode": "", "summary": "", "count": 0}
	var lines: PackedStringArray = []
	var start := maxi(0, trail.size() - maxi(1, max_lines))
	for i in range(start, trail.size()):
		var e = trail[i]
		if e is Dictionary:
			var s := str(e.get("summary", e.get("order", ""))).strip_edges()
			if not s.is_empty():
				lines.append(s)
	if lines.is_empty():
		return {"empty": true, "plain": "", "bbcode": "", "summary": "", "count": 0}
	var label := "Command log surface · %d" % lines.size()
	var bb: PackedStringArray = ["%s── Command results ──[/color]" % COLOR_HEADER]
	for ln in lines:
		bb.append("%s· %s[/color]" % [COLOR_MUTED, ln])
	return {
		"count": lines.size(),
		"lines": Array(lines),
		"summary": label,
		"plain": "\n".join(lines),
		"bbcode": "\n".join(bb),
		"empty": false,
		"integration": ["command_log", "player_surface"],
	}


static func day_apply_budget(pending_count: int = 0, max_applies: int = 3, precip: float = 0.0, visibility: float = 1.0) -> Dictionary:
	var base := maxi(1, max_applies)
	if precip > 0.55 or visibility < 0.4:
		base = maxi(1, base - 1)
	var allowed := mini(base, maxi(0, pending_count))
	var label := "Day apply budget · allow %d of %d pending (cap %d)" % [allowed, pending_count, base]
	return {
		"cap": base,
		"pending": pending_count,
		"allowed": allowed,
		"score": float(allowed) / float(maxi(1, base)),
		"summary": label,
		"bbcode": "%s⏱ Budget[/color] %s— %s[/color]" % [COLOR_HEADER, COLOR_MUTED, label],
		"empty": false,
	}


