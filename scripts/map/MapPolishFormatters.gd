static func assault_follow_on_day(
	attacker_power: float = 100.0,
	defender_power: float = 70.0,
	attacker_supply: float = 0.85,
	weather_mult: float = 1.0,
	province_id: int = 1,
) -> Dictionary:
	var est: Dictionary = estimate_multi_phase_combat(attacker_power, defender_power, attacker_supply, weather_mult)
	var win := clampf(float(est.get("overall_attacker_win_chance", 0.5)), 0.0, 1.0)
	var next_step := "press" if win >= 0.45 else "hold"
	var apply_queue: Array = []
	if next_step == "press" or win >= 0.45:
		apply_queue.append({"action_id": "apply_assault", "province_id": province_id, "score": win, "enabled": true, "label": "Follow-on %s" % next_step})
	if attacker_supply < 0.7 or win < 0.5:
		apply_queue.append({"action_id": "apply_supply", "province_id": province_id, "score": maxf(0.35, 1.0 - attacker_supply), "enabled": true, "label": "Sustain follow-on"})
	if apply_queue.is_empty():
		apply_queue.append({"action_id": "apply_station", "province_id": province_id, "score": 0.4, "enabled": true})
	var label := "Assault follow-on day · %s · win %.0f%% · #%d" % [next_step, win * 100.0, province_id]
	return {
		"next_step": next_step, "score": win, "apply_queue": apply_queue,
		"actions": [{"action_id": "assault_follow_on_day", "label": "Run assault follow-on day", "enabled": true}],
		"summary": label, "plain": label,
		"bbcode": "%s⚔ Assault follow-on day[/color] %s— %s[/color]" % [COLOR_HEADER, COLOR_MUTED, label],
		"empty": false, "integration": ["assault", "follow_on", "readiness"],
	}


static func joint_ops_loop_day(
	basing_level: String = "port",
	fuel_level: float = 0.6,
	attacker_power: float = 100.0,
	attacker_supply: float = 0.85,
	weather_mult: float = 1.0,
	province_id: int = 1,
) -> Dictionary:
	var basing: Dictionary = basing_logistics_day(basing_level, fuel_level, province_id)
	var follow: Dictionary = assault_follow_on_day(attacker_power, 70.0, attacker_supply, weather_mult, province_id)
	var apply_queue: Array = []
	var seen: Dictionary = {}
	for block in [basing, follow]:
		for q in block.get("apply_queue", []):
			if not (q is Dictionary):
				continue
			var key := "%s:%d" % [str(q.get("action_id", "")), int(q.get("province_id", -1))]
			if seen.has(key):
				continue
			seen[key] = true
			apply_queue.append(q)
			if apply_queue.size() >= 6:
				break
	var score := (float(basing.get("score", 0.5)) + float(follow.get("score", 0.5))) * 0.5
	var label := "Joint ops loop day · basing %.2f · follow %.2f · q %d" % [
		float(basing.get("score", 0.0)), float(follow.get("score", 0.0)), apply_queue.size()
	]
	return {
		"basing": basing, "follow": follow, "score": score, "apply_queue": apply_queue,
		"actions": [{"action_id": "joint_ops_loop_day", "label": "Run joint ops loop day", "enabled": not apply_queue.is_empty()}],
		"summary": label, "plain": label,
		"bbcode": "%s◎ Joint ops loop day[/color] %s— %s[/color]" % [COLOR_HEADER, COLOR_MUTED, label],
		"empty": false, "integration": ["joint_ops", "basing", "follow_on"],
	}


