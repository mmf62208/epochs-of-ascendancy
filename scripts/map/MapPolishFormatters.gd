static func campaign_decision_day(
	boards: Array = [],
	province_id: int = 1,
) -> Dictionary:
	var bds: Array = boards if boards is Array and not boards.is_empty() else [
		{"id": "combat", "score": 0.78, "label": "Press main front", "action_id": "apply_assault"},
		{"id": "supply", "score": 0.62, "label": "Feed rear depots", "action_id": "apply_supply"},
		{"id": "fleet", "score": 0.58, "label": "Sea control patrol", "action_id": "apply_station"},
		{"id": "production", "score": 0.55, "label": "Surge primary line", "action_id": "apply_production"},
		{"id": "agenda", "score": 0.5, "label": "Commit war agenda", "action_id": "apply_hh_commit"},
	]
	var summaries: Array = []
	for b in bds:
		if b is Dictionary:
			summaries.append(str(b.get("label", b.get("id", ""))))
	var strip: Dictionary = campaign_decision_strip(summaries)
	var ranked: Array = bds.duplicate()
	ranked.sort_custom(func(a, b): return float(a.get("score", 0.0)) > float(b.get("score", 0.0)))
	var apply_queue: Array = []
	var sum_sc := 0.0
	var n := 0
	for b in ranked:
		if not (b is Dictionary):
			continue
		if apply_queue.size() >= 4:
			break
		apply_queue.append({
			"action_id": str(b.get("action_id", "refresh_queue")),
			"province_id": province_id,
			"score": clampf(float(b.get("score", 0.5)), 0.0, 1.0),
			"enabled": true,
			"label": str(b.get("label", b.get("id", ""))),
		})
		sum_sc += float(b.get("score", 0.5))
		n += 1
	var score := clampf(sum_sc / float(maxi(1, n)), 0.0, 1.0)
	var top_id := str(ranked[0].get("id", "?")) if not ranked.is_empty() and ranked[0] is Dictionary else "—"
	var label := "Campaign decision day · boards %d · top %s · score %.2f" % [ranked.size(), top_id, score]
	return {
		"strip": strip, "boards": ranked, "score": score, "apply_queue": apply_queue,
		"actions": [{"action_id": "campaign_decision_day", "label": "Run campaign decision day", "enabled": not apply_queue.is_empty()}],
		"summary": label, "plain": "%s\n%s" % [label, str(strip.get("plain", strip.get("summary", "")))],
		"bbcode": "%s── Campaign decision day[/color] %s— %s[/color]" % [COLOR_HEADER, COLOR_MUTED, label],
		"empty": false, "integration": ["campaign", "decision", "multi_board"],
	}


