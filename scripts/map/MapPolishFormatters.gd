	var score := clampf(0.35 * assign_score + 0.35 * station_score + 0.3 * command_score, 0.0, 1.0)
	if score < 0.35: score = 0.35
	var rec: Dictionary = recommend_leader_step(assign_score, station_score, assign_score >= 0.45 and station_score >= 0.45)
	var steps: Array = [
		{"step": "assign", "action_id": "leader_command_assign", "leaf": "apply_focus", "label": "Step 0 — leader assign board", "score": assign_score},
		{"step": "station", "action_id": "leader_command_station", "leaf": "apply_station", "label": "Step 1 — formation station", "score": station_score},
		{"step": "command", "action_id": "leader_command_ops", "leaf": "apply_assault", "label": "Step 2 — command ops", "score": command_score},
	]
	var day_rows: Array = []
	var apply_queue: Array = []
	for i in range(steps.size()):
		var st: Dictionary = steps[i]
		var step_name := str(st.get("step"))
		var recommended: bool = step_name == str(rec.get("step"))
		var sc := float(st.get("score", 0.5))
		var leaf := str(st.get("leaf"))
		var lab := str(st.get("label"))
		if recommended: lab = "★ " + lab
		lab = "%s · score %.2f" % [lab, sc]
		day_rows.append({"index": i, "step": step_name, "action_id": str(st.get("action_id")), "leaf_action": leaf, "label": lab, "score": sc, "enabled": true, "recommended": recommended, "province_id": province_id})
		apply_queue.append({"action_id": leaf, "province_id": province_id, "score": sc, "enabled": true, "label": lab, "step": step_name, "product_action": str(st.get("action_id"))})
	var actions: Array = [
		{"action_id": "leader_command_product", "label": "Run leader command product", "enabled": true},
		{"action_id": str(rec.get("action_id", "leader_command_assign")), "label": "Recommended: %s" % str(rec.get("step", "assign")), "enabled": true},
	]
	for row2 in day_rows:
		actions.append({"action_id": str(row2.get("action_id")), "label": str(row2.get("label")), "enabled": true, "step": str(row2.get("step"))})
	var label := "Leader command · assign %.2f · station %.2f · command %.2f · score %.2f" % [assign_score, station_score, command_score, score]
	return {
		"recommendation": rec, "day_rows": day_rows, "apply_queue": apply_queue, "actions": actions,
		"assign_score": assign_score, "station_score": station_score, "command_score": command_score,
		"score": score, "leader_score": score, "province_id": province_id,
		"summary": label, "plain": label,
		"bbcode": "%s★ Leader command[/color] %s— %s[/color]" % [COLOR_HEADER, COLOR_MUTED, label],
		"empty": false,
		"integration": ["leader_command_product", "leader_command_assign", "leader_command_station", "leader_command_ops", "major_26", "leader", "command"],
	}

static func execute_leader_command_step(step: String = "assign", province_id: int = 1) -> Dictionary:
	var s := step.strip_edges().to_lower()
	if s.begins_with("leader_command_"):
		s = s.replace("leader_command_", "")
	if s not in ["assign", "station", "command"]:
		s = "assign"
	var product: Dictionary = leader_command_product(province_id)
	var row: Dictionary = {}
	for r in product.get("day_rows", []):
		if r is Dictionary and str(r.get("step")) == s:
			row = r
			break
	var leaf := str(row.get("leaf_action", "apply_focus"))
	var action_id := "leader_command_assign"
	match s:
		"station": action_id = "leader_command_station"
		"command": action_id = "leader_command_ops"
	var sc := float(row.get("score", product.get("score", 0.5)))
	var label := "Execute leader command %s · leaf %s · score %.2f" % [s, leaf, sc]
	return {"step": s, "leaf_action": leaf, "action_id": action_id, "ok": true, "score": sc, "province_id": province_id,
		"apply_queue": [{"action_id": leaf, "province_id": province_id, "score": sc, "enabled": true, "label": label, "step": s, "product_action": action_id}],
		"summary": label, "plain": label, "bbcode": "%s★ Leader %s[/color] %s— %s[/color]" % [COLOR_HEADER, s, COLOR_MUTED, label], "empty": false,
		"integration": ["execute_leader_command_step", s, leaf]}

