	var wx_mult := clampf(visibility * (1.0 - precip * 0.35), 0.25, 1.15)
	var phase: Dictionary = combat_phase_depth_score(force_strength, 70.0, supply_health, wx_mult)
	var apply_queue: Array = []
	for block in [posture, readiness]:
		if not (block is Dictionary) or bool(block.get("empty", false)):
			continue
		for q in block.get("apply_queue", []):
			if q is Dictionary and bool(q.get("enabled", true)):
				apply_queue.append(q)
	var p_score := float(phase.get("score", 0.5))
	if p_score >= 0.45 and not bool(readiness.get("empty", false)):
		apply_queue.append({
			"action_id": "apply_assault",
			"province_id": province_id,
			"score": p_score,
			"enabled": true,
			"domain": "phase_depth",
		})
	var seen: Dictionary = {}
	var deduped: Array = []
	for q in apply_queue:
		if not (q is Dictionary):
			continue
		var key := "%s:%d:%s" % [str(q.get("action_id", "")), int(q.get("province_id", -1)), str(q.get("domain", ""))]
		if seen.has(key):
			continue
		seen[key] = true
		deduped.append(q)
	if deduped.size() > 8:
		deduped = deduped.slice(0, 8)
	var s_posture := float(posture.get("score", 0.0))
	var s_ready := 0.0 if bool(readiness.get("empty", false)) else float(readiness.get("score", 0.0))
	var s_phase := p_score
	var score: float = (s_posture + s_ready + s_phase) / 3.0
	var label := "Force readiness day · posture %.2f · theater %.2f · phase %.2f · q %d" % [
		s_posture, s_ready, s_phase, deduped.size()
	]
	return {
		"posture": posture,
		"readiness": readiness,
		"phase": phase,
		"apply_queue": deduped,
		"score": score,
		"actions": [{"action_id": "force_readiness_day", "label": "Run force readiness day", "enabled": not deduped.is_empty()}],
		"summary": label,
		"plain": label,
		"bbcode": "%s🎖 Force readiness day[/color] %s— %s[/color]" % [COLOR_HEADER, COLOR_MUTED, label],
		"empty": false,
	}


## Production surge day package.
static func production_surge_day(
	temp: float = 10.0,
	precip: float = 0.0,
	ground_state: String = "dry",
	visibility: float = 1.0,
	wind: float = 0.2,
	base_output: float = 1.0,
	line_id: String = "primary",
	province_id: int = 1,
) -> Dictionary:
	var mut: Dictionary = production_priority_mutation(temp, precip, ground_state, visibility, wind, base_output, line_id, "")
	var alert: Dictionary = production_weather_alert(temp, precip, 0.85)
	var plan_v = mut.get("plan", null)
	var priority := "MONITOR"
	if plan_v is Dictionary:
		priority = str((plan_v as Dictionary).get("priority", "MONITOR"))
	var score := float(mut.get("score", 0.5))
	if score > 2.0:
		score = clampf(score / 100.0, 0.0, 1.0)
	var alert_on := bool(alert.get("alert", false)) and not bool(alert.get("empty", true))
	var prod_mult := float(alert.get("mult", weather_production_multiplier(temp, precip)))
	var apply_queue: Array = [
		{"action_id": "apply_production", "province_id": province_id, "score": maxf(0.35, score), "line_id": line_id, "priority": priority, "enabled": true},
	]
	if alert_on or priority in ["SHIELD", "SURGE"]:
		apply_queue.append({"action_id": "apply_focus", "province_id": province_id, "score": 0.45, "focus_id": "industrial_effort", "enabled": true})
	if alert_on:
		apply_queue.append({"action_id": "apply_supply", "province_id": province_id, "score": maxf(0.35, 1.0 - prod_mult), "enabled": true})
	var adj_score: float = score * (0.75 if alert_on else 1.0)
	var label := "Production surge day · priority %s · out×%.2f · alert=%s" % [
		priority, prod_mult, "yes" if alert_on else "no"
	]
	return {
		"mutation": mut,
		"alert": alert,
		"priority": priority,
		"prod_mult": prod_mult,
		"score": adj_score,
		"apply_ready": true,
		"apply_queue": apply_queue,
		"actions": [{"action_id": "production_surge_day", "label": "Run production surge day", "enabled": true}],
		"summary": label,
		"plain": label,
		"bbcode": "%s🏭 Production surge day[/color] %s— %s[/color]" % [COLOR_HEADER, COLOR_MUTED, label],
		"empty": false,
	}


## Depot capacity day package.
static func depot_capacity_day(
	base_capacity: float = 100.0,
	ground_state: String = "dry",
	precip: float = 0.0,
	sea_mult: float = 1.0,
	province_id: int = 1,
) -> Dictionary:
	var depot: Dictionary = depot_weather_capacity(base_capacity, ground_state, precip)
	var cap := float(depot.get("capacity", base_capacity))
	var wx_m := float(depot.get("weather_mult", 1.0))
	var fill_pressure := clampf(1.0 - (cap / maxf(10.0, base_capacity)), 0.0, 1.0)
	var sea := clampf(sea_mult, 0.2, 1.5)
	var score: float = (wx_m * 0.55 + minf(1.2, sea) * 0.45) * (1.0 - fill_pressure * 0.35)
	var apply_queue: Array = [
		{"action_id": "apply_supply", "province_id": province_id, "score": maxf(0.35, 1.0 - score + 0.2), "enabled": true},
	]
	if fill_pressure >= 0.25 or precip > 0.45:
		apply_queue.append({"action_id": "apply_station", "province_id": province_id, "score": 0.4 + fill_pressure * 0.3, "enabled": true})
	if sea < 0.75:
		apply_queue.append({"action_id": "fleet_autonomy", "province_id": province_id, "score": 0.45, "enabled": true, "order": "escort"})
	var label := "Depot capacity day · cap %.0f (base %.0f · wx×%.2f) · sea×%.2f" % [cap, base_capacity, wx_m, sea]
	return {
		"depot": depot,
		"capacity": cap,
		"weather_mult": wx_m,
		"sea_mult": sea,
		"fill_pressure": fill_pressure,
		"score": score,
		"apply_ready": cap >= 15.0,
		"apply_queue": apply_queue,
		"actions": [{"action_id": "depot_capacity_day", "label": "Run depot capacity day", "enabled": cap >= 15.0}],
		"summary": label,
		"plain": label,
		"bbcode": "%s📦 Depot capacity day[/color] %s— %s[/color]" % [COLOR_HEADER, COLOR_MUTED, label],
		"empty": false,
	}


## Industry surge day compose.
static func industry_surge_day(
	temp: float = 10.0,
	precip: float = 0.0,
	ground_state: String = "dry",
	visibility: float = 1.0,
	wind: float = 0.2,
	base_output: float = 1.0,
	base_capacity: float = 100.0,
	sea_mult: float = 1.0,
	line_id: String = "primary",
	province_id: int = 1,
) -> Dictionary:
	var surge: Dictionary = production_surge_day(temp, precip, ground_state, visibility, wind, base_output, line_id, province_id)
	var depot: Dictionary = depot_capacity_day(base_capacity, ground_state, precip, sea_mult, province_id)
	var oob: Dictionary = oob_factory_risk_loop(temp, precip, ground_state, visibility, wind, base_output)
	var chain: Dictionary = supply_chain_health_compose(100.0, sea_mult, ground_state, precip, visibility, 0.0)
	var mult := float(oob.get("effective_output", oob.get("mult", 1.0)))
	var risk := clampf(1.0 - mult, 0.0, 1.0)
	var health := float(chain.get("health", chain.get("score", 0.7)))
	var ind_score: float = (1.0 - risk) * 0.5 + health * 0.5
	var industry: Dictionary = {
		"score": ind_score,
		"risk": risk,
		"summary": "Industry economy · out×%.2f · supply×%.2f · risk %.0f%%" % [mult, health, risk * 100.0],
		"empty": false,
		"actions": [
			{"action_id": "apply_production", "enabled": true},
			{"action_id": "apply_supply", "enabled": true},
			{"action_id": "apply_focus", "enabled": true, "focus_id": "industrial_effort"},
		],
	}
	var apply_queue: Array = []
	for block in [surge, depot]:
		if not (block is Dictionary) or bool(block.get("empty", false)):
			continue
		for q in block.get("apply_queue", []):
			if q is Dictionary and bool(q.get("enabled", true)):
				apply_queue.append(q)
	for a in industry.get("actions", []):
		if a is Dictionary and bool(a.get("enabled", true)):
			apply_queue.append({
				"action_id": str(a.get("action_id", "")),
				"province_id": province_id,
				"score": ind_score,
				"enabled": true,
				"focus_id": str(a.get("focus_id", "industrial_effort")),
			})
	var seen: Dictionary = {}
	var deduped: Array = []
	for q in apply_queue:
		if not (q is Dictionary):
			continue
		var key := "%s:%d:%s" % [str(q.get("action_id", "")), int(q.get("province_id", -1)), str(q.get("focus_id", ""))]
		if seen.has(key):
			continue
		seen[key] = true
		deduped.append(q)
	if deduped.size() > 8:
		deduped = deduped.slice(0, 8)
	var s_surge := float(surge.get("score", 0.0))
	var s_depot := float(depot.get("score", 0.0))
	var score: float = (s_surge + s_depot + ind_score) / 3.0
	var label := "Industry surge day · prod %.2f · depot %.2f · industry %.2f · q %d" % [
		s_surge, s_depot, ind_score, deduped.size()
	]
	return {
		"surge": surge,
		"depot": depot,
		"industry": industry,
		"apply_queue": deduped,
		"score": score,
		"actions": [{"action_id": "industry_surge_day", "label": "Run industry surge day", "enabled": not deduped.is_empty()}],
		"summary": label,
		"plain": label,
		"bbcode": "%s🏭 Industry surge day[/color] %s— %s[/color]" % [COLOR_HEADER, COLOR_MUTED, label],
		"empty": false,
		"sole_mult": true,
	}


