	var label := "Air ops · sortie %.0f%% · day×%.2f%s" % [float(ready.get("effectiveness", 1.0)) * 100.0, float(day.get("combat_mult", 1.0)), " GROUNDED" if grounded else ""]
	return {"effective": eff, "grounded": grounded, "summary": label, "bbcode": "%s✈ Air package[/color] %s— %s[/color]" % [COLOR_TECH, COLOR_MUTED, label], "empty": false, "integration": ["air_sortie", "daylight"]}


static func theater_readiness_board(summaries: Array) -> Dictionary:
	## Compose fleet+assault+day-risk (or any) summaries into a readiness board.
	var board: Dictionary = format_campaign_strip(summaries, 6)
	if bool(board.get("empty", true)):
		return board
	board["summary"] = "Theater readiness · %d signals" % int(board.get("count", 0))
	var bb: PackedStringArray = ["%s── Theater readiness ──[/color]" % COLOR_HEADER]
	for ln in str(board.get("plain", "")).split("\n"):
		var t := str(ln).strip_edges()
		if t.is_empty():
			continue
		bb.append("%s· %s[/color]" % [COLOR_MUTED, t])
	board["bbcode"] = "\n".join(bb)
	board["integration"] = ["fleet_wx", "assault_ready", "day_risk"]
	return board


## Convoy escort × weather window package (fleet+wx+convoy).
static func convoy_package_compose(
	escort_need: float = 0.0,
	escort_coverage: float = 1.0,
	best_day: int = 0,
	precip: float = 0.0,
) -> Dictionary:
	var recommend_escort := escort_need >= 25.0
	var sufficient := escort_coverage >= 0.8
	var recommend_wait := best_day > 0 and precip > 0.5
	var label := "Convoy package · escort %s · best day %d" % [
