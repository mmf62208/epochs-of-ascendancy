	sea_trade_mult: float = 1.0,
	escort_coverage: float = 0.7,
	controller_tag: String = "",
	province_id: int = 1,
) -> Dictionary:
	var skim: Dictionary = sealane_contest_skim(is_choke, zone_relation, sea_trade_mult, escort_coverage, province_id)
	var zone := str(skim.get("zone_relation", zone_relation)).to_lower()
	var contest := float(skim.get("contest", 0.3))
	var tint_key := "neutral_sealane"
	var marker := "○"
	var color_hint := "#8899aa"
	if zone == "hostile":
		tint_key = "hostile_sealane"
		marker = "⚔"
		color_hint = "#e85d5d"
	elif zone == "contested" or contest >= 0.45:
		tint_key = "contested_sealane"
		marker = "◇"
