		"coverage": escort_coverage,
		"best_day": best_day,
		"recommend_escort": recommend_escort,
		"sufficient": sufficient,
		"recommend_wait": recommend_wait,
		"summary": label,
		"bbcode": "%s⛵ Convoy package[/color] %s— %s[/color]" % [COLOR_TECH, COLOR_MUTED, label],
		"empty": false,
		"integration": ["convoy_escort", "weather_window"],
