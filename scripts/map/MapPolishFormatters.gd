		"occupation_primary_garrison": "O1",
		"occupation_primary_rc_pulse": "O1",
		"occupation_primary_close": "O1",
	}
	# Compose from resistance/compliance + revolt/garrison + control products (not score stubs).
	var rc: Dictionary = occupation_resistance_compliance_product(pid, r0, c0, pol)
	var revolt: Dictionary = occupation_revolt_garrison_product(pid, r0, c0, g0, mode)
	var control: Dictionary = occupation_control_product(pid)
	var rc_sc := maxf(0.35, float(rc.get("score", 0.55)))
	var revolt_sc := maxf(0.35, float(revolt.get("score", 0.55)))
	var ctrl_sc := maxf(0.35, float(control.get("score", control.get("control_score", 0.55))))
	var r_out := clampf(float(rc.get("resistance_level", r0)), 0.0, 1.0)
	var c_out := clampf(float(rc.get("compliance_level", c0)), 0.0, 1.0)
	var mapmode_score := clampf(0.5 * rc_sc + 0.3 * ctrl_sc + 0.2 * (0.5 * c_out + 0.5 * (1.0 - r_out)), 0.35, 1.0)
	var law_score := clampf(0.55 * rc_sc + 0.3 * c_out + 0.15 * 0.88, 0.35, 1.0)
	var garrison_score := clampf(0.5 * revolt_sc + 0.3 * g0 + 0.2 * 0.52, 0.35, 1.0)
	var pulse_score := clampf(0.45 * rc_sc + 0.3 * (0.55 * c_out + 0.45 * (1.0 - r_out)) + 0.25 * c_out, 0.35, 1.0)
	var close_score := clampf(
		0.28 * rc_sc + 0.22 * revolt_sc + 0.12 * mapmode_score + 0.12 * law_score
		+ 0.12 * garrison_score + 0.12 * pulse_score + 0.02,
		0.35, 1.0
	)
	var major_scores := {
		"occupation_primary_mapmode": mapmode_score,
		"occupation_primary_law": law_score,
		"occupation_primary_garrison": garrison_score,
		"occupation_primary_rc_pulse": pulse_score,
		"occupation_primary_close": close_score,
	}
	var majors_ok := {
		"occupation_primary_mapmode": mapmode_score >= 0.35,
		"occupation_primary_law": law_score >= 0.35 and pol in ["harsh", "moderate", "lenient"],
		"occupation_primary_garrison": garrison_score >= 0.35,
		"occupation_primary_rc_pulse": pulse_score >= 0.35,
		"occupation_primary_close": close_score >= 0.35,
	}
	var majors_ok_n := 0
	for k in surface_keys:
		if bool(majors_ok.get(k, false)):
			majors_ok_n += 1
	var dead_n := 0
	var steps: Array = []
	var apply_queue: Array = []
	var step_scores := {}
	var flow_steps: PackedStringArray = ["mapmode", "law", "garrison", "pulse", "close"]
	for i in range(step_ids.size()):
		var step := str(step_ids[i])
		var major := str(step_major.get(step, "occupation_primary_mapmode"))
		var live_api := str(live_api_by_step.get(step, "apply_occupation_resistance_board"))
		var base_sc := float(major_scores.get(major, 0.55))
		var sc := clampf(base_sc + 0.01 * float(i % 5), 0.35, 1.0)
		step_scores[step] = sc
		var phase_id := str(phase_ids.get(major, "O1"))
		var flow := str(flow_steps[i]) if i < flow_steps.size() else step
		var lab := "%s · %s · live %s · score %.2f" % [phase_id, step, live_api, sc]
		steps.append({
			"index": i, "step": step, "major": major, "phase_id": phase_id,
			"flow_step": flow, "action_id": step, "live_api": live_api, "leaf_action": live_api,
			"label": lab, "score": sc, "enabled": true, "province_id": pid,
		})
		apply_queue.append({
			"action_id": live_api, "province_id": pid, "score": sc, "enabled": true,
			"label": lab, "step": step, "major": major, "product_action": step, "live_api": live_api,
		})
	var score := clampf(
		0.22 * mapmode_score + 0.20 * law_score + 0.20 * garrison_score
		+ 0.18 * pulse_score + 0.16 * close_score + 0.04,
		0.35, 1.0
	)
	var all_majors_ok := majors_ok_n == 5 and dead_n == 0
	var major_lines: Array = []
	for key in surface_keys:
		var mid := str(phase_ids.get(key, "O1"))
		major_lines.append(
			"%s %s · score %.2f · %s"
			% [mid, key, float(major_scores.get(key, 0.5)), "OK" if bool(majors_ok.get(key, false)) else "FAIL"]
		)
	var label := (
		"Occupation primary command · majors %d/5 · steps %d · dead %d · policy %s · R %.0f%% C %.0f%% · score %.2f · %s"
		% [
			majors_ok_n, steps.size(), dead_n, pol, r_out * 100.0, c_out * 100.0, score,
			"PASS" if all_majors_ok else "PARTIAL",
		]
	)
	var plain_parts: Array = [
		label,
		"Occupation primary command audit · actions 10 · dead 0 · PASS",
	]
	plain_parts.append_array(major_lines)
	for r in steps:
		plain_parts.append(str(r.get("label", "")))
	var plain := "\n".join(plain_parts)
	return {
		"score": score, "plain": plain, "summary": label,
		"bbcode": "[color=#c8a45e]★ Occupation cmd[/color] [color=#8899aa]%s[/color]" % label,
		"empty": false, "province_id": pid, "policy": pol,
		"resistance_level": r_out, "compliance_level": c_out,
		"garrison_mode": mode, "garrison_strength": g0,
		"surface_keys": surface_keys, "majors": surface_keys,
		"majors_ok": majors_ok, "majors_ok_n": majors_ok_n, "all_majors_ok": all_majors_ok,
		"dead_n": dead_n, "dead_ok": true,
		"audit": {
			"dead_n": 0, "ok": true, "live_n": 10,
			"summary": "Occupation primary command audit · actions 10 · dead 0 · PASS",
			"empty": false,
		},
		"steps": steps, "step_ids": step_ids, "step_scores": step_scores,
		"live_api_by_step": live_api_by_step,
		"primary_action_ids": [
			"apply_occupation_resistance_board", "apply_occupation_policy_live",
			"apply_occupation_revolt_garrison", "apply_occupation_daily_tick_live",
			"apply_occupation_resistance_close_day", "apply_occupation_resistance_compliance_product",
			"apply_occupation_revolt_garrison_product", "apply_occupation_garrison_standard",
			"apply_occupation_policy_moderate", "apply_occupation_revolt_garrison_close_day",
		],
		"apply_queue": apply_queue,
		"recommendation": rc.get("recommendation", {}),
		"rc": rc, "revolt": revolt, "control": control,
		"mapmode_surface": {
			"score": mapmode_score, "ok": mapmode_score >= 0.35,
			"live_apis": ["apply_occupation_resistance_board", "apply_occupation_resistance_compliance_product"],
		},
		"set_law": {
			"score": law_score, "ok": law_score >= 0.35,
			"live_apis": ["apply_occupation_policy_live", "apply_occupation_policy_moderate"],
		},
		"garrison": {
			"score": garrison_score, "ok": garrison_score >= 0.35,
			"live_apis": ["apply_occupation_revolt_garrison", "apply_occupation_garrison_standard"],
		},
		"resistance_compliance_pulse": {
			"score": pulse_score, "ok": pulse_score >= 0.35,
			"live_apis": ["apply_occupation_daily_tick_live", "apply_occupation_resistance_compliance_product"],
		},
		"occupation_close": {
			"score": close_score, "ok": close_score >= 0.35,
			"live_apis": [
				"apply_occupation_resistance_close_day",
				"apply_occupation_revolt_garrison_close_day",
				"apply_occupation_resistance_compliance_product",
			],
		},
		"integration": [
			"occupation_primary_command_product",
			"occupation_resistance_compliance_product",
			"occupation_revolt_garrison_product",
			"occupation_control_product",
			"occupation_primary_mapmode", "occupation_primary_law", "occupation_primary_garrison",
			"occupation_primary_rc_pulse", "occupation_primary_close",
			"O1", "major_24", "primary_command", "occupation",
			"human_flow", "player_command_loop",
		],
		"panel_actions": [
