static func strategic_ai_player_skip_day(province_id: int = 1) -> Dictionary:
	var board: Dictionary = multi_faction_strategic_ai_product([], province_id, 7)
	var factions: Array = board.get("factions", [])
	var skipped: Dictionary = budget_ai_day_actions(factions, "GER", 4, province_id)
	var full: Dictionary = budget_ai_day_actions(factions, "", 7, province_id)
	var sc := int(skipped.get("selected_count", 0))
	var fc := int(full.get("selected_count", 0))
	var shift := maxi(0, fc - sc)
	var ok_skip := true
	for item in skipped.get("queue", []):
		if item is Dictionary and str(item.get("faction", "")).to_upper() == "GER":
			ok_skip = false
			break
	var score := clampf(0.4 + 0.1 * float(sc) + (0.15 if ok_skip else 0.0) + 0.05 * float(mini(3, shift)), 0.0, 1.0)
	if score < 0.35:
		score = 0.35
	var apply_queue: Array = []
	for q in skipped.get("queue", []):
		if q is Dictionary:
			apply_queue.append(q)
		if apply_queue.size() >= 4:
			break
	if apply_queue.is_empty():
		apply_queue = [
			{"action_id": "apply_station", "province_id": province_id, "score": score, "enabled": true, "label": "Strategic AI player skip station"},
			{"action_id": "apply_focus", "province_id": province_id, "score": 0.5, "enabled": true, "label": "Strategic AI player skip focus"},
		]
	var label := "Strategic AI player skip · budget %d · full %d · skip_shift %d · GER out %s · score %.2f" % [sc, fc, shift, "yes" if ok_skip else "no", score]
	return {
		"skipped": skipped, "full": full, "skip_shift": shift, "ai_score": score, "score": score, "apply_queue": apply_queue,
		"actions": [{"action_id": "strategic_ai_player_skip_day", "label": "Run strategic AI player skip day", "enabled": true}],
		"summary": label, "plain": label,
		"bbcode": "%s♟ Strategic AI player skip[/color] %s— %s[/color]" % [COLOR_HEADER, COLOR_MUTED, label],
		"empty": false, "integration": ["strategic_ai", "player_skip", "budget", "next290"],
	}

