			"action_id": leaf, "province_id": province_id, "score": sc, "enabled": true,
			"label": lab, "step": step_name, "product_action": str(st.get("action_id")),
		})
	var actions: Array = [
		{"action_id": "air_ops_campaign_product", "label": "Run air ops campaign product", "enabled": true},
		{"action_id": str(rec.get("action_id", "air_ops_sortie")), "label": "Recommended: %s" % str(rec.get("step", "sortie")), "enabled": true},
