static func recommend_apply_queue_live_step(live_n: int = 6, production_live: bool = true, combat_live: bool = true) -> Dictionary:
	var step := "combat_supply"
	var reason := "all live — reaffirm combat/supply path"
	if live_n < 5:
		step = "audit"
		reason = "live leaves thin — re-audit contracts"
	elif not production_live:
		step = "production_live"
		reason = "production/supply path not live"
	elif not combat_live:
		step = "combat_supply"
		reason = "combat/station/agent prove needed"
	var action_id := "apply_queue_live_audit"
	var leaf := "apply_production"
	match step:
		"production_live":
			action_id = "apply_queue_live_production"
			leaf = "apply_production"
		"combat_supply":
			action_id = "apply_queue_live_combat"
			leaf = "apply_assault"
	return {"step": step, "action_id": action_id, "leaf": leaf, "reason": reason, "empty": false, "summary": "Recommend %s · %s" % [step, reason]}

static func apply_queue_live_managers_product(province_id: int = 1, live_n: int = 6, ok_n: int = 6) -> Dictionary:
	var total := 6
	var live_ratio := float(live_n) / float(maxi(1, total))
	var ok_ratio := float(ok_n) / float(maxi(1, total))
	var audit_score := clampf(0.55 * live_ratio + 0.45 * ok_ratio, 0.0, 1.0)
	if audit_score < 0.35: audit_score = 0.35
	var production_live: bool = live_n >= 2
	var combat_live: bool = live_n >= 4
	var prod_score := 0.7 if production_live else 0.4
	var combat_score := 0.7 if combat_live else 0.4
	var score := clampf(0.4 * audit_score + 0.3 * prod_score + 0.3 * combat_score, 0.0, 1.0)
	if score < 0.35: score = 0.35
	var rec: Dictionary = recommend_apply_queue_live_step(live_n, production_live, combat_live)
	var steps: Array = [
		{"step": "audit", "action_id": "apply_queue_live_audit", "leaf": "apply_production", "label": "Step 0 — audit core apply-queue leaves", "score": audit_score},
		{"step": "production_live", "action_id": "apply_queue_live_production", "leaf": "apply_production", "label": "Step 1 — production/supply live harden", "score": prod_score},
		{"step": "combat_supply", "action_id": "apply_queue_live_combat", "leaf": "apply_assault", "label": "Step 2 — combat/station/focus/agent prove", "score": combat_score},
	]
	var day_rows: Array = []
	var apply_queue: Array = []
	for i in range(steps.size()):
		var st: Dictionary = steps[i]
		var step_name := str(st.get("step"))
		var recommended: bool = step_name == str(rec.get("step"))
		var sc := float(st.get("score", 0.5))
		var leaf := str(st.get("leaf"))
		var lab := str(st.get("label"))
		if recommended: lab = "★ " + lab
		lab = "%s · score %.2f" % [lab, sc]
		day_rows.append({"index": i, "step": step_name, "action_id": str(st.get("action_id")), "leaf_action": leaf, "label": lab, "score": sc, "enabled": true, "recommended": recommended, "province_id": province_id})
		apply_queue.append({"action_id": leaf, "province_id": province_id, "score": sc, "enabled": true, "label": lab, "step": step_name, "product_action": str(st.get("action_id"))})
	for leaf2 in ["apply_production", "apply_supply", "apply_station", "apply_assault", "apply_focus", "apply_agent_dispatch"]:
		apply_queue.append({"action_id": leaf2, "province_id": province_id, "score": score, "enabled": true, "label": "live leaf %s" % leaf2, "product_action": "apply_queue_live_managers_product"})
	var apply_queue_live := "%d/%d" % [live_n, total]
	var actions: Array = [
		{"action_id": "apply_queue_live_managers_product", "label": "Run apply-queue live managers product", "enabled": true},
		{"action_id": str(rec.get("action_id", "apply_queue_live_audit")), "label": "Recommended: %s" % str(rec.get("step", "audit")), "enabled": true},
	]
	for row2 in day_rows:
		actions.append({"action_id": str(row2.get("action_id")), "label": str(row2.get("label")), "enabled": true, "step": str(row2.get("step"))})
	var label := "Apply-queue live managers · live %s · ok %d/%d · score %.2f" % [apply_queue_live, ok_n, total, score]
	return {
		"recommendation": rec, "day_rows": day_rows, "apply_queue": apply_queue, "actions": actions,
		"apply_queue_live": apply_queue_live, "live_n": live_n, "ok_n": ok_n,
		"score": score, "live_score": score, "province_id": province_id,
		"summary": label, "plain": label,
		"bbcode": "%s⚡ Apply-queue live[/color] %s— %s[/color]" % [COLOR_HEADER, COLOR_MUTED, label],
		"empty": false,
		"integration": ["apply_queue_live_managers_product", "apply_queue_live_audit", "apply_queue_live_production", "apply_queue_live_combat", "major_28", "apply_queue", "live_managers"],
	}

static func execute_apply_queue_live_step(step: String = "audit", province_id: int = 1) -> Dictionary:
	var s := step.strip_edges().to_lower()
	if s.begins_with("apply_queue_live_"):
		s = s.replace("apply_queue_live_", "")
	if s in ["prod", "production"]: s = "production_live"
	if s in ["combat", "combat_supply_prove"]: s = "combat_supply"
	if s not in ["audit", "production_live", "combat_supply"]:
		s = "audit"
	var product: Dictionary = apply_queue_live_managers_product(province_id)
	var row: Dictionary = {}
	for r in product.get("day_rows", []):
		if r is Dictionary and str(r.get("step")) == s:
			row = r
			break
	var leaf := str(row.get("leaf_action", "apply_production"))
	var action_id := "apply_queue_live_audit"
	match s:
		"production_live": action_id = "apply_queue_live_production"
		"combat_supply":
			action_id = "apply_queue_live_combat"
			leaf = "apply_assault"
	var sc := float(row.get("score", product.get("score", 0.5)))
	var label := "Execute apply-queue live %s · leaf %s · score %.2f" % [s, leaf, sc]
	return {"step": s, "leaf_action": leaf, "action_id": action_id, "ok": true, "score": sc, "province_id": province_id,
		"apply_queue": [{"action_id": leaf, "province_id": province_id, "score": sc, "enabled": true, "label": label, "step": s, "product_action": action_id}],
		"summary": label, "plain": label, "bbcode": "%s⚡ Live %s[/color] %s— %s[/color]" % [COLOR_HEADER, s, COLOR_MUTED, label], "empty": false,
		"integration": ["execute_apply_queue_live_step", s, leaf]}

