		"crisis_sustain":
			leaf = "apply_supply"; action_id = "weather_crisis_sustain"
	var label := "Execute weather crisis %s · leaf %s · score %.2f" % [s, leaf, score]
	return {"step": s, "leaf_action": leaf, "action_id": action_id, "ok": true, "score": score, "province_id": province_id,
