static func product_ux_command_polish_product(province_id: int = 1, max_expanded: int = 2, max_chips: int = 8, section_count: int = 24) -> Dictionary:
	var expanded := mini(maxi(max_expanded, 1), 4)
	var nsec := maxi(section_count, 1)
	var collapsed := maxi(nsec - expanded, 0)
	var load_sc := clampf(1.0 - 0.55 * (float(collapsed) / float(nsec)), 0.0, 1.0)
	var compact_score := clampf(1.0 - load_sc * 0.5, 0.35, 1.0)
	var chip_ids: Array = [
		"peace_conference_settlement_product", "manpower_laws_training_product", "occupation_resistance_compliance_product",
		"apply_queue_live_managers_product", "medium_tank_production_honesty_product", "campaign_ai_multi_month_product",
		"designer_domain_live_product", "product_ux_command_polish_product"
	]
	var shown := mini(maxi(max_chips, 4), chip_ids.size())
	var chips_score := clampf(0.45 + 0.07 * float(shown), 0.35, 1.0)
	var bind_n := 8
	var hotkey_score := clampf(0.5 + 0.05 * float(bind_n), 0.35, 1.0)
	var score := clampf(0.35 * compact_score + 0.35 * chips_score + 0.3 * hotkey_score, 0.35, 1.0)
	var step := "hotkeys"
	var rec := {"step": step, "action_id": "product_ux_hotkeys", "leaf": "apply_production", "reason": "bind primary hotkeys 1–8", "summary": "Recommend hotkeys", "empty": false}
	var day_rows: Array = [
		{"step": "compact", "action_id": "product_ux_compact_board", "leaf": "apply_focus", "label": "Step 0 — compact section board", "score": compact_score},
		{"step": "chips", "action_id": "product_ux_top_chips", "leaf": "apply_station", "label": "Step 1 — top-8 always-on chips", "score": chips_score},
		{"step": "hotkeys", "action_id": "product_ux_hotkeys", "leaf": "apply_production", "label": "Step 2 — bind primary hotkeys", "score": hotkey_score},
	]
	var apply_queue: Array = []
	for r in day_rows:
		apply_queue.append({"action_id": str(r.get("leaf")), "province_id": province_id, "score": float(r.get("score", 0.5)), "enabled": true, "label": str(r.get("label")), "step": str(r.get("step")), "product_action": str(r.get("action_id"))})
	var label := "Product UX polish · expanded %d · chips %d · hotkeys %d · score %.2f" % [expanded, shown, bind_n, score]
	return {
		"recommendation": rec, "day_rows": day_rows, "apply_queue": apply_queue,
		"actions": [{"action_id": "product_ux_command_polish_product", "label": "Run product UX command polish", "enabled": true}, {"action_id": str(rec.get("action_id")), "label": "Recommended: %s" % step, "enabled": true}],
		"max_expanded": expanded, "max_chips": shown, "bind_n": bind_n, "score": score, "ux_score": score, "province_id": province_id,
		"summary": label, "plain": label, "bbcode": "[color=#9ad0e8]✦ Product UX[/color] [color=#8899aa]%s[/color]" % label,
		"empty": false, "integration": ["product_ux_command_polish_product", "product_ux_compact_board", "product_ux_top_chips", "product_ux_hotkeys", "major_32", "ux", "phase3_depth"],
	}

static func execute_product_ux_step(step: String = "compact", province_id: int = 1) -> Dictionary:
	var s := step.strip_edges().to_lower().replace("product_ux_", "")
	if s.begins_with("compact"): s = "compact"
	elif s.begins_with("chip"): s = "chips"
	elif s.begins_with("hotkey"): s = "hotkeys"
	else: s = "compact"
	var product: Dictionary = product_ux_command_polish_product(province_id)
	var leaf := "apply_focus"
	var action_id := "product_ux_compact_board"
	var score := float(product.get("score", 0.5))
