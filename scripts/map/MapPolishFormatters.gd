static func fleet_hh_combat_close_day(province_id: int = 1) -> Dictionary:
	var tg: Dictionary = compose_fleet_task_group(100.0, "patrol", "contested", 0.0)
	var trail: Array = [{"action": "commit", "action_class": "influence", "score": 0.72, "province_id": province_id, "influence": 0.55, "year": 1936, "month": 3}]
	var hh: Dictionary = hh_order_commit(trail, 3)
	var est: Dictionary = estimate_multi_phase_combat(100.0, 80.0, 0.85, 0.9)
	var gate: Dictionary = execution_integrity_gate()
	var ok := bool(gate.get("ok", false))
	var score := clampf(
		0.25 * (0.7 if not bool(tg.get("empty", false)) else 0.3)
		+ 0.25 * float(hh.get("score", 0.5))
		+ 0.25 * float(est.get("overall_attacker_win_chance", 0.5))
		+ 0.25 * (0.8 if ok else 0.3),
		0.0, 1.0
	)
	var apply_queue: Array = [
		{"action_id": "apply_station", "province_id": province_id, "score": 0.55, "enabled": true, "label": "Close fleet station"},
		{"action_id": "apply_hh_commit", "province_id": province_id, "score": float(hh.get("score", 0.6)), "enabled": true, "label": "Close HH commit"},
		{"action_id": "apply_assault", "province_id": province_id, "score": float(est.get("overall_attacker_win_chance", 0.5)), "enabled": true, "label": "Close combat assault"},
		{"action_id": "apply_supply", "province_id": province_id, "score": 0.45, "enabled": true, "label": "Close supply"},
	]
	var label := "Fleet HH combat close · gate %s · score %.2f" % ["PASS" if ok else "FAIL", score]
	return {
		"task_group": tg, "hh": hh, "estimate": est, "gate": gate, "ok": ok, "score": score, "apply_queue": apply_queue,
		"actions": [{"action_id": "fleet_hh_combat_close_day", "label": "Run fleet hh combat close day", "enabled": true}],
		"summary": label, "plain": "%s\n%s\n%s" % [label, str(hh.get("summary", "")), str(est.get("summary", ""))],
		"bbcode": "%s✓ Fleet HH combat close[/color] %s— %s[/color]" % [COLOR_HEADER, COLOR_MUTED, label],
		"empty": false, "integration": ["fleet", "hh", "combat", "close", "next130"],
	}


