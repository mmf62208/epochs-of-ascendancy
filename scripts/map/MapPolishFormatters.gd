static func agenda_execute_pick_from_trail(trail: Array, max_commits: int = 3) -> String:
	if trail.is_empty():
		return ""
	var commits := format_hh_agenda_commitments_from_trail(trail, max_commits)
	if commits.is_empty():
		return ""
	# First commit line after header is best pick
	var lines := commits.split("\n")
	var pick_line := ""
	if lines.size() >= 2:
		pick_line = str(lines[1]).strip_edges()
	elif lines.size() == 1:
		pick_line = str(lines[0]).strip_edges()
	if pick_line.is_empty():
		return ""
	return "NEXT: %s\n%s" % [pick_line, commits]


static func move_path_ops_loop(
	base_cost: float = 1.0,
	ground_state: String = "dry",
	visibility: float = 1.0,
	supply_health: float = 1.0,
	armored: bool = false,
) -> Dictionary:
	var move_m := weather_move_multiplier(ground_state, visibility, armored)
	var supply_h := clampf(supply_health, 0.15, 1.5)
	var cost := maxf(0.05, base_cost / maxf(0.15, move_m) / maxf(0.3, supply_h))
	var label := "Move path · cost %.2f (wx ×%.2f · supply ×%.2f)" % [cost, move_m, supply_h]
	return {
		"path_cost": cost,
		"weather_move_mult": move_m,
		"supply_health": supply_h,
		"summary": label,
		"bbcode": "%s🥾 Move path[/color] %s— %s[/color]" % [COLOR_TECH, COLOR_MUTED, label],
		"empty": false,
		"integration": ["move", "weather", "supply"],
	}


static func basing_repair_weather_loop(basing_level: String = "port", precip: float = 0.0) -> Dictionary:
	var level := basing_level.strip_edges().to_lower()
	var base_repair := 0.0
	var base_refuel := 0.0
	match level:
		"anchorage":
			base_repair = 0.015
			base_refuel = 0.10
		"port":
			base_repair = 0.04
			base_refuel = 0.25
		"major_base":
			base_repair = 0.06
			base_refuel = 0.40
		_:
			base_repair = 0.0
			base_refuel = 0.0
	var repair := base_repair * maxf(0.25, 1.0 - precip * 0.55)
	var refuel := base_refuel * maxf(0.4, 1.0 - precip * 0.3)
	var label := "Basing repair · %s · org %.3f/d (storm %.0f%%)" % [level, repair, precip * 100.0]
	return {
		"basing_level": level,
		"repair_org_rate": repair,
		"refuel_rate": refuel,
		"summary": label,
		"bbcode": "%s🔧 Basing×wx[/color] %s— %s[/color]" % [COLOR_TECH, COLOR_MUTED, label],
		"empty": level == "none",
		"integration": ["basing", "weather"],
	}


static func sealane_joint_health(
	sea_trade_mult: float = 1.0,
	escort_coverage: float = 1.0,
	recommend_wait: bool = false,
	ground_state: String = "dry",
	precip: float = 0.0,
	route_risk: float = 0.0,
) -> Dictionary:
	var trade: Dictionary = trade_supply_weather_chain(sea_trade_mult, ground_state, precip, route_risk)
	var escort_ok := 1.0 if escort_coverage >= 0.8 else 0.65
	if recommend_wait:
		escort_ok *= 0.85
	var score := float(trade.get("health", 1.0)) * escort_ok
	var label := "Sealane health ×%.2f (trade ×%.2f · escort %.0f%%)" % [score, float(trade.get("health", 1.0)), escort_ok * 100.0]
	return {
		"score": score,
		"summary": label,
		"bbcode": "%s🌊 Sealane[/color] %s— %s[/color]" % [COLOR_TECH, COLOR_MUTED, label],
		"empty": false,
		"integration": ["convoy_package", "trade_chain"],
	}


static func reinforced_assault_loop(
	targets: Array,
	attacker_power: float = 100.0,
	attacker_supply: float = 1.0,
	visibility: float = 1.0,
	precip: float = 0.0,
	ground_state: String = "dry",
	wind: float = 0.2,
	month: int = 1,
	is_choke: bool = false,
	controller_friendly: bool = true,
) -> Dictionary:
	var ready: Dictionary = assault_readiness_compose(
		targets, attacker_power, attacker_supply, visibility, precip, ground_state, wind
	)
	var day: Dictionary = daylight_combat_mod(month)
	var choke: Dictionary = choke_weather_synergy(is_choke, controller_friendly, visibility, precip)
	var base := 0.3
	if not bool(ready.get("empty", true)):
		var ranked: Dictionary = ready.get("ranked", {})
		var best: Dictionary = ranked.get("best", {}) if ranked is Dictionary else {}
		base = float(best.get("overall", 0.5))
	var day_m := float(day.get("combat_mult", 1.0))
	var choke_m := 1.0 if bool(choke.get("empty", false)) else float(choke.get("score", 1.0))
	var score := clampf(base * day_m * (0.85 + 0.15 * choke_m), 0.05, 0.98)
	var label := "Reinforced assault · score %.0f%% (ready %.0f%% · day×%.2f · choke×%.2f)" % [
		score * 100.0, base * 100.0, day_m, choke_m
	]
	return {
		"score": score,
		"summary": label,
		"bbcode": "%s⚔ Reinforced[/color] %s— %s[/color]" % [COLOR_HEADER, COLOR_MUTED, label],
		"empty": bool(ready.get("empty", false)),
		"integration": ["assault_ready", "daylight", "choke"],
	}


static func oob_factory_risk_loop(temp: float = 10.0, precip: float = 0.0, ground_state: String = "dry", visibility: float = 1.0, wind: float = 0.2, base_output: float = 1.0) -> Dictionary:
	var prod := weather_production_multiplier(temp, precip)
	var risk: Dictionary = factory_risk_compose(temp, precip, ground_state, visibility, wind)
	var effective := maxf(0.1, base_output * prod * (1.0 - float(risk.get("risk", 0.0)) * 0.4))
	var label := "OOB factory · out ×%.2f (prod ×%.2f · risk %.0f%%)" % [effective, prod, float(risk.get("risk", 0.0)) * 100.0]
	return {
		"effective_output": effective,
