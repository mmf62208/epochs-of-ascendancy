static func manpower_laws_training_product(province_id: int = 1, law: String = "limited", population_pool: float = 100000.0, training_capacity: float = 0.65) -> Dictionary:
	var base: Dictionary = manpower_reinforcement_product(province_id)
	var law_k := law.strip_edges().to_lower()
	var mult := 0.75
	match law_k:
		"volunteer": mult = 0.55
		"limited": mult = 0.75
		"extensive": mult = 0.95
		"service_by_requirement": mult = 1.15
		_:
			law_k = "limited"
			mult = 0.75
	var eligible := population_pool * 0.12 * mult
	var train_out := eligible * 0.08 * clampf(training_capacity, 0.0, 1.0)
	var trained := 5000.0 + train_out
	var fielded := trained * 0.15
	var pool_score := clampf(eligible / 20000.0, 0.0, 1.0)
	var train_score := clampf(0.4 * training_capacity + 0.6 * clampf(train_out / 800.0, 0.0, 1.0), 0.0, 1.0)
	var field_score := clampf(0.5 * clampf(fielded / 1500.0, 0.0, 1.0) + 0.5 * pool_score, 0.0, 1.0)
	if pool_score < 0.35: pool_score = 0.35
	if train_score < 0.35: train_score = 0.35
	if field_score < 0.35: field_score = 0.35
	var law_score := clampf(0.5 * pool_score + 0.5 * float(base.get("score", 0.5)), 0.0, 1.0)
	if law_score < 0.35: law_score = 0.35
	var score := clampf(0.35 * law_score + 0.35 * train_score + 0.3 * field_score, 0.0, 1.0)
	if score < 0.35: score = 0.35
	var step := "train"
	if train_score >= 0.45 and field_score >= 0.45:
		step = "field"
	var rec := {"step": step, "action_id": "manpower_%s" % ("law_board" if step == "law" else ("train_pipeline" if step == "train" else "field_trained")), "leaf": "apply_focus" if step == "law" else ("apply_production" if step == "train" else "apply_station"), "empty": false, "summary": "Recommend %s" % step}
	var steps: Array = [
		{"step": "law", "action_id": "manpower_law_board", "leaf": "apply_focus", "label": "Step 0 — set conscription law", "score": law_score},
		{"step": "train", "action_id": "manpower_train_pipeline", "leaf": "apply_production", "label": "Step 1 — training camp pipeline", "score": train_score},
		{"step": "field", "action_id": "manpower_field_trained", "leaf": "apply_station", "label": "Step 2 — field trained manpower to OOB", "score": field_score},
	]
	var day_rows: Array = []
	var apply_queue: Array = []
	for i in range(steps.size()):
		var st: Dictionary = steps[i]
		var sn := str(st.get("step"))
		var recommended: bool = sn == step
		var sc := float(st.get("score", 0.5))
		var leaf := str(st.get("leaf"))
		var lab := str(st.get("label"))
		if recommended: lab = "★ " + lab
		lab = "%s · score %.2f" % [lab, sc]
		day_rows.append({"index": i, "step": sn, "action_id": str(st.get("action_id")), "leaf_action": leaf, "label": lab, "score": sc, "enabled": true, "recommended": recommended, "province_id": province_id})
		apply_queue.append({"action_id": leaf, "province_id": province_id, "score": sc, "enabled": true, "label": lab, "step": sn, "product_action": str(st.get("action_id"))})
	var label := "Manpower laws/training · law %s · eligible %.0f · train +%.0f · field %.0f · score %.2f" % [law_k, eligible, train_out, fielded, score]
	return {
		"base": base, "law": law_k, "eligible_manpower": eligible, "training_output": train_out, "trained_stock": trained, "fielded": fielded,
		"recommendation": rec, "day_rows": day_rows, "apply_queue": apply_queue,
		"actions": [{"action_id": "manpower_laws_training_product", "label": "Run manpower laws/training product", "enabled": true}, {"action_id": str(rec.get("action_id")), "label": "Recommended: %s" % step, "enabled": true}],
		"score": score, "manpower_score": score, "province_id": province_id, "summary": label, "plain": label,
		"bbcode": "%s🎖 Manpower laws[/color] %s— %s[/color]" % [COLOR_HEADER, COLOR_MUTED, label], "empty": false,
		"integration": ["manpower_laws_training_product", "manpower_law_board", "manpower_train_pipeline", "manpower_field_trained", "major_30", "manpower", "laws", "training"],
	}

