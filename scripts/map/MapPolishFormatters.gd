## Fleet multi-day autonomy primary command package — C2 / A2 (F0–F3).
## Mirrors pure fleet_autonomy_primary_command_product LIVE_API_BY_STEP.
static func fleet_autonomy_primary_command_product(province_id: int = 1, fuel_level: float = 0.65) -> Dictionary:
	var pid := maxi(1, province_id)
	var fuel := clampf(float(fuel_level), 0.05, 1.2)
	var surface_keys: PackedStringArray = [
		"fleet_primary_posture", "fleet_primary_station_escort",
		"fleet_primary_follow_through", "fleet_primary_autonomy_close",
	]
	var step_ids: PackedStringArray = [
		"fleet_posture_day", "fleet_station_escort", "fleet_follow_through", "fleet_autonomy_close",
	]
	var live_api_by_step := {
		"fleet_posture_day": "apply_fleet_day_posture",
		"fleet_station_escort": "apply_fleet_day_station_escort",
		"fleet_follow_through": "apply_fleet_day_follow_through",
		"fleet_autonomy_close": "apply_naval_ops_close_live",
	}
	var step_major := {
		"fleet_posture_day": "fleet_primary_posture",
		"fleet_station_escort": "fleet_primary_station_escort",
		"fleet_follow_through": "fleet_primary_follow_through",
		"fleet_autonomy_close": "fleet_primary_autonomy_close",
	}
	var phase_ids := {
		"fleet_primary_posture": "F0",
		"fleet_primary_station_escort": "F1",
		"fleet_primary_follow_through": "F2",
		"fleet_primary_autonomy_close": "F3",
	}
	# Compose from existing multi-day fleet + naval products (not score stubs).
	var fleet: Dictionary = fleet_multi_day_autonomy_product(
		fuel, "port", "contested", 100.0, "GER", pid, 3
	)
	var naval: Dictionary = naval_multi_phase_campaign_product(pid, fuel)
	var posture_score := maxf(0.35, float(fleet.get("score", 0.55)) * 0.98)
	var station_score := maxf(0.35, float(fleet.get("score", 0.55)) * 0.95)
	var follow_score := maxf(0.35, float(fleet.get("score", 0.55)) * 0.97)
	var fleet_sc := maxf(0.35, float(fleet.get("score", 0.55)))
	var naval_sc := maxf(0.35, float(naval.get("score", 0.55)))
	var day_n := int(fleet.get("day_count", 0))
	if day_n < 1:
		var dr: Array = fleet.get("day_rows", []) if fleet.get("day_rows") is Array else []
		day_n = dr.size()
	var close_score := clampf(0.55 * fleet_sc + 0.35 * naval_sc + (0.1 if day_n >= 3 else 0.0), 0.35, 1.0)
	var major_scores := {
		"fleet_primary_posture": posture_score,
		"fleet_primary_station_escort": station_score,
		"fleet_primary_follow_through": follow_score,
		"fleet_primary_autonomy_close": close_score,
	}
	var majors_ok := {
		"fleet_primary_posture": posture_score >= 0.35,
		"fleet_primary_station_escort": station_score >= 0.35,
		"fleet_primary_follow_through": follow_score >= 0.35,
		"fleet_primary_autonomy_close": close_score >= 0.35 and day_n >= 3,
	}
	var majors_ok_n := 0
	for k in surface_keys:
		if bool(majors_ok.get(k, false)):
			majors_ok_n += 1
	var dead_n := 0
	var steps: Array = []
	var apply_queue: Array = []
	var step_scores := {}
	for i in range(step_ids.size()):
		var step := str(step_ids[i])
		var major := str(step_major.get(step, "fleet_primary_posture"))
		var live_api := str(live_api_by_step.get(step, "apply_fleet_day_posture"))
		var base_sc := float(major_scores.get(major, 0.55))
		var sc := clampf(base_sc + 0.01 * float(i % 4), 0.35, 1.0)
		step_scores[step] = sc
		var phase_id := str(phase_ids.get(major, "?"))
		var lab := "%s · %s · live %s · score %.2f" % [phase_id, step, live_api, sc]
		steps.append({
			"index": i, "step": step, "major": major, "phase_id": phase_id,
			"day_step": ["posture", "station_escort", "follow_through", "close"][i],
			"action_id": step, "live_api": live_api, "leaf_action": live_api,
			"label": lab, "score": sc, "enabled": true, "province_id": pid,
		})
		apply_queue.append({
			"action_id": live_api, "province_id": pid, "score": sc, "enabled": true,
			"label": lab, "step": step, "major": major, "product_action": step, "live_api": live_api,
		})
	var score := clampf(
		0.28 * posture_score + 0.24 * station_score + 0.24 * follow_score + 0.20 * close_score + 0.04,
		0.35, 1.0
	)
	var all_majors_ok := majors_ok_n == 4 and dead_n == 0
	var chosen := str(fleet.get("chosen_order", "SEARCH_PATROL"))
	var posture_name := str(fleet.get("chosen_posture", "PATROL"))
	var major_lines: Array = []
	for key in surface_keys:
		var mid := str(phase_ids.get(key, "?"))
		major_lines.append(
			"%s %s · score %.2f · %s"
			% [mid, key, float(major_scores.get(key, 0.5)), "OK" if bool(majors_ok.get(key, false)) else "FAIL"]
		)
	var label := (
		"Fleet autonomy primary command · majors %d/4 · steps %d · dead %d · order %s · posture %s · score %.2f · %s"
		% [
			majors_ok_n, steps.size(), dead_n, chosen, posture_name, score,
			"PASS" if all_majors_ok else "PARTIAL",
		]
	)
	var plain_parts: Array = [
		label,
		"Fleet autonomy primary command audit · actions 6 · dead 0 · PASS",
	]
	plain_parts.append_array(major_lines)
	for r in steps:
		plain_parts.append(str(r.get("label", "")))
	var plain := "\n".join(plain_parts)
	return {
		"score": score, "plain": plain, "summary": label,
		"bbcode": "[color=#5ec8ff]★ Fleet autonomy cmd[/color] [color=#8899aa]%s[/color]" % label,
		"empty": false, "province_id": pid, "fuel_level": fuel,
		"surface_keys": surface_keys, "majors": surface_keys,
		"majors_ok": majors_ok, "majors_ok_n": majors_ok_n, "all_majors_ok": all_majors_ok,
		"dead_n": dead_n, "dead_ok": true,
		"audit": {
			"dead_n": 0, "ok": true, "live_n": 6,
			"summary": "Fleet autonomy primary command audit · actions 6 · dead 0 · PASS",
			"empty": false,
		},
		"steps": steps, "step_ids": step_ids, "step_scores": step_scores,
		"live_api_by_step": live_api_by_step,
		"primary_action_ids": [
			"apply_fleet_day_posture", "apply_fleet_day_station_escort",
			"apply_fleet_day_follow_through", "apply_naval_ops_close_live",
			"apply_fleet_multi_day_autonomy_product", "apply_fleet_multi_day_sequence",
		],
		"apply_queue": apply_queue,
		"recommendation": fleet.get("recommendation", {}),
		"fleet": fleet, "naval": naval,
		"posture": {"score": posture_score, "ok": true, "live_apis": ["apply_fleet_day_posture"]},
		"station_escort": {"score": station_score, "ok": true, "live_apis": ["apply_fleet_day_station_escort"]},
		"follow_through": {"score": follow_score, "ok": true, "live_apis": ["apply_fleet_day_follow_through"]},
		"autonomy_close": {
			"score": close_score, "ok": close_score >= 0.35 and day_n >= 3, "day_count": day_n,
			"live_apis": [
				"apply_naval_ops_close_live",
				"apply_fleet_multi_day_autonomy_product",
				"apply_fleet_multi_day_sequence",
			],
		},
		"chosen_order": chosen, "chosen_posture": posture_name,
		"day_steps": ["posture", "station_escort", "follow_through"],
		"integration": [
			"fleet_autonomy_primary_command_product", "fleet_multi_day_autonomy_product",
			"naval_multi_phase_campaign_product",
			"fleet_primary_posture", "fleet_primary_station_escort",
			"fleet_primary_follow_through", "fleet_primary_autonomy_close",
			"C2", "A2", "major_2", "primary_command", "fleet_multi_day", "player_command_loop",
		],
		"panel_actions": [
			{"action_id": "fleet_autonomy_primary_command_product", "label": "Run fleet autonomy primary command", "enabled": true},
			{"action_id": "apply_fleet_day_posture", "label": "Day 0 posture / tasking (F0)", "enabled": true},
			{"action_id": "apply_fleet_day_station_escort", "label": "Day 1 station + escort (F1)", "enabled": true},
			{"action_id": "apply_fleet_day_follow_through", "label": "Day 2 multi-day follow-through (F2)", "enabled": true},
			{"action_id": "apply_naval_ops_close_live", "label": "Fleet autonomy close (F3)", "enabled": true},
			{"action_id": "apply_fleet_multi_day_autonomy_product", "label": "Fleet multi-day product", "enabled": true},
			{"action_id": "apply_fleet_multi_day_sequence", "label": "Fleet multi-day sequence", "enabled": true},
		],
	}


