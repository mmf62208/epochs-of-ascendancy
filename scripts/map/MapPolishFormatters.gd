## Fleet-ops pilot: score basing dict for station preference (mirrors naval_fleet_ops.py).
## has_treaty_basing: guest has DOCKING_RIGHTS edge on this host province (TradeManager basing graph).
static func score_fleet_station_candidate(
	basing: Dictionary,
	is_owned: bool = true,
	is_enemy: bool = false,
	distance_penalty: float = 0.0,
	has_treaty_basing: bool = false,
) -> Dictionary:
	var lv := str(basing.get("level", "none"))
	var cap := int(basing.get("capacity", 0))
	var rank := 0
	match lv:
		"anchorage":
			rank = 1
		"port":
			rank = 2
		"major_base":
			rank = 3
		_:
			rank = 0
	var rates: Dictionary = basing_repair_refuel_rates(basing)
	var score := float(rank * 100 + cap * 2)
	if bool(rates.get("can_service", false)):
		score += float(rates.get("refuel_rate", 0.0)) * 50.0
		score += float(rates.get("repair_org_rate", 0.0)) * 100.0
	var treaty := has_treaty_basing and not is_owned
	if not is_owned:
		if treaty:
			score *= 0.88
			score += 40.0
		else:
			score *= 0.35
	if is_enemy and not treaty:
		score = -absf(score) - 50.0
	if lv == "none":
		score = minf(score, 0.0)
	score -= maxf(0.0, distance_penalty)
	return {
		"province_id": int(basing.get("province_id", 0)),
		"level": lv,
		"capacity": cap,
		"score": score,
		"can_service": bool(rates.get("can_service", false)),
		"refuel_rate": float(rates.get("refuel_rate", 0.0)),
		"label": str(basing.get("label", lv)),
		"is_owned": is_owned,
		"is_enemy": is_enemy,
		"has_treaty_basing": treaty,
	}


## Multi-phase combat estimate pilot (approach/engage/disengage).
static func estimate_multi_phase_combat(
	attacker_power: float,
	defender_power: float,
	attacker_supply: float = 1.0,
	weather_mult: float = 1.0,
) -> Dictionary:
	var phases := ["approach", "engage", "disengage"]
	var atk_m := {"approach": 0.85, "engage": 1.15, "disengage": 0.70}
	var def_m := {"approach": 1.05, "engage": 1.00, "disengage": 1.10}
	var results: Array = []
	var atk := maxf(0.0, attacker_power)
	var dfn := maxf(0.0, defender_power)
	var wins: Array = []
	for p in phases:
		# Weather hurts attacker more (offensive tempo); defender keeps phase mod only.
		var ae := atk * float(atk_m[p]) * maxf(0.2, attacker_supply) * maxf(0.2, weather_mult)
		var de := dfn * float(def_m[p])
		var ratio := ae / de if de > 0.0001 else (2.0 if ae > 0.0 else 0.0)
		var win := clampf(0.5 + (ratio - 1.0) * 0.25, 0.05, 0.95)
		results.append({
			"phase": p,
			"attacker_effective": ae,
			"defender_effective": de,
			"power_ratio": ratio,
			"attacker_win_chance": win,
		})
		wins.append(win)
		if win >= 0.5:
			dfn *= 0.92
			atk *= 0.97
		else:
			atk *= 0.90
			dfn *= 0.98
	var overall := 0.0
	for w in wins:
		overall += float(w)
	overall /= float(maxi(wins.size(), 1))
	var approach_w := float(results[0]["attacker_win_chance"]) if results.size() > 0 else 0.0
	var engage_w := float(results[1]["attacker_win_chance"]) if results.size() > 1 else 0.0
	return {
		"phases": results,
		"overall_attacker_win_chance": overall,
		"approach_win_chance": approach_w,
		"engage_win_chance": engage_w,
		"summary": "multi-phase %.0f%% (approach %.0f%% · engage %.0f%%)" % [overall * 100.0, approach_w * 100.0, engage_w * 100.0],
		"empty": results.is_empty(),
	}


## Play data dir operator helper (mirrors play_data_dir.py).
static func resolve_play_data_dir(scenario_id: String = "", explicit_dir: String = "") -> Dictionary:
	var scenario := scenario_id.strip_edges().to_lower()
	var explicit := explicit_dir.strip_edges()
	if "/" in explicit:
		explicit = explicit.get_file()
	var chosen := "provinces_world_full"
	var source := "default"
	if not explicit.is_empty():
		chosen = explicit
		source = "explicit"
	elif scenario in ["world_full", "world", "full_world"]:
		chosen = "provinces_world_full"
		source = "scenario"
	elif scenario in ["grand_theater", "grand"]:
		chosen = "provinces_grand_theater"
		source = "scenario"
	elif scenario in ["full_europe", "europe"]:
		chosen = "provinces_full_europe"
		source = "scenario"
	var is_default := chosen == "provinces_world_full"
	var warning := ""
	if chosen in ["provinces", "provinces_phase1_test"]:
		warning = "legacy/test data dir — not default world_full play board"
	elif not is_default:
		warning = "secondary theater — default F5 play is provinces_world_full"
	return {
		"data_dir": chosen,
		"source": source,
		"is_default_play": is_default,
		"warning": warning,
		"summary": "play data_dir=%s (via %s)" % [chosen, source],
	}


## Fleet tasking pilot: rank naval orders by basing + zone relation (not full fleet AI).
static func rank_naval_orders(
	basing_level: String = "none",
	basing_capacity: int = 0,
	zone_relation: String = "no_zone",
	fuel_level: float = 1.0,
) -> Dictionary:
	var orders := ["SEARCH_PATROL", "ESCORT", "ASW", "STRIKE", "AMBUSH", "SEARCH_AND_DESTROY"]
	var ranked: Array = []
	for o in orders:
		var base := 50.0
		match o:
			"SEARCH_PATROL":
				base = 50.0
			"ESCORT":
				base = 48.0
			"ASW":
				base = 45.0
			"STRIKE":
				base = 55.0
			"AMBUSH":
				base = 40.0
			"SEARCH_AND_DESTROY":
				base = 52.0
		var rank := 0
		match basing_level:
			"anchorage":
				rank = 1
			"port":
				rank = 2
			"major_base":
				rank = 3
			_:
				rank = 0
		if rank >= 3 and o in ["STRIKE", "SEARCH_AND_DESTROY"]:
			base += 25.0
		elif rank >= 2 and o in ["ESCORT", "SEARCH_PATROL"]:
			base += 15.0
		elif rank >= 1 and o in ["SEARCH_PATROL", "AMBUSH"]:
			base += 12.0
		elif rank == 0 and o in ["STRIKE", "SEARCH_AND_DESTROY"]:
			base -= 20.0
		var rel := zone_relation.strip_edges().to_lower()
		if rel == "hostile" and o in ["STRIKE", "SEARCH_AND_DESTROY", "AMBUSH"]:
			base += 18.0
		elif rel == "contested" and o in ["ESCORT", "ASW", "SEARCH_PATROL"]:
			base += 16.0
		elif rel == "friendly" and o in ["SEARCH_PATROL", "ASW"]:
			base += 10.0
		var fuel := clampf(fuel_level, 0.1, 1.2)
		if fuel < 0.45 and o in ["STRIKE", "SEARCH_AND_DESTROY"]:
			base -= 25.0
		base += float(basing_capacity) * 0.3
		base *= 0.85 + 0.15 * fuel
		ranked.append({"order": o, "score": base})
	ranked.sort_custom(func(a, b): return float(a["score"]) > float(b["score"]))
	var best: Dictionary = ranked[0] if ranked.size() > 0 else {}
	return {
		"best_order": str(best.get("order", "")),
		"best_score": float(best.get("score", 0.0)),
		"ranked": ranked,
		"summary": "Fleet tasking prefer %s (score %.1f)" % [best.get("order", "?"), float(best.get("score", 0.0))],
		"empty": ranked.is_empty(),
	}


## Multi-phase combat phase ribbon UI labels.
static func format_phase_ribbon(estimate: Dictionary = {}) -> Dictionary:
	var est := estimate
	if est.is_empty() or bool(est.get("empty", false)):
		est = estimate_multi_phase_combat(100.0, 80.0)
	var labels: PackedStringArray = []
	var phases: Array = est.get("phases", [])
	for r in phases:
		var phase := str(r.get("phase", "engage"))
		var win := float(r.get("attacker_win_chance", 0.0))
		var icon := "⚔"
		match phase:
			"approach":
				icon = "↗"
			"disengage":
				icon = "↘"
			_:
				icon = "⚔"
		labels.append("%s %s %.0f%%" % [icon, phase, win * 100.0])
	var ribbon := " → ".join(labels)
	return {
		"labels": labels,
		"ribbon_plain": ribbon,
		"bbcode": "[color=#ff9a6e]⚔ Phase ribbon[/color] [color=#8899aa]%s[/color]" % ribbon,
		"empty": labels.is_empty(),
		"summary": ribbon,
	}


## Focus pick priority pilot (ordered available focuses).
static func rank_focus_picks(focuses: Array, completed_ids: Array = [], year: int = 1936) -> Dictionary:
	var scored: Array = []
	var done: Dictionary = {}
	for c in completed_ids:
		done[str(c)] = true
	for f in focuses:
		if typeof(f) != TYPE_DICTIONARY:
			continue
		var d: Dictionary = f
		var fid := str(d.get("id", d.get("focus_id", "")))
		var name := str(d.get("name", d.get("title", fid)))
		var cost := float(d.get("cost", d.get("days", 70)))
		var prereqs: Array = d.get("prerequisites", d.get("requires", []))
		var prereq_ok := true
		for p in prereqs:
			if not done.has(str(p)):
				prereq_ok = false
				break
		var era_min := int(d.get("era_min", d.get("available_year", 1918)))
		var era_max := int(d.get("era_max", 2026))
		var era_ok := year >= era_min and year <= era_max
		var score := 100.0
		var available := true
		if done.has(fid):
			score = -200.0
			available = false
		elif not prereq_ok:
			score = -100.0
			available = false
		elif not era_ok:
			score = -50.0
			available = false
		else:
			score += maxf(0.0, 40.0 - absf(cost - 70.0) * 0.25)
		scored.append({
			"id": fid,
			"name": name,
			"score": score,
			"cost": cost,
			"available": available,
		})
	scored.sort_custom(func(a, b): return float(a["score"]) > float(b["score"]))
	var picks: Array = []
	for s in scored:
		if bool(s.get("available", false)):
			picks.append(s)
		if picks.size() >= 5:
			break
	var best: Dictionary = picks[0] if picks.size() > 0 else {}
	return {
		"best_id": str(best.get("id", "")),
		"best_name": str(best.get("name", "")),
		"best_score": float(best.get("score", 0.0)),
		"picks": picks,
		"count": picks.size(),
		"empty": picks.is_empty(),
		"summary": "Focus pick: %s" % str(best.get("name", "none")),
	}


