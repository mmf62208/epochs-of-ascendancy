static func execution_integrity_gate(
	sea_mult: float = 1.1,
	weather_mult: float = 0.8,
	route_risk: float = 0.2,
	order_mult: float = 1.0,
) -> Dictionary:
	var sole: Dictionary = sole_mult_integrity(sea_mult, weather_mult, route_risk)
	var coh: Dictionary = cohesion_integrity_gate(sea_mult, weather_mult, route_risk)
	var sole_ok := bool(sole.get("integrity_ok", false))
	var coh_ok := bool(coh.get("ok", false))
	var sole_health := float(sole.get("sole_health", 0.5)) * clampf(order_mult, 0.1, 1.4)
	var stacked := sole_health * clampf(order_mult, 0.1, 1.4)
	var order_ok := true
	if absf(order_mult - 1.0) > 0.05:
		order_ok = absf(stacked - sole_health) > 0.01
	var ok := sole_ok and coh_ok and order_ok
	var label := "Execution integrity %s (sole=%s coh=%s order=%s)" % [
		"PASS" if ok else "FAIL",
		"ok" if sole_ok else "fail",
		"ok" if coh_ok else "fail",
		"ok" if order_ok else "fail",
	]
	return {
		"ok": ok,
		"summary": label,
		"bbcode": "%s✓ Exec integrity[/color] %s— %s[/color]" % [COLOR_HEADER, COLOR_MUTED, label],
		"empty": false,
		"integration": ["sole_mult", "cohesion", "order_mult"],
	}

