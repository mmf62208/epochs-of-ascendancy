		"tint_key": tint_key,
		"marker": marker,
		"color_hint": color_hint,
		"strength": strength,
		"is_choke": is_choke,
		"zone_relation": zone,
		"controller_tag": tag,
		"contest": contest,
		"score": float(skim.get("score", 0.5)),
		"mapmode_hint": "naval",
		"summary": label,
		"plain": label,
		"bbcode": "[color=%s]%s Sealane visual[/color] %s— %s[/color]" % [color_hint, marker, COLOR_MUTED, label],
		"empty": false,
		"integration": ["naval_mapmode", "choke_glyph", "sealane_contest"],
	}



## GPU pan/zoom day (soft advisory profile; no hard gate).
static func gpu_pan_zoom_day(
	province_count: int = 2665,
	zoom: float = 0.45,
	cull_margin: float = 192.0,
	resource_icon_budget: int = 180,
	label_budget: int = 140,
) -> Dictionary:
	var z := clampf(zoom, 0.05, 2.0)
	var n := maxi(1, province_count)
	var icon_base := resource_icon_budget(z, n)
	var icon_eff := int(float(icon_base) * (0.6 + 0.8 * clampf(z, 0.1, 1.0)))
	var label_eff := int(float(label_budget) * (0.5 + 0.9 * clampf(z, 0.1, 1.0)))
	var load := (float(n) / 2665.0) * (0.4 + 0.6 * z)
	var cull := cull_margin * (1.1 if load > 0.85 else 1.0)
	var score := clampf(1.0 - load * 0.35, 0.1, 1.0)
	var advice: Array = []
	if load >= 0.9:
		advice.append("tighten_cull")
		advice.append("reduce_icons")
	elif load >= 0.75:
		advice.append("cap_icons_at_operational")
	if z < 0.28:
		advice.append("hide_detail_icons")
	if z >= 0.75:
		advice.append("allow_icon_boost")
	if advice.is_empty():
		advice.append("profile_ok")
	var apply_queue: Array = [
		{"action_id": "refresh_queue", "province_id": 1, "score": maxf(0.3, score), "enabled": true, "label": "Refresh order queue (advisory)"},
	]
	var label := "GPU pan/zoom day · zoom %.2f · load %.0f%% · icons %d · labels %d · cull %.0f · %s" % [
		z, load * 100.0, icon_eff, label_eff, cull, ",".join(advice.slice(0, mini(3, advice.size())))
	]
	return {
		"province_count": n,
		"zoom": z,
		"load": load,
		"resource_icon_budget": icon_eff,
		"label_budget": label_eff,
		"cull_margin": cull,
		"advice": advice,
		"deferred_hard_gate": true,
		"score": score,
		"apply_queue": apply_queue,
		"actions": [{"action_id": "gpu_pan_zoom_day", "label": "Review GPU pan/zoom day", "enabled": true}],
		"summary": label,
		"plain": label,
		"bbcode": "%s🖥 GPU pan/zoom day[/color] %s— %s[/color]" % [COLOR_TECH, COLOR_MUTED, label],
		"empty": false,
		"integration": ["pan_zoom", "lod", "advisory"],
	}


