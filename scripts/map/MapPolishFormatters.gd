## Infra / special-site consistency skim.
static func infra_site_consistency_skim(
	infrastructure: float = 50.0,
	site_count: int = 0,
	site_damaged: int = 0,
	project_active: int = 0,
	project_sabotaged: int = 0,
	facility_tier: String = "full",
	province_id: int = 1,
) -> Dictionary:
	var infra := clampf(infrastructure, 0.0, 100.0)
	var sites := maxi(0, site_count)
	var damaged := clampi(site_damaged, 0, sites)
	var projects := maxi(0, project_active)
	var sabo := maxi(0, project_sabotaged)
	var tier := facility_tier.strip_edges().to_lower()
	if tier.is_empty():
		tier = "none"
	var issues: Array = []
	if sites >= 1 and infra < 20.0:
		issues.append("sites_on_low_infra")
	if damaged > 0 and sabo == 0 and damaged >= sites and sites > 0:
		issues.append("all_sites_damaged")
	if projects > 0 and infra < 15.0:
		issues.append("project_on_low_infra")
	if tier in ["none", ""] and (sites > 0 or projects > 0):
		issues.append("facility_tier_mismatch")
	if sabo > projects:
		issues.append("sabo_exceeds_projects")
	var consistency := 1.0 - 0.18 * float(issues.size())
	if damaged > 0:
		consistency -= 0.05 * float(mini(3, damaged))
	consistency = clampf(consistency, 0.05, 1.0)
	var label := "Infra/site skim · #%d · infra %.0f · sites %d (dmg %d) · projects %d (sabo %d) · tier %s · issues %d" % [
		province_id, infra, sites, damaged, projects, sabo, tier, issues.size()
	]
	return {
		"province_id": province_id,
		"infrastructure": infra,
		"site_count": sites,
		"site_damaged": damaged,
		"project_active": projects,
		"project_sabotaged": sabo,
		"facility_tier": tier,
		"issues": issues,
		"issue_count": issues.size(),
		"consistency": consistency,
		"score": consistency,
		"ok": issues.is_empty(),
		"summary": label,
		"plain": label + (" · " + ", ".join(issues) if not issues.is_empty() else " · consistent"),
		"bbcode": "%s🏗 Infra/site skim[/color] %s— %s[/color]" % [COLOR_WARN, COLOR_MUTED, label],
		"empty": false,
	}



## HH agenda screen day (product sections + player-path apply queue).
static func hh_agenda_screen_day(trail: Array = [], province_id: int = 1, year: int = 1936, month: int = 6) -> Dictionary:
	if trail.is_empty():
		return {"empty": true, "plain": "", "bbcode": "", "summary": "", "score": 0.0, "apply_queue": [], "actions": [], "sections": []}
	var product: Dictionary = hh_agenda_product_screen(trail) if true else {}
	# Prefer product screen when available; else build minimal from trail + player path
	if product.is_empty() or bool(product.get("empty", false)):
		# Fallback compose from screen package helpers already in this file
		var path: Dictionary = hh_agenda_player_path(trail, province_id, 3)
		if bool(path.get("empty", false)):
			return {"empty": true, "plain": "", "bbcode": "", "summary": "", "score": 0.0, "apply_queue": [], "actions": [], "sections": []}
		var label0 := "HH agenda screen day · trail %d · q %d · score %.2f" % [
			trail.size(), (path.get("apply_queue", []) as Array).size(), float(path.get("score", 0.4))
		]
		return {
			"product": {},
			"player_path": path,
			"sections": [{"id": "trail", "title": "Agenda trail", "lines": ["trail %d" % trail.size()]}],
			"trail_count": trail.size(),
			"apply_queue": path.get("apply_queue", []),
			"score": float(path.get("score", 0.4)),
			"actions": [{"action_id": "hh_agenda_screen_day", "label": "Run HH agenda screen day", "enabled": true}],
			"summary": label0,
			"plain": label0,
			"bbcode": "%s📜 HH agenda screen day[/color] %s— %s[/color]" % [COLOR_HEADER, COLOR_MUTED, label0],
			"empty": false,
		}
	var path2: Dictionary = hh_agenda_player_path(trail, province_id, 3)
	var apply_queue: Array = []
	for q in path2.get("apply_queue", []):
		if q is Dictionary and bool(q.get("enabled", true)):
			apply_queue.append(q)
	if apply_queue.is_empty():
		apply_queue.append({"action_id": "apply_hh_commit", "province_id": -1, "score": 0.4, "enabled": true, "label": "Commit HH agenda"})
	var sections: Array = product.get("sections", [])
	var score: float = (float(product.get("score", 0.4)) + float(path2.get("score", 0.4))) / 2.0
	var label := "HH agenda screen day · trail %d · sections %d · q %d · score %.2f" % [
		trail.size(), sections.size(), apply_queue.size(), score
	]
	return {
		"product": product,
		"player_path": path2,
		"sections": sections,
		"trail_count": trail.size(),
		"apply_queue": apply_queue,
		"score": score,
		"actions": [{"action_id": "hh_agenda_screen_day", "label": "Run HH agenda screen day", "enabled": not apply_queue.is_empty()}],
		"summary": label,
		"plain": label,
		"bbcode": "%s📜 HH agenda screen day[/color] %s— %s[/color]" % [COLOR_HEADER, COLOR_MUTED, label],
		"empty": false,
		"integration": ["hh_agenda_screen", "player_path", "apply_hh_commit"],
	}


## Fleet autonomy day (multi-province apply queue).
static func fleet_autonomy_day(
	province_ids: Array = [],
	fuel_level: float = 0.65,
	basing_level: String = "port",
	zone_relation: String = "contested",
	available_strength: float = 100.0,
	country_tag: String = "ENG",
	max_applies: int = 3,
) -> Dictionary:
	var ids: Array = []
	for p in province_ids:
		var pid := int(p)
		if pid >= 0:
			ids.append(pid)
	if ids.is_empty():
		ids = [1, 2, 3]
	var plan: Dictionary = fleet_autonomy_plan(ids.size(), fuel_level, basing_level, zone_relation, available_strength, country_tag)
	var fuel := clampf(fuel_level, 0.05, 1.2)
	var apply_ready := bool(plan.get("apply_ready", fuel >= 0.35))
	var chosen := str(plan.get("chosen_order", plan.get("best_order", "SEARCH_PATROL")))
	var score := float(plan.get("score", 0.45))
	if score > 2.0:
		score = clampf(score / 100.0, 0.0, 1.0)
	var apply_queue: Array = []
	var n := mini(max_applies, ids.size())
	for i in range(n):
		var pid2 := int(ids[i])
		if fuel < 0.4 or chosen.to_upper() in ["ESCORT", "REFUEL", "HOLD_BASE"]:
			apply_queue.append({"action_id": "apply_supply", "province_id": pid2, "score": maxf(0.35, 1.0 - fuel), "enabled": true})
		apply_queue.append({"action_id": "apply_station", "province_id": pid2, "score": maxf(0.3, score), "enabled": apply_ready or fuel >= 0.25})
	var seen: Dictionary = {}
	var deduped: Array = []
	for q in apply_queue:
		if not (q is Dictionary):
			continue
		var key := "%s:%d" % [str(q.get("action_id", "")), int(q.get("province_id", -1))]
		if seen.has(key):
			continue
		seen[key] = true
		deduped.append(q)
	if deduped.size() > max_applies * 2:
		deduped = deduped.slice(0, max_applies * 2)
	var label := "Fleet autonomy day · order %s · fuel %.0f%% · ports %d · q %d · ready %s" % [
		chosen, fuel * 100.0, ids.size(), deduped.size(), "Y" if apply_ready else "N"
	]
	return {
		"plan": plan,
		"chosen_order": chosen,
		"fuel_level": fuel,
		"province_ids": ids,
		"apply_ready": apply_ready,
		"apply_queue": deduped,
		"score": score,
		"actions": [{"action_id": "fleet_autonomy_day", "label": "Run fleet autonomy day", "enabled": not deduped.is_empty()}],
		"summary": label,
		"plain": "\n".join([label, str(plan.get("summary", ""))]),
		"bbcode": "%s🚢 Fleet autonomy day[/color] %s— %s[/color]" % [COLOR_TECH, COLOR_MUTED, label],
		"empty": false,
		"integration": ["fleet_autonomy", "station", "supply"],
	}


