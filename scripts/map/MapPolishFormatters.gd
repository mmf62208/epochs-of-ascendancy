static func hh_order_commit(trail: Array = [], max_commits: int = 3) -> Dictionary:
	if trail.is_empty():
		return {"empty": true, "order": "", "plain": "", "bbcode": "", "summary": "", "score": 0.0}
	var board: Dictionary = hh_campaign_board(trail, max_commits)
	if bool(board.get("empty", true)):
		return {"empty": true, "order": "", "plain": "", "bbcode": "", "summary": "", "score": 0.0}
	var pick := agenda_execute_pick_from_trail(trail, max_commits)
	var next_line := pick.strip_edges()
	if next_line.is_empty():
		next_line = str(board.get("plain", board.get("summary", "HOLD AGENDA"))).split("\n")[0]
	var order := next_line
	if not order.to_upper().begins_with("COMMIT") and not order.to_upper().begins_with("NEXT"):
		order = "COMMIT %s" % next_line
	elif order.to_upper().begins_with("NEXT"):
		order = "COMMIT %s" % next_line
	var score := float(board.get("score", 0.5))
	var label := "HH order commit · score %.2f" % score
	return {
		"order": order,
		"score": score,
		"summary": label,
