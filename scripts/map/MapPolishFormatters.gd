	var loy := clampf(float(loyalty), 0.0, 1.0)
	var max_d := maxi(1, max_dispatches)
	var surface_keys: PackedStringArray = [
		"agent_primary_board_surface", "agent_primary_dispatch",
		"agent_primary_resolve", "agent_primary_counter_intel", "agent_primary_close",
	]
	var step_ids: PackedStringArray = [
		"board_surface", "dispatch_mission", "resolve_mission", "counter_intel", "close",
	]
	var live_api_by_step := {
		"board_surface": "apply_agent_product_board",
		"dispatch_mission": "apply_agent_product_dispatch",
		"resolve_mission": "apply_agent_missions_day",
		"counter_intel": "apply_agent_product_counterplay",
		"close": "apply_agent_hh_close_day",
	}
