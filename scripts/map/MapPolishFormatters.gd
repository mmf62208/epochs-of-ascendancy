static func theater_day_report_compose(brief_lines: Array = [], log_lines: Array = []) -> Dictionary:
	var lines: PackedStringArray = []
	for ln in brief_lines:
		var s := str(ln).strip_edges()
		if not s.is_empty():
			lines.append(s)
		if lines.size() >= 3:
			break
	for ln in log_lines:
		var s2 := str(ln).strip_edges()
		if not s2.is_empty():
			lines.append(s2)
		if lines.size() >= 6:
			break
	if lines.is_empty():
		return {"empty": true, "plain": "", "bbcode": "", "summary": "", "count": 0}
	var label := "Theater day report · brief + log · %d lines" % lines.size()
	var bb: PackedStringArray = ["%s── Day report ──[/color]" % COLOR_HEADER]
	for ln in lines:
		bb.append("%s· %s[/color]" % [COLOR_MUTED, ln])
	return {
		"lines": Array(lines),
		"count": lines.size(),
		"summary": label,
		"plain": "\n".join(PackedStringArray([label]) + lines),
		"bbcode": "\n".join(bb),
		"empty": false,
		"integration": ["daily_brief", "command_log"],
	}

## --- Ops depth: multi-province live + order panel + combat/fleet depth ---

static func multi_province_live_rank(province_ids: Array = [], max_provinces: int = 4, country_tag: String = "GER", queue_score: float = 0.5, brief_score: float = 0.5) -> Dictionary:
	var seen: Dictionary = {}
	var ranked: Array = []
	for p in province_ids:
		var pid := int(p)
		if pid < 0 or seen.has(pid):
			continue
		seen[pid] = true
		var score := queue_score * (0.85 + 0.03 * float(pid % 5)) + 0.01 * float(pid % 7)
		ranked.append({
			"province_id": pid,
			"score": score,
			"queue_count": 1,
			"brief_score": brief_score,
			"country_tag": country_tag,
		})
	ranked.sort_custom(func(a, b): return float(a.get("score", 0.0)) > float(b.get("score", 0.0)))
	var top: Array = ranked.slice(0, mini(ranked.size(), maxi(1, max_provinces)))
	if top.is_empty():
		return {"empty": true, "top": [], "ranked": [], "count": 0, "summary": "", "plain": ""}
	var label := "Multi-province live · top %d of %d · %s" % [top.size(), ranked.size(), country_tag]
	return {
		"ranked": ranked,
		"top": top,
		"count": top.size(),
		"total": ranked.size(),
		"country_tag": country_tag,
		"score": float(top[0].get("score", 0.0)),
		"summary": label,
		"plain": label,
		"bbcode": "%s🗺 Live multi-prov[/color] %s— %s[/color]" % [COLOR_HEADER, COLOR_MUTED, label],
		"empty": false,
	}


static func order_panel_actions_compose(summaries: Array = []) -> Dictionary:
	## Build action rows from summary strings or dicts with action_id.
	var actions: Array = []
	for s in summaries:
		if s is Dictionary:
			actions.append(s)
		else:
			var t := str(s).strip_edges()
			if t.is_empty():
				continue
			actions.append({"action_id": "row", "label": t, "enabled": true, "score": 0.5})
	if actions.is_empty():
		return {"empty": true, "actions": [], "plain": "", "bbcode": "", "summary": "", "count": 0}
	var label := "Order panel · %d actions" % actions.size()
	var lines: PackedStringArray = []
	for a in actions:
		lines.append("%s · %s" % [str(a.get("action_id", "row")), str(a.get("label", ""))])
	var bb: PackedStringArray = ["%s── Order panel ──[/color]" % COLOR_HEADER]
	for ln in lines:
		bb.append("%s· %s[/color]" % [COLOR_MUTED, ln])
	return {
		"actions": actions,
		"count": actions.size(),
		"score": float(actions[0].get("score", 0.5)),
		"summary": label,
		"plain": "\n".join(PackedStringArray([label]) + lines),
		"bbcode": "\n".join(bb),
		"empty": false,
	}



static func format_combat_phase_ribbon_plain(attacker_power: float = 100.0, defender_power: float = 80.0, attacker_supply: float = 0.85, weather_mult: float = 1.0) -> String:
	var est: Dictionary = estimate_multi_phase_combat(attacker_power, defender_power, attacker_supply, weather_mult)
	return str(est.get("summary", ""))


static func combat_phase_depth_score(attacker_power: float = 100.0, defender_power: float = 80.0, attacker_supply: float = 0.85, weather_mult: float = 1.0) -> Dictionary:
	var est: Dictionary = estimate_multi_phase_combat(attacker_power, defender_power, attacker_supply, weather_mult)
