## Resource icon budget decision (world board tighter).
static func resource_icon_budget(zoom: float, board_size: int) -> int:
	var z := absf(zoom)
	var budget := 220
	if board_size >= 2200:
		budget = 180
	if z < 0.25:
		budget = mini(budget, 80)
	elif z < 0.38:
		budget = mini(budget, 140)
	elif z >= 0.8:
		budget = mini(budget + 40, 260)
	return budget


