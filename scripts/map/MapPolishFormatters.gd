## Combat air–naval joint (mirrors campaign_ops_depth.combat_air_naval_joint).
static func combat_air_naval_joint(
	attacker_power: float = 100.0,
	defender_power: float = 80.0,
	attacker_supply: float = 0.85,
	weather_mult: float = 1.0,
	fuel_level: float = 0.7,
	basing_level: String = "port",
	province_id: int = -1,
	month: int = 6,
) -> Dictionary:
	var combat: Dictionary = multi_phase_combat_ui_product(
		attacker_power, defender_power, attacker_supply, weather_mult, province_id
	)
	# Lightweight air readiness from weather_mult proxy
	var air_eff := clampf(weather_mult * 0.95, 0.25, 1.15)
	var grounded := weather_mult < 0.55
	if grounded:
		air_eff *= 0.4
	var naval: Dictionary = rank_naval_orders(basing_level, 2, "contested", fuel_level)
	var land_s := float(combat.get("score", 0.5))
	var air_s := clampf(air_eff, 0.0, 1.0)
	var naval_s := float(naval.get("best_score", 50.0))
	if naval_s > 2.0:
		naval_s = clampf(naval_s / 100.0, 0.0, 1.0)
	var joint := (land_s * 0.45 + air_s * 0.3 + naval_s * 0.25) * (0.75 if grounded else 1.0)
	var apply_ready := bool(combat.get("apply_ready", false)) and not grounded
	var label := "Combat air-naval joint · land %.0f%% · air %.0f%% · naval %s · score %.2f" % [
		land_s * 100.0, air_s * 100.0, str(naval.get("best_order", "?")), joint
	]
	if province_id >= 0:
		label += " · #%d" % province_id
	return {
		"combat": combat,
		"phase_rows": combat.get("phase_rows", []),
		"naval": naval,
		"air_effective": air_s,
		"grounded": grounded,
		"score": joint,
		"apply_ready": apply_ready,
		"actions": [
			{"action_id": "apply_assault", "label": "Stage joint assault", "enabled": apply_ready},
			{"action_id": "fleet_autonomy", "label": "Support naval tasking", "enabled": fuel_level >= 0.25},
		],
		"summary": label,
		"plain": label,
		"bbcode": "%s⚔✈🚢 Joint combat[/color] %s— %s[/color]" % [COLOR_HEADER, COLOR_MUTED, label],
		"empty": false,
		"month": month,
	}


## Multi-theater fleet day plan (array of {province_ids, fuel_level, basing_level}).
static func fleet_multi_theater_day(
	theater_specs: Array = [],
	default_fuel: float = 0.7,
	country_tag: String = "ENG",
	max_applies: int = 3,
) -> Dictionary:
	if theater_specs.is_empty():
		return {
			"empty": true, "plain": "", "bbcode": "", "summary": "", "score": 0.0,
			"plans": [], "apply_queue": [], "theater_count": 0, "ready_count": 0,
		}
	var plans: Array = []
	var apply_queue: Array = []
	for t in theater_specs:
		if not (t is Dictionary):
			continue
		var ids: Array = t.get("province_ids", t.get("ids", []))
		if ids.is_empty() and t.has("province_id"):
			ids = [int(t.get("province_id"))]
		if ids.is_empty():
			continue
		var fuel := float(t.get("fuel_level", default_fuel))
		var basing := str(t.get("basing_level", "port"))
		var zone := str(t.get("zone_relation", "contested"))
		var plan: Dictionary = fleet_autonomy_plan(ids.size(), fuel, basing, zone, 100.0, country_tag)
		plan["theater_id"] = t.get("theater_id", t.get("id", plans.size()))
		plan["province_ids"] = ids
		plans.append(plan)
		if bool(plan.get("apply_ready", false)) and not bool(plan.get("empty", false)):
			apply_queue.append({
				"province_id": int(ids[0]),
				"action_id": "fleet_autonomy",
				"chosen_order": plan.get("chosen_order"),
				"score": float(plan.get("score", 0.5)),
			})
	if plans.is_empty():
		return {
			"empty": true, "plain": "", "bbcode": "", "summary": "", "score": 0.0,
			"plans": [], "apply_queue": [], "theater_count": 0, "ready_count": 0,
		}
	apply_queue.sort_custom(func(a, b): return float(a.get("score", 0.0)) > float(b.get("score", 0.0)))
	if apply_queue.size() > max_applies:
		apply_queue = apply_queue.slice(0, max_applies)
	var mean := 0.0
	var ready_n := 0
	for p in plans:
		mean += float(p.get("score", 0.0))
		if bool(p.get("apply_ready", false)):
			ready_n += 1
	mean /= float(maxi(plans.size(), 1))
	var label := "Fleet multi-theater day · %d theaters · ready %d · queue %d · score %.2f" % [
		plans.size(), ready_n, apply_queue.size(), mean
	]
	return {
		"plans": plans,
		"apply_queue": apply_queue,
		"ready_count": ready_n,
		"theater_count": plans.size(),
		"score": mean,
		"actions": [{
			"action_id": "fleet_multi_day",
			"label": "Apply multi-theater fleet day",
			"enabled": not apply_queue.is_empty(),
		}],
		"summary": label,
		"plain": label,
		"bbcode": "%s🚢 Multi-theater fleet[/color] %s— %s[/color]" % [COLOR_HEADER, COLOR_MUTED, label],
		"empty": false,
	}


## Naval multi-phase combat estimate (search→detect→engage→disengage).
static func estimate_naval_multi_phase(
	attacker_power: float = 100.0,
	defender_power: float = 80.0,
	visibility: float = 1.0,
	fuel_level: float = 0.8,
	sub_heavy: bool = false,
	chokepoint: bool = false,
	attacker_order: String = "SEARCH_PATROL",
) -> Dictionary:
	var vis := clampf(visibility, 0.15, 1.2)
	var fuel := clampf(fuel_level, 0.1, 1.2)
	var atk := maxf(0.0, attacker_power) * (0.85 + 0.15 * fuel)
	var dfn := maxf(0.0, defender_power)
	var order := attacker_order.strip_edges().to_upper()
	if order.is_empty():
		order = "SEARCH_PATROL"
	var spot := 0.55 * vis
	if order in ["SEARCH_PATROL", "SEARCH_AND_DESTROY", "STRIKE"]:
		spot *= 1.25
	if chokepoint:
		spot *= 1.2
	if sub_heavy:
		spot *= 0.85
	var search_win := clampf(spot, 0.08, 0.92)
	var detect_win := clampf(search_win * (0.7 + 0.3 * vis), 0.08, 0.92)
	if order == "AMBUSH":
		detect_win = clampf(detect_win * 0.9, 0.08, 0.92)
	var ratio := (atk * detect_win) / maxf(dfn * 0.5 + dfn * (1.0 - detect_win) * 0.5, 0.0001)
	var engage_win := clampf(0.5 + (ratio - 1.0) * 0.22, 0.05, 0.95)
	if fuel < 0.4:
		engage_win *= 0.85
	if sub_heavy and order in ["ASW", "SEARCH_AND_DESTROY"]:
		engage_win = minf(0.95, engage_win * 1.08)
	var dis_base := 0.55 if engage_win < 0.45 else 0.35
	if fuel < 0.45:
		dis_base += 0.15
	var dis_win := clampf(dis_base, 0.1, 0.9)
	var phase_rows: Array = [
		{"phase": "search", "win_chance": search_win, "label": "search · spot %.0f%%" % (search_win * 100.0)},
		{"phase": "detect", "win_chance": detect_win, "label": "detect · %.0f%%" % (detect_win * 100.0)},
		{"phase": "engage", "win_chance": engage_win, "label": "engage · win %.0f%% · ratio %.2f" % [engage_win * 100.0, ratio]},
		{"phase": "disengage", "win_chance": dis_win, "label": "disengage · %.0f%%" % (dis_win * 100.0)},
	]
	var overall := (search_win + detect_win + engage_win) / 3.0
	var score := overall * (0.9 + 0.1 * fuel)
	var label := "Naval multi-phase · overall %.0f%% · %s · fuel %.0f%%" % [overall * 100.0, order, fuel * 100.0]
	return {
		"phase_rows": phase_rows,
		"phase_count": phase_rows.size(),
		"overall": overall,
		"score": score,
		"apply_ready": overall >= 0.35 and fuel >= 0.25,
		"actions": [{"action_id": "fleet_autonomy", "label": "Apply naval posture", "enabled": fuel >= 0.25}],
		"summary": label,
		"plain": label + "\n" + str(phase_rows[0].get("label", "")) + "\n" + str(phase_rows[2].get("label", "")),
		"bbcode": "%s⚓ Naval multi-phase[/color] %s— %s[/color]" % [COLOR_HEADER, COLOR_MUTED, label],
		"empty": false,
	}


## HH agenda product screen (empty trail → empty).
static func hh_agenda_product_screen(trail: Array = [], counterplay_summary: String = "") -> Dictionary:
	if trail.is_empty():
		return {"empty": true, "plain": "", "bbcode": "", "summary": "", "score": 0.0, "sections": [], "actions": []}
	var recent: Array = []
	var class_counts: Dictionary = {}
	for e in trail:
		if not (e is Dictionary):
			continue
		var ac := str(e.get("action_class", e.get("class", "signal"))).strip_edges()
		if ac.is_empty():
			ac = "signal"
		class_counts[ac] = int(class_counts.get(ac, 0)) + 1
		var line := str(e.get("summary", e.get("order", ac))).strip_edges()
		if line.is_empty():
			line = ac
		recent.append(line)
		if recent.size() >= 6:
			break
	if recent.is_empty():
		return {"empty": true, "plain": "", "bbcode": "", "summary": "", "score": 0.0, "sections": [], "actions": []}
	var by_class: Array = []
	for k in class_counts.keys():
		by_class.append("%s ×%d" % [str(k), int(class_counts[k])])
	var sections: Array = [
		{"id": "header", "title": "Hidden Hand Agenda", "lines": ["Trail %d entries" % trail.size()]},
		{"id": "recent", "title": "Recent", "lines": recent},
		{"id": "by_class", "title": "By class", "lines": by_class},
	]
	if not counterplay_summary.strip_edges().is_empty():
		sections.append({"id": "actions", "title": "Suggested counterplay", "lines": [counterplay_summary.strip_edges()]})
	var score := clampf(0.15 * float(trail.size()) + 0.3, 0.1, 1.0)
	var label := "HH agenda product · trail %d · sections %d · score %.2f" % [trail.size(), sections.size(), score]
	var plain_lines: PackedStringArray = [label]
	for sec in sections:
		plain_lines.append("## %s" % str(sec.get("title", "")))
		for ln in sec.get("lines", []):
			if str(ln).strip_edges() != "":
				plain_lines.append(str(ln))
	return {
		"sections": sections,
		"trail_len": trail.size(),
		"score": score,
		"actions": [
			{"action_id": "apply_hh_commit", "label": "Commit HH agenda", "enabled": true},
			{"action_id": "apply_counterplay", "label": "Apply counter-intel", "enabled": true},
		],
		"summary": label,
		"plain": "\n".join(plain_lines),
		"bbcode": "%s📜 HH product[/color] %s— %s[/color]" % [COLOR_HEADER, COLOR_MUTED, label],
		"empty": false,
	}


## Joint land+naval combat timeline.
static func joint_combat_timeline(
	attacker_power: float = 100.0,
	defender_power: float = 80.0,
	attacker_supply: float = 0.85,
	weather_mult: float = 1.0,
	fuel_level: float = 0.75,
	visibility: float = 1.0,
) -> Dictionary:
	var land: Dictionary = multi_phase_combat_ui_product(
		attacker_power, defender_power, attacker_supply, weather_mult, -1
	)
	var naval: Dictionary = estimate_naval_multi_phase(
		attacker_power * 0.9, defender_power * 0.85, visibility, fuel_level, false, false, "SEARCH_PATROL"
	)
	var timeline: Array = []
	for row in land.get("phase_rows", []):
		if row is Dictionary:
			timeline.append({
				"domain": "land",
				"phase": row.get("phase"),
				"win_chance": row.get("win_chance"),
				"label": "land/%s" % str(row.get("label", row.get("phase", ""))),
			})
	for row in naval.get("phase_rows", []):
		if row is Dictionary:
			timeline.append({
				"domain": "naval",
				"phase": row.get("phase"),
				"win_chance": row.get("win_chance"),
				"label": "naval/%s" % str(row.get("label", row.get("phase", ""))),
			})
	var score := (float(land.get("score", 0.5)) + float(naval.get("score", 0.5))) / 2.0
	var label := "Joint combat timeline · land %d · naval %d · score %.2f" % [
		(land.get("phase_rows", []) as Array).size(),
		(naval.get("phase_rows", []) as Array).size(),
		score,
	]
	return {
		"land": land,
		"naval": naval,
		"timeline": timeline,
		"phase_count": timeline.size(),
		"score": score,
		"apply_ready": bool(land.get("apply_ready", false)) or bool(naval.get("apply_ready", false)),
		"actions": [
			{"action_id": "apply_assault", "label": "Stage land assault", "enabled": bool(land.get("apply_ready", true))},
			{"action_id": "fleet_autonomy", "label": "Apply naval posture", "enabled": fuel_level >= 0.25},
		],
		"summary": label,
		"plain": label,
		"bbcode": "%s⚔⚓ Timeline[/color] %s— %s[/color]" % [COLOR_HEADER, COLOR_MUTED, label],
		"empty": timeline.is_empty(),
	}


## Convoy + supply day package.
static func convoy_supply_day_package(
	precip: float = 0.0,
	visibility: float = 1.0,
	sea_mult: float = 1.0,
	available_fleet: float = 80.0,
) -> Dictionary:
	var health := clampf(sea_mult * (1.0 - precip * 0.35) * (0.7 + 0.3 * visibility), 0.1, 1.5)
	var recommend_wait := precip > 0.5
	var apply_ready := (not recommend_wait) and health >= 0.35
	var score := health * (0.75 if recommend_wait else 1.0)
	var label := "Convoy/supply day · health %.0f%% · wait=%s · score %.2f" % [
		health * 100.0, "yes" if recommend_wait else "no", score
	]
	return {
		"score": score,
		"apply_ready": apply_ready,
		"recommend_wait": recommend_wait,
		"actions": [
			{"action_id": "apply_supply", "label": "Sustain supply / convoy route", "enabled": apply_ready},
			{"action_id": "fleet_autonomy", "label": "Escort posture", "enabled": true},
		],
		"summary": label,
		"plain": label,
		"bbcode": "%s⛵ Supply day[/color] %s— %s[/color]" % [COLOR_HEADER, COLOR_MUTED, label],
		"empty": false,
	}


## Theater day cabinet package (readiness + convoy + timeline queue).
static func theater_day_cabinet_package(
	precip: float = 0.0,
	visibility: float = 1.0,
	fuel_level: float = 0.7,
	has_trail: bool = false,
	has_signal: bool = false,
	signal_province_id: int = 1,
) -> Dictionary:
	var timeline: Dictionary = joint_combat_timeline(100.0, 80.0, 0.85, clampf(1.0 - precip * 0.35 + (visibility - 1.0) * 0.2, 0.35, 1.15), fuel_level, visibility)
	var convoy: Dictionary = convoy_supply_day_package(precip, visibility, 1.0, 80.0)
	var readiness_lines: Array = [
		"Theater readiness · weather precip %.0f%% · vis %.0f%%" % [precip * 100.0, visibility * 100.0]
	]
	var apply_queue: Array = []
	if bool(convoy.get("apply_ready", false)):
		apply_queue.append({"action_id": "apply_supply", "province_id": 1, "score": float(convoy.get("score", 0.5))})
	if bool(timeline.get("apply_ready", false)):
		apply_queue.append({"action_id": "apply_assault", "province_id": 1, "score": float(timeline.get("score", 0.5))})
	if has_trail:
		apply_queue.append({"action_id": "apply_hh_commit", "province_id": -1, "score": 0.45})
	if has_signal:
		apply_queue.append({"action_id": "apply_agent_dispatch", "province_id": signal_province_id, "score": 0.5})
	var score := (float(convoy.get("score", 0.5)) + float(timeline.get("score", 0.5)) + 0.6) / 3.0
	var label := "Theater day cabinet · convoy %.2f · timeline %.2f · queue %d" % [
		float(convoy.get("score", 0.0)), float(timeline.get("score", 0.0)), apply_queue.size()
	]
	return {
		"readiness": {"summary": readiness_lines[0], "lines": readiness_lines, "empty": false},
		"convoy": convoy,
		"timeline": timeline,
		"apply_queue": apply_queue,
		"score": score,
		"actions": [{"action_id": "theater_day_cabinet", "label": "Run theater day cabinet", "enabled": not apply_queue.is_empty()}],
		"summary": label,
		"plain": label,
		"bbcode": "%s🗺 Theater day[/color] %s— %s[/color]" % [COLOR_HEADER, COLOR_MUTED, label],
		"empty": false,
	}


