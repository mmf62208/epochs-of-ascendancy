static func multi_phase_combat_day(
	attacker_power: float = 100.0,
	defender_power: float = 80.0,
	attacker_supply: float = 0.85,
	weather_mult: float = 1.0,
	province_id: int = 1,
) -> Dictionary:
	var est: Dictionary = estimate_multi_phase_combat(attacker_power, defender_power, attacker_supply, weather_mult)
	if bool(est.get("empty", false)):
		return {"empty": true, "plain": "", "bbcode": "", "summary": "", "score": 0.0, "apply_queue": [], "actions": []}
	var win := clampf(float(est.get("overall_attacker_win_chance", est.get("engage_win_chance", 0.5))), 0.0, 1.0)
	var supply := clampf(attacker_supply, 0.05, 1.2)
	var apply_ready := win >= 0.35 and supply >= 0.3
	var apply_queue: Array = []
	if apply_ready and win >= 0.4:
		apply_queue.append({"action_id": "apply_assault", "province_id": province_id, "score": win, "enabled": true, "label": "Stage multi-phase assault"})
	if supply < 0.75 or win < 0.45:
		apply_queue.append({"action_id": "apply_supply", "province_id": province_id, "score": maxf(0.35, 1.0 - supply), "enabled": true, "label": "Feed multi-phase supply"})
	if apply_queue.is_empty():
		apply_queue.append({"action_id": "apply_station", "province_id": province_id, "score": 0.4, "enabled": true, "label": "Hold station (phase wait)"})
	var label := "Multi-phase combat day · win %.0f%% · supply %.0f%% · phases 3" % [win * 100.0, supply * 100.0]
	return {
		"estimate": est, "win_chance": win, "score": win, "apply_ready": apply_ready, "apply_queue": apply_queue,
		"actions": [{"action_id": "multi_phase_combat_day", "label": "Run multi-phase combat day", "enabled": apply_ready}],
		"summary": label, "plain": "%s\n%s" % [label, str(est.get("summary", ""))],
		"bbcode": "%s⚔ Multi-phase combat day[/color] %s— %s[/color]" % [COLOR_HEADER, COLOR_MUTED, label],
		"empty": false, "integration": ["multi_phase", "assault", "supply"],
	}


