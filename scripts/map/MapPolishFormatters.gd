static func recommend_tech_research_step(catalog_count: int = 0, priority_score: float = 0.5, field_ready: bool = false) -> Dictionary:
	var step := "priority"
	var reason := "refresh research priority"
	if catalog_count < 4:
		step = "catalog"
		reason = "thin catalog — review designs"
	elif priority_score < 0.4:
		step = "priority"
		reason = "priority path weak — retool production"
	elif field_ready:
		step = "field"
		reason = "ready to field seed/OOB"
	var action_id := "tech_research_catalog"
	var leaf := "apply_focus"
	match step:
		"priority":
			action_id = "tech_research_priority"
			leaf = "apply_production"
		"field":
			action_id = "tech_research_field"
			leaf = "apply_production"
	return {"step": step, "action_id": action_id, "leaf": leaf, "reason": reason, "empty": false, "summary": "Recommend %s · %s" % [step, reason]}

static func tech_research_campaign_product(province_id: int = 1) -> Dictionary:
	var designer: Dictionary = designer_suite_product({}, province_id)
	var priority: Dictionary = production_priority_mutation(10.0, 0.3, "mud", 0.7, 0.3, 1.0, "primary", "")
	var oob: Dictionary = medium_tank_oob_product(province_id)
	var seed: Dictionary = execute_designer_suite_step("seed", province_id)
	var focus: Dictionary = focus_war_path_product(province_id, "industrial_effort")
	var economy: Dictionary = war_economy_day_package(10.0, 0.3, "mud", 0.7, 0.3)
	var catalog_count := int(designer.get("catalog_count", 0))
	var catalog_score := clampf(0.55 * minf(1.0, float(catalog_count) / 12.0) + 0.45 * float(designer.get("score", 0.5)), 0.0, 1.0)
	if catalog_score < 0.35:
		catalog_score = 0.35
	var priority_score := clampf(0.5 * float(priority.get("score", 0.5)) + 0.3 * float(economy.get("score", 0.5)) + 0.2 * float(focus.get("score", 0.5)), 0.0, 1.0)
	if priority_score < 0.35:
		priority_score = 0.35
	var field_score := clampf(0.5 * float(oob.get("score", 0.5)) + 0.5 * float(seed.get("score", 0.5)), 0.0, 1.0)
	if field_score < 0.35:
		field_score = 0.35
	var score := clampf(0.35 * catalog_score + 0.35 * priority_score + 0.3 * field_score, 0.0, 1.0)
	if score < 0.35:
		score = 0.35
	var rec: Dictionary = recommend_tech_research_step(catalog_count, priority_score, field_score >= 0.4 and catalog_count >= 4)
	var steps: Array = [
		{"step": "catalog", "action_id": "tech_research_catalog", "leaf": "apply_focus", "label": "Step 0 — research/design catalog", "score": catalog_score},
		{"step": "priority", "action_id": "tech_research_priority", "leaf": "apply_production", "label": "Step 1 — production/research priority", "score": priority_score},
		{"step": "field", "action_id": "tech_research_field", "leaf": "apply_production", "label": "Step 2 — field seed / OOB", "score": field_score},
	]
	var day_rows: Array = []
	var apply_queue: Array = []
	for i in range(steps.size()):
		var st: Dictionary = steps[i]
		var step_name := str(st.get("step"))
		var recommended: bool = step_name == str(rec.get("step"))
		var sc := float(st.get("score", 0.5))
		var leaf := str(st.get("leaf"))
		var lab := str(st.get("label"))
		if recommended:
			lab = "★ " + lab
		lab = "%s · catalog %d · score %.2f" % [lab, catalog_count, sc]
		day_rows.append({"index": i, "step": step_name, "action_id": str(st.get("action_id")), "leaf_action": leaf, "label": lab, "score": sc, "enabled": true, "recommended": recommended, "province_id": province_id})
		apply_queue.append({"action_id": leaf, "province_id": province_id, "score": sc, "enabled": true, "label": lab, "step": step_name, "product_action": str(st.get("action_id"))})
	var actions: Array = [
		{"action_id": "tech_research_campaign_product", "label": "Run tech research campaign product", "enabled": true},
		{"action_id": str(rec.get("action_id", "tech_research_catalog")), "label": "Recommended: %s" % str(rec.get("step", "catalog")), "enabled": true},
		{"action_id": "designer_suite_product", "label": "Open designer suite product", "enabled": true},
	]
	for row2 in day_rows:
		actions.append({"action_id": str(row2.get("action_id")), "label": str(row2.get("label")), "enabled": true, "step": str(row2.get("step"))})
	var label := "Tech research campaign · catalog %d · priority %.2f · field %.2f · score %.2f" % [catalog_count, priority_score, field_score, score]
	return {
		"designer": designer, "priority": priority, "oob": oob, "seed": seed, "focus": focus, "economy": economy,
		"catalog_count": catalog_count, "catalog_score": catalog_score, "priority_score": priority_score, "field_score": field_score,
		"recommendation": rec, "day_rows": day_rows, "apply_queue": apply_queue, "actions": actions,
		"score": score, "tech_score": score, "province_id": province_id,
		"summary": label, "plain": label,
		"bbcode": "%s🔬 Tech research[/color] %s— %s[/color]" % [COLOR_HEADER, COLOR_MUTED, label],
		"empty": catalog_count <= 0,
		"integration": ["tech_research_campaign_product", "tech_research_catalog", "tech_research_priority", "tech_research_field", "major_17", "tech", "research"],
	}

static func execute_tech_research_step(step: String = "catalog", province_id: int = 1) -> Dictionary:
	var s := step.strip_edges().to_lower()
	if s.begins_with("tech_research_"):
		s = s.replace("tech_research_", "")
	if s not in ["catalog", "priority", "field"]:
		s = "catalog"
	var product: Dictionary = tech_research_campaign_product(province_id)
	var row: Dictionary = {}
	for r in product.get("day_rows", []):
		if r is Dictionary and str(r.get("step")) == s:
			row = r
			break
	var leaf := str(row.get("leaf_action", "apply_focus"))
	var action_id := "tech_research_catalog"
	match s:
		"priority":
			action_id = "tech_research_priority"
		"field":
			action_id = "tech_research_field"
	var score := float(row.get("score", product.get("score", 0.5)))
	var apply_queue: Array = [{"action_id": leaf, "province_id": province_id, "score": score, "enabled": true, "label": str(row.get("label", s)), "step": s, "product_action": action_id}]
	var label := "Execute tech research %s · leaf %s · score %.2f" % [s, leaf, score]
	return {"step": s, "leaf_action": leaf, "action_id": action_id, "apply_queue": apply_queue, "score": score, "province_id": province_id, "summary": label, "plain": label, "bbcode": "%s🔬 Tech %s[/color] %s— %s[/color]" % [COLOR_HEADER, s, COLOR_MUTED, label], "empty": false, "ok": true, "integration": ["execute_tech_research_step", s, leaf]}

