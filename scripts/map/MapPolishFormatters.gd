static func strategic_ai_domain_weight_day(province_id: int = 1) -> Dictionary:
	var tags: Array = ["GER", "FRA", "ENG", "USA", "SOV"]
	var plans: Array = []
	var domains: Array = []
	var avg_u := 0.0
	for t in tags:
		var p: Dictionary = plan_faction_ai(str(t), province_id)
		plans.append(p)
		var dom := str(p.get("top_domain", ""))
		if not domains.has(dom) and not dom.is_empty():
			domains.append(dom)
		avg_u += float(p.get("urgency", 0))
	avg_u /= float(maxi(1, plans.size()))
	var diversity := domains.size()
	var score := clampf(0.45 * minf(1.0, float(diversity) / 4.0) + 0.55 * avg_u, 0.0, 1.0)
	if score < 0.35:
		score = 0.35
	var leaf := "apply_station"
	if not plans.is_empty() and plans[0] is Dictionary:
		leaf = str(plans[0].get("top_leaf", leaf))
	var apply_queue: Array = [
		{"action_id": leaf, "province_id": province_id, "score": score, "enabled": true, "label": "Strategic AI domain weight leaf"},
		{"action_id": "apply_production", "province_id": province_id, "score": 0.5, "enabled": true, "label": "Strategic AI domain industry"},
		{"action_id": "apply_agent_dispatch", "province_id": province_id, "score": 0.45, "enabled": true, "label": "Strategic AI domain agent"},
	]
	var label := "Strategic AI domain weight · domains %d unique · avg urg %.2f · score %.2f" % [diversity, avg_u, score]
	return {
		"plans": plans, "domains": domains, "ai_score": score, "score": score, "apply_queue": apply_queue,
		"actions": [{"action_id": "strategic_ai_domain_weight_day", "label": "Run strategic AI domain weight day", "enabled": true}],
		"summary": label, "plain": label,
		"bbcode": "%s♟ Strategic AI domain weight[/color] %s— %s[/color]" % [COLOR_HEADER, COLOR_MUTED, label],
		"empty": false, "integration": ["strategic_ai", "domain", "weight", "next290"],
	}

