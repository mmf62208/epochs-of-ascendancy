	var daily_s := clampf(float(daily.get("score", 0.55)), 0.35, 1.0)
	var board_score := clampf(0.4 * multi_s + 0.3 * daily_s + 0.3 * urgency, 0.35, 1.0)
	var weekly_score := clampf(0.55 * board_score + 0.2, 0.35, 1.0)
