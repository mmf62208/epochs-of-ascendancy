	var air: Dictionary = air_ops_campaign_product(province_id)
	var focus: Dictionary = focus_war_path_product(province_id)
	var board: Dictionary = multi_faction_strategic_ai_product([], province_id, 7)
	var domains: Array = [
		{"domain": "theater", "score": float(theater.get("score", 0.5)), "leaf": "apply_assault", "summary": str(theater.get("summary", ""))},
		{"domain": "logistics", "score": float(logistics.get("score", 0.5)), "leaf": "apply_supply", "summary": str(logistics.get("summary", ""))},
		{"domain": "intel", "score": float(intel.get("score", 0.5)), "leaf": "apply_agent_dispatch", "summary": str(intel.get("summary", ""))},
		{"domain": "session", "score": float(session.get("score", 0.5)), "leaf": "apply_focus", "summary": str(session.get("summary", ""))},
		{"domain": "diplomacy", "score": float(diplo.get("score", 0.5)), "leaf": "apply_hh_commit", "summary": str(diplo.get("summary", ""))},
		{"domain": "tech", "score": float(tech.get("score", 0.5)), "leaf": "apply_production", "summary": str(tech.get("summary", ""))},
		{"domain": "ai", "score": float(ai.get("score", 0.5)), "leaf": "apply_station", "summary": str(ai.get("summary", ""))},
		{"domain": "naval", "score": float(naval.get("score", 0.5)), "leaf": "apply_station", "summary": str(naval.get("summary", ""))},
		{"domain": "air", "score": float(air.get("score", 0.5)), "leaf": "apply_assault", "summary": str(air.get("summary", ""))},
		{"domain": "focus", "score": float(focus.get("score", 0.5)), "leaf": "apply_focus", "summary": str(focus.get("summary", ""))},
	]
	domains.sort_custom(func(a, b): return float(a.get("score", 0)) > float(b.get("score", 0)))
	var top: Dictionary = domains[0] if not domains.is_empty() else {"domain": "theater", "score": 0.5, "leaf": "apply_assault"}
	var top_score := float(top.get("score", 0.5))
	var score := clampf(0.45 * top_score + 0.3 * minf(1.0, float(domains.size()) / 10.0) + 0.25 * float(board.get("score", 0.5)), 0.0, 1.0)
	if score < 0.35:
		score = 0.35
	var rec: Dictionary = recommend_world_class_step(domains.size(), top_score)
	var steps: Array = [
		{"step": "scan", "action_id": "world_class_scan", "leaf": "apply_focus", "label": "Step 0 — scan world-class domains", "score": clampf(0.45 + 0.05 * float(mini(10, domains.size())), 0.35, 1.0)},
		{"step": "rank", "action_id": "world_class_rank", "leaf": "apply_station", "label": "Step 1 — rank domain urgency", "score": clampf(0.4 + 0.1 * top_score, 0.35, 1.0)},
		{"step": "execute", "action_id": "world_class_execute", "leaf": str(top.get("leaf", "apply_assault")), "label": "Step 2 — execute top domain leaf", "score": clampf(0.5 + 0.1 * top_score, 0.35, 1.0)},
	]
	var day_rows: Array = []
	var apply_queue: Array = []
	for i in range(steps.size()):
		var st: Dictionary = steps[i]
		var step_name := str(st.get("step"))
		var recommended: bool = step_name == str(rec.get("step"))
		var sc := float(st.get("score", 0.5))
		var leaf := str(st.get("leaf"))
		var lab := str(st.get("label"))
		if recommended:
			lab = "★ " + lab
		lab = "%s · top %s · score %.2f" % [lab, str(top.get("domain")), sc]
		day_rows.append({"index": i, "step": step_name, "action_id": str(st.get("action_id")), "leaf_action": leaf, "label": lab, "score": sc, "enabled": true, "recommended": recommended, "province_id": province_id})
		apply_queue.append({"action_id": leaf, "province_id": province_id, "score": sc, "enabled": true, "label": lab, "step": step_name, "product_action": str(st.get("action_id")), "domain": str(top.get("domain"))})
	apply_queue.append({"action_id": str(top.get("leaf", "apply_focus")), "province_id": province_id, "score": top_score, "enabled": true, "label": "Top domain · %s" % str(top.get("domain")), "step": "execute", "product_action": "world_class_execute", "domain": str(top.get("domain"))})
	var board_lines: Array = []
	for d in domains:
		if d is Dictionary:
			board_lines.append("%s · %.2f · %s" % [str(d.get("domain")), float(d.get("score", 0)), str(d.get("leaf"))])
		if board_lines.size() >= 8:
			break
	var actions: Array = [
		{"action_id": "world_class_campaign_command_product", "label": "Run world-class campaign command", "enabled": true},
		{"action_id": str(rec.get("action_id", "world_class_scan")), "label": "Recommended: %s" % str(rec.get("step", "scan")), "enabled": true},
		{"action_id": "theater_command_product", "label": "Open theater command product", "enabled": true},
	]
	for row2 in day_rows:
		actions.append({"action_id": str(row2.get("action_id")), "label": str(row2.get("label")), "enabled": true, "step": str(row2.get("step"))})
	var label := "World-class campaign command · domains %d · top %s/%.2f · AI majors %d · score %.2f" % [domains.size(), str(top.get("domain")), top_score, int(board.get("faction_count", 0)), score]
	return {
		"domains": domains, "domain_count": domains.size(), "top_domain": str(top.get("domain")), "top_score": top_score,
		"top_leaf": str(top.get("leaf")), "board": board, "board_lines": board_lines,
		"recommendation": rec, "day_rows": day_rows, "apply_queue": apply_queue, "actions": actions,
		"score": score, "world_class_score": score, "province_id": province_id, "player_tag": player_tag.strip_edges().to_upper(),
		"summary": label, "plain": label,
		"bbcode": "%s★ World-class command[/color] %s— %s[/color]" % [COLOR_HEADER, COLOR_MUTED, label],
		"empty": domains.is_empty(),
		"integration": ["world_class_campaign_command_product", "world_class_scan", "world_class_rank", "world_class_execute", "major_20", "world_class", "campaign_command"],
	}

static func execute_world_class_step(step: String = "scan", province_id: int = 1, player_tag: String = "GER") -> Dictionary:
	var s := step.strip_edges().to_lower()
	if s.begins_with("world_class_"):
		s = s.replace("world_class_", "")
	if s not in ["scan", "rank", "execute"]:
		s = "scan"
	var product: Dictionary = world_class_campaign_command_product(province_id, player_tag)
	var row: Dictionary = {}
	for r in product.get("day_rows", []):
		if r is Dictionary and str(r.get("step")) == s:
			row = r
			break
	var leaf := str(row.get("leaf_action", "apply_focus"))
	var action_id := "world_class_scan"
	match s:
		"rank":
			action_id = "world_class_rank"
		"execute":
			action_id = "world_class_execute"
	var score := float(row.get("score", product.get("score", 0.5)))
	var apply_queue: Array = [{"action_id": leaf, "province_id": province_id, "score": score, "enabled": true, "label": str(row.get("label", s)), "step": s, "product_action": action_id, "domain": str(product.get("top_domain"))}]
	var label := "Execute world-class %s · leaf %s · top %s · score %.2f" % [s, leaf, str(product.get("top_domain")), score]
	return {"step": s, "leaf_action": leaf, "action_id": action_id, "apply_queue": apply_queue, "score": score, "province_id": province_id, "summary": label, "plain": label, "bbcode": "%s★ World-class %s[/color] %s— %s[/color]" % [COLOR_HEADER, s, COLOR_MUTED, label], "empty": false, "ok": true, "integration": ["execute_world_class_step", s, leaf]}

