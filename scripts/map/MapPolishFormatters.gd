static func execute_economy_conversion_step(step: String = "civ_board", province_id: int = 1) -> Dictionary:
	var s := step.strip_edges().to_lower().replace("economy_", "").replace("war_economy_", "")
	if s.begins_with("civ") or s.begins_with("board"): s = "civ_board"
	elif s.begins_with("convert") or s.begins_with("war"): s = "convert"
	elif s.begins_with("sustain") or s.begins_with("stock"): s = "sustain"
	else: s = "civ_board"
	var product: Dictionary = war_economy_conversion_product(province_id)
	var leaf := "apply_production"
	var action_id := "economy_civ_board"
	var score := float(product.get("score", 0.5))
	match s:
		"convert":
			leaf = "apply_production"; action_id = "economy_war_convert"
		"sustain":
			# Honest economy leaf — never apply_focus for stockpile sustain.
			leaf = "apply_production"; action_id = "economy_stockpile_sustain"
	var label := "Execute economy conversion %s · leaf %s · score %.2f" % [s, leaf, score]
	return {"step": s, "leaf_action": leaf, "action_id": action_id, "ok": true, "score": score, "province_id": province_id,
		"apply_queue": [{"action_id": leaf, "province_id": province_id, "score": score, "enabled": true, "label": label, "step": s}],
		"summary": label, "plain": label, "empty": false, "integration": ["execute_economy_conversion_step", s, leaf]}

