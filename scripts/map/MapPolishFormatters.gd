static func theater_fleet_auto_command(
	province_specs: Array = [],
	visibility: float = 1.0,
	precip: float = 0.0,
	formation_id: String = "fleet_div",
	country_tag: String = "ENG",
	fuel_level: float = 0.55,
) -> Dictionary:
	var specs: Array = province_specs
	if specs.is_empty():
		specs = [
			{"province_id": 1, "basing_level": "port", "zone_relation": "contested"},
			{"province_id": 2, "basing_level": "major_base", "zone_relation": "friendly"},
			{"province_id": 3, "basing_level": "anchorage", "zone_relation": "hostile"},
		]
	var ranked: Array = []
	for p in specs:
		if not (p is Dictionary):
			continue
		var pid := int(p.get("province_id", p.get("id", -1)))
		var mut: Dictionary = fleet_station_mutation(
			str(p.get("basing_level", "port")),
			float(p.get("fuel_level", fuel_level)),
			float(p.get("available_strength", 100.0)),
			str(p.get("zone_relation", "contested")),
			visibility,
			precip,
			pid,
			str(p.get("formation_id", formation_id)),
			str(p.get("country_tag", country_tag)),
		)
		ranked.append(mut)
	ranked.sort_custom(func(a, b): return float(a.get("score", 0.0)) > float(b.get("score", 0.0)))
	var top: Dictionary = ranked[0] if ranked.size() > 0 else {"empty": true, "score": 0.0}
	var score := float(top.get("score", 0.0)) if ranked.size() > 0 else 0.0
	var label := "Theater fleet auto · %d candidates · top score %.2f" % [ranked.size(), score]
	return {
		"ranked": ranked,
		"top": top,
		"count": ranked.size(),
		"score": score,
		"summary": label,
		"bbcode": "%s⚓ Theater fleet[/color] %s— %s[/color]" % [COLOR_HEADER, COLOR_MUTED, label],
		"empty": ranked.is_empty(),
		"integration": ["fleet_station_mutation", "theater_auto"],
	}


static func theater_combat_auto_command(
	front_specs: Array = [],
	visibility: float = 1.0,
	precip: float = 0.0,
	month: int = 6,
	attacker_tag: String = "GER",
	formation_id: String = "inf_div",
) -> Dictionary:
	var fr: Array = front_specs
	if fr.is_empty():
		fr = [
			{"from_province_id": 1, "target_province_id": 2, "attacker_power": 100.0},
			{"from_province_id": 3, "target_province_id": 4, "attacker_power": 60.0},
			{"from_province_id": 5, "target_province_id": 6, "attacker_power": 80.0},
		]
	var ranked: Array = []
	for f in fr:
		if not (f is Dictionary):
			continue
		var mut: Dictionary = assault_stage_mutation(
			float(f.get("attacker_power", 100.0)),
			float(f.get("attacker_supply", 0.85)),
			visibility,
			precip,
			int(f.get("month", month)),
			int(f.get("from_province_id", -1)),
			int(f.get("target_province_id", -1)),
			str(f.get("formation_id", formation_id)),
			str(f.get("attacker_tag", attacker_tag)),
		)
		ranked.append(mut)
	ranked.sort_custom(func(a, b):
		var ap := 1 if str((a.get("plan", {}) as Dictionary).get("step", "")) == "press" else 0
		var bp := 1 if str((b.get("plan", {}) as Dictionary).get("step", "")) == "press" else 0
		if ap != bp:
			return ap > bp
		return float(a.get("score", 0.0)) > float(b.get("score", 0.0))
	)
	var top: Dictionary = ranked[0] if ranked.size() > 0 else {"empty": true, "score": 0.0}
	var score := float(top.get("score", 0.0)) if ranked.size() > 0 else 0.0
	var press_n := 0
	for m in ranked:
		if str((m.get("plan", {}) as Dictionary).get("step", "")) == "press":
			press_n += 1
	var label := "Theater combat auto · %d fronts · press=%d · top %.2f" % [ranked.size(), press_n, score]
	return {
		"ranked": ranked,
		"top": top,
		"count": ranked.size(),
		"press_count": press_n,
		"score": score,
		"summary": label,
		"bbcode": "%s⚔ Theater combat[/color] %s— %s[/color]" % [COLOR_HEADER, COLOR_MUTED, label],
		"empty": ranked.is_empty(),
		"integration": ["assault_stage_mutation", "theater_auto"],
	}


