static func command_integrity_gate(
	sea_mult: float = 1.1,
	weather_mult: float = 0.8,
	route_risk: float = 0.2,
	theater_mult: float = 1.0,
) -> Dictionary:
	var sole: Dictionary = sole_mult_integrity(sea_mult, weather_mult, route_risk)
	var mut: Dictionary = mutation_integrity_gate(sea_mult, weather_mult, route_risk, theater_mult)
	var sole_ok := bool(sole.get("integrity_ok", false))
	var mut_ok := bool(mut.get("ok", false))
	var sole_health := float(sole.get("sole_health", 0.5)) * clampf(theater_mult, 0.1, 1.4)
	var stacked := sole_health * clampf(theater_mult, 0.1, 1.4)
	var thr_ok := true
	if absf(theater_mult - 1.0) > 0.05:
		thr_ok = absf(stacked - sole_health) > 0.01
	var ok := sole_ok and mut_ok and thr_ok
	var label := "Command integrity %s (sole=%s mut=%s thr=%s)" % [
		"PASS" if ok else "FAIL",
		"ok" if sole_ok else "fail",
		"ok" if mut_ok else "fail",
		"ok" if thr_ok else "fail",
	]
	return {
		"ok": ok,
		"summary": label,
		"bbcode": "%s✓ Cmd integrity[/color] %s— %s[/color]" % [COLOR_HEADER, COLOR_MUTED, label],
		"empty": false,
		"integration": ["sole_mult", "mutation_integrity", "theater_mult"],
	}

