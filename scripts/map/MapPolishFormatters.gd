# scripts/map/MapPolishFormatters.gd
## Pure format helpers for map polish (infra invest, special sites, naval chokepoints).
## Mirrors tools/map_generation/lib/map_polish_formatters.py — keep outputs in sync.
## No autoload / MapManager / IDM dependencies; take plain Dictionaries and primitives.
class_name MapPolishFormatters
extends RefCounted

const COLOR_HEADER := "[color=#6eb5ff]"
const COLOR_TECH := "[color=#6ec8ff]"
const COLOR_WARN := "[color=#ff9a6e]"
const COLOR_MUTED := "[color=#8899aa]"

const KNOWN_EFFECT_KEYS := [
	"supply_throughput_bonus",
	"trade_capacity",
	"naval_repair_bonus",
	"air_recon_bonus",
	"defense_bonus",
	"construction_speed_bonus",
]


static func format_investment_modifier_bits(mods: Dictionary) -> PackedStringArray:
	var bits: PackedStringArray = []
	if mods.is_empty():
		return bits
	if mods.has("engineer") and float(mods["engineer"]) != 0.0:
		bits.append("Eng %+.1f" % float(mods["engineer"]))
	if mods.has("tech") and float(mods["tech"]) != 0.0:
		bits.append("Tech %+.1f" % float(mods["tech"]))
	if mods.has("stability") and float(mods["stability"]) != 0.0:
		bits.append("Stab %+.1f" % float(mods["stability"]))
	if mods.has("regional") and float(mods["regional"]) != 0.0:
		bits.append("Reg %+.1f" % float(mods["regional"]))
	if mods.has("sabotage") and float(mods["sabotage"]) != 0.0:
		bits.append("Sab %.1f" % float(mods["sabotage"]))
	return bits


## BBCode invest line from get_project_status-shaped Dictionary. Empty if not active.
static func format_investment_status_line(status: Dictionary, default_infra: int = 1) -> String:
	if status.is_empty() or not bool(status.get("active", false)):
		return ""
	var pct := int(round(float(status.get("progress", 0.0))))
	var eta := int(status.get("eta_days", 0))
	var target := int(status.get("target_level", default_infra + 1))
	var sabotaged := bool(status.get("is_sabotaged", false))
	var work := float(status.get("work_per_day", 0.0))
	var mods: Dictionary = status.get("modifiers", {}) if status.get("modifiers") is Dictionary else {}

	var color := COLOR_WARN if sabotaged else COLOR_TECH
	var icon := "⚠" if sabotaged else "🚧"
	var sab := " (under sabotage)" if sabotaged else ""
	var line := "%s%s Infra Investment → Lv.%d  %d%%%s (ETA %dd" % [
		color, icon, target, pct, sab, eta
	]
	if work > 0.0:
		line += ", %.1f/day" % work
	line += ")[/color]"

	var mod_bits := format_investment_modifier_bits(mods)
	if not mod_bits.is_empty():
		var mod_color := COLOR_WARN if sabotaged else COLOR_MUTED
		line += "\n%sMods: %s[/color]" % [mod_color, " · ".join(mod_bits)]
	if sabotaged:
		line += "\n%sCancel or clear agents to recover progress rate.[/color]" % COLOR_WARN
	return line


## Panel state for MapRenderer invest UI.
static func format_invest_panel_state(status: Dictionary, cur_infra: int, cur_dev: int = 0) -> Dictionary:
	var has_project := bool(status.get("active", false)) if not status.is_empty() else false
	if not has_project:
		return {
			"has_project": false,
			"label": "Infra: %d  ·  Dev: %d  (Invest to raise)" % [cur_infra, cur_dev],
			"progress_pct": 0,
			"sabotaged": false,
			"show_cancel": false,
			"show_progress": false,
			"modifiers_label": "",
			"button_text": "Invest in Infrastructure",
			"button_disabled": false,
		}
	var pct := int(round(float(status.get("progress", 0.0))))
	var eta := int(status.get("eta_days", 0))
	var target := int(status.get("target_level", cur_infra + 1))
	var sabotaged := bool(status.get("is_sabotaged", false))
	var sab_note := " ⚠ Sabotage slowing progress" if sabotaged else ""
	var label := "Infra Project: %d%% → Lv.%d (ETA %d days)%s" % [pct, target, eta, sab_note]
	var mods: Dictionary = status.get("modifiers", {}) if status.get("modifiers") is Dictionary else {}
	var panel_bits: PackedStringArray = []
	if mods.has("engineer"):
		panel_bits.append("Eng +%.1f" % float(mods["engineer"]))
	if mods.has("tech"):
		panel_bits.append("Tech +%.1f" % float(mods["tech"]))
	if mods.has("stability"):
		panel_bits.append("Stab %.1f" % float(mods["stability"]))
	if mods.has("regional"):
		panel_bits.append("Reg +%.1f" % float(mods["regional"]))
	if mods.has("sabotage"):
		panel_bits.append("Sab %.1f" % float(mods["sabotage"]))
	var mod_str := " | ".join(panel_bits) if not panel_bits.is_empty() else "Base work rate"
	var modifiers_label := "Curr Lv: Infra %d / Dev %d  ·  Mods: %s" % [cur_infra, cur_dev, mod_str]
	if sabotaged:
		modifiers_label += "  ·  ⚠ sabo active"
	return {
		"has_project": true,
		"label": label,
		"progress_pct": clampi(pct, 0, 100),
		"sabotaged": sabotaged,
		"show_cancel": true,
		"show_progress": true,
		"modifiers_label": modifiers_label,
		"button_text": "Project Active",
		"button_disabled": true,
	}


static func format_site_effect_bits(
	supply_bonus: float = 0.0,
	trade_capacity: float = 0.0,
	effects: Dictionary = {},
	construction_progress: float = -1.0,
	damage_level: int = 0,
) -> PackedStringArray:
	var bits: PackedStringArray = []
	var supply_b := supply_bonus
	var trade_b := trade_capacity
	if supply_b <= 0.0 and effects.has("supply_throughput_bonus"):
		supply_b = float(effects["supply_throughput_bonus"])
	if trade_b <= 0.0 and effects.has("trade_capacity"):
		trade_b = float(effects["trade_capacity"])
	if supply_b > 0.0:
		bits.append("+%d supply" % int(supply_b))
	if trade_b > 0.0:
		bits.append("+%d trade" % int(trade_b))
	if effects.has("naval_repair_bonus") and float(effects["naval_repair_bonus"]) > 0.0:
		bits.append("+%d naval repair" % int(effects["naval_repair_bonus"]))
	if effects.has("air_recon_bonus") and float(effects["air_recon_bonus"]) > 0.0:
		bits.append("+%d recon" % int(effects["air_recon_bonus"]))
	if effects.has("defense_bonus") and float(effects["defense_bonus"]) > 0.0:
		bits.append("+%d def" % int(effects["defense_bonus"]))
	if effects.has("construction_speed_bonus") and float(effects["construction_speed_bonus"]) > 0.0:
		bits.append("+%d build spd" % int(effects["construction_speed_bonus"]))
	for k in effects.keys():
		var key := str(k)
		if key in KNOWN_EFFECT_KEYS:
			continue
		var val = effects[k]
		if (val is float or val is int) and float(val) > 0.0:
			bits.append("+%d %s" % [int(val), key.replace("_", " ")])
	if construction_progress >= 0.0:
		var prog := int(round(clampf(construction_progress, 0.0, 1.0) * 100.0))
		bits.append("building %d%%" % prog)
	if damage_level > 0:
		bits.append("dmg %d" % damage_level)
	return bits


static func format_overlay_effect_chip(supply_bonus: float, trade_capacity: float) -> String:
	var parts: PackedStringArray = []
	if supply_bonus > 0.0:
		parts.append("+%dS" % int(supply_bonus))
	if trade_capacity > 0.0:
		parts.append("+%dT" % int(trade_capacity))
	return " ".join(parts)


static func format_special_site_line(
	site_id: String,
	display_name: String,
	tier: int,
	state_icon: String,
	effect_bits: PackedStringArray,
	compact: bool = true,
	description: String = "",
) -> String:
	var display := display_name if not display_name.is_empty() else site_id.replace("_", " ")
	var eff_str := " · ".join(effect_bits) if not effect_bits.is_empty() else "no passive effects"
	if compact:
		return "%s%s %s T%d[/color] %s%s[/color]" % [
			COLOR_TECH, state_icon, display, tier, COLOR_MUTED, eff_str
		]
	var line := "%s%s %s (T%d) — %s[/color]" % [COLOR_TECH, state_icon, display, tier, eff_str]
	if not description.is_empty():
		line += "\n%s%s[/color]" % [COLOR_MUTED, description]
	return line


static func format_special_sites_block(site_lines: PackedStringArray, compact: bool = true) -> String:
	if site_lines.is_empty():
		return ""
	if compact:
		return "%sSites:[/color] " % COLOR_HEADER + " | ".join(site_lines)
	return "%s── Special sites ──[/color]\n" % COLOR_HEADER + "\n".join(site_lines)


static func is_chokepoint_member(province_id: int, chokepoint_ids: Array) -> bool:
	return province_id in chokepoint_ids


static func format_chokepoint_badge(
	supply_bonus_multiplier: float = 1.18,
	controller_tag: String = "",
	owner_tag: String = "",
) -> String:
	var contest := compute_chokepoint_contest(0, controller_tag, owner_tag, supply_bonus_multiplier)
	return format_chokepoint_contest_badge(contest)


static func compute_chokepoint_contest(
	province_id: int = 0,
	controller_tag: String = "",
	owner_tag: String = "",
	supply_bonus_multiplier: float = 1.18,
) -> Dictionary:
	var ctrl := controller_tag.strip_edges().to_upper()
	var own := owner_tag.strip_edges().to_upper()
	if ctrl.is_empty() and not own.is_empty():
		ctrl = own
	var unowned := ctrl.is_empty() and own.is_empty()
	var contested := not own.is_empty() and not ctrl.is_empty() and own != ctrl
	var state := "controlled"
	var summary := ""
	var label := ctrl
	if unowned:
		state = "unowned"
		summary = "Naval chokepoint — unowned strait"
		label = "Unowned"
	elif contested:
		state = "contested"
		summary = "Naval chokepoint — contested (controller %s, owner %s)" % [ctrl, own]
		label = "Contested · %s" % ctrl
	else:
		summary = "Naval chokepoint — controlled by %s" % ctrl
	return {
		"province_id": province_id,
		"controller": ctrl,
		"owner": own,
		"state": state,
		"contested": contested,
		"unowned": unowned,
		"controlled": state == "controlled",
		"summary": summary,
		"label": label,
		"supply_bonus_multiplier": supply_bonus_multiplier,
	}


static func format_chokepoint_contest_badge(contest: Dictionary) -> String:
	var mult := float(contest.get("supply_bonus_multiplier", 1.18))
	if bool(contest.get("unowned", false)):
		return (
			"%s⚓ Naval chokepoint[/color] %s— unowned strait (×%.2f supply/trade)[/color]"
			% [COLOR_TECH, COLOR_MUTED, mult]
		)
	var ctrl := str(contest.get("controller", "")).strip_edges().to_upper()
	var own := str(contest.get("owner", "")).strip_edges().to_upper()
	if bool(contest.get("contested", false)):
		return (
			"%s⚓ Naval chokepoint[/color] %s— contested · controller %s (owner %s) · ×%.2f[/color]"
			% [COLOR_WARN, COLOR_MUTED, ctrl if not ctrl.is_empty() else "?", own if not own.is_empty() else "?", mult]
		)
	return (
		"%s⚓ Naval chokepoint[/color] %s— controlled by %s · ×%.2f supply/trade[/color]"
		% [COLOR_TECH, COLOR_MUTED, ctrl if not ctrl.is_empty() else "?", mult]
	)


static func site_state_icon(completed: bool = false, under_construction: bool = false, damaged: bool = false) -> String:
	if damaged:
		return "💥"
	if completed:
		return "✓"
	if under_construction:
		return "🚧"
	return "⚠"


## Supply/trade multipliers from sea-zone control state (pure decision).
static func sea_zone_strategic_modifiers(
	controller: String = "",
	contested: bool = false,
	unowned: bool = false,
) -> Dictionary:
	var ctrl := controller.strip_edges().to_upper()
	var state := "controlled"
	var supply := 1.12
	var trade := 1.10
	var label := "controlled sealanes"
	if unowned or ctrl.is_empty():
		state = "unowned"
		supply = 1.00
		trade = 0.95
		label = "neutral waters"
	elif contested:
		state = "contested"
		supply = 0.92
		trade = 0.88
		label = "contested sealanes"
	return {
		"state": state,
		"controller": ctrl,
		"supply_multiplier": supply,
		"trade_multiplier": trade,
		"label": label,
		"summary": "supply ×%.2f · trade ×%.2f (%s)" % [supply, trade, label],
	}


## Naval basing pilot: none / anchorage / port / major_base + fleet capacity.
## Pure mirror of tools/map_generation/lib/naval_basing.py compute_naval_basing.
static func compute_naval_basing(
	domain: String = "",
	is_sea: bool = false,
	is_coastal: bool = false,
	has_port: bool = false,
	port_tier: int = 0,
	has_naval_shipyard: bool = false,
	has_naval_base: bool = false,
	is_chokepoint: bool = false,
	facility_tier: String = "",
	in_sea_zone: bool = false,
	province_id: int = 0,
) -> Dictionary:
	var dom := domain.strip_edges().to_lower()
	if dom.is_empty() and is_sea:
		dom = "sea"
	var coastal := is_coastal or dom == "coastal_land" or dom == "coastal"
	var strait := dom == "strait"
	var sea_domain := is_sea or dom == "sea" or dom == "ocean"
	var landlocked := (dom == "land" or dom.is_empty()) and not coastal and not strait and not sea_domain
	var lake := dom == "lake"
	var fac := facility_tier.strip_edges().to_lower()
	var p_tier := maxi(0, port_tier)
	var portish := has_port or p_tier >= 1
	var shipyard := has_naval_shipyard or has_naval_base
	var choke := is_chokepoint or strait

	var level := "none"
	var capacity := 0
	var label := "no basing"
	var reason := "none"
	if lake or (landlocked and not choke and not portish and not shipyard):
		level = "none"
		capacity = 0
		label = "no basing"
		reason = "landlocked" if landlocked else "lake"
	elif sea_domain and not choke and not portish and not shipyard and not coastal:
		level = "none"
		capacity = 0
		label = "open waters"
		reason = "sea_no_base"
	elif shipyard or p_tier >= 3 or (choke and (portish or strait or p_tier >= 2)):
		level = "major_base"
		capacity = 12
		if shipyard:
			capacity += 4
		if choke:
			capacity += 2
		if p_tier >= 3:
			capacity += 2
		capacity = mini(capacity, 20)
		label = "major naval base"
		if shipyard:
			reason = "shipyard"
		elif p_tier >= 3:
			reason = "port_tier3"
		else:
			reason = "choke_port"
	elif portish or p_tier >= 2 or (coastal and fac == "full") or strait:
		level = "port"
		capacity = 6
		if p_tier >= 2:
			capacity += 2
		if choke:
			capacity += 2
		if fac == "full":
			capacity += 1
		if in_sea_zone:
			capacity += 1
		capacity = mini(capacity, 12)
		label = "port"
		if portish or p_tier >= 2:
			reason = "port"
		elif fac == "full":
			reason = "facility"
		else:
			reason = "strait"
	elif coastal or choke or in_sea_zone:
		level = "anchorage"
		capacity = 2
		if in_sea_zone:
			capacity += 1
		if choke:
			capacity += 1
		label = "anchorage"
		if coastal:
			reason = "coastal"
		elif choke:
			reason = "choke"
		else:
			reason = "sea_zone"
	else:
		level = "none"
		capacity = 0
		label = "no basing"
		reason = "no_naval_signal"
	return {
		"province_id": province_id,
		"level": level,
		"capacity": capacity,
		"label": label,
		"reason": reason,
		"summary": "%s · capacity %d" % [label, capacity],
		"is_naval": level != "none",
		"domain": dom,
		"is_coastal": coastal,
		"is_chokepoint": choke,
		"has_port": portish,
		"port_tier": p_tier,
		"has_naval_shipyard": shipyard,
		"in_sea_zone": in_sea_zone,
	}


static func format_naval_basing_badge(basing: Dictionary) -> String:
	var level := str(basing.get("level", "none"))
	if level == "none" or not bool(basing.get("is_naval", level != "none")):
		return ""
	var cap := int(basing.get("capacity", 0))
	var label := str(basing.get("label", level)).strip_edges()
	if label.is_empty():
		label = level
	var bits: PackedStringArray = [label, "capacity %d" % cap]
	if bool(basing.get("is_chokepoint", false)):
		bits.append("choke")
	if int(basing.get("port_tier", 0)) >= 2:
		bits.append("port-t%d" % int(basing.get("port_tier", 0)))
	if bool(basing.get("has_naval_shipyard", false)):
		bits.append("shipyard")
	var rates: Dictionary = basing_repair_refuel_rates(basing)
	if bool(rates.get("can_service", false)):
		bits.append("refuel %.2f/d" % float(rates.get("refuel_rate", 0.0)))
	var detail := " · ".join(bits)
	var color := COLOR_WARN if level == "major_base" else COLOR_TECH
	return "%s⚓ Naval basing[/color] %s— %s[/color]" % [color, COLOR_MUTED, detail]


## Daily naval repair/refuel rates from basing level/capacity (pure).
## Mirrors tools/map_generation/lib/naval_basing.py basing_repair_refuel_rates.
## Ordering: none (0) < anchorage < port < major_base.
static func basing_repair_refuel_rates(basing: Dictionary = {}) -> Dictionary:
	var lv := str(basing.get("level", "none")).strip_edges().to_lower()
	if lv.is_empty():
		lv = "none"
	if basing.has("is_naval") and not bool(basing.get("is_naval", false)):
		lv = "none"
	var cap := int(basing.get("capacity", 0))
	var refuel := 0.0
	var org := 0.0
	var ready := 0.0
	var strength := 0.0
	var baseline_cap := 0
	match lv:
		"anchorage":
			refuel = 0.10
			org = 0.015
			ready = 0.012
			strength = 0.008
			baseline_cap = 2
		"port":
			refuel = 0.25
			org = 0.04
			ready = 0.03
			strength = 0.02
			baseline_cap = 6
		"major_base":
			refuel = 0.40
			org = 0.06
			ready = 0.05
			strength = 0.035
			baseline_cap = 12
		_:
			lv = "none"
			refuel = 0.0
			org = 0.0
			ready = 0.0
			strength = 0.0
			baseline_cap = 0
	var scale := 1.0
	if lv != "none":
		var extra := maxi(0, cap - baseline_cap)
		scale = 1.0 + minf(0.25, float(extra) * 0.015)
		refuel *= scale
		org *= scale
		ready *= scale
		strength *= scale
	var can_service := lv != "none" and (refuel > 0.0 or org > 0.0)
	return {
		"level": lv,
		"capacity": cap,
		"refuel_rate": refuel,
		"repair_org_rate": org,
		"repair_readiness_rate": ready,
		"repair_strength_rate": strength,
		"can_service": can_service,
		"scale": scale,
		"summary": "refuel ×%.3f/d · org ×%.3f/d · ready ×%.3f/d · str ×%.3f/d (%s)" % [refuel, org, ready, strength, lv],
	}


## Friendly-aware sea-zone multipliers for live supply/trade (pure).
## use_no_zone=true (empty control) → 1.0/1.0 landlocked-safe.
## Hostile exclusive control penalizes; friendly exclusive bonuses.
static func friendly_sea_zone_multipliers(
	controller: String = "",
	contested: bool = false,
	unowned: bool = false,
	friendly_tag: String = "",
	use_no_zone: bool = false,
) -> Dictionary:
	var friend := friendly_tag.strip_edges().to_upper()
	var ctrl := controller.strip_edges().to_upper()
	if use_no_zone:
		return {
			"state": "none",
			"relation": "no_zone",
			"supply_multiplier": 1.0,
			"trade_multiplier": 1.0,
			"label": "no sea zone",
			"summary": "supply ×1.00 · trade ×1.00 (no sea zone)",
			"applies": false,
			"controller": "",
		}
	if unowned or ctrl.is_empty():
		return {
			"state": "unowned",
			"relation": "neutral",
			"supply_multiplier": 1.00,
			"trade_multiplier": 0.95,
			"label": "neutral waters",
			"summary": "supply ×1.00 · trade ×0.95 (neutral waters)",
			"applies": true,
			"controller": ctrl,
		}
	if contested:
		return {
			"state": "contested",
			"relation": "contested",
			"supply_multiplier": 0.92,
			"trade_multiplier": 0.88,
			"label": "contested sealanes",
			"summary": "supply ×0.92 · trade ×0.88 (contested sealanes)",
			"applies": true,
			"controller": ctrl,
		}
	if not friend.is_empty() and ctrl == friend:
		return {
			"state": "controlled",
			"relation": "friendly",
			"supply_multiplier": 1.12,
			"trade_multiplier": 1.10,
			"label": "friendly sealanes",
			"summary": "supply ×1.12 · trade ×1.10 (friendly sealanes)",
			"applies": true,
			"controller": ctrl,
		}
	if not friend.is_empty() and not ctrl.is_empty() and ctrl != friend:
		return {
			"state": "controlled",
			"relation": "hostile",
			"supply_multiplier": 0.85,
			"trade_multiplier": 0.80,
			"label": "hostile sealanes",
			"summary": "supply ×0.85 · trade ×0.80 (hostile sealanes)",
			"applies": true,
			"controller": ctrl,
		}
	var raw: Dictionary = sea_zone_strategic_modifiers(ctrl, contested, unowned)
	return {
		"state": str(raw.get("state", "unowned")),
		"relation": "neutral",
		"supply_multiplier": float(raw.get("supply_multiplier", 1.0)),
		"trade_multiplier": float(raw.get("trade_multiplier", 1.0)),
		"label": str(raw.get("label", "")),
		"summary": str(raw.get("summary", "")),
		"applies": true,
		"controller": ctrl,
	}


## Friendly multipliers from a control/modifiers dictionary (MapManager payload).
static func friendly_sea_zone_multipliers_from_dict(
	control_or_mods: Dictionary,
	friendly_tag: String = "",
) -> Dictionary:
	if control_or_mods.is_empty():
		return friendly_sea_zone_multipliers("", false, false, friendly_tag, true)
	var unowned := bool(control_or_mods.get("unowned", false))
	var contested := bool(control_or_mods.get("contested", false))
	var ctrl := str(control_or_mods.get("controller", "")).strip_edges().to_upper()
	var state := str(control_or_mods.get("state", "")).strip_edges().to_lower()
	if state == "unowned":
		unowned = true
	elif state == "contested":
		contested = true
	elif state == "controlled":
		unowned = false
		contested = false
	return friendly_sea_zone_multipliers(ctrl, contested, unowned, friendly_tag, false)


static func combine_path_multipliers(multipliers: Array, default_v: float = 1.0) -> float:
	if multipliers.is_empty():
		return default_v
	var s := 0.0
	var n := 0
	for m in multipliers:
		s += float(m)
		n += 1
	if n <= 0:
		return default_v
	return clampf(s / float(n), 0.5, 1.25)


static func apply_sea_zone_multiplier(base_amount: float, multiplier: float) -> float:
	return float(base_amount) * clampf(float(multiplier), 0.5, 1.25)


## Sea-zone control badge (unowned / contested / controlled by TAG) + strategic modifiers.
static func format_sea_zone_control_badge(
	zone_name: String,
	controller: String = "",
	contested: bool = false,
	unowned: bool = false,
) -> String:
	var zone := zone_name.strip_edges()
	if zone.is_empty():
		zone = "Sea"
	var mods: Dictionary = sea_zone_strategic_modifiers(controller, contested, unowned)
	var mod_bit := " · %s" % str(mods.get("summary", ""))
	if unowned or controller.strip_edges().is_empty():
		return "%s🌊 Sea zone[/color] %s%s — unowned open waters%s[/color]" % [COLOR_TECH, COLOR_MUTED, zone, mod_bit]
	var ctrl := controller.strip_edges().to_upper()
	if contested:
		return (
			"%s🌊 Sea zone[/color] %s%s[/color] %s— contested · lead %s%s[/color]"
			% [COLOR_TECH, COLOR_MUTED, zone, COLOR_WARN, ctrl, mod_bit]
		)
	return "%s🌊 Sea zone[/color] %s%s — controlled by %s%s[/color]" % [COLOR_TECH, COLOR_MUTED, zone, ctrl, mod_bit]


## Inspector top-line identity (name / owner / region / sea zone). Pure strings only.
static func format_inspector_topline(
	province_name: String,
	owner_tag: String = "",
	region_name: String = "",
	sea_zone_name: String = "",
) -> Dictionary:
	var pname := province_name.strip_edges()
	if pname.is_empty():
		pname = "Province"
	var owner := owner_tag.strip_edges().to_upper()
	var owner_disp := "Unowned" if owner.is_empty() else owner
	var region := region_name.strip_edges()
	var sea := sea_zone_name.strip_edges()
	var summary_bits: PackedStringArray = [pname, owner_disp]
