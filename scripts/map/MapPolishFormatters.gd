## Fleet redeploy route score (origin→dest; beyond theater posture).
static func score_fleet_redeploy_route(
	origin_basing: String = "none",
	dest_basing: String = "port",
	fuel_level: float = 0.85,
	path_hostile_segments: int = 0,
	path_length: int = 1,
	dest_zone_relation: String = "friendly",
) -> Dictionary:
	var fuel := clampf(fuel_level, 0.1, 1.2)
	var rank := {"none": 0, "anchorage": 1, "port": 2, "major_base": 3}
	var o := int(rank.get(origin_basing.strip_edges().to_lower(), 0))
	var d := int(rank.get(dest_basing.strip_edges().to_lower(), 0))
	var n := maxi(1, path_length)
	var hostile := maxi(0, path_hostile_segments)
	var rel := dest_zone_relation.strip_edges().to_lower()
	var score := 40.0 + float(d) * 12.0 - float(o) * 3.0
	score *= 0.7 + 0.3 * fuel
	score -= float(hostile) * 8.0
	score -= float(maxi(0, n - 2)) * 4.0
	if fuel < 0.35 and d >= 2:
		score += 18.0
	if rel == "hostile":
		score -= 15.0
	elif rel == "contested":
		score -= 8.0
	elif rel == "friendly":
		score += 10.0
	if d == 0:
		score -= 25.0
	return {
		"score": score,
		"recommend": score >= 45.0,
		"summary": "redeploy route score %.1f (dest %s · H%d · fuel %.0f%%)" % [score, dest_basing, hostile, fuel * 100.0],
	}


## Rank redeploy destination candidates.
static func plan_fleet_redeploy_routes(candidates: Array, fuel_level: float = 0.85, origin_basing: String = "anchorage") -> Dictionary:
	var scored: Array = []
	for raw in candidates:
		if typeof(raw) != TYPE_DICTIONARY:
			continue
		var d: Dictionary = raw
		var pid := int(d.get("province_id", d.get("id", -1)))
		if pid < 0:
			continue
		var row: Dictionary = score_fleet_redeploy_route(
			str(d.get("origin_basing", origin_basing)),
			str(d.get("basing_level", d.get("dest_basing", "port"))),
			float(d.get("fuel_level", fuel_level)),
			int(d.get("path_hostile_segments", 0)),
			int(d.get("path_length", 1)),
			str(d.get("zone_relation", d.get("dest_zone_relation", "friendly"))),
		)
		row["province_id"] = pid
		scored.append(row)
	scored.sort_custom(func(a, b): return float(a["score"]) > float(b["score"]))
	if scored.is_empty():
		return {"routes": [], "best_province_id": -1, "empty": true, "summary": "", "count": 0}
	var best: Dictionary = scored[0]
	return {
		"routes": scored,
		"best_province_id": int(best.get("province_id", -1)),
		"best_score": float(best.get("score", 0.0)),
		"best": best,
		"empty": false,
		"summary": "Redeploy → #%d score %.0f" % [int(best.get("province_id", -1)), float(best.get("score", 0.0))],
		"count": scored.size(),
	}


## Weather combat briefing (card + ribbon + wx mult).
static func build_weather_combat_briefing(
	attacker_power: float = 100.0,
	defender_power: float = 80.0,
	weather_mult: float = 1.0,
	attacker_supply: float = 1.0,
	province_name: String = "",
) -> Dictionary:
	var wmult := clampf(weather_mult, 0.2, 1.2)
	var est: Dictionary = estimate_multi_phase_combat(attacker_power, defender_power, attacker_supply, wmult)
	var ribbon: Dictionary = format_phase_ribbon(est)
	var overall := float(est.get("overall_attacker_win_chance", 0.0))
	var rec := "Favorable — press assault" if overall >= 0.65 else ("Marginal — wait for supply/reinforce" if overall >= 0.45 else "Unfavorable — avoid or soften first")
	var headline := "Wx briefing ×%.2f · win %.0f%%" % [wmult, overall * 100.0]
	if not province_name.is_empty():
		headline = "%s @ %s" % [headline, province_name]
	return {
		"weather_mult": wmult,
		"overall": overall,
		"estimate": est,
		"ribbon": ribbon,
		"recommendation": rec,
		"headline": headline,
		"plain": "%s\n%s\n%s" % [headline, str(ribbon.get("ribbon_plain", "")), rec],
		"bbcode": "%s⚔ %s[/color]\n%s\n%s%s[/color]" % [COLOR_HEADER, headline, str(ribbon.get("bbcode", "")), COLOR_MUTED, rec],
		"empty": bool(ribbon.get("empty", false)),
		"summary": headline,
		"favorable": overall >= 0.65,
	}


## Agent coverage plan across threats.
static func plan_agent_coverage(threats: Array, available_agents: int = 5, network_strength: float = 0.3) -> Dictionary:
	var avail := maxi(0, available_agents)
	var scored: Array = []
	for t in threats:
		if typeof(t) != TYPE_DICTIONARY:
			continue
		if not bool(t.get("active", true)):
			continue
		var pid := int(t.get("province_id", t.get("id", -1)))
		if pid < 0:
			continue
		var inf := float(t.get("influence", t.get("threat", 0.5)))
		var loyalty := float(t.get("loyalty", 0.5))
		var net := float(t.get("network_strength", network_strength))
		var need := inf * (1.2 - loyalty) * (1.1 - net)
		scored.append({
			"province_id": pid,
			"action_class": str(t.get("action_class", "influence")),
			"influence": inf,
			"need": need,
			"agents": 0,
		})
	scored.sort_custom(func(a, b): return float(a["need"]) > float(b["need"]))
	var remaining := avail
	for row in scored:
		if remaining <= 0:
			break
		var assign := 1 if remaining == 1 else maxi(1, mini(remaining, 1 + int(float(row["need"]) * 2.0)))
		assign = mini(assign, remaining)
		row["agents"] = assign
		remaining -= assign
	var covered := 0
	for row in scored:
		if int(row["agents"]) > 0:
			covered += 1
	if scored.is_empty() or avail <= 0:
		return {"assignments": [], "covered": 0, "agents_used": 0, "empty": true, "summary": "", "count": 0}
	var summary := "Coverage %d/%d threats · agents used %d/%d" % [covered, scored.size(), avail - remaining, avail]
	return {
		"assignments": scored,
		"covered": covered,
		"agents_used": avail - remaining,
		"empty": false,
		"summary": summary,
		"count": scored.size(),
		"bbcode": "%s◎ Coverage[/color] %s— %s[/color]" % [COLOR_HEADER, COLOR_MUTED, summary],
	}


## Weather pressure index (higher = worse).
static func weather_pressure_index(visibility: float = 1.0, precip: float = 0.0, ground_state: String = "dry", wind: float = 0.2) -> Dictionary:
	var c := weather_combat_multiplier(visibility, precip, wind)
	var s := weather_supply_multiplier(ground_state, precip)
	var m := weather_move_multiplier(ground_state, visibility, false)
	var pressure := clampf((3.0 - (c + s + m)) / 2.2, 0.0, 1.0)
	var label := "Weather pressure %.0f%% (c×%.2f s×%.2f m×%.2f)" % [pressure * 100.0, c, s, m]
	return {
		"pressure": pressure,
		"combat_mult": c,
		"supply_mult": s,
		"move_mult": m,
		"label": label,
		"summary": label,
		"severe": pressure >= 0.55,
		"bbcode": "%s🌪 Pressure[/color] %s— %s[/color]" % [COLOR_TECH, COLOR_MUTED, label],
	}


## Trade weather multiplier (storm/mud hurt trade).
static func trade_weather_multiplier(ground_state: String = "dry", precip_intensity: float = 0.0) -> float:
	var s := weather_supply_multiplier(ground_state, precip_intensity)
	return clampf(s * 0.95 + 0.05, 0.3, 1.1)


## Rank path weather supply risk (worst first).
static func rank_supply_route_weather_risk(path_entries: Array) -> Dictionary:
	var rows: Array = []
	for i in range(path_entries.size()):
		var w = path_entries[i]
		if typeof(w) != TYPE_DICTIONARY:
			continue
		var mult := weather_supply_multiplier(str(w.get("ground_state", "dry")), float(w.get("precip_intensity", 0.0)))
		var pid := int(w.get("province_id", w.get("id", i)))
		rows.append({"province_id": pid, "supply_mult": mult, "risk": 1.0 - mult, "ground_state": str(w.get("ground_state", "dry"))})
	rows.sort_custom(func(a, b): return float(a["risk"]) > float(b["risk"]))
	if rows.is_empty():
		return {"ranked": [], "worst_province_id": -1, "empty": true, "summary": ""}
	var worst: Dictionary = rows[0]
	var label := "Route wx risk worst #%d (×%.2f · %s)" % [int(worst["province_id"]), float(worst["supply_mult"]), str(worst["ground_state"])]
	return {"ranked": rows, "worst_province_id": int(worst["province_id"]), "worst": worst, "empty": false, "summary": label, "bbcode": "%s🛤 Route wx[/color] %s— %s[/color]" % [COLOR_TECH, COLOR_MUTED, label]}


## Naval engagement weather tip.
static func naval_engagement_weather_tip(visibility: float = 1.0, precip: float = 0.0) -> Dictionary:
	var spot := naval_spot_weather_multiplier(visibility, precip)
	var tip := "Moderate vis — balanced naval posture"
	if spot < 0.35:
		tip = "Low spot — favor ambush/sub screen"
	elif precip > 0.6:
		tip = "Storm seas — carrier strike degraded"
	elif visibility > 0.85:
		tip = "Clear seas — surface gunnery favored"
	var label := "Naval wx tip · spot ×%.2f · %s" % [spot, tip]
	return {"spot_mult": spot, "tip": tip, "summary": label, "bbcode": "%s🌊 Naval tip[/color] %s— %s[/color]" % [COLOR_TECH, COLOR_MUTED, label], "empty": false}


## Air grounding alert (empty when fair weather).
static func air_grounding_alert(visibility: float = 1.0, precip: float = 0.0, wind: float = 0.2) -> Dictionary:
	var ready: Dictionary = air_sortie_weather_readiness(visibility, precip, wind)
	var grounded := bool(ready.get("grounded", false))
	var eff := float(ready.get("effectiveness", 1.0))
	if not grounded and eff >= 0.5:
		return {"grounded": false, "empty": true, "plain": "", "bbcode": "", "effectiveness": eff}
	var label := "Air alert · %s" % str(ready.get("summary", "sortie degraded"))
	return {"grounded": grounded, "effectiveness": eff, "empty": false, "summary": label, "bbcode": "[color=#f87171]✈ %s[/color]" % label}


## Freeze/thaw ground transition.
static func freeze_thaw_transition(ground_state: String = "dry", temp: float = 10.0, precip: float = 0.0) -> Dictionary:
	var g := ground_state.strip_edges().to_lower()
	var nxt := g
	var note := "stable"
	if temp < -1.0 and g in ["mud", "wet", "dry"] and precip > 0.15:
		nxt = "frozen" if g != "snow_covered" else "snow_covered"
		note = "freeze-in"
	elif temp < -2.0 and precip > 0.25:
		nxt = "snow_covered"
		note = "snowfall"
	elif temp > 3.0 and g in ["frozen", "snow_covered", "ice"]:
		nxt = "mud" if precip > 0.2 else "wet"
		note = "thaw"
	elif temp > 8.0 and g in ["mud", "wet"] and precip < 0.1:
		nxt = "dry"
		note = "dry-out"
	var changed := nxt != g
	var label := "Ground %s → %s (%s)" % [g, nxt, note] if changed else "Ground %s stable" % g
	return {"from": g, "to": nxt, "changed": changed, "note": note, "summary": label, "bbcode": "%s❄ Ground[/color] %s— %s[/color]" % [COLOR_TECH, COLOR_MUTED, label], "empty": false}


## Infra weather wear factor.
static func infra_weather_wear(ground_state: String = "dry", precip: float = 0.0) -> Dictionary:
	var g := ground_state.strip_edges().to_lower()
	var wear := 1.0
	if g in ["snow_covered", "ice", "frozen"]:
		wear = 0.8
	elif g == "mud":
		wear = 0.9
	wear *= 1.0 - precip * 0.1
	wear = clampf(wear, 0.5, 1.2)
	var label := "Infra wear factor ×%.2f (%s)" % [wear, g]
	return {"wear_factor": wear, "summary": label, "bbcode": "%s🛠 Infra wx[/color] %s— %s[/color]" % [COLOR_TECH, COLOR_MUTED, label], "empty": false}


## Coastal fog naval gate.
static func coastal_fog_naval_gate(visibility: float = 1.0, precip: float = 0.0) -> Dictionary:
	var fog := visibility < 0.4 or (visibility < 0.55 and precip > 0.35)
	var ops := clampf(visibility * (1.0 - precip * 0.4), 0.1, 1.0)
	var label := ("Fog gate CLOSED · ops ×%.2f" % ops) if fog else ("Fog gate open · ops ×%.2f" % ops)
	return {"fog": fog, "ops_mult": ops, "can_surface_strike": (not fog) or ops >= 0.45, "summary": label, "bbcode": "%s🌫 Fog[/color] %s— %s[/color]" % [COLOR_TECH, COLOR_MUTED, label], "empty": false}


## Joint focus + agent priority board.
static func joint_focus_agent_priority(focus_picks: Array, agent_missions: Array, max_items: int = 3) -> Dictionary:
	var items: Array = []
	for f in focus_picks:
		if typeof(f) != TYPE_DICTIONARY:
			continue
		items.append({"kind": "focus", "id": str(f.get("id", f.get("focus_id", f.get("name", "focus")))), "score": float(f.get("score", f.get("priority", 0.0)))})
	for a in agent_missions:
		if typeof(a) != TYPE_DICTIONARY:
			continue
		items.append({"kind": "agent", "id": str(a.get("mission", a.get("id", "mission"))), "score": float(a.get("score", 0.0))})
	items.sort_custom(func(a, b): return float(a["score"]) > float(b["score"]))
	var top: Array = []
	for i in range(mini(items.size(), maxi(1, max_items))):
		top.append(items[i])
	if top.is_empty():
		return {"items": [], "empty": true, "summary": "", "count": 0}
	var best: Dictionary = top[0]
	return {
		"items": top,
		"empty": false,
		"count": top.size(),
		"best": best,
		"summary": "Joint priority · %s %s" % [str(best.get("kind", "")), str(best.get("id", ""))],
		"bbcode": "%s◆ Joint board[/color] %s— %s %s[/color]" % [COLOR_HEADER, COLOR_MUTED, str(best.get("kind", "")), str(best.get("id", ""))],
	}


