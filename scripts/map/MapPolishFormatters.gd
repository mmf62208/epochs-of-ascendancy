## Focus war path product (major #14) — pick → war path → commit
## ---------------------------------------------------------------------------

static func recommend_focus_war_step(pick_score: float = 0.5, path_score: float = 0.5, commit_ready: bool = false) -> Dictionary:
	var step := "war_path"
	var reason := "refresh war path"
	if pick_score < 0.4:
		step = "pick"
		reason = "weak pick board — re-rank focuses"
	elif path_score < 0.4:
		step = "war_path"
		reason = "war path score low — replan order"
	elif commit_ready:
		step = "commit"
		reason = "path ready — commit execute"
	var action_id := "focus_war_pick"
	var leaf := "apply_focus"
	match step:
		"war_path":
			action_id = "focus_war_path_step"
			leaf = "apply_focus"
		"commit":
			action_id = "focus_war_commit"
			leaf = "apply_hh_commit"
	return {"step": step, "action_id": action_id, "leaf": leaf, "reason": reason, "empty": false, "summary": "Recommend %s · %s" % [step, reason]}

static func focus_war_path_product(province_id: int = 1, focus_id: String = "industrial_effort") -> Dictionary:
	var focuses: Array = [
		{"id": "industrial_effort", "urgency": 0.78, "name": "Industrial Effort"},
		{"id": "naval_effort", "urgency": 0.58, "name": "Naval Effort"},
		{"id": "air_effort", "urgency": 0.62, "name": "Air Effort"},
		{"id": "army_effort", "urgency": 0.7, "name": "Army Effort"},
	]
	var picks: Dictionary = rank_focus_picks(focuses, [], 1936)
	var pick_day: Dictionary = focus_pick_day(focuses, [], 1936, province_id, 5)
	var best_id := str(picks.get("best_id", focus_id))
	if best_id.is_empty():
		best_id = focus_id
	var path: Dictionary = focus_order_path(best_id, 58.0, [], 0.65, 0.35)
	var war: Dictionary = focus_war_path_day(0.65, 0.35, "mud", best_id, 58.0, [], province_id)
	var pick_score := clampf(0.55 * clampf(float(picks.get("best_score", 50.0)) / 140.0, 0.0, 1.0) + 0.45 * float(pick_day.get("score", 0.5)), 0.0, 1.0)
	if pick_score < 0.35:
		pick_score = 0.35
	var path_score := clampf(0.55 * float(path.get("score", 0.5)) + 0.45 * float(war.get("score", 0.5)), 0.0, 1.0)
	if path_score < 0.35:
		path_score = 0.35
	var commit_score := clampf(0.5 * path_score + 0.5 * pick_score, 0.0, 1.0)
	if commit_score < 0.35:
		commit_score = 0.35
	var score := clampf(0.35 * pick_score + 0.35 * path_score + 0.3 * commit_score, 0.0, 1.0)
	if score < 0.35:
		score = 0.35
	var rec: Dictionary = recommend_focus_war_step(pick_score, path_score, path_score >= 0.4)
	var steps: Array = [
		{"step": "pick", "action_id": "focus_war_pick", "leaf": "apply_focus", "label": "Step 0 — rank/pick focus", "score": pick_score},
		{"step": "war_path", "action_id": "focus_war_path_step", "leaf": "apply_focus", "label": "Step 1 — war path order", "score": path_score},
		{"step": "commit", "action_id": "focus_war_commit", "leaf": "apply_hh_commit", "label": "Step 2 — commit / execute path", "score": commit_score},
	]
	var day_rows: Array = []
	var apply_queue: Array = []
	for i in range(steps.size()):
		var st: Dictionary = steps[i]
		var step_name := str(st.get("step"))
		var recommended: bool = step_name == str(rec.get("step"))
		var sc := float(st.get("score", 0.5))
		var leaf := str(st.get("leaf"))
		var lab := str(st.get("label"))
		if recommended:
			lab = "★ " + lab
		lab = "%s · focus %s · score %.2f" % [lab, best_id, sc]
		day_rows.append({"index": i, "step": step_name, "action_id": str(st.get("action_id")), "leaf_action": leaf, "label": lab, "score": sc, "enabled": true, "recommended": recommended, "province_id": province_id})
		apply_queue.append({"action_id": leaf, "province_id": province_id, "score": sc, "enabled": true, "label": lab, "step": step_name, "product_action": str(st.get("action_id")), "focus_id": best_id})
	var actions: Array = [
		{"action_id": "focus_war_path_product", "label": "Run focus war path product", "enabled": true},
		{"action_id": str(rec.get("action_id", "focus_war_pick")), "label": "Recommended: %s" % str(rec.get("step", "pick")), "enabled": true},
	]
	for row2 in day_rows:
		actions.append({"action_id": str(row2.get("action_id")), "label": str(row2.get("label")), "enabled": true, "step": str(row2.get("step"))})
	var label := "Focus war path · pick %s · pick %.2f · path %.2f · commit %.2f · score %.2f" % [best_id, pick_score, path_score, commit_score, score]
	return {
		"picks": picks, "pick_day": pick_day, "path": path, "war": war, "focus_id": best_id,
		"pick_score": pick_score, "path_score": path_score, "commit_score": commit_score,
		"recommendation": rec, "day_rows": day_rows, "apply_queue": apply_queue, "actions": actions,
		"score": score, "focus_score": score, "province_id": province_id,
		"summary": label, "plain": label,
		"bbcode": "%s◆ Focus war path[/color] %s— %s[/color]" % [COLOR_HEADER, COLOR_MUTED, label],
		"empty": false,
		"integration": ["focus_war_path_product", "focus_war_pick", "focus_war_path_step", "focus_war_commit", "major_14", "focus", "war_path"],
	}

static func execute_focus_war_step(step: String = "pick", province_id: int = 1, focus_id: String = "industrial_effort") -> Dictionary:
	var s := step.strip_edges().to_lower()
	if s.begins_with("focus_war_"):
		s = s.replace("focus_war_", "")
	if s == "path":
		s = "war_path"
	if s not in ["pick", "war_path", "commit"]:
		s = "pick"
	var product: Dictionary = focus_war_path_product(province_id, focus_id)
	var row: Dictionary = {}
	for r in product.get("day_rows", []):
		if r is Dictionary and str(r.get("step")) == s:
			row = r
			break
	var leaf := str(row.get("leaf_action", "apply_focus"))
	var action_id := "focus_war_pick"
	match s:
		"war_path":
			action_id = "focus_war_path_step"
		"commit":
			action_id = "focus_war_commit"
	var score := float(row.get("score", product.get("score", 0.5)))
	var apply_queue: Array = [{"action_id": leaf, "province_id": province_id, "score": score, "enabled": true, "label": str(row.get("label", s)), "step": s, "product_action": action_id}]
	var label := "Execute focus war %s · leaf %s · score %.2f" % [s, leaf, score]
	return {"step": s, "leaf_action": leaf, "action_id": action_id, "apply_queue": apply_queue, "score": score, "province_id": province_id, "summary": label, "plain": label, "bbcode": "%s◆ Focus war %s[/color] %s— %s[/color]" % [COLOR_HEADER, s, COLOR_MUTED, label], "empty": false, "ok": true, "integration": ["execute_focus_war_step", s, leaf]}

