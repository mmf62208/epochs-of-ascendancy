static func peace_conference_settlement_product(province_id: int = 1, winner_tag: String = "GER", loser_tag: String = "FRA", winner_leverage: float = 0.7) -> Dictionary:
	var diplo: Dictionary = diplomacy_peace_campaign_product(province_id)
	var lev := clampf(winner_leverage, 0.0, 1.0)
	var weight := 0.35 + 0.2 + 0.15 * 0.35  # annex + zone + reparations
	var feasibility := clampf(lev / maxf(0.25, weight + 0.15), 0.0, 1.0)
	if feasibility < 0.35: feasibility = 0.35
	var ai_accept := clampf(0.4 * lev + 0.35 * feasibility + 0.25 * (1.0 - weight * 0.5), 0.0, 1.0)
	if ai_accept < 0.35: ai_accept = 0.35
	var board_score := clampf(0.55 * float(diplo.get("score", 0.5)) + 0.45 * lev, 0.0, 1.0)
	if board_score < 0.35: board_score = 0.35
	var demands_score := clampf(0.5 * feasibility + 0.5 * ai_accept, 0.0, 1.0)
	if demands_score < 0.35: demands_score = 0.35
	var settle_score := clampf(0.4 * board_score + 0.6 * demands_score, 0.0, 1.0)
	if settle_score < 0.35: settle_score = 0.35
	var score := clampf(0.35 * board_score + 0.35 * demands_score + 0.3 * settle_score, 0.0, 1.0)
	if score < 0.35: score = 0.35
	var step := "settle" if demands_score >= 0.45 and board_score >= 0.45 else "demands"
	var rec := {"step": step, "action_id": "peace_conference_%s" % step, "leaf": "apply_assault" if step == "settle" else "apply_production", "empty": false, "summary": "Recommend %s" % step}
	var steps: Array = [
		{"step": "board", "action_id": "peace_conference_board", "leaf": "apply_focus", "label": "Step 0 — end-war conference board", "score": board_score},
		{"step": "demands", "action_id": "peace_conference_demands", "leaf": "apply_production", "label": "Step 1 — set demands package", "score": demands_score},
		{"step": "settle", "action_id": "peace_conference_settle", "leaf": "apply_assault", "label": "Step 2 — apply settlement to map", "score": settle_score},
	]
	var day_rows: Array = []
	var apply_queue: Array = []
	for i in range(steps.size()):
		var st: Dictionary = steps[i]
		var sn := str(st.get("step"))
		var recommended: bool = sn == step
		var sc := float(st.get("score", 0.5))
		var leaf := str(st.get("leaf"))
		var lab := str(st.get("label"))
		if recommended: lab = "★ " + lab
		lab = "%s · score %.2f" % [lab, sc]
		day_rows.append({"index": i, "step": sn, "action_id": str(st.get("action_id")), "leaf_action": leaf, "label": lab, "score": sc, "enabled": true, "recommended": recommended, "province_id": province_id})
		apply_queue.append({"action_id": leaf, "province_id": province_id, "score": sc, "enabled": true, "label": lab, "step": sn, "product_action": str(st.get("action_id"))})
	var label := "Peace conference · %s→%s · leverage %.0f%% · AI accept %.0f%% · score %.2f" % [winner_tag, loser_tag, lev * 100.0, ai_accept * 100.0, score]
	return {
		"diplo": diplo, "winner_tag": winner_tag, "loser_tag": loser_tag, "ai_accept": ai_accept, "feasibility": feasibility,
		"recommendation": rec, "day_rows": day_rows, "apply_queue": apply_queue,
		"actions": [{"action_id": "peace_conference_settlement_product", "label": "Run peace conference settlement product", "enabled": true}, {"action_id": str(rec.get("action_id")), "label": "Recommended: %s" % step, "enabled": true}],
		"score": score, "peace_score": score, "province_id": province_id, "summary": label, "plain": label,
		"bbcode": "%s🕊 Peace conference[/color] %s— %s[/color]" % [COLOR_HEADER, COLOR_MUTED, label], "empty": false,
		"integration": ["peace_conference_settlement_product", "peace_conference_board", "peace_conference_demands", "peace_conference_settle", "major_31", "peace", "conference", "settlement"],
	}

