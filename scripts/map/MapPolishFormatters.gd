## Agent campaign day compose.
static func agent_campaign_day(
	action_class: String = "sabotage",
	threat: float = 0.55,
	province_id: int = 1,
	available_agents: int = 5,
	trail: Array = [],
) -> Dictionary:
	var agent: Dictionary = agent_response_day(action_class, threat, province_id, available_agents)
	var trail_use: Array = trail
	if trail_use.is_empty():
		trail_use = [{"class": action_class, "influence": threat, "month": 1}]
	var hh: Dictionary = hh_campaign_day(trail_use, 3, province_id)
	var apply_queue: Array = []
	for block in [agent, hh]:
		if not (block is Dictionary) or bool(block.get("empty", false)):
			continue
		for q in block.get("apply_queue", []):
			if q is Dictionary and bool(q.get("enabled", true)):
				apply_queue.append(q)
	var seen: Dictionary = {}
	var deduped: Array = []
	for q in apply_queue:
		if not (q is Dictionary):
			continue
		var key := "%s:%d:%s" % [str(q.get("action_id", "")), int(q.get("province_id", -1)), str(q.get("focus_id", ""))]
		if seen.has(key):
			continue
		seen[key] = true
		deduped.append(q)
	if deduped.size() > 8:
		deduped = deduped.slice(0, 8)
	var a_score := 0.0 if bool(agent.get("empty", false)) else float(agent.get("score", 0.0))
	var h_score := 0.0 if bool(hh.get("empty", false)) else float(hh.get("score", 0.0))
	var n := 0
	if not bool(agent.get("empty", false)):
		n += 1
	if not bool(hh.get("empty", false)):
		n += 1
	var score: float = (a_score + h_score) / float(maxi(n, 1))
	var label := "Agent campaign day · agent %.2f · hh %.2f · q %d" % [a_score, h_score, deduped.size()]
	return {
		"agent": agent,
		"hh": hh,
		"apply_queue": deduped,
		"score": score,
		"actions": [{"action_id": "agent_campaign_day", "label": "Run agent campaign day", "enabled": not deduped.is_empty()}],
		"summary": label,
		"plain": label,
		"bbcode": "%s🕵📜 Agent campaign day[/color] %s— %s[/color]" % [COLOR_HEADER, COLOR_MUTED, label],
		"empty": deduped.is_empty() and bool(agent.get("empty", true)) and bool(hh.get("empty", true)),
	}


