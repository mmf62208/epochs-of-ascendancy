## Naval spotting mult pure (mirrors weather_effects.naval_spotting_multiplier).
static func naval_spot_weather_multiplier(visibility: float = 1.0, precip_intensity: float = 0.0) -> float:
	return clampf(visibility * (1.0 - precip_intensity * 0.5), 0.05, 1.2)


## Air sortie readiness pure gate.
static func air_sortie_weather_readiness(visibility: float = 1.0, precip_intensity: float = 0.0, wind: float = 0.2) -> Dictionary:
	var eff := clampf(
		visibility * (1.0 - precip_intensity * 0.8) * (1.0 - maxf(0.0, wind - 0.5) * 0.3),
		0.05,
		1.0,
	)
	var grounded := eff < 0.25
	return {
		"effectiveness": eff,
		"weather_eff": eff,
		"grounded": grounded,
		"can_sortie": not grounded,
		"summary": "air sortie %.0f%%%s" % [eff * 100.0, " GROUNDED" if grounded else ""],
	}


