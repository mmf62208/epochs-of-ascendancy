static func fleet_campaign_plan(
	basing_level: String = "port",
	fuel_level: float = 0.55,
	available_strength: float = 100.0,
	zone_relation: String = "contested",
	visibility: float = 1.0,
	precip: float = 0.0,
	month: int = 6,
	sea_trade_mult: float = 1.0,
) -> Dictionary:
	var basing: Dictionary = basing_fleet_fuel_logistics(
		basing_level, fuel_level, available_strength, zone_relation, "patrol", visibility, precip
	)
	var fleet_pkg: Dictionary = fleet_weather_mission_package(
		"patrol", available_strength, zone_relation, 0.0, visibility, precip
	)
	var assault: Dictionary = assault_readiness_compose(
		[{"id": 1, "power": 40.0}], available_strength, 0.85, visibility, precip
	)
	var day: Dictionary = campaign_day_risk(visibility, precip, "dry", 0.2, month)
	var theater: Dictionary = theater_readiness_board([
		str(fleet_pkg.get("summary", "")),
		str(assault.get("summary", "")),
		str(day.get("summary", "")),
	])
	var sealane: Dictionary = sealane_joint_health(sea_trade_mult, 0.9, false, "dry", precip, 0.1)
	var score := (
		float(basing.get("logistics_score", 0.5))
		+ float(theater.get("count", 1)) / 3.0
		+ float(sealane.get("score", 0.5))
	) / 3.0
