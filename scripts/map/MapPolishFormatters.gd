static func manpower_cohort_reserve_product(province_id: int = 1, population_pool: float = 100000.0, law_mult: float = 0.75, trained_stock: float = 8000.0) -> Dictionary:
	var pop := maxf(population_pool, 1000.0)
	var lm := clampf(law_mult, 0.3, 1.2)
	var youth := pop * 0.22 * lm
	var prime := pop * 0.38 * lm
	var veteran := pop * 0.28 * lm
	var elder := pop * 0.12 * lm * 0.85
	var eligible := youth + prime + veteran
	var trained := maxf(trained_stock, 0.0)
	var active := minf(trained, eligible * 0.25)
	var ready := minf(maxf(0.0, eligible * 0.35 - active * 0.1), eligible * 0.4)
	var strategic := maxf(0.0, eligible - active - ready)
	var readiness := clampf((active * 1.0 + ready * 0.7 + strategic * 0.35) / maxf(1.0, eligible), 0.35, 1.0)
	var laws: Dictionary = manpower_laws_training_product(province_id)
	var laws_s := clampf(float(laws.get("score", 0.55)), 0.35, 1.0)
	var cohort_score := clampf(0.5 * laws_s + 0.5 * minf(1.0, eligible / 60000.0), 0.35, 1.0)
	var reserve_score := clampf(0.45 + 0.55 * readiness, 0.35, 1.0)
	var mobilize_score := clampf(0.4 * reserve_score + 0.35 * cohort_score + 0.25 * minf(1.0, active / 15000.0), 0.35, 1.0)
	var score := clampf(0.3 * cohort_score + 0.35 * reserve_score + 0.35 * mobilize_score, 0.35, 1.0)
	var rec := {"step": "mobilize", "action_id": "manpower_cohort_mobilize", "leaf": "apply_station", "summary": "Recommend mobilize", "empty": false}
	var day_rows: Array = [
		{"step": "cohorts", "action_id": "manpower_cohort_board", "leaf": "apply_focus", "label": "Step 0 — age-cohort board", "score": cohort_score},
		{"step": "reserve", "action_id": "manpower_cohort_reserve", "leaf": "apply_production", "label": "Step 1 — assign reserve tiers", "score": reserve_score},
		{"step": "mobilize", "action_id": "manpower_cohort_mobilize", "leaf": "apply_station", "label": "Step 2 — mobilize field strength", "score": mobilize_score},
	]
	var apply_queue: Array = []
	for row in day_rows:
		apply_queue.append({"action_id": str(row.get("leaf")), "province_id": province_id, "score": float(row.get("score", 0.5)), "enabled": true, "label": str(row.get("label")), "step": str(row.get("step")), "product_action": str(row.get("action_id"))})
	var mobilized := active * 0.85
	var label := "Manpower cohort/reserve · eligible %.0f · active %.0f · mobilize %.0f · score %.2f" % [eligible, active, mobilized, score]
	return {
		"recommendation": rec, "day_rows": day_rows, "apply_queue": apply_queue,
		"actions": [{"action_id": "manpower_cohort_reserve_product", "label": "Run manpower cohort/reserve product", "enabled": true}, {"action_id": "manpower_cohort_mobilize", "label": "Recommended: mobilize", "enabled": true}],
		"eligible": eligible, "active": active, "ready": ready, "strategic": strategic, "mobilized": mobilized,
		"readiness": readiness, "score": score, "cohort_score": score, "province_id": province_id,
		"summary": label, "plain": label, "bbcode": "[color=#70b090]👥 Cohort/reserve[/color] [color=#8899aa]%s[/color]" % label,
		"empty": false, "integration": ["manpower_cohort_reserve_product", "manpower_cohort_board", "manpower_cohort_reserve", "manpower_cohort_mobilize", "major_36", "phase4_depth"],
	}

