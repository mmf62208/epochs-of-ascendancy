static func _demo_hh_multi_month_trail() -> Array:
	return [
		{"action_class": "sabotage", "influence": 0.62, "province_id": 1, "year": 1939, "month": 9, "summary": "sabotage pulse"},
		{"action_class": "economic_pressure", "influence": 0.48, "province_id": 2, "year": 1939, "month": 10, "summary": "economic pressure"},
		{"action_class": "infiltration", "influence": 0.55, "province_id": 3, "year": 1939, "month": 11, "summary": "infiltration"},
		{"action_class": "sabotage", "influence": 0.4, "province_id": 4, "year": 1939, "month": 12, "summary": "sabotage follow"},
		{"action_class": "economic_pressure", "influence": 0.52, "province_id": 5, "year": 1940, "month": 1, "summary": "econ pressure"},
		{"action_class": "infiltration", "influence": 0.58, "province_id": 6, "year": 1940, "month": 2, "summary": "infiltration deep"},
	]

static func filter_trail_by_class(trail: Array, action_class: String = "") -> Array:
	var ac := action_class.strip_edges().to_lower()
	var out: Array = []
	for e in trail:
		if not (e is Dictionary):
			continue
		if ac.is_empty() or str(e.get("action_class", e.get("class", ""))).to_lower() == ac:
			out.append(e)
	return out

static func recommend_hh_month_step(trail_count: int, class_count: int = 0, counter_options: int = 0) -> Dictionary:
	var step := "monthly_brief"
	var reason := "run monthly brief / pulse actions"
	if trail_count <= 0:
		step = "trail_board"
		reason = "empty trail — wait for pulse / open board"
	elif trail_count < 3 or class_count < 2:
		step = "trail_board"
		reason = "build multi-class trail board"
	elif counter_options >= 2:
		step = "quarterly_counter"
		reason = "counterplay ready — commit quarterly"
	var action_id := "hh_month_trail_board"
	var leaf := "apply_agent_dispatch"
	match step:
		"monthly_brief":
			action_id = "hh_month_brief"
			leaf = "apply_counterplay"
		"quarterly_counter":
			action_id = "hh_month_quarterly_counter"
			leaf = "apply_hh_commit"
	return {
		"step": step, "action_id": action_id, "leaf": leaf, "reason": reason, "empty": false,
		"summary": "Recommend %s · %s" % [step, reason],
	}

static func hh_multi_month_agenda_product(
	trail: Array = [],
	action_class_filter: String = "",
	province_id: int = 1,
	max_actions: int = 4,
) -> Dictionary:
	var base_trail: Array = trail if not trail.is_empty() else _demo_hh_multi_month_trail()
	var filtered: Array = filter_trail_by_class(base_trail, action_class_filter)
	var use_trail: Array = filtered if not filtered.is_empty() else base_trail
	var panel: Dictionary = hh_agenda_product_screen(use_trail)
	var path: Dictionary = hh_agenda_player_path(use_trail, province_id, max_actions)
	var quarterly_plain := format_hh_quarterly_rollup_from_trail(use_trail)
	var commits_plain := format_hh_agenda_commitments_from_trail(use_trail, 3)
	# Class order from trail
	var class_order: Array = []
	var class_seen: Dictionary = {}
	for e in use_trail:
		if not (e is Dictionary):
			continue
		var ac := str(e.get("action_class", e.get("class", ""))).strip_edges()
		if ac.is_empty() or class_seen.has(ac):
			continue
		class_seen[ac] = true
		class_order.append(ac)
	var months: Dictionary = {}
	for e2 in use_trail:
		if e2 is Dictionary:
			months["%d-%d" % [int(e2.get("year", 0)), int(e2.get("month", 0))]] = true
	var months_covered := maxi(months.size(), 1 if not use_trail.is_empty() else 0)
	var trail_count := use_trail.size()
	var class_count := class_order.size()
	var pick_count := 0
	for q in path.get("apply_queue", []):
		if q is Dictionary:
			pick_count += 1
	var opt_count := pick_count
	var reduction := 0.12 if trail_count > 0 else 0.0
	var score := clampf(
		0.3 * minf(1.0, float(trail_count) / 6.0)
		+ 0.2 * minf(1.0, float(class_count) / 3.0)
		+ 0.2 * minf(1.0, float(months_covered) / 3.0)
		+ 0.15 * minf(1.0, float(maxi(opt_count, pick_count)) / 3.0)
		+ 0.15 * minf(1.0, reduction * 5.0),
		0.0, 1.0
	)
	if score < 0.35 and trail_count > 0:
		score = 0.35
	var rec: Dictionary = recommend_hh_month_step(trail_count, class_count, maxi(opt_count, pick_count))
	var step_scores := {
		"trail_board": clampf(minf(1.0, float(trail_count) / 6.0), 0.35, 1.0),
		"monthly_brief": clampf(0.5 + 0.1 * float(mini(3, pick_count)), 0.35, 1.0),
		"quarterly_counter": clampf(0.45 + reduction * 2.0 + 0.05 * float(opt_count), 0.35, 1.0),
	}
	var steps: Array = [
		{"step": "trail_board", "action_id": "hh_month_trail_board", "leaf": "apply_agent_dispatch", "label": "Month board — trail + class filter"},
		{"step": "monthly_brief", "action_id": "hh_month_brief", "leaf": "apply_counterplay", "label": "Monthly brief — pulse + actions"},
		{"step": "quarterly_counter", "action_id": "hh_month_quarterly_counter", "leaf": "apply_hh_commit", "label": "Quarterly — commit counterplay"},
	]
	var day_rows: Array = []
	var apply_queue: Array = []
	for i in range(steps.size()):
		var st: Dictionary = steps[i]
		var step_name := str(st.get("step"))
		var recommended := step_name == str(rec.get("step"))
		var sc := float(step_scores.get(step_name, 0.5))
		var lab := str(st.get("label"))
		if recommended:
			lab = "★ " + lab
		lab = "%s · score %.2f" % [lab, sc]
		var focus_pid := province_id
		if not use_trail.is_empty() and use_trail[use_trail.size() - 1] is Dictionary:
			focus_pid = int(use_trail[use_trail.size() - 1].get("province_id", province_id))
		var row := {
			"index": i, "step": step_name, "action_id": str(st.get("action_id")),
			"leaf_action": str(st.get("leaf")), "label": lab, "score": sc,
			"enabled": trail_count > 0 or step_name == "trail_board",
			"recommended": recommended, "province_id": focus_pid,
		}
		day_rows.append(row)
		apply_queue.append({
			"action_id": str(st.get("leaf")), "province_id": focus_pid, "score": sc,
			"enabled": bool(row.get("enabled")), "label": lab, "step": step_name,
			"product_action": str(st.get("action_id")),
		})
	var actions: Array = [
		{"action_id": "hh_multi_month_agenda_product", "label": "Run HH multi-month agenda product", "enabled": true},
		{"action_id": str(rec.get("action_id", "hh_month_trail_board")), "label": "Recommended: %s" % str(rec.get("step", "trail_board")), "enabled": true},
		{"action_id": "apply_counterplay", "label": "Commit counterplay", "enabled": trail_count > 0},
		{"action_id": "apply_hh_commit", "label": "HH commit pulse", "enabled": trail_count > 0},
	]
	for row2 in day_rows:
		actions.append({"action_id": str(row2.get("action_id")), "label": str(row2.get("label")), "enabled": bool(row2.get("enabled")), "step": str(row2.get("step"))})
	var class_filters: Array = [{"id": "", "label": "All classes"}]
	for c in class_order:
		class_filters.append({"id": str(c), "label": str(c)})
	var monthly_headline := "Monthly Hand brief · trail %d · classes %d" % [trail_count, class_count]
	if not quarterly_plain.is_empty():
		monthly_headline = quarterly_plain.split("\n")[0] if quarterly_plain.contains("\n") else quarterly_plain
	var label := "HH multi-month agenda · trail %d · classes %d · months %d · filter %s · score %.2f" % [
		trail_count, class_count, months_covered, action_class_filter if not action_class_filter.is_empty() else "all", score
	]
	var plain_lines: PackedStringArray = [label, str(rec.get("summary", "")), monthly_headline]
	if not commits_plain.is_empty():
		plain_lines.append(commits_plain.split("\n")[0])
	for row3 in day_rows:
		plain_lines.append(str(row3.get("label", "")))
	if not bool(panel.get("empty", false)):
		plain_lines.append(str(panel.get("summary", "")))
	return {
		"trail": use_trail, "trail_count": trail_count, "class_order": class_order,
		"class_filters": class_filters, "action_class_filter": action_class_filter,
		"panel": panel, "path": path, "monthly_headline": monthly_headline,
		"quarterly_plain": quarterly_plain, "commits_plain": commits_plain,
		"months_covered": months_covered, "recommendation": rec,
		"day_rows": day_rows, "apply_queue": apply_queue, "actions": actions,
		"score": score, "hh_score": score, "province_id": province_id,
		"apply_ready": trail_count > 0,
		"summary": label, "plain": "\n".join(plain_lines),
		"bbcode": "[color=#c084fc]◈ HH multi-month agenda[/color] %s— %s[/color]" % [COLOR_MUTED, label],
		"empty": trail_count <= 0,
		"integration": ["hh_multi_month_agenda_product", "hh_month_trail_board", "hh_month_brief", "hh_month_quarterly_counter", "major_5"],
	}

static func execute_hh_month_step(
	step: String = "trail_board",
	province_id: int = 1,
	trail: Array = [],
	action_class_filter: String = "",
) -> Dictionary:
	var s := step.strip_edges().to_lower()
	if s.begins_with("hh_month_"):
		s = s.replace("hh_month_", "")
	if s == "brief":
		s = "monthly_brief"
	if s == "quarterly_counter" or s.ends_with("quarterly_counter"):
		s = "quarterly_counter"
	elif s == "monthly_brief" or s.ends_with("brief"):
		s = "monthly_brief"
	elif s not in ["trail_board", "monthly_brief", "quarterly_counter"]:
		s = "trail_board"
	var product: Dictionary = hh_multi_month_agenda_product(trail, action_class_filter, province_id)
	var row: Dictionary = {}
	for r in product.get("day_rows", []):
		if r is Dictionary and str(r.get("step")) == s:
			row = r
			break
	var leaf := "apply_agent_dispatch"
	var action_id := "hh_month_trail_board"
	var lab := "Month board — trail + class filter"
	match s:
		"monthly_brief":
			leaf = "apply_counterplay"
			action_id = "hh_month_brief"
			lab = "Monthly brief — pulse + actions"
		"quarterly_counter":
			leaf = "apply_hh_commit"
			action_id = "hh_month_quarterly_counter"
			lab = "Quarterly — commit counterplay"
	var score := float(row.get("score", product.get("score", 0.5)))
	var apply_queue: Array = [{
		"action_id": leaf, "province_id": province_id, "score": score,
		"enabled": bool(row.get("enabled", true)), "label": lab, "step": s, "product_action": action_id,
	}]
	var label := "Execute HH %s · leaf %s · score %.2f · #%d" % [s, leaf, score, province_id]
	return {
		"step": s, "leaf_action": leaf, "action_id": action_id, "apply_queue": apply_queue,
		"score": score, "province_id": province_id, "summary": label, "plain": label,
		"bbcode": "[color=#c084fc]◈ HH %s[/color] %s— %s[/color]" % [s, COLOR_MUTED, label],
		"empty": false, "ok": true,
		"integration": ["execute_hh_month_step", s, leaf],
	}

## ---------------------------------------------------------------------------
## Agent campaign product (major #6) — board → dispatch → counterplay
## Composes agent_ai_board + coverage + campaign response + escalation (not stubs).
## ---------------------------------------------------------------------------

static func recommend_agent_product_step(
	signal_count: int,
	coverage_count: int = 0,
	counter_options: int = 0,
	affinity: float = 0.5,
) -> Dictionary:
	var step := "dispatch"
	var reason := "dispatch agents to coverage plan"
	if signal_count <= 0:
		step = "board"
		reason = "no signals — open board / wait for pulse"
	elif coverage_count <= 0 or affinity < 0.35:
		step = "board"
		reason = "pick missions on AI board"
	elif counter_options >= 1 and coverage_count >= 1:
		step = "counterplay"
		reason = "coverage set — escalate / counterplay"
	var action_id := "agent_product_board"
	var leaf := "apply_agent_dispatch"
	match step:
		"dispatch":
			action_id = "agent_product_dispatch"
			leaf = "apply_agent_dispatch"
		"counterplay":
			action_id = "agent_product_counterplay"
			leaf = "apply_counterplay"
	return {
		"step": step, "action_id": action_id, "leaf": leaf, "reason": reason, "empty": false,
		"summary": "Recommend %s · %s" % [step, reason],
	}

static func _demo_agent_campaign_signals() -> Array:
	return [
		{"action_class": "sabotage", "influence": 0.62, "province_id": 1, "active": true, "loyalty": 0.45},
		{"action_class": "economic_pressure", "influence": 0.48, "province_id": 2, "active": true, "loyalty": 0.55},
		{"action_class": "infiltration", "influence": 0.55, "province_id": 3, "active": true, "loyalty": 0.4},
	]

static func agent_campaign_product(
	signals: Array = [],
	available_agents: int = 5,
	network_strength: float = 0.35,
	loyalty: float = 0.5,
	province_id: int = 1,
	max_dispatches: int = 3,
) -> Dictionary:
	var use_signals: Array = signals if not signals.is_empty() else _demo_agent_campaign_signals()
	var focus: Dictionary = use_signals[0] if use_signals[0] is Dictionary else {"action_class": "sabotage", "influence": 0.55, "province_id": province_id}
	var ac := str(focus.get("action_class", focus.get("class", "sabotage"))).strip_edges().to_lower()
	if ac.is_empty():
		ac = "sabotage"
	var threat := float(focus.get("influence", focus.get("threat", 0.55)))
	var focus_pid := int(focus.get("province_id", province_id))
	var board: Dictionary = agent_ai_board(ac, threat, focus_pid, true, network_strength, loyalty, available_agents)
	var quality: Dictionary = agent_ai_decision_quality(use_signals, available_agents, network_strength)
	var coverage: Dictionary = plan_agent_coverage(use_signals, available_agents, network_strength)
	var response: Dictionary = agent_campaign_response(ac, threat, focus_pid, available_agents, network_strength, loyalty)
	var auto: Dictionary = agent_auto_dispatch_day(use_signals, available_agents, network_strength, max_dispatches)
	var signal_count := use_signals.size()
	var cov_count := int(coverage.get("covered", coverage.get("count", 0)))
	if cov_count <= 0:
		for a in coverage.get("assignments", []):
			if a is Dictionary and int(a.get("agents", 0)) > 0:
				cov_count += 1
	var opt_count := 0
	for d in quality.get("decisions", []):
		if d is Dictionary:
			opt_count += 1
	if opt_count <= 0:
		opt_count = int(auto.get("dispatch_queue", []).size()) if auto.get("dispatch_queue") is Array else 0
	var affinity := float(quality.get("affinity", 0.5))
	if bool(quality.get("empty", false)):
		affinity = 0.4
	var resp_score := float(response.get("score", 0.55))
	var board_score := float(board.get("score", 0.5))
	var auto_score := float(auto.get("score", 0.5))
	var score := clampf(
		0.3 * resp_score + 0.25 * board_score + 0.2 * minf(1.0, float(signal_count) / 3.0)
		+ 0.15 * minf(1.0, float(cov_count) / 3.0) + 0.1 * auto_score,
		0.0, 1.0
	)
	if score < 0.35 and signal_count > 0:
		score = 0.35
	var rec: Dictionary = recommend_agent_product_step(signal_count, cov_count, maxi(opt_count, 1), affinity)
	var step_scores := {
		"board": clampf(0.45 + 0.15 * float(mini(3, signal_count)), 0.35, 1.0),
		"dispatch": clampf(0.4 + 0.15 * float(mini(3, cov_count)), 0.35, 1.0),
		"counterplay": clampf(0.4 + 0.1 * float(mini(3, opt_count)) + 0.1 * affinity, 0.35, 1.0),
	}
	var steps: Array = [
		{"step": "board", "action_id": "agent_product_board", "leaf": "apply_agent_dispatch", "label": "Step 0 — AI board / mission pick"},
		{"step": "dispatch", "action_id": "agent_product_dispatch", "leaf": "apply_agent_dispatch", "label": "Step 1 — coverage dispatch"},
		{"step": "counterplay", "action_id": "agent_product_counterplay", "leaf": "apply_counterplay", "label": "Step 2 — counterplay / escalate"},
	]
	var day_rows: Array = []
	var apply_queue: Array = []
	for i in range(steps.size()):
		var st: Dictionary = steps[i]
		var step_name := str(st.get("step"))
		var recommended := step_name == str(rec.get("step"))
		var sc := float(step_scores.get(step_name, 0.5))
		var lab := str(st.get("label"))
		if recommended:
			lab = "★ " + lab
		lab = "%s · score %.2f" % [lab, sc]
		var row := {
			"index": i, "step": step_name, "action_id": str(st.get("action_id")),
			"leaf_action": str(st.get("leaf")), "label": lab, "score": sc,
			"enabled": signal_count > 0 or step_name == "board",
			"recommended": recommended, "province_id": focus_pid,
		}
		day_rows.append(row)
		apply_queue.append({
			"action_id": str(st.get("leaf")), "province_id": focus_pid, "score": sc,
			"enabled": bool(row.get("enabled")), "label": lab, "step": step_name,
			"product_action": str(st.get("action_id")), "action_class": ac,
		})
	# Coverage dispatches
	var assigned: Array = coverage.get("assignments", [])
	var added := 0
	for a in assigned:
		if not (a is Dictionary):
			continue
		if int(a.get("agents", 0)) <= 0:
			continue
		var pid := int(a.get("province_id", focus_pid))
		if pid == focus_pid and added == 0:
			added += 1
			continue
		apply_queue.append({
			"action_id": "apply_agent_dispatch", "province_id": pid, "score": score, "enabled": true,
			"label": "Dispatch · #%d · %s" % [pid, str(a.get("action_class", "signal"))],
			"step": "dispatch", "product_action": "agent_product_dispatch",
			"action_class": str(a.get("action_class", ac)),
		})
		added += 1
		if added >= max_dispatches:
			break
	var best_mission := str(board.get("best_mission", response.get("top_action", "counterintel")))
	var actions: Array = [
		{"action_id": "agent_campaign_product", "label": "Run agent campaign product", "enabled": true},
		{"action_id": str(rec.get("action_id", "agent_product_board")), "label": "Recommended: %s" % str(rec.get("step", "board")), "enabled": true},
		{"action_id": "apply_agent_dispatch", "label": "Dispatch agents", "enabled": signal_count > 0},
		{"action_id": "apply_counterplay", "label": "Apply counter-intel", "enabled": signal_count > 0},
	]
	for row2 in day_rows:
		actions.append({"action_id": str(row2.get("action_id")), "label": str(row2.get("label")), "enabled": bool(row2.get("enabled")), "step": str(row2.get("step"))})
	var label := "Agent campaign product · signals %d · coverage %d · affinity %.0f%% · mission %s · score %.2f" % [
		signal_count, cov_count, affinity * 100.0, best_mission, score
	]
	var plain_lines: PackedStringArray = [label, str(rec.get("summary", "")), str(board.get("summary", "")), str(coverage.get("summary", ""))]
	for row3 in day_rows:
		plain_lines.append(str(row3.get("label", "")))
	return {
		"signals": use_signals, "signal_count": signal_count, "coverage": coverage, "coverage_count": cov_count,
		"board": board, "quality": quality, "response": response, "auto": auto,
		"affinity": affinity, "best_mission": best_mission, "recommendation": rec,
		"day_rows": day_rows, "apply_queue": apply_queue, "actions": actions,
		"score": score, "agent_score": score, "province_id": province_id,
		"available_agents": available_agents, "apply_ready": signal_count > 0 and available_agents >= 1,
		"summary": label, "plain": "\n".join(plain_lines),
		"bbcode": "%s🕵 Agent campaign product[/color] %s— %s[/color]" % [COLOR_HEADER, COLOR_MUTED, label],
		"empty": signal_count <= 0,
		"integration": ["agent_campaign_product", "agent_product_board", "agent_product_dispatch", "agent_product_counterplay", "major_6"],
	}

static func execute_agent_product_step(
	step: String = "board",
	province_id: int = 1,
	signals: Array = [],
) -> Dictionary:
	var s := step.strip_edges().to_lower()
	if s.begins_with("agent_product_"):
		s = s.replace("agent_product_", "")
	if s not in ["board", "dispatch", "counterplay"]:
		s = "board"
	var product: Dictionary = agent_campaign_product(signals, 5, 0.35, 0.5, province_id)
	var row: Dictionary = {}
	for r in product.get("day_rows", []):
		if r is Dictionary and str(r.get("step")) == s:
			row = r
			break
	var leaf := "apply_agent_dispatch"
	var action_id := "agent_product_board"
	var lab := "Step 0 — AI board / mission pick"
	match s:
		"dispatch":
			leaf = "apply_agent_dispatch"
			action_id = "agent_product_dispatch"
			lab = "Step 1 — coverage dispatch"
		"counterplay":
			leaf = "apply_counterplay"
			action_id = "agent_product_counterplay"
			lab = "Step 2 — counterplay / escalate"
	var score := float(row.get("score", product.get("score", 0.5)))
	var apply_queue: Array = [{
		"action_id": leaf, "province_id": province_id, "score": score,
		"enabled": bool(row.get("enabled", true)), "label": lab, "step": s, "product_action": action_id,
	}]
	var label := "Execute agent %s · leaf %s · score %.2f · #%d" % [s, leaf, score, province_id]
	return {
		"step": s, "leaf_action": leaf, "action_id": action_id, "apply_queue": apply_queue,
		"score": score, "province_id": province_id, "summary": label, "plain": label,
		"bbcode": "%s🕵 Agent %s[/color] %s— %s[/color]" % [COLOR_HEADER, s, COLOR_MUTED, label],
		"empty": false, "ok": true,
		"integration": ["execute_agent_product_step", s, leaf],
	}

## ---------------------------------------------------------------------------
## Inspector decision product (major #7) — primary strip · collapse · apply
## ---------------------------------------------------------------------------

static func recommend_inspector_product_step(shown: int, hidden: int, primary_count: int = 0) -> Dictionary:
	var step := "apply_decision"
	var reason := "apply recommended leaf decision"
	if primary_count <= 0 or shown <= 0:
		step = "primary_strip"
		reason = "build primary decision strip"
	elif hidden >= 3:
		step = "collapse_budget"
		reason = "collapse secondary chips (high hidden)"
	var action_id := "inspector_product_primary"
	var leaf := "apply_station"
	match step:
		"collapse_budget":
			action_id = "inspector_product_collapse"
			leaf = "refresh_queue"
		"apply_decision":
			action_id = "inspector_product_apply"
			leaf = "apply_supply"
	return {
		"step": step, "action_id": action_id, "leaf": leaf, "reason": reason, "empty": false,
		"summary": "Recommend %s · %s" % [step, reason],
	}

static func inspector_decision_product(
	chips: Array = [],
	province_id: int = 1,
	max_primary: int = 6,
	max_chips: int = 8,
) -> Dictionary:
	var use_chips: Array = chips
	if use_chips.is_empty():
		# Demo flood: majors + noise
		var majors := ["multi_phase_combat_product", "fleet_multi_day_autonomy_product", "medium_tank_oob_product", "agent_campaign_product", "hh_multi_month_agenda_product", "naval_skim", "combat_campaign_day", "fleet_campaign_day"]
		for i in range(majors.size()):
			use_chips.append({"id": majors[i], "bbcode": "[chip]%s[/chip]" % majors[i], "priority": 110 - i})
		for n in range(12):
			use_chips.append({"id": "day_noise_%d" % n, "bbcode": "day package noise %d" % n, "priority": 20})
	# Priority boost for major products
	var major_set := {
		"multi_phase_combat_product": 110, "fleet_multi_day_autonomy_product": 109,
		"medium_tank_oob_product": 108, "agent_campaign_product": 107,
		"hh_multi_month_agenda_product": 106, "save_browser_campaign_product": 105,
		"naval_skim": 100, "combat_campaign_day": 90, "fleet_campaign_day": 90,
	}
	for c in use_chips:
		if c is Dictionary:
			var cid := str(c.get("id", ""))
			if major_set.has(cid):
				c["priority"] = maxi(int(c.get("priority", 0)), int(major_set[cid]))
	var budget: Dictionary = budget_product_depth_chips(use_chips, max_chips, true)
	var selected: Array = budget.get("chips", [])
	var shown := int(budget.get("shown", selected.size()))
	var hidden := int(budget.get("hidden", 0))
	var total := int(budget.get("total", use_chips.size()))
	var primary: Array = []
	for c in selected:
		if not (c is Dictionary):
			continue
		var cid2 := str(c.get("id", ""))
		if major_set.has(cid2) or int(c.get("priority", 0)) >= 80:
			primary.append(c)
		if primary.size() >= max_primary:
			break
	if primary.is_empty() and not selected.is_empty():
		primary = selected.slice(0, mini(3, selected.size()))
	var primary_count := primary.size()
	var collapse_ratio := float(hidden) / float(maxi(1, total))
	var score := clampf(
		0.35 * minf(1.0, float(primary_count) / 4.0)
		+ 0.3 * minf(1.0, float(shown) / float(maxi(1, max_chips)))
		+ 0.2 * minf(1.0, collapse_ratio * 2.0)
		+ 0.15 * (0.8 if hidden >= 2 else 0.4),
		0.0, 1.0
	)
	if score < 0.35:
		score = 0.35
	var rec: Dictionary = recommend_inspector_product_step(shown, hidden, primary_count)
	var decision_lines: Array = []
	for c2 in primary:
		if c2 is Dictionary:
			decision_lines.append(str(c2.get("id", "")))
	if decision_lines.is_empty():
		decision_lines = ["station basing", "supply sustain", "inspect collapse"]
	var strip: Dictionary = execution_decision_strip(decision_lines)
	var campaign: Dictionary = campaign_decision_strip(decision_lines)
	var step_scores := {
		"primary_strip": clampf(0.5 + 0.1 * float(mini(4, primary_count)), 0.35, 1.0),
		"collapse_budget": clampf(0.45 + 0.15 * minf(1.0, collapse_ratio * 3.0), 0.35, 1.0),
		"apply_decision": clampf(0.5 + 0.05 * float(shown), 0.35, 1.0),
	}
	var steps: Array = [
		{"step": "primary_strip", "action_id": "inspector_product_primary", "leaf": "apply_station", "label": "Step 0 — primary decision strip"},
		{"step": "collapse_budget", "action_id": "inspector_product_collapse", "leaf": "refresh_queue", "label": "Step 1 — collapse secondary chips"},
		{"step": "apply_decision", "action_id": "inspector_product_apply", "leaf": "apply_supply", "label": "Step 2 — apply recommended decision"},
	]
	var day_rows: Array = []
	var apply_queue: Array = []
	for i in range(steps.size()):
		var st: Dictionary = steps[i]
		var step_name := str(st.get("step"))
		var recommended := step_name == str(rec.get("step"))
		var sc := float(step_scores.get(step_name, 0.5))
		var lab := str(st.get("label"))
		if recommended:
			lab = "★ " + lab
		lab = "%s · score %.2f" % [lab, sc]
		var row := {
			"index": i, "step": step_name, "action_id": str(st.get("action_id")),
			"leaf_action": str(st.get("leaf")), "label": lab, "score": sc,
			"enabled": true, "recommended": recommended, "province_id": province_id,
		}
		day_rows.append(row)
		apply_queue.append({
			"action_id": str(st.get("leaf")), "province_id": province_id, "score": sc, "enabled": true,
			"label": lab, "step": step_name, "product_action": str(st.get("action_id")),
		})
	var actions: Array = [
		{"action_id": "inspector_decision_product", "label": "Run inspector decision product", "enabled": true},
		{"action_id": str(rec.get("action_id", "inspector_product_primary")), "label": "Recommended: %s" % str(rec.get("step", "primary_strip")), "enabled": true},
	]
	for row2 in day_rows:
		actions.append({"action_id": str(row2.get("action_id")), "label": str(row2.get("label")), "enabled": true, "step": str(row2.get("step"))})
	var label := "Inspector decision product · primary %d · shown %d/%d · hidden %d · score %.2f" % [
		primary_count, shown, total, hidden, score
	]
	var plain_lines: PackedStringArray = [label, str(rec.get("summary", "")), "primary: %s" % ", ".join(PackedStringArray(decision_lines)), str(budget.get("summary", ""))]
	for row3 in day_rows:
		plain_lines.append(str(row3.get("label", "")))
	return {
		"budget": budget, "primary": primary, "primary_count": primary_count, "decision_lines": decision_lines,
		"strip": strip, "campaign": campaign, "shown": shown, "hidden": hidden, "total": total,
		"collapse_ratio": collapse_ratio, "recommendation": rec, "day_rows": day_rows,
		"apply_queue": apply_queue, "actions": actions, "score": score, "inspector_score": score,
		"province_id": province_id, "apply_ready": primary_count > 0,
		"summary": label, "plain": "\n".join(plain_lines),
		"bbcode": "%s◆ Inspector decision[/color] %s— %s[/color]" % [COLOR_HEADER, COLOR_MUTED, label],
		"empty": total <= 0,
		"integration": ["inspector_decision_product", "inspector_product_primary", "inspector_product_collapse", "inspector_product_apply", "major_7"],
	}

static func execute_inspector_product_step(step: String = "primary_strip", province_id: int = 1, chips: Array = []) -> Dictionary:
	var s := step.strip_edges().to_lower()
	if s.begins_with("inspector_product_"):
		s = s.replace("inspector_product_", "")
		if s == "primary":
			s = "primary_strip"
		elif s == "collapse":
			s = "collapse_budget"
		elif s == "apply":
			s = "apply_decision"
	if s not in ["primary_strip", "collapse_budget", "apply_decision"]:
		s = "primary_strip"
	var product: Dictionary = inspector_decision_product(chips, province_id)
	var row: Dictionary = {}
	for r in product.get("day_rows", []):
		if r is Dictionary and str(r.get("step")) == s:
			row = r
			break
	var leaf := "apply_station"
	var action_id := "inspector_product_primary"
	var lab := "Step 0 — primary decision strip"
	match s:
		"collapse_budget":
			leaf = "refresh_queue"
			action_id = "inspector_product_collapse"
			lab = "Step 1 — collapse secondary chips"
		"apply_decision":
			leaf = "apply_supply"
			action_id = "inspector_product_apply"
			lab = "Step 2 — apply recommended decision"
	var score := float(row.get("score", product.get("score", 0.5)))
	var apply_queue: Array = [{
		"action_id": leaf, "province_id": province_id, "score": score, "enabled": true,
		"label": lab, "step": s, "product_action": action_id,
	}]
	var label := "Execute inspector %s · leaf %s · score %.2f · #%d" % [s, leaf, score, province_id]
	return {
		"step": s, "leaf_action": leaf, "action_id": action_id, "apply_queue": apply_queue,
		"score": score, "province_id": province_id, "summary": label, "plain": label,
		"bbcode": "%s◆ Inspector %s[/color] %s— %s[/color]" % [COLOR_HEADER, s, COLOR_MUTED, label],
		"empty": false, "ok": true,
		"integration": ["execute_inspector_product_step", s, leaf],
	}

## ---------------------------------------------------------------------------
## Theater command product (major #8) — domain rank strip for order panel
## ---------------------------------------------------------------------------

static func recommend_theater_command_step(domain_count: int, top_score: float = 0.5) -> Dictionary:
	var step := "execute"
	var reason := "execute top domain recommendation"
	if domain_count <= 0:
		step = "scan"
		reason = "no domain products — scan"
	elif top_score < 0.4:
		step = "rank"
		reason = "low scores — re-rank domains"
	var action_id := "theater_command_scan"
	var leaf := "apply_station"
	match step:
		"rank":
			action_id = "theater_command_rank"
			leaf = "apply_focus"
		"execute":
			action_id = "theater_command_execute"
			leaf = "apply_supply"
	return {
		"step": step, "action_id": action_id, "leaf": leaf, "reason": reason, "empty": false,
		"summary": "Recommend %s · %s" % [step, reason],
	}

static func theater_command_product(
	province_id: int = 1,
	fuel_level: float = 0.65,
	tank_progress: float = 0.15,
	factories: int = 14,
) -> Dictionary:
	var combat: Dictionary = multi_phase_combat_product(100.0, 80.0, 0.85, 1.0, province_id)
	var fleet: Dictionary = fleet_multi_day_autonomy_product(fuel_level, "port", "contested", 100.0, "GER", province_id, 3)
	var industry: Dictionary = medium_tank_oob_product(province_id, tank_progress, 0.0, 5.0, factories)
	var hh: Dictionary = hh_multi_month_agenda_product([], "", province_id)
	var agent: Dictionary = agent_campaign_product([], 5, 0.35, 0.5, province_id)
	var domain_specs: Array = [
		{"domain": "combat", "block": combat, "leaf": "apply_assault", "weight": 1.0},
		{"domain": "fleet", "block": fleet, "leaf": "apply_station", "weight": 0.95},
		{"domain": "industry", "block": industry, "leaf": "apply_production", "weight": 0.9},
		{"domain": "hh", "block": hh, "leaf": "apply_hh_commit", "weight": 0.85},
		{"domain": "agent", "block": agent, "leaf": "apply_agent_dispatch", "weight": 0.88},
	]
	var domains: Array = []
	for spec in domain_specs:
		var block: Dictionary = spec.get("block", {})
		if bool(block.get("empty", false)):
			continue
		var sc := clampf(float(block.get("score", 0.5)), 0.0, 1.0)
		var w := float(spec.get("weight", 1.0))
		var rec_d: Dictionary = block.get("recommendation", {})
		domains.append({
			"domain": str(spec.get("domain")),
			"score": sc * w,
			"raw_score": sc,
			"summary": str(block.get("summary", "")).substr(0, 120),
			"recommendation": rec_d,
			"leaf": str(spec.get("leaf")),
		})
	domains.sort_custom(func(a, b): return float(a.get("score", 0)) > float(b.get("score", 0)))
	var top: Dictionary = domains[0] if not domains.is_empty() else {"domain": "fleet", "score": 0.45, "leaf": "apply_station", "summary": "empty"}
	var top_score := float(top.get("score", 0.45))
	var domain_count := domains.size()
	var mean_raw := 0.0
	for d in domains:
		mean_raw += float(d.get("raw_score", 0.5))
	if domain_count > 0:
		mean_raw /= float(domain_count)
	var score := clampf(0.4 * top_score + 0.3 * minf(1.0, float(domain_count) / 5.0) + 0.3 * mean_raw, 0.0, 1.0)
	if score < 0.35 and domain_count > 0:
		score = 0.35
	var rec: Dictionary = recommend_theater_command_step(domain_count, top_score)
	var step_scores := {
		"scan": clampf(0.4 + 0.1 * float(mini(5, domain_count)), 0.35, 1.0),
		"rank": clampf(0.45 + 0.2 * top_score, 0.35, 1.0),
		"execute": clampf(0.5 + 0.25 * top_score, 0.35, 1.0),
	}
	var steps: Array = [
		{"step": "scan", "action_id": "theater_command_scan", "leaf": "apply_station", "label": "Step 0 — scan theater domains"},
		{"step": "rank", "action_id": "theater_command_rank", "leaf": "apply_focus", "label": "Step 1 — rank domain recommendations"},
		{"step": "execute", "action_id": "theater_command_execute", "leaf": str(top.get("leaf", "apply_supply")), "label": "Step 2 — execute top domain leaf"},
	]
	var day_rows: Array = []
	var apply_queue: Array = []
	for i in range(steps.size()):
		var st: Dictionary = steps[i]
		var step_name := str(st.get("step"))
		var recommended := step_name == str(rec.get("step"))
		var sc2 := float(step_scores.get(step_name, 0.5))
		var lab := str(st.get("label"))
		if recommended:
			lab = "★ " + lab
		lab = "%s · top %s · score %.2f" % [lab, str(top.get("domain", "?")), sc2]
		var leaf2 := str(st.get("leaf"))
		var row := {
			"index": i, "step": step_name, "action_id": str(st.get("action_id")),
			"leaf_action": leaf2, "label": lab, "score": sc2,
			"enabled": domain_count > 0 or step_name == "scan",
			"recommended": recommended, "province_id": province_id, "domain": str(top.get("domain", "")),
		}
		day_rows.append(row)
		apply_queue.append({
			"action_id": leaf2, "province_id": province_id, "score": sc2,
			"enabled": bool(row.get("enabled")), "label": lab, "step": step_name,
			"product_action": str(st.get("action_id")), "domain": str(top.get("domain", "")),
		})
	for d2 in domains.slice(0, mini(3, domains.size())):
		if d2 is Dictionary:
			apply_queue.append({
				"action_id": str(d2.get("leaf", "apply_station")), "province_id": province_id,
				"score": float(d2.get("score", 0.5)), "enabled": true,
				"label": "Domain %s · %.2f" % [str(d2.get("domain")), float(d2.get("score", 0))],
				"step": "execute", "product_action": "theater_domain_%s" % str(d2.get("domain")),
				"domain": str(d2.get("domain")),
			})
	var strip_lines: Array = []
	for d3 in domains:
		if d3 is Dictionary:
			var r3: Dictionary = d3.get("recommendation", {})
			strip_lines.append("%s · %.2f · %s" % [
				str(d3.get("domain")), float(d3.get("score", 0)),
				str(r3.get("step", r3.get("summary", ""))).substr(0, 40),
			])
	var actions: Array = [
		{"action_id": "theater_command_product", "label": "Run theater command product", "enabled": true},
		{"action_id": str(rec.get("action_id", "theater_command_scan")), "label": "Recommended: %s" % str(rec.get("step", "scan")), "enabled": true},
	]
	for row4 in day_rows:
		actions.append({"action_id": str(row4.get("action_id")), "label": str(row4.get("label")), "enabled": bool(row4.get("enabled")), "step": str(row4.get("step"))})
	var label := "Theater command product · domains %d · top %s · score %.2f" % [
		domain_count, str(top.get("domain", "—")), score
	]
	var plain_lines: PackedStringArray = [label, str(rec.get("summary", ""))]
	for ln in strip_lines:
		plain_lines.append(str(ln))
	for row5 in day_rows:
		plain_lines.append(str(row5.get("label", "")))
	return {
		"domains": domains, "domain_count": domain_count, "top_domain": str(top.get("domain", "")),
		"top_score": top_score, "strip_lines": strip_lines,
		"combat": combat, "fleet": fleet, "industry": industry, "hh": hh, "agent": agent,
		"recommendation": rec, "day_rows": day_rows, "apply_queue": apply_queue, "actions": actions,
		"score": score, "theater_score": score, "province_id": province_id, "apply_ready": domain_count > 0,
		"summary": label, "plain": "\n".join(plain_lines),
		"bbcode": "%s🎖 Theater command[/color] %s— %s[/color]" % [COLOR_HEADER, COLOR_MUTED, label],
		"empty": domain_count <= 0,
		"integration": ["theater_command_product", "theater_command_scan", "theater_command_rank", "theater_command_execute", "major_8"],
	}

static func execute_theater_command_step(step: String = "scan", province_id: int = 1) -> Dictionary:
	var s := step.strip_edges().to_lower()
	if s.begins_with("theater_command_"):
		s = s.replace("theater_command_", "")
	if s not in ["scan", "rank", "execute"]:
		s = "scan"
	var product: Dictionary = theater_command_product(province_id)
	var row: Dictionary = {}
	for r in product.get("day_rows", []):
		if r is Dictionary and str(r.get("step")) == s:
			row = r
			break
	var leaf := str(row.get("leaf_action", "apply_station"))
	var action_id := "theater_command_scan"
	match s:
		"rank":
			action_id = "theater_command_rank"
		"execute":
			action_id = "theater_command_execute"
	var score := float(row.get("score", product.get("score", 0.5)))
	var apply_queue: Array = [{
		"action_id": leaf, "province_id": province_id, "score": score, "enabled": true,
		"label": str(row.get("label", s)), "step": s, "product_action": action_id,
	}]
	var label := "Execute theater %s · leaf %s · score %.2f · #%d" % [s, leaf, score, province_id]
	return {
		"step": s, "leaf_action": leaf, "action_id": action_id, "apply_queue": apply_queue,
		"score": score, "province_id": province_id, "summary": label, "plain": label,
		"bbcode": "%s🎖 Theater %s[/color] %s— %s[/color]" % [COLOR_HEADER, s, COLOR_MUTED, label],
		"empty": false, "ok": true,
		"integration": ["execute_theater_command_step", s, leaf],
	}

## ---------------------------------------------------------------------------
## Multi-faction strategic AI product (major #9) — first deferred strategic AI slice
## Per-major doctrine weights × theater domains → urgency board → execute top.
## ---------------------------------------------------------------------------

const STRATEGIC_AI_MAJORS := ["GER", "FRA", "ENG", "USA", "SOV", "ITA", "JAP"]

static func faction_ai_doctrine(tag: String) -> Dictionary:
	var t := tag.strip_edges().to_upper()
	match t:
		"GER":
			return {"combat": 1.15, "industry": 1.1, "fleet": 0.85, "agent": 0.95, "hh": 0.9}
		"SOV":
			return {"combat": 1.12, "industry": 1.08, "fleet": 0.75, "agent": 1.0, "hh": 0.95}
		"USA":
			return {"combat": 1.0, "industry": 1.15, "fleet": 1.12, "agent": 0.9, "hh": 0.85}
		"ENG":
			return {"combat": 0.95, "industry": 1.0, "fleet": 1.18, "agent": 0.95, "hh": 1.0}
		"FRA":
			return {"combat": 1.05, "industry": 0.95, "fleet": 0.9, "agent": 0.9, "hh": 0.95}
		"ITA":
			return {"combat": 1.0, "industry": 0.9, "fleet": 1.05, "agent": 0.95, "hh": 1.05}
		"JAP":
			return {"combat": 1.05, "industry": 1.0, "fleet": 1.15, "agent": 1.05, "hh": 0.9}
		_:
			return {"combat": 1.0, "fleet": 1.0, "industry": 1.0, "hh": 1.0, "agent": 1.0}

static func recommend_strategic_ai_step(faction_count: int, top_urgency: float = 0.5) -> Dictionary:
	var step := "execute_top"
	var reason := "execute highest-urgency faction action"
	if faction_count <= 0:
		step = "scan_factions"
		reason = "no factions — scan majors"
	elif top_urgency < 0.45:
		step = "rank_priorities"
		reason = "low urgency — re-rank faction priorities"
	var action_id := "strategic_ai_scan"
	var leaf := "apply_focus"
	match step:
		"rank_priorities":
			action_id = "strategic_ai_rank"
			leaf = "apply_station"
		"execute_top":
			action_id = "strategic_ai_execute"
			leaf = "apply_assault"
	return {
		"step": step, "action_id": action_id, "leaf": leaf, "reason": reason, "empty": false,
		"summary": "Recommend %s · %s" % [step, reason],
	}

static func plan_faction_ai(tag: String, province_id: int = 1, fuel_level: float = 0.65, tank_progress: float = 0.15, factories: int = 14) -> Dictionary:
	var t := tag.strip_edges().to_upper()
	if t.is_empty():
		t = "GER"
	var th: Dictionary = theater_command_product(province_id, fuel_level, tank_progress, factories)
	var doctrine: Dictionary = faction_ai_doctrine(t)
	var ranked: Array = []
	for d in th.get("domains", []):
		if not (d is Dictionary):
			continue
		var dom := str(d.get("domain", "combat"))
		var raw := clampf(float(d.get("score", 0.5)), 0.0, 1.0)
		var w := float(doctrine.get(dom, 1.0))
		var sc := clampf(raw * w, 0.0, 1.0)
		if sc < 0.35:
			sc = 0.35
		ranked.append({
			"domain": dom, "score": sc, "raw_score": raw, "weight": w,
			"leaf": str(d.get("leaf", "apply_station")),
			"summary": str(d.get("summary", "")).substr(0, 80),
		})
	ranked.sort_custom(func(a, b): return float(a.get("score", 0)) > float(b.get("score", 0)))
	var top: Dictionary = ranked[0] if not ranked.is_empty() else {"domain": "combat", "score": 0.5, "leaf": "apply_assault"}
	var urgency := clampf(0.55 * float(top.get("score", 0.5)) + 0.25 * float(th.get("score", 0.55)) + 0.2 * minf(1.0, float(ranked.size()) / 5.0), 0.0, 1.0)
	if urgency < 0.35:
		urgency = 0.35
	var label := "AI %s · top %s · urgency %.2f · domains %d" % [t, str(top.get("domain")), urgency, ranked.size()]
	return {
		"tag": t, "top_domain": str(top.get("domain")), "top_leaf": str(top.get("leaf")),
		"top_score": float(top.get("score")), "urgency": urgency, "domains": ranked,
		"theater_score": float(th.get("score", 0.55)), "summary": label, "plain": label, "empty": false,
	}

static func multi_faction_strategic_ai_product(
	tags: Array = [],
	province_id: int = 1,
	max_factions: int = 7,
) -> Dictionary:
	var use_tags: Array = tags if not tags.is_empty() else STRATEGIC_AI_MAJORS.duplicate()
	if use_tags.size() > max_factions:
		use_tags = use_tags.slice(0, max_factions)
	var factions: Array = []
	for i in range(use_tags.size()):
		var tag := str(use_tags[i]).to_upper()
		var fuel := 0.55 + float(i) * 0.03
		var prog := 0.12 + float(i) * 0.02
		var fac := 12 + i
		factions.append(plan_faction_ai(tag, province_id + i, fuel, prog, fac))
	factions.sort_custom(func(a, b): return float(a.get("urgency", 0)) > float(b.get("urgency", 0)))
	var top: Dictionary = factions[0] if not factions.is_empty() else {"tag": "GER", "top_domain": "combat", "top_leaf": "apply_assault", "urgency": 0.45}
	var top_urgency := float(top.get("urgency", 0.45))
	var faction_count := factions.size()
	var mean_u := 0.0
	for f in factions:
		mean_u += float(f.get("urgency", 0.5))
	if faction_count > 0:
		mean_u /= float(faction_count)
	var score := clampf(0.4 * top_urgency + 0.3 * minf(1.0, float(faction_count) / 7.0) + 0.3 * mean_u, 0.0, 1.0)
	if score < 0.35 and faction_count > 0:
		score = 0.35
	var rec: Dictionary = recommend_strategic_ai_step(faction_count, top_urgency)
	var step_scores := {
		"scan_factions": clampf(0.4 + 0.08 * float(mini(7, faction_count)), 0.35, 1.0),
		"rank_priorities": clampf(0.45 + 0.25 * top_urgency, 0.35, 1.0),
		"execute_top": clampf(0.5 + 0.3 * top_urgency, 0.35, 1.0),
	}
	var steps: Array = [
		{"step": "scan_factions", "action_id": "strategic_ai_scan", "leaf": "apply_focus", "label": "Step 0 — scan major factions"},
		{"step": "rank_priorities", "action_id": "strategic_ai_rank", "leaf": "apply_station", "label": "Step 1 — rank multi-faction priorities"},
		{"step": "execute_top", "action_id": "strategic_ai_execute", "leaf": str(top.get("top_leaf", "apply_assault")), "label": "Step 2 — execute top faction AI action"},
	]
	var day_rows: Array = []
	var apply_queue: Array = []
	for i in range(steps.size()):
		var st: Dictionary = steps[i]
		var step_name := str(st.get("step"))
		var recommended := step_name == str(rec.get("step"))
		var sc := float(step_scores.get(step_name, 0.5))
		var lab := str(st.get("label"))
		if recommended:
			lab = "★ " + lab
		lab = "%s · top %s/%s · score %.2f" % [lab, str(top.get("tag", "?")), str(top.get("top_domain", "?")), sc]
		var leaf2 := str(st.get("leaf"))
		var row := {
			"index": i, "step": step_name, "action_id": str(st.get("action_id")),
			"leaf_action": leaf2, "label": lab, "score": sc,
			"enabled": faction_count > 0 or step_name == "scan_factions",
			"recommended": recommended, "province_id": province_id, "faction": str(top.get("tag", "")),
		}
		day_rows.append(row)
		apply_queue.append({
			"action_id": leaf2, "province_id": province_id, "score": sc,
			"enabled": bool(row.get("enabled")), "label": lab, "step": step_name,
			"product_action": str(st.get("action_id")), "faction": str(top.get("tag", "")),
		})
	for f2 in factions.slice(0, mini(3, factions.size())):
		if f2 is Dictionary:
			apply_queue.append({
				"action_id": str(f2.get("top_leaf", "apply_station")), "province_id": province_id,
				"score": float(f2.get("urgency", 0.5)), "enabled": true,
				"label": "AI %s · %s" % [str(f2.get("tag")), str(f2.get("top_domain"))],
				"step": "execute_top", "product_action": "strategic_ai_faction_%s" % str(f2.get("tag")),
				"faction": str(f2.get("tag")),
			})
	var board_lines: Array = []
	for f3 in factions:
		if f3 is Dictionary:
			board_lines.append("%s · %s · urg %.2f" % [str(f3.get("tag")), str(f3.get("top_domain")), float(f3.get("urgency", 0))])
	var actions: Array = [
		{"action_id": "multi_faction_strategic_ai_product", "label": "Run multi-faction strategic AI product", "enabled": true},
		{"action_id": str(rec.get("action_id", "strategic_ai_scan")), "label": "Recommended: %s" % str(rec.get("step", "scan_factions")), "enabled": true},
	]
	for row4 in day_rows:
		actions.append({"action_id": str(row4.get("action_id")), "label": str(row4.get("label")), "enabled": bool(row4.get("enabled")), "step": str(row4.get("step"))})
	var label := "Multi-faction strategic AI · majors %d · top %s/%s · urg %.2f · score %.2f" % [
		faction_count, str(top.get("tag", "—")), str(top.get("top_domain", "—")), top_urgency, score
	]
	var plain_lines: PackedStringArray = [label, str(rec.get("summary", ""))]
	for ln in board_lines:
		plain_lines.append(str(ln))
	for row5 in day_rows:
		plain_lines.append(str(row5.get("label", "")))
	return {
		"factions": factions, "faction_count": faction_count, "tags": use_tags,
		"top_faction": str(top.get("tag", "")), "top_domain": str(top.get("top_domain", "")),
		"top_leaf": str(top.get("top_leaf", "")), "top_urgency": top_urgency, "board_lines": board_lines,
		"recommendation": rec, "day_rows": day_rows, "apply_queue": apply_queue, "actions": actions,
		"score": score, "ai_score": score, "province_id": province_id, "apply_ready": faction_count > 0,
		"summary": label, "plain": "\n".join(plain_lines),
		"bbcode": "%s♟ Multi-faction strategic AI[/color] %s— %s[/color]" % [COLOR_HEADER, COLOR_MUTED, label],
		"empty": faction_count <= 0,
		"integration": ["multi_faction_strategic_ai_product", "strategic_ai_scan", "strategic_ai_rank", "strategic_ai_execute", "major_9", "strategic_ai"],
	}

static func execute_strategic_ai_step(step: String = "scan_factions", province_id: int = 1, tags: Array = []) -> Dictionary:
	var s := step.strip_edges().to_lower()
	if s.begins_with("strategic_ai_"):
		s = s.replace("strategic_ai_", "")
		if s == "scan":
			s = "scan_factions"
		elif s == "rank":
			s = "rank_priorities"
		elif s == "execute":
			s = "execute_top"
	if s not in ["scan_factions", "rank_priorities", "execute_top"]:
		s = "scan_factions"
	var product: Dictionary = multi_faction_strategic_ai_product(tags, province_id)
	var row: Dictionary = {}
	for r in product.get("day_rows", []):
		if r is Dictionary and str(r.get("step")) == s:
			row = r
			break
	var leaf := str(row.get("leaf_action", "apply_focus"))
	var action_id := "strategic_ai_scan"
	match s:
		"rank_priorities":
			action_id = "strategic_ai_rank"
		"execute_top":
			action_id = "strategic_ai_execute"
	var score := float(row.get("score", product.get("score", 0.5)))
	var apply_queue: Array = [{
		"action_id": leaf, "province_id": province_id, "score": score, "enabled": true,
		"label": str(row.get("label", s)), "step": s, "product_action": action_id,
		"faction": str(product.get("top_faction", "")),
	}]
	var label := "Execute strategic AI %s · leaf %s · faction %s · score %.2f" % [
		s, leaf, str(product.get("top_faction", "?")), score
	]
	return {
		"step": s, "leaf_action": leaf, "action_id": action_id, "apply_queue": apply_queue,
		"score": score, "province_id": province_id, "faction": str(product.get("top_faction", "")),
		"summary": label, "plain": label,
		"bbcode": "%s♟ AI %s[/color] %s— %s[/color]" % [COLOR_HEADER, s, COLOR_MUTED, label],
		"empty": false, "ok": true,
		"integration": ["execute_strategic_ai_step", s, leaf],
	}

