static func execute_weather_crisis_step(step: String = "forecast", province_id: int = 1) -> Dictionary:
	var s := step.strip_edges().to_lower().replace("weather_crisis_", "").replace("weather_", "")
	if s.begins_with("forecast") or s.begins_with("pressure"): s = "forecast"
	elif s.begins_with("gate") or s.begins_with("multi"): s = "gate_multi"
	elif s.begins_with("crisis") or s.begins_with("sustain") or s.begins_with("response"): s = "crisis_sustain"
	else: s = "forecast"
	var product: Dictionary = weather_crisis_campaign_product(province_id)
	var leaf := "apply_station"
	var action_id := "weather_crisis_forecast"
	var score := float(product.get("score", 0.5))
	match s:
