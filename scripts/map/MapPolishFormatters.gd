static func industry_economy_day(
	temp: float = 10.0,
	precip: float = 0.0,
	ground_state: String = "dry",
	visibility: float = 1.0,
	wind: float = 0.2,
	base_output: float = 1.0,
	sea_mult: float = 1.0,
	province_id: int = 1,
) -> Dictionary:
	var oob: Dictionary = oob_factory_risk_loop(temp, precip, ground_state, visibility, wind, base_output)
	var mult := float(oob.get("effective_output", oob.get("mult", 1.0)))
	var risk := clampf(1.0 - mult, 0.0, 1.0)
