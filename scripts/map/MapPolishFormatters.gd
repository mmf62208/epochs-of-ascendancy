	if winner_n < 2:
		winners = ["GER", "ITA"]
	elif winner_n > 3:
		winners = ["GER", "ITA", "HUN", "ROM"]
	var bilat: Dictionary = peace_conference_settlement_product(province_id, "GER", loser_tag, 0.7)
	var cohesion := 0.62
	var board_score := clampf(0.45 * float(bilat.get("score", 0.65)) + 0.55 * cohesion, 0.35, 1.0)
	var feasibility := clampf(0.4 + 0.45 * cohesion + 0.05 * float(winners.size()), 0.35, 1.0)
	var ai_accept := clampf(0.35 + 0.5 * feasibility, 0.35, 1.0)
	var goals_score := clampf(0.4 * feasibility + 0.35 * ai_accept + 0.25 * board_score, 0.35, 1.0)
	var settle_score := clampf(0.5 * goals_score + 0.5 * board_score, 0.35, 1.0)
	var score := clampf(0.3 * board_score + 0.35 * goals_score + 0.35 * settle_score, 0.35, 1.0)
