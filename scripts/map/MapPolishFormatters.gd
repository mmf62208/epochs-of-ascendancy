static func recommend_war_economy_step(board_score: float = 0.5, allocate_score: float = 0.5, ready: bool = false) -> Dictionary:
	var step := "allocate"
	var reason := "refresh allocation"
	if board_score < 0.45:
		step = "board"
		reason = "economy board thin — re-scan factories/trade"
	elif allocate_score < 0.45:
		step = "allocate"
		reason = "priority lines under-allocated"
	elif ready:
		step = "sustain"
		reason = "board ready — sustain war economy"
	var action_id := "war_economy_board"
	var leaf := "apply_production"
	match step:
		"allocate":
			action_id = "war_economy_allocate"
			leaf = "apply_production"
		"sustain":
			action_id = "war_economy_sustain"
			leaf = "apply_focus"
	return {"step": step, "action_id": action_id, "leaf": leaf, "reason": reason, "empty": false, "summary": "Recommend %s · %s" % [step, reason]}

static func war_economy_mobilization_product(province_id: int = 1) -> Dictionary:
	var economy: Dictionary = war_economy_day_package(10.0, 0.3, "mud", 0.7, 0.3)
	var surge: Dictionary = industry_surge_day(10.0, 0.3, "mud", 0.7, 0.3, 1.0, 100.0, 1.0, "primary", province_id)
	var trade: Dictionary = trade_chain_day(1.0, province_id)
	var oob: Dictionary = medium_tank_oob_product(province_id)
	var board_score := clampf(0.5 * float(economy.get("score", 0.5)) + 0.5 * float(trade.get("score", 0.5)), 0.0, 1.0)
	if board_score < 0.35: board_score = 0.35
	var allocate_score := clampf(0.55 * float(surge.get("score", 0.5)) + 0.45 * float(oob.get("score", 0.5)), 0.0, 1.0)
	if allocate_score < 0.35: allocate_score = 0.35
	var sustain_score := clampf(0.45 * board_score + 0.55 * allocate_score, 0.0, 1.0)
	if sustain_score < 0.35: sustain_score = 0.35
	var score := clampf(0.35 * board_score + 0.35 * allocate_score + 0.3 * sustain_score, 0.0, 1.0)
	if score < 0.35: score = 0.35
	var rec: Dictionary = recommend_war_economy_step(board_score, allocate_score, board_score >= 0.45 and allocate_score >= 0.45)
	var steps: Array = [
		{"step": "board", "action_id": "war_economy_board", "leaf": "apply_production", "label": "Step 0 — war economy board", "score": board_score},
		{"step": "allocate", "action_id": "war_economy_allocate", "leaf": "apply_production", "label": "Step 1 — allocate production priority", "score": allocate_score},
		{"step": "sustain", "action_id": "war_economy_sustain", "leaf": "apply_focus", "label": "Step 2 — sustain war economy", "score": sustain_score},
	]
	var day_rows: Array = []
	var apply_queue: Array = []
	for i in range(steps.size()):
		var st: Dictionary = steps[i]
		var step_name := str(st.get("step"))
		var recommended: bool = step_name == str(rec.get("step"))
		var sc := float(st.get("score", 0.5))
		var leaf := str(st.get("leaf"))
		var lab := str(st.get("label"))
		if recommended: lab = "★ " + lab
		lab = "%s · score %.2f" % [lab, sc]
		day_rows.append({"index": i, "step": step_name, "action_id": str(st.get("action_id")), "leaf_action": leaf, "label": lab, "score": sc, "enabled": true, "recommended": recommended, "province_id": province_id})
		apply_queue.append({"action_id": leaf, "province_id": province_id, "score": sc, "enabled": true, "label": lab, "step": step_name, "product_action": str(st.get("action_id"))})
	var actions: Array = [
		{"action_id": "war_economy_mobilization_product", "label": "Run war economy mobilization product", "enabled": true},
		{"action_id": str(rec.get("action_id", "war_economy_board")), "label": "Recommended: %s" % str(rec.get("step", "board")), "enabled": true},
	]
	for row2 in day_rows:
		actions.append({"action_id": str(row2.get("action_id")), "label": str(row2.get("label")), "enabled": true, "step": str(row2.get("step"))})
	var label := "War economy mobilization · board %.2f · allocate %.2f · sustain %.2f · score %.2f" % [board_score, allocate_score, sustain_score, score]
	return {
		"economy": economy, "surge": surge, "trade": trade, "oob": oob,
		"board_score": board_score, "allocate_score": allocate_score, "sustain_score": sustain_score,
		"recommendation": rec, "day_rows": day_rows, "apply_queue": apply_queue, "actions": actions,
		"score": score, "economy_score": score, "province_id": province_id,
		"summary": label, "plain": label,
		"bbcode": "%s⚙ War economy[/color] %s— %s[/color]" % [COLOR_HEADER, COLOR_MUTED, label],
		"empty": false,
		"integration": ["war_economy_mobilization_product", "war_economy_board", "war_economy_allocate", "war_economy_sustain", "major_21", "economy", "industry"],
	}

