		summary_bits.append(region)
	if not sea.is_empty():
		summary_bits.append("⚓ " + sea)
	var bb_bits: PackedStringArray = [
		"%s%s[/color]" % [COLOR_HEADER, pname],
		"%s%s[/color]" % [COLOR_MUTED, owner_disp],
	]
	if not region.is_empty():
		bb_bits.append("%s%s[/color]" % [COLOR_TECH, region])
	if not sea.is_empty():
		bb_bits.append("%s⚓ %s[/color]" % [COLOR_TECH, sea])
	return {
		"title": pname,
		"owner": owner_disp,
		"owner_line": "Owner: %s" % owner_disp,
		"region": region,
		"region_line": ("Region: %s" % region) if not region.is_empty() else "",
		"sea_zone": sea,
		"sea_zone_line": ("Sea zone: %s" % sea) if not sea.is_empty() else "",
		"plain_summary": " · ".join(summary_bits),
		"bbcode": " · ".join(bb_bits),
		"has_region": not region.is_empty(),
		"has_sea_zone": not sea.is_empty(),
	}


