## Naval campaign skim (inspector/panel one-liner).
static func naval_campaign_skim(
	basing_level: String = "port",
	fuel_level: float = 0.65,
	zone_relation: String = "contested",
	is_choke: bool = false,
	sea_trade_mult: float = 1.0,
	province_id: int = 1,
) -> Dictionary:
	var basing := basing_level.strip_edges().to_lower()
	if basing.is_empty():
		basing = "none"
	var fuel := clampf(fuel_level, 0.05, 1.2)
	var zone := zone_relation.strip_edges().to_lower()
	if zone.is_empty():
		zone = "no_zone"
	var sea := clampf(sea_trade_mult, 0.2, 1.5)
	var choke_tag := "choke" if is_choke else "open"
	var urgency := 0.25
	if fuel < 0.45:
		urgency += 0.25
	if zone in ["hostile", "contested"]:
		urgency += 0.2
	if is_choke:
		urgency += 0.15
	if basing in ["none", "anchorage"] and fuel < 0.6:
		urgency += 0.1
	urgency = minf(1.0, urgency)
	var score := maxf(0.05, 1.0 - urgency * 0.55 + (sea - 1.0) * 0.2)
	var label := "Naval skim · #%d · %s · fuel %.0f%% · zone %s · %s · sea×%.2f" % [
		province_id, basing, fuel * 100.0, zone, choke_tag, sea
	]
	return {
		"province_id": province_id,
		"basing_level": basing,
		"fuel_level": fuel,
		"zone_relation": zone,
		"is_choke": is_choke,
		"sea_trade_mult": sea,
		"urgency": urgency,
		"score": score,
		"summary": label,
		"plain": label,
		"bbcode": "%s⚓ Naval skim[/color] %s— %s[/color]" % [COLOR_TECH, COLOR_MUTED, label],
		"empty": false,
		"integration": ["basing", "fuel", "zone", "choke"],
	}


## HH agenda one-click player path (commit + counterplay).
static func hh_agenda_player_path(trail: Array = [], province_id: int = 1, max_actions: int = 3) -> Dictionary:
	if trail.is_empty():
		return {"empty": true, "plain": "", "bbcode": "", "summary": "", "score": 0.0, "apply_queue": [], "actions": []}
	var last: Dictionary = trail[trail.size() - 1] if trail[trail.size() - 1] is Dictionary else {}
	var influence := float(last.get("influence", last.get("score", 0.4)))
	var action_class := str(last.get("class", last.get("action_class", "sabotage")))
	var score := clampf(influence if influence <= 1.5 else influence / 100.0, 0.15, 1.0)
	var apply_queue: Array = [
		{"action_id": "apply_hh_commit", "province_id": -1, "score": maxf(0.35, score), "enabled": true, "label": "Commit HH agenda"},
		{"action_id": "apply_counterplay", "province_id": province_id, "score": maxf(0.3, score * 0.9), "enabled": true, "label": "Counter-intel", "action_class": action_class},
	]
	if score >= 0.45:
		apply_queue.append({
			"action_id": "apply_agent_dispatch", "province_id": province_id, "score": score, "enabled": true,
			"label": "Dispatch agents", "action_class": action_class,
		})
	if apply_queue.size() > max_actions:
		apply_queue = apply_queue.slice(0, max_actions)
	var label := "HH player path · trail %d · class %s · score %.2f · q %d" % [trail.size(), action_class, score, apply_queue.size()]
	return {
		"trail_count": trail.size(),
		"action_class": action_class,
		"score": score,
		"apply_queue": apply_queue,
		"actions": [{"action_id": "hh_player_path", "label": "Run HH player path", "enabled": true}],
		"summary": label,
		"plain": label,
		"bbcode": "%s🕵 HH player path[/color] %s— %s[/color]" % [COLOR_HEADER, COLOR_MUTED, label],
		"empty": false,
		"integration": ["hh_commit", "counterplay", "dispatch"],
	}


## Medium-horizon equip honesty plan (≤60d second line class).
static func medium_horizon_equip_plan(
	infantry_stock: float = 5.0,
	tank_stock: float = 0.0,
	tank_line_progress: float = 0.15,
	days_horizon: int = 60,
	factories: int = 14,
) -> Dictionary:
	var days := maxi(1, days_horizon)
	var fac := maxi(0, factories)
	var tanks := maxf(0.0, tank_stock)
	var progress := clampf(tank_line_progress, 0.0, 1.0)
	var rate := 0.012 * maxf(1.0, float(fac) / 4.0)
	var projected := progress + rate * float(days)
	var will_complete := projected >= 1.0
	var seed_needed := (not will_complete) and tanks < 1.0
	var seed_design := ""
	if seed_needed:
		seed_design = "light_tank_line_seed" if fac >= 10 else "infantry_k98_bolt_action"
	var score := 0.55 if will_complete else (0.35 if seed_needed else 0.4)
	var label := "Medium-horizon equip · %dd · tanks stock %.0f · progress %.0f%% → %.0f%% · %s" % [
		days, tanks, progress * 100.0, minf(100.0, projected * 100.0),
		"complete" if will_complete else ("seed second line" if seed_needed else "partial"),
	]
	var apply_queue: Array = []
	if seed_needed:
		apply_queue.append({
			"action_id": "apply_production", "province_id": -1, "score": 0.5, "enabled": true,
			"priority": "secondary", "design_hint": seed_design,
		})
	return {
		"days_horizon": days,
		"infantry_stock": maxf(0.0, infantry_stock),
		"tank_stock": tanks,
		"tank_line_progress": progress,
		"projected_progress": minf(1.5, projected),
		"will_complete_tank": will_complete,
		"seed_needed": seed_needed,
		"seed_design": seed_design,
		"factories": fac,
		"score": score,
		"apply_queue": apply_queue,
		"actions": [{"action_id": "medium_horizon_equip", "label": "Review medium-horizon equip", "enabled": true}],
		"summary": label,
		"plain": label,
		"bbcode": "%s🏭 Medium-horizon equip[/color] %s— %s[/color]" % [COLOR_WARN, COLOR_MUTED, label],
		"empty": false,
		"integration": ["production", "oob", "stockpile"],
	}


