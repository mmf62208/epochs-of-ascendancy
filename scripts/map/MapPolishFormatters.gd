## Strategic continuity day compose.
static func strategic_continuity_day(
	visibility: float = 1.0,
	precip: float = 0.0,
	temp: float = 10.0,
	ground_state: String = "dry",
	wind: float = 0.2,
	month: int = 6,
	trail: Array = [],
	max_executes: int = 3,
	focus_id: String = "industrial_effort",
	province_id: int = 1,
	before_score: float = 0.5,
) -> Dictionary:
	var orders: Dictionary = order_execute_day(visibility, precip, temp, ground_state, wind, month, trail, max_executes, province_id)
	var focus: Dictionary = focus_war_path_day(visibility, precip, ground_state, focus_id, 55.0, trail, province_id)
	var o_score := 0.0 if bool(orders.get("empty", false)) else float(orders.get("score", 0.0))
	var f_score := float(focus.get("score", 0.0))
	var after: float = o_score * 0.55 + f_score * 0.45 if not bool(orders.get("empty", false)) else f_score
	var feedback: Dictionary = next_day_feedback(before_score, after, "strategic_continuity")
	var apply_queue: Array = []
	for block in [orders, focus]:
		if not (block is Dictionary) or bool(block.get("empty", false)):
			continue
		for q in block.get("apply_queue", []):
			if q is Dictionary and bool(q.get("enabled", true)):
				apply_queue.append(q)
	var seen: Dictionary = {}
	var deduped: Array = []
	for q in apply_queue:
		if not (q is Dictionary):
			continue
		var key := "%s:%d:%s" % [str(q.get("action_id", "")), int(q.get("province_id", -1)), str(q.get("focus_id", ""))]
		if seen.has(key):
			continue
		seen[key] = true
		deduped.append(q)
	if deduped.size() > 8:
		deduped = deduped.slice(0, 8)
	var fb_score := float(feedback.get("after", after))
	var score: float = (o_score + f_score + fb_score) / 3.0
	var ready_n := 0
	for q in deduped:
		if bool(q.get("enabled", true)):
			ready_n += 1
	var label := "Strategic continuity day · orders %.2f · focus %.2f · feedback %s · q %d" % [
		o_score, f_score, str(feedback.get("trend", "steady")), ready_n
	]
	return {
		"orders": orders,
		"focus": focus,
		"feedback": feedback,
		"apply_queue": deduped,
		"score": score,
		"actions": [{"action_id": "strategic_continuity_day", "label": "Run strategic continuity day", "enabled": ready_n > 0}],
		"summary": label,
		"plain": label,
		"bbcode": "%s⟳ Strategic continuity[/color] %s— %s[/color]" % [COLOR_HEADER, COLOR_MUTED, label],
		"empty": false,
	}


## Force posture day package.
static func force_posture_day(
	force_strength: float = 80.0,
	supply_health: float = 0.85,
	visibility: float = 1.0,
	precip: float = 0.0,
	ground_state: String = "dry",
	wind: float = 0.2,
	province_id: int = 1,
) -> Dictionary:
	var board: Dictionary = force_posture_board(force_strength, supply_health, visibility, precip, ground_state, wind)
	var score := float(board.get("score", board.get("posture", 0.5)))
	if score > 2.0:
		score = clampf(score / 100.0, 0.0, 1.0)
	var supply_h := clampf(supply_health, 0.05, 1.2)
	var strain := maxf(0.0, 1.0 - supply_h)
	var apply_ready := force_strength >= 20.0
	var apply_queue: Array = []
	if apply_ready and score >= 0.35:
		apply_queue.append({
			"action_id": "apply_assault",
			"province_id": province_id,
			"score": score,
			"enabled": score >= 0.4 and supply_h >= 0.4,
		})
	if strain >= 0.25 or supply_h < 0.7:
		apply_queue.append({
			"action_id": "apply_supply",
			"province_id": province_id,
			"score": maxf(0.35, strain),
			"enabled": true,
		})
	apply_queue.append({
		"action_id": "apply_station",
		"province_id": province_id,
		"score": minf(1.0, 0.3 + score * 0.5),
		"enabled": true,
	})
	var label := "Force posture day · force %.0f · supply %.0f%% · score %.2f" % [
		force_strength, supply_h * 100.0, score
	]
	return {
		"board": board,
		"force_strength": force_strength,
		"supply_health": supply_h,
		"score": score,
		"apply_ready": apply_ready,
		"apply_queue": apply_queue,
		"actions": [{"action_id": "force_posture_day", "label": "Run force posture day", "enabled": apply_ready}],
		"summary": label,
		"plain": label,
		"bbcode": "%s🛡 Force posture day[/color] %s— %s[/color]" % [COLOR_HEADER, COLOR_MUTED, label],
		"empty": false,
	}


## Theater readiness day package.
static func theater_readiness_day(
	visibility: float = 1.0,
	precip: float = 0.0,
	wind: float = 0.2,
	month: int = 6,
	available_fleet: float = 80.0,
	attacker_power: float = 100.0,
	province_id: int = 1,
) -> Dictionary:
	var fleet: Dictionary = fleet_weather_mission_package("patrol", available_fleet, "contested", 0.0, visibility, precip)
	var targets: Array = [{"province_id": province_id, "defender_power": 70.0}]
	var assault: Dictionary = assault_readiness_compose(targets, attacker_power, 0.85, visibility, precip, "dry", wind)
	var day_risk: Dictionary = campaign_day_risk(visibility, precip, "dry", wind, month)
	var summaries: Array = []
	for block in [fleet, assault, day_risk]:
		if block is Dictionary and not bool(block.get("empty", false)):
			var s := str(block.get("summary", block.get("plain", ""))).strip_edges()
			if not s.is_empty():
				summaries.append(s.split("\n")[0])
	if summaries.is_empty():
		return {"empty": true, "plain": "", "bbcode": "", "summary": "", "score": 0.0, "apply_queue": [], "actions": []}
	var board: Dictionary = theater_readiness_board(summaries)
	var f_s := float(fleet.get("score", fleet.get("spot_mult", 0.55)))
	if f_s > 2.0:
		f_s = clampf(f_s / 100.0, 0.0, 1.0)
	var a_s := 0.5
	if assault.has("score"):
		a_s = float(assault.get("score", 0.5))
	elif assault.has("best") and assault.get("best") is Dictionary:
		a_s = float((assault.get("best") as Dictionary).get("overall", 0.5))
	elif assault.has("ranked") and assault.get("ranked") is Dictionary:
		var ranked_a: Dictionary = assault.get("ranked")
		var best_a = ranked_a.get("best", {})
		if best_a is Dictionary:
			a_s = float((best_a as Dictionary).get("overall", 0.5))
	if a_s > 2.0:
		a_s = clampf(a_s / 100.0, 0.0, 1.0)
	var risk := clampf(float(day_risk.get("risk", 0.3)), 0.0, 1.0)
	var r_s := 1.0 - risk
	var score: float = (f_s + a_s + r_s) / 3.0
	var apply_queue: Array = []
	if a_s >= 0.4 and risk < 0.65:
		apply_queue.append({"action_id": "apply_assault", "province_id": province_id, "score": a_s, "enabled": true})
	if f_s >= 0.35:
		apply_queue.append({"action_id": "fleet_autonomy", "province_id": province_id, "score": f_s, "enabled": true})
	if risk >= 0.45:
		apply_queue.append({"action_id": "apply_supply", "province_id": province_id, "score": risk, "enabled": true})
	if apply_queue.is_empty():
		apply_queue.append({"action_id": "apply_station", "province_id": province_id, "score": 0.4, "enabled": true})
	var label := "Theater readiness day · fleet %.2f · assault %.2f · risk %.0f%%" % [f_s, a_s, risk * 100.0]
	return {
		"board": board,
		"fleet": fleet,
		"assault": assault,
		"day_risk": day_risk,
		"score": score,
		"risk": risk,
		"apply_ready": risk < 0.85,
		"apply_queue": apply_queue,
		"actions": [{"action_id": "theater_readiness_day", "label": "Run theater readiness day", "enabled": true}],
		"summary": label,
		"plain": label,
		"bbcode": "%s── Theater readiness day ──[/color] %s— %s[/color]" % [COLOR_HEADER, COLOR_MUTED, label],
		"empty": false,
	}


## Force readiness day compose.
static func force_readiness_day(
	force_strength: float = 80.0,
	supply_health: float = 0.85,
	visibility: float = 1.0,
	precip: float = 0.0,
	ground_state: String = "dry",
