## Agent mission priority pilot (mirrors agent_mission_priority.rank_agent_missions).
static func rank_agent_missions(
	hh_action_class: String = "",
	threat: float = 0.5,
	network_strength: float = 0.3,
	loyalty: float = 0.5,
	max_missions: int = 4,
) -> Dictionary:
	var missions := ["counterintel", "sabotage_defense", "propaganda", "network_expand", "assassination_watch", "economic_shield"]
	var ac := hh_action_class.strip_edges().to_lower()
	var th := clampf(threat, 0.0, 1.0)
	var net := clampf(network_strength, 0.0, 1.0)
	var loy := clampf(loyalty, 0.0, 1.0)
	var scored: Array = []
	for m in missions:
		var base := 45.0
		match m:
			"counterintel":
				base = 55.0
			"sabotage_defense":
				base = 50.0
			"propaganda":
				base = 48.0
			"network_expand":
				base = 45.0
			"assassination_watch":
				base = 40.0
			"economic_shield":
				base = 47.0
		if ac == "sabotage" and m in ["sabotage_defense", "counterintel"]:
			base += 30.0
		elif ac == "infiltration" and m in ["counterintel", "propaganda", "assassination_watch"]:
			base += 28.0
		elif ac == "economic_pressure" and m in ["economic_shield", "network_expand"]:
			base += 26.0
		base += th * 25.0
		if m == "network_expand":
			base += (1.0 - net) * 20.0
		if m == "propaganda":
			base += (1.0 - loy) * 22.0
		scored.append({"mission": m, "score": base})
	scored.sort_custom(func(a, b): return float(a["score"]) > float(b["score"]))
	var top: Array = []
	for i in range(mini(scored.size(), maxi(1, max_missions))):
		top.append(scored[i])
	var best: Dictionary = top[0] if top.size() > 0 else {}
	return {
		"best_mission": str(best.get("mission", "")),
		"best_score": float(best.get("score", 0.0)),
		"missions": top,
		"count": top.size(),
		"empty": top.is_empty(),
		"summary": "Agent priority: %s" % str(best.get("mission", "none")),
	}


## Weather combat/supply/move multipliers (mirrors weather_effects.py).
static func weather_combat_multiplier(visibility: float = 1.0, precip_intensity: float = 0.0, wind: float = 0.2) -> float:
	var mult := visibility * (1.0 - precip_intensity * 0.55) * (1.0 - maxf(0.0, wind - 0.4) * 0.2)
	return clampf(mult, 0.2, 1.1)


static func weather_supply_multiplier(ground_state: String = "dry", precip_intensity: float = 0.0) -> float:
	var g := ground_state.strip_edges().to_lower()
	var mult := 1.0
	if g == "mud":
		mult *= 0.7
	elif g in ["snow_covered", "ice", "frozen"]:
		mult *= 0.85
	mult *= 1.0 - precip_intensity * 0.25
	return clampf(mult, 0.35, 1.15)


static func weather_move_multiplier(ground_state: String = "dry", visibility: float = 1.0, armored: bool = false) -> float:
	var g := ground_state.strip_edges().to_lower()
	var base := 1.0
	match g:
		"mud":
			base = 0.45 if armored else 0.75
		"frozen", "snow_covered":
			base = 0.85
			if armored:
				base *= 1.15
		"ice":
			base = 0.8
		"wet":
			base = 0.9
		_:
			base = 1.0
	if visibility < 0.3:
		base *= 0.6
	return clampf(base, 0.15, 1.5)


static func weather_production_multiplier(temp: float = 10.0, precip_intensity: float = 0.0) -> float:
	var mult := 1.0
	if temp < -15.0:
		mult *= 0.85
	elif temp > 38.0:
		mult *= 0.9
	mult *= 1.0 - precip_intensity * 0.15
	return clampf(mult, 0.5, 1.1)


static func format_weather_chip_bbcode(
	temp: float = 10.0,
	ground_state: String = "dry",
	visibility: float = 1.0,
	precip_intensity: float = 0.0,
	season: String = "",
) -> String:
	var combat := weather_combat_multiplier(visibility, precip_intensity)
	var supply := weather_supply_multiplier(ground_state, precip_intensity)
	var label := "Temp %.0f°C · %s · vis %.0f%%" % [temp, ground_state, visibility * 100.0]
	if not season.is_empty():
		label = "%s · %s" % [season, label]
	return "%s🌤 Weather[/color] %s— %s · combat ×%.2f · supply ×%.2f[/color]" % [COLOR_TECH, COLOR_MUTED, label, combat, supply]


static func format_weather_legend_bbcode() -> String:
	return "\n".join(PackedStringArray([
		"%s── Weather legend ──[/color]" % COLOR_HEADER,
		"%s· dry · normal move/supply[/color]" % COLOR_MUTED,
		"%s· mud · heavy move penalty (armor worse)[/color]" % COLOR_MUTED,
		"%s· snow/frozen · mild move hit; winter wear[/color]" % COLOR_MUTED,
		"%s· storm/low vis · air/naval/spotting down; interdiction up[/color]" % COLOR_MUTED,
	]))


static func season_label(month: int) -> String:
	var m := month
	if m in [12, 1, 2]:
		return "winter"
	if m in [3, 4, 5]:
		return "spring"
	if m in [6, 7, 8]:
		return "summer"
	return "autumn"


## Fleet redeploy posture pilot (beyond tasking/escort).
static func rank_fleet_postures(
	basing_level: String = "none",
	fuel_level: float = 1.0,
	zone_relation: String = "no_zone",
	escort_need: float = 0.0,
	can_service: bool = false,
) -> Dictionary:
	var postures := ["HOLD_BASE", "PATROL_SCREEN", "CONVOY_COVER", "POWER_PROJECTION", "REFUEL_RETURN"]
	var ranked: Array = []
	var fuel := clampf(fuel_level, 0.1, 1.2)
	var rel := zone_relation.strip_edges().to_lower()
	var rank := 0
	match basing_level:
		"anchorage":
			rank = 1
		"port":
			rank = 2
		"major_base":
			rank = 3
		_:
			rank = 0
	for p in postures:
		var base := 50.0
		match p:
			"HOLD_BASE":
				base = 40.0
			"PATROL_SCREEN":
				base = 50.0
			"CONVOY_COVER":
				base = 48.0
			"POWER_PROJECTION":
				base = 55.0
			"REFUEL_RETURN":
				base = 35.0
		if fuel < 0.4:
			if p == "REFUEL_RETURN":
				base += 40.0
			if p == "POWER_PROJECTION":
				base -= 30.0
		if can_service and p == "HOLD_BASE":
			base += 12.0 + float(rank * 5)
		if escort_need >= 25.0 and p == "CONVOY_COVER":
			base += 28.0 + minf(20.0, escort_need * 0.05)
		if rel == "hostile" and p == "POWER_PROJECTION":
			base += 22.0
		if rel == "contested" and p in ["PATROL_SCREEN", "CONVOY_COVER"]:
			base += 16.0
		if rel == "friendly" and p == "PATROL_SCREEN":
			base += 10.0
		if rank >= 3 and p == "POWER_PROJECTION":
			base += 15.0
		if rank == 0 and p == "POWER_PROJECTION":
			base -= 20.0
		base *= 0.85 + 0.15 * fuel
		ranked.append({"posture": p, "score": base})
	ranked.sort_custom(func(a, b): return float(a["score"]) > float(b["score"]))
	var best: Dictionary = ranked[0] if ranked.size() > 0 else {}
	return {
		"best_posture": str(best.get("posture", "")),
		"best_score": float(best.get("score", 0.0)),
		"ranked": ranked,
		"summary": "Fleet posture %s (score %.1f)" % [best.get("posture", "?"), float(best.get("score", 0.0))],
		"empty": ranked.is_empty(),
	}


## Multi-province theater fleet posture plan (beyond single-province rank).
static func plan_fleet_theater_posture(province_inputs: Array) -> Dictionary:
	var rows: Array = []
	var scores: Dictionary = {}
	var refuel := 0
	var projection := 0
	for raw in province_inputs:
		if typeof(raw) != TYPE_DICTIONARY:
			continue
		var d: Dictionary = raw
		var pid := int(d.get("province_id", d.get("id", -1)))
		if pid < 0:
			continue
		var fuel := float(d.get("fuel_level", 0.85))
		var ranked: Dictionary = rank_fleet_postures(
			str(d.get("basing_level", "none")),
			fuel,
			str(d.get("zone_relation", "no_zone")),
			float(d.get("escort_need", 0.0)),
			bool(d.get("can_service", false)),
		)
		var posture := str(ranked.get("best_posture", ""))
		var sc := float(ranked.get("best_score", 0.0))
		rows.append({
			"province_id": pid,
			"best_posture": posture,
			"best_score": sc,
			"fuel_level": fuel,
			"summary": str(ranked.get("summary", "")),
		})
		scores[posture] = float(scores.get(posture, 0.0)) + sc
		if posture == "REFUEL_RETURN":
			refuel += 1
		if posture == "POWER_PROJECTION":
			projection += 1
	if rows.is_empty():
		return {
			"provinces": [],
			"dominant_posture": "",
			"refuel_count": 0,
			"projection_count": 0,
			"count": 0,
			"empty": true,
			"summary": "",
		}
	var dominant := ""
	var best_s := -1.0
	for k in scores.keys():
		var sv := float(scores[k])
		if sv > best_s:
			best_s = sv
			dominant = str(k)
	rows.sort_custom(func(a, b): return float(a["best_score"]) > float(b["best_score"]))
	var top: Array = []
	for i in range(mini(3, rows.size())):
		top.append(rows[i])
	var summary := "Theater posture %s · %d ports · refuel %d · project %d" % [
		dominant, rows.size(), refuel, projection
	]
	return {
		"provinces": rows,
		"dominant_posture": dominant,
		"refuel_count": refuel,
		"projection_count": projection,
		"count": rows.size(),
		"empty": false,
		"summary": summary,
		"top": top,
	}


