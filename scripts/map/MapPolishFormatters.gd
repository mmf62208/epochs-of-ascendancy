static func occupation_resistance_compliance_product(province_id: int = 1, resistance_level: float = 0.55, compliance_level: float = 0.40, policy: String = "moderate") -> Dictionary:
	var control: Dictionary = occupation_control_product(province_id)
	var pol := policy.strip_edges().to_lower()
	if pol not in ["harsh", "moderate", "lenient"]:
		pol = "moderate"
	var r := clampf(resistance_level, 0.0, 1.0)
	var c := clampf(compliance_level, 0.0, 1.0)
	var r_delta := -0.05
	var c_delta := 0.04
	var revolt := 0.07
	var fac := 0.90
	if pol == "harsh":
		r_delta = -0.08
		c_delta = -0.05
		revolt = 0.12
		fac = 0.85
	elif pol == "lenient":
		r_delta = -0.03
		c_delta = 0.08
		revolt = 0.04
		fac = 0.95
	r = clampf(r + r_delta, 0.0, 1.0)
	c = clampf(c + c_delta, 0.0, 1.0)
	var stability := clampf(0.55 * c + 0.45 * (1.0 - r), 0.0, 1.0)
	var revolt_risk := clampf(revolt + 0.4 * r - 0.25 * c, 0.0, 1.0)
	var board_score := clampf(0.55 * stability + 0.45 * float(control.get("score", 0.5)), 0.0, 1.0)
	if board_score < 0.35: board_score = 0.35
	var policy_score := clampf(0.5 + 0.3 * c - 0.2 * revolt_risk, 0.0, 1.0)
	if policy_score < 0.35: policy_score = 0.35
	var tick_score := clampf(0.45 * board_score + 0.55 * policy_score, 0.0, 1.0)
	if tick_score < 0.35: tick_score = 0.35
