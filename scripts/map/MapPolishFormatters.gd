## Sea-zone control × weather supply combine.
static func sea_weather_supply_combined(sea_mult: float = 1.0, weather_mult: float = 1.0) -> Dictionary:
	var sea := clampf(sea_mult, 0.15, 1.5)
	var wx := clampf(weather_mult, 0.12, 1.4)
