	var day_rows: Array = [
		{"step": "board", "action_id": "multi_party_peace_board", "leaf": "apply_focus", "label": "Step 0 — multi-party conference board", "score": board_score},
		{"step": "wargoals", "action_id": "multi_party_peace_wargoals", "leaf": "apply_production", "label": "Step 1 — assign war-goal packages", "score": goals_score},
		{"step": "settle", "action_id": "multi_party_peace_settle", "leaf": "apply_assault", "label": "Step 2 — multi-party settle map", "score": settle_score},
	]
	var apply_queue: Array = []
	for row in day_rows:
		apply_queue.append({"action_id": str(row.get("leaf")), "province_id": province_id, "score": float(row.get("score", 0.5)), "enabled": true, "label": str(row.get("label")), "step": str(row.get("step")), "product_action": str(row.get("action_id"))})
	var label := "Multi-party peace · winners %d · packages %d · AI accept %.0f%% · score %.2f" % [winners.size(), winners.size(), ai_accept * 100.0, score]
	return {
		"recommendation": rec, "day_rows": day_rows, "apply_queue": apply_queue,
		"actions": [{"action_id": "multi_party_peace_conference_product", "label": "Run multi-party peace conference product", "enabled": true}, {"action_id": "multi_party_peace_settle", "label": "Recommended: settle", "enabled": true}],
		"winners": winners, "loser_tag": loser_tag.strip_edges().to_upper(), "winner_n": winners.size(), "package_n": winners.size(),
		"ai_accept": ai_accept, "feasibility": feasibility, "score": score, "peace_score": score, "province_id": province_id,
		"summary": label, "plain": label, "bbcode": "[color=#e0c06a]🕊 Multi-party peace[/color] [color=#8899aa]%s[/color]" % label,
		"empty": false, "integration": ["multi_party_peace_conference_product", "multi_party_peace_board", "multi_party_peace_wargoals", "multi_party_peace_settle", "major_37", "phase4_depth"],
	}

