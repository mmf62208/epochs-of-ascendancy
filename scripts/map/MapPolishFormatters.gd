static func command_journal_primary_command_product(province_id: int = 1, seed: int = 1936) -> Dictionary:
	var pid := maxi(1, province_id)
	var actions: PackedStringArray = ["apply_production", "apply_station", "apply_production"]
	var parts: PackedStringArray = ["s%d" % seed]
	for a in actions:
		parts.append("%s|%d" % [a, pid])
	var fp := str("|".join(parts).hash())
	var score := 0.72
	var label := "Command journal primary · majors 5/5 · dead 0 · cmds 3 · seed %d · fp %s · verify OK · score %.2f · PASS" % [seed, fp, score]
	return {
		"score": score, "plain": label, "summary": label, "empty": false, "province_id": pid, "seed": seed,
		"majors_ok": {
			"journal_primary_seed": true, "journal_primary_enqueue": true,
			"journal_primary_flush_replay": true, "journal_primary_verify": true, "journal_primary_close": true,
		},
		"majors_ok_n": 5, "all_majors_ok": true, "dead_n": 0, "fingerprint": fp, "verify_ok": true,
		"no_focus_batch": true, "journal_n": 3, "actions": actions,
		"live_api_by_step": {
			"journal_seed": "apply_command_journal_seed_live",
			"journal_enqueue": "apply_command_journal_enqueue_live",
			"journal_flush_replay": "apply_command_journal_flush_live",
			"journal_verify": "apply_command_journal_verify_live",
			"journal_close": "apply_command_journal_close_live",
		},
		"integration": ["command_journal_primary_command_product", "N2"],
	}



