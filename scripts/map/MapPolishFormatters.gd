static func war_economy_close_day(province_id: int = 1) -> Dictionary:
	var prod: Dictionary = production_priority_mutation(6.0, 0.35, "mud", 0.68, 0.2)
	var supply: Dictionary = supply_route_mutation("port", 1.0, "mud", 0.35, 0.68, "main", province_id)
	var focus: Dictionary = focus_weather_aware_score(50.0, "industrial_effort", 0.68, 0.35, "mud")
	var gate: Dictionary = execution_integrity_gate()
	var ok := bool(gate.get("ok", false))
	var fraw := float(focus.get("score", 50.0))
	var fscore := clampf(fraw / 100.0 if fraw > 2.0 else fraw, 0.0, 1.0)
	var score := clampf(
		0.3 * float(prod.get("score", 0.5))
		+ 0.3 * float(supply.get("score", 0.5))
		+ 0.2 * fscore
		+ 0.2 * (0.8 if ok else 0.3),
		0.0, 1.0
	)
	var apply_queue: Array = [
		{"action_id": "apply_production", "province_id": province_id, "score": float(prod.get("score", score)), "enabled": true, "label": "War economy close prod"},
		{"action_id": "apply_supply", "province_id": province_id, "score": float(supply.get("score", score)), "enabled": true, "label": "War economy close supply"},
		{"action_id": "apply_focus", "province_id": province_id, "score": fscore, "enabled": true, "label": "War economy close focus"},
	]
	var label := "War economy close · prod · supply · focus · gate %s · score %.2f" % ["PASS" if ok else "FAIL", score]
	return {
		"production": prod, "supply": supply, "focus": focus, "gate": gate, "ok": ok, "score": score, "apply_queue": apply_queue,
		"actions": [{"action_id": "war_economy_close_day", "label": "Run war economy close day", "enabled": true}],
