## --- Campaign execution (beyond campaign-cohesion) ---

static func fleet_order_execute(
	basing_level: String = "port",
	fuel_level: float = 0.55,
	available_strength: float = 100.0,
	zone_relation: String = "contested",
	visibility: float = 1.0,
	precip: float = 0.0,
	province_id: int = -1,
) -> Dictionary:
	var plan: Dictionary = fleet_campaign_plan(
		basing_level, fuel_level, available_strength, zone_relation, visibility, precip, 6, 1.0
	)
	var score := float(plan.get("score", 0.5))
	var role := "PATROL"
	if score >= 0.55 and fuel_level >= 0.45:
		role = "STRIKE" if zone_relation in ["hostile", "contested"] else "ESCORT"
	elif score < 0.35 or fuel_level < 0.35:
		role = "REFUEL" if basing_level in ["port", "major_base", "anchorage"] else "HOLD"
	var order := "DEPLOY FLEET %s L%s strength=%.0f @#%d" % [
		role, basing_level.to_upper(), available_strength, province_id
	]
	var label := "Fleet order · %s · score %.2f" % [role, score]
	return {
		"order": order,
		"role": role,
		"score": score,
		"summary": label,
		"plain": "%s\n%s" % [order, label],
		"bbcode": "%s⚓ Fleet order[/color] %s— %s[/color]" % [COLOR_HEADER, COLOR_MUTED, order],
		"empty": false,
		"province_id": province_id,
		"integration": ["fleet_campaign", "execute"],
	}


