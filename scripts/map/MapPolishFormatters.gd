	var day_rows: Array = [
		{"step": "catalog", "action_id": "designer_domain_live_catalog", "leaf": "apply_focus", "label": "Step 0 — multi-domain catalog", "score": catalog_score},
		{"step": "pick", "action_id": "designer_domain_live_pick", "leaf": "apply_production", "label": "Step 1 — pick domain design", "score": pick_score},
