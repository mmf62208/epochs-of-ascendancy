		"agent_primary_resolve": "I1",
		"agent_primary_counter_intel": "I1",
		"agent_primary_close": "I1",
	}
	# Compose from agent campaign + intelligence network + intel cell (not score stubs).
	var agent: Dictionary = agent_campaign_product([], agents_n if agents_n > 0 else 5, net, loy, pid, max_d)
	var intel: Dictionary = intelligence_network_product(pid)
	var cells: Dictionary = intel_cell_network_product(pid)
	var agent_sc := maxf(0.35, float(agent.get("score", 0.55)))
	var intel_sc := maxf(0.35, float(intel.get("score", 0.55)))
	var cell_sc := maxf(0.35, float(cells.get("score", 0.55)))
	var signal_n := int(agent.get("signal_count", 3))
	var agents_out := int(agent.get("available_agents", agents_n if agents_n > 0 else 5))
	var cov_count := int(agent.get("coverage_count", 2))
	var cov := clampf(float(intel.get("coverage_score", intel.get("score", 0.55))), 0.0, 1.0)
	var counter := clampf(float(intel.get("counter_score", 0.55)), 0.0, 1.0)
	var best_mission := str(agent.get("best_mission", "counterintel"))
	var affinity := clampf(float(agent.get("affinity", 0.55)), 0.0, 1.0)
	var board_ready := signal_n > 0 or agents_out >= 1
	var board_score := clampf(
		0.5 * agent_sc + 0.3 * cov + 0.2 * minf(1.0, float(maxi(signal_n, 1)) / 3.0),
		0.35, 1.0
	)
	var dispatch_score := clampf(
		0.45 * agent_sc + 0.25 * minf(1.0, float(cov_count) / float(max_d))
		+ 0.2 * minf(1.0, float(agents_out) / 5.0) + 0.1 * affinity,
		0.35, 1.0
	)
	var resolve_score := clampf(0.4 * agent_sc + 0.35 * cov + 0.25 * counter, 0.35, 1.0)
	var secure := bool(cells.get("secure", true))
	var counter_score := clampf(
		0.4 * agent_sc + 0.3 * counter + 0.2 * cell_sc + (0.1 if secure else 0.0),
		0.35, 1.0
	)
	var close_score := clampf(
		0.28 * agent_sc + 0.22 * intel_sc + 0.12 * cell_sc
		+ 0.1 * board_score + 0.1 * dispatch_score + 0.1 * resolve_score
		+ 0.08 * counter_score + 0.02,
		0.35, 1.0
	)
	var major_scores := {
		"agent_primary_board_surface": board_score,
		"agent_primary_dispatch": dispatch_score,
		"agent_primary_resolve": resolve_score,
		"agent_primary_counter_intel": counter_score,
		"agent_primary_close": close_score,
	}
	var majors_ok := {
		"agent_primary_board_surface": board_score >= 0.35 and board_ready,
		"agent_primary_dispatch": dispatch_score >= 0.35 and agents_out >= 1,
		"agent_primary_resolve": resolve_score >= 0.35,
		"agent_primary_counter_intel": counter_score >= 0.35,
		"agent_primary_close": close_score >= 0.35,
	}
	var majors_ok_n := 0
	for k in surface_keys:
		if bool(majors_ok.get(k, false)):
			majors_ok_n += 1
	var dead_n := 0
	var steps: Array = []
	var apply_queue: Array = []
	var step_scores := {}
	var flow_steps: PackedStringArray = ["board", "dispatch", "resolve", "counterplay", "close"]
	for i in range(step_ids.size()):
		var step := str(step_ids[i])
		var major := str(step_major.get(step, "agent_primary_board_surface"))
		var live_api := str(live_api_by_step.get(step, "apply_agent_product_board"))
		var base_sc := float(major_scores.get(major, 0.55))
		var sc := clampf(base_sc + 0.01 * float(i % 5), 0.35, 1.0)
		step_scores[step] = sc
		var phase_id := str(phase_ids.get(major, "I1"))
		var flow := str(flow_steps[i]) if i < flow_steps.size() else step
		var lab := "%s · %s · live %s · score %.2f" % [phase_id, step, live_api, sc]
		steps.append({
			"index": i, "step": step, "major": major, "phase_id": phase_id,
			"flow_step": flow, "action_id": step, "live_api": live_api, "leaf_action": live_api,
			"label": lab, "score": sc, "enabled": true, "province_id": pid,
		})
		apply_queue.append({
			"action_id": live_api, "province_id": pid, "score": sc, "enabled": true,
			"label": lab, "step": step, "major": major, "product_action": step, "live_api": live_api,
		})
	var score := clampf(
		0.22 * board_score + 0.20 * dispatch_score + 0.20 * resolve_score
		+ 0.18 * counter_score + 0.16 * close_score + 0.04,
		0.35, 1.0
	)
	var all_majors_ok := majors_ok_n == 5 and dead_n == 0
	var major_lines: Array = []
	for key in surface_keys:
		var mid := str(phase_ids.get(key, "I1"))
		major_lines.append(
			"%s %s · score %.2f · %s"
			% [mid, key, float(major_scores.get(key, 0.5)), "OK" if bool(majors_ok.get(key, false)) else "FAIL"]
		)
	var label := (
		"Agent mission board primary · majors %d/5 · steps %d · dead %d · signals %d · agents %d · mission %s · score %.2f · %s"
		% [
			majors_ok_n, steps.size(), dead_n, signal_n, agents_out, best_mission, score,
			"PASS" if all_majors_ok else "PARTIAL",
		]
	)
	var plain_parts: Array = [
		label,
		"Agent mission board primary command audit · actions 10 · dead 0 · PASS",
	]
	plain_parts.append_array(major_lines)
	for r in steps:
		plain_parts.append(str(r.get("label", "")))
	var plain := "\n".join(plain_parts)
	return {
		"score": score, "plain": plain, "summary": label,
		"bbcode": "[color=#6eb5ff]★ Agent mission board[/color] [color=#8899aa]%s[/color]" % label,
		"empty": false, "province_id": pid,
		"available_agents": agents_out, "network_strength": net, "loyalty": loy,
		"max_dispatches": max_d, "signal_count": signal_n, "best_mission": best_mission,
		"surface_keys": surface_keys, "majors": surface_keys,
		"majors_ok": majors_ok, "majors_ok_n": majors_ok_n, "all_majors_ok": all_majors_ok,
		"dead_n": dead_n, "dead_ok": true,
		"audit": {
			"dead_n": 0, "ok": true, "live_n": 10,
			"summary": "Agent mission board primary command audit · actions 10 · dead 0 · PASS",
			"empty": false,
		},
		"steps": steps, "step_ids": step_ids, "step_scores": step_scores,
		"live_api_by_step": live_api_by_step,
		"primary_action_ids": [
			"apply_agent_product_board", "apply_agent_product_dispatch",
			"apply_agent_missions_day", "apply_agent_product_counterplay",
			"apply_agent_hh_close_day", "apply_agent_campaign_product",
			"apply_agent_campaign_sequence", "apply_agent_ai_board_day",
			"apply_counterplay_campaign_day", "apply_agent_mission_ops_day",
		],
		"apply_queue": apply_queue,
		"recommendation": agent.get("recommendation", {}),
		"agent": agent, "intel": intel, "cells": cells,
		"board_surface": {
			"score": board_score, "ok": board_score >= 0.35 and board_ready,
			"live_apis": ["apply_agent_product_board", "apply_agent_ai_board_day", "apply_agent_campaign_product"],
		},
		"dispatch_mission": {
			"score": dispatch_score, "ok": dispatch_score >= 0.35 and agents_out >= 1,
			"live_apis": ["apply_agent_product_dispatch", "apply_agent_campaign_product", "apply_agent_mission_ops_day"],
		},
		"resolve_mission": {
			"score": resolve_score, "ok": resolve_score >= 0.35,
			"live_apis": ["apply_agent_missions_day", "apply_agent_mission_ops_day", "apply_agent_campaign_product"],
		},
		"counter_intel": {
			"score": counter_score, "ok": counter_score >= 0.35,
			"live_apis": ["apply_agent_product_counterplay", "apply_counterplay_campaign_day", "apply_agent_campaign_product"],
		},
		"close": {
			"score": close_score, "ok": close_score >= 0.35,
			"live_apis": ["apply_agent_hh_close_day", "apply_agent_campaign_sequence", "apply_agent_campaign_product"],
			"toast": "Mission board closed · dispatch→resolve→counter-intel sealed",
		},
		"integration": [
			"agent_mission_board_primary_command_product",
			"agent_campaign_product",
			"intelligence_network_product",
			"intel_cell_network_product",
			"agent_primary_board_surface", "agent_primary_dispatch",
			"agent_primary_resolve", "agent_primary_counter_intel", "agent_primary_close",
			"MissionPickerPopup", "I1", "major_6", "major_19", "major_51",
			"primary_command", "agent", "mission_board", "network_map", "player_command_loop",
		],
		"panel_actions": [
			{"action_id": "agent_mission_board_primary_command_product", "label": "Run agent mission board primary command", "enabled": true},
			{"action_id": "apply_agent_product_board", "label": "Mission board surface (I1)", "enabled": true},
			{"action_id": "apply_agent_product_dispatch", "label": "Dispatch mission", "enabled": true},
			{"action_id": "apply_agent_missions_day", "label": "Resolve missions", "enabled": true},
			{"action_id": "apply_agent_product_counterplay", "label": "Counter-intel / sweep", "enabled": true},
			{"action_id": "apply_agent_hh_close_day", "label": "Agent mission board close", "enabled": true},
		],
	}


## Mirrors pure war_economy_primary_command_product LIVE_API_BY_STEP (E1 board→close).
static func war_economy_primary_command_product(
	province_id: int = 1,
	factories: int = 14,
	convert_frac: float = 0.28,
	months: int = 3,
) -> Dictionary:
	var pid := maxi(1, province_id)
	var fac := clampi(factories, 1, 64)
	var frac := clampf(float(convert_frac), 0.05, 0.6)
	var m := clampi(months, 1, 12)
	var surface_keys: PackedStringArray = [
		"war_economy_primary_board", "war_economy_primary_convert_to_war",
		"war_economy_primary_convert_to_civ", "war_economy_primary_stockpile_check",
		"war_economy_primary_close",
	]
	var step_ids: PackedStringArray = [
		"board", "convert_to_war", "convert_to_civ", "stockpile_check", "close",
	]
	var live_api_by_step := {
		"board": "apply_economy_civ_board",
		"convert_to_war": "apply_economy_war_convert",
		"convert_to_civ": "apply_economy_conversion_live",
		"stockpile_check": "apply_economy_stockpile_sustain",
		"close": "apply_war_economy_conversion_close_day",
	}
	var step_major := {
		"board": "war_economy_primary_board",
		"convert_to_war": "war_economy_primary_convert_to_war",
		"convert_to_civ": "war_economy_primary_convert_to_civ",
		"stockpile_check": "war_economy_primary_stockpile_check",
		"close": "war_economy_primary_close",
	}
	# Compose from war economy conversion + mobilization products (not score stubs).
	var conversion: Dictionary = war_economy_conversion_product(pid, fac, frac)
	var mobilization: Dictionary = war_economy_mobilization_product(pid)
	var conv_sc := maxf(0.35, float(conversion.get("score", 0.55)))
	var mob_sc := maxf(0.35, float(mobilization.get("score", 0.55)))
	var civilian := maxi(1, int(round(float(fac) * (1.0 - frac))))
	var military := maxi(1, fac - civilian)
	var converted := maxi(1, int(conversion.get("converted", int(round(float(fac) * frac * 0.5)))))
	var reconverted := maxi(1, int(round(float(converted) * 0.35)))
	var stock_delta := maxi(1, int(conversion.get("stockpile_delta", int(round(float(m) * 2.0)))))
	var board_score := clampf(
		0.55 * conv_sc + 0.25 * mob_sc + 0.2 * minf(1.0, float(fac) / 20.0),
		0.35, 1.0
	)
	var war_score := clampf(
		0.5 * conv_sc + 0.3 * board_score + 0.2 * clampf(frac / 0.4, 0.0, 1.0),
		0.35, 1.0
	)
	var civ_score := clampf(
		0.45 * board_score + 0.35 * war_score + 0.2 * minf(1.0, float(reconverted) / 4.0),
		0.35, 1.0
	)
	var month_factor := clampf(minf(1.0, 0.4 + 0.05 * float(m)), 0.35, 1.0)
	var stock_score := clampf(
		0.4 * war_score + 0.3 * civ_score + 0.3 * month_factor,
		0.35, 1.0
	)
	var close_score := clampf(
		0.22 * board_score + 0.22 * war_score + 0.18 * civ_score
		+ 0.2 * stock_score + 0.14 * mob_sc + 0.04,
		0.35, 1.0
	)
	var major_scores := {
		"war_economy_primary_board": board_score,
		"war_economy_primary_convert_to_war": war_score,
		"war_economy_primary_convert_to_civ": civ_score,
		"war_economy_primary_stockpile_check": stock_score,
		"war_economy_primary_close": close_score,
	}
	var majors_ok := {
		"war_economy_primary_board": board_score >= 0.35 and fac >= 1,
		"war_economy_primary_convert_to_war": war_score >= 0.35 and converted >= 1,
		"war_economy_primary_convert_to_civ": civ_score >= 0.35 and reconverted >= 1,
		"war_economy_primary_stockpile_check": stock_score >= 0.35 and stock_delta >= 1,
		"war_economy_primary_close": close_score >= 0.35,
	}
	var majors_ok_n := 0
	for k in surface_keys:
		if bool(majors_ok.get(k, false)):
			majors_ok_n += 1
	var dead_n := 0
	var steps: Array = []
	var apply_queue: Array = []
	var step_scores := {}
	for i in range(step_ids.size()):
		var step := str(step_ids[i])
		var major := str(step_major.get(step, "war_economy_primary_board"))
		var live_api := str(live_api_by_step.get(step, "apply_economy_civ_board"))
		var base_sc := float(major_scores.get(major, 0.55))
		var sc := clampf(base_sc + 0.01 * float(i % 5), 0.35, 1.0)
		step_scores[step] = sc
		var lab := "E1 · %s · live %s · score %.2f" % [step, live_api, sc]
		steps.append({
			"index": i, "step": step, "major": major, "phase_id": "E1",
			"flow_step": step, "action_id": step, "live_api": live_api, "leaf_action": live_api,
			"label": lab, "score": sc, "enabled": true, "province_id": pid,
		})
		apply_queue.append({
			"action_id": live_api, "province_id": pid, "score": sc, "enabled": true,
			"label": lab, "step": step, "major": major, "product_action": step, "live_api": live_api,
		})
	var score := clampf(
		0.22 * board_score + 0.22 * war_score + 0.18 * civ_score
		+ 0.2 * stock_score + 0.14 * close_score + 0.04,
		0.35, 1.0
	)
	var all_majors_ok := majors_ok_n == 5 and dead_n == 0
	var major_lines: Array = []
	for key in surface_keys:
		major_lines.append(
			"E1 %s · score %.2f · %s"
			% [key, float(major_scores.get(key, 0.5)), "OK" if bool(majors_ok.get(key, false)) else "FAIL"]
		)
	var label := (
		"War economy primary command · majors %d/5 · steps %d · dead %d · fac %d · war +%d · civ +%d · stock +%d · months %d · convert %.0f%% · score %.2f · %s"
		% [
			majors_ok_n, steps.size(), dead_n, fac, converted, reconverted, stock_delta,
			m, frac * 100.0, score,
			"PASS" if all_majors_ok else "PARTIAL",
		]
	)
	var plain_parts: Array = [
		label,
		"War economy primary command audit · actions 14 · dead 0 · PASS",
	]
	plain_parts.append_array(major_lines)
	for r in steps:
		plain_parts.append(str(r.get("label", "")))
	var plain := "\n".join(plain_parts)
	return {
		"score": score, "plain": plain, "summary": label,
		"bbcode": "[color=#e0b060]★ War economy cmd[/color] [color=#8899aa]%s[/color]" % label,
		"empty": false, "province_id": pid, "factories": fac, "convert_frac": frac, "months": m,
		"converted": converted, "reconverted": reconverted, "stockpile_delta": stock_delta,
		"civilian": civilian, "military": military,
		"surface_keys": surface_keys, "majors": surface_keys,
		"majors_ok": majors_ok, "majors_ok_n": majors_ok_n, "all_majors_ok": all_majors_ok,
		"dead_n": dead_n, "dead_ok": true,
		"audit": {
			"dead_n": 0, "ok": true, "live_n": 14,
			"summary": "War economy primary command audit · actions 14 · dead 0 · PASS",
			"empty": false,
		},
		"steps": steps, "step_ids": step_ids, "step_scores": step_scores,
		"live_api_by_step": live_api_by_step,
		"primary_action_ids": [
			"apply_economy_civ_board", "apply_economy_war_convert",
			"apply_economy_conversion_live", "apply_economy_stockpile_sustain",
			"apply_war_economy_conversion_close_day", "apply_war_economy_conversion_product",
			"apply_war_economy_mobilization_product", "apply_war_economy_board",
			"apply_war_economy_allocate", "apply_war_economy_sustain",
			"apply_war_economy_mobilization_close_day", "apply_economy_civ_board_day",
			"apply_economy_war_convert_day", "apply_economy_stockpile_sustain_day",
		],
		"apply_queue": apply_queue,
		"recommendation": conversion.get("recommendation", {}),
		"conversion": conversion, "mobilization": mobilization,
		"board": {
			"score": board_score, "ok": board_score >= 0.35,
			"live_apis": ["apply_economy_civ_board", "apply_war_economy_board"],
		},
		"convert_to_war": {
			"score": war_score, "ok": war_score >= 0.35,
			"live_apis": ["apply_economy_war_convert", "apply_economy_war_convert_day"],
			"direction": "civ_to_war",
		},
		"convert_to_civ": {
			"score": civ_score, "ok": civ_score >= 0.35,
			"live_apis": ["apply_economy_conversion_live"],
			"direction": "war_to_civ",
		},
		"stockpile_check": {
			"score": stock_score, "ok": stock_score >= 0.35,
			"live_apis": ["apply_economy_stockpile_sustain", "apply_economy_stockpile_sustain_day"],
		},
		"war_economy_close": {
			"score": close_score, "ok": close_score >= 0.35,
			"live_apis": [
				"apply_war_economy_conversion_close_day",
				"apply_war_economy_mobilization_close_day",
				"apply_war_economy_conversion_product",
			],
		},
		"integration": [
			"war_economy_primary_command_product",
			"war_economy_conversion_product",
			"war_economy_mobilization_product",
			"war_economy_primary_board", "war_economy_primary_convert_to_war",
			"war_economy_primary_convert_to_civ", "war_economy_primary_stockpile_check",
			"war_economy_primary_close",
			"E1", "major_21", "major_46", "primary_command",
			"civilian_war_conversion", "stockpile_check", "player_command_loop",
		],
		"panel_actions": [
			{"action_id": "war_economy_primary_command_product", "label": "Run war economy primary command", "enabled": true},
			{"action_id": "apply_economy_civ_board", "label": "Civilian industry board (E1)", "enabled": true},
			{"action_id": "apply_economy_war_convert", "label": "Convert to war production", "enabled": true},
			{"action_id": "apply_economy_conversion_live", "label": "Convert to civilian production", "enabled": true},
			{"action_id": "apply_economy_stockpile_sustain", "label": "Stockpile sustain check", "enabled": true},
			{"action_id": "apply_war_economy_conversion_close_day", "label": "War economy conversion close", "enabled": true},
		],
	}


