## Naval multi-phase campaign product (major #15) — posture → escort → strike
## ---------------------------------------------------------------------------

static func recommend_naval_phase_step(posture_score: float = 0.5, escort_ok: bool = true, strike_ready: bool = false) -> Dictionary:
	var step := "escort"
	var reason := "secure escort then strike"
	if posture_score < 0.4:
		step = "posture"
		reason = "posture weak — re-task fleet"
	elif not escort_ok:
		step = "escort"
		reason = "escort insufficient — reinforce"
	elif strike_ready:
		step = "strike"
		reason = "strike window open"
	var action_id := "naval_phase_posture"
	var leaf := "apply_station"
	match step:
		"escort":
			action_id = "naval_phase_escort"
			leaf = "apply_station"
		"strike":
			action_id = "naval_phase_strike"
			leaf = "apply_assault"
	return {"step": step, "action_id": action_id, "leaf": leaf, "reason": reason, "empty": false, "summary": "Recommend %s · %s" % [step, reason]}

static func naval_multi_phase_campaign_product(province_id: int = 1, fuel_level: float = 0.65) -> Dictionary:
	var fleet: Dictionary = fleet_multi_day_autonomy_product(fuel_level, "port", "contested", 100.0, "GER", province_id)
	var convoy: Dictionary = convoy_package_day(75.0, province_id)
	var combat: Dictionary = multi_phase_combat_product(100.0, 80.0, 0.85, 1.0, province_id)
	var posture_score := clampf(float(fleet.get("score", 0.5)), 0.0, 1.0)
	if posture_score < 0.35:
		posture_score = 0.35
	var escort_ok: bool = float(convoy.get("score", 0.5)) >= 0.4
	var escort_score := clampf(0.5 * (1.0 if escort_ok else 0.4) + 0.5 * float(convoy.get("score", 0.5)), 0.0, 1.0)
	if escort_score < 0.35:
		escort_score = 0.35
	var strike_score := clampf(0.55 * float(combat.get("score", 0.5)) + 0.45 * posture_score, 0.0, 1.0)
	if strike_score < 0.35:
		strike_score = 0.35
	var score := clampf(0.35 * posture_score + 0.3 * escort_score + 0.35 * strike_score, 0.0, 1.0)
	if score < 0.35:
		score = 0.35
	var rec: Dictionary = recommend_naval_phase_step(posture_score, escort_ok, strike_score >= 0.4 and escort_ok)
	var steps: Array = [
		{"step": "posture", "action_id": "naval_phase_posture", "leaf": "apply_station", "label": "Step 0 — fleet posture / tasking", "score": posture_score},
		{"step": "escort", "action_id": "naval_phase_escort", "leaf": "apply_station", "label": "Step 1 — convoy escort phase", "score": escort_score},
		{"step": "strike", "action_id": "naval_phase_strike", "leaf": "apply_assault", "label": "Step 2 — strike / multi-phase follow", "score": strike_score},
	]
	var day_rows: Array = []
	var apply_queue: Array = []
	for i in range(steps.size()):
		var st: Dictionary = steps[i]
		var step_name := str(st.get("step"))
		var recommended: bool = step_name == str(rec.get("step"))
		var sc := float(st.get("score", 0.5))
		var leaf := str(st.get("leaf"))
		var lab := str(st.get("label"))
		if recommended:
			lab = "★ " + lab
		lab = "%s · score %.2f" % [lab, sc]
		day_rows.append({"index": i, "step": step_name, "action_id": str(st.get("action_id")), "leaf_action": leaf, "label": lab, "score": sc, "enabled": true, "recommended": recommended, "province_id": province_id})
		apply_queue.append({"action_id": leaf, "province_id": province_id, "score": sc, "enabled": true, "label": lab, "step": step_name, "product_action": str(st.get("action_id"))})
	var actions: Array = [
		{"action_id": "naval_multi_phase_campaign_product", "label": "Run naval multi-phase campaign product", "enabled": true},
		{"action_id": str(rec.get("action_id", "naval_phase_posture")), "label": "Recommended: %s" % str(rec.get("step", "posture")), "enabled": true},
		{"action_id": "fleet_multi_day_autonomy_product", "label": "Open fleet multi-day autonomy", "enabled": true},
	]
	for row2 in day_rows:
		actions.append({"action_id": str(row2.get("action_id")), "label": str(row2.get("label")), "enabled": true, "step": str(row2.get("step"))})
	var label := "Naval multi-phase · posture %.2f · escort %s · strike %.2f · score %.2f" % [posture_score, "ok" if escort_ok else "thin", strike_score, score]
	return {
		"fleet": fleet, "convoy": convoy, "combat": combat, "posture_score": posture_score,
		"escort_score": escort_score, "strike_score": strike_score, "escort_ok": escort_ok,
		"recommendation": rec, "day_rows": day_rows, "apply_queue": apply_queue, "actions": actions,
		"score": score, "naval_score": score, "province_id": province_id,
		"summary": label, "plain": label,
		"bbcode": "%s⚓ Naval multi-phase[/color] %s— %s[/color]" % [COLOR_HEADER, COLOR_MUTED, label],
		"empty": false,
		"integration": ["naval_multi_phase_campaign_product", "naval_phase_posture", "naval_phase_escort", "naval_phase_strike", "major_15", "naval", "multi_phase"],
	}

static func execute_naval_phase_step(step: String = "posture", province_id: int = 1) -> Dictionary:
	var s := step.strip_edges().to_lower()
	if s.begins_with("naval_phase_"):
		s = s.replace("naval_phase_", "")
	if s not in ["posture", "escort", "strike"]:
		s = "posture"
	var product: Dictionary = naval_multi_phase_campaign_product(province_id)
	var row: Dictionary = {}
	for r in product.get("day_rows", []):
		if r is Dictionary and str(r.get("step")) == s:
