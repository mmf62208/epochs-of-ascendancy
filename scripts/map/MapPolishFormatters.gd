	var branch_sc := maxf(0.35, float(branch.get("score", 0.55)))
	var catalog_count := int(tech.get("catalog_count", 8))
	var open_n := int(branch.get("open_n", 5))
	var branch_n := int(branch.get("branch_n", 6))
	var locked_n := maxi(0, branch_n - open_n)
	var path_branch := str(branch.get("path_branch", pref))
	var tech_n := int(branch.get("tech_n", 3))
	var open_score := clampf(
		0.65 * maxf(0.35, float(tech.get("catalog_score", tech_sc)))
		+ 0.35 * minf(1.0, float(catalog_count) / 12.0),
		0.35, 1.0
	)
	var enqueue_score := clampf(
		0.55 * branch_sc + 0.25 * minf(1.0, float(tech_n) / 3.0) + 0.2 * 0.7,
		0.35, 1.0
	)
	var coverage := float(open_n) / maxf(1.0, float(branch_n))
	var gate_sc := clampf(0.55 * res + 0.45 * coverage - minf(0.25, 0.05 * float(locked_n)), 0.35, 1.0)
	var preferred_open := open_n >= 3
	var gate_score := clampf(0.45 * branch_sc + 0.4 * gate_sc + (0.15 if preferred_open else 0.05), 0.35, 1.0)
	var month_factor := clampf(minf(1.0, 0.45 + 0.04 * float(months)), 0.35, 1.0)
	var advance_score := clampf(
		0.5 * maxf(0.35, float(tech.get("priority_score", tech_sc)))
		+ 0.3 * gate_score + 0.2 * month_factor,
		0.35, 1.0
	)
	var close_score := clampf(
		0.22 * tech_sc + 0.18 * branch_sc + 0.14 * open_score + 0.14 * enqueue_score
		+ 0.14 * gate_score + 0.14 * advance_score + 0.04,
		0.35, 1.0
	)
	var major_scores := {
		"research_primary_open_queue": open_score,
		"research_primary_enqueue_branch": enqueue_score,
		"research_primary_gate_check": gate_score,
		"research_primary_advance_month": advance_score,
		"research_primary_close": close_score,
	}
	var majors_ok := {
		"research_primary_open_queue": open_score >= 0.35 and catalog_count >= 4,
		"research_primary_enqueue_branch": enqueue_score >= 0.35 and not path_branch.is_empty(),
		"research_primary_gate_check": gate_score >= 0.35 and preferred_open,
		"research_primary_advance_month": advance_score >= 0.35,
		"research_primary_close": close_score >= 0.35,
	}
	var majors_ok_n := 0
	for k in surface_keys:
		if bool(majors_ok.get(k, false)):
			majors_ok_n += 1
	var dead_n := 0
	var steps: Array = []
	var apply_queue: Array = []
	var step_scores := {}
	var flow_steps: PackedStringArray = ["open_queue", "enqueue_branch", "gate_check", "advance_month", "close"]
