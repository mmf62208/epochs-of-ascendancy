static func live_mut_board_day(province_id: int = 1) -> Dictionary:
	var summaries: Array = [
		{"label": "station mutate", "score": 0.55, "summary": "Fleet station mutation seed"},
		{"label": "prod mutate", "score": 0.7, "summary": "Production priority mutation seed"},
		{"label": "assault mutate", "score": 0.45, "summary": "Assault stage mutation seed"},
	]
	var strip: Dictionary = mutation_decision_strip(summaries)
	var gate: Dictionary = mutation_integrity_gate(1.1, 0.8, 0.2, 1.0)
	var ok := bool(gate.get("ok", false))
	var score := 0.75 if ok else 0.4
	if not bool(strip.get("empty", true)):
		score = minf(1.0, score + 0.1)
	var apply_queue: Array = [
		{"action_id": "refresh_queue", "province_id": province_id, "score": score, "enabled": true, "label": "Live mut board refresh"},
		{"action_id": "apply_station", "province_id": province_id, "score": 0.55, "enabled": true, "label": "Station after mut board"},
		{"action_id": "apply_production", "province_id": province_id, "score": 0.5, "enabled": true, "label": "Production after mut board"},
	]
	var label := "Live mut board · gate %s · strip %d · score %.2f" % [
		"PASS" if ok else "FAIL", int(strip.get("count", summaries.size())), score
	]
	return {
		"strip": strip, "gate": gate, "ok": ok, "score": score, "apply_queue": apply_queue,
		"actions": [{"action_id": "live_mut_board_day", "label": "Run live mut board day", "enabled": true}],
		"summary": label,
		"plain": "%s\n%s\n%s" % [label, str(gate.get("summary", "")), str(strip.get("summary", ""))],
		"bbcode": "%s☰ Live mut board[/color] %s— %s[/color]" % [COLOR_HEADER, COLOR_MUTED, label],
		"empty": false, "integration": ["mutation", "board", "integrity", "next110"],
	}


