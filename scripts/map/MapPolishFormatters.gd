	var leaf := str(row.get("leaf_action", "apply_station"))
	var action_id := "occupation_control_board"
	match s:
		"garrison": action_id = "occupation_control_garrison"
		"integrate": action_id = "occupation_control_integrate"
	var sc := float(row.get("score", product.get("score", 0.5)))
	var label := "Execute occupation %s · leaf %s · score %.2f" % [s, leaf, sc]
	return {"step": s, "leaf_action": leaf, "action_id": action_id, "ok": true, "score": sc, "province_id": province_id,
		"apply_queue": [{"action_id": leaf, "province_id": province_id, "score": sc, "enabled": true, "label": label, "step": s, "product_action": action_id}],
		"summary": label, "plain": label, "bbcode": "%s🏛 Occupation %s[/color] %s— %s[/color]" % [COLOR_HEADER, s, COLOR_MUTED, label], "empty": false,
