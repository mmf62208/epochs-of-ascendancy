## Move path day package (costly paths → station / supply).
static func move_path_day(
	base_cost: float = 1.0,
	ground_state: String = "dry",
	visibility: float = 1.0,
	supply_health: float = 0.85,
	armored: bool = false,
	province_id: int = 1,
) -> Dictionary:
	var path: Dictionary = move_path_ops_loop(base_cost, ground_state, visibility, supply_health, armored)
	var cost := float(path.get("path_cost", path.get("cost", base_cost)))
	var supply_h := clampf(supply_health, 0.15, 1.5)
	var urgency := clampf((cost - 0.8) * 0.5 + maxf(0.0, 1.0 - supply_h) * 0.6 + 0.25, 0.05, 1.2)
	var score := urgency
	var apply_queue: Array = []
	if cost >= 1.15 or supply_h < 0.7:
		apply_queue.append({
			"action_id": "apply_supply",
			"province_id": province_id,
			"score": maxf(0.35, urgency),
			"enabled": true,
		})
	apply_queue.append({
		"action_id": "apply_station",
		"province_id": province_id,
		"score": minf(1.0, 0.3 + urgency * 0.5),
		"enabled": true,
	})
	if cost >= 1.4:
		apply_queue.append({
			"action_id": "apply_focus",
			"province_id": province_id,
			"score": 0.4,
			"focus_id": "military_effort",
			"enabled": true,
		})
	var label := "Move path day · cost %.2f · supply %.0f%% · urgency %.2f" % [cost, supply_h * 100.0, urgency]
	return {
		"path": path,
		"path_cost": cost,
		"supply_health": supply_h,
		"score": score,
		"apply_ready": true,
		"apply_queue": apply_queue,
		"actions": [{"action_id": "move_path_day", "label": "Run move path day", "enabled": true}],
		"summary": label,
		"plain": label,
		"bbcode": "%s🥾 Move path day[/color] %s— %s[/color]" % [COLOR_TECH, COLOR_MUTED, label],
