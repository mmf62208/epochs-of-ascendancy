		specs = [
			{"province_id": 1, "basing_level": "port", "fuel_level": fuel_level},
			{"province_id": 2, "basing_level": "anchorage", "fuel_level": maxf(0.2, fuel_level - 0.25)},
		]
	var station: Dictionary = leader_formation_station_day(specs, leader_skill, visibility, precip, 3)
	var apply_queue: Array = []
	for a in sealane.get("actions", []):
		if a is Dictionary and bool(a.get("enabled", true)):
			apply_queue.append({"action_id": a.get("action_id"), "province_id": 1, "score": float(sealane.get("score", 0.5))})
	for q in station.get("apply_queue", []):
		if q is Dictionary and bool(q.get("enabled", true)):
			apply_queue.append({"action_id": q.get("action_id", "apply_station"), "province_id": q.get("province_id"), "score": float(q.get("score", 0.5))})
	if apply_queue.size() > 6:
		apply_queue = apply_queue.slice(0, 6)
	var score := (float(sealane.get("score", 0.5)) + float(station.get("score", 0.0))) / 2.0
	var label := "Logistics day · sealane/choke %.2f · stations %d" % [
		float(sealane.get("score", 0.0)),
		(station.get("apply_queue", []) as Array).size() if station.get("apply_queue") is Array else 0,
	]
	return {
		"sealane_choke": sealane,
		"station": station,
		"apply_queue": apply_queue,
		"score": score,
		"actions": [{"action_id": "logistics_day", "label": "Run logistics day", "enabled": not apply_queue.is_empty()}],
		"summary": label,
		"plain": label,
		"bbcode": "%s📦 Logistics day[/color] %s— %s[/color]" % [COLOR_HEADER, COLOR_MUTED, label],
		"empty": false,
	}


## War economy day: focus wx + production priority + OOB risk.
static func war_economy_day_package(
	temp: float = 10.0,
	precip: float = 0.0,
	ground_state: String = "dry",
	visibility: float = 1.0,
	wind: float = 0.2,
	focus_id: String = "industrial_effort",
	focus_base: float = 55.0,
) -> Dictionary:
	var focus: Dictionary = focus_weather_aware_score(focus_base, focus_id, visibility, precip, ground_state)
	var prod: Dictionary = production_priority_mutation(temp, precip, ground_state, visibility, wind, 1.0, "primary", "primary")
	var oob: Dictionary = oob_factory_risk_loop(temp, precip, ground_state, visibility, wind, 1.0)
	var mult := float(oob.get("effective_output", oob.get("mult", 1.0)))
	var risk := clampf(1.0 - mult, 0.0, 1.0)
	var focus_score := float(focus.get("score", 50.0))
	if focus_score > 2.0:
		focus_score = clampf(focus_score / 100.0, 0.0, 1.0)
	var prod_score := float(prod.get("score", 0.55))
	if prod_score > 2.0:
		prod_score = clampf(prod_score / 100.0, 0.0, 1.0)
	var score := focus_score * 0.35 + prod_score * 0.35 + (1.0 - risk) * 0.3
	var apply_ready := true
	var plan_v = prod.get("plan", null)
	if plan_v is Dictionary:
		apply_ready = bool((plan_v as Dictionary).get("apply_ready", true))
	apply_ready = apply_ready and risk < 0.85
	var best_focus := str(focus.get("focus_id", focus_id))
	if best_focus.is_empty():
		best_focus = focus_id
	var label := "War economy day · focus %s · prod×%.2f · risk %.0f%% · score %.2f" % [
		best_focus, mult, risk * 100.0, score
	]
	return {
		"focus": focus,
		"production": prod,
		"oob": oob,
		"best_focus": best_focus,
		"risk": risk,
		"score": score,
		"apply_ready": apply_ready,
		"actions": [
			{"action_id": "apply_production", "label": "Set production priority", "enabled": apply_ready},
			{"action_id": "apply_focus", "label": "Hold/advance focus %s" % best_focus, "enabled": true, "focus_id": best_focus},
		],
		"summary": label,
		"plain": label,
		"bbcode": "%s🏭 War economy[/color] %s— %s[/color]" % [COLOR_HEADER, COLOR_MUTED, label],
		"empty": false,
		"sole_mult": true,
	}


## Multi-front assault day queue from ranked targets.
static func multi_front_assault_day(
	targets: Array = [],
	attacker_power: float = 100.0,
	attacker_supply: float = 0.85,
	max_targets: int = 4,
) -> Dictionary:
	if targets.is_empty():
		return {"empty": true, "plain": "", "bbcode": "", "summary": "", "score": 0.0, "apply_queue": [], "actions": []}
	var ranked: Dictionary = rank_assault_targets(targets, attacker_power, attacker_supply, max_targets)
	var rows: Array = ranked.get("ranked", ranked.get("targets", ranked.get("top", [])))
	if rows.is_empty() and not bool(ranked.get("empty", true)):
		# rank_assault_targets may return list under different key
		for k in ranked.keys():
			if ranked[k] is Array and (ranked[k] as Array).size() > 0:
				var sample = (ranked[k] as Array)[0]
				if sample is Dictionary and (sample.has("province_id") or sample.has("overall") or sample.has("priority")):
					rows = ranked[k]
					break
	var apply_queue: Array = []
	for r in rows:
		if not (r is Dictionary):
			continue
		var pid := int(r.get("province_id", r.get("id", -1)))
		if pid < 0:
			continue
		var overall := float(r.get("overall", r.get("priority", 0.5)))
		if overall > 2.0:
			overall = clampf(overall / 100.0, 0.0, 1.0)
		apply_queue.append({
			"province_id": pid,
			"action_id": "apply_assault",
			"score": overall,
			"enabled": overall >= 0.35,
			"overall": overall,
		})
		if apply_queue.size() >= max_targets:
			break
	if apply_queue.is_empty():
		return {"empty": true, "plain": "", "bbcode": "", "summary": "", "score": 0.0, "apply_queue": [], "actions": []}
	var mean := 0.0
	var ready_n := 0
	for q in apply_queue:
		mean += float(q.get("score", 0.0))
		if bool(q.get("enabled", false)):
			ready_n += 1
	mean /= float(maxi(apply_queue.size(), 1))
	var label := "Multi-front assault day · %d targets · ready %d · score %.2f" % [apply_queue.size(), ready_n, mean]
	return {
		"ranked": ranked,
		"apply_queue": apply_queue,
		"score": mean,
		"ready_count": ready_n,
		"actions": [{"action_id": "multi_front_assault_day", "label": "Stage multi-front assaults", "enabled": ready_n > 0}],
		"summary": label,
		"plain": label,
		"bbcode": "%s⚔ Multi-front day[/color] %s— %s[/color]" % [COLOR_HEADER, COLOR_MUTED, label],
		"empty": false,
	}


## Theater day command strip for inspector.
static func theater_day_command_strip(summaries: Array = [], log_lines: Array = []) -> Dictionary:
	var lines: Array = []
	for s in summaries:
		var t := str(s).strip_edges()
		if not t.is_empty():
			lines.append(t.split("\n")[0])
	for ln in log_lines:
		var t2 := str(ln).strip_edges()
		if not t2.is_empty():
			lines.append(t2)
		if lines.size() >= 8:
			break
	if lines.is_empty():
		return {"empty": true, "plain": "", "bbcode": "", "summary": "", "lines": [], "score": 0.0}
	var label := "Theater day command strip · %d lines" % lines.size()
	return {
		"lines": lines,
		"count": lines.size(),
		"score": clampf(0.2 * float(lines.size()), 0.1, 1.0),
		"summary": label,
		"plain": label + "\n" + "\n".join(lines),
		"bbcode": "%s── Theater day strip ──[/color] %s— %s[/color]" % [COLOR_HEADER, COLOR_MUTED, label],
		"empty": false,
	}


## Integrated day ops plan bundle.
static func day_ops_integrated_plan(
	fleet_day: Dictionary = {},
	agent_day: Dictionary = {},
	hh_product: Dictionary = {},
) -> Dictionary:
	var fleet_empty := fleet_day.is_empty() or bool(fleet_day.get("empty", true))
	var agent_empty := agent_day.is_empty() or bool(agent_day.get("empty", true))
	var hh_empty := hh_product.is_empty() or bool(hh_product.get("empty", true))
	if fleet_empty and agent_empty and hh_empty:
		return {"empty": true, "plain": "", "bbcode": "", "summary": "", "score": 0.0, "apply_queue": []}
	var apply_queue: Array = []
	for item in fleet_day.get("apply_queue", []):
		if item is Dictionary:
			apply_queue.append(item)
	for item in agent_day.get("dispatch_queue", []):
		if item is Dictionary:
			apply_queue.append(item)
	if not hh_empty:
		apply_queue.append({
			"action_id": "apply_hh_commit",
			"province_id": -1,
			"score": float(hh_product.get("score", 0.4)),
		})
	var score := 0.0
	var n := 0
	if not fleet_empty:
		score += float(fleet_day.get("score", 0.0))
		n += 1
	if not agent_empty:
		score += float(agent_day.get("score", 0.0))
		n += 1
	if not hh_empty:
		score += float(hh_product.get("score", 0.0))
		n += 1
	if n > 0:
		score /= float(n)
	var label := "Day ops integrated · fleet_q %d · agent_q %d · hh %s · score %.2f" % [
		(fleet_day.get("apply_queue", []) as Array).size() if not fleet_empty else 0,
		(agent_day.get("dispatch_queue", []) as Array).size() if not agent_empty else 0,
		"yes" if not hh_empty else "no",
		score,
	]
	return {
		"fleet": fleet_day,
		"agent": agent_day,
		"hh": hh_product,
		"apply_queue": apply_queue,
		"score": score,
		"actions": [{"action_id": "day_ops_integrated", "label": "Run integrated day ops", "enabled": not apply_queue.is_empty()}],
		"summary": label,
		"plain": label,
		"bbcode": "%s📅 Day ops[/color] %s— %s[/color]" % [COLOR_HEADER, COLOR_MUTED, label],
		"empty": false,
	}


## Agent auto-dispatch day from signal list.
static func agent_auto_dispatch_day(
	signals: Array = [],
	available_agents: int = 5,
	network_strength: float = 0.35,
	max_dispatches: int = 3,
) -> Dictionary:
	var quality: Dictionary = agent_ai_decision_quality(signals, available_agents, network_strength)
	if bool(quality.get("empty", true)):
		return {
			"empty": true, "plain": "", "bbcode": "", "summary": "", "score": 0.0,
			"dispatch_queue": [], "actions": [],
		}
	var queue: Array = []
	for d in quality.get("decisions", []):
		if not (d is Dictionary):
			continue
		queue.append({
			"province_id": int(d.get("province_id", -1)),
			"action_class": str(d.get("action_class", "")),
			"best_mission": str(d.get("best_mission", "")),
			"action_id": "apply_agent_dispatch",
			"score": float(d.get("score", 0.5)),
		})
	queue.sort_custom(func(a, b): return float(a.get("score", 0.0)) > float(b.get("score", 0.0)))
	if queue.size() > max_dispatches:
		queue = queue.slice(0, max_dispatches)
	if not queue.is_empty():
		queue.append({
			"province_id": int(queue[0].get("province_id", -1)),
			"action_id": "apply_counterplay",
			"best_mission": "counter_intel",
			"score": float(queue[0].get("score", 0.5)) * 0.9,
		})
	var label := "Agent auto-dispatch day · %d dispatches · affinity %.0f%% · score %.2f" % [
		queue.size() - (1 if queue.size() > 0 and str(queue[-1].get("action_id", "")) == "apply_counterplay" else 0),
		float(quality.get("affinity", 0.0)) * 100.0,
		float(quality.get("score", 0.0)),
	]
	return {
		"quality": quality,
		"dispatch_queue": queue,
		"score": float(quality.get("score", 0.0)),
		"affinity": float(quality.get("affinity", 0.0)),
		"actions": [{
			"action_id": "agent_auto_day",
			"label": "Run agent auto-dispatch day",
			"enabled": not queue.is_empty(),
		}],
		"summary": label,
		"plain": label,
		"bbcode": "%s🕵 Agent day[/color] %s— %s[/color]" % [COLOR_HEADER, COLOR_MUTED, label],
		"empty": queue.is_empty(),
	}


static func ops_depth_integrity_gate(sea_mult: float = 1.1, weather_mult: float = 0.8, route_risk: float = 0.2, ops_mult: float = 1.0) -> Dictionary:
	var sole: Dictionary = sole_mult_integrity(sea_mult, weather_mult, route_risk)
	var day: Dictionary = daily_apply_integrity_gate(sea_mult, weather_mult, route_risk, ops_mult)
	var sole_ok := bool(sole.get("integrity_ok", false))
	var day_ok := bool(day.get("ok", false))
	var sole_health := float(sole.get("sole_health", 0.5)) * clampf(ops_mult, 0.1, 1.4)
	var stacked := sole_health * clampf(ops_mult, 0.1, 1.4)
	var ops_ok := true
	if absf(ops_mult - 1.0) > 0.05:
		ops_ok = absf(stacked - sole_health) > 0.01
	var ok := sole_ok and day_ok and ops_ok
	var label := "Ops depth integrity %s (sole=%s day=%s ops=%s)" % [
		"PASS" if ok else "FAIL",
		"ok" if sole_ok else "fail",
		"ok" if day_ok else "fail",
		"ok" if ops_ok else "fail",
	]
	return {"ok": ok, "summary": label, "bbcode": "%s✓ Ops integrity[/color] %s— %s[/color]" % [COLOR_HEADER, COLOR_MUTED, label], "empty": false}



## Naval interdiction day package.
static func naval_interdiction_day(
	sea_trade_mult: float = 1.0,
	escort_coverage: float = 0.55,
	interdiction_pressure: float = 0.4,
	visibility: float = 1.0,
	precip: float = 0.0,
	available_fleet: float = 80.0,
) -> Dictionary:
	var sea := clampf(sea_trade_mult, 0.2, 1.5)
	var escort := clampf(escort_coverage, 0.0, 1.0)
	var pressure := clampf(interdiction_pressure, 0.0, 1.0)
	var wx_gate := clampf(visibility * (1.0 - precip * 0.45), 0.25, 1.0)
	var interdict_score := pressure * (1.0 - escort * 0.65) * wx_gate * minf(1.2, sea)
	var escort_need := clampf(interdict_score * 0.9 + (1.0 - escort) * 0.35, 0.0, 1.0)
	var apply_ready := wx_gate >= 0.35 and available_fleet >= 20.0
	var convoy: Dictionary = convoy_supply_day_package(precip, visibility, sea, available_fleet)
	var score := interdict_score * 0.55 + float(convoy.get("score", 0.5)) * 0.45
	var apply_queue: Array = []
	if apply_ready and interdict_score >= 0.35:
		apply_queue.append({"action_id": "fleet_autonomy", "province_id": 1, "score": interdict_score, "order": "interdict", "enabled": true})
	if escort_need >= 0.45:
		apply_queue.append({"action_id": "apply_station", "province_id": 1, "score": escort_need, "order": "escort", "enabled": true})
	if apply_queue.is_empty():
		apply_queue.append({"action_id": "apply_supply", "province_id": 1, "score": 0.4, "enabled": true})
	var label := "Naval interdiction day · interdict %.0f%% · escort_need %.0f%% · fleet %.0f" % [
		interdict_score * 100.0, escort_need * 100.0, available_fleet
	]
	return {
		"convoy": convoy,
		"interdiction_score": interdict_score,
		"escort_need": escort_need,
		"wx_gate": wx_gate,
		"score": score,
		"apply_ready": apply_ready,
		"apply_queue": apply_queue,
		"actions": [
			{"action_id": "naval_interdiction_day", "label": "Run naval interdiction day", "enabled": not apply_queue.is_empty()},
			{"action_id": "fleet_autonomy", "label": "Fleet interdict posture", "enabled": apply_ready and interdict_score >= 0.35},
		],
		"summary": label,
		"plain": label,
		"bbcode": "%s⚓ Interdiction day[/color] %s— %s[/color]" % [COLOR_HEADER, COLOR_MUTED, label],
		"empty": false,
	}


## Intel / HH counter day package.
static func intel_counter_day(
	has_signal: bool = true,
	action_class: String = "sabotage",
	province_id: int = 1,
	trail_count: int = 1,
	pressure: float = 0.45,
) -> Dictionary:
	if not has_signal and trail_count <= 0:
		return {"empty": true, "plain": "", "bbcode": "", "summary": "", "score": 0.0, "apply_queue": [], "actions": []}
	var p := clampf(pressure, 0.0, 1.0)
	var counter_score := p * (1.15 if has_signal else 0.7) * (1.1 if trail_count > 0 else 1.0)
	counter_score = clampf(counter_score, 0.05, 1.2)
	var apply_queue: Array = []
	if has_signal:
		apply_queue.append({"action_id": "apply_agent_dispatch", "province_id": province_id, "score": counter_score, "action_class": action_class, "enabled": true})
		apply_queue.append({"action_id": "apply_counterplay", "province_id": province_id, "score": counter_score * 0.9, "enabled": true})
	if trail_count > 0:
		apply_queue.append({"action_id": "apply_hh_commit", "province_id": -1, "score": 0.45 + 0.05 * float(mini(3, trail_count)), "enabled": true})
	var label := "Intel counter day · signal=%s · trail=%d · score %.2f" % [
		action_class if has_signal else "none", trail_count, counter_score
	]
	return {
		"action_class": action_class,
		"trail_count": trail_count,
		"score": counter_score,
		"apply_ready": true,
		"apply_queue": apply_queue,
		"actions": [{"action_id": "intel_counter_day", "label": "Run intel counter day", "enabled": true}],
		"summary": label,
		"plain": label,
		"bbcode": "%s◎ Intel counter day[/color] %s— %s[/color]" % [COLOR_HEADER, COLOR_MUTED, label],
		"empty": false,
	}


## Joint command day compose (naval + intel + air-forecast + logistics).
static func joint_command_day(
	visibility: float = 1.0,
	precip: float = 0.0,
	sea_trade_mult: float = 1.0,
	has_signal: bool = true,
	action_class: String = "sabotage",
	province_id: int = 1,
	trail_count: int = 1,
	targets: Array = [],
) -> Dictionary:
	var naval: Dictionary = naval_interdiction_day(sea_trade_mult, 0.55, 0.4, visibility, precip, 80.0)
	var intel: Dictionary = intel_counter_day(has_signal, action_class, province_id, trail_count, 0.5)
	var month := 6
	var air: Dictionary = air_forecast_assault_day(visibility, precip, 0.2, month, targets)
	var logistics: Dictionary = sealane_choke_logistics_day(sea_trade_mult, 0.9, precip, visibility, true, true, 0.65, "port")
	var apply_queue: Array = []
	for block in [naval, intel, air, logistics]:
		if not (block is Dictionary) or bool(block.get("empty", false)):
			continue
		for q in block.get("apply_queue", []):
			if q is Dictionary and bool(q.get("enabled", true)):
				apply_queue.append(q)
	# Dedupe
	var seen: Dictionary = {}
	var deduped: Array = []
	for q in apply_queue:
		if not (q is Dictionary):
			continue
		var key := "%s:%d" % [str(q.get("action_id", "")), int(q.get("province_id", -1))]
		if seen.has(key):
			continue
		seen[key] = true
		deduped.append(q)
	if deduped.size() > 8:
		deduped = deduped.slice(0, 8)
	var s_naval := float(naval.get("score", 0.0))
	var s_intel := 0.0 if bool(intel.get("empty", false)) else float(intel.get("score", 0.0))
	var s_air := float(air.get("score", 0.0))
	var s_log := float(logistics.get("score", 0.0))
	var score: float = (s_naval + s_intel + s_air + s_log) / 4.0
	var label := "Joint command day · naval %.2f · intel %.2f · air %.2f · log %.2f · q %d" % [
		s_naval, s_intel, s_air, s_log, deduped.size()
	]
	return {
		"naval": naval,
		"intel": intel,
		"air": air,
		"logistics": logistics,
		"apply_queue": deduped,
		"score": score,
		"actions": [{"action_id": "joint_command_day", "label": "Run joint command day", "enabled": not deduped.is_empty()}],
		"summary": label,
		"plain": label,
		"bbcode": "%s🎖 Joint command day[/color] %s— %s[/color]" % [COLOR_HEADER, COLOR_MUTED, label],
		"empty": false,
	}


## Order execute day: drain order queue with budget.
static func order_execute_day(
	visibility: float = 1.0,
	precip: float = 0.0,
	temp: float = 10.0,
	ground_state: String = "dry",
	wind: float = 0.2,
	month: int = 6,
	trail: Array = [],
	max_executes: int = 3,
	province_id: int = 1,
) -> Dictionary:
	var board: Dictionary = order_queue_board(visibility, precip, temp, ground_state, wind, month, trail)
	var items: Array = board.get("items", [])
	if items.is_empty():
		return {"empty": true, "plain": "", "bbcode": "", "summary": "", "score": 0.0, "apply_queue": [], "actions": []}
	var budget := maxi(1, max_executes)
	var apply_queue: Array = []
	var n := 0
	for item in items:
		if n >= budget:
			break
		if not (item is Dictionary):
			continue
		var domain := str(item.get("domain", "fleet"))
		var score := float(item.get("score", 0.5))
		if score > 2.0:
			score = clampf(score / 100.0, 0.0, 1.0)
		var aid := "execute_one"
		if domain == "combat":
			aid = "apply_assault"
		elif domain == "production":
			aid = "apply_production"
		elif domain == "supply":
			aid = "apply_supply"
		elif domain == "hh":
			aid = "apply_hh_commit"
		elif domain == "agent":
			aid = "apply_agent_dispatch"
		elif n > 0:
			aid = "fleet_autonomy"
		apply_queue.append({
			"action_id": aid,
			"province_id": province_id,
			"score": score,
			"domain": domain,
			"api": str(item.get("api", item.get("order", ""))),
			"enabled": bool(item.get("apply_ready", true)) or score >= 0.35,
		})
		n += 1
	var ready_n := 0
	var mean := 0.0
	for q in apply_queue:
		mean += float(q.get("score", 0.0))
		if bool(q.get("enabled", false)):
			ready_n += 1
	mean /= float(maxi(apply_queue.size(), 1))
	var label := "Order execute day · queue %d · budget %d · ready %d · score %.2f" % [
		items.size(), budget, ready_n, mean
	]
	return {
		"board": board,
		"apply_queue": apply_queue,
		"score": mean,
		"ready_count": ready_n,
		"apply_ready": ready_n > 0,
		"actions": [
			{"action_id": "order_execute_day", "label": "Run order execute day", "enabled": ready_n > 0},
			{"action_id": "execute_one", "label": "Execute one order", "enabled": ready_n > 0},
		],
