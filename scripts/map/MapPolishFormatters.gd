static func recommend_designer_domain(
	catalog: Dictionary,
	tank_progress: float = 0.15,
	naval_pressure: float = 0.4,
	air_pressure: float = 0.35,
	era_year: int = 1939,
) -> Dictionary:
	var land_best := 0.55
	var naval_best := 0.55
	var air_best := 0.55
	var space_best := 0.55
	if catalog.get("land") is Array and not (catalog["land"] as Array).is_empty():
		land_best = float((catalog["land"] as Array)[0].get("score", 0.55)) if (catalog["land"] as Array)[0] is Dictionary else 0.55
	if catalog.get("naval") is Array and not (catalog["naval"] as Array).is_empty():
		naval_best = float((catalog["naval"] as Array)[0].get("score", 0.55)) if (catalog["naval"] as Array)[0] is Dictionary else 0.55
	if catalog.get("air") is Array and not (catalog["air"] as Array).is_empty():
		air_best = float((catalog["air"] as Array)[0].get("score", 0.55)) if (catalog["air"] as Array)[0] is Dictionary else 0.55
	if catalog.get("space") is Array and not (catalog["space"] as Array).is_empty():
		space_best = float((catalog["space"] as Array)[0].get("score", 0.55)) if (catalog["space"] as Array)[0] is Dictionary else 0.55
	var prog := clampf(tank_progress, 0.0, 1.0)
	var scores := {
		"land": clampf(0.45 * land_best + 0.35 * (1.0 - prog) + 0.2, 0.35, 1.0),
		"naval": clampf(0.5 * naval_best + 0.4 * clampf(naval_pressure, 0.0, 1.0) + 0.1, 0.35, 1.0),
		"air": clampf(0.5 * air_best + 0.4 * clampf(air_pressure, 0.0, 1.0) + 0.1, 0.35, 1.0),
		"space": clampf(0.35 * space_best + (0.35 if era_year >= 1955 else 0.1), 0.35, 1.0),
	}
	var domain := "land"
	var best_sc := -1.0
	for k in scores.keys():
		if float(scores[k]) > best_sc:
			best_sc = float(scores[k])
			domain = str(k)
	var rows: Array = catalog.get(domain, []) if catalog.get(domain) is Array else []
	var pick: Dictionary = rows[0] if not rows.is_empty() and rows[0] is Dictionary else {"design_id": "", "label": domain}
	var leaf := "apply_production"
	var doctrine := "rugged_redundancy"
	var action_id := "designer_domain_land"
	match domain:
		"naval":
			leaf = "apply_station"
			doctrine = "compartmentalized_survivability"
			action_id = "designer_domain_naval"
		"air":
			leaf = "apply_production"
			doctrine = "lightweight_performance"
			action_id = "designer_domain_air"
		"space":
			leaf = "apply_focus"
			doctrine = "lightweight_performance"
			action_id = "designer_domain_space"
	return {
		"domain": domain, "design_id": str(pick.get("design_id", "")), "label": str(pick.get("label", "")),
		"score": best_sc, "domain_scores": scores, "action_id": action_id, "leaf": leaf, "doctrine": doctrine,
		"reason": "prioritize %s" % domain, "summary": "Recommend %s · %s" % [domain, str(pick.get("label", ""))], "empty": false,
	}

static func recommend_designer_suite_step(catalog_count: int, has_pick: bool = true, production_ready: bool = false) -> Dictionary:
	var step := "seed_production"
	var reason := "seed production line from design"
	if catalog_count <= 0:
		step = "catalog"
		reason = "empty catalog — open designer"
	elif not has_pick:
		step = "pick_domain"
		reason = "pick domain design"
	elif not production_ready:
		step = "seed_production"
		reason = "seed production line from design"
	var action_id := "designer_suite_catalog"
	var leaf := "apply_focus"
	match step:
		"pick_domain":
			action_id = "designer_suite_pick"
			leaf = "apply_production"
		"seed_production":
			action_id = "designer_suite_seed"
			leaf = "apply_production"
	return {
		"step": step, "action_id": action_id, "leaf": leaf, "reason": reason, "empty": false,
		"summary": "Recommend %s · %s" % [step, reason],
	}

static func designer_suite_product(
	catalog: Dictionary = {},
	province_id: int = 1,
	country_tag: String = "GER",
	tank_progress: float = 0.15,
	factories: int = 14,
	naval_pressure: float = 0.4,
	air_pressure: float = 0.35,
	era_year: int = 1939,
	temp: float = 12.0,
	precip: float = 0.2,
	ground_state: String = "dry",
	visibility: float = 0.75,
	wind: float = 0.2,
) -> Dictionary:
	var cat: Dictionary = catalog if not catalog.is_empty() else _designer_demo_catalog()
	# Normalize scores on demo rows
	for dom in ["land", "naval", "air", "space"]:
		var rows: Array = cat.get(dom, []) if cat.get(dom) is Array else []
		rows.sort_custom(func(a, b):
			if not (a is Dictionary):
				return false
			if not (b is Dictionary):
				return true
			return float(a.get("score", 0)) > float(b.get("score", 0))
		)
		cat[dom] = rows
	var domain_rec: Dictionary = recommend_designer_domain(cat, tank_progress, naval_pressure, air_pressure, era_year)
	var design_id := str(domain_rec.get("design_id", "primary"))
	var mut: Dictionary = production_priority_mutation(temp, precip, ground_state, visibility, wind, 1.0, design_id)
	var order: Dictionary = production_order_resolve(temp, precip, ground_state, visibility, wind, 1.0, design_id)
	var oob: Dictionary = medium_tank_oob_product(province_id, tank_progress, 0.0, 5.0, factories, temp, precip, ground_state, visibility, wind)
	var catalog_count := 0
	for dom2 in ["land", "naval", "air", "space"]:
		if cat.get(dom2) is Array:
			catalog_count += (cat[dom2] as Array).size()
	var domain_meta := {
		"land": {"action_id": "designer_domain_land", "leaf": "apply_production", "label": "Land designer — medium armor line", "doctrine": "rugged_redundancy"},
		"naval": {"action_id": "designer_domain_naval", "leaf": "apply_station", "label": "Naval designer — fleet hull line", "doctrine": "compartmentalized_survivability"},
		"air": {"action_id": "designer_domain_air", "leaf": "apply_production", "label": "Air designer — fighter/CAS line", "doctrine": "lightweight_performance"},
		"space": {"action_id": "designer_domain_space", "leaf": "apply_focus", "label": "Space designer — orbital project", "doctrine": "lightweight_performance"},
	}
	var domain_rows: Array = []
	for dom3 in ["land", "naval", "air", "space"]:
		var meta: Dictionary = domain_meta[dom3]
		var rows3: Array = cat.get(dom3, []) if cat.get(dom3) is Array else []
		var best: Dictionary = rows3[0] if not rows3.is_empty() and rows3[0] is Dictionary else {"design_id": "", "label": "empty", "score": 0.35}
		var recommended: bool = dom3 == str(domain_rec.get("domain"))
		var sc := float(best.get("score", 0.5))
		if recommended:
			sc = clampf(sc + 0.08, 0.35, 1.0)
		var lab := str(meta.get("label"))
		if recommended:
			lab = "★ " + lab
		lab = "%s · %s · score %.2f" % [lab, str(best.get("label", "")), sc]
		domain_rows.append({
			"domain": dom3, "action_id": str(meta.get("action_id")), "leaf_action": str(meta.get("leaf")),
			"design_id": str(best.get("design_id", "")), "label": lab, "score": sc,
			"recommended": recommended, "enabled": not rows3.is_empty(), "doctrine": str(meta.get("doctrine")),
			"count": rows3.size(),
		})
	var prod_score := float(mut.get("score", order.get("score", 0.55)))
	var oob_score := float(oob.get("score", 0.55))
	var pick_score := float(domain_rec.get("score", 0.55))
	var score := clampf(0.35 * pick_score + 0.25 * prod_score + 0.2 * oob_score + 0.2 * minf(1.0, float(catalog_count) / 12.0), 0.0, 1.0)
	if score < 0.35:
		score = 0.35
	var production_ready: bool = factories >= 8 and str(domain_rec.get("design_id", "")) != ""
	var rec: Dictionary = recommend_designer_suite_step(catalog_count, true, production_ready)
	var step_scores := {
		"catalog": clampf(0.4 + 0.05 * float(mini(12, catalog_count)), 0.35, 1.0),
		"pick_domain": pick_score,
		"seed_production": clampf(0.45 * prod_score + 0.35 * pick_score + 0.2, 0.35, 1.0),
	}
	var steps: Array = [
		{"step": "catalog", "action_id": "designer_suite_catalog", "leaf": "apply_focus", "label": "Step 0 — review multi-domain catalog"},
		{"step": "pick_domain", "action_id": "designer_suite_pick", "leaf": "apply_production", "label": "Step 1 — pick domain design"},
		{"step": "seed_production", "action_id": "designer_suite_seed", "leaf": str(domain_rec.get("leaf", "apply_production")), "label": "Step 2 — seed production line"},
	]
	var day_rows: Array = []
	var apply_queue: Array = []
	for i in range(steps.size()):
		var st: Dictionary = steps[i]
		var step_name := str(st.get("step"))
		var recommended2: bool = step_name == str(rec.get("step"))
		var sc2 := float(step_scores.get(step_name, 0.5))
		var lab2 := str(st.get("label"))
		if recommended2:
			lab2 = "★ " + lab2
		lab2 = "%s · %s · score %.2f" % [lab2, str(domain_rec.get("domain", "")), sc2]
		var leaf2 := str(st.get("leaf"))
		var row := {
			"index": i, "step": step_name, "action_id": str(st.get("action_id")),
			"leaf_action": leaf2, "label": lab2, "score": sc2,
			"enabled": catalog_count > 0 or step_name == "catalog",
			"recommended": recommended2, "province_id": province_id,
			"domain": str(domain_rec.get("domain", "")), "design_id": design_id,
		}
		day_rows.append(row)
		apply_queue.append({
			"action_id": leaf2, "province_id": province_id, "score": sc2, "enabled": bool(row.get("enabled")),
			"label": lab2, "step": step_name, "product_action": str(st.get("action_id")),
			"design_id": design_id, "domain": str(domain_rec.get("domain", "")),
		})
	for dr in domain_rows:
		if dr is Dictionary:
			apply_queue.append({
				"action_id": str(dr.get("leaf_action")), "province_id": province_id,
				"score": float(dr.get("score", 0.5)), "enabled": bool(dr.get("enabled")),
				"label": str(dr.get("label")), "step": "pick_domain",
				"product_action": str(dr.get("action_id")),
				"design_id": str(dr.get("design_id", "")), "domain": str(dr.get("domain", "")),
			})
	var actions: Array = [
		{"action_id": "designer_suite_product", "label": "Run designer suite product", "enabled": true},
		{"action_id": str(rec.get("action_id", "designer_suite_catalog")), "label": "Recommended: %s" % str(rec.get("step", "catalog")), "enabled": true},
	]
	for row3 in day_rows:
		actions.append({"action_id": str(row3.get("action_id")), "label": str(row3.get("label")), "enabled": bool(row3.get("enabled")), "step": str(row3.get("step"))})
	for dr2 in domain_rows:
		if dr2 is Dictionary:
			actions.append({"action_id": str(dr2.get("action_id")), "label": str(dr2.get("label")), "enabled": bool(dr2.get("enabled")), "domain": str(dr2.get("domain"))})
	var tag := country_tag.strip_edges().to_upper()
	if tag.is_empty():
		tag = "GER"
	var label := "Designer suite · %s · domains 4 · pick %s/%s · catalog %d · factories %d · score %.2f" % [
		tag, str(domain_rec.get("domain")), design_id, catalog_count, factories, score
	]
	var plain_lines: PackedStringArray = [label, str(rec.get("summary", "")), str(domain_rec.get("summary", "")), "doctrine %s" % str(domain_rec.get("doctrine", ""))]
	for dr3 in domain_rows:
		if dr3 is Dictionary:
			plain_lines.append(str(dr3.get("label", "")))
	for row4 in day_rows:
		plain_lines.append(str(row4.get("label", "")))
	return {
		"catalog": cat, "catalog_count": catalog_count, "domain_rows": domain_rows,
		"domain_recommendation": domain_rec, "mutation": mut, "order": order, "oob": oob,
		"country_tag": tag, "factories": factories, "tank_progress": clampf(tank_progress, 0.0, 1.0),
		"recommendation": rec, "day_rows": day_rows, "apply_queue": apply_queue, "actions": actions,
		"score": score, "design_score": score, "province_id": province_id, "apply_ready": production_ready,
		"summary": label, "plain": "\n".join(plain_lines),
		"bbcode": "%s⚙ Designer suite[/color] %s— %s[/color]" % [COLOR_WARN, COLOR_MUTED, label],
		"empty": catalog_count <= 0,
		"integration": ["designer_suite_product", "designer_suite_catalog", "designer_suite_pick", "designer_suite_seed", "designer_domain_land", "designer_domain_naval", "designer_domain_air", "designer_domain_space", "major_10", "designers"],
	}

static func execute_designer_suite_step(step: String = "catalog", province_id: int = 1, country_tag: String = "GER") -> Dictionary:
	var s := step.strip_edges().to_lower()
	if s.begins_with("designer_suite_"):
		s = s.replace("designer_suite_", "")
	if s.begins_with("designer_domain_"):
		s = "pick_domain"
	if s not in ["catalog", "pick_domain", "seed_production"]:
		s = "catalog"
	var product: Dictionary = designer_suite_product({}, province_id, country_tag)
	var row: Dictionary = {}
	for r in product.get("day_rows", []):
		if r is Dictionary and str(r.get("step")) == s:
			row = r
			break
	var leaf := str(row.get("leaf_action", "apply_focus"))
	var action_id := "designer_suite_catalog"
	match s:
		"pick_domain":
			action_id = "designer_suite_pick"
		"seed_production":
			action_id = "designer_suite_seed"
	var score := float(row.get("score", product.get("score", 0.5)))
	var drec: Dictionary = product.get("domain_recommendation", {})
	var apply_queue: Array = [{
		"action_id": leaf, "province_id": province_id, "score": score, "enabled": true,
		"label": str(row.get("label", s)), "step": s, "product_action": action_id,
		"design_id": str(drec.get("design_id", "")), "domain": str(drec.get("domain", "")),
	}]
	var label := "Execute designer %s · leaf %s · %s/%s · score %.2f" % [
		s, leaf, str(drec.get("domain", "?")), str(drec.get("design_id", "?")), score
	]
	return {
		"step": s, "leaf_action": leaf, "action_id": action_id, "apply_queue": apply_queue,
		"score": score, "province_id": province_id, "domain": str(drec.get("domain", "")),
		"design_id": str(drec.get("design_id", "")), "summary": label, "plain": label,
		"bbcode": "%s⚙ Designer %s[/color] %s— %s[/color]" % [COLOR_WARN, s, COLOR_MUTED, label],
		"empty": false, "ok": true,
		"integration": ["execute_designer_suite_step", s, leaf],
	}

