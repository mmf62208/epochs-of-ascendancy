## === Gameplay loops beyond integration-expand ===

static func basing_fleet_fuel_logistics(
	basing_level: String = "port",
	fuel_level: float = 0.5,
	available_strength: float = 100.0,
	zone_relation: String = "contested",
	mission: String = "patrol",
	visibility: float = 1.0,
	precip: float = 0.0,
) -> Dictionary:
	var level := basing_level.strip_edges().to_lower()
	var fuel := clampf(fuel_level, 0.05, 1.2)
	var escort := 0.0
	var mission_eff := mission
	if fuel < 0.4:
		escort = 35.0
		if level in ["port", "major_base", "anchorage"]:
			mission_eff = "hold"
		else:
			mission_eff = "patrol"
	var pkg: Dictionary = fleet_weather_mission_package(
		mission_eff, available_strength, zone_relation, escort, visibility, precip
	)
	var refuel := 0.0
	match level:
		"anchorage":
			refuel = 0.10
		"port":
			refuel = 0.25
		"major_base":
			refuel = 0.40
		_:
			refuel = 0.0
	var urgency := maxf(0.0, 1.0 - fuel)
	var logistics := refuel * (0.5 + 0.5 * urgency) * (0.7 + 0.3 * available_strength / 100.0)
	if fuel < 0.35 and level == "none":
		logistics *= 0.3
	var label := "Basing logistics · %s · fuel %.0f%% · refuel %.2f · primary %s" % [
		level, fuel * 100.0, refuel, str(pkg.get("primary_role", "?"))
	]
	return {
		"basing_level": level,
		"fuel_level": fuel,
		"refuel_rate": refuel,
		"logistics_score": logistics,
		"primary_role": str(pkg.get("primary_role", "")),
		"mission_effective": str(pkg.get("mission_effective", mission_eff)),
		"summary": label,
		"bbcode": "%s⚓ Basing logistics[/color] %s— %s[/color]" % [COLOR_TECH, COLOR_MUTED, label],
		"empty": false,
		"integration": ["basing", "fleet_wx", "fuel"],
	}


static func assault_follow_on_loop(
	targets: Array,
	attacker_power: float = 100.0,
	attacker_supply: float = 1.0,
	visibility: float = 1.0,
	precip: float = 0.0,
	ground_state: String = "dry",
	wind: float = 0.2,
) -> Dictionary:
	var ready: Dictionary = assault_readiness_compose(
		targets, attacker_power, attacker_supply, visibility, precip, ground_state, wind
	)
	if bool(ready.get("empty", true)):
		return {"empty": true, "next_step": "none", "summary": "", "bbcode": ""}
	var overall := 0.0
	var ranked: Dictionary = ready.get("ranked", {})
	if ranked is Dictionary:
		var best: Dictionary = ranked.get("best", {})
		overall = float(best.get("overall", 0.0))
	var step := "soften"
	var advice := "Soften with recon/artillery first"
	if overall >= 0.65:
		step = "press"
		advice = "Press follow-on assault"
	elif overall >= 0.45:
		step = "hold"
		advice = "Hold — reinforce supply before follow-on"
	var label := "Follow-on · %s · win %.0f%% · %s" % [step, overall * 100.0, advice]
	return {
		"readiness": ready,
		"overall": overall,
		"next_step": step,
		"advice": advice,
		"best_province_id": int(ready.get("best_province_id", -1)),
		"summary": label,
		"bbcode": "%s⚔ Follow-on[/color] %s— %s[/color]" % [COLOR_HEADER, COLOR_MUTED, label],
		"empty": false,
		"integration": ["assault_ready", "follow_on"],
	}


