## Fleet redeploy day package (routes → station / fleet autonomy).
static func fleet_redeploy_day(
	candidates: Array = [],
	fuel_level: float = 0.65,
	origin_basing: String = "anchorage",
	province_id: int = 1,
) -> Dictionary:
	var cands: Array = candidates
	if cands.is_empty():
		cands = [
			{
				"province_id": province_id,
				"basing_level": "port",
				"fuel_level": fuel_level,
				"path_hostile_segments": 0,
				"path_length": 2,
				"zone_relation": "friendly",
				"origin_basing": origin_basing,
			},
			{
				"province_id": province_id + 1 if province_id > 0 else 2,
				"basing_level": "major_base",
				"fuel_level": fuel_level,
				"path_hostile_segments": 1,
				"path_length": 3,
				"zone_relation": "contested",
				"origin_basing": origin_basing,
			},
		]
	var plan: Dictionary = plan_fleet_redeploy_routes(cands, fuel_level, origin_basing)
	if bool(plan.get("empty", false)):
		return {"empty": true, "plain": "", "bbcode": "", "summary": "", "score": 0.0, "apply_queue": [], "actions": []}
	var raw_score := float(plan.get("best_score", plan.get("score", 50.0)))
	var score: float = clampf(raw_score / 100.0 if raw_score > 2.0 else raw_score, 0.05, 1.0)
	var best_pid := int(plan.get("best_province_id", province_id))
	if best_pid < 0:
		best_pid = province_id
	var fuel := clampf(fuel_level, 0.1, 1.2)
	var apply_ready := score >= 0.35 and fuel >= 0.25
	var apply_queue: Array = []
	if apply_ready:
		apply_queue.append({"action_id": "apply_station", "province_id": best_pid, "score": maxf(0.35, score), "enabled": true})
	if fuel < 0.55 or score < 0.45:
		apply_queue.append({"action_id": "fleet_autonomy", "province_id": best_pid, "score": maxf(0.3, 1.0 - fuel), "enabled": true})
	if apply_queue.is_empty():
		apply_queue.append({"action_id": "apply_station", "province_id": province_id, "score": 0.35, "enabled": true})
	var label := "Fleet redeploy day · best #%d · score %.2f · fuel %.0f%%" % [best_pid, score, fuel * 100.0]
	return {
		"plan": plan,
		"best_province_id": best_pid,
		"score": score,
		"fuel_level": fuel,
		"apply_ready": apply_ready,
		"apply_queue": apply_queue,
		"actions": [{"action_id": "fleet_redeploy_day", "label": "Run fleet redeploy day", "enabled": apply_ready}],
		"summary": label,
		"plain": label,
		"bbcode": "%s🚢 Fleet redeploy day[/color] %s— %s[/color]" % [COLOR_TECH, COLOR_MUTED, label],
		"empty": false,
		"integration": ["redeploy_route", "station", "fleet_autonomy"],
	}


## Fleet task group day package.
static func fleet_task_group_day(
	available_strength: float = 100.0,
	mission: String = "patrol",
	zone_relation: String = "contested",
	escort_need: float = 0.0,
	province_id: int = 1,
) -> Dictionary:
	var tg: Dictionary = compose_fleet_task_group(available_strength, mission, zone_relation, escort_need)
	if bool(tg.get("empty", false)):
		return {"empty": true, "plain": "", "bbcode": "", "summary": "", "score": 0.0, "apply_queue": [], "actions": []}
	var strength := maxf(0.0, float(tg.get("available_strength", available_strength)))
	var primary := str(tg.get("primary_role", "SCREEN"))
	var score: float = clampf(strength / 120.0 + 0.25, 0.05, 1.2)
	if zone_relation.strip_edges().to_lower() == "hostile":
		score = minf(1.2, score + 0.15)
	if escort_need >= 25.0:
		score = minf(1.2, score + 0.1)
	var apply_ready := strength >= 10.0
	var apply_queue: Array = []
	if apply_ready:
		apply_queue.append({"action_id": "apply_station", "province_id": province_id, "score": maxf(0.35, score), "enabled": true})
		apply_queue.append({"action_id": "fleet_autonomy", "province_id": province_id, "score": maxf(0.3, score * 0.9), "enabled": true})
	var mission_l := mission.strip_edges().to_lower()
	if mission_l in ["convoy", "escort", "cover"] or escort_need >= 20.0:
		apply_queue.append({"action_id": "apply_supply", "province_id": province_id, "score": 0.4, "enabled": true})
	if apply_queue.is_empty():
		apply_queue.append({"action_id": "apply_station", "province_id": province_id, "score": 0.35, "enabled": true})
	var label := "Fleet task group day · primary %s · strength %.0f · %s" % [primary, strength, mission_l]
	return {
		"task_group": tg,
		"primary_role": primary,
		"score": score,
		"apply_ready": apply_ready,
		"apply_queue": apply_queue,
		"actions": [{"action_id": "fleet_task_group_day", "label": "Run fleet task group day", "enabled": apply_ready}],
		"summary": label,
		"plain": label,
		"bbcode": "%s🚢 Fleet task group day[/color] %s— %s[/color]" % [COLOR_TECH, COLOR_MUTED, label],
		"empty": false,
		"integration": ["task_group", "station", "fleet_autonomy"],
	}


## Fleet campaign day compose (redeploy + task group).
static func fleet_campaign_day(
	candidates: Array = [],
	fuel_level: float = 0.65,
	origin_basing: String = "anchorage",
	available_strength: float = 100.0,
	mission: String = "patrol",
	zone_relation: String = "contested",
	escort_need: float = 0.0,
	province_id: int = 1,
) -> Dictionary:
	var redeploy: Dictionary = fleet_redeploy_day(candidates, fuel_level, origin_basing, province_id)
	var task: Dictionary = fleet_task_group_day(available_strength, mission, zone_relation, escort_need, province_id)
	var apply_queue: Array = []
	for block in [redeploy, task]:
		if not (block is Dictionary) or bool(block.get("empty", false)):
			continue
		for q in block.get("apply_queue", []):
			if q is Dictionary and bool(q.get("enabled", true)):
				apply_queue.append(q)
	var seen: Dictionary = {}
	var deduped: Array = []
	for q in apply_queue:
		if not (q is Dictionary):
			continue
		var key := "%s:%d:%s" % [str(q.get("action_id", "")), int(q.get("province_id", -1)), str(q.get("focus_id", ""))]
		if seen.has(key):
			continue
		seen[key] = true
		deduped.append(q)
	if deduped.size() > 8:
		deduped = deduped.slice(0, 8)
	var r_score := 0.0 if bool(redeploy.get("empty", false)) else float(redeploy.get("score", 0.0))
	var t_score := 0.0 if bool(task.get("empty", false)) else float(task.get("score", 0.0))
	var score: float = (r_score + t_score) / 2.0
	var label := "Fleet campaign day · redeploy %.2f · task %.2f · q %d" % [r_score, t_score, deduped.size()]
	return {
		"redeploy": redeploy,
		"task_group": task,
		"apply_queue": deduped,
		"score": score,
		"actions": [{"action_id": "fleet_campaign_day", "label": "Run fleet campaign day", "enabled": not deduped.is_empty()}],
		"summary": label,
		"plain": "\n".join([label, str(redeploy.get("summary", "")), str(task.get("summary", ""))]),
		"bbcode": "%s⚓ Fleet campaign day[/color] %s— %s[/color]" % [COLOR_HEADER, COLOR_MUTED, label],
		"empty": false,
		"integration": ["fleet_redeploy", "fleet_task_group"],
	}


