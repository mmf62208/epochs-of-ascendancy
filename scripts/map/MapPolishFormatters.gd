## Weather forecast planning day.
static func weather_forecast_planning_day(
	temp: float = 10.0,
	precip: float = 0.0,
	visibility: float = 1.0,
	wind: float = 0.2,
	ground_state: String = "dry",
) -> Dictionary:
	# Deterministic next-day stub (mirrors forecast_next_day)
	var next_precip := clampf(precip * 0.7 + (0.15 if precip > 0.5 else 0.0), 0.0, 1.0)
	var next_vis := clampf(visibility * 0.85 + 0.15 * (1.0 - next_precip), 0.1, 1.0)
	var combat_m := clampf(1.0 - next_precip * 0.35 + (next_vis - 1.0) * 0.2, 0.35, 1.15)
	var supply_m := clampf(1.0 - next_precip * 0.25, 0.4, 1.1)
	var recommend_wait := next_precip > 0.45 or combat_m < 0.75
	var score := (combat_m * 0.5 + supply_m * 0.5) * (0.8 if recommend_wait else 1.0)
	var label := "Forecast planning day · combat×%.2f · supply×%.2f · wait=%s" % [
		combat_m, supply_m, "yes" if recommend_wait else "no"
	]
	return {
		"combat_mult": combat_m,
		"supply_mult": supply_m,
		"recommend_wait": recommend_wait,
		"best_day": 1 if recommend_wait else 0,
		"score": score,
		"apply_ready": not recommend_wait,
		"actions": [
			{"action_id": "apply_supply", "label": "Sustain supply (go window)", "enabled": not recommend_wait},
			{"action_id": "apply_assault", "label": "Stage assault (go weather)", "enabled": (not recommend_wait) and combat_m >= 0.7},
			{"action_id": "apply_focus", "label": "Hold focus through weather", "enabled": recommend_wait, "focus_id": "industrial_effort"},
		],
		"summary": label,
		"plain": label,
		"bbcode": "%s📅 Forecast day[/color] %s— %s[/color]" % [COLOR_HEADER, COLOR_MUTED, label],
		"empty": false,
	}


## Reinforced assault day.
static func reinforced_assault_day(
	targets: Array = [],
	attacker_power: float = 100.0,
	attacker_supply: float = 0.85,
	visibility: float = 1.0,
	precip: float = 0.0,
	ground_state: String = "dry",
	wind: float = 0.2,
	month: int = 6,
	is_choke: bool = false,
	max_targets: int = 3,
) -> Dictionary:
	if targets.is_empty():
		return {"empty": true, "plain": "", "bbcode": "", "summary": "", "score": 0.0, "apply_queue": [], "actions": []}
	var reinforced: Dictionary = reinforced_assault_loop(
		targets, attacker_power, attacker_supply, visibility, precip, ground_state, wind, month, is_choke, true
	)
	var fronts: Dictionary = {"empty": true, "apply_queue": [], "score": 0.0}
	var r_score := float(reinforced.get("score", 0.5))
	if r_score > 2.0:
		r_score = clampf(r_score, 0.05, 1.0)
	var f_score := 0.0
	var score := r_score
	var apply_queue: Array = []
	# Build queue directly from targets
	var n := 0
	for t in targets:
		if n >= max_targets:
			break
		if not (t is Dictionary):
			continue
		var pid := int(t.get("province_id", t.get("id", -1)))
		if pid < 0:
			continue
		if r_score >= 0.35:
			apply_queue.append({
				"province_id": pid,
				"action_id": "apply_assault",
				"score": r_score,
				"enabled": true,
			})
			n += 1
	if apply_queue.is_empty() and bool(reinforced.get("empty", false)):
		return {"empty": true, "plain": "", "bbcode": "", "summary": "", "score": 0.0, "apply_queue": [], "actions": []}
	var label := "Reinforced assault day · score %.0f%% · queue %d" % [score * 100.0, apply_queue.size()]
	return {
		"reinforced": reinforced,
		"multi_front": fronts,
		"apply_queue": apply_queue,
		"score": score,
		"actions": [{"action_id": "reinforced_assault_day", "label": "Stage reinforced assaults", "enabled": not apply_queue.is_empty()}],
		"summary": label,
		"plain": label,
		"bbcode": "%s⚔ Reinforced day[/color] %s— %s[/color]" % [COLOR_HEADER, COLOR_MUTED, label],
		"empty": apply_queue.is_empty() and bool(reinforced.get("empty", false)),
	}


## Air + forecast + assault compose.
static func air_forecast_assault_day(
	visibility: float = 1.0,
	precip: float = 0.0,
	wind: float = 0.2,
	month: int = 6,
	targets: Array = [],
) -> Dictionary:
	var air: Dictionary = air_ops_day_package(visibility, precip, wind, month)
	var forecast: Dictionary = weather_forecast_planning_day(10.0, precip, visibility, wind, "dry")
	var tgts: Array = targets
	if tgts.is_empty():
		tgts = [{"province_id": 10, "defender_power": 65.0}, {"province_id": 20, "defender_power": 90.0}]
	var assault: Dictionary = reinforced_assault_day(tgts, 100.0, 0.85, visibility, precip, "dry", wind, month, false, 3)
	var apply_queue: Array = []
	if not bool(forecast.get("recommend_wait", false)):
		if bool(air.get("apply_ready", false)):
			apply_queue.append({"action_id": "apply_assault", "province_id": int(tgts[0].get("province_id", 10)), "score": float(air.get("score", 0.5))})
		for q in assault.get("apply_queue", []):
			if q is Dictionary and bool(q.get("enabled", true)):
				apply_queue.append(q)
	else:
		apply_queue.append({"action_id": "apply_focus", "province_id": 1, "score": 0.4, "focus_id": "industrial_effort"})
	if apply_queue.size() > 6:
		apply_queue = apply_queue.slice(0, 6)
	var score := (float(air.get("score", 0.5)) + float(forecast.get("score", 0.5)) + float(assault.get("score", 0.0))) / 3.0
	var label := "Air-forecast assault day · air %.2f · wait=%s · assault_q %d" % [
		float(air.get("score", 0.0)),
		str(forecast.get("recommend_wait", false)),
		(assault.get("apply_queue", []) as Array).size() if assault.get("apply_queue") is Array else 0,
	]
	return {
		"air": air,
		"forecast": forecast,
		"assault": assault,
		"apply_queue": apply_queue,
		"score": score,
		"actions": [{"action_id": "air_forecast_day", "label": "Run air-forecast assault day", "enabled": not apply_queue.is_empty()}],
		"summary": label,
		"plain": label,
		"bbcode": "%s✈📅 Air-forecast day[/color] %s— %s[/color]" % [COLOR_HEADER, COLOR_MUTED, label],
		"empty": false,
	}


## Sealane/choke logistics day package.
static func sealane_choke_logistics_day(
	sea_trade_mult: float = 1.0,
	escort_coverage: float = 0.9,
	precip: float = 0.0,
	visibility: float = 1.0,
	is_choke: bool = true,
	friendly: bool = true,
	fuel_level: float = 0.65,
	basing_level: String = "port",
) -> Dictionary:
	var sealane: Dictionary = sealane_joint_health(sea_trade_mult, escort_coverage, precip > 0.5, "dry", precip, 0.1)
	var choke: Dictionary = choke_sea_weather_package(is_choke, friendly, sea_trade_mult, visibility, precip)
	var basing: Dictionary = basing_fleet_fuel_logistics(basing_level, fuel_level, 80.0, "contested", "patrol", visibility, precip)
	var s_score := float(sealane.get("score", 0.5))
	var c_score := clampf(float(choke.get("combined_score", choke.get("score", 0.7))), 0.1, 1.5)
	var b_score := float(basing.get("logistics_score", basing.get("score", 0.4)))
	if b_score > 2.0:
		b_score = clampf(b_score, 0.05, 1.2)
	var score := s_score * 0.4 + minf(1.0, c_score) * 0.3 + minf(1.0, b_score) * 0.3
	var apply_ready := fuel_level >= 0.2 and precip <= 0.75
	var label := "Sealane/choke logistics day · sealane %.2f · choke %.2f · basing %.2f" % [s_score, minf(1.0, c_score), minf(1.0, b_score)]
	return {
		"sealane": sealane,
		"choke": choke,
		"basing": basing,
		"score": score,
		"apply_ready": apply_ready,
		"actions": [
			{"action_id": "apply_supply", "label": "Sustain sealane supply", "enabled": apply_ready},
			{"action_id": "apply_station", "label": "Station for basing/refuel", "enabled": true},
			{"action_id": "fleet_autonomy", "label": "Fleet logistics posture", "enabled": true},
		],
		"summary": label,
		"plain": label,
		"bbcode": "%s🌊 Logistics day[/color] %s— %s[/color]" % [COLOR_HEADER, COLOR_MUTED, label],
		"empty": false,
	}


## Leader-formation station day ranking.
static func leader_formation_station_day(
	station_specs: Array = [],
	leader_skill: float = 0.55,
	visibility: float = 1.0,
	precip: float = 0.0,
	max_stations: int = 3,
) -> Dictionary:
	if station_specs.is_empty():
		return {"empty": true, "plain": "", "bbcode": "", "summary": "", "score": 0.0, "apply_queue": [], "actions": []}
	var ground := "mud" if precip > 0.45 else "dry"
	var leader: Dictionary = leader_weather_assign(leader_skill, ground, visibility, false)
	var move_eff := float(leader.get("effective_move", 1.0))
	var scored: Array = []
	for s in station_specs:
		if not (s is Dictionary):
			continue
		var pid := int(s.get("province_id", s.get("id", -1)))
		if pid < 0:
			continue
		var basing := str(s.get("basing_level", s.get("level", "port")))
		var fuel := float(s.get("fuel_level", 0.6))
		var basing_pkg: Dictionary = basing_fleet_fuel_logistics(basing, fuel, 80.0, "contested", "patrol", visibility, precip)
		var log_s := float(basing_pkg.get("logistics_score", basing_pkg.get("score", 0.4)))
		if log_s > 2.0:
			log_s = clampf(log_s, 0.05, 1.0)
		var sc := log_s * (0.7 + 0.3 * move_eff) * (0.6 + 0.4 * clampf(fuel, 0.15, 1.0))
		scored.append({
			"province_id": pid,
			"basing_level": basing,
			"fuel_level": fuel,
			"score": sc,
			"action_id": "apply_station",
			"enabled": fuel >= 0.15,
		})
	scored.sort_custom(func(a, b): return float(a.get("score", 0.0)) > float(b.get("score", 0.0)))
	if scored.size() > max_stations:
		scored = scored.slice(0, max_stations)
	if scored.is_empty():
		return {"empty": true, "plain": "", "bbcode": "", "summary": "", "score": 0.0, "apply_queue": [], "actions": []}
	var mean := 0.0
	for q in scored:
		mean += float(q.get("score", 0.0))
	mean /= float(maxi(scored.size(), 1))
	var label := "Leader-formation station day · %d stations · leader×wx %.2f · score %.2f" % [scored.size(), move_eff, mean]
	return {
		"leader": leader,
		"apply_queue": scored,
		"score": mean,
		"actions": [{"action_id": "leader_station_day", "label": "Apply leader station day", "enabled": true}],
		"summary": label,
		"plain": label,
		"bbcode": "%s★ Station day[/color] %s— %s[/color]" % [COLOR_HEADER, COLOR_MUTED, label],
		"empty": false,
	}


## Full logistics day package.
static func logistics_day_package(
	sea_trade_mult: float = 1.0,
	precip: float = 0.0,
	visibility: float = 1.0,
