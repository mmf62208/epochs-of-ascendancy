static func occupation_revolt_garrison_product(province_id: int = 1, resistance_level: float = 0.55, compliance_level: float = 0.40, garrison_strength: float = 0.45, mode: String = "standard") -> Dictionary:
	var m := mode.strip_edges().to_lower()
	if m not in ["light", "standard", "heavy"]:
		m = "standard"
	var mode_mult := 1.0
	match m:
		"light": mode_mult = 0.7
		"heavy": mode_mult = 1.35
	var r := clampf(resistance_level if resistance_level <= 2.0 else resistance_level / 100.0, 0.0, 1.0)
	var c := clampf(compliance_level if compliance_level <= 2.0 else compliance_level / 100.0, 0.0, 1.0)
	var g := clampf(garrison_strength if garrison_strength <= 2.0 else garrison_strength / 100.0, 0.0, 1.0)
	var g_eff := clampf(g * mode_mult, 0.0, 1.0)
	var flashpoint := clampf(0.55 * r + 0.25 * (1.0 - c) - 0.35 * g_eff + 0.15, 0.0, 1.0)
	var suppress_power := clampf(0.4 * g_eff + 0.35 * c + 0.25 * (1.0 - r), 0.35, 1.0)
	var occ: Dictionary = occupation_resistance_compliance_product(province_id, r, c, "moderate")
	var board_score := clampf(0.5 * float(occ.get("score", 0.5)) + 0.5 * (1.0 - flashpoint), 0.35, 1.0)
	var garrison_score := clampf(0.4 + 0.5 * g_eff, 0.35, 1.0)
	var suppress_score := clampf(0.45 * suppress_power + 0.55 * garrison_score, 0.35, 1.0)
	var score := clampf(0.3 * board_score + 0.35 * garrison_score + 0.35 * suppress_score, 0.35, 1.0)
	var rec := {"step": "suppress", "action_id": "occupation_revolt_suppress", "leaf": "apply_assault", "summary": "Recommend suppress", "empty": false}
	var day_rows: Array = [
		{"step": "board", "action_id": "occupation_revolt_board", "leaf": "apply_station", "label": "Step 0 — revolt risk board", "score": board_score},
		{"step": "garrison", "action_id": "occupation_revolt_garrison", "leaf": "apply_station", "label": "Step 1 — deploy garrison", "score": garrison_score},
		{"step": "suppress", "action_id": "occupation_revolt_suppress", "leaf": "apply_assault", "label": "Step 2 — suppress/resolve flashpoint", "score": suppress_score},
	]
	var apply_queue: Array = []
	for row in day_rows:
		apply_queue.append({"action_id": str(row.get("leaf")), "province_id": province_id, "score": float(row.get("score", 0.5)), "enabled": true, "label": str(row.get("label")), "step": str(row.get("step")), "product_action": str(row.get("action_id"))})
	var label := "Occupation revolt/garrison · flash %.0f%% · mode %s · score %.2f" % [flashpoint * 100.0, m, score]
	return {
		"recommendation": rec, "day_rows": day_rows, "apply_queue": apply_queue,
		"actions": [{"action_id": "occupation_revolt_garrison_product", "label": "Run occupation revolt/garrison product", "enabled": true}, {"action_id": "occupation_revolt_suppress", "label": "Recommended: suppress", "enabled": true}],
		"flashpoint": flashpoint, "garrison_mode": m, "garrison_effective": g_eff, "suppress_power": suppress_power,
		"resolved": flashpoint < 0.45 and suppress_power >= 0.5, "score": score, "revolt_score": score, "province_id": province_id,
		"summary": label, "plain": label, "bbcode": "[color=#d07060]⚔ Revolt/garrison[/color] [color=#8899aa]%s[/color]" % label,
		"empty": false, "integration": ["occupation_revolt_garrison_product", "occupation_revolt_board", "occupation_revolt_garrison", "occupation_revolt_suppress", "major_35", "phase4_depth"],
	}

static func execute_occupation_revolt_step(step: String = "board", province_id: int = 1) -> Dictionary:
	var s := step.strip_edges().to_lower().replace("occupation_revolt_", "")
	if s.begins_with("board"): s = "board"
	elif s.begins_with("garrison"): s = "garrison"
	elif s.begins_with("suppress") or s.begins_with("resolve"): s = "suppress"
	else: s = "board"
	var product: Dictionary = occupation_revolt_garrison_product(province_id)
	var leaf := "apply_station"
	var action_id := "occupation_revolt_board"
