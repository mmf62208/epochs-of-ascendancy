static func recommend_logistics_step(route_score: float = 0.5, sustain_score: float = 0.5, ready: bool = false) -> Dictionary:
	var step := "sustain"
	var reason := "refresh sustain"
	if route_score < 0.45:
		step = "route"
		reason = "route health low — re-audit supply"
	elif sustain_score < 0.45:
		step = "sustain"
		reason = "basing/fuel thin — sustain"
	elif ready:
		step = "readiness"
		reason = "spine ready — push force readiness"
	var action_id := "logistics_supply_route"
	var leaf := "apply_supply"
	match step:
		"sustain":
			action_id = "logistics_supply_sustain"
			leaf = "apply_station"
		"readiness":
			action_id = "logistics_supply_readiness"
			leaf = "apply_production"
	return {"step": step, "action_id": action_id, "leaf": leaf, "reason": reason, "empty": false, "summary": "Recommend %s · %s" % [step, reason]}

static func logistics_supply_theater_product(province_id: int = 1) -> Dictionary:
	var supply: Dictionary = supply_route_mutation_day(province_id)
	var trade: Dictionary = trade_chain_day(1.0, province_id)
	var economy: Dictionary = war_economy_day_package(10.0, 0.3, "mud", 0.7, 0.3)
	var ready: Dictionary = force_readiness_day(80.0, 0.85, 0.7, 0.3, "mud", 0.3, 6, 80.0, province_id)
	var fleet: Dictionary = fleet_multi_day_autonomy_product(0.6, "port", "contested", 100.0, "GER", province_id)
	var route_score := clampf(0.55 * float(supply.get("score", 0.5)) + 0.45 * float(trade.get("score", 0.5)), 0.0, 1.0)
	if route_score < 0.35:
		route_score = 0.35
	var sustain_score := clampf(0.45 * float(fleet.get("score", 0.5)) + 0.55 * float(economy.get("score", 0.5)), 0.0, 1.0)
	if sustain_score < 0.35:
		sustain_score = 0.35
	var ready_score := clampf(0.55 * float(ready.get("score", 0.5)) + 0.45 * route_score, 0.0, 1.0)
	if ready_score < 0.35:
		ready_score = 0.35
	var score := clampf(0.35 * route_score + 0.35 * sustain_score + 0.3 * ready_score, 0.0, 1.0)
	if score < 0.35:
		score = 0.35
	var rec: Dictionary = recommend_logistics_step(route_score, sustain_score, ready_score >= 0.45 and route_score >= 0.45)
	var steps: Array = [
		{"step": "route", "action_id": "logistics_supply_route", "leaf": "apply_supply", "label": "Step 0 — supply route audit", "score": route_score},
		{"step": "sustain", "action_id": "logistics_supply_sustain", "leaf": "apply_station", "label": "Step 1 — basing/fuel sustain", "score": sustain_score},
		{"step": "readiness", "action_id": "logistics_supply_readiness", "leaf": "apply_production", "label": "Step 2 — force readiness joint", "score": ready_score},
	]
	var day_rows: Array = []
	var apply_queue: Array = []
	for i in range(steps.size()):
		var st: Dictionary = steps[i]
		var step_name := str(st.get("step"))
		var recommended: bool = step_name == str(rec.get("step"))
		var sc := float(st.get("score", 0.5))
		var leaf := str(st.get("leaf"))
		var lab := str(st.get("label"))
		if recommended:
			lab = "★ " + lab
		lab = "%s · score %.2f" % [lab, sc]
		day_rows.append({"index": i, "step": step_name, "action_id": str(st.get("action_id")), "leaf_action": leaf, "label": lab, "score": sc, "enabled": true, "recommended": recommended, "province_id": province_id})
		apply_queue.append({"action_id": leaf, "province_id": province_id, "score": sc, "enabled": true, "label": lab, "step": step_name, "product_action": str(st.get("action_id"))})
	var actions: Array = [
		{"action_id": "logistics_supply_theater_product", "label": "Run logistics supply theater product", "enabled": true},
		{"action_id": str(rec.get("action_id", "logistics_supply_route")), "label": "Recommended: %s" % str(rec.get("step", "route")), "enabled": true},
	]
	for row2 in day_rows:
		actions.append({"action_id": str(row2.get("action_id")), "label": str(row2.get("label")), "enabled": true, "step": str(row2.get("step"))})
	var label := "Logistics supply theater · route %.2f · sustain %.2f · ready %.2f · score %.2f" % [route_score, sustain_score, ready_score, score]
	return {
		"supply": supply, "trade": trade, "economy": economy, "ready": ready, "fleet": fleet,
		"route_score": route_score, "sustain_score": sustain_score, "ready_score": ready_score,
		"recommendation": rec, "day_rows": day_rows, "apply_queue": apply_queue, "actions": actions,
		"score": score, "logistics_score": score, "province_id": province_id,
		"summary": label, "plain": label,
		"bbcode": "%s📦 Logistics theater[/color] %s— %s[/color]" % [COLOR_HEADER, COLOR_MUTED, label],
		"empty": false,
		"integration": ["logistics_supply_theater_product", "logistics_supply_route", "logistics_supply_sustain", "logistics_supply_readiness", "major_18", "logistics", "supply"],
	}

static func execute_logistics_supply_step(step: String = "route", province_id: int = 1) -> Dictionary:
	var s := step.strip_edges().to_lower()
	if s.begins_with("logistics_supply_"):
		s = s.replace("logistics_supply_", "")
	if s not in ["route", "sustain", "readiness"]:
		s = "route"
	var product: Dictionary = logistics_supply_theater_product(province_id)
	var row: Dictionary = {}
	for r in product.get("day_rows", []):
		if r is Dictionary and str(r.get("step")) == s:
			row = r
			break
	var leaf := str(row.get("leaf_action", "apply_supply"))
	var action_id := "logistics_supply_route"
	match s:
		"sustain":
			action_id = "logistics_supply_sustain"
		"readiness":
			action_id = "logistics_supply_readiness"
	var score := float(row.get("score", product.get("score", 0.5)))
	var apply_queue: Array = [{"action_id": leaf, "province_id": province_id, "score": score, "enabled": true, "label": str(row.get("label", s)), "step": s, "product_action": action_id}]
	var label := "Execute logistics %s · leaf %s · score %.2f" % [s, leaf, score]
	return {"step": s, "leaf_action": leaf, "action_id": action_id, "apply_queue": apply_queue, "score": score, "province_id": province_id, "summary": label, "plain": label, "bbcode": "%s📦 Logistics %s[/color] %s— %s[/color]" % [COLOR_HEADER, s, COLOR_MUTED, label], "empty": false, "ok": true, "integration": ["execute_logistics_supply_step", s, leaf]}

