static func play_session_campaign_close_day(province_id: int = 1) -> Dictionary:
	var p0: Dictionary = air_convoy_campaign_close_day(province_id)
	var p1: Dictionary = focus_intel_leader_close_day(province_id)
	var p2: Dictionary = order_execute_session_day(province_id)
	var p3: Dictionary = next_day_feedback_session_day(province_id)
	var p4: Dictionary = campaign_decision_session_day(province_id)
	var p5: Dictionary = theater_ai_session_joint_day(province_id)
	var p6: Dictionary = force_readiness_session_day(province_id)
	var non_empty := 0
	var sum_sc := 0.0
	for p in [p0, p1, p2, p3, p4, p5, p6]:
		if p is Dictionary and not bool(p.get("empty", true)):
			non_empty += 1
			sum_sc += float(p.get("score", 0))
	var avg := sum_sc / float(maxi(1, non_empty))
	var ok: bool = non_empty >= 7
	var score := clampf(0.55 * avg + 0.45 * (1.0 if ok else 0.3), 0.0, 1.0)
	if score < 0.35:
		score = 0.35
	var apply_queue: Array = [
		{"action_id": "apply_focus", "province_id": province_id, "score": score, "enabled": true, "label": "Play session campaign close focus"},
		{"action_id": "apply_production", "province_id": province_id, "score": 0.55, "enabled": true, "label": "Play session campaign close production"},
		{"action_id": "apply_assault", "province_id": province_id, "score": 0.5, "enabled": true, "label": "Play session campaign close assault"},
		{"action_id": "apply_station", "province_id": province_id, "score": 0.45, "enabled": true, "label": "Play session campaign close fleet"},
	]
	var label := "Play session campaign close · pillars %d/7 · gates %s · score %.2f" % [non_empty, "PASS" if ok else "FAIL", score]
	return {
		"ok": ok, "session_score": score, "score": score, "apply_queue": apply_queue,
		"actions": [{"action_id": "play_session_campaign_close_day", "label": "Run play session campaign close day", "enabled": true}],
		"summary": label, "plain": label,
		"bbcode": "%s✓ Play session campaign close[/color] %s— %s[/color]" % [COLOR_HEADER, COLOR_MUTED, label],
		"empty": false, "integration": ["play_session", "campaign", "close", "next300"],
	}

