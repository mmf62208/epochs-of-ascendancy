static func budget_ai_day_actions(factions: Array, player_tag: String = "", max_actions: int = 4, province_id: int = 1) -> Dictionary:
	var player := player_tag.strip_edges().to_upper()
	var ranked: Array = []
	for f in factions:
		if not (f is Dictionary):
			continue
		var tag := str(f.get("tag", "")).to_upper()
		if tag.is_empty():
			continue
		if not player.is_empty() and tag == player:
			continue
		ranked.append(f)
	ranked.sort_custom(func(a, b): return float(a.get("urgency", 0)) > float(b.get("urgency", 0)))
	var cap := maxi(1, max_actions)
	var selected: Array = ranked.slice(0, mini(cap, ranked.size())) if not ranked.is_empty() else []
	var queue: Array = []
	for f2 in selected:
		if f2 is Dictionary:
			queue.append({
				"action_id": str(f2.get("top_leaf", "apply_station")), "province_id": province_id,
				"score": float(f2.get("urgency", 0.5)), "enabled": true,
				"label": "AI day · %s · %s" % [str(f2.get("tag")), str(f2.get("top_domain"))],
				"faction": str(f2.get("tag", "")), "domain": str(f2.get("top_domain", "")),
				"product_action": "strategic_ai_daily_apply", "step": "apply_ai",
			})
	var label := "AI day budget · selected %d · skipped_player %s · pool %d" % [
		selected.size(), player if not player.is_empty() else "—", ranked.size()
	]
	return {
		"queue": queue, "selected": selected, "selected_count": selected.size(),
		"pool_count": ranked.size(), "player_tag": player, "max_actions": cap,
		"summary": label, "plain": label, "empty": selected.is_empty(),
		"score": clampf(0.4 + 0.1 * float(selected.size()), 0.35, 1.0),
	}

static func recommend_strategic_ai_daily_step(faction_count: int, budget_count: int = 0, apply_ready: bool = false) -> Dictionary:
	var step := "budget"
	var reason := "refresh AI budget"
	if faction_count <= 0:
		step = "board"
		reason = "empty board — scan majors"
	elif budget_count <= 0:
		step = "budget"
		reason = "build AI day budget"
	elif apply_ready:
		step = "apply_ai"
		reason = "apply budgeted AI actions"
	var action_id := "strategic_ai_daily_board"
	var leaf := "apply_focus"
	match step:
		"budget":
			action_id = "strategic_ai_daily_budget"
			leaf = "apply_station"
		"apply_ai":
			action_id = "strategic_ai_daily_apply"
			leaf = "apply_assault"
	return {
		"step": step, "action_id": action_id, "leaf": leaf, "reason": reason, "empty": false,
		"summary": "Recommend %s · %s" % [step, reason],
	}

static func strategic_ai_daily_campaign_product(
	province_id: int = 1,
	player_tag: String = "GER",
	max_ai_actions: int = 4,
) -> Dictionary:
	var board: Dictionary = multi_faction_strategic_ai_product([], province_id, 7)
	var factions: Array = board.get("factions", [])
	var budget: Dictionary = budget_ai_day_actions(factions, player_tag, max_ai_actions, province_id)
	var faction_count := int(board.get("faction_count", factions.size()))
	var budget_count := int(budget.get("selected_count", 0))
	var apply_ready: bool = budget_count > 0
	var rec: Dictionary = recommend_strategic_ai_daily_step(faction_count, budget_count, apply_ready)
	var score := clampf(
		0.4 * float(board.get("score", 0.55))
		+ 0.35 * minf(1.0, float(budget_count) / float(maxi(1, max_ai_actions)))
		+ 0.25 * minf(1.0, float(faction_count) / 7.0),
		0.0, 1.0
	)
	if score < 0.35 and faction_count > 0:
		score = 0.35
	var step_scores := {
		"board": clampf(0.45 + 0.05 * float(mini(7, faction_count)), 0.35, 1.0),
		"budget": clampf(0.4 + 0.12 * float(mini(4, budget_count)), 0.35, 1.0),
		"apply_ai": clampf(0.5 + 0.1 * float(mini(4, budget_count)), 0.35, 1.0),
	}
	var top_leaf := str(board.get("top_leaf", "apply_assault"))
	var steps: Array = [
		{"step": "board", "action_id": "strategic_ai_daily_board", "leaf": "apply_focus", "label": "Step 0 — multi-faction AI board"},
		{"step": "budget", "action_id": "strategic_ai_daily_budget", "leaf": "apply_station", "label": "Step 1 — budget AI day actions"},
		{"step": "apply_ai", "action_id": "strategic_ai_daily_apply", "leaf": top_leaf, "label": "Step 2 — apply budgeted AI actions"},
	]
	var day_rows: Array = []
	var apply_queue: Array = []
	for i in range(steps.size()):
		var st: Dictionary = steps[i]
		var step_name := str(st.get("step"))
		var recommended: bool = step_name == str(rec.get("step"))
		var sc := float(step_scores.get(step_name, 0.5))
		var leaf := str(st.get("leaf"))
		if step_name == "apply_ai" and budget.get("queue") is Array and not (budget["queue"] as Array).is_empty():
			var q0 = (budget["queue"] as Array)[0]
			if q0 is Dictionary:
				leaf = str(q0.get("action_id", leaf))
		var lab := str(st.get("label"))
		if recommended:
			lab = "★ " + lab
		lab = "%s · factions %d · budget %d · score %.2f" % [lab, faction_count, budget_count, sc]
		var row := {
			"index": i, "step": step_name, "action_id": str(st.get("action_id")),
			"leaf_action": leaf, "label": lab, "score": sc,
			"enabled": faction_count > 0 or step_name == "board",
			"recommended": recommended, "province_id": province_id,
		}
		day_rows.append(row)
		apply_queue.append({
			"action_id": leaf, "province_id": province_id, "score": sc,
			"enabled": bool(row.get("enabled")), "label": lab, "step": step_name,
			"product_action": str(st.get("action_id")),
		})
	if budget.get("queue") is Array:
		for q in budget["queue"]:
			if q is Dictionary:
				apply_queue.append(q)
	var actions: Array = [
		{"action_id": "strategic_ai_daily_campaign_product", "label": "Run strategic AI daily campaign product", "enabled": true},
		{"action_id": str(rec.get("action_id", "strategic_ai_daily_board")), "label": "Recommended: %s" % str(rec.get("step", "board")), "enabled": true},
		{"action_id": "multi_faction_strategic_ai_product", "label": "Open multi-faction AI board", "enabled": true},
	]
	for row2 in day_rows:
		actions.append({"action_id": str(row2.get("action_id")), "label": str(row2.get("label")), "enabled": bool(row2.get("enabled")), "step": str(row2.get("step"))})
	var label := "Strategic AI daily campaign · majors %d · AI budget %d · player %s · top %s · score %.2f" % [
		faction_count, budget_count, player_tag if not player_tag.is_empty() else "—",
		str(board.get("top_faction", "—")), score
	]
	var plain_lines: PackedStringArray = [label, str(rec.get("summary", "")), str(board.get("summary", "")), str(budget.get("summary", ""))]
	for ln in board.get("board_lines", []):
		plain_lines.append(str(ln))
	for row3 in day_rows:
		plain_lines.append(str(row3.get("label", "")))
	return {
		"board": board, "budget": budget, "factions": factions, "faction_count": faction_count,
		"budget_count": budget_count, "player_tag": player_tag.strip_edges().to_upper(),
		"top_faction": str(board.get("top_faction", "")), "top_domain": str(board.get("top_domain", "")),
		"recommendation": rec, "day_rows": day_rows, "apply_queue": apply_queue, "actions": actions,
		"score": score, "ai_day_score": score, "province_id": province_id, "apply_ready": apply_ready,
		"summary": label, "plain": "\n".join(plain_lines),
		"bbcode": "%s♟ Strategic AI daily[/color] %s— %s[/color]" % [COLOR_HEADER, COLOR_MUTED, label],
		"empty": faction_count <= 0,
		"integration": ["strategic_ai_daily_campaign_product", "strategic_ai_daily_board", "strategic_ai_daily_budget", "strategic_ai_daily_apply", "major_11", "strategic_ai", "daily_campaign"],
	}

static func execute_strategic_ai_daily_step(step: String = "board", province_id: int = 1, player_tag: String = "GER", max_ai_actions: int = 4) -> Dictionary:
	var s := step.strip_edges().to_lower()
	if s.begins_with("strategic_ai_daily_"):
		s = s.replace("strategic_ai_daily_", "")
	if s == "apply":
		s = "apply_ai"
	if s not in ["board", "budget", "apply_ai"]:
		s = "board"
	var product: Dictionary = strategic_ai_daily_campaign_product(province_id, player_tag, max_ai_actions)
	var row: Dictionary = {}
	for r in product.get("day_rows", []):
		if r is Dictionary and str(r.get("step")) == s:
			row = r
			break
	var leaf := str(row.get("leaf_action", "apply_focus"))
	var action_id := "strategic_ai_daily_board"
	match s:
		"budget":
			action_id = "strategic_ai_daily_budget"
		"apply_ai":
			action_id = "strategic_ai_daily_apply"
	var score := float(row.get("score", product.get("score", 0.5)))
	var apply_queue: Array = [{
		"action_id": leaf, "province_id": province_id, "score": score, "enabled": true,
		"label": str(row.get("label", s)), "step": s, "product_action": action_id,
	}]
	if s == "apply_ai":
		var bq = product.get("budget", {}).get("queue", [])
		if bq is Array and not bq.is_empty():
			apply_queue = bq
	var label := "Execute AI daily %s · leaf %s · budget %d · score %.2f" % [
		s, leaf, int(product.get("budget_count", 0)), score
	]
	return {
		"step": s, "leaf_action": leaf, "action_id": action_id, "apply_queue": apply_queue,
		"score": score, "province_id": province_id, "summary": label, "plain": label,
		"bbcode": "%s♟ AI daily %s[/color] %s— %s[/color]" % [COLOR_HEADER, s, COLOR_MUTED, label],
		"empty": false, "ok": true,
		"integration": ["execute_strategic_ai_daily_step", s, leaf],
	}

