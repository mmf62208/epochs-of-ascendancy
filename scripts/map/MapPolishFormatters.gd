	var pref := preferred.strip_edges().to_lower()
	if pref.is_empty():
		pref = "armor"
	var res := clampf(float(resource_level), 0.0, 1.0)
	var months := clampi(months_ahead, 1, 24)
	var surface_keys: PackedStringArray = [
		"research_primary_open_queue", "research_primary_enqueue_branch",
		"research_primary_gate_check", "research_primary_advance_month", "research_primary_close",
