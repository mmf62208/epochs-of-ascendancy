static func recommend_resume_slot(rows: Array) -> Dictionary:
	var occupied: Array = []
	for r in rows:
		if r is Dictionary and bool(r.get("occupied", false)):
			occupied.append(r)
	if occupied.is_empty():
		return {"slot": "", "action_id": "", "empty": true, "summary": "No occupied slot to resume", "can_load": false}
	# Prefer later labels (timestamp-ish); last occupied is fine when no metadata sort
	var best: Dictionary = occupied[occupied.size() - 1]
	var best_ts := ""
	for r2 in occupied:
		var meta: Dictionary = r2.get("metadata", {}) if r2.get("metadata") is Dictionary else {}
		var ts := str(meta.get("timestamp", meta.get("last_played", "")))
		if ts >= best_ts:
			best_ts = ts
			best = r2
	var slot := str(best.get("slot", "")).strip_edges()
	return {
		"slot": slot,
		"action_id": "load_slot:%s" % slot if not slot.is_empty() else "",
		"label": str(best.get("flair_label", best.get("label", slot))),
		"can_load": bool(best.get("can_load", true)),
		"empty": false,
		"summary": "Resume · %s" % str(best.get("label", slot)),
		"row": best,
	}

static func recommend_checkpoint_slot(rows: Array) -> Dictionary:
	var by_slot: Dictionary = {}
	for r in rows:
		if r is Dictionary:
			by_slot[str(r.get("slot", ""))] = r
	var slot := "autosave"
	if not by_slot.has("autosave"):
		slot = "quicksave"
		for r2 in rows:
			if r2 is Dictionary and not bool(r2.get("occupied", false)):
				slot = str(r2.get("slot", "quicksave"))
				break
	var row: Dictionary = by_slot.get(slot, {"slot": slot, "occupied": false, "can_save": true})
	return {
		"slot": slot,
		"action_id": "save_slot:%s" % slot,
		"label": str(row.get("flair_label", row.get("label", slot))),
		"can_save": bool(row.get("can_save", true)),
		"empty": false,
		"summary": "Checkpoint · save %s" % slot,
		"row": row,
	}

static func save_browser_campaign_product(rows: Array = [], max_rows: int = 8) -> Dictionary:
	var use_rows: Array = rows
	if use_rows.is_empty():
		# Demo fallback (live path injects SaveLoadManager rows)
		use_rows = [
			{"slot": "quicksave", "occupied": true, "label": "quicksave · world_full · GER", "can_load": true, "can_save": true, "metadata": {"timestamp": "1939-09-01", "scenario_id": "world_full", "player_tag": "GER"}},
			{"slot": "autosave", "occupied": false, "label": "autosave · empty", "can_load": false, "can_save": true},
			{"slot": "slot1", "occupied": true, "label": "slot1 · campaign · GER", "can_load": true, "can_save": true, "metadata": {"timestamp": "1939-09-15", "scenario_id": "world_full", "player_tag": "GER"}},
			{"slot": "slot2", "occupied": false, "label": "slot2 · empty", "can_load": false, "can_save": true},
			{"slot": "slot3", "occupied": false, "label": "slot3 · empty", "can_load": false, "can_save": true},
		]
	var flair: Dictionary = save_slot_browser_flair(use_rows, max_rows)
	var display: Array = flair.get("rows", use_rows)
	var resume: Dictionary = recommend_resume_slot(display)
	var checkpoint: Dictionary = recommend_checkpoint_slot(display)
	var occupied_count := int(flair.get("occupied_count", 0))
	var empty_count := int(flair.get("empty_count", 0))
	var count := int(flair.get("count", display.size()))
	if count <= 0:
		count = display.size()
	var score := clampf(0.35 * float(flair.get("score", 0.7)) + 0.25 * (0.8 if not bool(resume.get("empty", true)) else 0.3) + 0.2 * (0.75 if str(checkpoint.get("slot", "")) != "" else 0.3) + 0.2 * minf(1.0, float(count) / 7.0), 0.0, 1.0)
	var apply_queue: Array = []
	var actions: Array = [{"action_id": "save_browser_campaign_product", "label": "Run save browser campaign product", "enabled": true}]
	if not bool(resume.get("empty", true)) and str(resume.get("action_id", "")) != "":
		actions.append({"action_id": str(resume.get("action_id")), "label": "Resume campaign · %s" % str(resume.get("slot")), "enabled": bool(resume.get("can_load", true))})
		apply_queue.append({"action_id": str(resume.get("action_id")), "province_id": 1, "score": 0.75, "enabled": bool(resume.get("can_load", true)), "label": "Resume %s" % str(resume.get("slot")), "product_action": "resume"})
	if str(checkpoint.get("action_id", "")) != "":
		actions.append({"action_id": str(checkpoint.get("action_id")), "label": "Checkpoint · %s" % str(checkpoint.get("slot")), "enabled": bool(checkpoint.get("can_save", true))})
		apply_queue.append({"action_id": str(checkpoint.get("action_id")), "province_id": 1, "score": 0.7, "enabled": true, "label": "Checkpoint %s" % str(checkpoint.get("slot")), "product_action": "checkpoint"})
	actions.append({"action_id": "save_slot:quicksave", "label": "Quicksave", "enabled": true})
	apply_queue.append({"action_id": "save_slot:quicksave", "province_id": 1, "score": 0.6, "enabled": true, "label": "Quicksave", "product_action": "quicksave"})
	var shown := 0
	for r in display:
		if not (r is Dictionary):
			continue
		var slot := str(r.get("slot", "")).strip_edges()
		if slot.is_empty():
			continue
		apply_queue.append({"action_id": "save_slot:%s" % slot, "province_id": 1, "score": 0.55, "enabled": bool(r.get("can_save", true)), "label": "Save %s" % slot, "product_action": "save_row"})
		if bool(r.get("occupied", false)) and bool(r.get("can_load", true)):
			apply_queue.append({"action_id": "load_slot:%s" % slot, "province_id": 1, "score": 0.65, "enabled": true, "label": "Load %s" % slot, "product_action": "load_row"})
		shown += 1
		if shown >= max_rows:
			break
	var gate: Dictionary = execution_integrity_gate()
	var sole: Dictionary = sole_mult_integrity()
	var label := "Save browser campaign · %d slots · occupied %d · empty %d · resume %s · checkpoint %s · score %.2f" % [
		count, occupied_count, empty_count, str(resume.get("slot", "—")), str(checkpoint.get("slot", "—")), score
	]
	var plain_lines: PackedStringArray = [label, str(resume.get("summary", "")), str(checkpoint.get("summary", ""))]
	for r2 in display:
		if r2 is Dictionary and plain_lines.size() < max_rows + 3:
			plain_lines.append(str(r2.get("flair_label", r2.get("label", r2.get("slot", "")))))
	return {
		"rows": display, "flair": flair, "resume": resume, "checkpoint": checkpoint,
		"occupied_count": occupied_count, "empty_count": empty_count, "count": count,
		"score": score, "save_score": score, "apply_queue": apply_queue, "actions": actions,
		"gate": gate, "sole": sole, "slot_ok": count > 0,
		"summary": label, "plain": "\n".join(plain_lines),
		"bbcode": "%s💾 Save browser campaign[/color] %s— %s[/color]" % [COLOR_HEADER, COLOR_MUTED, label],
		"empty": count <= 0,
		"integration": ["save_browser_campaign_product", "resume", "checkpoint", "major_4", "save_game_detailed", "load_game_detailed"],
	}

## ---------------------------------------------------------------------------
## Medium-tank OOB product (major #3) — 60/80/100d equip horizons
## Composes medium_horizon_equip_plan + oob_factory_risk + production priority (not stubs).
## ---------------------------------------------------------------------------

static func recommend_oob_horizon_step(
	will_complete_60: bool,
	will_complete_100: bool,
	tank_progress: float = 0.15,
	logistics: float = 0.5,
) -> Dictionary:
	var prog := clampf(tank_progress, 0.0, 1.0)
	var logi := clampf(logistics if logistics <= 1.5 else logistics / 100.0, 0.0, 1.0)
	var step := 80
	var reason := "sustain medium line"
	if not will_complete_60 and prog < 0.4:
		step = 60
		reason = "line early — prioritize factories / seed"
	elif will_complete_60 and not will_complete_100:
		step = 80
		reason = "mid window — manage factory risk"
	elif will_complete_100 and logi < 0.45:
		step = 100
		reason = "completion window — stockpile/equip path"
	elif will_complete_100:
		step = 100
		reason = "prove equip at 100d horizon"
	var action_id := "oob_horizon_%dd" % step
	var leaf := "apply_supply" if step == 100 else "apply_production"
	return {
		"step": step, "horizon_days": step, "action_id": action_id, "leaf": leaf,
		"reason": reason, "empty": false,
		"summary": "Recommend %dd · %s" % [step, reason],
	}

static func medium_tank_oob_product(
	province_id: int = 1,
	tank_line_progress: float = 0.15,
	tank_stock: float = 0.0,
	infantry_stock: float = 5.0,
	factories: int = 14,
	temp: float = 8.0,
	precip: float = 0.3,
	ground_state: String = "mud",
	visibility: float = 0.7,
	wind: float = 0.25,
) -> Dictionary:
	var progress := clampf(tank_line_progress, 0.0, 1.0)
	var fac := maxi(0, factories)
	var equip_rows: Array = []
	var horizons: Array = [60, 80, 100]
	for days in horizons:
		var eq: Dictionary = medium_horizon_equip_plan(infantry_stock, tank_stock, progress, int(days), fac)
		equip_rows.append({
			"horizon_days": int(days),
			"equip": eq,
			"will_complete_tank": bool(eq.get("will_complete_tank", false)),
			"projected_progress": float(eq.get("projected_progress", 0.0)),
			"score": float(eq.get("score", 0.55)),
			"summary": str(eq.get("summary", "")),
		})
	var loop: Dictionary = oob_factory_risk_loop(temp, precip, ground_state, visibility, wind, 1.0)
	var mut: Dictionary = production_priority_mutation(temp, precip, ground_state, visibility, wind, 1.0, "medium_tank")
	var order: Dictionary = production_order_resolve(temp, precip, ground_state, visibility, wind, 1.0, "medium_tank")
	var pcr: Dictionary = production_campaign_risk(temp, precip, ground_state, visibility, wind, 1.0)
	var ready: Dictionary = force_readiness_day(80.0, 0.85, visibility, precip, ground_state, wind, 6, 80.0, province_id)
	var logistics := float(loop.get("effective_output", 0.7))
	var prod_score := float(mut.get("score", order.get("score", 0.55)))
	var equip100: Dictionary = equip_rows[equip_rows.size() - 1] if not equip_rows.is_empty() else {}
	var equip60: Dictionary = equip_rows[0] if not equip_rows.is_empty() else {}
	var complete100 := bool(equip100.get("will_complete_tank", false))
	var complete60 := bool(equip60.get("will_complete_tank", false))
	var score := clampf(
		0.3 * float(equip100.get("score", 0.55))
		+ 0.25 * prod_score
		+ 0.25 * logistics
		+ 0.1 * (0.8 if complete100 else 0.35)
		+ 0.1 * float(ready.get("score", 0.5)),
		0.0, 1.0
	)
	if score < 0.35:
		score = 0.35
	var rec: Dictionary = recommend_oob_horizon_step(complete60, complete100, progress, logistics)
	var day_rows: Array = []
	var apply_queue: Array = []
	var step_meta := {
		60: {"action_id": "oob_horizon_60d", "leaf": "apply_production", "label": "60d horizon — seed/priority medium line"},
		80: {"action_id": "oob_horizon_80d", "leaf": "apply_production", "label": "80d horizon — factory risk + output"},
		100: {"action_id": "oob_horizon_100d", "leaf": "apply_supply", "label": "100d horizon — equip/stockpile prove"},
	}
	for row in equip_rows:
		var days := int(row.get("horizon_days", 100))
		var meta: Dictionary = step_meta.get(days, step_meta[100])
		var recommended := days == int(rec.get("step", 100))
		var lab := str(meta.get("label", ""))
		if recommended:
			lab = "★ " + lab
		var will := "complete" if bool(row.get("will_complete_tank")) else "incomplete"
		lab = "%s · %s · score %.2f" % [lab, will, float(row.get("score", 0.55))]
		var r := {
			"horizon_days": days, "action_id": str(meta.get("action_id")), "leaf_action": str(meta.get("leaf")),
			"label": lab, "score": float(row.get("score", 0.55)),
			"will_complete_tank": bool(row.get("will_complete_tank")),
			"enabled": true, "recommended": recommended, "province_id": province_id,
		}
		day_rows.append(r)
		apply_queue.append({
			"action_id": str(meta.get("leaf")), "province_id": province_id, "score": float(row.get("score", 0.55)),
			"enabled": true, "label": lab, "horizon_days": days, "product_action": str(meta.get("action_id")),
		})
	if complete100:
		apply_queue.append({
			"action_id": "apply_station", "province_id": province_id, "score": score, "enabled": true,
			"label": "Equip formations from stockpile (100d prove)", "product_action": "oob_equip_prove",
		})
	var actions: Array = [
		{"action_id": "medium_tank_oob_product", "label": "Run medium-tank OOB product", "enabled": true},
		{"action_id": str(rec.get("action_id", "oob_horizon_100d")), "label": "Recommended: %dd" % int(rec.get("step", 100)), "enabled": true},
	]
	for row2 in day_rows:
		actions.append({"action_id": str(row2.get("action_id")), "label": str(row2.get("label")), "enabled": true, "horizon_days": int(row2.get("horizon_days", 0))})
	var label := "Medium-tank OOB · 60/80/100d · progress %.0f%% · complete100 %s · factories %d · score %.2f" % [
		progress * 100.0, "yes" if complete100 else "no", fac, score
	]
	var plain_lines: PackedStringArray = [label, str(rec.get("summary", ""))]
	for row3 in day_rows:
		plain_lines.append(str(row3.get("label", "")))
	plain_lines.append(str(equip100.get("summary", "")))
	return {
		"equip_rows": equip_rows, "horizon_rows": day_rows, "day_rows": day_rows,
		"loop": loop, "mutation": mut, "order": order, "campaign_risk": pcr, "readiness": ready,
		"recommendation": rec, "will_complete_60d": complete60, "will_complete_100d": complete100,
		"tank_line_progress": progress, "tank_stock": tank_stock, "factories": fac,
		"apply_queue": apply_queue, "actions": actions, "score": score, "oob_score": score,
		"province_id": province_id, "apply_ready": complete100 or progress >= 0.5,
		"summary": label, "plain": "\n".join(plain_lines),
		"bbcode": "%s🏭 Medium-tank OOB[/color] %s— %s[/color]" % [COLOR_WARN, COLOR_MUTED, label],
		"empty": false,
		"integration": ["medium_tank_oob_product", "oob_horizon_60d", "oob_horizon_80d", "oob_horizon_100d", "major_3"],
	}

static func execute_oob_horizon_step(
	horizon_days: int = 100,
	province_id: int = 1,
	tank_line_progress: float = 0.15,
	factories: int = 14,
) -> Dictionary:
	var days := int(horizon_days)
	if days not in [60, 80, 100]:
		days = 100
	var product: Dictionary = medium_tank_oob_product(province_id, tank_line_progress, 0.0, 5.0, factories)
	var row: Dictionary = {}
	for r in product.get("day_rows", []):
		if r is Dictionary and int(r.get("horizon_days", 0)) == days:
			row = r
			break
	var leaf := "apply_supply" if days == 100 else "apply_production"
	var action_id := "oob_horizon_%dd" % days
	var lab := str(row.get("label", "%dd horizon" % days))
	var score := float(row.get("score", product.get("score", 0.5)))
	var apply_queue: Array = [{
		"action_id": leaf, "province_id": province_id, "score": score, "enabled": true,
		"label": lab, "horizon_days": days, "product_action": action_id,
	}]
	var label := "Execute OOB %dd · leaf %s · complete %s · #%d" % [
		days, leaf, "yes" if bool(row.get("will_complete_tank")) else "no", province_id
	]
	return {
		"horizon_days": days, "leaf_action": leaf, "action_id": action_id, "apply_queue": apply_queue,
		"score": score, "will_complete_tank": bool(row.get("will_complete_tank")),
		"province_id": province_id, "summary": label, "plain": label,
		"bbcode": "%s🏭 OOB %dd[/color] %s— %s[/color]" % [COLOR_WARN, days, COLOR_MUTED, label],
		"empty": false, "ok": true,
		"integration": ["execute_oob_horizon", str(days), leaf],
	}

