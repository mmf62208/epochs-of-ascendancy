	var action_id := "naval_phase_posture"
	match s:
		"escort":
			action_id = "naval_phase_escort"
		"strike":
			action_id = "naval_phase_strike"
	var score := float(row.get("score", product.get("score", 0.5)))
	var apply_queue: Array = [{"action_id": leaf, "province_id": province_id, "score": score, "enabled": true, "label": str(row.get("label", s)), "step": s, "product_action": action_id}]
	var label := "Execute naval phase %s · leaf %s · score %.2f" % [s, leaf, score]
	return {"step": s, "leaf_action": leaf, "action_id": action_id, "apply_queue": apply_queue, "score": score, "province_id": province_id, "summary": label, "plain": label, "bbcode": "%s⚓ Naval %s[/color] %s— %s[/color]" % [COLOR_HEADER, s, COLOR_MUTED, label], "empty": false, "ok": true, "integration": ["execute_naval_phase_step", s, leaf]}

