## Deterministic next-day weather forecast stub.
static func forecast_next_day_weather(
	temp: float = 10.0,
	precip_intensity: float = 0.0,
	visibility: float = 1.0,
	wind: float = 0.2,
	ground_state: String = "dry",
) -> Dictionary:
	var next_temp := temp * 0.9 + 10.0 * 0.1
	var next_precip := clampf(precip_intensity * 0.7 + (0.15 if precip_intensity > 0.5 else 0.0), 0.0, 1.0)
	var next_vis := clampf(visibility * 0.85 + 0.15 * (1.0 - next_precip), 0.1, 1.0)
	var next_wind := clampf(wind * 0.8 + next_precip * 0.15, 0.05, 1.0)
	var next_ground := ground_state.strip_edges().to_lower()
	if next_precip > 0.55 and next_temp > 2.0:
		next_ground = "mud"
	elif next_temp < -2.0 and next_precip > 0.2:
		next_ground = "snow_covered"
	elif next_precip < 0.15 and next_ground in ["mud", "wet"]:
		next_ground = "dry"
	var combat := weather_combat_multiplier(next_vis, next_precip, next_wind)
	var label := "Tomorrow · %s · vis %.0f%% · combat ×%.2f" % [next_ground, next_vis * 100.0, combat]
	return {
		"temp": next_temp,
		"precip_intensity": next_precip,
		"visibility": next_vis,
		"wind": next_wind,
		"ground_state": next_ground,
		"combat_mult": combat,
		"label": label,
		"summary": label,
		"bbcode": "%s📅 Forecast[/color] %s— %s[/color]" % [COLOR_TECH, COLOR_MUTED, label],
	}


## Storm convoy risk (interdiction + escort need).
static func storm_convoy_risk(
	precip_intensity: float = 0.0,
	visibility: float = 1.0,
	escort_need_base: float = 25.0,
	base_interdiction: float = 0.1,
) -> Dictionary:
	var bump := precip_intensity * 0.18 + maxf(0.0, 0.5 - visibility) * 0.12
	var chance := clampf(base_interdiction + bump, 0.0, 0.95)
	var need := escort_need_base * (0.6 + chance)
	var risk := clampf(chance + 0.2, 0.0, 1.0)
	var label := "Storm convoy risk %.0f%% · escort need %.1f" % [risk * 100.0, need]
	return {
		"risk": risk,
		"escort_need": need,
		"interdiction_chance": chance,
		"recommend_escort": need >= 25.0,
		"label": label,
		"summary": label,
		"bbcode": "%s🌊 Storm convoy[/color] %s— %s[/color]" % [COLOR_TECH, COLOR_MUTED, label],
	}


## Extreme event severity chip.
static func format_extreme_event_chip(events: Array) -> Dictionary:
	var scored: Array = []
	for e in events:
		if typeof(e) != TYPE_DICTIONARY:
			continue
		var et := str(e.get("type", e.get("event_type", "storm")))
		var sev := int(e.get("severity", e.get("level", 1)))
		var score := float(sev * 10)
		if et in ["emp_detonation", "nuke_atmo", "x_flare"]:
			score += 25.0
		elif et in ["typhoon", "quake"]:
			score += 15.0
		scored.append({"type": et, "severity": sev, "score": score})
	if scored.is_empty():
		return {"empty": true, "plain": "", "bbcode": "", "summary": "", "worst": {}}
	scored.sort_custom(func(a, b): return float(a["score"]) > float(b["score"]))
	var worst: Dictionary = scored[0]
	var label := "Extreme: %s sev %s" % [worst.get("type", "?"), worst.get("severity", "?")]
	return {
		"empty": false,
		"worst": worst,
		"ranked": scored,
		"plain": label,
		"bbcode": "[color=#f87171]⚠ %s[/color]" % label,
		"summary": label,
	}


