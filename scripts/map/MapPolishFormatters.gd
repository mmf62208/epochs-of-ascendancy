static func recommend_play_session_step(brief_ready: bool = false, execute_done: bool = false, resolve_ready: bool = false) -> Dictionary:
	var step := "execute"
	var reason := "refresh execute queue"
	if not brief_ready:
		step = "brief"
		reason = "open session brief"
	elif not execute_done:
		step = "execute"
		reason = "player orders pending"
	elif resolve_ready:
		step = "resolve"
		reason = "AI tick + feedback ready"
	var action_id := "play_session_brief"
	var leaf := "apply_focus"
	match step:
		"execute":
			action_id = "play_session_execute"
			leaf = "apply_assault"
		"resolve":
			action_id = "play_session_resolve"
			leaf = "apply_station"
	return {
		"step": step, "action_id": action_id, "leaf": leaf, "reason": reason, "empty": false,
		"summary": "Recommend %s · %s" % [step, reason],
	}

static func play_session_campaign_product(province_id: int = 1, player_tag: String = "GER") -> Dictionary:
	var theater: Dictionary = theater_command_product(province_id)
	var decision: Dictionary = campaign_decision_day([], province_id)
	var execute: Dictionary = order_execute_day(0.65, 0.35, 6.0, "mud", 0.35, 6, [], 3, province_id)
	var ai_daily: Dictionary = strategic_ai_daily_campaign_product(province_id, player_tag, 4)
	var before := float(execute.get("score", 0.5))
	var after := minf(1.0, before + 0.06)
	var feedback: Dictionary = next_day_feedback(before, after, "session_resolve")
	var save: Dictionary = save_browser_campaign_product([])
	var brief_score := clampf(0.55 * float(theater.get("score", 0.5)) + 0.45 * float(decision.get("score", 0.5)), 0.0, 1.0)
	if brief_score < 0.35:
		brief_score = 0.35
	var exec_score := clampf(float(execute.get("score", 0.5)), 0.0, 1.0)
	if exec_score < 0.35:
		exec_score = 0.35
	var resolve_score := clampf(0.45 * float(ai_daily.get("score", 0.5)) + 0.35 * after + 0.2 * float(save.get("score", 0.5)), 0.0, 1.0)
	if resolve_score < 0.35:
		resolve_score = 0.35
	var score := clampf(0.3 * brief_score + 0.35 * exec_score + 0.35 * resolve_score, 0.0, 1.0)
	if score < 0.35:
		score = 0.35
	var brief_ready: bool = not bool(theater.get("empty", false)) and not bool(decision.get("empty", false))
	var execute_done: bool = (execute.get("apply_queue") is Array and (execute["apply_queue"] as Array).size() >= 1) or float(execute.get("score", 0)) > 0.3
	var resolve_ready: bool = int(ai_daily.get("budget_count", 0)) >= 1
	var rec: Dictionary = recommend_play_session_step(brief_ready, execute_done, resolve_ready)
	var exec_leaf := "apply_assault"
	if execute.get("apply_queue") is Array and not (execute["apply_queue"] as Array).is_empty():
		var eq0 = (execute["apply_queue"] as Array)[0]
		if eq0 is Dictionary:
			exec_leaf = str(eq0.get("action_id", exec_leaf))
	var resolve_leaf := "apply_station"
	var budget_block: Dictionary = ai_daily.get("budget", {}) if ai_daily.get("budget") is Dictionary else {}
	if budget_block.get("queue") is Array and not (budget_block["queue"] as Array).is_empty():
		var rq0 = (budget_block["queue"] as Array)[0]
		if rq0 is Dictionary:
			resolve_leaf = str(rq0.get("action_id", resolve_leaf))
	var steps: Array = [
		{"step": "brief", "action_id": "play_session_brief", "leaf": "apply_focus", "label": "Step 0 — session brief / theater decision", "score": brief_score},
		{"step": "execute", "action_id": "play_session_execute", "leaf": exec_leaf, "label": "Step 1 — execute player order queue", "score": exec_score},
		{"step": "resolve", "action_id": "play_session_resolve", "leaf": resolve_leaf, "label": "Step 2 — resolve AI day + next-day feedback", "score": resolve_score},
	]
	var day_rows: Array = []
	var apply_queue: Array = []
	for i in range(steps.size()):
		var st: Dictionary = steps[i]
		var step_name := str(st.get("step"))
		var recommended: bool = step_name == str(rec.get("step"))
		var sc := float(st.get("score", 0.5))
		var leaf := str(st.get("leaf"))
		var lab := str(st.get("label"))
		if recommended:
			lab = "★ " + lab
		lab = "%s · score %.2f" % [lab, sc]
		var row := {
			"index": i, "step": step_name, "action_id": str(st.get("action_id")),
			"leaf_action": leaf, "label": lab, "score": sc, "enabled": true,
			"recommended": recommended, "province_id": province_id,
		}
		day_rows.append(row)
		apply_queue.append({
			"action_id": leaf, "province_id": province_id, "score": sc, "enabled": true,
			"label": lab, "step": step_name, "product_action": str(st.get("action_id")),
		})
	if budget_block.get("queue") is Array:
		for q in budget_block["queue"]:
			if q is Dictionary:
				apply_queue.append(q)
	var actions: Array = [
		{"action_id": "play_session_campaign_product", "label": "Run play session campaign product", "enabled": true},
		{"action_id": str(rec.get("action_id", "play_session_brief")), "label": "Recommended: %s" % str(rec.get("step", "brief")), "enabled": true},
		{"action_id": "strategic_ai_daily_campaign_product", "label": "Open strategic AI daily", "enabled": true},
	]
	for row2 in day_rows:
		actions.append({"action_id": str(row2.get("action_id")), "label": str(row2.get("label")), "enabled": true, "step": str(row2.get("step"))})
	var label := "Play session campaign · brief %.2f · execute %.2f · resolve %.2f · AI budget %d · score %.2f" % [
		brief_score, exec_score, resolve_score, int(ai_daily.get("budget_count", 0)), score
	]
	var plain_lines: PackedStringArray = [label, str(rec.get("summary", "")), str(theater.get("summary", "")), str(decision.get("summary", "")), str(execute.get("summary", "")), str(ai_daily.get("summary", "")), str(feedback.get("summary", ""))]
	for row3 in day_rows:
		plain_lines.append(str(row3.get("label", "")))
	return {
		"theater": theater, "decision": decision, "execute": execute, "ai_daily": ai_daily,
		"feedback": feedback, "save": save, "brief_score": brief_score, "exec_score": exec_score,
		"resolve_score": resolve_score, "recommendation": rec, "day_rows": day_rows,
		"apply_queue": apply_queue, "actions": actions, "score": score, "session_score": score,
		"province_id": province_id, "player_tag": player_tag.strip_edges().to_upper(),
		"budget_count": int(ai_daily.get("budget_count", 0)),
		"summary": label, "plain": "\n".join(plain_lines),
		"bbcode": "%s▶ Play session[/color] %s— %s[/color]" % [COLOR_HEADER, COLOR_MUTED, label],
		"empty": false,
		"integration": ["play_session_campaign_product", "play_session_brief", "play_session_execute", "play_session_resolve", "major_12", "play_session"],
	}

static func execute_play_session_step(step: String = "brief", province_id: int = 1, player_tag: String = "GER") -> Dictionary:
	var s := step.strip_edges().to_lower()
	if s.begins_with("play_session_"):
		s = s.replace("play_session_", "")
	if s not in ["brief", "execute", "resolve"]:
		s = "brief"
	var product: Dictionary = play_session_campaign_product(province_id, player_tag)
	var row: Dictionary = {}
	for r in product.get("day_rows", []):
		if r is Dictionary and str(r.get("step")) == s:
			row = r
			break
	var leaf := str(row.get("leaf_action", "apply_focus"))
	var action_id := "play_session_brief"
	match s:
		"execute":
			action_id = "play_session_execute"
		"resolve":
			action_id = "play_session_resolve"
	var score := float(row.get("score", product.get("score", 0.5)))
	var apply_queue: Array = [{
		"action_id": leaf, "province_id": province_id, "score": score, "enabled": true,
		"label": str(row.get("label", s)), "step": s, "product_action": action_id,
	}]
	if s == "execute" and product.get("execute") is Dictionary:
		var eq = product["execute"].get("apply_queue", [])
		if eq is Array and not eq.is_empty():
			apply_queue = []
			for item in eq:
				if item is Dictionary:
					apply_queue.append(item)
				if apply_queue.size() >= 4:
					break
	elif s == "resolve":
		var bq = product.get("ai_daily", {}).get("budget", {}).get("queue", []) if product.get("ai_daily") is Dictionary else []
		if bq is Array and not bq.is_empty():
			apply_queue = []
			for item2 in bq:
				if item2 is Dictionary:
					apply_queue.append(item2)
				if apply_queue.size() >= 4:
					break
	var label := "Execute play session %s · leaf %s · score %.2f" % [s, leaf, score]
	return {
		"step": s, "leaf_action": leaf, "action_id": action_id, "apply_queue": apply_queue,
		"score": score, "province_id": province_id, "summary": label, "plain": label,
		"bbcode": "%s▶ Session %s[/color] %s— %s[/color]" % [COLOR_HEADER, s, COLOR_MUTED, label],
		"empty": false, "ok": true,
		"integration": ["execute_play_session_step", s, leaf],
	}

