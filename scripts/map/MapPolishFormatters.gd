## Resource/damage operational skim.
static func resource_damage_operational_skim(
	primary_resource: String = "oil",
	resource_level: float = 0.6,
	infrastructure: float = 50.0,
	damage_strength: float = 0.0,
	sabotage: bool = false,
	site_damaged: int = 0,
	zoom: float = 0.45,
	province_id: int = 1,
) -> Dictionary:
	var res := primary_resource.strip_edges().to_lower()
	if res.is_empty():
		res = "none"
	var level := clampf(resource_level, 0.0, 1.5)
	var infra := clampf(infrastructure, 0.0, 100.0)
	var dmg := clampf(damage_strength, 0.0, 1.0)
	if sabotage:
		dmg = maxf(dmg, 0.35)
	if site_damaged > 0:
		dmg = maxf(dmg, minf(0.7, 0.15 * float(site_damaged)))
	var z := clampf(zoom, 0.05, 2.0)
	var visible := z >= 0.32
	var icon_weight := 0.0
	if visible:
		icon_weight = minf(1.0, 0.35 + level * 0.5 + (z - 0.32) * 1.2)
	var urgency := dmg * 0.6 + maxf(0.0, 0.5 - level) * 0.3 + maxf(0.0, 40.0 - infra) / 100.0
	urgency = minf(1.0, urgency)
	var score := maxf(0.05, (1.0 - urgency) * 0.55 + icon_weight * 0.45)
	var dmg_tag := "sabo" if sabotage else ("dmg" if dmg >= 0.2 else "clean")
	var label := "Res/dmg skim · #%d · %s %.0f%% · infra %.0f · %s · zoom %.2f%s" % [
		province_id, res, level * 100.0, infra, dmg_tag, z, "" if visible else " · icons off"
	]
	return {
		"province_id": province_id,
		"primary_resource": res,
		"resource_level": level,
		"infrastructure": infra,
		"damage_strength": dmg,
		"sabotage": sabotage,
		"site_damaged": site_damaged,
		"zoom": z,
		"icons_visible": visible,
		"icon_weight": icon_weight,
		"urgency": urgency,
		"score": score,
		"summary": label,
		"plain": label,
		"bbcode": "%s⛏ Res/dmg skim[/color] %s— %s[/color]" % [COLOR_WARN, COLOR_MUTED, label],
		"empty": false,
	}


## Sealane contest skim.
static func sealane_contest_skim(
	is_choke: bool = false,
	zone_relation: String = "contested",
	sea_trade_mult: float = 1.0,
	escort_coverage: float = 0.7,
	province_id: int = 1,
) -> Dictionary:
	var zone := zone_relation.strip_edges().to_lower()
	if zone.is_empty():
		zone = "no_zone"
	var sea := clampf(sea_trade_mult, 0.2, 1.5)
	var escort := clampf(escort_coverage, 0.0, 1.2)
	var contest := 0.2
	if zone == "hostile":
		contest = 0.85
	elif zone == "contested":
		contest = 0.55
	elif zone == "friendly":
		contest = 0.15
	if is_choke:
		contest = minf(1.0, contest + 0.15)
	if escort < 0.5:
		contest = minf(1.0, contest + 0.1)
	var score := maxf(0.05, (1.0 - contest) * 0.5 + sea * 0.3 + escort * 0.2)
	var label := "Sealane contest · #%d · %s · choke %s · sea×%.2f · escort %.0f%% · contest %.0f%%" % [
		province_id, zone, "yes" if is_choke else "no", sea, escort * 100.0, contest * 100.0
	]
	return {
		"province_id": province_id,
		"is_choke": is_choke,
		"zone_relation": zone,
		"sea_trade_mult": sea,
		"escort_coverage": escort,
		"contest": contest,
		"score": score,
		"summary": label,
		"plain": label,
		"bbcode": "%s🌊 Sealane contest[/color] %s— %s[/color]" % [COLOR_TECH, COLOR_MUTED, label],
		"empty": false,
	}


## Day-package apply audit (structural: action_id in apply_order_panel_action).
static func day_package_apply_audit(panel_ids: Array = [], router_source: String = "") -> Dictionary:
	var ids: Array = panel_ids.duplicate()
	if ids.is_empty():
		ids = [
			"day_ops_integrated", "theater_day_cabinet", "logistics_day", "war_economy_day",
			"combat_campaign_day", "fleet_campaign_day", "weather_crisis_day", "agent_campaign_day",
			"hh_campaign_day", "hh_player_path", "industry_surge_day", "joint_command_day",
			"strategic_continuity_day", "force_readiness_day", "apply_supply", "apply_station",
			"apply_production", "apply_hh_commit",
		]
	var routed: Array = []
	var dead: Array = []
	var src := router_source
	if src.is_empty():
		# Live path: treat known GameData router as present when GameData exists.
		src = "apply_order_panel_action live"
	for aid_v in ids:
		var aid := str(aid_v)
		if src == "apply_order_panel_action live":
			# Defer detailed string audit to pure tests; runtime assumes GameData routes.
			routed.append(aid)
		elif ('"%s"' % aid) in src or ("'%s'" % aid) in src:
			routed.append(aid)
		else:
			dead.append(aid)
	var ok := dead.is_empty() and not routed.is_empty()
	var label := "Day apply audit · panel %d · routed %d · dead %d · %s" % [
		ids.size(), routed.size(), dead.size(), "PASS" if ok else "FAIL"
	]
	return {
		"panel_ids": ids,
		"routed": routed,
		"dead": dead,
		"routed_count": routed.size(),
		"dead_count": dead.size(),
		"ok": ok,
		"score": 1.0 if ok else 0.2,
		"summary": label,
		"plain": label,
		"bbcode": "%s✓ Day apply audit[/color] %s— %s[/color]" % [COLOR_TECH, COLOR_MUTED, label],
		"empty": false,
	}


## Save-slot browser flair rows.
static func save_slot_browser_flair(rows: Array = [], max_rows: int = 8) -> Dictionary:
	var raw: Array = rows
	if raw.is_empty():
		raw = [
			{"slot": "quicksave", "occupied": false, "label": "quicksave · empty", "can_load": false, "can_save": true},
			{"slot": "autosave", "occupied": true, "label": "autosave · world_full", "can_load": true, "can_save": true},
			{"slot": "slot1", "occupied": false, "label": "slot1 · empty", "can_load": false, "can_save": true},
		]
	var flaired: Array = []
	var empty_n := 0
	var occ_n := 0
	var n := mini(max_rows, raw.size())
	for i in range(n):
		var r = raw[i]
		if not (r is Dictionary):
			continue
		var slot := str(r.get("slot", "unnamed")).strip_edges()
		var occupied := bool(r.get("occupied", false))
		var base := str(r.get("label", slot)).strip_edges()
		var mark := "○"
		var tint := "empty"
		if occupied:
			occ_n += 1
			if slot == "autosave":
				mark = "★"
			elif slot == "quicksave":
				mark = "⚡"
			else:
				mark = "●"
			tint = "occupied"
		else:
			empty_n += 1
			if "empty" not in base:
				base = base + " · empty"
		var flair_label := "%s %s" % [mark, base]
		flaired.append({
			"slot": slot,
			"occupied": occupied,
			"status": "occupied" if occupied else "empty",
			"label": str(r.get("label", slot)),
			"flair_label": flair_label,
			"marker": mark,
			"tint": tint,
			"can_load": bool(r.get("can_load", occupied)),
			"can_save": bool(r.get("can_save", true)),
			"action_save": "save_slot:%s" % slot,
			"action_load": "load_slot:%s" % slot,
		})
	var label := "Save-slot flair · %d rows · occupied %d · empty %d" % [flaired.size(), occ_n, empty_n]
	var plain_lines: PackedStringArray = [label]
	for x in flaired:
		if plain_lines.size() >= 7:
			break
		plain_lines.append(str(x.get("flair_label", "")))
	return {
		"rows": flaired,
		"occupied_count": occ_n,
		"empty_count": empty_n,
		"count": flaired.size(),
