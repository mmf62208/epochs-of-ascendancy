static func full_game_campaign_close_day(province_id: int = 1) -> Dictionary:
	var p0: Dictionary = strategic_ai_campaign_close_day(province_id)
	var p1: Dictionary = designer_industry_close_day(province_id)
	var p2: Dictionary = theater_ai_command_joint_day(province_id)
	var p3: Dictionary = fleet_ai_campaign_depth_day(province_id)
	var p4: Dictionary = agent_ai_campaign_depth_day(province_id)
	var p5: Dictionary = combat_ai_phase_depth_day(province_id)
	var p6: Dictionary = save_session_ai_joint_day(province_id)
	var non_empty := 0
	var sum_sc := 0.0
	for p in [p0, p1, p2, p3, p4, p5, p6]:
		if p is Dictionary and not bool(p.get("empty", true)):
			non_empty += 1
			sum_sc += float(p.get("score", 0))
	var avg := sum_sc / float(maxi(1, non_empty))
	var ok: bool = non_empty >= 7
	var score := clampf(0.55 * avg + 0.45 * (1.0 if ok else 0.3), 0.0, 1.0)
	if score < 0.35:
		score = 0.35
	var apply_queue: Array = [
		{"action_id": "apply_focus", "province_id": province_id, "score": score, "enabled": true, "label": "Full game campaign close focus"},
		{"action_id": "apply_production", "province_id": province_id, "score": 0.55, "enabled": true, "label": "Full game campaign close production"},
		{"action_id": "apply_assault", "province_id": province_id, "score": 0.5, "enabled": true, "label": "Full game campaign close assault"},
		{"action_id": "apply_station", "province_id": province_id, "score": 0.45, "enabled": true, "label": "Full game campaign close fleet"},
	]
	var label := "Full game campaign close · pillars %d/7 · gates %s · score %.2f" % [non_empty, "PASS" if ok else "FAIL", score]
	return {
		"ok": ok, "campaign_score": score, "score": score, "apply_queue": apply_queue,
		"actions": [{"action_id": "full_game_campaign_close_day", "label": "Run full game campaign close day", "enabled": true}],
		"summary": label, "plain": label,
		"bbcode": "%s✓ Full game campaign close[/color] %s— %s[/color]" % [COLOR_HEADER, COLOR_MUTED, label],
		"empty": false, "integration": ["full_game", "campaign", "close", "next290"],
	}

