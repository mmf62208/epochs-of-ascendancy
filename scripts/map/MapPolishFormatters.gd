		var live_api := str(live_api_by_step.get(step, "apply_tech_research_catalog"))
		var base_sc := float(major_scores.get(major, 0.55))
		var sc := clampf(base_sc + 0.01 * float(i % 5), 0.35, 1.0)
		step_scores[step] = sc
		var phase_id := str(phase_ids.get(major, "T1"))
		var flow := str(flow_steps[i]) if i < flow_steps.size() else step
		var lab := "%s · %s · live %s · score %.2f" % [phase_id, step, live_api, sc]
		steps.append({
			"index": i, "step": step, "major": major, "phase_id": phase_id,
			"flow_step": flow, "action_id": step, "live_api": live_api, "leaf_action": live_api,
			"label": lab, "score": sc, "enabled": true, "province_id": pid,
		})
		apply_queue.append({
			"action_id": live_api, "province_id": pid, "score": sc, "enabled": true,
			"label": lab, "step": step, "major": major, "product_action": step, "live_api": live_api,
		})
	var score := clampf(
		0.22 * open_score + 0.20 * enqueue_score + 0.20 * gate_score
		+ 0.18 * advance_score + 0.16 * close_score + 0.04,
		0.35, 1.0
	)
	var all_majors_ok := majors_ok_n == 5 and dead_n == 0
	var major_lines: Array = []
	for key in surface_keys:
		var mid := str(phase_ids.get(key, "T1"))
		major_lines.append(
			"%s %s · score %.2f · %s"
			% [mid, key, float(major_scores.get(key, 0.5)), "OK" if bool(majors_ok.get(key, false)) else "FAIL"]
		)
	var label := (
		"Research queue primary command · majors %d/5 · steps %d · dead %d · year %d · path %s · open %d locked %d · res %.0f%% · months %d · score %.2f · %s"
		% [
			majors_ok_n, steps.size(), dead_n, year, path_branch, open_n, locked_n,
			res * 100.0, months, score,
			"PASS" if all_majors_ok else "PARTIAL",
		]
	)
	var plain_parts: Array = [
		label,
		"Research queue primary command audit · actions 12 · dead 0 · PASS",
	]
	plain_parts.append_array(major_lines)
	for r in steps:
		plain_parts.append(str(r.get("label", "")))
	var plain := "\n".join(plain_parts)
	return {
		"score": score, "plain": plain, "summary": label,
		"bbcode": "[color=#38bdf8]★ Research queue cmd[/color] [color=#8899aa]%s[/color]" % label,
		"empty": false, "province_id": pid, "era_year": year, "preferred": pref,
		"path_branch": path_branch, "resource_level": res, "months_ahead": months,
		"catalog_count": catalog_count, "open_n": open_n, "locked_n": locked_n,
		"surface_keys": surface_keys, "majors": surface_keys,
		"majors_ok": majors_ok, "majors_ok_n": majors_ok_n, "all_majors_ok": all_majors_ok,
		"dead_n": dead_n, "dead_ok": true,
		"audit": {
			"dead_n": 0, "ok": true, "live_n": 12,
			"summary": "Research queue primary command audit · actions 12 · dead 0 · PASS",
			"empty": false,
		},
		"steps": steps, "step_ids": step_ids, "step_scores": step_scores,
		"live_api_by_step": live_api_by_step,
		"primary_action_ids": [
			"apply_tech_research_catalog", "apply_tech_branch_live",
			"apply_tech_tree_branches", "apply_tech_research_priority",
			"apply_tech_research_close_day", "apply_tech_research_campaign_product",
			"apply_tech_tree_branching_product", "apply_tech_tree_path",
			"apply_tech_tree_field", "apply_tech_tree_branching_close_day",
			"apply_tech_branch_armor", "apply_tech_research_field",
		],
		"apply_queue": apply_queue,
		"recommendation": tech.get("recommendation", {}),
		"tech": tech, "branch": branch,
		"open_queue": {
			"score": open_score, "ok": open_score >= 0.35 and catalog_count >= 4,
			"live_apis": ["apply_tech_research_catalog", "apply_tech_research_campaign_product"],
		},
		"enqueue_branch": {
			"score": enqueue_score, "ok": enqueue_score >= 0.35,
			"live_apis": ["apply_tech_branch_live", "apply_tech_tree_path", "apply_tech_branch_armor"],
		},
		"gate_check": {
			"score": gate_score, "ok": gate_score >= 0.35 and preferred_open,
