## Focus war path day package.
static func focus_war_path_day(
	visibility: float = 1.0,
	precip: float = 0.0,
	ground_state: String = "dry",
	focus_id: String = "industrial_effort",
	focus_base: float = 55.0,
	trail: Array = [],
	province_id: int = 1,
) -> Dictionary:
	var board: Dictionary = focus_war_path_board(focus_id, focus_base, trail, visibility, precip)
	var score := float(board.get("score", 0.5))
	if score > 2.0:
		score = clampf(score / 100.0, 0.0, 1.0)
	var best := focus_id
	var urgency := float(board.get("score", 0.25)) * 0.9
	# Prefer war path urgency if present on nested dicts
	var war_v = board.get("war_path", null)
	if war_v is Dictionary:
		urgency = float((war_v as Dictionary).get("urgency", (war_v as Dictionary).get("score", urgency)))
	var apply_ready := score >= 0.25
	var apply_queue: Array = [
		{"action_id": "apply_focus", "province_id": province_id, "score": score, "focus_id": best, "enabled": apply_ready},
	]
	if urgency >= 0.45:
		apply_queue.append({"action_id": "apply_production", "province_id": province_id, "score": minf(1.0, urgency), "enabled": true})
	var label := "Focus war path day · focus %s · score %.2f · urgency %.2f" % [best, score, urgency]
	return {
		"board": board,
		"best_focus": best,
		"urgency": urgency,
