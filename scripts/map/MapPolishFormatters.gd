	var score := clampf(0.35 * coverage_score + 0.35 * counter_score + 0.3 * counterplay_score, 0.0, 1.0)
	if score < 0.35:
		score = 0.35
	var rec: Dictionary = recommend_intel_step(coverage_score, counter_score, counterplay_score >= 0.45 and coverage_score >= 0.4)
	var steps: Array = [
		{"step": "coverage", "action_id": "intel_network_coverage", "leaf": "apply_agent_dispatch", "label": "Step 0 — coverage / agent board", "score": coverage_score},
		{"step": "counterintel", "action_id": "intel_network_counterintel", "leaf": "apply_agent_dispatch", "label": "Step 1 — counterintel board", "score": counter_score},
		{"step": "counterplay", "action_id": "intel_network_counterplay", "leaf": "apply_hh_commit", "label": "Step 2 — HH/agent counterplay", "score": counterplay_score},
	]
	var day_rows: Array = []
	var apply_queue: Array = []
	for i in range(steps.size()):
		var st: Dictionary = steps[i]
		var step_name := str(st.get("step"))
		var recommended: bool = step_name == str(rec.get("step"))
		var sc := float(st.get("score", 0.5))
		var leaf := str(st.get("leaf"))
		var lab := str(st.get("label"))
		if recommended:
			lab = "★ " + lab
		lab = "%s · score %.2f" % [lab, sc]
		day_rows.append({"index": i, "step": step_name, "action_id": str(st.get("action_id")), "leaf_action": leaf, "label": lab, "score": sc, "enabled": true, "recommended": recommended, "province_id": province_id})
		apply_queue.append({"action_id": leaf, "province_id": province_id, "score": sc, "enabled": true, "label": lab, "step": step_name, "product_action": str(st.get("action_id"))})
	var actions: Array = [
		{"action_id": "intelligence_network_product", "label": "Run intelligence network product", "enabled": true},
		{"action_id": str(rec.get("action_id", "intel_network_coverage")), "label": "Recommended: %s" % str(rec.get("step", "coverage")), "enabled": true},
	]
	for row2 in day_rows:
		actions.append({"action_id": str(row2.get("action_id")), "label": str(row2.get("label")), "enabled": true, "step": str(row2.get("step"))})
	var label := "Intelligence network · coverage %.2f · counter %.2f · counterplay %.2f · score %.2f" % [coverage_score, counter_score, counterplay_score, score]
	return {
		"agent": agent, "counter": counter, "hh": hh, "diplo": diplo,
		"coverage_score": coverage_score, "counter_score": counter_score, "counterplay_score": counterplay_score,
		"recommendation": rec, "day_rows": day_rows, "apply_queue": apply_queue, "actions": actions,
		"score": score, "intel_score": score, "province_id": province_id,
		"summary": label, "plain": label,
		"bbcode": "%s🕵 Intelligence network[/color] %s— %s[/color]" % [COLOR_HEADER, COLOR_MUTED, label],
		"empty": false,
		"integration": ["intelligence_network_product", "intel_network_coverage", "intel_network_counterintel", "intel_network_counterplay", "major_19", "intelligence", "intel"],
