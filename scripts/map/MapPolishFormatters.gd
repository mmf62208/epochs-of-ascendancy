## Daylight combat modifier from month.
static func daylight_combat_mod(month: int = 1) -> Dictionary:
	var season := season_label(month)
	var hours := 12.0
	match season:
		"winter":
			hours = 9.0
		"spring":
			hours = 12.5
		"summer":
			hours = 15.0
		"autumn":
			hours = 11.0
	var mult := clampf(0.75 + hours / 30.0, 0.85, 1.12)
	var label := "Daylight combat ×%.2f (%s · %.0fh)" % [mult, season, hours]
	return {"daylight_hours": hours, "season": season, "combat_mult": mult, "summary": label, "bbcode": "%s☀ Daylight[/color] %s— %s[/color]" % [COLOR_TECH, COLOR_MUTED, label], "empty": false}


## Choke + weather synergy (empty when not choke).
static func choke_weather_synergy(is_choke: bool = false, controller_friendly: bool = true, visibility: float = 1.0, precip: float = 0.0) -> Dictionary:
	if not is_choke:
		return {"empty": true, "summary": "", "bbcode": ""}
	var spot := naval_spot_weather_multiplier(visibility, precip)
	var control_mult := 1.12 if controller_friendly else 0.88
	var risk := clampf(precip * 0.5 + (1.0 - spot) * 0.4, 0.0, 1.0)
	var score := control_mult * (1.0 - risk * 0.3)
	var label := "Choke×wx score ×%.2f (ctrl %.2f · risk %.0f%%)" % [score, control_mult, risk * 100.0]
	return {"score": score, "control_mult": control_mult, "risk": risk, "empty": false, "summary": label, "bbcode": "%s🗺 Choke×wx[/color] %s— %s[/color]" % [COLOR_TECH, COLOR_MUTED, label]}


## Focus score with weather urgency boost.
static func focus_weather_aware_score(base_score: float = 50.0, focus_id: String = "", visibility: float = 1.0, precip: float = 0.0, ground_state: String = "dry") -> Dictionary:
	var pressure: Dictionary = weather_pressure_index(visibility, precip, ground_state)
	var p := float(pressure.get("pressure", 0.0))
	var fid := focus_id.strip_edges().to_lower()
	var boost := 0.0
	if p >= 0.4 and (fid.contains("indust") or fid.contains("armament") or fid.contains("military") or fid.contains("infra") or fid.contains("war")):
		boost = 8.0 + p * 12.0
	elif p >= 0.55 and (fid.contains("naval") or fid.contains("fleet") or fid.contains("convoy")):
		boost = 6.0 + p * 8.0
	var score := base_score + boost
	var label := "Focus wx · %s score %.0f (+%.0f)" % [focus_id if not focus_id.is_empty() else "focus", score, boost]
	return {"focus_id": focus_id, "base_score": base_score, "boost": boost, "score": score, "pressure": p, "summary": label, "bbcode": "%s◆ Focus wx[/color] %s— %s[/color]" % [COLOR_HEADER, COLOR_MUTED, label], "empty": false}


## HH quarterly rollup from trail (last ≤3 unique year/month windows; empty trail → "").
## Mirrors tools/map_generation/lib/hh_quarterly_rollup.py — used by GameData.format_hh_quarterly_rollup_plain.
static func format_hh_quarterly_rollup_from_trail(trail: Array, quarter_label: String = "") -> String:
	if trail.is_empty():
		return ""
	# Collect last up to 3 unique (year, month) keys from newest entries.
	var months: Array = []  # each: {"y": int, "m": int}
	var seen: Dictionary = {}
	for i in range(trail.size() - 1, -1, -1):
		if typeof(trail[i]) != TYPE_DICTIONARY:
			continue
		var e: Dictionary = trail[i]
		var y := int(e.get("year", 0))
		var m := int(e.get("month", 0))
		var key := "%d-%d" % [y, m]
		if seen.has(key):
			continue
		seen[key] = true
		months.append({"y": y, "m": m})
		if months.size() >= 3:
			break
	var month_set: Dictionary = {}
	for mk in months:
		month_set["%d-%d" % [int(mk["y"]), int(mk["m"])]] = true
	var window: Array = []
	for e in trail:
		if typeof(e) != TYPE_DICTIONARY:
			continue
		var d: Dictionary = e
		var key2 := "%d-%d" % [int(d.get("year", 0)), int(d.get("month", 0))]
		if months.is_empty() or month_set.has(key2):
			window.append(d)
	if window.is_empty():
		# Fallback: last 6 trail slots
		var start := maxi(0, trail.size() - 6)
		for j in range(start, trail.size()):
			if typeof(trail[j]) == TYPE_DICTIONARY:
				window.append(trail[j])
	if window.is_empty():
		return ""
	var classes: Dictionary = {}
	var total_inf := 0.0
	for e2 in window:
		var c := str((e2 as Dictionary).get("action_class", "influence"))
		classes[c] = int(classes.get(c, 0)) + 1
		total_inf += float((e2 as Dictionary).get("influence", (e2 as Dictionary).get("strength", 0.0)))
	var class_bits: PackedStringArray = []
	for k in classes.keys():
		class_bits.append("%s ×%d" % [str(k), int(classes[k])])
	var n := window.size()
	var avg := total_inf / float(maxi(1, n))
	var title := "Quarterly Hand rollup"
	if not quarter_label.is_empty():
		title = "%s · %s" % [quarter_label, title]
	var headline := "%s · events %d · classes %d · avg inf %.0f%%" % [
		title, n, classes.size(), avg * 100.0
	]
	var lines: PackedStringArray = [headline]
	for bit in class_bits:
		lines.append(str(bit))
	return "\n".join(lines)


## Compact ops dashboard from pilot summaries.
static func format_ops_dashboard(summaries: Array) -> Dictionary:
	var lines: PackedStringArray = []
	var bb: PackedStringArray = ["%s── Ops dashboard ──[/color]" % COLOR_HEADER]
	for s in summaries:
		var t := str(s).strip_edges()
		if t.is_empty():
			continue
		var first := t.split("\n")[0]
		lines.append(first)
		bb.append("%s· %s[/color]" % [COLOR_MUTED, first])
	if lines.is_empty():
		return {"empty": true, "plain": "", "bbcode": "", "summary": ""}
	return {
		"empty": false,
		"plain": "\n".join(lines),
		"bbcode": "\n".join(bb),
		"summary": lines[0],
		"count": lines.size(),
	}


## === Integrated multi-system packages (beyond theater-expand) ===

static func fleet_weather_mission_package(
	mission: String = "patrol",
	available_strength: float = 100.0,
	zone_relation: String = "contested",
	escort_need: float = 0.0,
	visibility: float = 1.0,
	precip: float = 0.0,
) -> Dictionary:
	var mission_l := mission.strip_edges().to_lower()
	var escort := escort_need
	var spot := naval_spot_weather_multiplier(visibility, precip)
	if precip > 0.55 or spot < 0.4:
		if mission_l in ["strike", "projection", "raid"]:
			mission_l = "patrol"
		escort = maxf(escort, 30.0)
	var tg: Dictionary = compose_fleet_task_group(available_strength, mission_l, zone_relation, escort)
	var label := "Fleet+wx package · %s · spot ×%.2f · primary %s" % [mission_l, spot, str(tg.get("primary_role", "?"))]
	tg["mission_effective"] = mission_l
	tg["spot_mult"] = spot
	tg["summary"] = label
	tg["bbcode"] = "%s🚢 Fleet+wx[/color] %s— %s[/color]" % [COLOR_TECH, COLOR_MUTED, label]
	tg["integration"] = ["fleet_task_group", "naval_weather"]
	return tg


static func assault_readiness_compose(
	targets: Array,
	attacker_power: float = 100.0,
	attacker_supply: float = 1.0,
	visibility: float = 1.0,
	precip: float = 0.0,
	ground_state: String = "dry",
	wind: float = 0.2,
) -> Dictionary:
	var morale: Dictionary = combat_morale_weather(visibility, precip, wind)
	var supply_m := weather_supply_multiplier(ground_state, precip)
	var eff_supply := maxf(0.2, attacker_supply * float(morale.get("morale_mult", 1.0)) * supply_m)
	var enriched: Array = []
	var wmult := weather_combat_multiplier(visibility, precip, wind)
	for t in targets:
		if typeof(t) != TYPE_DICTIONARY:
			continue
		var row: Dictionary = (t as Dictionary).duplicate()
		if not row.has("weather_mult"):
			row["weather_mult"] = wmult
		enriched.append(row)
	var ranked: Dictionary = rank_assault_targets(enriched, attacker_power, eff_supply, 5)
	if bool(ranked.get("empty", true)):
		return {"empty": true, "summary": "", "bbcode": ""}
	var best: Dictionary = ranked.get("best", {})
	var label := "Assault readiness · #%d win %.0f%% · supply×%.2f morale×%.2f" % [
		int(best.get("province_id", -1)), float(best.get("overall", 0.0)) * 100.0, supply_m, float(morale.get("morale_mult", 1.0))
	]
	return {
		"ranked": ranked,
		"best_province_id": int(ranked.get("best_province_id", -1)),
		"effective_supply": eff_supply,
		"supply_mult": supply_m,
		"morale_mult": float(morale.get("morale_mult", 1.0)),
		"empty": false,
		"summary": label,
		"bbcode": "%s⚔ Assault ready[/color] %s— %s[/color]" % [COLOR_HEADER, COLOR_MUTED, label],
		"integration": ["multi_front", "supply_wx", "morale_wx"],
	}


static func counter_ops_board(
	action_class: String = "influence",
	threat: float = 0.55,
	province_id: int = -1,
	network_strength: float = 0.3,
	available_agents: int = 4,
	loyalty: float = 0.5,
) -> Dictionary:
	if action_class.is_empty() and province_id < 0:
		return {"empty": true, "summary": "", "bbcode": ""}
	var esc: Dictionary = plan_agent_escalation(action_class, threat, network_strength, available_agents, loyalty)
	var threats: Array = [{"action_class": action_class, "influence": threat, "province_id": province_id, "active": true}]
	var cov: Dictionary = plan_agent_coverage(threats, available_agents, network_strength)
	if bool(esc.get("empty", true)) and bool(cov.get("empty", true)):
		return {"empty": true, "summary": "", "bbcode": ""}
	var label := "Counter-ops · L%d %s" % [int(esc.get("level", 0)), str(esc.get("top_action", "—"))]
	return {
		"escalation": esc,
		"coverage": cov,
		"empty": false,
		"summary": label,
		"bbcode": "%s◎ Counter-ops[/color] %s— %s[/color]" % [COLOR_HEADER, COLOR_MUTED, label],
		"integration": ["hh_signal", "escalation", "coverage"],
	}


static func format_hh_agenda_commitments_from_trail(trail: Array, max_commits: int = 3) -> String:
	if trail.is_empty():
		return ""
	var scored: Array = []
	for i in range(trail.size()):
		if typeof(trail[i]) != TYPE_DICTIONARY:
			continue
		var e: Dictionary = trail[i]
		var inf := float(e.get("influence", e.get("strength", 0.5)))
		var recency := float(i + 1) / float(maxi(1, trail.size()))
		scored.append({
			"action_class": str(e.get("action_class", "influence")),
			"province_id": int(e.get("province_id", -1)),
			"influence": inf,
			"score": inf * 0.7 + recency * 0.3,
		})
	if scored.is_empty():
		return ""
	scored.sort_custom(func(a, b): return float(a["score"]) > float(b["score"]))
	var lines: PackedStringArray = ["Agenda commits · %d" % mini(scored.size(), max_commits)]
	for j in range(mini(scored.size(), maxi(1, max_commits))):
		var c: Dictionary = scored[j]
		lines.append("%s @#%s (inf %.0f%%)" % [str(c["action_class"]), str(c["province_id"]), float(c["influence"]) * 100.0])
	return "\n".join(lines)


static func trade_supply_weather_chain(sea_trade_mult: float = 1.0, ground_state: String = "dry", precip: float = 0.0, route_risk: float = 0.0) -> Dictionary:
	var wx := weather_supply_multiplier(ground_state, precip)
	var health := clampf(sea_trade_mult * wx * (1.0 - route_risk * 0.25), 0.1, 1.4)
	var label := "Trade chain health ×%.2f (sea %.2f · wx %.2f · risk %.0f%%)" % [health, sea_trade_mult, wx, route_risk * 100.0]
	return {"health": health, "summary": label, "bbcode": "%s📦 Trade chain[/color] %s— %s[/color]" % [COLOR_TECH, COLOR_MUTED, label], "empty": false, "integration": ["trade", "supply", "weather"]}


static func supply_chain_health_compose(base_depot: float = 100.0, sea_mult: float = 1.0, ground_state: String = "dry", precip: float = 0.0, visibility: float = 1.0, route_risk: float = 0.0) -> Dictionary:
	var depot: Dictionary = depot_weather_capacity(base_depot, ground_state, precip)
	var sea_nav: Dictionary = sea_naval_weather_ops(sea_mult, visibility, precip)
	var health := clampf(float(depot.get("weather_mult", 1.0)) * float(sea_nav.get("combined", 1.0)) * (1.0 - route_risk * 0.2), 0.1, 1.5)
	var label := "Supply chain ×%.2f (depot wx %.2f · sea×nav %.2f)" % [health, float(depot.get("weather_mult", 1.0)), float(sea_nav.get("combined", 1.0))]
	return {"health": health, "summary": label, "bbcode": "%s🔗 Supply chain[/color] %s— %s[/color]" % [COLOR_TECH, COLOR_MUTED, label], "empty": false, "integration": ["depot", "sea_zone", "weather"]}


static func factory_risk_compose(temp: float = 10.0, precip: float = 0.0, ground_state: String = "dry", visibility: float = 1.0, wind: float = 0.2) -> Dictionary:
	var prod := weather_production_multiplier(temp, precip)
	var wear: Dictionary = infra_weather_wear(ground_state, precip)
	var pressure: Dictionary = weather_pressure_index(visibility, precip, ground_state, wind)
	var risk := clampf((1.0 - prod) * 0.5 + float(pressure.get("pressure", 0.0)) * 0.35 + (1.0 - float(wear.get("wear_factor", 1.0))) * 0.3, 0.0, 1.0)
	var label := "Factory risk %.0f%% · prod ×%.2f · wear ×%.2f" % [risk * 100.0, prod, float(wear.get("wear_factor", 1.0))]
	return {"risk": risk, "summary": label, "bbcode": "[color=#f87171]🏭 Factory risk[/color] %s— %s[/color]" % [COLOR_MUTED, label], "empty": false, "severe": risk >= 0.45}


static func format_campaign_strip(summaries: Array, max_lines: int = 6) -> Dictionary:
	var lines: PackedStringArray = []
	for s in summaries:
		var t := str(s).strip_edges()
		if t.is_empty():
			continue
		lines.append(t.split("\n")[0])
		if lines.size() >= max_lines:
			break
	if lines.is_empty():
		return {"empty": true, "plain": "", "bbcode": "", "summary": ""}
	var bb: PackedStringArray = ["%s── Campaign strip ──[/color]" % COLOR_HEADER]
	for ln in lines:
		bb.append("%s· %s[/color]" % [COLOR_MUTED, ln])
	return {
		"empty": false,
		"plain": "\n".join(lines),
		"bbcode": "\n".join(bb),
		"summary": "Campaign strip · %d" % lines.size(),
		"count": lines.size(),
		"integration": ["multi"],
	}


static func choke_sea_weather_package(is_choke: bool = true, controller_friendly: bool = true, sea_mult: float = 1.0, visibility: float = 1.0, precip: float = 0.0) -> Dictionary:
	var sea_nav: Dictionary = sea_naval_weather_ops(sea_mult, visibility, precip)
	var choke: Dictionary = choke_weather_synergy(is_choke, controller_friendly, visibility, precip)
	var score := float(choke.get("score", 1.0)) * float(sea_nav.get("combined", 1.0))
	var label := "Choke×sea×wx · score %.2f · sea×nav %.2f" % [score, float(sea_nav.get("combined", 1.0))]
	if bool(choke.get("empty", false)) and not is_choke:
		label = "Sea×wx only · %s" % str(sea_nav.get("summary", ""))
	return {"combined_score": score, "summary": label, "bbcode": "%s🗺 Choke×sea×wx[/color] %s— %s[/color]" % [COLOR_TECH, COLOR_MUTED, label], "empty": false, "integration": ["choke", "sea_zone", "weather"]}


static func air_ops_package(visibility: float = 1.0, precip: float = 0.0, wind: float = 0.2, month: int = 1) -> Dictionary:
	var ready: Dictionary = air_sortie_weather_readiness(visibility, precip, wind)
