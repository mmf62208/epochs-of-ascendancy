	if not pick.strip_edges().is_empty():
		urgency += 0.25
	urgency = clampf(urgency, 0.0, 1.0)
	var label := "War path urgency %.0f%% · focus %s · pick %s" % [
		urgency * 100.0, focus_id, "yes" if not pick.strip_edges().is_empty() else "none"
	]
	return {
		"urgency": urgency,
		"summary": label,
		"label": label,
