	elif assault_score < 0.45:
		step = "assault"
		reason = "no strong follow-on assault target"
	elif ready:
		step = "sustain"
		reason = "front ready — sustain force/logistics"
	var action_id := "front_continuity_combat"
	var leaf := "apply_assault"
	match step:
		"assault":
			action_id = "front_continuity_assault"
			leaf = "apply_assault"
		"sustain":
			action_id = "front_continuity_sustain"
			leaf = "apply_supply"
	return {"step": step, "action_id": action_id, "leaf": leaf, "reason": reason, "empty": false, "summary": "Recommend %s · %s" % [step, reason]}

static func front_continuity_campaign_product(province_id: int = 1) -> Dictionary:
	var combat: Dictionary = multi_phase_combat_product(100.0, 80.0, 0.85, 1.0, province_id)
	var logistics: Dictionary = logistics_supply_theater_product(province_id)
	var ready: Dictionary = force_readiness_day(80.0, 0.85, 0.7, 0.3, "mud", 0.3, 6, 80.0, province_id)
	var theater: Dictionary = theater_command_product(province_id)
	var combat_score := clampf(float(combat.get("score", 0.5)), 0.0, 1.0)
	if combat_score < 0.35: combat_score = 0.35
	var assault_score := clampf(0.55 * combat_score + 0.45 * float(theater.get("score", 0.5)), 0.0, 1.0)
	if assault_score < 0.35: assault_score = 0.35
	var sustain_score := clampf(0.4 * float(ready.get("score", 0.5)) + 0.35 * float(logistics.get("score", 0.5)) + 0.25 * float(theater.get("score", 0.5)), 0.0, 1.0)
	if sustain_score < 0.35: sustain_score = 0.35
	var score := clampf(0.35 * combat_score + 0.35 * assault_score + 0.3 * sustain_score, 0.0, 1.0)
	if score < 0.35: score = 0.35
	var rec: Dictionary = recommend_front_step(combat_score, assault_score, combat_score >= 0.45 and assault_score >= 0.45)
	var steps: Array = [
		{"step": "combat", "action_id": "front_continuity_combat", "leaf": "apply_assault", "label": "Step 0 — multi-phase combat board", "score": combat_score},
		{"step": "assault", "action_id": "front_continuity_assault", "leaf": "apply_assault", "label": "Step 1 — assault follow-on rank", "score": assault_score},
		{"step": "sustain", "action_id": "front_continuity_sustain", "leaf": "apply_supply", "label": "Step 2 — force/logistics sustain", "score": sustain_score},
	]
	var day_rows: Array = []
	var apply_queue: Array = []
	for i in range(steps.size()):
		var st: Dictionary = steps[i]
		var step_name := str(st.get("step"))
		var recommended: bool = step_name == str(rec.get("step"))
		var sc := float(st.get("score", 0.5))
		var leaf := str(st.get("leaf"))
		var lab := str(st.get("label"))
		if recommended: lab = "★ " + lab
		lab = "%s · score %.2f" % [lab, sc]
		day_rows.append({"index": i, "step": step_name, "action_id": str(st.get("action_id")), "leaf_action": leaf, "label": lab, "score": sc, "enabled": true, "recommended": recommended, "province_id": province_id})
		apply_queue.append({"action_id": leaf, "province_id": province_id, "score": sc, "enabled": true, "label": lab, "step": step_name, "product_action": str(st.get("action_id"))})
	var actions: Array = [
		{"action_id": "front_continuity_campaign_product", "label": "Run front continuity campaign product", "enabled": true},
		{"action_id": str(rec.get("action_id", "front_continuity_combat")), "label": "Recommended: %s" % str(rec.get("step", "combat")), "enabled": true},
	]
	for row2 in day_rows:
		actions.append({"action_id": str(row2.get("action_id")), "label": str(row2.get("label")), "enabled": true, "step": str(row2.get("step"))})
	var label := "Front continuity · combat %.2f · assault %.2f · sustain %.2f · score %.2f" % [combat_score, assault_score, sustain_score, score]
	return {
		"combat": combat, "logistics": logistics, "ready": ready, "theater": theater,
		"combat_score": combat_score, "assault_score": assault_score, "sustain_score": sustain_score,
		"recommendation": rec, "day_rows": day_rows, "apply_queue": apply_queue, "actions": actions,
		"score": score, "front_score": score, "province_id": province_id,
		"summary": label, "plain": label,
		"bbcode": "%s⚔ Front continuity[/color] %s— %s[/color]" % [COLOR_HEADER, COLOR_MUTED, label],
		"empty": false,
		"integration": ["front_continuity_campaign_product", "front_continuity_combat", "front_continuity_assault", "front_continuity_sustain", "major_23", "front", "combat"],
	}

static func execute_front_continuity_step(step: String = "combat", province_id: int = 1) -> Dictionary:
	var s := step.strip_edges().to_lower()
	if s.begins_with("front_continuity_"):
		s = s.replace("front_continuity_", "")
	if s not in ["combat", "assault", "sustain"]:
		s = "combat"
	var product: Dictionary = front_continuity_campaign_product(province_id)
	var row: Dictionary = {}
	for r in product.get("day_rows", []):
		if r is Dictionary and str(r.get("step")) == s:
			row = r
			break
	var leaf := str(row.get("leaf_action", "apply_assault"))
	var action_id := "front_continuity_combat"
	match s:
		"assault": action_id = "front_continuity_assault"
		"sustain": action_id = "front_continuity_sustain"
	var sc := float(row.get("score", product.get("score", 0.5)))
	var label := "Execute front continuity %s · leaf %s · score %.2f" % [s, leaf, sc]
	return {"step": s, "leaf_action": leaf, "action_id": action_id, "ok": true, "score": sc, "province_id": province_id,
		"apply_queue": [{"action_id": leaf, "province_id": province_id, "score": sc, "enabled": true, "label": label, "step": s, "product_action": action_id}],
		"summary": label, "plain": label, "bbcode": "%s⚔ Front %s[/color] %s— %s[/color]" % [COLOR_HEADER, s, COLOR_MUTED, label], "empty": false,
		"integration": ["execute_front_continuity_step", s, leaf]}

