	if counter_score < 0.35:
		counter_score = 0.35
	var counterplay_score := clampf(0.5 * float(hh.get("score", 0.5)) + 0.3 * coverage_score + 0.2 * float(diplo.get("leverage_score", diplo.get("score", 0.5))), 0.0, 1.0)
