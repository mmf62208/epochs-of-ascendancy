## Fleet task-group composition (SCREEN/STRIKE/SUPPORT).
static func compose_fleet_task_group(
	available_strength: float = 100.0,
	mission: String = "patrol",
	zone_relation: String = "contested",
	escort_need: float = 0.0,
) -> Dictionary:
	var strength := maxf(0.0, available_strength)
	var mission_l := mission.strip_edges().to_lower()
	var rel := zone_relation.strip_edges().to_lower()
	var weights := {"SCREEN": 0.40, "STRIKE": 0.35, "SUPPORT": 0.25}
	if mission_l in ["convoy", "escort", "cover"]:
		weights = {"SCREEN": 0.55, "STRIKE": 0.20, "SUPPORT": 0.25}
	elif mission_l in ["strike", "projection", "raid"]:
		weights = {"SCREEN": 0.25, "STRIKE": 0.55, "SUPPORT": 0.20}
	elif mission_l in ["refuel", "base", "hold"]:
		weights = {"SCREEN": 0.30, "STRIKE": 0.15, "SUPPORT": 0.55}
	if rel == "hostile":
		weights["SCREEN"] = float(weights["SCREEN"]) + 0.10
		weights["STRIKE"] = float(weights["STRIKE"]) + 0.05
	elif rel == "friendly":
		weights["SUPPORT"] = float(weights["SUPPORT"]) + 0.08
	if escort_need >= 25.0:
		weights["SCREEN"] = float(weights["SCREEN"]) + 0.15
	var total_w := 0.0
	for k in weights.keys():
		total_w += float(weights[k])
	if total_w <= 0.0:
		total_w = 1.0
	var alloc := {}
	var primary := "SCREEN"
	var best_a := -1.0
	for role in ["SCREEN", "STRIKE", "SUPPORT"]:
		var a := strength * (float(weights.get(role, 0.0)) / total_w)
		alloc[role] = a
		if a > best_a:
			best_a = a
			primary = role
	var summary := "Task group · primary %s · strength %.0f · %s" % [primary, strength, mission_l]
	return {
		"mission": mission_l,
		"allocation": alloc,
		"primary_role": primary,
		"available_strength": strength,
		"empty": strength <= 0.0,
		"summary": summary,
		"bbcode": "%s🚢 Task group[/color] %s— %s · %s[/color]" % [COLOR_TECH, COLOR_MUTED, primary, mission_l],
	}


## Multi-front assault priority rank.
static func rank_assault_targets(targets: Array, attacker_power: float = 100.0, attacker_supply: float = 1.0, max_targets: int = 5) -> Dictionary:
	var scored: Array = []
	for t in targets:
		if typeof(t) != TYPE_DICTIONARY:
			continue
		var pid := int(t.get("province_id", t.get("id", -1)))
		if pid < 0:
			continue
		var dfn := maxf(0.1, float(t.get("defender_power", t.get("defense", 80.0))))
		var wmult := clampf(float(t.get("weather_mult", 1.0)), 0.2, 1.2)
		var est: Dictionary = estimate_multi_phase_combat(attacker_power, dfn, attacker_supply, wmult)
		var overall := float(est.get("overall_attacker_win_chance", 0.0))
		var priority := overall * 100.0 + (100.0 / dfn)
		var rec := "press" if overall >= 0.65 else ("marginal" if overall >= 0.45 else "avoid")
		scored.append({
			"province_id": pid,
			"defender_power": dfn,
			"weather_mult": wmult,
			"overall": overall,
			"priority": priority,
			"recommendation": rec,
		})
	scored.sort_custom(func(a, b): return float(a["priority"]) > float(b["priority"]))
	if scored.is_empty():
		return {"targets": [], "best_province_id": -1, "empty": true, "summary": "", "count": 0}
	var top: Array = []
	for i in range(mini(scored.size(), maxi(1, max_targets))):
		top.append(scored[i])
	var best: Dictionary = top[0]
	var summary := "Assault priority · #%d win %.0f%% · %s" % [int(best["province_id"]), float(best["overall"]) * 100.0, str(best["recommendation"])]
	return {
		"targets": top,
		"best_province_id": int(best["province_id"]),
		"best": best,
		"empty": false,
		"summary": summary,
		"count": scored.size(),
		"bbcode": "%s⚔ Front priority[/color] %s— #%d · %.0f%%[/color]" % [COLOR_HEADER, COLOR_MUTED, int(best["province_id"]), float(best["overall"]) * 100.0],
	}


## Agent escalation ladder.
static func plan_agent_escalation(
	action_class: String = "influence",
	threat: float = 0.55,
	network_strength: float = 0.3,
	available_agents: int = 3,
	loyalty: float = 0.5,
) -> Dictionary:
	var ladder := ["monitor", "counterintel", "network_expand", "sabotage_defense", "active_disruption", "emergency_lockdown"]
	var level := int(clampf(threat * 4.0 + (0.5 - network_strength) * 2.0 + (0.5 - loyalty) * 1.5, 0.0, 5.0))
	if available_agents <= 0:
		level = mini(level, 1)
	var steps: Array = []
	for i in range(ladder.size()):
		if i > level:
			break
		steps.append({"step": i, "action": ladder[i], "active": i == level})
	if steps.is_empty():
		return {"steps": [], "empty": true, "summary": "", "level": 0}
	var top: Dictionary = steps[steps.size() - 1]
	var summary := "Escalation L%d · %s (threat %.0f%%)" % [level, str(top["action"]), threat * 100.0]
	return {
		"steps": steps,
		"level": level,
		"top_action": str(top["action"]),
		"empty": false,
		"summary": summary,
		"bbcode": "%s◎ Escalation L%d[/color] %s— %s[/color]" % [COLOR_HEADER, level, COLOR_MUTED, str(top["action"])],
	}


## Campaign day risk.
static func campaign_day_risk(visibility: float = 1.0, precip: float = 0.0, ground_state: String = "dry", wind: float = 0.2, month: int = 1) -> Dictionary:
	var pressure: Dictionary = weather_pressure_index(visibility, precip, ground_state, wind)
	var season := season_label(month)
	var bump := 0.12 if season == "winter" else (0.05 if season == "autumn" else 0.0)
	var risk := clampf(float(pressure.get("pressure", 0.0)) + bump, 0.0, 1.0)
	var label := "Campaign day risk %.0f%% · %s · pressure %.0f%%" % [risk * 100.0, season, float(pressure.get("pressure", 0.0)) * 100.0]
	return {
		"risk": risk,
		"season": season,
		"pressure": float(pressure.get("pressure", 0.0)),
		"label": label,
		"summary": label,
		"severe": risk >= 0.55,
		"empty": false,
		"bbcode": "[color=#f87171]📅 Day risk[/color] %s— %s[/color]" % [COLOR_MUTED, label],
	}


## Convoy weather window — best day by spot/supply.
static func convoy_weather_window(day_entries: Array) -> Dictionary:
	var scored: Array = []
	for i in range(day_entries.size()):
		var w = day_entries[i]
		if typeof(w) != TYPE_DICTIONARY:
			continue
		var spot := naval_spot_weather_multiplier(float(w.get("visibility", 1.0)), float(w.get("precip_intensity", 0.0)))
		var supply := weather_supply_multiplier(str(w.get("ground_state", "dry")), float(w.get("precip_intensity", 0.0)))
		var score := spot * 0.55 + supply * 0.45
		scored.append({"day_index": int(w.get("day_index", i)), "score": score, "spot": spot, "supply": supply})
	scored.sort_custom(func(a, b): return float(a["score"]) > float(b["score"]))
	if scored.is_empty():
		return {"best_day": -1, "empty": true, "summary": ""}
	var best: Dictionary = scored[0]
	var label := "Convoy window · day %d score %.2f (spot ×%.2f)" % [int(best["day_index"]), float(best["score"]), float(best["spot"])]
	return {"best_day": int(best["day_index"]), "best": best, "empty": false, "summary": label, "bbcode": "%s⛵ Convoy window[/color] %s— %s[/color]" % [COLOR_TECH, COLOR_MUTED, label]}


