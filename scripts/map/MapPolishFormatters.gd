## ---------------------------------------------------------------------------

static func recommend_diplomacy_step(board_score: float = 0.5, leverage_ready: bool = false, settle_ready: bool = false) -> Dictionary:
	var step := "leverage"
	var reason := "refresh leverage tools"
	if board_score < 0.4:
		step = "board"
		reason = "pressure board weak — rescan economy/trade"
	elif not leverage_ready:
		step = "leverage"
		reason = "need agent/HH leverage"
	elif settle_ready:
		step = "settle"
		reason = "leverage enough — settle path"
	var action_id := "diplomacy_peace_board"
	var leaf := "apply_focus"
	match step:
		"leverage":
			action_id = "diplomacy_peace_leverage"
			leaf = "apply_agent_dispatch"
		"settle":
			action_id = "diplomacy_peace_settle"
			leaf = "apply_hh_commit"
	return {"step": step, "action_id": action_id, "leaf": leaf, "reason": reason, "empty": false, "summary": "Recommend %s · %s" % [step, reason]}

static func diplomacy_peace_campaign_product(province_id: int = 1) -> Dictionary:
	var economy: Dictionary = war_economy_day_package(10.0, 0.3, "mud", 0.7, 0.3)
	var trade: Dictionary = trade_chain_day(1.0, province_id)
	var decision: Dictionary = campaign_decision_day([], province_id)
	var agent: Dictionary = agent_campaign_product([], 5, 0.35, 0.5, province_id)
	var hh: Dictionary = hh_multi_month_agenda_product([], "all", province_id, 4)
	var focus: Dictionary = focus_war_path_product(province_id, "industrial_effort")
	var board_score := clampf(0.4 * float(economy.get("score", 0.5)) + 0.3 * float(trade.get("score", 0.5)) + 0.3 * float(decision.get("score", 0.5)), 0.0, 1.0)
	if board_score < 0.35:
		board_score = 0.35
	var leverage_score := clampf(0.5 * float(agent.get("score", 0.5)) + 0.5 * float(hh.get("score", 0.5)), 0.0, 1.0)
	if leverage_score < 0.35:
		leverage_score = 0.35
	var settle_score := clampf(0.45 * float(focus.get("score", 0.5)) + 0.55 * leverage_score, 0.0, 1.0)
	if settle_score < 0.35:
		settle_score = 0.35
	var score := clampf(0.35 * board_score + 0.35 * leverage_score + 0.3 * settle_score, 0.0, 1.0)
	if score < 0.35:
		score = 0.35
	var rec: Dictionary = recommend_diplomacy_step(board_score, leverage_score >= 0.4, settle_score >= 0.4 and leverage_score >= 0.4)
	var steps: Array = [
		{"step": "board", "action_id": "diplomacy_peace_board", "leaf": "apply_focus", "label": "Step 0 — diplomatic board / pressure", "score": board_score},
		{"step": "leverage", "action_id": "diplomacy_peace_leverage", "leaf": "apply_agent_dispatch", "label": "Step 1 — leverage agent / HH", "score": leverage_score},
		{"step": "settle", "action_id": "diplomacy_peace_settle", "leaf": "apply_hh_commit", "label": "Step 2 — settle / path commit", "score": settle_score},
	]
	var day_rows: Array = []
	var apply_queue: Array = []
	for i in range(steps.size()):
		var st: Dictionary = steps[i]
		var step_name := str(st.get("step"))
		var recommended: bool = step_name == str(rec.get("step"))
		var sc := float(st.get("score", 0.5))
		var leaf := str(st.get("leaf"))
		var lab := str(st.get("label"))
		if recommended:
			lab = "★ " + lab
		lab = "%s · score %.2f" % [lab, sc]
		day_rows.append({"index": i, "step": step_name, "action_id": str(st.get("action_id")), "leaf_action": leaf, "label": lab, "score": sc, "enabled": true, "recommended": recommended, "province_id": province_id})
		apply_queue.append({"action_id": leaf, "province_id": province_id, "score": sc, "enabled": true, "label": lab, "step": step_name, "product_action": str(st.get("action_id"))})
	var actions: Array = [
		{"action_id": "diplomacy_peace_campaign_product", "label": "Run diplomacy peace campaign product", "enabled": true},
		{"action_id": str(rec.get("action_id", "diplomacy_peace_board")), "label": "Recommended: %s" % str(rec.get("step", "board")), "enabled": true},
	]
	for row2 in day_rows:
		actions.append({"action_id": str(row2.get("action_id")), "label": str(row2.get("label")), "enabled": true, "step": str(row2.get("step"))})
	var label := "Diplomacy peace campaign · board %.2f · leverage %.2f · settle %.2f · score %.2f" % [board_score, leverage_score, settle_score, score]
	return {
		"economy": economy, "trade": trade, "decision": decision, "agent": agent, "hh": hh, "focus": focus,
		"board_score": board_score, "leverage_score": leverage_score, "settle_score": settle_score,
		"recommendation": rec, "day_rows": day_rows, "apply_queue": apply_queue, "actions": actions,
		"score": score, "diplomacy_score": score, "province_id": province_id,
		"summary": label, "plain": label,
		"bbcode": "%s🕊 Diplomacy peace[/color] %s— %s[/color]" % [COLOR_HEADER, COLOR_MUTED, label],
		"empty": false,
		"integration": ["diplomacy_peace_campaign_product", "diplomacy_peace_board", "diplomacy_peace_leverage", "diplomacy_peace_settle", "major_16", "diplomacy", "peace"],
	}

static func execute_diplomacy_peace_step(step: String = "board", province_id: int = 1) -> Dictionary:
	var s := step.strip_edges().to_lower()
	if s.begins_with("diplomacy_peace_"):
		s = s.replace("diplomacy_peace_", "")
	if s not in ["board", "leverage", "settle"]:
		s = "board"
	var product: Dictionary = diplomacy_peace_campaign_product(province_id)
	var row: Dictionary = {}
	for r in product.get("day_rows", []):
		if r is Dictionary and str(r.get("step")) == s:
			row = r
			break
	var leaf := str(row.get("leaf_action", "apply_focus"))
	var action_id := "diplomacy_peace_board"
	match s:
		"leverage":
			action_id = "diplomacy_peace_leverage"
		"settle":
			action_id = "diplomacy_peace_settle"
	var score := float(row.get("score", product.get("score", 0.5)))
	var apply_queue: Array = [{"action_id": leaf, "province_id": province_id, "score": score, "enabled": true, "label": str(row.get("label", s)), "step": s, "product_action": action_id}]
	var label := "Execute diplomacy %s · leaf %s · score %.2f" % [s, leaf, score]
	return {"step": s, "leaf_action": leaf, "action_id": action_id, "apply_queue": apply_queue, "score": score, "province_id": province_id, "summary": label, "plain": label, "bbcode": "%s🕊 Diplomacy %s[/color] %s— %s[/color]" % [COLOR_HEADER, s, COLOR_MUTED, label], "empty": false, "ok": true, "integration": ["execute_diplomacy_peace_step", s, leaf]}

