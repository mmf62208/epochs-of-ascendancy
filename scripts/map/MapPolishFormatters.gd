static func theater_daily_brief(
	visibility: float = 1.0,
	precip: float = 0.0,
	temp: float = 10.0,
	ground_state: String = "dry",
	wind: float = 0.2,
	month: int = 6,
	trail: Array = [],
) -> Dictionary:
	var fleet: Dictionary = theater_fleet_auto_command([], visibility, precip)
	var combat: Dictionary = theater_combat_auto_command([], visibility, precip, month)
	var prod: Dictionary = theater_production_auto(temp, precip, ground_state, visibility, wind)
	var supply: Dictionary = theater_supply_auto("port", 1.0, ground_state, precip, visibility)
	var hh: Dictionary = theater_hh_auto_commit(trail)
	var parts: Array = [fleet, combat, prod, supply]
	if not bool(hh.get("empty", true)):
		parts.append(hh)
	var score := 0.0
	var lines: PackedStringArray = []
	for p in parts:
		score += float(p.get("score", 0.0))
		var s := str(p.get("summary", "")).strip_edges()
		if not s.is_empty():
			lines.append(s)
	score /= float(maxi(1, parts.size()))
	var label := "Theater daily brief · %d domains · score %.2f" % [parts.size(), score]
	return {
		"fleet": fleet,
		"combat": combat,
		"production": prod,
		"supply": supply,
		"hh": hh,
		"lines": Array(lines),
		"count": parts.size(),
		"score": score,
		"summary": label,
		"plain": "\n".join(PackedStringArray([label]) + lines),
		"bbcode": "%s📋 Theater brief[/color] %s— %s[/color]" % [COLOR_HEADER, COLOR_MUTED, label],
		"empty": false,
		"integration": ["fleet_auto", "combat_auto", "prod_auto", "supply_auto"],
	}


static func order_queue_board(
	visibility: float = 1.0,
	precip: float = 0.0,
	temp: float = 10.0,
	ground_state: String = "dry",
	wind: float = 0.2,
	month: int = 6,
	trail: Array = [],
) -> Dictionary:
	var fleet: Dictionary = theater_fleet_auto_command([], visibility, precip)
	var combat: Dictionary = theater_combat_auto_command([], visibility, precip, month)
	var prod: Dictionary = theater_production_auto(temp, precip, ground_state, visibility, wind)
	var supply: Dictionary = theater_supply_auto("port", 1.0, ground_state, precip, visibility)
	var items: Array = []
	for pair in [
		[fleet.get("top", {}), "fleet"],
		[combat.get("top", {}), "combat"],
		[prod.get("top", {}), "production"],
		[supply.get("top", {}), "supply"],
	]:
		var src: Dictionary = pair[0]
		var domain: String = str(pair[1])
		if src.is_empty() or bool(src.get("empty", false)):
			continue
		var plan: Dictionary = src.get("plan", {})
		items.append({
			"domain": domain,
			"plan": plan,
			"score": float(src.get("score", plan.get("score", 0.0))),
			"summary": str(src.get("summary", "")),
			"apply_ready": bool(plan.get("apply_ready", false)),
			"api": str(plan.get("api", "")),
			"order": str(plan.get("order", "")),
		})
	var hh: Dictionary = theater_hh_auto_commit(trail)
	if not bool(hh.get("empty", true)):
		var planh: Dictionary = hh.get("plan", {})
		items.append({
			"domain": "hh",
			"plan": planh,
			"score": float(hh.get("score", 0.0)),
			"summary": str(hh.get("summary", "")),
			"apply_ready": bool(planh.get("apply_ready", false)),
			"api": str(planh.get("api", "")),
			"order": str(planh.get("order", "")),
		})
	items.sort_custom(func(a, b): return float(a.get("score", 0.0)) > float(b.get("score", 0.0)))
	var label := "Order queue · %d pending" % items.size()
	return {
		"items": items,
		"count": items.size(),
		"top": items[0] if items.size() > 0 else {},
		"score": float(items[0].get("score", 0.0)) if items.size() > 0 else 0.0,
		"summary": label,
		"bbcode": "%s☰ Order queue[/color] %s— %s[/color]" % [COLOR_HEADER, COLOR_MUTED, label],
		"empty": items.is_empty(),
		"integration": ["theater_auto", "queue"],
	}


static func execute_one_order(
	visibility: float = 1.0,
	precip: float = 0.0,
	temp: float = 10.0,
	ground_state: String = "dry",
	wind: float = 0.2,
	month: int = 6,
	trail: Array = [],
	prefer_apply_ready: bool = true,
) -> Dictionary:
	var board: Dictionary = order_queue_board(visibility, precip, temp, ground_state, wind, month, trail)
	var items: Array = board.get("items", [])
	var pick: Dictionary = {}
	if prefer_apply_ready:
		for i in items:
			if bool(i.get("apply_ready", false)):
				pick = i
				break
	if pick.is_empty() and items.size() > 0:
		pick = items[0]
	if pick.is_empty():
		return {"empty": true, "plain": "", "bbcode": "", "summary": "", "score": 0.0}
	var label := "Execute-one · %s · %s" % [str(pick.get("domain", "")), str(pick.get("api", "")).substr(0, 40)]
	return {
		"pick": pick,
		"domain": pick.get("domain"),
		"plan": pick.get("plan", {}),
		"api": pick.get("api"),
		"order": pick.get("order"),
		"apply_ready": bool(pick.get("apply_ready")),
		"score": float(pick.get("score", 0.0)),
		"summary": label,
		"plain": "%s\n%s" % [label, str(pick.get("order", ""))],
		"bbcode": "%s▶ Execute-one[/color] %s— %s[/color]" % [COLOR_HEADER, COLOR_MUTED, label],
		"empty": false,
		"integration": ["order_queue", "execute_one"],
	}


