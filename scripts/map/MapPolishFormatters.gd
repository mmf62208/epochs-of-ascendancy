static func recommend_occupation_step(control_score: float = 0.5, garrison_score: float = 0.5, ready: bool = false) -> Dictionary:
	var step := "garrison"
	var reason := "refresh garrison"
	if control_score < 0.45:
		step = "control"
		reason = "control thin — re-board occupation"
	elif garrison_score < 0.45:
		step = "garrison"
		reason = "garrison insecure — secure province"
	elif ready:
		step = "integrate"
		reason = "secure — integrate economy/front"
	var action_id := "occupation_control_board"
	var leaf := "apply_station"
	match step:
		"garrison":
			action_id = "occupation_control_garrison"
			leaf = "apply_assault"
		"integrate":
			action_id = "occupation_control_integrate"
			leaf = "apply_production"
	return {"step": step, "action_id": action_id, "leaf": leaf, "reason": reason, "empty": false, "summary": "Recommend %s · %s" % [step, reason]}

