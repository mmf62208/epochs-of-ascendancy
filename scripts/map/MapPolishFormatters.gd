## Product combat UI: ordered phase_rows + ribbon + apply_ready (mirrors product_depth.multi_phase_combat_ui_product).
static func multi_phase_combat_ui_product(
	attacker_power: float = 100.0,
	defender_power: float = 80.0,
	attacker_supply: float = 0.85,
	weather_mult: float = 1.0,
	province_id: int = -1,
) -> Dictionary:
	var est: Dictionary = estimate_multi_phase_combat(attacker_power, defender_power, attacker_supply, weather_mult)
	var phase_rows: Array = []
	var phases: Array = est.get("phases", [])
	for i in range(phases.size()):
		var r: Dictionary = phases[i] if phases[i] is Dictionary else {}
		var phase := str(r.get("phase", "engage"))
		var win := float(r.get("attacker_win_chance", 0.0))
		phase_rows.append({
			"index": i,
			"phase": phase,
			"win_chance": win,
			"attacker_effective": float(r.get("attacker_effective", 0.0)),
			"defender_effective": float(r.get("defender_effective", 0.0)),
			"label": "%s · win %.0f%% · atk×%.0f def×%.0f" % [
				phase, win * 100.0, float(r.get("attacker_effective", 0.0)), float(r.get("defender_effective", 0.0))
			],
		})
	var overall := float(est.get("overall_attacker_win_chance", 0.0))
	var apply_ready := overall >= 0.35 and attacker_power > 0.0
	var score := overall * (0.85 + 0.15 * weather_mult)
	var ribbon := format_combat_phase_ribbon_plain(attacker_power, defender_power, attacker_supply, weather_mult)
	var label := "Combat UI · %d phases · overall %.0f%% · wx×%.2f" % [phase_rows.size(), overall * 100.0, weather_mult]
	if province_id >= 0:
		label += " · #%d" % province_id
	var plain_lines: PackedStringArray = [label, ribbon]
	for row in phase_rows:
		plain_lines.append(str(row.get("label", "")))
	return {
		"estimate": est,
		"phase_rows": phase_rows,
		"phase_count": phase_rows.size(),
		"overall": overall,
		"weather_mult": weather_mult,
		"attacker_power": attacker_power,
		"defender_power": defender_power,
		"ribbon": ribbon,
		"score": score,
		"apply_ready": apply_ready,
		"actions": [{
			"action_id": "apply_assault",
			"label": "Stage multi-phase assault",
			"enabled": apply_ready,
			"api": "MapManager.apply_assault_stage_mutation",
		}],
		"summary": label,
		"plain": "\n".join(plain_lines),
		"bbcode": "%s⚔ Combat UI[/color] %s— %s[/color]" % [COLOR_HEADER, COLOR_MUTED, label],
		"empty": phase_rows.is_empty(),
	}


## Fleet autonomy plan (mirrors product_depth.fleet_autonomy_plan).
static func fleet_autonomy_plan(
	zone_count: int = 3,
	fuel_level: float = 0.7,
	basing_level: String = "port",
	zone_relation: String = "contested",
	available_strength: float = 100.0,
	country_tag: String = "ENG",
) -> Dictionary:
	if zone_count <= 0:
		return {
			"empty": true,
			"plain": "",
			"bbcode": "",
			"summary": "",
			"score": 0.0,
			"apply_ready": false,
			"actions": [],
		}
	var fuel := clampf(fuel_level, 0.0, 1.2)
	var task: Dictionary = rank_naval_orders(basing_level, 2, zone_relation, fuel)
	var best_order := "SEARCH_PATROL"
	var best_score := 50.0
	if not task.is_empty():
		best_order = str(task.get("best_order", task.get("best_posture", best_order)))
		best_score = float(task.get("best_score", task.get("score", best_score)))
	if best_score <= 0.0:
		best_score = 40.0 + 20.0 * fuel
	var best_norm := best_score / 100.0 if best_score > 2.0 else best_score
	best_norm = clampf(best_norm, 0.0, 1.0)
	var coverage := clampf(available_strength / 100.0, 0.2, 1.0)
	if zone_relation == "hostile":
		coverage *= 0.75
	elif zone_relation == "contested":
		coverage *= 0.9
	var chosen := best_order
	var action_id := "apply_station"
	var apply_ready := true
	var reason := "tasking preference"
	if fuel < 0.25:
		chosen = "HOLD_BASE"
		action_id = "apply_station"
		apply_ready = false
		reason = "fuel critically low"
	elif fuel < 0.45:
		if best_order in ["STRIKE", "SEARCH_AND_DESTROY"]:
			chosen = "SEARCH_PATROL"
		reason = "fuel conserving posture"
	elif best_order == "ESCORT" or coverage < 0.45:
		chosen = "ESCORT"
		action_id = "apply_supply"
		reason = "escort/convoy priority"
	var score := (best_norm * 0.5 + coverage * 0.3 + fuel * 0.2) * (0.6 if fuel < 0.45 else 1.0)
	score = clampf(score, 0.05, 1.0)
	var label := "Fleet autonomy · %s · fuel %.0f%% · score %.2f · %s" % [
		chosen, fuel * 100.0, score, country_tag if not country_tag.is_empty() else "?"
	]
	return {
		"chosen_order": chosen,
		"best_order": best_order,
		"fuel_level": fuel,
		"score": score,
		"apply_ready": apply_ready,
		"reason": reason,
		"zone_count": zone_count,
		"actions": [
			{"action_id": action_id, "label": "Apply fleet autonomy (%s)" % chosen, "enabled": apply_ready},
			{"action_id": "fleet_autonomy", "label": "Run fleet autonomy tick", "enabled": true},
		],
		"summary": label,
		"plain": "%s\norder %s · %s" % [label, chosen, reason],
		"bbcode": "%s🚢 Fleet autonomy[/color] %s— %s[/color]" % [COLOR_HEADER, COLOR_MUTED, label],
		"empty": false,
	}


## Agent AI board (empty when inactive/empty signal).
static func agent_ai_board(
	action_class: String = "",
	threat: float = 0.55,
	province_id: int = -1,
	active: bool = true,
	network_strength: float = 0.35,
	loyalty: float = 0.5,
	available_agents: int = 5,
) -> Dictionary:
	if not active or (action_class.strip_edges().is_empty() and threat <= 0.0):
		return {"empty": true, "plain": "", "bbcode": "", "summary": "", "score": 0.0, "actions": []}
	var ac := action_class.strip_edges().to_lower()
	if ac.is_empty():
		ac = "sabotage"
	var missions: Dictionary = rank_agent_missions(ac, threat, network_strength, loyalty, 4)
	var best := str(missions.get("best_mission", "counterintel"))
	var score := clampf(
		0.4 * clampf(float(missions.get("best_score", 50.0)) / 100.0, 0.0, 1.0)
		+ 0.3 * threat
		+ 0.3 * 0.7,
		0.05,
		1.0,
	)
	var label := "Agent AI board · %s · threat %.0f%% · %s" % [best, threat * 100.0, ac]
	return {
		"missions": missions,
		"best_mission": best,
		"action_class": ac,
		"threat": threat,
		"province_id": province_id,
		"score": score,
		"actions": [
			{"action_id": "apply_agent_dispatch", "label": "Dispatch %s" % best, "enabled": true},
			{"action_id": "apply_counterplay", "label": "Apply counter-intel", "enabled": true},
		],
		"summary": label,
		"plain": label + "\n" + str(missions.get("plain", missions.get("summary", ""))),
		"bbcode": "%s🕵 Agent AI[/color] %s— %s[/color]" % [COLOR_HEADER, COLOR_MUTED, label],
		"empty": false,
	}


## Agent AI decision quality (multi-signal affinity).
static func agent_ai_decision_quality(signals: Array = [], available_agents: int = 5, network_strength: float = 0.35) -> Dictionary:
	var active: Array = []
	for s in signals:
		if not (s is Dictionary):
			continue
		if s.get("active") is bool and not bool(s.get("active")):
			continue
		var ac := str(s.get("action_class", s.get("class", ""))).strip_edges()
		if ac.is_empty() and not s.has("influence"):
			continue
		active.append(s)
	if active.is_empty():
		return {"empty": true, "plain": "", "bbcode": "", "summary": "", "score": 0.0, "decisions": []}
	var preferred := {
		"sabotage": ["sabotage_defense", "counterintel"],
		"infiltration": ["counterintel", "propaganda", "assassination_watch"],
		"economic_pressure": ["economic_shield", "network_expand"],
	}
	var decisions: Array = []
	var affinity_hits := 0
	var affinity_n := 0
	for s in active:
		var ac2 := str(s.get("action_class", s.get("class", "sabotage"))).strip_edges().to_lower()
		var th := float(s.get("influence", s.get("threat", 0.55)))
		var board: Dictionary = agent_ai_board(ac2, th, int(s.get("province_id", -1)), true, network_strength, 0.5, available_agents)
		if bool(board.get("empty", true)):
			continue
		var best := str(board.get("best_mission", ""))
		decisions.append({
			"province_id": int(s.get("province_id", -1)),
			"action_class": ac2,
			"best_mission": best,
			"threat": th,
			"score": float(board.get("score", 0.5)),
		})
		if preferred.has(ac2):
			affinity_n += 1
			if best in preferred[ac2]:
				affinity_hits += 1
	if decisions.is_empty():
		return {"empty": true, "plain": "", "bbcode": "", "summary": "", "score": 0.0, "decisions": []}
	var affinity := float(affinity_hits) / float(affinity_n) if affinity_n > 0 else 0.5
	var mean := 0.0
	for d in decisions:
		mean += float(d.get("score", 0.5))
	mean /= float(decisions.size())
	var score := mean * 0.5 + affinity * 0.4 + 0.1
	var label := "Agent AI quality · %d signals · affinity %.0f%% · score %.2f" % [
		decisions.size(), affinity * 100.0, score
	]
	var lines: PackedStringArray = [label]
	for d in decisions:
		lines.append("#%d %s → %s" % [int(d.get("province_id", -1)), str(d.get("action_class", "")), str(d.get("best_mission", ""))])
	return {
		"decisions": decisions,
		"affinity": affinity,
		"affinity_hits": affinity_hits,
		"affinity_n": affinity_n,
		"score": score,
		"actions": [
			{"action_id": "apply_agent_dispatch", "label": "Dispatch best counter-ops", "enabled": true},
			{"action_id": "apply_counterplay", "label": "Apply counter-intel", "enabled": true},
		],
		"summary": label,
		"plain": "\n".join(lines),
		"bbcode": "%s🕵 Agent quality[/color] %s— %s[/color]" % [COLOR_HEADER, COLOR_MUTED, label],
		"empty": false,
	}


static func fleet_patrol_depth_score(zone_count: int = 3, fuel_level: float = 0.7, dominant: String = "PATROL") -> Dictionary:
