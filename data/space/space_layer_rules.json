{
  "version": 2,
  "model": "orbital_compact_ledger",
  "notes": "S1: full Sol multi-site graph, habitability, lift/orbital_command capacity, space power, colony relations, generational independence",
  "capacity_model": {
    "rename_from_mission_control": "orbital_command",
    "player_facing_labels": {
      "lift_capacity": "Launch / lift capacity (spaceports + boost industry)",
      "orbital_command": "Orbital command capacity (stations, electronics, trained crews)",
      "expansion_strain": "Political expansion strain (mandate/cohesion soft cost when overextended)"
    },
    "lift_sources": {
      "per_spaceport_tier": [0, 2, 5, 10, 18],
      "per_orbital_yard": 4,
      "per_reusable_flag": 3
    },
    "orbital_command_sources": {
      "base": 2,
      "per_station_platform": 1,
      "per_station_orbital": 2,
      "per_station_ring": 4,
      "electronics_stock_scale": 0.002,
      "per_space_flag": 1
    },
    "expansion_strain": {
      "per_habitat_over_command": 0.03,
      "per_outer_system_habitat": 0.04,
      "soft_cap_not_hard_block": true,
      "affects": ["mandate_drag", "cohesion_risk", "autonomy_drift"]
    }
  },
  "development_phases": [
    {
      "id": "phase_0_rockets",
      "label": "Ballistic / early rocketry",
      "requires_any": ["rocketry_foundations", "v2_rocket"],
      "unlocks": ["suborbital_tests"],
      "player_hint": "Build rocketry tech and early launch sites."
    },
    {
      "id": "phase_1_satellites",
      "label": "Satellites & LEO",
      "requires_any_flags": ["allow_satellites"],
      "requires_any_milestones": ["first_satellite"],
      "unlocks": ["near_earth", "isr_constellations", "comms"],
      "player_hint": "Need spaceport lift + satellite designs. Buy/trade lift if you lack spaceports."
    },
    {
      "id": "phase_2_crew_station",
      "label": "Crewed orbit & stations",
      "requires_any_flags": ["allow_manned_space", "allow_space_station"],
      "unlocks": ["crew_transfer", "station_research_bonus", "orbital_command_growth"],
      "player_hint": "Life support + crew vehicles. Stations raise orbital command and space RP."
    },
    {
      "id": "phase_3_cis_lunar",
      "label": "Cis-lunar ops & Moon sites",
      "requires_any_flags": ["allow_lunar_operations", "allow_moon_base"],
      "unlocks": ["luna_sites", "l_points", "staging_for_mars"],
      "player_hint": "Moon base is the cheap staging step before Mars loft costs."
    },
    {
      "id": "phase_4_inner",
      "label": "Inner system (Mars, NEAs, Ceres)",
      "requires_any_flags": ["allow_mars_ops", "allow_mars_base"],
      "requires_any_milestones": ["mars_probe", "mars_landing"],
      "unlocks": ["mars_sites", "asteroid_mining", "long_hauls"],
      "player_hint": "Direct Earth→Mars is expensive; cis-lunar staging cuts loft cost."
    },
    {
      "id": "phase_5_outer",
      "label": "Outer system",
      "requires_any_flags": ["allow_outer_system", "fusion_power", "nuclear_thermal"],
      "unlocks": ["jovian_moons", "saturn_system", "deep_isolation_risk"],
      "player_hint": "Local propellant/ISRU mandatory; neglect → generational independence drift."
    }
  ],
