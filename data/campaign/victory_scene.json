        "ascendant": {
          "fallback": "score",
          "eyebrow": "VICTORY \u00b7 1 JANUARY 1949",
          "headline": "{NAME} / ASCENDANT",
          "sub": "First in industry on 1 January 1949."
        },
        "endured": {
          "eyebrow": "VICTORY \u00b7 1 JANUARY 1949",
          "headline": "{NAME} / ENDURES",
          "sub": "The campaign ended on 1 January 1949. Keep playing to shape what comes next."
        }
      }
