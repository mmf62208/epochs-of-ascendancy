    "loss": {
      "_default": {
        "capitulation": {
          "eyebrow": "DEFEAT \u00b7 CAPITULATION",
          "headline": "{NAME} / HAS FALLEN",
          "sub": "{name} capitulated on {date}. History isn't finished."
        },
        "rival_path": {
          "eyebrow": "DEFEAT \u00b7 {WINNER} WON {TITLE} FIRST",
          "headline": "{WINNER} / WINS THE WORLD",
          "sub": "{winner} won {title} first. Our banner did not survive it."
        },
        "eclipsed": {
          "eyebrow": "1 JANUARY 1949 \u00b7 ECLIPSED",
          "headline": "{NAME} / ECLIPSED",
          "sub": "The epoch closes with {name} {rank} among the powers. The flag is lowered, not lost."
        }
      }
