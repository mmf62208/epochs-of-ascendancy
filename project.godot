; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Epochs-of-Ascendancy"
run/main_scene="res://scenes/TestScenario.tscn"
config/features=PackedStringArray("4.6", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

GameData="*res://scripts/autoload/GameData.gd"
FactoryManager="*res://scripts/production/FactoryManager.gd"
ProductionManager="*res://scripts/autoload/ProductionManager.gd"
DesignManager="*res://scripts/production/DesignManager.gd"
SupplyManager="*res://scripts/supply/SupplyManager.gd"
LeaderManager="*res://scripts/leaders/LeaderManager.gd"
TimeManager="*res://scripts/autoload/TimeManager.gd"
LeaderEventUI="*res://scripts/ui/LeaderEventUI.gd"
AgentManager="*res://scripts/agents/AgentManager.gd"
NationalModifierManager="*res://scripts/national/NationalModifierManager.gd"
NationalSpiritManager="*res://scripts/national/NationalSpiritManager.gd"
TradeManager="*res://scripts/national/TradeManager.gd"
MapManager="*res://scripts/map/MapManager.gd"
InfrastructureDevelopmentManager="*res://scripts/map/InfrastructureDevelopmentManager.gd"
SpecialSiteManager="*res://scripts/map/SpecialSiteManager.gd"
TechnologyManager="*res://scripts/technology/TechnologyManager.gd"
SaveLoadManager="*res://scripts/autoload/SaveLoadManager.gd"
BattleManager="*res://scripts/combat/BattleManager.gd"

[display]

window/size/viewport_width=1680
window/size/viewport_height=960

